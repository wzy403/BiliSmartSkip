{
  "manifest_version": 3,
  "name": "Bilibili 广告跳过助手",
  "version": "2.1.0",
  "description": "通过多信号源分析自动识别并跳过B站视频中的嵌入式广告段",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://comment.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://i0.hdslb.com/*",
    "https://aisubtitle.hdslb.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": [
        "/scr/constants.js",
        "/scr/utils.js",
        "/scr/api.js",
        "/scr/detectors.js",
        "/scr/segment-detector.js",
        "/scr/skipper.js",
        "/scr/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["scr/page-data.js"],
      "matches": ["https://www.bilibili.com/*"]
    }
  ],
  "action": {
    "default_popup": "/scr/popup.html"
  },
  "icons": {
    "48": "/scr/icon.png",
    "512": "/scr/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bilismartskip@extanstion.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
