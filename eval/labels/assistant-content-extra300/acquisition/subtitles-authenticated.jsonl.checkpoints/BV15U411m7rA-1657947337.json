,{"from":164.45,"to":165.51,"content":"建造难度不高"},{"from":165.51,"to":167.17,"content":"造价更是童叟无欺"},{"from":167.17,"to":169.93,"content":"当年更是可以达到一年三舰的产量"},{"from":169.93,"to":171.85,"content":"在滨海战斗舰惨败的当下"},{"from":171.85,"to":172.53,"content":"美国海军民"},{"from":172.53,"to":175.81,"content":"现今非常需要这种务实成熟的军舰开发"},{"from":175.81,"to":178.36,"content":"佩里级护卫舰的正统续作便是众望所归"},{"from":178.36,"to":181.24,"content":"是时候让滨海战斗舰的失败翻篇了"},{"from":181.24,"to":183.18,"content":"让美国的护卫舰重回正轨"},{"from":183.92,"to":187.39,"content":"并且再不补上反潜扫雷小型舰这一空缺"},{"from":187.39,"to":190.05,"content":"未来的伯克级驱军的压力就会变得更大"},{"from":190.05,"to":193.37,"content":"于是星座级护卫舰便在这种期望中提上了日程"},{"from":193.37,"to":195.02,"content":"总之事就是这么个事吧"},{"from":195.02,"to":197.62,"content":"请原谅我花了这么些篇幅来讲滨海战斗舰"},{"from":197.62,"to":199.4,"content":"但也正是滨海战斗的失败"},{"from":199.4,"to":202.019,"content":"反衬出了美国海军对星座级护卫舰的需求"},{"from":202.019,"to":204.89,"content":"那么星座级护卫舰它靠谱吗"},{"from":204.89,"to":207.51,"content":"你别说仅从设计上来说还挺靠谱的"},{"from":207.51,"to":208.17,"content":"事实上啊"},{"from":208.17,"to":209.41,"content":"从2017年开始"},{"from":209.41,"to":212.32,"content":"美国海军对滨海战队的前景就已经产生了怀疑"},{"from":212.32,"to":213.5,"content":"也就在这一年"},{"from":213.5,"to":215.96,"content":"美国海军开始了新护卫舰的指标设定"},{"from":215.96,"to":217.04,"content":"2018年"},{"from":217.04,"to":218.64,"content":"因为冰冰们的糟糕表现"},{"from":218.64,"to":220.66,"content":"美国海军开始寻求成熟方案"},{"from":220.66,"to":221.82,"content":"在四个竞选方案中"},{"from":221.82,"to":224.02,"content":"就有异形设计进入了毛老美的视线"},{"from":224.02,"to":226.16,"content":"欧洲多用途护卫舰frame"},{"from":226.16,"to":228.62,"content":"作为意大利和法国共同研制的护卫舰"},{"from":228.62,"to":230.48,"content":"其主打的就是价美物联"},{"from":230.48,"to":231.92,"content":"没有任何试验技术"},{"from":231.92,"to":235.69,"content":"也没有什么先进Buff全货架式采购透明度极高"},{"from":235.69,"to":237.17,"content":"所有装备沿用现成品"},{"from":237.17,"to":238.15,"content":"并作最佳利用"},{"from":238.15,"to":240.29,"content":"并且已经有了大量的使用经验"},{"from":240.29,"to":242.19,"content":"服役后的表现优秀稳定"},{"from":242.19,"to":243.97,"content":"更让人勃然大喜的是"},{"from":243.97,"to":246.39,"content":"frame从一开始就瞄准了外销市场"},{"from":246.39,"to":247.79,"content":"仅在2018年"},{"from":247.79,"to":249.75,"content":"法国和意大利的frame服役之后呢"},{"from":249.75,"to":252.16,"content":"就先后取得了I摩洛哥的订单"},{"from":252.16,"to":254.32,"content":"外销成绩相当不错哦"},{"from":254.32,"to":257.06,"content":"天呐世上竟然有两片相同的叶纸"},{"from":257.06,"to":260.12,"content":"frame就是新世纪佩里吉异父异母的亲姐妹啊"},{"from":260.12,"to":262.42,"content":"我都不知道美国有什么理由不选frame方案"},{"from":262.42,"to":263.68,"content":"最后果不其然"},{"from":263.68,"to":264.4,"content":"那还用说"},{"from":264.4,"to":267.12,"content":"2020年来自意大利的芬坎蒂尼团队中标"},{"from":267.12,"to":268.98,"content":"这个团队拿出来的护卫舰方案"},{"from":268.98,"to":271.12,"content":"就是基于frame改进而来"},{"from":271.12,"to":273.18,"content":"而根据美国海军自己的构想"},{"from":273.18,"to":275.88,"content":"自己只需要替换一些关键子系统"},{"from":275.88,"to":278.92,"content":"其余绝大部分保持意大利团队的原始设计"},{"from":278.92,"to":281.52,"content":"就能直接开始进行热血澎湃的大建了"},{"from":281.52,"to":282.5,"content":"太好了"},{"from":282.5,"to":284.61,"content":"青黄不接的水面舰队有救啦"},{"from":284.61,"to":285.79,"content":"2020年4月"},{"from":285.79,"to":288.11,"content":"授予芬坎蒂尼详细设计和建造合同"},{"from":288.11,"to":288.93,"content":"按照常理"},{"from":288.93,"to":291.13,"content":"这种完全货架式采购设计的舰船"},{"from":291.13,"to":292.76,"content":"没有任何新技术新系统"},{"from":292.76,"to":296.4,"content":"但船厂和海军还是花了两年时间细化设计"},{"from":296.4,"to":297.24,"content":"与此同时呢"},{"from":297.24,"to":299.37,"content":"船厂还要对材料人员进行筹备"},{"from":299.37,"to":300.69,"content":"2022年的8月"},{"from":300.69,"to":301.65,"content":"意大利芬坎蒂尼"},{"from":301.65,"to":303.61,"content":"位于威斯康辛州的马里内特造船厂"},{"from":303.61,"to":306.02,"content":"正式开始建造星座级护卫舰项目"},{"from":306.02,"to":307.3,"content":"订单总计20艘"},{"from":307.3,"to":309.16,"content":"首舰预计2026年交付"},{"from":309.16,"to":311.92,"content":"4年时间就建造一艘护卫舰"},{"from":311.92,"to":313.26,"content":"你这放在曾经的美国"},{"from":313.26,"to":315.82,"content":"这个用时是尼米兹航母的下水时间"},{"from":315.82,"to":318.98,"content":"精神前作佩里级护卫舰更是只需要一年"},{"from":318.98,"to":320.7,"content":"当然放在现今的这个美国啊"},{"from":320.7,"to":321.9,"content":"已经是相当快的速度了"},{"from":321.9,"to":322.66,"content":"星座级护卫舰"},{"from":322.66,"to":326.07,"content":"就在这么一副务实成熟的氛围中推进"},{"from":326.07,"to":328.37,"content":"2023年5月29日"},{"from":328.37,"to":331.43,"content":"当问责局发布了对星座级护卫舰的审计后"},{"from":331.43,"to":333.62,"content":"国会老爷们并不惊讶地发现"},{"from":333.62,"to":337.22,"content":"这个宣称在2022年8月开工的项目"},{"from":337.22,"to":338.65,"content":"果然出问题了"},{"from":338.65,"to":339.37,"content":"对嘛"},{"from":339.37,"to":340.61,"content":"怎么可能那么顺利嘛"},{"from":340.61,"to":341.79,"content":"我都不习惯了"},{"from":341.79,"to":343.33,"content":"原计划在这个时间点"},{"from":343.33,"to":344.93,"content":"也就是在2024年的6月"},{"from":344.93,"to":346.87,"content":"星座级护卫舰的建造进度"},{"from":346.87,"to":349.25,"content":"理应达到35.5%"},{"from":349.25,"to":351.37,"content":"马里内特造船厂爆出的实际进度呢"},{"from":351.37,"to":353.59,"content":"则和预计的建造进度呢略有差距"},{"from":353.59,"to":355.53,"content":"3.6%"},{"from":355.53,"to":358.21,"content":"面对这个堪比杂志的数字"},{"from":358.21,"to":360.29,"content":"国会老爷们倒吸冷气"},{"from":360.29,"to":361.37,"content":"没错呀"},{"from":361.37,"to":364.45,"content":"咱这造的是护卫舰的设计方案"},{"from":364.45,"to":366.49,"content":"是基于frame的成熟方案"},{"from":366.49,"to":368.83,"content":"设备技术全是成熟产品"},{"from":368.83,"to":371.27,"content":"没有任何的新系统和新设备"},{"from":371.27,"to":374.56,"content":"全舰所有子系统全部经过长期验证"},{"from":374.56,"to":375.64,"content":"从理论上讲"},{"from":375.64,"to":377.8,"content":"它就不可能有任何建造上的困难"},{"from":377.8,"to":379.46,"content":"那最大的可能性只有一种"},{"from":379.46,"to":381.44,"content":"你们船上的人全都在带薪睡觉"},{"from":381.44,"to":382.7,"content":"用的还是神气"},{"from":382.7,"to":384.24,"content":"小鹿双面承托护颈枕"},{"from":384.24,"to":386.06,"content":"商场里类似的护颈枕都要三四百"},{"from":386.06,"to":387.32,"content":"他只要188"},{"from":387.32,"to":389.4,"content":"几年下来一天也就几毛钱"},{"from":389.4,"to":392.86,"content":"和星座那层层累加的预算一比就是物美价廉呐"},{"from":392.86,"to":393.62,"content":"价格妙"},{"from":393.62,"to":394.48,"content":"税感更妙"},{"from":394.48,"to":396.12,"content":"他有两一个蛇枕垫着脖子"},{"from":396.12,"to":397.1,"content":"一边还有凸点"},{"from":397.1,"to":398.6,"content":"能按摩到脖子后面的穴位"},{"from":398.6,"to":399.3,"content":"边睡边按"},{"from":399.3,"to":400.74,"content":"睡醒肩膀特别轻松"},{"from":400.74,"to":403.14,"content":"我之前那棉花枕睡着脖子都是悬空的"},{"from":403.14,"to":404.82,"content":"每天起床肩膀又酸又痛"},{"from":404.82,"to":406.14,"content":"和睡小路加一比"},{"from":406.14,"to":407.02,"content":"简直就是食草"},{"from":407.02,"to":408.44,"content":"马路和大和旅馆的区别"},{"from":408.44,"to":410.1,"content":"我特别爱特的过渡分区"},{"from":410.1,"to":411.66,"content":"正躺拖住脖子"},{"from":411.66,"to":413.48,"content":"侧躺玩手机也不压肩膀"},{"from":413.48,"to":414.94,"content":"随便翻身都不硌脸"},{"from":414.94,"to":416.88,"content":"天城同款紧凑臂都缓解了不少"},{"from":416.88,"to":419.2,"content":"里面呢是升级的2.0太空记忆棉"},{"from":419.2,"to":422,"content":"一躺下去就能把我的脑袋拖到最舒服的高度"},{"from":422,"to":422.76,"content":"睡一晚上"},{"from":422.76,"to":423.56,"content":"压力都被吸收"},{"from":423.56,"to":425.08,"content":"白天工作整个人都有劲儿"},{"from":425.08,"to":428.28,"content":"而且这个冰丝枕套夏天睡凉凉的特舒服"},{"from":428.28,"to":429.78,"content":"喜欢就抓紧领券"},{"from":429.78,"to":431.28,"content":"保价还有运费险"},{"from":431.28,"to":433.5,"content":"两年开裂变形都能免费换新"},{"from":433.5,"to":436.06,"content":"自己睡或者送礼都不错哦"},{"from":437.86,"to":440.34,"content":"星座级层层累加的预算其实还好吧"},{"from":440.34,"to":442.46,"content":"这种报告大数字看多了也就习惯了"},{"from":442.46,"to":444.24,"content":"星座级首舰也就15亿美元"},{"from":444.24,"to":446.36,"content":"后期舰船大致在12亿美元"},{"from":446.36,"to":448.98,"content":"但和它不断累加的延后时间相比"},{"from":448.98,"to":450.8,"content":"预算都显得不是问题了"},{"from":450.8,"to":452.08,"content":"2024年1月"},{"from":452.08,"to":453.3,"content":"美国海军发言称"},{"from":453.3,"to":456.68,"content":"星座级护卫舰预计延迟交付12个月"},{"from":456.68,"to":457.88,"content":"到了今年的3月"},{"from":457.88,"to":459.82,"content":"海军认为得延迟到15个月"},{"from":459.82,"to":461.36,"content":"而到了4月2日"},{"from":461.36,"to":463.5,"content":"这个数字被改为了36个月"},{"from":463.5,"to":466.86,"content":"在各路参与人士的一片质疑和问责中"},{"from":466.86,"to":467.98,"content":"今年的4月"},{"from":467.98,"to":468.74,"content":"12号"},{"from":468.74,"to":472.67,"content":"星座级首舰终于象征性地举行了龙骨铺设仪式"},{"from":472.67,"to":474.51,"content":"别骂了别骂了"},{"from":474.51,"to":479.02,"content":"真的再见了一个货架式采购设计完全成熟"},{"from":479.02,"to":480.86,"content":"没有任何先进技术的护卫舰"},{"from":480.86,"to":482.06,"content":"原本计划造4年"},{"from":482.06,"to":483.4,"content":"2026年才交付"},{"from":483.4,"to":485.66,"content":"这已经不是什么值得吹的事情了"},{"from":485.66,"to":486.76,"content":"现在你告诉我"},{"from":486.76,"to":488.62,"content":"海底延期到2029年"},{"from":488.62,"to":490.44,"content":"连下一届奥运会都赶不上"},{"from":490.44,"to":492.53,"content":"你们船厂和海军到底在搞什么"},{"from":492.53,"to":495.57,"content":"于是为期45天的国会问责开始了工作"},{"from":495.57,"to":496.69,"content":"今年5月29日"},{"from":496.69,"to":497.77,"content":"问责结果公示"},{"from":497.77,"to":500.93,"content":"随后美国媒体对星座级护卫舰项目一词概括"},{"from":500.93,"to":502.11,"content":"一团乱麻"},{"from":502.11,"to":503.17,"content":"我们之前说过"},{"from":503.17,"to":506.06,"content":"星座级护卫舰的设计本身就是基于frame的设计"},{"from":506.06,"to":508.8,"content":"两者设计的通用度高达85%"},{"from":508.8,"to":511.02,"content":"而当船长真的开始着手准备之后"},{"from":511.02,"to":513.54,"content":"他们发现海军这边一直在改设计"},{"from":513.54,"to":515.12,"content":"其程度堪称大刀阔"},{"from":515.12,"to":517.24,"content":"不对应该是脱胎换骨"},{"from":517.24,"to":518.6,"content":"用报告的原话便是"},{"from":518.6,"to":521.32,"content":"几乎每一张图纸都进行了修改"},{"from":521.32,"to":523.46,"content":"根据国会报告中的方案对比"},{"from":523.46,"to":525.14,"content":"蓝色为frame设计"},{"from":525.14,"to":527.13,"content":"白色为星座级设计"},{"from":527.13,"to":529.25,"content":"全方案加长7.2米"},{"from":529.25,"to":530.39,"content":"加宽1.2米"},{"from":530.39,"to":532.61,"content":"满载排水量从6800吨"},{"from":532.61,"to":534.91,"content":"飙升至了7408吨"},{"from":534.91,"to":536.75,"content":"设计航速降低至26节"},{"from":536.75,"to":537.49,"content":"动力装置"},{"from":537.49,"to":539.109,"content":"机械控制系统大改"},{"from":539.109,"to":542.229,"content":"当然按照星座级护卫舰项目的这个经理啊"},{"from":542.229,"to":543.94,"content":"凯文史密斯海军上尉的说法"},{"from":543.94,"to":545.96,"content":"这相当于买了个大一点的房子"},{"from":545.96,"to":547.74,"content":"但从建模和模拟来看"},{"from":547.74,"to":549.7,"content":"星座和film是完全相同的"},{"from":549.7,"to":551.78,"content":"然后国会这边就看到了"},{"from":551.78,"to":553.58,"content":"结果在美国海军的干涉下"},{"from":553.58,"to":555.32,"content":"星座级图纸和frame图纸"},{"from":555.32,"to":558.05,"content":"通用性降低至不足15%"},{"from":558.05,"to":559.17,"content":"是的你没有听错"},{"from":559.17,"to":560.61,"content":"不足15%"},{"from":560.61,"to":562.36,"content":"按审计员自己的说法"},{"from":562.36,"to":563.4,"content":"现在的星座和frame"},{"from":563.4,"to":565.92,"content":"别说她俩是什么异父异母的亲姐妹"},{"from":565.92,"to":568.36,"content":"现在连远房亲戚都混不上"},{"from":568.36,"to":570.52,"content":"美国海军队设计的大改还则罢了"},{"from":570.52,"to":571.28,"content":"你都改了"},{"from":571.28,"to":572.88,"content":"那就赶紧照着设计施工吧"},{"from":572.88,"to":574.96,"content":"咱就当这个frame是仅供参考了"},{"from":574.96,"to":578.32,"content":"而当用于施工的3D数据包完成度爆出之后"},{"from":578.32,"to":580.84,"content":"国会老爷们直接爷视二度啊"},{"from":580.84,"to":582.06,"content":"这张图其实很好理解"},{"from":582.06,"to":585.28,"content":"就是造船时具体的3D施工模型数据"},{"from":585.28,"to":586.84,"content":"根据左上角的标注"},{"from":586.84,"to":588.8,"content":"不同的颜色呢代表不同的完成度"},{"from":588.8,"to":589.64,"content":"整体看下来"},{"from":589.64,"to":590.78,"content":"全键30一个分段"},{"from":590.78,"to":593.44,"content":"除了动力舱段的设计完成度较高之外"},{"from":593.44,"to":596.92,"content":"有25个分段完成度在90%以下"},{"from":596.92,"to":600.18,"content":"美利坚特色晾衣杆桅杆都只搞了一半哦"},{"from":600.18,"to":602.54,"content":"原来你连施工图纸都还没有确定"},{"from":602.54,"to":604.1,"content":"那你这怎么让船厂开工"},{"from":604.1,"to":606.92,"content":"注意这已经是延期了八个月的结果"},{"from":606.92,"to":609.48,"content":"也距离项目敲定过去了4年"},{"from":609.48,"to":610.52,"content":"与此同同时"},{"from":610.52,"to":612.24,"content":"船厂也同样遇到了问题"},{"from":612.24,"to":614.36,"content":"目前最紧急的问题便是劳动力不足"},{"from":614.36,"to":616.74,"content":"准确的来讲是缺乏熟练的造船工人"},{"from":616.74,"to":619.34,"content":"这个问题不仅仅是马里内特造船厂的问题"},{"from":619.34,"to":621.599,"content":"而是目前美国造船业的问题"},{"from":621.599,"to":624.199,"content":"除了本身缺乏足够的造船工人外"},{"from":624.199,"to":627.03,"content":"马里内特造船厂的产能居然还在分流"},{"from":627.03,"to":630.07,"content":"目前船厂总共有三个在建项目"},{"from":630.07,"to":631.97,"content":"第一个便是星座级护卫舰"},{"from":631.97,"to":635.359,"content":"其次是沙特阿拉伯订购的多任务水面舰"},{"from":635.359,"to":639.299,"content":"最后还有两艘在建的自由行滨海战斗舰"},{"from":639.299,"to":641.319,"content":"博罗伊特和克利夫兰啊"},{"from":641.319,"to":642.119,"content":"对你没有听错"},{"from":642.119,"to":643.339,"content":"还在造冰冰"},{"from":643.339,"to":646.179,"content":"现今的冰墩们处于一种一边建造"},{"from":646.179,"to":646.939,"content":"一边改装"},{"from":646.939,"to":648.619,"content":"一边退役的奇妙形态"},{"from":648.619,"to":650.339,"content":"毕竟作为一个首舰6亿美元"},{"from":650.339,"to":652.74,"content":"后期均价近5亿美元的滨海战斗舰"},{"from":652.74,"to":654.68,"content":"想放弃是谈何容易啊"},{"from":654.68,"to":657.36,"content":"美国海军后续给冰冰打了很多的补丁"},{"from":657.36,"to":658.78,"content":"例如安装什么地狱火呀"},{"from":658.78,"to":660.1,"content":"试试NSM导弹呢"},{"from":660.1,"to":661.48,"content":"2024年10月"},{"from":661.48,"to":664.72,"content":"依靠在冰冰尾部的直升机甲板上安装集装箱"},{"from":664.72,"to":665.2,"content":"武器系统"},{"from":665.2,"to":666.33,"content":"马克七零啊"},{"from":666.33,"to":666.77,"content":"放心吧"},{"from":666.77,"to":668.57,"content":"这个集装箱不是什么高科技产物"},{"from":668.57,"to":672.01,"content":"就是把驱逐舰里的马克四幺垂发摘出来砍一半"},{"from":672.01,"to":673.76,"content":"然后做成了集装箱的造型"},{"from":673.76,"to":676.79,"content":"靠这个集装箱试射了一枚标准六防空导弹"},{"from":676.79,"to":679.03,"content":"这些站着护卫舰编制的冰冰"},{"from":679.03,"to":683.02,"content":"终于在服役近10年后获得了远距离防空的能力"},{"from":683.02,"to":684.5,"content":"但你话又说回来"},{"from":684.5,"to":686.12,"content":"这原本也不是他的活儿啊"},{"from":686.12,"to":690.1,"content":"而且一旦依靠集装箱获得远距防空能力"},{"from":690.1,"to":692.04,"content":"尾部的甲板就会被占用"},{"from":692.04,"to":694.03,"content":"冰冰们就要完全放弃直升机"},{"from":694.03,"to":695.83,"content":"所以补了半天还是个瘸子"},{"from":695.83,"to":697.03,"content":"别折腾冰冰了"},{"from":697.03,"to":699.07,"content":"赶紧把产能挪到星座级上面去吧"},{"from":699.07,"to":700.86,"content":"当然看到这里也有观众被问到"},{"from":700.86,"to":702.98,"content":"怎么确定这些报告就一定是真的呢"},{"from":702.98,"to":705.05,"content":"万一这些报告是来战忽的怎么办"},{"from":705.05,"to":706.39,"content":"呃怎么说呢"},{"from":706.39,"to":709.42,"content":"我们现在看到的国会报告可能数据有偏差"},{"from":709.42,"to":711.54,"content":"严重性可能有夸大的嫌疑"},{"from":711.54,"to":714.569,"content":"但现在有一个事是千真万确"},{"from":714.569,"to":716.309,"content":"项目开始过去4年"},{"from":716.309,"to":717.209,"content":"美国的船坞里"},{"from":717.209,"to":719.11,"content":"他就是没有星座级护卫舰"},{"from":719.11,"to":722.21,"content":"在现代各种遥感卫星侦察手段的情况下"},{"from":722.21,"to":725.1,"content":"3000吨的滨海战斗舰还能放在乌舱里面造"},{"from":725.1,"to":726.62,"content":"原案6900吨"},{"from":726.62,"to":728.46,"content":"修改后7400吨的护卫舰"},{"from":728.46,"to":730.54,"content":"它是无论如何都藏不住的"},{"from":730.54,"to":733.55,"content":"并且这种水面舰船它也不用藏船坞"},{"from":733.55,"to":734.43,"content":"中西装的战舰"},{"from":734.43,"to":735.95,"content":"它既是牌桌上的名牌"},{"from":735.95,"to":737.56,"content":"也是最直接的威慑"},{"from":737.56,"to":739.44,"content":"当然也不要在船坞里面泡的太久"},{"from":739.44,"to":740.72,"content":"视频已经接近尾声"},{"from":740.72,"to":742.68,"content":"本期视频的主题也讲的差不多了"},{"from":742.68,"to":744.94,"content":"一个成熟方案被改的面目目全非"},{"from":744.94,"to":745.56,"content":"4年过去"},{"from":745.56,"to":746.78,"content":"仅象征性的开工"},{"from":746.78,"to":748.34,"content":"这里可能会有人好奇啊"},{"from":748.34,"to":749.76,"content":"星座级护卫舰的延误"},{"from":749.76,"to":751.67,"content":"会对美国海军造成什么影响呢"},{"from":751.67,"to":754.01,"content":"平心而论不会造成什么影响"},{"from":754.01,"to":756.33,"content":"接下来我们来玩一个角色扮演游戏"},{"from":756.33,"to":759.23,"content":"现在各位观众就是国会里听报告的老爷们"},{"from":759.23,"to":760.85,"content":"我来给大家汇报一下"},{"from":760.85,"to":762.79,"content":"兴许大家就能够心里好受一些"},{"from":762.79,"to":764.29,"content":"2024年4月"},{"from":764.29,"to":766.66,"content":"也就是在星座级护卫舰问责调查前"},{"from":766.66,"to":768.94,"content":"美国国防新闻就发布了一篇文章"},{"from":768.94,"to":771.72,"content":"其中就总结了目前美国海军的建设现状"},{"from":771.72,"to":775.26,"content":"美国海军目前所有大型项目都有延误情况"},{"from":775.26,"to":777.4,"content":"以下是建造耗时汇总"},{"from":777.4,"to":778.26,"content":"单月为月"},{"from":778.26,"to":781.3,"content":"橙色点线代表原定预估建造耗时"},{"from":781.3,"to":784.94,"content":"绿色矩形为实际建造或最近预估所需耗时"},{"from":784.94,"to":787.6,"content":"首先就是三位一体核打击力量之一"},{"from":787.6,"to":791.27,"content":"海军建造最高优先级的哥伦比亚级战略核潜艇"},{"from":791.27,"to":793.53,"content":"首艇于2021年开工"},{"from":793.53,"to":795.51,"content":"预计2028年完成下水"},{"from":795.51,"to":797.35,"content":"根据最近的造船审查"},{"from":797.35,"to":800.24,"content":"首艇已经比计划晚了12~14个月"},{"from":800.24,"to":802.04,"content":"具体完工日期待定"},{"from":802.04,"to":804.56,"content":"其次弗吉尼亚级攻击核潜艇"},{"from":804.56,"to":806.56,"content":"首艇自2004年开始服役"},{"from":806.56,"to":808.069,"content":"从俄勒冈号后开始"},{"from":808.069,"to":809.409,"content":"随着产能增加"},{"from":809.409,"to":811.389,"content":"该级潜艇开始大规模的延误"},{"from":811.389,"to":812.869,"content":"自2019年开始"},{"from":812.869,"to":816.029,"content":"美艇弗吉尼亚级的建造时间从平均68个月"},{"from":816.029,"to":817.34,"content":"拖到了85个月"},{"from":817.34,"to":820.94,"content":"目前在建的时间则直接规划至了95个月"},{"from":820.94,"to":823.46,"content":"随后便是水面中间伯克级驱逐舰"},{"from":823.46,"to":824.82,"content":"最近交付的伯克级中呢"},{"from":824.82,"to":827.06,"content":"实际或建造时间约为70个月"},{"from":827.06,"to":828.86,"content":"并且一直呈现上升趋势"},{"from":828.86,"to":831.02,"content":"伯克级驱逐舰的采购将一直维持至"},{"from":831.02,"to":832.14,"content":"2032财年"},{"from":832.14,"to":834.66,"content":"届时才开始采购新一代驱逐舰"},{"from":834.66,"to":836.52,"content":"接下来是福特级航空母舰"},{"from":836.52,"to":838.64,"content":"首舰福特号和2号舰肯尼迪号"},{"from":838.64,"to":841.18,"content":"已经比原定交付计划推迟了两年以上"},{"from":841.18,"to":843.34,"content":"肯尼迪预计在2025年交付"},{"from":843.34,"to":843.92,"content":"咋说呢"},{"from":843.92,"to":845.98,"content":"得抓紧时间去设海试了啊"},{"from":845.98,"to":848.12,"content":"2024年已经过去了一大半"},{"from":848.12,"to":851.2,"content":"3号舰企业号和4号舰米勒号为同批采购"},{"from":851.2,"to":851.68,"content":"企业号"},{"from":851.68,"to":853.54,"content":"原定2028年3月交付"},{"from":853.54,"to":855.86,"content":"现在则推迟至了2029年的9月"},{"from":855.86,"to":858.37,"content":"至于米勒号慢慢造不着急"},{"from":858.37,"to":860.72,"content":"最后才是我们本期的主角"},{"from":860.72,"to":861.98,"content":"星座级护卫舰"},{"from":861.98,"to":863.3,"content":"原定4年交付"},{"from":863.3,"to":865.32,"content":"现在建造时长预计超过7年"},{"from":865.32,"to":866.08,"content":"不出意外"},{"from":866.08,"to":868.6,"content":"差不多也就是在2029年交付"},{"from":868.6,"to":870,"content":"言外之意很简单啦"},{"from":870,"to":871.48,"content":"在战略核潜艇"},{"from":871.48,"to":875.069,"content":"航母驱逐舰等大型项目都在延误的情况之下"},{"from":875.069,"to":876.269,"content":"星座级护卫舰"},{"from":876.269,"to":877.649,"content":"它作为一个勤务船只"},{"from":877.649,"to":879.69,"content":"实在是谈不上拖累美国海军"},{"from":879.69,"to":881.57,"content":"所谓债多不压身怎么样"},{"from":881.57,"to":882.95,"content":"各位国会的老爷们"},{"from":882.95,"to":884.69,"content":"听完我这番宽慰的话语"},{"from":884.69,"to":885.13,"content":"是不是"},{"from":885.13,"to":888.43,"content":"瞬间觉得星座级护卫舰也没那么高血压了"},{"from":888.43,"to":890.63,"content":"总之现今的美国海军就是这么个情况"},{"from":890.63,"to":892.23,"content":"建造上出现了广泛的延误"},{"from":892.23,"to":893.89,"content":"新技术和新装备基本难产"},{"from":893.89,"to":895.8,"content":"即便抛开新船建造不谈"},{"from":895.8,"to":898.44,"content":"美国甚至在维护现有舰船规模上"},{"from":898.44,"to":899.62,"content":"都在逐渐力不从心"},{"from":899.62,"to":901.98,"content":"这里推荐看看花岗岩老师的视频进行了解"},{"from":901.98,"to":902.2,"content":"说"},{"from":902.2,"to":903.48,"content":"真的你都闹成这个样子了"},{"from":903.48,"to":905.32,"content":"你直接买现成的frame吧"},{"from":905.32,"to":907.4,"content":"历史上你又不是没有外购过军舰"},{"from":907.4,"to":908.34,"content":"你直接买吧"},{"from":908.34,"to":909.12,"content":"比你造的快"},{"from":909.12,"to":909.88,"content":"价格还便宜"},{"from":909.88,"to":910.66,"content":"不丢人"},{"from":910.66,"to":911.44,"content":"我是克狗"},{"from":911.44,"to":912.86,"content":"我们下期节目再见"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:02:08.111Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:02:05.674Z"}}
