o":298.28,"content":"这个"},{"from":298.28,"to":300.02,"content":"就是我们今天摄影小妹点的一份"},{"from":300.02,"to":301.32,"content":"经典的鳗鱼盖饭"},{"from":301.32,"to":302.22,"content":"没有其他内容"},{"from":302.22,"to":303.84,"content":"只不过是一个简单的小盒"},{"from":303.84,"to":306.8,"content":"上面放了一片鳗鱼以及鸡蛋丝"},{"from":306.8,"to":308.04,"content":"我那就太经典了"},{"from":308.04,"to":310.66,"content":"鳗鱼牛我点的是300克的牛肉"},{"from":310.66,"to":311.96,"content":"这里有半斤多呢"},{"from":311.96,"to":314.06,"content":"就是在日本鳗鱼和牛肉"},{"from":314.06,"to":314.98,"content":"他俩是好哥们"},{"from":314.98,"to":316.64,"content":"鳗鱼上岸遇到了牛"},{"from":316.64,"to":318.42,"content":"就像美人鱼上岸遇到了王子"},{"from":318.42,"to":319.42,"content":"他俩就是畜生了"},{"from":319.42,"to":321.5,"content":"那咱们从尾巴开始吃起"},{"from":324.82,"to":328.659,"content":"我要尝一口牛嗯牛嗯"},{"from":328.659,"to":329.779,"content":"你想清楚一点"},{"from":329.779,"to":331.459,"content":"是里面有刺"},{"from":334.75,"to":337.09,"content":"嗯通哥嘴皮有点难崩的是吧"},{"from":337.09,"to":337.93,"content":"刺还不少啊"},{"from":337.93,"to":339.11,"content":"嗯我都不敢往下咽"},{"from":339.11,"to":339.53,"content":"说实话"},{"from":339.53,"to":341.88,"content":"咱们之前吃鳗鱼饭好像没感觉到里面有刺啊"},{"from":341.88,"to":344.34,"content":"是不是咱以前吃的鳗鱼饭都是快餐的事"},{"from":344.34,"to":346.42,"content":"咱以前吃也吃过好的鳗鱼吧"},{"from":346.42,"to":347.58,"content":"没有刺儿啊"},{"from":347.58,"to":350.42,"content":"鳗鱼饭的做法应该是先蒸再烤"},{"from":350.42,"to":352.1,"content":"通常在蒸再加上烤的时候"},{"from":352.1,"to":354.16,"content":"就已经把这种刺啊给它软化了"},{"from":354.16,"to":356.44,"content":"他这种我感觉就是一个制作上的技术问题"},{"from":356.44,"to":357.52,"content":"因为我们之前吃的鳗鱼饭"},{"from":357.52,"to":358.8,"content":"他是不是没有刺的"},{"from":358.8,"to":360.04,"content":"可能也是品质问题"},{"from":360.04,"to":362.32,"content":"对我这个牛肉首先能看出来一点"},{"from":362.32,"to":363.48,"content":"就是这个肉很新鲜"},{"from":363.48,"to":364.56,"content":"它有那种光栅效应"},{"from":364.56,"to":365.84,"content":"就是你能看到它反绿光"},{"from":365.84,"to":366.92,"content":"就味道上来说呢"},{"from":366.92,"to":369.32,"content":"我觉得是有点白瞎这个新鲜牛肉了"},{"from":369.32,"to":370.64,"content":"那么我就问你嗯"},{"from":370.64,"to":372.86,"content":"这个牛肉跟吉野家哪个好吃"},{"from":372.86,"to":374.38,"content":"我觉得17加的挺好"},{"from":374.38,"to":376.5,"content":"你觉得你觉得17甲的更好吃"},{"from":376.5,"to":378.68,"content":"他家这个肉我还有一个字形容他"},{"from":378.68,"to":379.86,"content":"我咸"},{"from":379.86,"to":383.55,"content":"可能是这种网红店会给你很高的期待"},{"from":383.55,"to":386.67,"content":"但实际上来说并没有咱俩上次在11家吃的爽"},{"from":387.82,"to":388.9,"content":"虽然咱干过"},{"from":388.9,"to":390.86,"content":"它是预制的微波炉加热就行"},{"from":390.86,"to":392.96,"content":"但是他那个鳗鱼烧烤非常的糯"},{"from":392.96,"to":394.6,"content":"而且油脂很高很香"},{"from":394.6,"to":396.32,"content":"因为日本的连锁店来讲"},{"from":396.32,"to":398.58,"content":"它品质往往要把控的更严对"},{"from":398.58,"to":399.82,"content":"所以它属于个体货"},{"from":399.82,"to":400.78,"content":"那我们再看一下啊"},{"from":400.78,"to":402.66,"content":"这个玉子烧给它剥开以后"},{"from":402.66,"to":404.38,"content":"里边的蛋芯还是比较糯"},{"from":404.38,"to":405.76,"content":"比较嫩的啊"},{"from":406.16,"to":408.58,"content":"嗯这个鸡蛋来讲的话"},{"from":408.58,"to":409.24,"content":"我可以吃出来"},{"from":409.24,"to":411.6,"content":"它里边是放了日式的这个海鲜酱油"},{"from":411.6,"to":412.36,"content":"挺嫩的"},{"from":412.36,"to":414.28,"content":"我反而觉得我这个鸡蛋要比这鳗鱼好吃"},{"from":414.28,"to":415.6,"content":"有点像这个鸡蛋糕的感觉"},{"from":415.6,"to":416.16,"content":"我尝一口"},{"from":416.16,"to":418.32,"content":"我专业这玩意"},{"from":421.74,"to":426.24,"content":"你能吃到这个有一种这个蒸鸡蛋糕的味儿啊"},{"from":427.44,"to":429.2,"content":"嗯蛋香还是挺足的"},{"from":429.2,"to":430.36,"content":"品尝完鳗鱼和蛋以后"},{"from":430.36,"to":431.86,"content":"我们再看一下他们下面这个饭啊"},{"from":431.86,"to":433.72,"content":"里边的米饭还是相当的多的"},{"from":433.72,"to":435.72,"content":"但是你看我一剥你就明白了"},{"from":435.72,"to":437.469,"content":"这饭真坨呀"},{"from":437.469,"to":440.86,"content":"这是一块一块的坨饭团嗯"},{"from":440.86,"to":443.62,"content":"就外面这一层给你一种就是风干饭的感觉了"},{"from":443.62,"to":445.3,"content":"你别看这个饭颜色挺深"},{"from":445.3,"to":447.06,"content":"但是实际吃起来吧没有什么味"},{"from":447.06,"to":449.86,"content":"哎我还是感觉要加一点这个酱汁"},{"from":453.34,"to":454.98,"content":"而且感觉