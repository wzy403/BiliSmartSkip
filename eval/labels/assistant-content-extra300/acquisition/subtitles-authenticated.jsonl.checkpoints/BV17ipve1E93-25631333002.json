{"schemaVersion":1,"bvid":"BV17ipve1E93","cid":25631333002,"subtitles":[{"from":0,"to":2.76,"content":"很多人在观看烟囱定向爆破的视频时"},{"from":2.76,"to":3.54,"content":"都会纳闷"},{"from":3.54,"to":6.42,"content":"为什么烟囱在倾斜中会凌空折断呢"},{"from":6.42,"to":8.1,"content":"爆破只是炸断了根部"},{"from":8.1,"to":9.42,"content":"其余完好无损"},{"from":9.42,"to":12.58,"content":"但在下落中却受到了很大的弯曲并折断"},{"from":12.58,"to":14.78,"content":"那么这股力量是从哪来的呢"},{"from":14.78,"to":16.06,"content":"本期我们就来研究"},{"from":16.06,"to":18.68,"content":"这种十分重要的烟囱半空折断现象"},{"from":18.68,"to":19.66,"content":"之所以重要"},{"from":19.66,"to":22.78,"content":"是因为一些在路上好端端行驶的半挂拖车"},{"from":22.78,"to":25.3,"content":"会毫无预兆的突然进入死亡摇摆"},{"from":25.3,"to":28.26,"content":"经常使车主创业未半而中道崩卒"},{"from":28.26,"to":31.64,"content":"这种事故其实就和烟囱的空中折断现象有关"},{"from":31.64,"to":32.66,"content":"为一探究竟"},{"from":32.66,"to":34.26,"content":"我们来到一处黑砖窑"},{"from":34.26,"to":37.36,"content":"有歹徒在此修建了一高一矮两根烟囱"},{"from":37.36,"to":39.32,"content":"随着执法人员引爆炸药"},{"from":39.32,"to":40.78,"content":"烟囱根部被炸断"},{"from":40.78,"to":42.04,"content":"从坍塌过程看"},{"from":42.04,"to":45.16,"content":"很明显矮的烟囱比高的倒下更快一些"},{"from":45.16,"to":47.92,"content":"我们不妨回想高中学过的角动量定理"},{"from":47.92,"to":50.1,"content":"烟囱绕根部旋转的重力矩"},{"from":50.1,"to":53.92,"content":"M等于烟囱的旋转角动量L随时间T的变化率"},{"from":53.92,"to":56.6,"content":"而这里的角动量又是烟囱的转动惯量"},{"from":56.6,"to":58.64,"content":"J和角速度欧米伽的乘积"},{"from":58.64,"to":60.72,"content":"那么此处角动量对时间求导"},{"from":60.72,"to":63.98,"content":"也就表示力矩等于转动惯量乘角加速度"},{"from":63.98,"to":64.82,"content":"既然如此"},{"from":64.82,"to":66.78,"content":"那么观察正在倒下的烟囱"},{"from":66.78,"to":68.26,"content":"发现它离地越高"},{"from":68.26,"to":69.9,"content":"则转动惯量就越大"},{"from":69.9,"to":71.34,"content":"并且高度增加时"},{"from":71.34,"to":73.94,"content":"转动惯量的增速超过了力矩的增速"},{"from":73.94,"to":75.92,"content":"导致角加速度越来越小"},{"from":75.92,"to":79.02,"content":"所以越靠近顶端的部分位移就会越滞后"},{"from":79.02,"to":82.32,"content":"使得烟囱在下落中受到了弯曲而被折断"},{"from":82.32,"to":85.16,"content":"但是这一原理和半挂拖车的死亡摇摆"},{"from":85.16,"to":86.18,"content":"有什么关系呢"},{"from":86.18,"to":89.68,"content":"在分析之前要向同学们推荐几米工具箱"},{"from":89.68,"to":91.58,"content":"它外形美观紧凑小巧"},{"from":91.58,"to":93.1,"content":"采用多层锁扣设计"},{"from":93.1,"to":95.56,"content":"取用轻松方便各层空间科学利用"},{"from":95.56,"to":99.22,"content":"实现了小身材大容量工具按功能种类合理分区"},{"from":99.22,"to":100.76,"content":"位置次序一目了然"},{"from":100.76,"to":103.46,"content":"包含几十种维修和制作的常用工具"},{"from":103.46,"to":106.18,"content":"每件无论材质或做工均无可挑剔"},{"from":106.18,"to":109.66,"content":"电动工具锤搞刀具及各种规格的钻头"},{"from":109.66,"to":111.06,"content":"劈头一应俱全"},{"from":111.06,"to":112.26,"content":"使用得心应手"},{"from":112.26,"to":115.04,"content":"无论日常修理或制作都是您的得力助手"},{"from":115.04,"to":117.38,"content":"但是大几百的价格还是有点贵"},{"from":117.38,"to":119.24,"content":"好在电商平台疯狂内卷"},{"from":119.24,"to":121.06,"content":"现在官方下血本大促"},{"from":121.06,"to":122.7,"content":"放出了好几千个名额"},{"from":122.7,"to":125.76,"content":"只要一元就有机会秒杀同款吉米工具箱"},{"from":125.76,"to":128.08,"content":"我为粉丝争取到1000个秒杀名额"},{"from":128.08,"to":129.48,"content":"之前没抢到的帖子"},{"from":129.48,"to":130.82,"content":"这次一定要抓紧"},{"from":130.82,"to":133.9,"content":"点击视频下方或评论区置顶链接开抢"},{"from":133.9,"to":135.62,"content":"只要链接在就有库存"},{"from":135.62,"to":136.38,"content":"名额有限"},{"from":136.38,"to":137.14,"content":"赶紧冲吧"},{"from":137.14,"to":138.94,"content":"说到拖车的死亡摇摆"},{"from":138.94,"to":142.06,"content":"有人在跑步机上拴着汽车模型进行观察"},{"from":142.06,"to":144.12,"content":"发现拖车的配重靠前时"},{"from":144.12,"to":145.18,"content":"一旦受到扰动"},{"from":145.18,"to":146.54,"content":"使车身出现偏斜"},{"from":146.54,"to":147.74,"content":"就可立即回正"},{"from":147.74,"to":149.68,"content":"当拖车的配重稍微后移"},{"from":149.68,"to":150.4,"content":"再次扰动"},{"from":150.4,"to":152.44,"content":"发现回正速度稍许变慢"},{"from":152.44,"to":153.68,"content":"摆动次数增加"},{"from":153.68,"to":155.22,"content":"但依然能安全行驶"},{"from":155.22,"to":156,"content":"继续后移"},{"from":156,"to":157.16,"content":"配种轻微扰动"},{"from":157.16,"to":159.98,"content":"就会使牵引车和拖车一起发散摇摆"},{"from":159.98,"to":161.26,"content":"持续震荡起来"},{"from":161.26,"to":162.14,"content":"可想而知"},{"from":162.14,"to":164.5,"content":"真正的牵引车一旦进入这样的死亡"},{"from":164.5,"to":166.36,"content":"摇摆振幅会快速增大"},{"from":166.36,"to":168.06,"content":"结果往往是失控翻车"},{"from":168.06,"to":169.16,"content":"为了进一步研究"},{"from":169.16,"to":170.34,"content":"我们来到公路上"},{"from":170.34,"to":173.02,"content":"正好有位老铁开着电动汽车出远门"},{"from":173.02,"to":174.12,"content":"为增加航程"},{"from":174.12,"to":176.32,"content":"他专门拖了一台大号发电机"},{"from":176.32,"to":177.2,"content":"边走边冲"},{"from":177.2,"to":178.6,"content":"从俯视角度观察"},{"from":178.6,"to":180.34,"content":"当牵引车快速变道时"},{"from":180.34,"to":183.06,"content":"尾部的挂钩舌头会带动拖车偏航"},{"from":183.06,"to":186.24,"content":"导致拖车轮胎和前进方向形成侧滑角"},{"from":186.24,"to":188.9,"content":"出现了和胎壁垂直的侧向抓地力"},{"from":188.9,"to":191.34,"content":"这股力量对挂钩产生了回正力矩"},{"from":191.34,"to":193.3,"content":"M根据前面总结的公式"},{"from":193.3,"to":196.12,"content":"回正力矩等于拖车对挂钩的转动惯量"},{"from":196.12,"to":197.76,"content":"乘以回正的角加速度"},{"from":197.76,"to":200.66,"content":"可见当发电机在颠簸中不断后移时"},{"from":200.66,"to":203.92,"content":"整个拖车对挂钩的转动惯量就会越来越大"},{"from":203.92,"to":205.7,"content":"使回正的角加速度减小"},{"from":205.7,"to":208.55,"content":"因此当整个拖车重心比较靠前时"},{"from":208.55,"to":209.91,"content":"牵引车突然变道"},{"from":209.91,"to":211.95,"content":"拖车就能靠较大的角加速度"},{"from":211.95,"to":214.05,"content":"快速跟随牵引车横向偏移"},{"from":214.05,"to":215.7,"content":"几乎同步完成变道"},{"from":215.7,"to":218.22,"content":"如果拖车重心向后移动一定距离"},{"from":218.22,"to":220.28,"content":"则会正脚加速度有所减小"},{"from":220.28,"to":222.12,"content":"当牵引车完成变道时"},{"from":222.12,"to":224.58,"content":"拖车因些许迟滞还在继续偏移"},{"from":224.58,"to":225.7,"content":"于是通过挂钩"},{"from":225.7,"to":228.52,"content":"对牵引车尾部施加了较小的侧向推力"},{"from":228.52,"to":232,"content":"此时司机感觉变道时车尾出现了轻微摇摆"},{"from":232,"to":234.48,"content":"但握紧方向盘依然能安全行驶"},{"from":234.48,"to":235.5,"content":"又过了一会儿"},{"from":235.5,"to":237.86,"content":"发电机被颠的后移了较大距离"},{"from":237.86,"to":240.74,"content":"造成拖车的回正角加速度显著减小"},{"from":240.74,"to":242.76,"content":"当牵引车已经完成变道时"},{"from":242.76,"to":246.2,"content":"拖车则由于回正过度迟滞而出现较大偏斜"},{"from":246.2,"to":249.42,"content":"以较强力度对回正的牵引车尾部施加推力"},{"from":249.42,"to":251.9,"content":"此时司机发现变道后回方向时"},{"from":251.9,"to":253.52,"content":"汽车出现了转向向过度"},{"from":253.52,"to":255,"content":"竟然冲向旁边车道"},{"from":255,"to":258.1,"content":"于是又大幅反向修正至车身摇摆加剧"},{"from":258.1,"to":261.1,"content":"这让跟随布吉的拖车反复横推前车"},{"from":261.1,"to":261.98,"content":"如此一来"},{"from":261.98,"to":263.48,"content":"在拖车的扰动下"},{"from":263.48,"to":266.36,"content":"司机的过度修正就和汽车的过度转向"},{"from":266.36,"to":267.68,"content":"形成了人机耦合"},{"from":267.68,"to":269.32,"content":"震荡振幅越来越大"},{"from":269.32,"to":271.05,"content":"村口随时准备开席"},{"from":271.05,"to":274.49,"content":"可见拖车重心位置是影响稳定性的重要因素"},{"from":274.49,"to":276.84,"content":"根据美国汽车工程师协会的建议"},{"from":276.84,"to":279.16,"content":"当拖车重心位于最佳区间时"},{"from":279.16,"to":281.08,"content":"挂钩舌头所承担的重量"},{"from":281.08,"to":284.28,"content":"应该在总拖曳重量的10%到15之间"},{"from":284.28,"to":286.06,"content":"如拖车重心过于靠前"},{"from":286.06,"to":287.28,"content":"则又矫枉过正"},{"from":287.28,"to":290.44,"content":"使牵引车被压的翘头前轮抓地力减弱"},{"from":290.44,"to":292.92,"content":"因此上路前复习一下角动量定理"},{"from":292.92,"to":294.98,"content":"并确保挂钩舌头重量合适"},{"from":294.98,"to":298.12,"content":"是避免拖车死亡摇摆的有效手段"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:02:28.298Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:02:25.681Z"}}
