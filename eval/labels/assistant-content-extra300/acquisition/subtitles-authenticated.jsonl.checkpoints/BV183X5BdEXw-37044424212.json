{"schemaVersion":1,"bvid":"BV183X5BdEXw","cid":37044424212,"subtitles":[{"from":0.08,"to":0.56,"content":"同志们"},{"from":0.56,"to":1.92,"content":"咱们今天讲讲小泽啊"},{"from":1.92,"to":3.58,"content":"也是好久没有讲小等等"},{"from":3.58,"to":4.78,"content":"小泽是谁来着"},{"from":4.78,"to":6.68,"content":"乌克兰的小泽哦"},{"from":6.68,"to":7.22,"content":"对对对"},{"from":7.22,"to":8.18,"content":"乌克兰的小泽"},{"from":8.18,"to":9,"content":"咱今天讲讲"},{"from":9,"to":11.82,"content":"他都知道他的情况是一天不如一天"},{"from":11.82,"to":12.7,"content":"最近更甚"},{"from":12.7,"to":14.56,"content":"为了应付中东那边的情况"},{"from":14.56,"to":17.36,"content":"美国早早的就把防空导弹调以色列去了"},{"from":17.36,"to":18.82,"content":"他花钱买也买不着"},{"from":18.82,"to":19.86,"content":"除了导弹以外"},{"from":19.86,"to":21.1,"content":"舆论也跟着转移"},{"from":21.1,"to":22.18,"content":"像23年那样"},{"from":22.18,"to":23.88,"content":"大家又把视角转回了中东"},{"from":23.88,"to":25.08,"content":"又没人管他了"},{"from":25.08,"to":29.07,"content":"气得小泽只能发视频怒斥特朗普内塔尼亚胡"},{"from":29.07,"to":30.27,"content":"我他妈弹药呢"},{"from":30.27,"to":31.81,"content":"为了重拾自己的热度"},{"from":31.81,"to":32.75,"content":"2月24日"},{"from":32.75,"to":35.14,"content":"也就是俄乌冲突四周年这天没错"},{"from":35.14,"to":38.2,"content":"不知不觉这场战争已经持续了4年之久了"},{"from":38.2,"to":40.84,"content":"在这天小泽召开了一场四周年大会"},{"from":40.84,"to":42.68,"content":"欧洲这边包括冯德莱恩"},{"from":42.68,"to":44.02,"content":"芬兰总统斯图布"},{"from":44.02,"to":45.94,"content":"丹麦首相弗雷德里克森等等"},{"from":48.44,"to":51.02,"content":"而英法德这些大国的领导人虽然没来"},{"from":51.02,"to":52.96,"content":"但他们的心与乌克兰同在"},{"from":52.96,"to":55.14,"content":"并与小泽共同召开了视频会议"},{"from":55.14,"to":55.92,"content":"商讨对策"},{"from":55.92,"to":57.64,"content":"首先是雪中送炭的事"},{"from":57.64,"to":59.78,"content":"炭欧盟短时间内肯定是送不来"},{"from":59.78,"to":61.54,"content":"但是能给俄罗斯添条血"},{"from":63.2,"to":65.8,"content":"他将通过对俄罗斯的第20轮制裁"},{"from":65.8,"to":67.86,"content":"切断普京战争资金的来源"},{"from":67.86,"to":69.04,"content":"毕竟制裁俄罗斯"},{"from":69.04,"to":70.24,"content":"让他们资金减少"},{"from":70.24,"to":72.6,"content":"这也等于变相给乌克兰援助钱了"},{"from":72.6,"to":74.2,"content":"英国一听有道理"},{"from":74.2,"to":75.62,"content":"随后斯塔默也表示"},{"from":75.62,"to":78.26,"content":"跟上将对300多家俄企实施制裁"},{"from":78.26,"to":79.58,"content":"这也是自战争以来"},{"from":79.58,"to":81.66,"content":"英国对俄规模最大的一次制裁"},{"from":81.66,"to":84.14,"content":"至于小泽那心心念的900亿贷款吧"},{"from":84.14,"to":85.38,"content":"不是欧盟不给"},{"from":85.38,"to":86.48,"content":"而是给不了"},{"from":86.48,"to":88.28,"content":"因为又被匈牙利否决了"},{"from":88.28,"to":89.86,"content":"冯大妈就对小泽表示"},{"from":89.86,"to":91.82,"content":"正所谓玉不琢不成器"},{"from":91.82,"to":93.58,"content":"可可豆不磨不称巧克力"},{"from":93.58,"to":95.32,"content":"我回去再好好劝劝匈牙利"},{"from":95.32,"to":97.34,"content":"这笔贷款我肯定会给你兑现的"},{"from":97.34,"to":97.96,"content":"放心吧"},{"from":97.96,"to":98.86,"content":"你再等两天"},{"from":98.86,"to":99.64,"content":"也是意识到"},{"from":99.64,"to":101.8,"content":"在关键时刻指望欧洲的盟友帮忙"},{"from":101.8,"to":102.82,"content":"是真指望不上"},{"from":102.82,"to":104.74,"content":"在当天接受CNN采访时"},{"from":104.74,"to":106.46,"content":"小泽又开始了呼吁美国"},{"from":108.62,"to":110.88,"content":"希望美国总统站在我们这边"},{"from":110.88,"to":112.44,"content":"因为美国实力强大"},{"from":112.44,"to":114.22,"content":"只有你们才能阻止普京"},{"from":114.22,"to":116.3,"content":"如果不阻止我们将失去一切"},{"from":116.3,"to":118.18,"content":"乌克兰所有人要么逃亡"},{"from":118.18,"to":119.86,"content":"要么只能成为俄罗斯人"},{"from":119.86,"to":122.88,"content":"那您认为美国对乌克兰的支持力度不够吗"},{"from":122.88,"to":123.48,"content":"够吗"},{"from":123.48,"to":126.46,"content":"我今年只看到美国把军事装备往中东掉"},{"from":126.46,"to":127.78,"content":"有管过乌克兰吗"},{"from":127.78,"to":129.08,"content":"他中东有犹太人"},{"from":129.08,"to":130.12,"content":"但欧洲也有啊"},{"from":130.12,"to":132.64,"content":"怎么乌克兰的犹太人就比以色列的犹太人低"},{"from":132.64,"to":134.54,"content":"等你美国管他们不管我"},{"from":134.54,"to":136.28,"content":"随着四天后2月28日"},{"from":136.28,"to":137.48,"content":"美伊以战争开打"},{"from":137.48,"to":139.06,"content":"小泽也彻底绝望了"},{"from":139.06,"to":139.88,"content":"那是夏侯敦"},{"from":140.68,"to":141.56,"content":"看李四"},{"from":141.56,"to":142.42,"content":"看商鞅"},{"from":142.42,"to":143.34,"content":"看伯邑考"},{"from":143.34,"to":144.44,"content":"别说头了"},{"from":144.44,"to":146.54,"content":"从身子到尾啥也看不着啊"},{"from":146.54,"to":148.94,"content":"中东这档子事啥时候能结束啊"},{"from":148.94,"to":152.16,"content":"可能也是为了庆祝中东那边开打搅混俄乌局势"},{"from":152.16,"to":154.62,"content":"俄罗斯在当晚也开始了大规模的发射"},{"from":157.3,"to":159.32,"content":"而这款无人机就是伊朗设计的"},{"from":159.32,"to":160.04,"content":"3月3日"},{"from":160.04,"to":161.1,"content":"小泽也抱怨称"},{"from":161.1,"to":164.18,"content":"中东战争不仅会导致乌克兰难获得防空导弹"},{"from":164.18,"to":166.16,"content":"还可能会分散盟友的注意力"},{"from":166.16,"to":167.82,"content":"从而忘记保卫乌克兰"},{"from":167.82,"to":168.98,"content":"这是一种风险"},{"from":168.98,"to":170.02,"content":"我的爱国者"},{"from":170.02,"to":173.24,"content":"我的海马斯全被以色列给我葬了呀"},{"from":173.24,"to":174.78,"content":"人家都是败家子儿"},{"from":174.78,"to":176.88,"content":"我怎么摊上个败家爷爷呀"},{"from":176.88,"to":178.4,"content":"好在我比他精明"},{"from":178.4,"to":180.04,"content":"知道把旧的拿去回血"},{"from":180.04,"to":182.44,"content":"就像我前几天换了新品宝来看剧"},{"from":182.44,"to":183.32,"content":"那台旧平板"},{"from":183.32,"to":184.64,"content":"我直接找转转上门"},{"from":184.64,"to":185.9,"content":"回收了4400多"},{"from":185.9,"to":187.54,"content":"转转是一个很好的买家"},{"from":187.54,"to":189.1,"content":"不仅回收品类丰富"},{"from":189.1,"to":190.54,"content":"而且变现特别快"},{"from":190.54,"to":193.54,"content":"像手机平板switch这种数码产品"},{"from":193.54,"to":194.58,"content":"甚至是吉他"},{"from":194.58,"to":196.7,"content":"台球杆之类不好卖的小众品类"},{"from":196.7,"to":198.58,"content":"在他那都能随时换成钱"},{"from":198.58,"to":200.78,"content":"比起之前挂网上一直卖不出去"},{"from":200.78,"to":202.9,"content":"还得跟买家斗智斗勇转转"},{"from":202.9,"to":205.96,"content":"特别适合我这种想快速变现又图省事的人"},{"from":205.96,"to":207.14,"content":"我替你们试过了"},{"from":207.14,"to":208.96,"content":"他们回收的价格也很不错"},{"from":208.96,"to":211.7,"content":"我之前那款omega还卖了2万4000多呢"},{"from":211.7,"to":213.76,"content":"要我说有懒得处理的闲置"},{"from":213.76,"to":214.98,"content":"就直接卖给转转"},{"from":214.98,"to":217.24,"content":"钱到手才是硬道理"},{"from":218.92,"to":220.44,"content":"好了我们再回到正题"},{"from":220.44,"to":221.04,"content":"一天后"},{"from":221.04,"to":221.72,"content":"3月4日"},{"from":221.72,"to":223.3,"content":"在得知美军的消耗后"},{"from":223.3,"to":224.82,"content":"小泽都有点愤怒了"},{"from":224.82,"to":225.74,"content":"他对记者称"},{"from":225.74,"to":226.76,"content":"你知道这三天"},{"from":226.76,"to":229.86,"content":"美国在中东那边使用了多少枚爱国者吗"},{"from":229.86,"to":231.58,"content":"800你没听错"},{"from":231.58,"to":233.48,"content":"是800枚爱国者"},{"from":233.48,"to":234.45,"content":"A contrary"},{"from":234.45,"to":238.03,"content":"乌克兰从未拥有过如此之多的导弹来抵御袭击"},{"from":238.03,"to":241.38,"content":"美国这三天使用的爱国者比自2022年以来"},{"from":241.38,"to":244.92,"content":"乌克兰使用过的所有导弹的数量加起来都多"},{"from":244.92,"to":247.8,"content":"而这仅仅是为了防御沙赫德型无人机"},{"from":247.8,"to":248.64,"content":"可笑吗"},{"from":248.64,"to":251.72,"content":"小泽现在的心情就好比是看着自己喜欢的美食"},{"from":251.72,"to":253.32,"content":"平时都不舍得闻一下"},{"from":253.32,"to":255.24,"content":"结果老美拿起来就喂狗了"},{"from":255.24,"to":255.92,"content":"扎铁了"},{"from":255.92,"to":258.28,"content":"老心美国的导弹肯定是有限的"},{"from":258.28,"to":259.66,"content":"所以你们可以找我呀"},{"from":259.66,"to":261.2,"content":"我帮你们防御无人机"},{"from":261.2,"to":262.18,"content":"我有秘诀的"},{"from":262.18,"to":263.06,"content":"一防一个准"},{"from":263.06,"to":265,"content":"美国把导弹分我一点好不好"},{"from":265,"to":265.78,"content":"别用光了"},{"from":265.78,"to":268.4,"content":"在得知小泽担心美军库存不足之后"},{"from":268.4,"to":270.12,"content":"董子第一时间也发文称"},{"from":270.12,"to":271.08,"content":"胡说八道"},{"from":271.08,"to":272.92,"content":"我美国的武器无穷无尽"},{"from":272.92,"to":273.56,"content":"无限量"},{"from":273.56,"to":274.74,"content":"永远也使不完"},{"from":274.74,"to":276.38,"content":"但就不给你乌克兰供应"},{"from":276.38,"to":277.2,"content":"你气不气"},{"from":277.2,"to":279.78,"content":"泽连斯基不过是个pt t巴达姆"},{"from":279.78,"to":280.56,"content":"他不配"},{"from":280.56,"to":281.46,"content":"这个巴达姆"},{"from":281.46,"to":284.34,"content":"是美国19世纪著名的马戏团老板兼骗子"},{"from":284.34,"to":285.8,"content":"懂王这话意思就是说"},{"from":285.8,"to":288.48,"content":"小泽靠着自己精彩的演技欺骗拜登"},{"from":288.48,"to":290.4,"content":"让他白白送出了大量武器"},{"from":290.4,"to":292.26,"content":"但我特朗普不会上你的当"},{"from":292.26,"to":293.3,"content":"在我的领导下"},{"from":293.3,"to":296.04,"content":"美国一直赢小赢中赢大赢"},{"from":296.04,"to":297.4,"content":"特大赢什么"},{"from":297.4,"to":299.64,"content":"你说把武器给乌克兰不叫被骗吗"},{"from":299.64,"to":300.8,"content":"那是我自愿的"},{"from":300.8,"to":301.66,"content":"能一样吗"},{"from":301.66,"to":303.08,"content":"都说我懂得卖国"},{"from":303.08,"to":304.56,"content":"但以色列没给我钱"},{"from":304.56,"to":305.74,"content":"那怎么能叫卖呢"},{"from":305.74,"to":307.7,"content":"面对中东对俄乌局势的影响"},{"from":307.7,"to":309.14,"content":"小泽方面也召开了会议"},{"from":309.14,"to":309.84,"content":"商量对策"},{"from":309.84,"to":311.9,"content":"不过他还乐观地对下属表示"},{"from":311.9,"to":314.58,"content":"虽然中东冲突导致咱的防空武器短缺"},{"from":314.58,"to":315.34,"content":"石油大涨"},{"from":315.34,"to":316.5,"content":"俄罗斯士气正旺"},{"from":316.5,"to":318.34,"content":"但我也看到了积极的一面"},{"from":318.34,"to":321.56,"content":"就是伊朗向俄国出售无人机的情况或许会停止"},{"from":321.56,"to":323.62,"content":"毕竟伊朗得紧着武器给自己用"},{"from":323.62,"to":325.98,"content":"这样俄罗斯的袭击烈度可能就会降低"},{"from":325.98,"to":327.1,"content":"倒也是个好事"},{"from":327.1,"to":329.22,"content":"但随后就有分析人士给他指出"},{"from":329.22,"to":330.92,"content":"老大你也忘了一件事"},{"from":330.92,"to":331.9,"content":"螳螂捕蝉"},{"from":331.9,"to":332.84,"content":"渔翁在后"},{"from":332.84,"to":334.16,"content":"这都什么乱七八糟的"},{"from":334.16,"to":335.32,"content":"你能不能说人话"},{"from":335.32,"to":335.98,"content":"666"},{"from":335.98,"to":336.48,"content":"您忘了"},{"from":336.48,"to":337.4,"content":"还有第二关"},{"from":337.4,"to":338.3,"content":"据我所知"},{"from":338.3,"to":340.26,"content":"伊朗已经把技术卖给俄罗斯了"},{"from":340.26,"to":343.14,"content":"也就是说俄国人在国内就能生产沙赫德"},{"from":343.14,"to":344.86,"content":"而且还是经过改良后"},{"from":344.86,"to":346.9,"content":"更适合袭击乌克兰的版本"},{"from":346.9,"to":348.02,"content":"我去你不早说"},{"from":348.02,"to":348.92,"content":"那怎么办呀"},{"from":348.92,"to":350.12,"content":"随后又有人表示"},{"from":350.12,"to":351.5,"content":"老大我有一计"},{"from":351.5,"to":353.68,"content":"但不知您敢不敢干什么"},{"from":353.68,"to":354.66,"content":"你也有计"},{"from":354.66,"to":355.88,"content":"速速与我道来"},{"from":355.88,"to":356.54,"content":"俗话说"},{"from":356.54,"to":357.18,"content":"人有多大"},{"from":357.18,"to":358.26,"content":"产地有多大胆"},{"from":358.26,"to":359.36,"content":"当年你光头强"},{"from":359.36,"to":362.04,"content":"强哥看到东北虎的第一反应不是跑"},{"from":362.04,"to":364.1,"content":"而是觉得我要卖了就发财了"},{"from":364.1,"to":365.86,"content":"所以咱们也应该干个大的"},{"from":365.86,"to":367.1,"content":"就是像海湾国家"},{"from":367.1,"to":368.44,"content":"包括美国和以色列"},{"from":368.44,"to":371.04,"content":"都提供先进的无人机技术和专业知识"},{"from":371.04,"to":373.54,"content":"这样咱们也能从中获得经济和政治利益"},{"from":376.22,"to":376.84,"content":"也表示"},{"from":376.84,"to":377.94,"content":"此计甚妙"},{"from":377.94,"to":378.86,"content":"不仅如此"},{"from":378.86,"to":381.18,"content":"咱们还可以向美国输出那么一个观点"},{"from":381.18,"to":383.94,"content":"就是即俄罗斯跟伊朗是一伙的"},{"from":383.94,"to":386.42,"content":"乌克兰不仅支持美国打击伊朗"},{"from":386.42,"to":388.86,"content":"同样还帮助美国打击伊朗的队友"},{"from":388.86,"to":389.4,"content":"俄罗斯"},{"from":389.4,"to":391.08,"content":"以此赢得白宫的青睐"},{"from":391.08,"to":391.62,"content":"这样的话"},{"from":391.62,"to":394.08,"content":"美国就不会把我们当成纯粹的伙伴"},{"from":394.08,"to":395.74,"content":"而是当成亲密的盟友"},{"from":395.74,"to":396.82,"content":"像以色列那样"},{"from":396.82,"to":399.1,"content":"但随后也有人提出了不一样的看法"},{"from":399.1,"to":400.42,"content":"你当精子傻呀"},{"from":400.42,"to":403.3,"content":"首先俄乙之间并没有正式的防务关系"},{"from":403.3,"to":404.5,"content":"普京也没有说过"},{"from":404.5,"to":406.64,"content":"在美国发动进攻时会援助伊朗"},{"from":406.64,"to":408.68,"content":"相反他甚至第一时间还给美国"},{"from":408.68,"to":410.88,"content":"以及海外国家的领导人都打去了电话"},{"from":410.88,"to":413.26,"content":"表示自己在中东这一块也能说得上话"},{"from":413.26,"to":414.46,"content":"愿意充当调解人"},{"from":414.46,"to":415.14,"content":"劝劝伊朗"},{"from":415.14,"to":415.86,"content":"也就是说"},{"from":415.86,"to":417.04,"content":"从战争一开始"},{"from":417.04,"to":418.8,"content":"普京就把自己置身事外"},{"from":418.8,"to":420.34,"content":"搞得他跟个好人一样"},{"from":420.34,"to":423,"content":"只给伊朗提供了除帮助以外的一切援助"},{"from":423,"to":425.02,"content":"没准懂得私下还谢精子呢"},{"from":425.02,"to":426.08,"content":"他能搭理你"},{"from":426.08,"to":428.08,"content":"你整的这出就好比是工头"},{"from":428.08,"to":429.98,"content":"让你把大方砖推到施工现场"},{"from":429.98,"to":432.06,"content":"结果你寻思把方砖磨圆了"},{"from":432.06,"to":433.16,"content":"推起来更省力"},{"from":433.16,"to":436.58,"content":"结果到了现场一看才发现人家建的是金字塔"},{"from":436.58,"to":438.16,"content":"随后新欧亚战略中心"},{"from":438.16,"to":440.96,"content":"外交政策负责人约翰洛夫也表示没错"},{"from":440.96,"to":444.1,"content":"普京目前的首要任务就是维护与董子的关系"},{"from":444.1,"to":447.48,"content":"并利用这种关系帮他摆脱在乌克兰陷入的困境"},{"from":447.48,"to":450.4,"content":"作为不阻挠美国在伊朗问题上行动的回报"},{"from":450.4,"to":454,"content":"他完全可以希望华盛顿对乌克兰实施更大压力"},{"from":454,"to":456.08,"content":"迫使乌克兰接受他的和平条约"},{"from":456.08,"to":458.06,"content":"至于普京的计划有没有奏效"},{"from":458.06,"to":459.82,"content":"小泽难道你就没有发现"},{"from":459.82,"to":461.82,"content":"美国最近对你逼得越来越紧"},{"from":461.82,"to":464.64,"content":"越来越强调美国武器缺少是原著"},{"from":464.64,"to":466.84,"content":"你导致的骂你是演员小丑"},{"from":466.84,"to":468.12,"content":"希望你赶紧投降"},{"from":468.12,"to":469.36,"content":"好像是这么个事儿"},{"from":469.36,"to":470.78,"content":"最后据与会者透露"},{"from":470.78,"to":473.38,"content":"这场对策商讨会开的大家都很疲惫"},{"from":473.38,"to":474.94,"content":"气氛几乎是阴郁的"},{"from":474.94,"to":477.52,"content":"所有人对美国都有一种深深的背叛感"},{"from":477.52,"to":479.46,"content":"对欧洲人的信任度也下降了"},{"from":479.46,"to":482.04,"content":"因为他们去年就说过要给乌克兰900亿"},{"from":482.04,"to":483.64,"content":"结果现在还没到账呢"},{"from":483.64,"to":485.14,"content":"还说什么投票不通过"},{"from":485.14,"to":487.6,"content":"波法德等20几个成员国都在场"},{"from":487.6,"to":489.68,"content":"却连一个小小的匈牙利都搞不定"},{"from":489.68,"to":490.64,"content":"你骗谁呢"},{"from":490.64,"to":492.8,"content":"我看他们就是故意不想给我钱"},{"from":492.8,"to":495.04,"content":"为了试探欧洲是不是不愿意给钱"},{"from":495.04,"to":497.06,"content":"匈牙利跟乌克兰到底哪个重要"},{"from":497.06,"to":499.76,"content":"小泽决定前狼假寐盖以诱敌"},{"from":499.76,"to":501.76,"content":"看我装糖阴他们一手"},{"from":501.76,"to":502.56,"content":"3月5日"},{"from":502.56,"to":505.88,"content":"小泽就给欧洲来了一场犹如春后惊雷般的演讲"},{"from":505.88,"to":506.64,"content":"他表示"},{"from":506.64,"to":509.66,"content":"欧尔班不应该阻挠欧洲向乌克兰提供资金"},{"from":509.66,"to":512.12,"content":"否则我将把他这个人的盒给开了"},{"from":512.12,"to":514.48,"content":"再把他家的地址交给我们武装部队"},{"from":514.48,"to":516.74,"content":"让士兵用自己的语言与他交流"},{"from":516.74,"to":517.32,"content":"说实话"},{"from":517.32,"to":518.64,"content":"这已经不是威胁了"},{"from":518.64,"to":519.74,"content":"简直是恐吓"},{"from":519.74,"to":521.56,"content":"随后欧尔班就对此回应称"},{"from":521.56,"to":523.18,"content":"怎么着不同意给你钱"},{"from":523.18,"to":524.74,"content":"你就要来布达大街抓我"},{"from":524.74,"to":525.72,"content":"你至于吗"},{"from":525.72,"to":527.74,"content":"我这么做都是为了匈牙利的利益"},{"from":527.74,"to":528.7,"content":"要你管呀"},{"from":528.7,"to":529.44,"content":"再说了"},{"from":529.44,"to":531.54,"content":"你有那个实力和人脉跟我斗吗"},{"from":531.54,"to":532.98,"content":"别到时候跟尹桑一样"},{"from":534.66,"to":535.26,"content":"焕过生日"},{"from":535.26,"to":536.08,"content":"喊的军官多"},{"from":536.08,"to":538.22,"content":"随后匈牙利外长瞎耳朵也表示"},{"from":539.9,"to":541.24,"content":"已经越过了所有界限"},{"from":541.24,"to":542.18,"content":"不给你钱"},{"from":542.18,"to":544.02,"content":"你还想把我们抓去填线"},{"from":544.02,"to":546.54,"content":"还让乌军用他们的语言跟我们交流"},{"from":546.54,"to":548.9,"content":"怎么我们匈牙利的语言是不通的吗"},{"from":548.9,"to":549.78,"content":"我告诉你"},{"from":549.78,"to":551.14,"content":"匈牙利不会被勒索"},{"from":551.14,"to":553.08,"content":"更不会参与泽连斯基的战争"},{"from":553.08,"to":555.82,"content":"随后欧盟发言人奥洛夫吉尔也谴责小责"},{"from":555.82,"to":557.14,"content":"称太过分了"},{"from":557.14,"to":558.04,"content":"沃尔班有问题"},{"from":558.04,"to":558.94,"content":"是他的问题"},{"from":558.94,"to":562.28,"content":"但你不应该发表这种带有煽动性威胁性的言论"},{"from":562.28,"to":563.28,"content":"张嘴闭嘴说"},{"from":563.28,"to":564.46,"content":"俄罗斯欺凌弱小"},{"from":564.46,"to":567.44,"content":"怎么现在你乌克兰开始欺凌更弱小的匈牙利了"},{"from":567.44,"to":569.32,"content":"也别说什么匈牙利不给你钱"},{"from":569.32,"to":570.48,"content":"那照你这逻辑"},{"from":570.48,"to":572.36,"content":"俄罗斯打乌克兰也能合理化了"},{"from":572.36,"to":573.6,"content":"毕竟你也没给他土地"},{"from":573.6,"to":574.96,"content":"关于援助的事"},{"from":574.96,"to":576.82,"content":"欧盟正在商讨会给钱的"},{"from":576.82,"to":578.92,"content":"但绝不允许你威胁欧盟国家"},{"from":578.92,"to":580.94,"content":"美国长辈说我们两句也就算了"},{"from":580.94,"to":582.28,"content":"反正我们也打不过你"},{"from":582.28,"to":584.46,"content":"乌克兰小辈怎敢如此放肆"},{"from":586.56,"to":587.88,"content":"也站出来支持欧尔班"},{"from":587.88,"to":591.08,"content":"并呼吁欧盟直接切断与乌克兰的一切联系"},{"from":591.08,"to":592.82,"content":"直到泽连斯基道歉为止"},{"from":592.82,"to":594.74,"content":"而且这哥们还主动开自己喝"},{"from":594.74,"to":596.92,"content":"鼓励小子把他的地址给吴俊"},{"from":596.92,"to":598.66,"content":"让乌军来匈牙利抓我呀"},{"from":598.66,"to":600.14,"content":"说起来比较抽象的是"},{"from":600.14,"to":602.36,"content":"最开始小泽觉得欧尔班太极端了"},{"from":602.36,"to":603.04,"content":"不给他钱"},{"from":603.04,"to":604.38,"content":"就想支持马扎尔"},{"from":606.18,"to":608.96,"content":"但没想到老马直接要断了与乌克兰的联系"},{"from":608.96,"to":610.96,"content":"这么看来欧尔班还是太温和了"},{"from":610.96,"to":612.8,"content":"当然匈牙利跟小泽闹到这一步"},{"from":612.8,"to":613.96,"content":"其实也怪他们自己"},{"from":613.96,"to":615.58,"content":"本来哥俩关系就不好"},{"from":615.58,"to":616.5,"content":"你就别搭理他"},{"from":616.5,"to":617.3,"content":"不就完了呗"},{"from":617.3,"to":618.14,"content":"结果1月底"},{"from":618.14,"to":619.66,"content":"德鲁日巴输油管被炸了"},{"from":619.66,"to":622.06,"content":"这条管道是苏联为了援助盟友建的"},{"from":623.44,"to":625.12,"content":"输送至匈牙利和斯洛伐克"},{"from":625.12,"to":628.12,"content":"后来俄罗斯一直通过这条线路向东欧供应石油"},{"from":628.12,"to":629.82,"content":"但小泽对此十分不满"},{"from":629.82,"to":631.72,"content":"毕竟我这正跟俄国人打账呢"},{"from":631.72,"to":632.92,"content":"你买他的商品了"},{"from":632.92,"to":634.06,"content":"他打我也就算了"},{"from":634.06,"to":635.34,"content":"还从我家门口过"},{"from":635.34,"to":636.7,"content":"那我不成牛头人了"},{"from":636.7,"to":637.86,"content":"什么你给钱啊"},{"from":637.86,"to":638.62,"content":"你给钱"},{"from":638.62,"to":640.18,"content":"那我不就不成牛头人了"},{"from":640.18,"to":641.58,"content":"所以在线路被炸之后"},{"from":641.58,"to":642.54,"content":"小泽直接宣布"},{"from":642.54,"to":643.3,"content":"这下好了"},{"from":643.3,"to":643.94,"content":"运输暂停"},{"from":643.94,"to":644.82,"content":"我不修了"},{"from":644.82,"to":646.94,"content":"除非匈牙利能同意那900亿的援助"},{"from":646.94,"to":649.97,"content":"布兰希望你们能研究出烧水就能跑的汽车哦"},{"from":649.97,"to":651.17,"content":"对于小泽的威胁"},{"from":651.17,"to":654.49,"content":"匈牙利直接反威胁停止了向乌克兰供应天然气"},{"from":654.49,"to":656.96,"content":"斯洛伐克也暂停了对乌克兰的电力供应"},{"from":656.96,"to":657.68,"content":"那行啊"},{"from":657.68,"to":659.76,"content":"我们研究烧水就能跑的汽车"},{"from":659.76,"to":662.28,"content":"你研究不用天然气就能打着火的燃气"},{"from":662.28,"to":663.9,"content":"不用电就能使用的电器"},{"from":663.9,"to":665.54,"content":"这样我们都有美好的未来"},{"from":665.54,"to":666.94,"content":"紧跟着就是3月5日"},{"from":666.94,"to":667.98,"content":"小泽威胁欧尔班"},{"from":667.98,"to":669.8,"content":"称要让乌军去敲他家门"},{"from":669.8,"to":671.72,"content":"其实小泽这小子还挺聪明的"},{"from":671.72,"to":673.78,"content":"他就知道匈牙利肯定会找他麻烦"},{"from":673.78,"to":677.16,"content":"所以立刻就下令把存在匈牙利资产都取出来"},{"from":677.16,"to":677.7,"content":"要跑路"},{"from":677.7,"to":679.56,"content":"只是没想到撞了沃尔班"},{"from":679.56,"to":681.26,"content":"他俩的想法撞一块去了"},{"from":681.26,"to":682.6,"content":"沃尔班也下令查查"},{"from":682.6,"to":684.32,"content":"乌克兰这边的资产有啥不正常"},{"from":684.32,"to":686.68,"content":"结果当时一名乌克兰前情报官员"},{"from":687.88,"to":689.72,"content":"开着两辆运钞车跑路呢"},{"from":689.72,"to":691.38,"content":"刚跑到边境口就被抓了"},{"from":691.38,"to":692.72,"content":"事后海关局一清脚"},{"from":692.72,"to":694.72,"content":"发现足足有4000万美元"},{"from":694.72,"to":697.4,"content":"3500万欧元以及9kg黄金"},{"from":697.4,"to":699.24,"content":"这笔钱还是从奥地利运来的"},{"from":699.24,"to":700.72,"content":"正准备运回乌克兰呢"},{"from":700.72,"to":701.72,"content":"被逮了个正着"},{"from":701.72,"to":702.88,"content":"至于这钱是谁的"},{"from":702.88,"to":703.44,"content":"不重要"},{"from":703.44,"to":705.02,"content":"反正现在是我匈牙利的了"},{"from":707.58,"to":709.92,"content":"正式扣押并调查乌克兰这笔资产"},{"from":709.92,"to":711.46,"content":"而小子他在得知此事后"},{"from":711.46,"to":713.2,"content":"咬牙切齿地怒斥匈牙利"},{"from":713.2,"to":715.1,"content":"你们他妈是劫匪呀"},{"from":715.1,"to":716.78,"content":"那是我的钱"},{"from":716.78,"to":719.5,"content":"乌克兰的钱还给我"},{"from":719.5,"to":722,"content":"欧盟能能能不能去管管他们"},{"from":722,"to":725.09,"content":"那都是我的钱给我我的钱"},{"from":725.09,"to":726.93,"content":"随后欧盟方面也表态称"},{"from":726.93,"to":728.35,"content":"援助的事先放一放"},{"from":728.35,"to":729.67,"content":"你先把管道给人修了"},{"from":729.67,"to":730.16,"content":"行不行"},{"from":730.16,"to":731.44,"content":"也别什么俄罗斯炸了"},{"from":731.44,"to":732.26,"content":"不关你的事"},{"from":732.26,"to":734.9,"content":"你甩锅的时候都不考虑厨子在不在旁边吗"},{"from":734.9,"to":736.28,"content":"俄罗斯他傻福啊"},{"from":736.28,"to":738.08,"content":"指望这条管道赚钱的还炸"},{"from":738.08,"to":739.42,"content":"我都不好意思点破"},{"from":739.42,"to":739.76,"content":"你"},{"from":739.76,"to":741.84,"content":"非跟匈牙利斯洛伐克杠什么"},{"from":741.84,"to":743.34,"content":"他俩一个比一个头铁"},{"from":743.34,"to":744.62,"content":"尤其是斯洛伐克"},{"from":746.98,"to":748.64,"content":"胸一枪腹两枪"},{"from":748.64,"to":749.46,"content":"手臂一枪"},{"from":749.46,"to":750.3,"content":"大腿一枪"},{"from":750.3,"to":751.9,"content":"而且是接连中五枪"},{"from":751.9,"to":754.44,"content":"屁事没有跟他妈奥特曼一样硬"},{"from":754.44,"to":756.42,"content":"我根本就劝不动他好不好"},{"from":756.42,"to":758.56,"content":"你把那破管道修了能怎么着"},{"from":758.56,"to":759.86,"content":"到时候钱也能还"},{"from":759.86,"to":760.88,"content":"你援助也能过"},{"from":760.88,"to":761.62,"content":"别杠了"},{"from":761.62,"to":763.94,"content":"孩子你听老人一句言吧"},{"from":763.94,"to":766.06,"content":"但小泽对此表示不听不听"},{"from":766.06,"to":766.78,"content":"王八念经"},{"from":766.78,"to":768.8,"content":"我不会允许俄罗斯石油供应"},{"from":768.8,"to":770.04,"content":"这是原则问题"},{"from":770.04,"to":772.98,"content":"如果我们被要求以乌克兰不获得武器为条件"},{"from":772.98,"to":774.06,"content":"那么恕我直言"},{"from":774.06,"to":775.88,"content":"在这个问题上我无能为力"},{"from":775.88,"to":777.56,"content":"因为这叫敲诈勒索"},{"from":777.56,"to":779.28,"content":"甚至可以说是强掠"},{"from":779.28,"to":780.52,"content":"你们是g ti啊"},{"from":780.52,"to":783.08,"content":"在一时的欧洲短时间内帮不上忙之后"},{"from":783.08,"to":785,"content":"小泽又把视角转移到了美国"},{"from":785,"to":787.38,"content":"看看美国在中东那边打的怎么样了吧"},{"from":787.38,"to":790.54,"content":"结果他仔细一看才发现美国这仗打的呀"},{"from":790.54,"to":792.42,"content":"一世英名毁于一旦"},{"from":792.42,"to":794.08,"content":"所以小泽干脆也表示"},{"from":794.08,"to":797.42,"content":"美国之土有科尔比米勒沃特之属"},{"from":797.42,"to":798.12,"content":"为之谋"},{"from":798.12,"to":800.12,"content":"万斯卢比奥贝森特之徒"},{"from":800.12,"to":802.74,"content":"通其皮特达里尔弗兰克之论"},{"from":802.74,"to":804.92,"content":"治骑兵今已六备之地"},{"from":804.92,"to":806.9,"content":"百万之众靠海而攻"},{"from":806.9,"to":809.86,"content":"伊伊朗开峡延敌美国之势"},{"from":809.86,"to":811.22,"content":"群寻而不敢进"},{"from":811.22,"to":812.36,"content":"令人耻笑"},{"from":813.96,"to":814.96,"content":"巧则愿为公"},{"from":814.96,"to":816.22,"content":"以出微薄之力"},{"from":816.22,"to":817.1,"content":"不置可否"},{"from":817.1,"to":819.32,"content":"而董子对此就表示叨逼叨叨逼叨"},{"from":819.32,"to":820.12,"content":"你说啥呢"},{"from":820.12,"to":821.94,"content":"美国不需要乌克兰的帮忙"},{"from":821.94,"to":823.8,"content":"这是我们自己能摆平的事"},{"from":823.8,"to":826.4,"content":"我用不着你在随后小泽在访法时"},{"from":826.4,"to":828.4,"content":"做客法国国际电视台的一档节目"},{"from":828.4,"to":829.4,"content":"主持人就问他"},{"from":829.4,"to":831.66,"content":"您认为您跟特朗普算不算朋友"},{"from":835.04,"to":835.98,"content":"鸳鸯之交"},{"from":835.98,"to":838.18,"content":"但我跟董子不可能有这种关系"},{"from":838.18,"to":839.44,"content":"他46年生人"},{"from":839.44,"to":840.72,"content":"我78年才生"},{"from":840.72,"to":842.18,"content":"我俩相差31岁"},{"from":842.18,"to":843.6,"content":"他都能当我爹了"},{"from":843.6,"to":845.32,"content":"所以我更希望他当我爹"},{"from":845.32,"to":847.36,"content":"更期待那种父子般的关系"},{"from":847.36,"to":849.92,"content":"但可惜我不是他宠爱的那个儿子"},{"from":849.92,"to":851.5,"content":"但我依然愿意帮助他"},{"from":851.5,"to":853.64,"content":"随后小泽就说自己掌握了证据"},{"from":853.64,"to":856.3,"content":"掌握了俄罗斯给伊朗提供情报的证据"},{"from":856.3,"to":858.74,"content":"普京是不希望中东那边结束冲突的"},{"from":858.74,"to":859.74,"content":"你要相信我啊"},{"from":859.74,"to":861.9,"content":"董子我可以肯定负责任的说"},{"from":861.9,"to":865.2,"content":"我泽连斯基比任何一个人都希望中东和平"},{"from":865.2,"to":866.24,"content":"你得让我帮你"},{"from":866.24,"to":867.4,"content":"然后你再帮我呀"},{"from":867.4,"to":869.08,"content":"可能是被小泽感动到了"},{"from":869.08,"to":870.62,"content":"也可能是被伊朗打傻了"},{"from":870.62,"to":873.06,"content":"董子也觉得小泽这孩子该拉拉一把"},{"from":873.06,"to":875.84,"content":"就同意乌克兰提供无人机技术帮助美国"},{"from":878.5,"to":879.54,"content":"前提是有货"},{"from":879.54,"to":882.08,"content":"随后小泽就向中东派遣了201名"},{"from":882.08,"to":883,"content":"反无人机专家"},{"from":883,"to":884.62,"content":"帮助美国作为回报"},{"from":884.62,"to":885.5,"content":"3月21日"},{"from":885.5,"to":888.48,"content":"美国允许乌克兰代表团来美商量和谈事宜"},{"from":888.48,"to":890.5,"content":"只可惜美国老是喂不熟的"},{"from":890.5,"to":891.46,"content":"3月26日"},{"from":891.46,"to":892.48,"content":"谈判结果出来了"},{"from":892.48,"to":895.52,"content":"也不知道莫斯科档案馆里到底藏了懂子啥秘密"},{"from":895.52,"to":898.56,"content":"美国方面表示愿意为基辅提供安全保障"},{"from":898.56,"to":901.04,"content":"但条件嘛我美国没啥条件"},{"from":901.04,"to":903.18,"content":"不过普京刚给我们提了些条件"},{"from":903.18,"to":905.22,"content":"准确的说是给你提了些条件"},{"from":905.22,"to":906.7,"content":"我们就负责转达一下"},{"from":906.7,"to":909.12,"content":"乌军必须撤出顿涅茨克和卢甘斯克"},{"from":909.12,"to":911.18,"content":"也不能再提收复克里米亚的事了"},{"from":911.18,"to":913.46,"content":"哪怕是在乌军的占领区内也要撤"},{"from":913.46,"to":914.96,"content":"把土地割让给俄罗斯"},{"from":914.96,"to":917.04,"content":"战后不得加入任何的军事同盟"},{"from":917.04,"to":917.54,"content":"没了"},{"from":917.54,"to":918.84,"content":"这要求可以接受吧"},{"from":918.84,"to":919.96,"content":"如果能接受的话"},{"from":919.96,"to":921.58,"content":"欧洲现在就可以获得和平"},{"from":921.58,"to":922.36,"content":"毫无疑问"},{"from":922.36,"to":925.38,"content":"俄国以上的这些要求完全在小泽的预料之中"},{"from":925.38,"to":926.84,"content":"我早预判了你的预判"},{"from":926.84,"to":930.42,"content":"