{"schemaVersion":1,"bvid":"BV11NLAz6EJ5","cid":29519252896,"subtitles":[{"from":0.06,"to":2.34,"content":"一名潜水向导带着七人动前"},{"from":2.34,"to":4.16,"content":"结果途中人越来越少"},{"from":4.16,"to":5.98,"content":"向导却始终没有察觉"},{"from":5.98,"to":8.4,"content":"等他回头看时才发现丢了四个"},{"from":8.4,"to":10.58,"content":"他赶快带着剩下的人往回赶"},{"from":10.58,"to":12.06,"content":"当他从水下出来时"},{"from":12.06,"to":12.96,"content":"心凉了半截"},{"from":12.96,"to":15.18,"content":"因为失踪的四人只有一人回来了"},{"from":15.18,"to":16.42,"content":"而这个时间点"},{"from":16.42,"to":18.66,"content":"他们的气体应该已经所剩不多"},{"from":18.66,"to":20.12,"content":"教练立刻换上气瓶"},{"from":20.12,"to":21.39,"content":"跳入水中寻找"},{"from":21.39,"to":21.83,"content":"大家好"},{"from":21.83,"to":22.85,"content":"我是失眠"},{"from":22.85,"to":24.81,"content":"欢迎观看本期的动前故事"},{"from":24.81,"to":26.8,"content":"也算是比较离谱的一期"},{"from":26.8,"to":28.38,"content":"墨西哥的尤卡坦半岛"},{"from":28.38,"to":30.4,"content":"被称为洞潜爱好者们的天堂"},{"from":30.4,"to":33.22,"content":"因为世界第一和第二强的水下洞穴系统"},{"from":33.22,"to":34.26,"content":"都分布在这里"},{"from":34.26,"to":37.26,"content":"地面的体现就是有数不胜数的天坑群"},{"from":37.26,"to":38.7,"content":"大约有6000多个"},{"from":38.7,"to":40.94,"content":"天坑之间有复杂的通道相连"},{"from":40.94,"to":43.06,"content":"里面的水最终会流入大海"},{"from":43.06,"to":44.95,"content":"跟广西的天窗略有不同"},{"from":44.95,"to":47.25,"content":"墨西哥的天坑大多不向外冒水"},{"from":47.25,"to":49.35,"content":"它们都是地面塌陷后形成的"},{"from":49.35,"to":51.19,"content":"天坑里的水质清澈透明"},{"from":51.19,"to":53.28,"content":"因此逐渐成了热门的旅游地"},{"from":53.28,"to":55.78,"content":"我们本期的故事发生在图鲁姆附近"},{"from":55.78,"to":58.98,"content":"这里有一个比较有名的天坑叫卡拉维天坑"},{"from":58.98,"to":61.769,"content":"它属于萨克阿克顿洞穴系统的一部分"},{"from":61.769,"to":64.369,"content":"SNOTE在玛雅语中的意思为水井"},{"from":64.369,"to":67.149,"content":"而卡拉维拉这个名字来源于西班牙语"},{"from":67.149,"to":68.22,"content":"意为骷髅"},{"from":68.22,"to":70.66,"content":"这是因为卡拉维天坑共有三个洞口"},{"from":70.66,"to":71.62,"content":"一大两小"},{"from":71.62,"to":73.12,"content":"当它们组合在一起时"},{"from":73.12,"to":74.7,"content":"很像是一张骷髅脸"},{"from":74.7,"to":77,"content":"因此卡拉维还有另外两个名字"},{"from":77,"to":78.44,"content":"一个是骷髅天坑"},{"from":78.44,"to":80.16,"content":"还有一个是末日神庙"},{"from":80.16,"to":82.16,"content":"曾经下面发现了很多人骨"},{"from":82.16,"to":83.6,"content":"在玛雅文明时期"},{"from":83.6,"to":84.96,"content":"这里可能是一个墓地"},{"from":84.96,"to":87.08,"content":"又或者是一个举行祭祀的地方"},{"from":87.08,"to":89.85,"content":"但现在里面的骸骨已经被清理干净"},{"from":89.85,"to":91.67,"content":"然后才慢慢变成一个景点"},{"from":91.67,"to":94.09,"content":"在这里你可以体验跳水游泳"},{"from":94.09,"to":96.2,"content":"浮潜或者是动潜洞前的话"},{"from":96.2,"to":98.18,"content":"景区规划的有一条固定线路"},{"from":98.18,"to":100.14,"content":"就是围绕着天坑转一圈"},{"from":100.14,"to":102.62,"content":"环线的深度从6米到15米不等"},{"from":102.62,"to":104.38,"content":"这个路线有永井的隐身"},{"from":104.38,"to":105.28,"content":"光线很好"},{"from":105.28,"to":106.44,"content":"整体难度也小"},{"from":106.44,"to":108.36,"content":"因此比较适合动前新手"},{"from":108.36,"to":110.72,"content":"或者是只有开放水域经验的潜水员"},{"from":110.72,"to":111.92,"content":"但刚才我们说了"},{"from":111.92,"to":115.18,"content":"卡拉维天坑属于萨克阿克顿洞穴系统的一部分"},{"from":115.18,"to":117.26,"content":"所以底下的通道都是相连的"},{"from":117.26,"to":120.28,"content":"从卡拉维这里可以直接游到数百公里之外"},{"from":120.28,"to":123.12,"content":"因为整个洞穴系统长达378km"},{"from":123.12,"to":125.2,"content":"这比从上海游到南京还要远"},{"from":125.2,"to":127.84,"content":"洞穴的深度最大时可达119米"},{"from":127.84,"to":129.28,"content":"万一在里面失踪的话"},{"from":129.28,"to":130.74,"content":"可能早都没有地方找"},{"from":130.74,"to":134.2,"content":"所以在动迁时偏离主线的话将会非常危险"},{"from":134.2,"to":136.72,"content":"景区也在每个分岔口设立了警示牌"},{"from":136.72,"to":138.459,"content":"但有些人偏不信邪"},{"from":138.459,"to":140.559,"content":"因为几名当事人都不愿透露姓名"},{"from":140.559,"to":142.599,"content":"所以后来的新闻报道使用了化名"},{"from":142.599,"to":144.26,"content":"我们这里也是如此"},{"from":144.26,"to":146.56,"content":"哈里与玛丽是一对墨西哥夫妻"},{"from":146.56,"to":149.34,"content":"两人在墨西哥的克苏美尔开了一家潜水店"},{"from":149.34,"to":150.7,"content":"1995年的夏天"},{"from":150.7,"to":152.96,"content":"他们接到了许多外国游客的电话"},{"from":152.96,"to":155.44,"content":"这些人预定了图鲁姆附近的潜水项目"},{"from":155.44,"to":156.86,"content":"可夫妻俩却犯了难"},{"from":156.86,"to":159.01,"content":"因为他们都是开放水域的潜水员"},{"from":159.01,"to":160.15,"content":"没有动前经验"},{"from":160.15,"to":161.45,"content":"但生意好不容易来了"},{"from":161.45,"to":162.37,"content":"也不想丢掉"},{"from":162.37,"to":165.17,"content":"于是他们就来图鲁姆聘请了一位动前向导"},{"from":165.17,"to":166.82,"content":"这名向导叫胡安可"},{"from":166.82,"to":169.46,"content":"事实上胡安虽然对这些洞穴很熟悉"},{"from":169.46,"to":171.58,"content":"可他也没有动钱方面的知识"},{"from":171.58,"to":173.18,"content":"那为什么还要找他呢"},{"from":173.18,"to":174.66,"content":"答案也很简单啊"},{"from":174.66,"to":175.42,"content":"就是便宜"},{"from":175.42,"to":177.38,"content":"但这种事还考虑省钱的话"},{"from":177.38,"to":178.48,"content":"将会非常危险"},{"from":178.48,"to":180.3,"content":"那什么时候可以省钱呢"},{"from":180.3,"to":181.9,"content":"比如我们换手机的时候"},{"from":181.9,"to":183.96,"content":"大家买了新的旧的都怎么处理呢"},{"from":183.96,"to":185.42,"content":"像我那台IPHONE13"},{"from":185.42,"to":187.88,"content":"旧的转转上门回收了2500多"},{"from":187.88,"to":189.79,"content":"转转提供优质的回收服务"},{"from":189.79,"to":191.95,"content":"所有回收师都经过严格培训"},{"from":191.95,"to":193.4,"content":"全程标准化验机"},{"from":193.4,"to":194.1,"content":"当面报价"},{"from":194.1,"to":194.96,"content":"现场打钱"},{"from":194.96,"to":196.44,"content":"而且只要我定了时间"},{"from":196.44,"to":198.32,"content":"回收师最快一小时上门"},{"from":198.32,"to":200.67,"content":"不管是写字楼还是住宅区都能来"},{"from":200.67,"to":202.43,"content":"现在转转还不止收手机"},{"from":202.43,"to":204.39,"content":"就连我闲置吃灰很久的平板"},{"from":204.39,"to":205.87,"content":"没用过几次的笔记本"},{"from":205.87,"to":207.66,"content":"都能随时呼叫转转上门"},{"from":207.66,"to":210.56,"content":"特别适合我这种想卖闲置又怕麻烦的人"},{"from":210.56,"to":212.06,"content":"现在打开转转app"},{"from":212.06,"to":213.34,"content":"搜索11472"},{"from":213.34,"to":215.3,"content":"领取580元回收红包"},{"from":215.3,"to":217.38,"content":"手机平板笔记本全都加价"},{"from":217.38,"to":217.68,"content":"手"},{"from":217.68,"to":219.14,"content":"赶紧上转转google价吧"},{"from":219.14,"to":219.82,"content":"说完转转"},{"from":219.82,"to":221.48,"content":"我们正式进入洞穴探险"},{"from":221.48,"to":223.34,"content":"1995年8月17日"},{"from":223.34,"to":225.88,"content":"哈里夫妇带着另外五名游客到图鲁姆"},{"from":225.88,"to":226.9,"content":"跟胡安会合"},{"from":226.9,"to":229.08,"content":"这五名游客有三个是荷兰人"},{"from":229.08,"to":231.04,"content":"一个意大利人和一个美国人"},{"from":231.04,"to":234.36,"content":"上午他们在另一个天坑潜水了一个多小时之后"},{"from":234.36,"to":235.36,"content":"才来到卡拉维"},{"from":235.36,"to":235.8,"content":"天坑"},{"from":235.8,"to":238.14,"content":"洞口有架梯子作为出入口使用"},{"from":238.14,"to":240.32,"content":"但人们下去时都喜欢直接跳"},{"from":240.32,"to":241.94,"content":"胡安第一个下去之后"},{"from":241.94,"to":242.88,"content":"其他人跟上"},{"from":242.88,"to":244.14,"content":"按照最初的计划"},{"from":244.14,"to":245.34,"content":"它们只在主区域"},{"from":245.34,"to":247.02,"content":"也就是环形线路潜水"},{"from":247.02,"to":249.68,"content":"这个环形路线半径为366米"},{"from":249.68,"to":250.94,"content":"最深处15米"},{"from":250.94,"to":253.22,"content":"许多游客甚至经验丰富的潜水员"},{"from":253.22,"to":254.54,"content":"都是待在这个范围"},{"from":254.54,"to":256.02,"content":"但胡安另有打算"},{"from":256.02,"to":258.06,"content":"他决定带着众人穿过警戒线"},{"from":258.06,"to":259.56,"content":"到洞穴的深处看看"},{"from":259.56,"to":261.04,"content":"通道内环绕着石灰岩"},{"from":261.04,"to":261.94,"content":"墙壁和柱子"},{"from":261.94,"to":262.84,"content":"景色很美"},{"from":262.84,"to":264.5,"content":"但越往里光线越暗"},{"from":264.5,"to":265.98,"content":"水温也逐渐下降"},{"from":265.98,"to":268.49,"content":"因此潜水店的老马哈里感到了不安"},{"from":268.49,"to":269.77,"content":"他没有动线经验"},{"from":269.77,"to":271.67,"content":"觉得这样盲目进去会有危险"},{"from":271.67,"to":273.18,"content":"于是他就停了下来"},{"from":273.18,"to":274.82,"content":"他本想喊出妻子玛丽"},{"from":274.82,"to":277.04,"content":"但玛丽已经跟着前面的人有远"},{"from":277.04,"to":278.58,"content":"于是哈里就自己退了"},{"from":278.58,"to":279.46,"content":"回来之后"},{"from":279.46,"to":280.92,"content":"他就在入口等着几人"},{"from":280.92,"to":283.66,"content":"而胡安带着剩下的六人还在往前游"},{"from":283.66,"to":286.31,"content":"期间他一次也没有回头检查人数"},{"from":286.31,"to":288.75,"content":"忽然他们的视线开始模糊起来"},{"from":288.75,"to":290.9,"content":"这是因为他们进入了盐月城"},{"from":290.9,"to":294.3,"content":"所谓盐跃层是指有显著含盐度变化的水层"},{"from":294.3,"to":295.94,"content":"卡拉维天坑靠近海边"},{"from":295.94,"to":296.66,"content":"洞里的水"},{"from":296.66,"to":297.26,"content":"既有淡水"},{"from":297.26,"to":298.02,"content":"又有海水"},{"from":298.02,"to":299.52,"content":"一般海水位于下层"},{"from":299.52,"to":300.68,"content":"淡水位于上层"},{"from":300.68,"to":302.54,"content":"就跟油和水混合时类似"},{"from":302.54,"to":304.28,"content":"当潜水员进入交融层时"},{"from":304.28,"to":305.76,"content":"光线就会发生变化"},{"from":305.76,"to":307.66,"content":"所以视线也开始变得模糊"},{"from":307.66,"to":310.5,"content":"这种现象让剩下的游客开始惊慌起来"},{"from":310.5,"to":312.76,"content":"但胡安却根本没有停下来的意思"},{"from":312.76,"to":314.539,"content":"他依然在带头往前游"},{"from":314.539,"to":315.419,"content":"十几分钟后"},{"from":315.419,"to":316.679,"content":"胡安终于停了下来"},{"from":316.679,"to":319.379,"content":"因为他发现自己的气体已经所剩不多"},{"from":319.379,"to":320.92,"content":"是时候掉头回去了"},{"from":320.92,"to":322.48,"content":"可他刚一回头就惊呆了"},{"from":322.48,"to":324.1,"content":"因为后面只剩三个人了"},{"from":324.1,"to":326.6,"content":"分别是两名荷兰人和一个意大利人"},{"from":326.6,"to":328.08,"content":"胡安感到情况不妙"},{"from":328.08,"to":329.38,"content":"怎么一下少了四个"},{"from":329.38,"to":332.24,"content":"他赶快示意三人跟着自己往回游回去"},{"from":332.24,"to":333.58,"content":"这一路倒没有什么意外"},{"from":333.58,"to":335.61,"content":"四人很快就回到了入口处"},{"from":335.61,"to":338.21,"content":"这时哈里依然还在那里等着胡安问"},{"from":338.21,"to":338.41,"content":"他"},{"from":338.41,"to":339.49,"content":"还有没有人上来"},{"from":339.49,"to":340.43,"content":"哈利说没有"},{"from":340.43,"to":342.12,"content":"之后胡安就不再说话"},{"from":342.12,"to":343.42,"content":"他会带上哈里的气瓶"},{"from":343.42,"to":344.54,"content":"立刻下去寻找"},{"from":344.54,"to":345.08,"content":"其他人"},{"from":345.08,"to":346.78,"content":"则爬出天坑报警求助"},{"from":346.78,"to":349.06,"content":"胡安从刚才出来的路线往内寻找"},{"from":349.06,"to":350.5,"content":"但一直到掉头的地方"},{"from":350.5,"to":351.74,"content":"也没有发现人影"},{"from":351.74,"to":352.9,"content":"接着湖湾转弯"},{"from":352.9,"to":354.04,"content":"进入下方通道"},{"from":354.04,"to":355.26,"content":"仅仅56分钟后"},{"from":355.26,"to":356.58,"content":"他就发现了两个人"},{"from":356.58,"to":358.6,"content":"一名荷兰人和一名美国人"},{"from":358.6,"to":359.34,"content":"可惜的是"},{"from":359.34,"to":360.64,"content":"两人都已经死亡"},{"from":360.64,"to":361.96,"content":"他们的气瓶已空"},{"from":361.96,"to":363.86,"content":"呼吸调节器在一边飘着"},{"from":363.86,"to":364.88,"content":"胡安没做停留"},{"from":364.88,"to":365.68,"content":"继续往前"},{"from":365.68,"to":367.8,"content":"因为还有一名墨西哥人没有找到"},{"from":367.8,"to":369.52,"content":"也就是哈里的妻子玛丽"},{"from":369.52,"to":370.24,"content":"几分钟后"},{"from":370.24,"to":372.04,"content":"胡安看到前方有灯光在闪"},{"from":372.04,"to":373.56,"content":"他立刻游过去查看"},{"from":373.56,"to":374.84,"content":"发现正是玛丽"},{"from":374.84,"to":376.48,"content":"只不过他已经失去意识"},{"from":376.48,"to":378,"content":"正在那里不停的抽搐"},{"from":378,"to":380.02,"content":"呼吸调节器也从嘴里脱落"},{"from":380.02,"to":382.92,"content":"这些迹象表明他的气体应该是刚刚用完"},{"from":382.92,"to":383.58,"content":"没多久"},{"from":383.58,"to":385.94,"content":"胡安立刻把备用调节器塞他嘴里"},{"from":385.94,"to":387.98,"content":"但玛丽已经没有了呼吸动作"},{"from":387.98,"to":389.06,"content":"胡安不再犹豫"},{"from":389.06,"to":390.85,"content":"立刻拖着他往出口游"},{"from":390.85,"to":392.75,"content":"当他和玛丽露出水面后"},{"from":392.75,"to":395.64,"content":"哈里帮忙拖着玛丽从梯子爬了出去之后"},{"from":395.64,"to":397.34,"content":"又迅速给他做心肺复苏"},{"from":397.34,"to":398.08,"content":"几分钟后"},{"from":398.08,"to":399,"content":"救护车赶到"},{"from":399,"to":400.76,"content":"玛丽被送到附近医院抢救"},{"from":400.76,"to":402.1,"content":"但还是晚了一步"},{"from":402.1,"to":403.78,"content":"玛丽最终死在了医院里"},{"from":403.78,"to":404.62,"content":"当天晚上"},{"from":404.62,"to":406.42,"content":"另外两人也被打捞上来"},{"from":406.42,"to":408.64,"content":"胡安等人被带到警局接受询问"},{"from":408.64,"to":409.56,"content":"对于这起事故"},{"from":409.56,"to":410.8,"content":"当地人非常愤怒"},{"from":410.8,"to":413.58,"content":"因为胡安的行为严重影响了当地的旅游业"},{"from":413.58,"to":416.72,"content":"他们认为胡安至少应该被判过失杀人罪"},{"from":416.72,"to":418.78,"content":"但几天后胡安被无罪释放"},{"from":418.78,"to":419.82,"content":"关于这起事故"},{"from":419.82,"to":421.57,"content":"警方也给出了自己的推测"},{"from":421.57,"to":423.43,"content":"八人在环线内游了一圈后"},{"from":423.43,"to":425.57,"content":"胡安开始带他们进入洞穴深处"},{"from":425.57,"to":426.71,"content":"结果刚游几米"},{"from":426.71,"to":428.67,"content":"哈里就因为恐惧退了出去"},{"from":428.67,"to":429.78,"content":"又游了一段后"},{"from":429.78,"to":432.24,"content":"或许玛丽发现丈夫没有在后面跟着"},{"from":432.24,"to":433.7,"content":"于是她就掉头去找"},{"from":433.7,"to":434.34,"content":"另外两人"},{"from":434.34,"to":435.8,"content":"看见后也跟着往回游"},{"from":435.8,"to":438.289,"content":"因为他们不清楚胡安要带他们去哪里"},{"from":438.289,"to":440.309,"content":"结果他们游到岔路口时迷了路"},{"from":440.309,"to":442.629,"content":"三人在下方通道来回寻找出口"},{"from":442.629,"to":444.62,"content":"最终气体一个一个耗尽"},{"from":444.62,"to":445.66,"content":"从结果来看"},{"from":445.66,"to":447.92,"content":"如果他们三人一直跟着胡安往前游"},{"from":447.92,"to":449.59,"content":"最后应该也不会出事"},{"from":449.59,"to":451.95,"content":"因为跟着胡安的三人都安全返回了"},{"from":451.95,"to":454.16,"content":"胡安之前也确实经常这么做"},{"from":454.16,"to":455.9,"content":"但这并不能说他没有责任"},{"from":455.9,"to":457.78,"content":"反而他的责任还是最大的"},{"from":457.78,"to":459.58,"content":"因为他犯了几个严重错误"},{"from":459.58,"to":461.76,"content":"第一个没有动钱方面的资格证书"},{"from":461.76,"to":462.73,"content":"就不多说了"},{"from":462.73,"to":464.51,"content":"第二个违反了三分法则"},{"from":464.51,"to":466.03,"content":"他带人掉头回去时"},{"from":466.03,"to":467.81,"content":"气体只剩1/3左右"},{"from":467.81,"to":469.65,"content":"而根据三分法则的要求"},{"from":469.65,"to":471.96,"content":"剩余2/3时就应该回去了"},{"from":471.96,"to":473.42,"content":"第三个装备不大"},{"from":473.42,"to":475.8,"content":"巴人用的都是开放水域的潜水设备"},{"from":475.8,"to":478.1,"content":"他们无法适应复杂的洞穴环境"},{"from":478.1,"to":479.6,"content":"第四个缺乏训练"},{"from":479.6,"to":482,"content":"不管是向导还是游客都是如此"},{"from":482,"to":483.42,"content":"向导铁着头往前游"},{"from":483.42,"to":484.38,"content":"不管后面的人"},{"from":484.38,"to":486.22,"content":"而游客也随意脱离队伍"},{"from":486.22,"to":487.02,"content":"比如哈里"},{"from":487.02,"to":489.18,"content":"你聘请的向导却又不信任向导"},{"from":489.18,"to":490.88,"content":"我们无法确认他的推错"},{"from":490.88,"to":493.24,"content":"在多大程度上影响了其他人的决定"},{"from":493.24,"to":495.98,"content":"但不打招呼就脱离队伍也有很大问题"},{"from":495.98,"to":498.14,"content":"第五个其实也跟第四个有关"},{"from":498.14,"to":500.14,"content":"同时也是最严重的一个错误"},{"from":500.14,"to":501,"content":"正常来讲"},{"from":501,"to":502.64,"content":"一名向导最多带三个人"},{"from":502.64,"to":504.56,"content":"也就是四人队伍才更安全"},{"from":504.56,"to":506.52,"content":"可胡安却独自带了七个人"},{"from":506.52,"to":509.63,"content":"在队伍的末尾也没有安排一名向导保证安全"},{"from":509.63,"to":512.17,"content":"或许胡安觉得哈里会承担这个角色"},{"from":512.17,"to":514.19,"content":"但没想到哈里自己退出去了"},{"from":514.19,"to":515.64,"content":"在这起事故发生以后"},{"from":515.64,"to":518.96,"content":"尤卡坦半岛针对动前制定了新的安全政策和程"},{"from":518.96,"to":520.04,"content":"序要求之后"},{"from":520.04,"to":522.12,"content":"类似的事故也就很少出现了"},{"from":522.12,"to":524.62,"content":"这里呀也提醒下喜欢动潜的朋友们"},{"from":524.62,"to":527.32,"content":"如果你的技术和相应的认证还没有达到"},{"from":527.32,"to":529.54,"content":"那么当你在水下看到禁止标志时"},{"from":529.54,"to":530.96,"content":"最好不要进去查看"},{"from":530.96,"to":533.5,"content":"那里之所以会有这种牌子是有原因的"},{"from":533.5,"to":534.26,"content":"在洞前时"},{"from":534.26,"to":535.3,"content":"一旦出现意外"},{"from":535.3,"to":537.78,"content":"生与死的间隔往往只有23分钟"},{"from":537.78,"to":538.36,"content":"好了"},{"from":538.36,"to":540.62,"content":"那本期视频到这里就全部结束了"},{"from":540.62,"to":541.72,"content":"感谢各位的观看"},{"from":541.72,"to":543.14,"content":"我们下期再见"}],"chapters":[{"from":0,"to":27,"content":"引子"},{"from":27,"to":222,"content":"洞穴背景"},{"from":222,"to":409,"content":"过程"},{"from":409,"to":544,"content":"后续"}],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:01:20.666Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"available","chaptersFetchedAt":"2026-10-04T23:01:18.169Z"}}
