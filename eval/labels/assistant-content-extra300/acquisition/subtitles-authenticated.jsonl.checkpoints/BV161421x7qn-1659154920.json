{"schemaVersion":1,"bvid":"BV161421x7qn","cid":1659154920,"subtitles":[{"from":0.08,"to":1.92,"content":"最喜欢的一集被拍得乌漆嘛"},{"from":1.92,"to":4.24,"content":"黑多少精彩细节惨遭无情删减多少"},{"from":4.24,"to":5.82,"content":"关键剧情被一镜带过"},{"from":5.82,"to":7.98,"content":"哈利波特与混血王子到底讲了个什么故事"},{"from":7.98,"to":8.74,"content":"原著细节整理"},{"from":8.74,"to":9.26,"content":"第四集"},{"from":9.26,"to":11.26,"content":"我们现在开始上集"},{"from":11.26,"to":13.86,"content":"结尾讲到harry与邓笑探访少年伏地魔"},{"from":13.86,"to":15.64,"content":"结束从孤儿院记忆中归来"},{"from":15.64,"to":17.48,"content":"转天海瑞就在邓校的同意下"},{"from":17.48,"to":18.84,"content":"把这件事告诉罗恩赫敏了"},{"from":18.84,"to":20.6,"content":"只不过是在草药课上偷偷说的"},{"from":20.6,"to":22.3,"content":"赫米认为尽量了解伏地魔的背景"},{"from":22.3,"to":22.98,"content":"很有必要"},{"from":22.98,"to":24.26,"content":"对伏地魔的了解越深"},{"from":24.26,"to":25.66,"content":"就越能探明他的弱点"},{"from":25.66,"to":27.34,"content":"对未来的战斗是非常有意义的"},{"from":27.34,"to":29.92,"content":"而罗恩觉得嚯小孩神秘人私密"},{"from":29.92,"to":30.44,"content":"小孩啊"},{"from":30.44,"to":31.08,"content":"太刺激了"},{"from":31.08,"to":31.96,"content":"因为在课上说话"},{"from":31.96,"to":33.88,"content":"所以三个人都被斯普劳特教授给批了"},{"from":33.88,"to":36.28,"content":"这节课的内容是采摘疙瘩藤的浆果"},{"from":36.28,"to":37.02,"content":"并给它榨汁"},{"from":37.02,"to":39.36,"content":"疙瘩藤是一种平时看上去像个枯树藤"},{"from":39.36,"to":42.379,"content":"但一被触碰就会伸出藤蔓抽人的危险植物"},{"from":42.379,"to":44.219,"content":"取家果这道工序很困难"},{"from":44.219,"to":45.819,"content":"要好几个人配合才能完成"},{"from":45.819,"to":47.019,"content":"三人组因为上课说话"},{"from":47.019,"to":48.32,"content":"所以进度落后了很多"},{"from":48.32,"to":50.12,"content":"第一个成功拿到伽古的是NAVI"},{"from":50.12,"to":51.12,"content":"但是被抽的很惨啊"},{"from":51.12,"to":51.8,"content":"头破血流的"},{"from":51.8,"to":53,"content":"在这节草药课上"},{"from":53,"to":55.62,"content":"赫敏还和他俩分享了鼻涕虫俱乐部的一些细节"},{"from":55.62,"to":58.26,"content":"因为原著中harry前期并没有去参加那些宴"},{"from":58.26,"to":59.42,"content":"都是赫敏一个人去的"},{"from":59.42,"to":61.34,"content":"赫敏自己觉得比利城俱乐部还挺有意思"},{"from":61.34,"to":63.34,"content":"因为每次去菜确实都挺好吃的"},{"from":63.34,"to":64.14,"content":"而且还能认识"},{"from":64.14,"to":66.1,"content":"诸如魁地奇联赛球队队长这种名人"},{"from":66.1,"to":68.38,"content":"斯拉格霍恩还委托赫敏再次邀请harry"},{"from":68.38,"to":69.28,"content":"务必要让他到场"},{"from":69.28,"to":69.66,"content":"他不来"},{"from":69.66,"to":70.38,"content":"下次就不开了"},{"from":70.38,"to":71.86,"content":"一旁的罗恩听了这话有点生气"},{"from":71.86,"to":73.52,"content":"给伽果榨汁时过于用力"},{"from":73.52,"to":75.24,"content":"结果从他手里滋溜一声飞出去了"},{"from":75.24,"to":76.32,"content":"harry去捡的时候"},{"from":76.32,"to":78.8,"content":"罗恩因为吃麦克拉根的醋和赫敏吵了一小架"},{"from":81.44,"to":82.2,"content":"成王后"},{"from":82.2,"to":83.6,"content":"harry听到后还暗自希望"},{"from":83.6,"to":85.4,"content":"哎刚才那个家伙能飞远点就好了"},{"from":85.4,"to":86.94,"content":"我多跑两步也不想听他俩吵"},{"from":86.94,"to":87.8,"content":"但是赫敏回答说"},{"from":87.8,"to":89.74,"content":"嘿我还准备邀请你跟我一起去参加呢"},{"from":89.74,"to":90.82,"content":"你情愿我跟麦克拉肯好"},{"from":90.82,"to":91.62,"content":"那我就不费事了"},{"from":91.62,"to":93.14,"content":"罗恩美滋滋的小声回答了一句"},{"from":93.14,"to":94.3,"content":"要是我不情愿呢"},{"from":94.3,"to":95.78,"content":"而原著中也就是在这里"},{"from":95.78,"to":98.7,"content":"harry正式确认了赫敏和罗恩是互有情愫的"},{"from":98.7,"to":99.9,"content":"他其实并不怎么吃惊"},{"from":99.9,"to":102.1,"content":"因为这俩人这么多年早就有那种意思了"},{"from":102.1,"to":104.06,"content":"他担心的是他俩要是分手怎么办"},{"from":104.06,"to":106.52,"content":"那情况岂不是变成ross and rachel and另外那四个人"},{"from":106.52,"to":108.68,"content":"或者是他俩要谈起恋爱来过于黏糊"},{"from":108.68,"to":109.68,"content":"像比尔和芙蓉那样"},{"from":109.68,"to":110.82,"content":"自己肯定要被疏远"},{"from":110.82,"to":112.4,"content":"不过harry还是选择不插手"},{"from":112.4,"to":113.56,"content":"他俩的事静观其变"},{"from":113.56,"to":114.24,"content":"暗自期待"},{"from":114.24,"to":115.68,"content":"这俩人在斯拉克婚的宴会上"},{"from":115.68,"to":117.7,"content":"几杯黄油啤酒下肚后会发生些什么"},{"from":117.7,"to":119.58,"content":"赫敏在电影里编的这些小金丝雀"},{"from":119.58,"to":120.18,"content":"挺有意思吧"},{"from":120.18,"to":122.38,"content":"原著中这其实是变形课的课堂任务"},{"from":122.38,"to":124.24,"content":"目前全班只有赫敏能成功变出来"},{"from":124.24,"to":125.56,"content":"其他人连毛都变不出来"},{"from":125.56,"to":127.36,"content":"原著里这些小黄鸟都是真的啊"},{"from":127.36,"to":128.04,"content":"吃食喝水"},{"from":128.04,"to":128.98,"content":"拉鸟屎一样不拉"},{"from":128.98,"to":131.439,"content":"kelly bell因为项链事件还在医院住着"},{"from":131.439,"to":131.959,"content":"也就是说"},{"from":131.959,"to":134.559,"content":"harry好不容易选出的新魁地奇球队还没比赛"},{"from":134.559,"to":135.799,"content":"就突然少了一名主力"},{"from":135.799,"to":137.199,"content":"所以他就在变形课之后"},{"from":137.199,"to":138.719,"content":"找到了在追求手选拔赛中"},{"from":138.719,"to":140.88,"content":"表现仅次于三位女队员的爹迪彦"},{"from":140.88,"to":142.28,"content":"这会儿还是金靖的男朋友呢"},{"from":142.28,"to":143.68,"content":"harry虽然看着有点不太顺眼"},{"from":143.68,"to":145.18,"content":"但还是直接邀请了她入队"},{"from":145.18,"to":145.96,"content":"harry你要这样"},{"from":145.96,"to":146.84,"content":"你真是爷们儿啊"},{"from":146.84,"to":147.4,"content":"纯爷们儿"},{"from":147.4,"to":148.72,"content":"但西莫对此事不太满意"},{"from":148.72,"to":149.98,"content":"还给迪安和harry甩脸子"},{"from":149.98,"to":151.82,"content":"因为他当初也参加了选拔"},{"from":151.82,"to":153,"content":"只不过飞的没有点好"},{"from":153,"to":153.94,"content":"更尴尬的是"},{"from":153.94,"to":155.14,"content":"失去追求手机会的西蒙"},{"from":155.14,"to":157.1,"content":"还当场被赫敏的金丝雀拉了一坨鸟屎"},{"from":157.1,"to":159.22,"content":"为了备战赛季和蛇院的第一场比赛"},{"from":159.22,"to":160.74,"content":"也为了磨合替补球员DN"},{"from":160.74,"to":163.14,"content":"所以harry在当天晚上就进行了突击训练"},{"from":163.14,"to":163.86,"content":"包括DN"},{"from":163.86,"to":165.06,"content":"大家表现的都很好啊"},{"from":165.06,"to":165.98,"content":"当然除了我们的王"},{"from":165.98,"to":167.34,"content":"也就是关键时刻扛大旗"},{"from":167.34,"to":168.8,"content":"但平时疯狂掉链子轮"},{"from":168.8,"to":170.88,"content":"伦恩在训练赛上一连漏了六个球"},{"from":170.88,"to":171.8,"content":"最后还痛击队友"},{"from":171.8,"to":173.93,"content":"把新追球手德米尔扎的嘴给打破了"},{"from":173.93,"to":175.61,"content":"JY气的直骂他哥是草包"},{"from":175.61,"to":177.01,"content":"但是队长harry表面严肃"},{"from":177.01,"to":178.39,"content":"实则憋笑的制止了JY"},{"from":178.39,"to":179.74,"content":"还治好了德梅尔扎的嘴"},{"from":179.74,"to":180.66,"content":"训练结束后"},{"from":180.66,"to":181.82,"content":"harry和罗恩回到城堡"},{"from":181.82,"to":183.9,"content":"harry在通往格兰芬多塔楼的一条路上"},{"from":183.9,"to":186.6,"content":"正好撞到了在这里约会亲嘴的基尼和DAN"},{"from":186.6,"to":188,"content":"harry当时都要爆炸了"},{"from":188,"to":188.84,"content":"只要梳理原话"},{"from":188.84,"to":190.24,"content":"都想把DN变成果冻了"},{"from":190.24,"to":191.86,"content":"但是他表面上没有什么波澜"},{"from":191.86,"to":193.76,"content":"反倒是亲哥罗恩大发雷霆"},{"from":193.76,"to":196.56,"content":"他大声指责金妮不该在大庭广众下搂搂抱抱"},{"from":196.56,"to":197.22,"content":"成何体统"},{"from":197.22,"to":198.04,"content":"还含沙射影"},{"from":198.04,"to":199.48,"content":"说妹妹这是行为不减"},{"from":199.48,"to":200.96,"content":"DIAN非常尴尬的离开了"},{"from":200.96,"to":202.64,"content":"而JY开始愤怒的冷嘲热讽"},{"from":202.64,"to":203.9,"content":"罗恩说他管不着自己"},{"from":203.9,"to":205.04,"content":"还说罗恩长这么大"},{"from":205.04,"to":206.24,"content":"从来没和别人亲过嘴"},{"from":206.24,"to":207.96,"content":"harry亲过秋赫敏亲过克鲁姆"},{"from":207.96,"to":209.6,"content":"但唯一亲过罗恩的只有猫头鹰"},{"from":209.6,"to":211.04,"content":"小猪和他们的mil1婆"},{"from":211.04,"to":212.16,"content":"实在是太可悲了"},{"from":212.16,"to":212.92,"content":"用现在的话讲"},{"from":212.92,"to":214.34,"content":"就是一个非自愿单身人士"},{"from":214.34,"to":215.94,"content":"兄妹俩在走廊里大吵一架"},{"from":215.94,"to":218.18,"content":"罗恩生气的都抽出魔杖朝妹妹念恶咒了"},{"from":218.18,"to":219.54,"content":"还好有harry拉着没打中"},{"from":219.54,"to":220.4,"content":"争吵平后"},{"from":220.4,"to":222.3,"content":"海瑞罗恩各自烦恼都没怎么说话"},{"from":222.3,"to":223.56,"content":"harry满脑子都是金妮"},{"from":223.56,"to":226.23,"content":"而罗恩一直在琢磨赫敏到底有没有亲过克鲁姆"},{"from":226.23,"to":227.63,"content":"这里其实值得深究一下"},{"from":227.63,"to":228.51,"content":"有两种可能"},{"from":228.51,"to":230.21,"content":"第一种赫敏克鲁姆没有接过吻"},{"from":230.21,"to":231.3,"content":"仅仅瞎说的被气"},{"from":231.3,"to":231.66,"content":"罗恩呢"},{"from":231.66,"to":233.14,"content":"第二种就是确实亲过"},{"from":233.14,"to":234.22,"content":"可能是在圣诞舞会"},{"from":234.22,"to":236.1,"content":"也可能