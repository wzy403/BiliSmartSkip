.77,"content":"穿阿玛尼定制西装出入高级酒店及夜总会"},{"from":448.77,"to":450.69,"content":"对金发美女召之即来"},{"from":450.69,"to":452.98,"content":"不过他却是个变态杀人狂"},{"from":452.98,"to":455.38,"content":"优雅的听完唱片后就穿上雨衣"},{"from":455.38,"to":456.19,"content":"抡起斧头"},{"from":456.19,"to":457.72,"content":"一边跳舞一边杀人"},{"from":457.72,"to":459.07,"content":"管你是美女还是谁"},{"from":459.07,"to":460,"content":"照杀不误"},{"from":460,"to":463.44,"content":"基努里维斯扮演的角色同样西格玛指数爆表"},{"from":463.44,"to":465.42,"content":"2077里的强尼银手"},{"from":465.42,"to":467.26,"content":"极速追杀里的约翰威克"},{"from":467.26,"to":469,"content":"黑客帝国的救世主尼奥"},{"from":469,"to":470.2,"content":"他们冷酷无情"},{"from":470.2,"to":471.4,"content":"但又魅力四射"},{"from":471.4,"to":472.81,"content":"不关心琐碎小事"},{"from":472.81,"to":474.22,"content":"以自己的感受为主"},{"from":474.22,"to":476.08,"content":"把自己的目标放在第一位"},{"from":476.08,"to":476.89,"content":"在中国"},{"from":476.89,"to":480.1,"content":"成龙大哥也被奉为西格玛男的领军人物"},{"from":480.1,"to":481.57,"content":"他有段经典的采访"},{"from":481.57,"to":483.63,"content":"表达了他对女性的看法"},{"from":483.63,"to":485.97,"content":"好单不讲我的生活上面呢"},{"from":485.97,"to":487.8,"content":"以朋友兄弟为主"},{"from":487.8,"to":489.82,"content":"同为女朋友"},{"from":489.82,"to":491.44,"content":"他爸有没有讲没有讲"},{"from":491.44,"to":492.93,"content":"人"},{"from":515.47,"to":517.33,"content":"结婚离婚结婚离婚"},{"from":517.33,"to":519.07,"content":"我们结婚哦"},{"from":519.07,"to":525.949,"content":"原来哥哥好多好多好多女子将老公爷子"},{"from":525.949,"to":528.65,"content":"请老师走的半夜的模样"},{"from":528.65,"to":530.87,"content":"这些荧幕中的形象虽然很饱满"},{"from":530.87,"to":532.319,"content":"但却脱离现实"},{"from":532.319,"to":533.759,"content":"他们要么是大帅逼"},{"from":533.759,"to":535.109,"content":"要么是成功人士"},{"from":535.109,"to":536.759,"content":"过着精致享受的人生"},{"from":536.759,"to":538.94,"content":"然后故意塑造成迷人的反派"},{"from":538.94,"to":539.93,"content":"桀骜不驯"},{"from":539.93,"to":542.69,"content":"更像是人们幻想中的理想男性类型"},{"from":542.69,"to":544.67,"content":"用他们来代表西格玛兰"},{"from":544.67,"to":546.61,"content":"有点一叶障目的感觉"},{"from":546.61,"to":548.23,