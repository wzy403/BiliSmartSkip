ontent":"舌头热乎乎伸出去凉飕飕"},{"from":292.68,"to":293.31,"content":"说回来"},{"from":293.31,"to":295.92,"content":"一个典型西格玛男人的日程是怎样的"},{"from":295.92,"to":297.27,"content":"早晨五点钟起床"},{"from":297.27,"to":298.47,"content":"先冲个冷水澡"},{"from":298.47,"to":300.33,"content":"然后吃顿诺基式的早餐"},{"from":300.33,"to":301.98,"content":"一口气吞五颗生鸡蛋"},{"from":301.98,"to":303.42,"content":"在进行体能锻炼"},{"from":303.42,"to":304.49,"content":"锻炼完毕后"},{"from":304.49,"to":306.78,"content":"看一下加密货币的价格走势"},{"from":306.78,"to":309.51,"content":"在阅读尼采的查拉图斯特拉如是说"},{"from":309.51,"to":310.92,"content":"并对其中的句子"},{"from":310.92,"to":312.27,"content":"我们飞得越高"},{"from":312.27,"to":315.64,"content":"我们在那些不能飞的人眼中的形象就越渺小"},{"from":315.64,"to":317.23,"content":"着重标记下划线"},{"from":317.23,"to":318.4,"content":"作为西格玛男"},{"from":318.4,"to":320.02,"content":"健康和体能很重要"},{"from":320.02,"to":321.31,"content":"肉蛋奶是必需品"},{"from":321.31,"to":324.81,"content":"不然一副病恹恹的身体实在称不上是什么独狼"},{"from":324.81,"to":325.77,"content":"众所周知"},{"from":325.77,"to":327.96,"content":"我们的饮食结构肉类相对少"},{"from":327.96,"to":331.11,"content":"经常几片菜叶子和零星碎肉就打发一餐了"},{"from":331.11,"to":332.78,"content":"这就造成蛋白质不够"},{"from":332.78,"to":333.95,"content":"很多人不知道"},{"from":333.95,"to":336.65,"content":"其实70%以上的人都缺乏蛋白质"},{"from":336.65,"to":337.94,"content":"特别是老年人"},{"from":337.94,"to":339.05,"content":"孕妇青少年"},{"from":339.05,"to":341.6,"content":"他们对蛋白质的需求比一般人更高"},{"from":341.6,"to":343.1,"content":"但有些人不爱吃肉"},{"from":343.1,"to":343.88,"content":"吃不了肉"},{"from":343.88,"to":345.8,"content":"这就造成蛋白质摄入不足"},{"from":345.8,"to":348.68,"content":"而蛋白质的缺失会直接造成免疫力下降"},{"from":348.68,"to":349.52,"content":"感冒频发"},{"from":349.52,"to":350.42,"content":"老往医院跑"},{"from":350.42,"to":351.5,"content":"另外脱发"},{"from":351.5,"to":353.58,"content":"精神状态差也是典型症状"},{"from":353.58,"to":354.84,"content":"如果你有类似的问题"},{"from":354.84,"to":357.93,"content":"单靠饮食摄入可能无法满足每日蛋白质需求"},{"from":357.93,"to":360.72,"content":"那就可以像我一样选择一款专业的营养补剂"},{"from":362.98,"to":365.56,"content":"就为我提供了稳定且高效的蛋白质来源"},