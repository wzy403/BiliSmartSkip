o":144.79,"content":"能和阿尔法兰相提并论的"},{"from":144.79,"to":146.08,"content":"只有西格玛兰"},{"from":146.08,"to":148.13,"content":"西格玛兰和阿尔法兰相似"},{"from":148.13,"to":149.21,"content":"都很有自信"},{"from":149.21,"to":149.96,"content":"不拘小节"},{"from":149.96,"to":150.89,"content":"活出真我"},{"from":150.89,"to":153.43,"content":"但在社会等级中的位置又不一样"},{"from":153.43,"to":156.49,"content":"阿尔法兰的地位是建立在对人的领导上的"},{"from":156.49,"to":158.4,"content":"他们自带威严和霸气"},{"from":158.4,"to":159.24,"content":"西格玛男"},{"from":159.24,"to":160.44,"content":"这不是社会规则"},{"from":160.44,"to":161.64,"content":"不追求当领袖"},{"from":161.64,"to":162.66,"content":"他们是独狼"},{"from":162.66,"to":163.59,"content":"说走就走"},{"from":163.59,"to":164.57,"content":"想浪便浪"},{"from":164.57,"to":166.52,"content":"他们是古龙小说中的侠客"},{"from":166.52,"to":167.54,"content":"骑最快的马"},{"from":167.54,"to":168.56,"content":"喝最烈的酒"},{"from":168.56,"to":169.64,"content":"玩最利的刀"},{"from":169.64,"to":170.99,"content":"爱最美的女人"},{"from":170.99,"to":172.97,"content":"但又不会为任何一个停留"},{"from":172.97,"to":176.209,"content":"就像陆小凤万花丛中过片叶不沾身"},{"from":176.209,"to":178.069,"content":"虽然都处于顶级食物链"},{"from":178.069,"to":180.469,"content":"但阿尔法兰对西格玛男是警惕的"},{"from":180.469,"to":182.07,"content":"因为他们经常会偷家"},{"from":182.07,"to":183.78,"content":"阿尔法兰要去忙事业"},{"from":183.78,"to":184.77,"content":"征战四方"},{"from":184.77,"to":186.06,"content":"家里就顾不上了"},{"from":186.06,"to":187.94,"content":"比如拿破仑老婆约瑟芬"},{"from":187.94,"to":189.17,"content":"虽然已经是二婚"},{"from":189.17,"to":190.61,"content":"但总是出轨成瘾"},{"from":190.61,"to":194.06,"content":"连巴黎报纸也大幅渲染她和情人的约会厌世"},{"from":194.06,"to":196.16,"content":"当时拿破仑正在指挥打仗"},{"from":196.16,"to":197.39,"content":"一听老婆来了"},{"from":197.39,"to":200.67,"content":"能下队伍就回到了战线后方根据地米兰"},{"from":200.67,"to":203.58,"content":"拿破仑还为约瑟芬准备了盛大的欢迎会"},{"from":203.58,"to":206.75,"content":"可约瑟芬却跟中卫情人直接去了热那亚"},{"from":206.75,"to":209.48,"content":"这方面还是法国比较领先"},{"from":209.48,"to":213.16,"content":"法国启蒙时代大思想家伏尔泰也是一位王咖"},{"from":213.16,"to":214.48,"content":"他在读中学时"},{"f