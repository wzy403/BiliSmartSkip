"亚瑟把这个答案告诉了君主"},{"from":610.64,"to":611.63,"content":"获得了宽恕"},{"from":611.63,"to":612.579,"content":"被放了回来"},{"from":612.579,"to":614.289,"content":"在作者亚历山大看来"},{"from":614.289,"to":617.079,"content":"女人隐隐约约驱使着社会舆论和压力"},{"from":617.079,"to":618.309,"content":"很难活出自己"},{"from":618.309,"to":619.94,"content":"想要主宰自己的命运"},{"from":619.94,"to":621.86,"content":"需要付出很大的代价"},{"from":621.86,"to":623.36,"content":"当他试着去尊重女人"},{"from":623.36,"to":624.62,"content":"是个独立个体时"},{"from":624.62,"to":626.78,"content":"她将再也不会缺乏异性"},{"from":626.78,"to":629.15,"content":"西格玛男性并不自我矮化"},{"from":629.15,"to":631.329,"content":"他们不会去舔所谓的女神"},{"from":631.329,"to":633.219,"content":"但也不会把女性当做物品"},{"from":633.219,"to":634.689,"content":"不承认他们有特权"},{"from":634.689,"to":635.889,"content":"像对待男人一样"},{"from":635.889,"to":638.13,"content":"跟他们相处是平等与互惠"},{"from":638.13,"to":641,"content":"他们也不会故意打造神秘冷酷的形象"},{"from":641,"to":643.07,"content":"无人的时候他孤芳自赏"},{"from":643.07,"to":644,"content":"自得其乐"},{"from":644,"to":646.44,"content":"有人的时候他可以轻易融入大众"},{"from":646.44,"to":647.31,"content":"有说有笑"},{"from":647.31,"to":648.15,"content":"极少愤怒"},{"from":648.15,"to":649.22,"content":"永远笑眯眯"},{"from":649.22,"to":652.01,"content":"只是他的快乐不是来自于别人的认同"},{"from":652.01,"to":653.42,"content":"而是他自己的体验"},{"from":653.42,"to":654.77,"content":"跟阿尔法兰不同"},{"from":654.77,"to":656.67,"content":"阿尔法兰自带主角光环"},{"from":656.67,"to":658.59,"content":"使救火队长临危受命"},{"from":658.59,"to":659.55,"content":"掌控全局"},{"from":659.55,"to":661.32,"content":"而西格玛男是参与者"},{"from":661.32,"to":662.19,"content":"不争不抢"},{"from":662.19,"to":663.03,"content":"不卑不亢"},{"from":663.03,"to":664.68,"content":"注重每一段旅程"},{"from":664.68,"to":666.71,"content":"西方开始流行西格玛人格"},{"from":666.71,"to":668.57,"content":"是从2021年开始的"},{"from":668.57,"to":671.72,"content":"当时有条推文标题叫男人到底怎么了"},{"from":671.72,"to":673.39,"content":"引起了全世界的关注"},{"from":673.39,"to":675.04,"content":"男人们开始慢慢意识到"},{"from":675.04,"to":678.1,"content":"将世界划分为阿尔法和贝塔是相当愚蠢的"},{"from":678.1,"to":678.85,"content":"要么赢"},{"from":678.85,"to":679.579,"content":"要么输"},{"from":679.579,"to":680.539,"content":"弱肉强食"},{"from":680.539,"to":681.439,"content":"非常残忍"},{"from":681.439,"to":685.16,"content":"西方人分析西格玛表情包之所以越来越受欢迎"},{"from":685.16,"to":687.5,"content":"是因为疫情暴露了资本主义的失败"},{"from":687.5,"to":688.52,"content":"失业率上升"},{"from":688.52,"to":689.72,"content":"工资停滞不前"},{"from":689.72,"to":691.079,"content":"通货膨胀飙升"},{"from":691.079,"to":692.879,"content":"这也更加突出了一个概念"},{"from":692.879,"to":694.439,"content":"叫做非自愿单身"},{"from":694.439,"to":695.399,"content":"经济越差"},{"from":695.399,"to":696.539,"content":"情况越严重"},{"from":696.539,"to":697.769,"content":"非自愿单身"},{"from":697.769,"to":699.34,"content":"英文名叫INCEL"},{"from":699.34,"to":702.46,"content":"是90年代加拿大统计学专业的女生阿拉纳"},{"from":702.46,"to":703.09,"content":"创造的"},{"from":703.09,"to":703.9,"content":"她个子矮"},{"from":703.9,"to":704.59,"content":"有点胖"},{"from":704.59,"to":705.82,"content":"身上还有湿疹"},{"from":705.82,"to":707.11,"content":"基本没有异性缘"},{"from":707.11,"to":708.26,"content":"为了寻求改变"},{"from":708.26,"to":709.31,"content":"1997年"},{"from":709.31,"to":712.13,"content":"他用HTML开发了一个纯文本网站"},{"from":712.13,"to":714.86,"content":"名叫阿拉纳的非自愿单身项目"},{"from":714.86,"to":716.63,"content":"开始主要是女性加入"},{"from":716.63,"to":718.78,"content":"后来逐渐也有了男性空间"},{"from":718.78,"to":720.88,"content":"他们在探讨非自愿单身时"},{"from":720.88,"to":723.73,"content":"诞生了后来著名的几个男性文化分支"},{"from":723.73,"to":725.38,"content":"第一种叫MRS"},{"from":725.38,"to":727.99,"content":"主要关注男性劣势歧视及压抑"},{"from":727.99,"to":729.04,"content":"但并不厌女"},{"from":729.04,"to":731.52,"content":"第二种就是大名鼎鼎的PUA"},{"from":731.52,"to":734.07,"content":"指导男性通过技巧和心理学应用"},{"from":734.07,"to":736.069,"content":"去接近搭讪自己喜欢的人"},{"from":736.069,"to":737.869,"content":"但这个在中国被污名化"},{"from":737.869,"to":740.449,"content":"变成了骗色骗财和洗脑的手段"},{"from":740.449,"to":742.75,"content":"最后一种是所谓的米格道"},{"from":742.75,"to":744.43,"content":"她还有一个著名的代称"},{"from":744.43,"to":745.39,"content":"红丸主义"},{"from":745.39,"to":749.11,"content":"告诫男人杜绝与女人发生严肃认真的恋爱关系"},{"from":749.11,"to":750.56,"content":"特别是婚姻关系"},{"from":750.56,"to":752.57,"content":"他们称之为男性觉醒"},{"from":752.57,"to":754.77,"content":"在最近几年也传进了中国"},{"from":754.77,"to":756.66,"content":"西格玛也属于红丸的一种"},{"from":756.66,"to":759.11,"content":"这些思想因为天然的政治不正确"},{"from":759.11,"to":762.5,"content":"对女权的反抗在西方主流文化里是被批评的"},{"from":762.5,"to":763.97,"content":"不过却暗潮汹涌"},{"from":763.97,"to":765.92,"content":"隐隐有东西交汇之势"},{"from":765.92,"to":768.51,"content":"国内崇尚西格玛的主要有两拨人"},{"from":768.51,"to":770.25,"content":"一种是非自愿单身者"},{"from":770.25,"to":771.51,"content":"缺乏雄性魅力"},{"from":771.51,"to":772.53,"content":"热衷于躺平"},{"from":772.53,"to":773.82,"content":"说起追求女性"},{"from":773.82,"to":776.52,"content":"就安慰自己说吃顿好的不更香吗"},{"from":776.52,"to":779.61,"content":"但实际上又没有真的戒掉那种世俗的欲望"},{"from":779.61,"to":782.53,"content":"还是常常被性压抑折磨或者吟唱"},{"from":782.53,"to":784.36,"content":"一切都是什么什么叙事"},{"from":784.36,"to":785.92,"content":"但对方却根本不理"},{"from":785.92,"to":787.15,"content":"还要嗤之以鼻"},{"from":787.15,"to":788.47,"content":"搞得特别落寞"},{"from":788.47,"to":789.91,"content":"从地铁到小作文"},{"from":789.91,"to":791.44,"content":"那便是越闹越凶"},{"from":791.44,"to":793.099,"content":"这边完全无力还击"},{"from":793.099,"to":793.639,"content":"高阶"},{"from":793.639,"to":795.679,"content":"打低阶版本武器都不一样"},{"from":795.679,"to":797.53,"content":"还有一种就是链接达人"},{"from":797.53,"to":799.36,"content":"致力于成为真正的西格玛"},{"from":799.36,"to":801.28,"content":"但因为国内的恶性环境"},{"from":801.28,"to":802.87,"content":"信息匮乏等等因素"},{"from":802.87,"to":804.52,"content":"能做到的也非常少"},{"from":804.52,"to":807.85,"content":"这就导致西格玛虽然是亿万直男的偶像"},{"from":807.85,"to":809.86,"content":"但现实生活中极难看到"},{"from":809.86,"to":812.32,"content":"仿佛一种理想图腾照耀他们"},{"from":812.32,"to":813.25,"content":"顾影自怜"},{"from":813.25,"to":814.18,"content":"精神麻痹"},{"from":814.18,"to":817.56,"content":"但我这么说并不意味着西格玛完全不可取"},{"from":817.56,"to":819.48,"content":"比起阿尔法的拦路登天"},{"from":819.48,"to":821.38,"content":"成为贝塔的供养悲剧"},{"from":821.38,"to":823.81,"content":"西格玛不失为一种保全之道"},{"from":823.81,"to":825.16,"content":"就算真正做不到"},{"from":825.16,"to":826.85,"content":"起码也可以独善其身"},{"from":826.85,"to":829.7,"content":"毕竟男性解放在全世界都是异端"},{"from":829.7,"to":833.51,"content":"能踏出一小步已经是很大的勇气"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:01:17.123Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:01:15.059Z"}}
