":"此外董子还将成立一个投资委员会"},{"from":1041.24,"to":1042.54,"content":"由卢特尼克领导"},{"from":1042.54,"to":1044.44,"content":"并仅由美国官员组成"},{"from":1044.44,"to":1047.02,"content":"该委员会负责向董子推荐投资项目"},{"from":1047.02,"to":1049.08,"content":"董子觉得诶这个项目不错"},{"from":1049.08,"to":1049.78,"content":"就签字"},{"from":1049.78,"to":1051.28,"content":"日本人过来拿钱投资"},{"from":1051.28,"to":1052.62,"content":"诶这个项目不错"},{"from":1052.62,"to":1054.6,"content":"签字日本人拿钱去投资吧"},{"from":1054.6,"to":1056.66,"content":"当然这些项目中包含不包含"},{"from":1056.66,"to":1058.14,"content":"特朗普内阁成员的公司"},{"from":1058.14,"to":1059.4,"content":"我们就不得而知了"},{"from":1059.4,"to":1061.04,"content":"不过也不是啥项目都能投"},{"from":1061.04,"to":1063.4,"content":"因为投资委员会在向特朗普建议前"},{"from":1063.4,"to":1065.32,"content":"还得再跟咨询机构对接"},{"from":1065.32,"to":1067.76,"content":"而咨询机构是由日美双方组成的"},{"from":1067.76,"to":1069.64,"content":"他们将根据日本的法律法规"},{"from":1069.64,"to":1071.24,"content":"对投资项目进行审查"},{"from":1071.24,"to":1074.56,"content":"所以说日本政府还是有一点点点点点点点"},{"from":1074.56,"to":1075.3,"content":"话语权的"},{"from":1075.3,"to":1076.96,"content":"该谅解备忘录中还指出"},{"from":1076.96,"to":1079.34,"content":"如果日本未能兑现其承诺的投资"},{"from":1079.34,"to":1081.32,"content":"美国就可以立刻加征关税"},{"from":1081.32,"to":1082.46,"content":"不给钱就加税"},{"from":1082.46,"to":1083.94,"content":"至于利润怎么分吗"},{"from":1083.94,"to":1085.94,"content":"日本先投资的5500亿"},{"from":1085.94,"to":1087.24,"content":"在投资收回之前"},{"from":1087.24,"to":1089.02,"content":"日美双方将平分利润"},{"from":1089.02,"to":1090.16,"content":"日本回本之后呢"},{"from":1090.16,"to":1091.36,"content":"那就得九幺开了"},{"from":1091.36,"to":1092.98,"content":"我美国得拿九成利润"},{"from":1092.98,"to":1094.22,"content":"90%的利润"},{"from":1094.22,"to":1095.48,"content":"日本只能拿一成"},{"from":1095.48,"to":1096.92,"content":"至于其他方面的投资"},{"from":1096.92,"to":1098.42,"content":"比如日本买美国的大米"},{"from":1098.42,"to":1100,"content":"农产品啥的一样不能少"},{"from":1100,"to":1102.88,"content":"而美国也把日本最心心念的汽车关税给降到了"},{"from":1102.88,"to":1103.64,"content":"15%"},{"from":1103.64,"to":1105.74,"content":"不过日本人对此我看还挺高兴的"},{"from":1105.74,"to":1107.12,"content":"因为日本虽然出了钱"},{"from":1107.12,"to":1108.54,"content":"但往你美国投资"},{"from":1108.54,"to":1110.86,"content":"你美国就得提供项目所需要的土地"},{"from":1110.86,"to":1112.32,"content":"水电和其他基础设施"},{"from":1112.32,"to":1113.88,"content":"并为商品寻找购买方"},{"from":1113.88,"to":1114.92,"content":"这么算下来的话"},{"from":1114.92,"to":1116.68,"content":"日本人认为自己吃亏也不多"},{"from":1116.68,"to":1119.28,"content":"而且只要日本忠诚的执行这些项目"},{"from":1119.28,"to":1120.34,"content":"老老实实给钱"},{"from":1120.34,"to":1122,"content":"美国就不会提高关税"},{"from":1122,"to":1123.06,"content":"只要不加关税"},{"from":1123.06,"to":1124.58,"content":"其他方面的问题就不大"},{"from":1124.58,"to":1127.38,"content":"当然最重要的还是进口美国农产品的事儿"},{"from":1127.38,"to":1129.78,"content":"日本不是经常吹自己保护农民吗"},{"from":1129.78,"to":1131.64,"content":"那大量进口美国的农产品"},{"from":1131.64,"to":1133.5,"content":"肯定会影响日本本国的农业"},{"from":1136.56,"to":1138.9,"content":"当然这不是石破茂该考虑的问题"},{"from":1138.9,"to":1140.1,"content":"反正他都要下台了"},{"from":1140.1,"to":1140.72,"content":"随便吧"},{"from":1140.72,"to":1142,"content":"相信后人的智慧"},{"from":1142,"to":1143.72,"content":"关于后续谁会接他这个盘"},{"from":1143.72,"to":1145.24,"content":"我们只能看后续的了好了"},{"from":1145.24,"to":1146.74,"content":"本期视频就先到此结束了"},{"from":1146.74,"to":1147.24,"content":"喜欢的话"},{"from":1147.24,"to":1148.28,"content":"拜托帮忙点赞关注"},{"from":1148.28,"to":1149.08,"content":"我们下期再见"},{"from":1149.08,"to":1150.52,"content":"没准哪天我就偷袭了哈"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:01:29.981Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:01:27.349Z"}}
