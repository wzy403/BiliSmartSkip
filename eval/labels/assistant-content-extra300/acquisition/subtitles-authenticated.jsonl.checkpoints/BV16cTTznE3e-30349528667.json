{"schemaVersion":1,"bvid":"BV16cTTznE3e","cid":30349528667,"subtitles":[{"from":0,"to":0.82,"content":"5月19号"},{"from":0.82,"to":2.08,"content":"华为鸿蒙电脑发布"},{"from":2.08,"to":3.9,"content":"不管你是否关注数码产品"},{"from":3.9,"to":4.68,"content":"都应该知道"},{"from":4.68,"to":7.779,"content":"真正消费级的纯国产电脑操作系统真的来了"},{"from":7.779,"to":10.739,"content":"和他一起来的还有山呼海啸般的质疑和嘲讽"},{"from":10.739,"to":12.619,"content":"这其中最多人质疑的是"},{"from":12.619,"to":15.18,"content":"虹膜电脑怎么用起来像个大号手机系统"},{"from":15.18,"to":16.5,"content":"为了验证大伙的说法"},{"from":16.5,"to":18.14,"content":"我实际上手体验了一段时间"},{"from":18.14,"to":19.87,"content":"然后发现好像还真是"},{"from":19.87,"to":21.47,"content":"但如果只是因为鸿蒙电脑"},{"from":21.47,"to":23.21,"content":"使用起来有点手机的感觉"},{"from":23.21,"to":25.35,"content":"却忽略了桌面终端和移动终端"},{"from":25.35,"to":26.99,"content":"正在逐渐靠近的事实"},{"from":26.99,"to":28.009,"content":"那也并不合理"},{"from":28.009,"to":28.409,"content":"大家好"},{"from":28.409,"to":30.169,"content":"我是攒钱买鸿蒙全家桶的"},{"from":30.169,"to":30.649,"content":"差评君"},{"from":30.649,"to":31.489,"content":"今天分享一点"},{"from":31.489,"to":33.459,"content":"对于鸿蒙电脑不同的看法"},{"from":33.459,"to":35.559,"content":"关于电脑越来越像手机这件事情"},{"from":35.559,"to":36.639,"content":"深究起来会发现"},{"from":36.639,"to":38.75,"content":"其实并不是华为率先发起的"},{"from":38.75,"to":40.63,"content":"年龄稍大一点的同学应该还记得"},{"from":40.63,"to":44.33,"content":"历史上微软和苹果都试图向类手机系统靠近"},{"from":44.33,"to":46.01,"content":"还为此做了不少尝试"},{"from":46.01,"to":48.91,"content":"让我们把时间拨回2001年这一年10月"},{"from":48.91,"to":52.21,"content":"微软发布了windows史上或许是最成功的操作系统"},{"from":52.21,"to":53.17,"content":"Windows xp"},{"from":53.17,"to":54.03,"content":"从此之后"},{"from":54.03,"to":55.79,"content":"大屁股电脑带个XP系统"},{"from":55.79,"to":58.12,"content":"几乎成为了电脑这个名词的标志"},{"from":58.12,"to":59.28,"content":"XP发布后"},{"from":59.28,"to":60.68,"content":"微软一时风头无两"},{"from":60.68,"to":62.12,"content":"但就在春风得意的时候"},{"from":62.12,"to":63.7,"content":"他们却悄悄的干了件事"},{"from":63.7,"to":65.099,"content":"研发windows mobi"},{"from":65.099,"to":66.939,"content":"WM脱胎于windows ce"},{"from":66.939,"to":68.119,"content":"因为研发的太早"},{"from":68.119,"to":69.639,"content":"以至于身为一个手机系统"},{"from":69.639,"to":72.46,"content":"却在当时找不到一台可以用于安装的手机"},{"from":72.46,"to":73.64,"content":"直到2002年"},{"from":73.64,"to":75.44,"content":"微软才终于联合HTC"},{"from":75.44,"to":78.3,"content":"推出了第一款搭载了WM系统的手机"},{"from":78.3,"to":82.329,"content":"htc orange s p v自带手机移植了很多电脑应用"},{"from":82.329,"to":83.889,"content":"包括outlook ie浏览器"},{"from":83.889,"to":85.39,"content":"media player播放器等"},{"from":85.39,"to":87.51,"content":"这些应用极大丰富了手机的功能"},{"from":87.51,"to":89.87,"content":"也扩大了手机这个概念的外延"},{"from":89.87,"to":92.53,"content":"orange s p v的出现是划时代的"},{"from":92.53,"to":94.43,"content":"它模糊了电脑和手机的界限"},{"from":94.43,"to":95.19,"content":"从此之后"},{"from":95.19,"to":97.84,"content":"通讯工具和终端开始双向奔赴"},{"from":97.84,"to":99.28,"content":"W莱文的设想很好"},{"from":99.28,"to":100.6,"content":"但作为一个便携终端"},{"from":100.6,"to":102.54,"content":"它的设计太依赖传统桌面"},{"from":102.54,"to":104.5,"content":"并不符合人们对于手机的想象"},{"from":104.5,"to":106.449,"content":"所以也没引起太大的波澜"},{"from":106.449,"to":107.489,"content":"直到2017年"},{"from":107.489,"to":110.469,"content":"乔布斯带的初代IPHONE第一次敲开了智能手机之门"},{"from":110.469,"to":113.18,"content":"人们才终于知道移动终端应该是什么样"},{"from":113.18,"to":115.94,"content":"为了追赶IOS和2008年发布的安卓"},{"from":115.94,"to":117.7,"content":"2010年10月11日"},{"from":117.7,"to":119.18,"content":"微软发布了windows phone"},{"from":119.18,"to":121.39,"content":"win phone开发了著名的modern ui"},{"from":121.39,"to":123.75,"content":"使用不同的色块表示不同的应用程序"},{"from":123.75,"to":125.13,"content":"看到这熟悉的色块"},{"from":125.13,"to":126.75,"content":"应该有不少同学反应过来了"},{"from":126.75,"to":128.28,"content":"这不就是应用磁贴吗"},{"from":128.28,"to":128.78,"content":"是的"},{"from":128.78,"to":131.72,"content":"应用磁贴的形式最早是在win phone上开始使用的"},{"from":131.72,"to":134.31,"content":"后续也被用于win8的用户界面中"},{"from":134.31,"to":135.43,"content":"除了应用磁贴外"},{"from":135.43,"to":136.63,"content":"win8上还有许多"},{"from":136.63,"to":139.12,"content":"专为手机这样的触屏设备打造的"},{"from":139.12,"to":140.72,"content":"首先就是win8的开始界面"},{"from":140.72,"to":142.48,"content":"是一条横置的滑动菜单"},{"from":142.48,"to":143.36,"content":"你把它竖过来"},{"from":143.36,"to":146.2,"content":"就会发现和今天的手机抽屉菜单没有两样"},{"from":146.2,"to":147.62,"content":"通过左右滑动操作"},{"from":147.62,"to":148.92,"content":"既高效又优雅"},{"from":148.92,"to":149.86,"content":"十分体面"},{"from":149.86,"to":151.46,"content":"win8还使用了charms栏"},{"from":151.46,"to":153.76,"content":"从屏幕边缘向内一滑即可呼出"},{"from":153.76,"to":154.7,"content":"细想一下的话"},{"from":154.7,"to":156.9,"content":"这不就是苹果的sensitive touch吗"},{"from":156.9,"to":157.74,"content":"不止这些"},{"from":157.74,"to":159.52,"content":"win8还引入了微软应用商店"},{"from":159.52,"to":161.52,"content":"希望能够形成自己的软件生态"},{"from":161.52,"to":164.24,"content":"以解决windows上混乱的软件管理问题"},{"from":164.24,"to":165.88,"content":"这一点咱们后面还会聊到"},{"from":165.88,"to":168.12,"content":"总之通过前面的种种尝试"},{"from":168.12,"to":171.12,"content":"win8成为了最像手机的一代PC操作系统"},{"from":171.12,"to":174.28,"content":"说完微软再来看苹果与微软尝试类似"},{"from":174.28,"to":175.44,"content":"苹果的Mac os"},{"from":175.44,"to":176.52,"content":"在发展的过程中"},{"from":176.52,"to":178.96,"content":"也展现出像移动端体验借鉴的趋势"},{"from":178.96,"to":181.99,"content":"但这与微软直接改造windows逻辑有所不同"},{"from":181.99,"to":185.07,"content":"苹果为IPHONE打造了IOS的原生移动系统"},{"from":185.07,"to":187.76,"content":"其成功的经验也反过来影响了Mac os"},{"from":187.76,"to":190.68,"content":"比如全屏应用模式在Mac os得到了强化"},{"from":190.68,"to":192.16,"content":"app store通知中心等"},{"from":192.16,"to":194.84,"content":"源于IOS的成功模块也被引入桌面端"},{"from":194.84,"to":197.48,"content":"手势操作的丰富以及视觉风格的统一"},{"from":197.48,"to":200.37,"content":"都表现出两类终端越来越趋同的特性"},{"from":200.37,"to":202.79,"content":"微软和苹果做了那么多尝试和努力"},{"from":202.79,"to":206.01,"content":"目的都是让传统的电脑系统的体验更像手机"},{"from":206.01,"to":207.19,"content":"可这是为什么呢"},{"from":207.19,"to":210.38,"content":"答案或许就藏在传统PC天然的短板之上"},{"from":210.38,"to":212.52,"content":"拿市占率最高的windows来举例吧"},{"from":212.52,"to":213.58,"content":"经过多年的发展"},{"from":213.58,"to":215.26,"content":"windows不说是千疮百孔吧"},{"from":215.26,"to":216.769,"content":"也能算是漏洞百出了"},{"from":216.769,"to":218.809,"content":"这里的漏洞并非指的是软件bug"},{"from":218.809,"to":220.63,"content":"而是使用标准上的不统一"},{"from":220.63,"to":221.47,"content":"举几个例子"},{"from":221.47,"to":223.57,"content":"就拿最最基础的软件安装来说"},{"from":223.57,"to":224.69,"content":"当你下载一个软件"},{"from":224.69,"to":225.93,"content":"它会被安装到哪里"},{"from":225.93,"to":229.39,"content":"正常的应用可能会放在C盘program files文件夹下"},{"from":229.39,"to":230.69,"content":"安装在app data里"},{"from":230.69,"to":231.75,"content":"也还算可以理解"},{"from":231.75,"to":232.93,"content":"很多奇怪的软件"},{"from":232.93,"to":235.28,"content":"会在不知道什么盘里新建文件夹安装"},{"from":235.28,"to":237.1,"content":"这就让人很摸不着头脑"},{"from":237.1,"to":239.18,"content":"软件安装位置已经如此复杂"},{"from":239.18,"to":241.36,"content":"数据文件的保存就更是混乱"},{"from":241.36,"to":244.32,"content":"放ab data和user data算是比较正常的"},{"from":244.32,"to":245.82,"content":"有的软件会放在当前目录"},{"from":245.82,"to":246.96,"content":"有的还会放在桌面"},{"from":246.96,"to":249.269,"content":"或者是别的他自己新建的文件夹下"},{"from":249.269,"to":250.889,"content":"此时想要找到对应文件"},{"from":250.889,"to":253.089,"content":"最好的办法竟然是保存一次文件"},{"from":253.089,"to":255.449,"content":"以确定上一个文件被保存到了哪"},{"from":255.449,"to":256.349,"content":"安装是这样的"},{"from":256.349,"to":257.86,"content":"软件的更新又是如何"},{"from":257.86,"to":260.94,"content":"windows上的软件更新只能用八仙过海来形容"},{"from":260.94,"to":261.86,"content":"随便一拍脑袋"},{"from":261.86,"to":264.289,"content":"就能想到这么多种常见的更新方式"},{"from":264.289,"to":265.169,"content":"最神奇的是"},{"from":265.169,"to":266.469,"content":"有些大型软件的更新"},{"from":266.469,"to":268.529,"content":"竟然需要通过下载另一个软件来更新"},{"from":268.529,"to":269.36,"content":"前一个软件"},{"from":269.36,"to":271.64,"content":"游戏玩家狂吹steam能够做到省心"},{"from":271.64,"to":272.4,"content":"开箱即玩"},{"from":272.4,"to":275.08,"content":"有没有可能就是因为windows下的软件下载"},{"from":275.08,"to":276.84,"content":"安装和更新都太不省心了"},{"from":276.84,"to":278.41,"content":"造成的软件下好了"},{"from":278.41,"to":279.77,"content":"用户还得操心一个问题"},{"from":279.77,"to":280.57,"content":"数据安全"},{"from":280.57,"to":281.97,"content":"对于普通消费者来说"},{"from":281.97,"to":283.83,"content":"windows以极高的自由度闻名"},{"from":283.83,"to":285.85,"content":"这里的自由就包括了权限自由"},{"from":285.85,"to":287.41,"content":"权限自由体验的两方面"},{"from":287.41,"to":288.81,"content":"一方面是权限太高"},{"from":288.81,"to":290.17,"content":"在非管理员状态下"},{"from":290.17,"to":291.41,"content":"应用就可以记录键盘"},{"from":291.41,"to":293.05,"content":"录入扫描硬盘上的文件"},{"from":293.05,"to":295.159,"content":"还可以自动下载一堆其他的软件"},{"from":295.159,"to":296.439,"content":"有了管理员权限后"},{"from":296.439,"to":298.83,"content":"直接重置系统也不成问题"},{"from":299.23,"to":300.91,"content":"权限控制不足的另一面是"},{"from":300.91,"to":302.77,"content":"应用调用权限没有任何提示"},{"from":302.77,"to":305.43,"content":"不管是调用了摄像头麦克风还是屏幕截了图"},{"from":305.43,"to":306.28,"content":"扫描了硬盘"},{"from":306.28,"to":308.08,"content":"系统都不会给出任何提示"},{"from":308.08,"to":311.07,"content":"用户也根本不知道哪些应用使用了哪些权限"},{"from":311.07,"to":313.79,"content":"windows的短板很多Mac os其实也不少"},{"from":313.79,"to":314.91,"content":"像是软件卸载"},{"from":314.91,"to":316.35,"content":"把软件拖进废纸楼"},{"from":316.35,"to":317.98,"content":"却只是删了应用程序包"},{"from":317.98,"to":319.42,"content":"大量配置文件和缓存"},{"from":319.42,"to":320.54,"content":"还要单独卸载"},{"from":320.54,"to":323.86,"content":"非app store应用的更新体验和windows也不相上下"},{"from":323.86,"to":325.58,"content":"系统通知一大堆挤在一起"},{"from":325.58,"to":327.04,"content":"既烦人还遮挡画面"},{"from":327.04,"to":329.06,"content":"还有那些飘忽不定的蓝牙连接"},{"from":329.06,"to":331.57,"content":"都是麦克使用过程中让人发飙的地方"},{"from":331.57,"to":333.13,"content":"当然前面讲到的情况"},{"from":333.13,"to":334.49,"content":"无论是Mac还是windows"},{"from":334.49,"to":335.91,"content":"都不是每个人都会遇到的"},{"from":335.91,"to":337.61,"content":"但是给女朋友修过电脑的同学"},{"from":337.61,"to":340.66,"content":"应该能够体会60秒开机后的满屏是兄弟"},{"from":340.66,"to":341.06,"content":"就来砍"},{"from":341.06,"to":342.329,"content":"我点开一个视频"},{"from":342.329,"to":343.849,"content":"七八个播放器争奇斗艳"},{"from":343.849,"to":346.809,"content":"更不用说360全家桶或100个杀毒软件打的"},{"from":346.809,"to":347.72,"content":"有来有回"},{"from":347.72,"to":349,"content":"见过这些画面的朋友"},{"from":349,"to":350.3,"content":"难免会思考一个问题"},{"from":350.3,"to":352.44,"content":"为什么女朋友使用手机没有任何问题"},{"from":352.44,"to":354.26,"content":"用起电脑来却是一卡一卡的"},{"from":354.26,"to":357.53,"content":"相同的问题其实也出现在PC工程师的脑海中"},{"from":357.53,"to":358.33,"content":"所以可以看见"},{"from":358.33,"to":361.93,"content":"微软和苹果都先后推出过UWP和Mac catalyst"},{"from":361.93,"to":363.9,"content":"这样的权宜之计来解决困境"},{"from":363.9,"to":365.38,"content":"讲到这里需要澄清一个点"},{"from":365.38,"to":368.02,"content":"虽然我们反复论证电脑越来越像手机"},{"from":368.02,"to":369.82,"content":"但其核心并非是想说"},{"from":369.82,"to":372.83,"content":"桌妹终端在单向的朝着移动终端靠近"},{"from":372.83,"to":373.43,"content":"事实上"},{"from":373.43,"to":375.41,"content":"近年来手机也得越来越像电脑"},{"from":375.41,"to":376.79,"content":"不管是越来越强的性能"},{"from":376.79,"to":378.83,"content":"还是安卓16引入了PC模式"},{"from":378.83,"to":381.78,"content":"都显示着两种终端越来越接近的关系"},{"from":381.78,"to":384.7,"content":"说到底其实是两类终端经过各自的发展"},{"from":384.7,"to":386.08,"content":"都在朝着越来越简单"},{"from":386.08,"to":387.26,"content":"越来越符合逻辑"},{"from":387.26,"to":388.8,"content":"越来越相似的方向发展"},{"from":388.8,"to":391.16,"content":"这可以称之为交互逻辑上的统一"},{"from":391.16,"to":392.92,"content":"或者用更华为一点的说法"},{"from":392.92,"to":393.79,"content":"多端融合"},{"from":393.79,"to":394.85,"content":"所谓多端融合"},{"from":394.85,"to":397.87,"content":"华为官方的说法是通过鸿蒙操作系统实现手机"},{"from":397.87,"to":398.63,"content":"平板电脑"},{"from":398.63,"to":399.23,"content":"智能手表"},{"from":399.23,"to":401.51,"content":"智能电视等不同设备之间的无缝协同"},{"from":401.51,"to":402.16,"content":"能互通"},{"from":402.16,"to":404.66,"content":"但其核心目的其实和咱们前面说的一样"},{"from":404.66,"to":407.62,"content":"就是使得各类终端都朝着统一的方向发展"},{"from":407.62,"to":409.58,"content":"这一点落在新出的红魔电脑上"},{"from":409.58,"to":412.789,"content":"就体现在了怎么解决传统pg的天然短板上"},{"from":412.789,"to":414.389,"content":"像是前面提到的软件安装"},{"from":414.389,"to":417.449,"content":"数据和更新在鸿蒙电脑上变得简单且方便"},{"from":417.449,"to":419.609,"content":"我们电脑的文件管理只分为两个部分"},{"from":419.609,"to":421.7,"content":"系统和个人软件相关的文件"},{"from":421.7,"to":423.12,"content":"都被放在系统文件夹下"},{"from":423.12,"to":425.52,"content":"所有的应用的数据都分门别类的摆好"},{"from":425.52,"to":427.809,"content":"不会存在混乱或找不到位置的情况"},{"from":427.809,"to":429.329,"content":"软件的更新就更简单了"},{"from":429.329,"to":430.209,"content":"打开应用市场"},{"from":430.209,"to":432.78,"content":"找到我的需要的更新都统一出现在这里"},{"from":432.78,"to":434.46,"content":"方便的文件管理只是小头"},{"from":434.46,"to":435.94,"content":"鸿蒙的系统调度策略"},{"from":435.94,"to":438.33,"content":"更是解决了windows上的巨大痛点"},{"from":438.33,"to":441.45,"content":"在触摸板三指上滑就进入了任务管理界面"},{"from":441.45,"to":442.33,"content":"运行中的任务"},{"from":442.33,"to":445.13,"content":"以卡片的形式展现在对应的卡片下方"},{"from":445.13,"to":446.52,"content":"上滑就能关闭进程"},{"from":446.52,"to":449.36,"content":"调度策略的优势不仅仅是任务进程清晰"},{"from":449.36,"to":451.9,"content":"更重要的是能够从系统层面节省性能"},{"from":451.9,"to":453.74,"content":"大家都知道鸿蒙电脑是很省电"},{"from":453.74,"to":455.56,"content":"这个不仅是因为它的电池大"},{"from":455.56,"to":456.46,"content":"系统能效高"},{"from":456.46,"to":458.14,"content":"掉的策略好才是主要原因"},{"from":458.14,"to":459.08,"content":"除了省电"},{"from":459.08,"to":461.42,"content":"虹膜电脑对于权限的管理也更严格"},{"from":461.42,"to":463.52,"content":"一方面电脑侧面有个专门的拨键"},{"from":463.52,"to":465.32,"content":"可以直接给摄像头麦克风断电"},{"from":465.32,"to":467.65,"content":"物理层面隔绝了应用调用的可能性"},{"from":467.65,"to":468.37,"content":"另一方面"},{"from":468.37,"to":469.09,"content":"在设置中"},{"from":469.09,"to":471.55,"content":"可以直接查看哪些应用使用的位置信息"},{"from":471.55,"to":473.49,"content":"相机文件夹的敏感信息"},{"from":473.49,"to":476.34,"content":"也可以直接设置是否给应用对应的权限"},{"from":476.34,"to":477.46,"content":"还有一个隐藏的痛点"},{"from":477.46,"to":478.54,"content":"可能很多人没有想到"},{"from":478.54,"to":479.92,"content":"但绝对会有人遇到的"},{"from":479.92,"to":481.62,"content":"就是随着移动设备的不断发展"},{"from":481.62,"to":484.27,"content":"很多人的工作重心已经转移到移动app上了"},{"from":484.27,"to":486.15,"content":"就拿差评君一个同事的案例来说"},{"from":486.15,"to":488.65,"content":"通过淘宝微信牵牛和客户对接"},{"from":488.65,"to":489.85,"content":"这是他的工作内容"},{"from":489.85,"to":492.99,"content":"但是这些app对于PC的适配实在令人糟心"},{"from":492.99,"to":494.11,"content":"要么是功能缺失"},{"from":494.11,"to":495.11,"content":"要么是操作复杂"},{"from":495.11,"to":496.66,"content":"要么就是干脆没有桌面端"},{"from":496.66,"to":497.68,"content":"面对这种情况"},{"from":497.68,"to":498.9,"content":"同事能做的就是"},{"from":498.9,"to":501.08,"content":"不停的在桌面和手机上来回调整"},{"from":501.08,"to":503.4,"content":"上个班时呈现出手舞足蹈的模样"},{"from":503.4,"to":504.68,"content":"已经成为办公室一警"},{"from":504.68,"to":505.32,"content":"实际上"},{"from":505.32,"to":507.48,"content":"微软在win11中推出的WSA"},{"from":507.48,"to":510.54,"content":"想要解决的正式移动app不适配PC端的问题"},{"from":510.54,"to":511.92,"content":"但就和UWP一样"},{"from":511.92,"to":513.25,"content":"不过是权宜之计罢了"},{"from":513.25,"to":514.77,"content":"鸿蒙电脑的多端融合"},{"from":514.77,"to":517.88,"content":"或许才是应用程序多端适配问题的终极解法"},{"from":517.88,"to":519.24,"content":"除了多端融合的优势外"},{"from":519.24,"to":521.04,"content":"他们已经实际体验了一段时间后"},{"from":521.04,"to":522.28,"content":"还发现了这些特点"},{"from":522.28,"to":523.5,"content":"首先必须要提的是"},{"from":523.5,"to":525.69,"content":"与其他PC截然不同的AI功能"},{"from":525.69,"to":528.41,"content":"鸿蒙电脑从系统底层就接入了AI功能"},{"from":528.41,"to":530.41,"content":"按下电脑右侧的这个球星标志"},{"from":530.41,"to":531.55,"content":"就能唤醒小E"},{"from":531.55,"to":533.81,"content":"小艺可不仅仅是一个简单的语音助手"},{"from":533.81,"to":535.21,"content":"他能做的事情可多了"},{"from":535.21,"to":537.19,"content":"像什么从电脑上找文件什么的"},{"from":537.19,"to":538.21,"content":"只是小菜一碟"},{"from":538.21,"to":540.39,"content":"它能帮你翻译和总结文件内容"},{"from":540.39,"to":543.15,"content":"甚至能够根据总结的内容直接写一份读后感"},{"from":543.15,"to":543.85,"content":"这就完了吗"},{"from":543.85,"to":545.68,"content":"当然不是读后感都有了"},{"from":545.68,"to":547.2,"content":"顺带再做个汇报的PPT"},{"from":547.2,"to":547.82,"content":"很合理吧"},{"from":547.82,"to":548.72,"content":"直接复制内容"},{"from":548.72,"to":549.66,"content":"并且跟小艺说"},{"from":549.66,"to":552.13,"content":"把这份读后感做成PPT用于汇报"},{"from":552.13,"to":553.99,"content":"小易就会打开WPSS"},{"from":553.99,"to":556.77,"content":"并自动帮你制作一份符合主题的PPPT"},{"from":556.77,"to":557.77,"content":"要觉得不满意"},{"from":557.77,"to":559.22,"content":"还可以在PPT里修改"},{"from":559.22,"to":559.94,"content":"总结一下"},{"from":559.94,"to":561.46,"content":"通过小E我们可以找文件"},{"from":561.46,"to":561.96,"content":"看文件"},{"from":561.96,"to":562.54,"content":"翻译文件"},{"from":562.54,"to":563.18,"content":"总结文件"},{"from":563.18,"to":563.74,"content":"写读后感"},{"from":563.74,"to":564.7,"content":"做PPT诶"},{"from":564.7,"to":567.28,"content":"慢着我怎么感觉他好像干的都是我的活"},{"from":567.28,"to":572.27,"content":"他说的全是我的词儿啊"},{"from":572.27,"to":574.09,"content":"除了丰富的AI功能之外"},{"from":574.09,"to":576.09,"content":"鸿蒙电脑软件上新的速度也很快"},{"from":576.09,"to":577.51,"content":"像是飞出剪映悟空图"},{"from":577.51,"to":578.47,"content":"像中望cad"},{"from":578.47,"to":581.29,"content":"万星喵影等生产力工具的使用体验也都还不错"},{"from":581.29,"to":582.63,"content":"比起这些生产力工具"},{"from":582.63,"to":584.41,"content":"其实我更想聊的是一些像B站"},{"from":584.41,"to":586.33,"content":"知乎抖音这样的融合生态应用"},{"from":586.33,"to":587.07,"content":"前面说了"},{"from":587.07,"to":588.73,"content":"移动端的生态经过多年发展"},{"from":588.73,"to":589.98,"content":"已经独立于桌面端了"},{"from":589.98,"to":592.74,"content":"以至于很多公司其实根本不在出中低端应用"},{"from":592.74,"to":594.94,"content":"或者只推出一个简略的网页版面"},{"from":594.94,"to":595.62,"content":"对这种情况"},{"from":595.62,"to":598.3,"content":"华为的多端融合生态应用就能发挥大作用了"},{"from":598.3,"to":599.76,"content":"对于软件开发者来说"},{"from":599.76,"to":600.9,"content":"只要开发一次应用"},{"from":600.9,"to":602.46,"content":"就能在所有设备上适配"},{"from":602.46,"to":603.84,"content":"大大节省了开发难度"},{"from":603.84,"to":605.34,"content":"也提高了适配的动力"},{"from":605.34,"to":606.18,"content":"对于用户来说"},{"from":606.18,"to":607.86,"content":"特别是那些主要的工作任务"},{"from":607.86,"to":608.98,"content":"都是在移动端完成的"},{"from":608.98,"to":610.38,"content":"用户一个积极适配"},{"from":610.38,"to":612.54,"content":"且能融合桌面和移动端生态的设备"},{"from":612.54,"to":613.83,"content":"才是他们更需要的"},{"from":613.83,"to":614.95,"content":"比如前面讲到的"},{"from":614.95,"to":617.49,"content":"有些同事工作主要就是靠移动app完成"},{"from":617.49,"to":619.09,"content":"那么鸿蒙的融合生态应用"},{"from":619.09,"to":621.42,"content":"就可以让所有的工作都在桌面上完成"},{"from":621.42,"to":623.28,"content":"而不用手机电脑来回折腾"},{"from":623.28,"to":623.86,"content":"我们电脑"},{"from":623.86,"to":624.94,"content":"还有一点做的特别好"},{"from":624.94,"to":626.4,"content":"那就是跨设备连接"},{"from":626.4,"to":628.6,"content":"目前手上有两台以上鸿蒙设备的同学"},{"from":628.6,"to":629.7,"content":"应该知道我在说什么"},{"from":629.7,"to":632.68,"content":"用我们手上的nova14和Macbook pro来展示"},{"from":632.68,"to":634.18,"content":"在手机上刷B站的时候"},{"from":634.18,"to":635.98,"content":"PC上也会出现一个B站图标"},{"from":635.98,"to":639,"content":"点击这个图标应用很自然的就会过渡到电脑上"},{"from":639,"to":640.54,"content":"光是屏幕共享还不算什么"},{"from":640.54,"to":641.9,"content":"虹膜还能共享摄像头"},{"from":641.9,"to":644.61,"content":"在桌面上右键选择从其他设备导入"},{"from":644.61,"to":646.59,"content":"除了简单的导入文件和图片外"},{"from":646.59,"to":649.44,"content":"还可以直接使用nova14的摄像头用于拍照"},{"from":649.44,"to":650.34,"content":"点击拍摄"},{"from":650.34,"to":653.32,"content":"最终拍到的照片就直接出现在了电脑桌面"},{"from":653.32,"to":655.36,"content":"当然都是在PC上操作了"},{"from":655.36,"to":657.34,"content":"键盘和鼠标一定是必不可少的"},{"from":657.34,"to":659.06,"content":"鸿蒙设备的跨设备互联"},{"from":659.06,"to":661.44,"content":"就连键鼠之间的操作也给你考虑到了"},{"from":661.44,"to":662.86,"content":"将鼠标移动到屏幕边缘"},{"from":662.86,"to":663.5,"content":"继续移动"},{"from":663.5,"to":665.23,"content":"鼠标就穿越到nova14上了"},{"from":665.23,"to":666.99,"content":"这样鼠标不仅可以控制PC"},{"from":666.99,"to":668.05,"content":"也可以控制手机"},{"from":668.05,"to":669.41,"content":"当然键盘也是一样"},{"from":669.41,"to":670.49,"content":"选一个输入框"},{"from":670.49,"to":672.27,"content":"可以直接用键盘进行输入"},{"from":672.27,"to":675.079,"content":"这样原本割裂的两种操作就融为了一体"},{"from":675.079,"to":677.219,"content":"鼠标在多设备之间来回穿越"},{"from":677.219,"to":678.399,"content":"可不只是为了好玩"},{"from":678.399,"to":680.799,"content":"能够大大方便多设备联合使用"},{"from":680.799,"to":683.45,"content":"像是女同学在手机上拍了美美的照片"},{"from":683.45,"to":684.87,"content":"就可以直接通过鼠标"},{"from":684.87,"to":686.91,"content":"将相册里的照片拖到电脑上"},{"from":686.91,"to":689.73,"content":"然后通过悟空图像就可以直接开始修图了"},{"from":689.73,"to":691.73,"content":"或者有同学有cad设计的需求"},{"from":691.73,"to":694.56,"content":"也可以直接将电脑上做好的图纸拖到手机"},{"from":694.56,"to":696.86,"content":"然后发送给对接的同事或者客户"},{"from":696.86,"to":698.88,"content":"省去了多端来回传输的操作"},{"from":698.88,"to":699.89,"content":"非常便利"},{"from":699.89,"to":702.43,"content":"鸿蒙的设备互联做的最好的一点是无感"},{"from":702.43,"to":703.79,"content":"很自然且符合逻辑"},{"from":703.79,"to":705.4,"content":"多台鸿蒙设备凑到一起"},{"from":705.4,"to":706.72,"content":"互相之间浑然一体"},{"from":706.72,"to":708.08,"content":"操作起来没有违和感"},{"from":708.08,"to":709.06,"content":"这一点就很棒"},{"from":709.06,"to":711.88,"content":"好现在我们再回头看开头抛出的问题"},{"from":711.88,"to":713.9,"content":"像电脑和手机越来越相似"},{"from":713.9,"to":715.26,"content":"这是真的有问题了吗"},{"from":715.26,"to":716.26,"content":"请下一个暴论"},{"from":716.26,"to":718.25,"content":"更简单的操作就是更先进"},{"from":718.25,"to":720.95,"content":"光是电脑自己的发展历程就足以佐证"},{"from":720.95,"to":721.85,"content":"1974年"},{"from":721.85,"to":723.15,"content":"雅达利88800发布"},{"from":723.15,"to":725.85,"content":"标志着个人电脑正式进入了千家万户"},{"from":725.85,"to":727.85,"content":"可是来改变计算机命运的终端"},{"from":727.85,"to":729.31,"content":"甚至没有键盘和鼠标"},{"from":729.31,"to":730.51,"content":"想要完成操作"},{"from":730.51,"to":732.73,"content":"使用者需要使用二进制机器码"},{"from":732.73,"to":735.8,"content":"逐个字节的通过前面板的开关输入到内存中"},{"from":735.8,"to":736.64,"content":"1977年"},{"from":736.64,"to":737.48,"content":"apple two发布"},{"from":737.48,"to":739.38,"content":"有了可以操作的屏幕和键盘"},{"from":739.38,"to":740.94,"content":"但此时想要使用电脑"},{"from":740.94,"to":743.46,"content":"还是得熟练掌握basic指令才行"},{"from":743.46,"to":744.7,"content":"直到1984年"},{"from":744.7,"to":745.8,"content":"麦金塔出现时"},{"from":745.8,"to":748.5,"content":"大家才开始使用图形化界面来操作电脑"},{"from":748.5,"to":749.16,"content":"到如今"},{"from":749.16,"to":750.3,"content":"人们已经无法想象"},{"from":750.3,"to":752.98,"content":"电脑如果没有屏幕和鼠标该如何操作"},{"from":752.98,"to":756.14,"content":"但在那些习惯使用命令行控制计算机的人看来"},{"from":756.14,"to":759.38,"content":"也许GUI界面本身也束缚了他们一定的发挥"},{"from":759.38,"to":761.88,"content":"看看移动终端和桌面端的占比就知道了"},{"from":761.88,"to":763.34,"content":"截止2024年11月"},{"from":763.34,"to":765.82,"content":"全球互联网流量中的64.04%"},{"from":765.82,"to":767.14,"content":"都来自于移动设备"},{"from":767.14,"to":769.67,"content":"而只有35.96%来自桌面"},{"from":769.67,"to":772.79,"content":"造成这一现象的原因不是移动设备性能更强"},{"from":772.79,"to":773.43,"content":"功能更多"},{"from":773.43,"to":774.23,"content":"作用更全面"},{"from":774.23,"to":775.59,"content":"而是它的操作更简单"},{"from":775.59,"to":776.55,"content":"使用更便捷"},{"from":776.55,"to":779.56,"content":"当然现在还有人担心鸿蒙电脑的软件适配不行"},{"from":779.56,"to":780.34,"content":"没有生产力"},{"from":780.34,"to":781.16,"content":"对于这个质疑"},{"from":781.16,"to":783.06,"content":"鸿蒙甚至已经回答过一次了"},{"from":783.06,"to":784.5,"content":"我们手机刚发布时"},{"from":784.5,"to":785.64,"content":"软件适配也很不足"},{"from":785.64,"to":787.88,"content":"但至今已经适配了超过2万款"},{"from":787.88,"to":789.56,"content":"而且这一数据还在提高"},{"from":789.56,"to":790.36,"content":"相同的事"},{"from":790.36,"to":791.62,"content":"既然已经发生过一次了"},{"from":791.62,"to":793.24,"content":"当然也能够发生第二次"},{"from":793.24,"to":794.48,"content":"最后我想说"},{"from":794.48,"to":796.58,"content":"不管你对手机和电脑的预期是怎样"},{"from":796.58,"to":798.95,"content":"也不管鸿蒙系统是否符合你的预期"},{"from":798.95,"to":800.71,"content":"停滞了20多年的PC市场"},{"from":800.71,"to":802.37,"content":"能够迎来一位新的搅局者"},{"from":802.37,"to":804.15,"content":"怎么看都是好事"},{"from":804.43,"to":804.91,"content":"好了"},{"from":805.79,"to":806.55,"content":"这就是今天的内容"},{"from":806.55,"to":807.43,"content":"如果你觉得好的话"},{"from":807.43,"to":808.43,"content":"欢迎你一键三连"},{"from":808.43,"to":809.58,"content":"如果你有什么想说的"},{"from":809.58,"to":811.2,"content":"欢迎你在评论区和我互动"},{"from":811.2,"to":812.5,"content":"最后拜托的关注一下"},{"from":812.5,"to":814.38,"content":"我们也可以关注一下我们的公众号"},{"from":814.38,"to":817.08,"content":"差评我们下次再见"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:02:14.611Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:02:11.911Z"}}
