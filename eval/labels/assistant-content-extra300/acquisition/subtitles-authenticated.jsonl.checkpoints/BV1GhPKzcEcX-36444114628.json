{"schemaVersion":1,"bvid":"BV1GhPKzcEcX","cid":36444114628,"subtitles":[{"from":0,"to":1.8,"content":"猪一生都被关在猪圈里"},{"from":1.8,"to":2.88,"content":"为什么不会抑郁"},{"from":2.88,"to":4.08,"content":"谁说猪不会抑郁"},{"from":4.08,"to":4.66,"content":"子非猪"},{"from":4.66,"to":5.66,"content":"安知猪不抑郁"},{"from":5.66,"to":8.5,"content":"猪猪一辈子被圈养在狭窄逼仄的圈舍里"},{"from":8.5,"to":11.32,"content":"生活里唯一的等待就是被屠宰时刻的来临"},{"from":11.32,"to":13.56,"content":"那日子过得就像夏侯敦进死胡同"},{"from":13.56,"to":14.66,"content":"一眼就能望到头"},{"from":14.66,"to":15.74,"content":"他当然会抑郁"},{"from":15.74,"to":18.82,"content":"要知道抑郁在生物学上是个很高级的东西"},{"from":18.82,"to":20.84,"content":"并不是所有的动物都能体会得到"},{"from":20.84,"to":23.44,"content":"首要条件就是得有一套复杂的神经系统"},{"from":23.44,"to":25.36,"content":"所以你要说一只蚊子会抑郁"},{"from":25.36,"to":26.42,"content":"那大概率不可能"},{"from":26.42,"to":28.259,"content":"而猪猪则完全有可能抑郁"},{"from":28.259,"to":30.459,"content":"因为它们的神经系统已经足够复杂"},{"from":30.459,"to":31.039,"content":"和高级"},{"from":31.039,"to":33.939,"content":"猪的大脑有22亿个神经元跟狗子相当"},{"from":33.939,"to":36.1,"content":"智商相当于人类3~5岁的小孩"},{"from":36.1,"to":37.66,"content":"而且猪本身在自然界"},{"from":37.66,"to":39.42,"content":"就是一种非常爱探索的动物"},{"from":39.42,"to":41.9,"content":"它们会花大量时间拱土觅食玩耍"},{"from":41.9,"to":42.7,"content":"而在猪圈里"},{"from":42.7,"to":44.14,"content":"这些本能都无法施展"},{"from":44.14,"to":45.44,"content":"长期下来就会抑郁"},{"from":45.44,"to":47.44,"content":"最典型的表现就是刻板行为"},{"from":47.44,"to":49.74,"content":"有些是在一刻不停的来回踱步"},{"from":49.74,"to":51,"content":"像被上了发条一样"},{"from":51,"to":53.1,"content":"有些是反复啃咬栏杆空嚼"},{"from":53.1,"to":55.7,"content":"这本质上和咱们人类反复咬指甲一样"},{"from":55.7,"to":57.7,"content":"都是内在心理压力的外在表现"},{"from":57.7,"to":59.42,"content":"还有一些猪猪会不吃不动"},{"from":59.42,"to":60.22,"content":"整天趴着"},{"from":60.22,"to":60.92,"content":"眼神空洞"},{"from":60.92,"to":63.24,"content":"对食物玩具同伴完全没有兴趣"},{"from":63.24,"to":64.02,"content":"甚至性冷淡"},{"from":64.02,"to":64.8,"content":"不愿意交配"},{"from":64.8,"to":66.68,"content":"而另外有一些猪猪则相反"},{"from":66.68,"to":68.06,"content":"它们会变得异常暴躁"},{"from":68.06,"to":68.76,"content":"相互攻击"},{"from":68.76,"to":69.3,"content":"摇尾巴"},{"from":69.3,"to":70.5,"content":"这些都是抑郁"},{"from":70.5,"to":72.68,"content":"所以说猪猪也是向往自由的"},{"from":72.68,"to":73.72,"content":"如果你细心观察"},{"from":73.72,"to":74.36,"content":"就会发现"},{"from":74.36,"to":77.26,"content":"散养的猪和圈养的猪简直就是判若两猪"},{"from":77.26,"to":79.04,"content":"我想起那天夕阳下的奔跑"},{"from":79.04,"to":80.34,"content":"那是我逝去的青春"},{"from":80.34,"to":83.4,"content":"另外对猪猪这种大脑足够发达的哺乳动物来讲"},{"from":83.4,"to":85.34,"content":"也是需要被提供情绪价值的"},{"from":85.34,"to":86.02,"content":"你对它好"},{"from":86.02,"to":86.88,"content":"给它加甘草"},{"from":86.88,"to":87.86,"content":"改善住宿环境"},{"from":87.86,"to":88.54,"content":"她就开心"},{"from":88.54,"to":89.28,"content":"你对他差"},{"from":89.28,"to":90,"content":"经常虐待"},{"from":90,"to":90.6,"content":"鞭打他"},{"from":90.6,"to":91.24,"content":"他就抑郁"},{"from":91.24,"to":93.26,"content":"日子怎么可能跟谁过都一样呢"},{"from":93.26,"to":94.08,"content":"其实除了猪"},{"from":94.08,"to":96.72,"content":"大部分智商高的动物或多或少都会抑郁"},{"from":96.72,"to":98.72,"content":"比如马马是情绪高度敏感"},{"from":98.72,"to":99.94,"content":"特别依赖主人的动物"},{"from":99.94,"to":101.28,"content":"所以他们也需要关心"},{"from":101.28,"to":102.52,"content":"否则就抑郁给你看"},{"from":102.52,"to":104.28,"content":"有些赛马在上场比赛前"},{"from":104.28,"to":106.4,"content":"主人甚至会提前对他做心理建设"},{"from":106.4,"to":107.42,"content":"给他加油打气"},{"from":107.42,"to":108.98,"content":"庆祝的草料已为你放好"},{"from":108.98,"to":110.3,"content":"千万不要膨胀的太早"},{"from":110.3,"to":111.76,"content":"把每一条赛道都跑好"},{"from":111.76,"to":113.78,"content":"回到马厩去见家乡父老"},{"from":113.78,"to":115.14,"content":"再比如说虎鲸"},{"from":115.14,"to":116.8,"content":"虎鲸的综合智商非常高"},{"from":116.8,"to":119.42,"content":"大概相当于人类13~16岁的青少年"},{"from":119.42,"to":122.16,"content":"所以圈养的虎鲸很多都会出现情绪问题"},{"from":122.16,"to":123.22,"content":"有些漂浮不动"},{"from":123.22,"to":123.98,"content":"眼神空洞"},{"from":123.98,"to":125.12,"content":"有些反复撞墙"},{"from":125.12,"to":125.98,"content":"甩头转圈"},{"from":125.98,"to":128.74,"content":"甚至有些严重的还会攻击同类和训练师"},{"from":128.74,"to":130.74,"content":"而且几乎所有圈养的虎鲸"},{"from":130.74,"to":132.42,"content":"都会出现被其坍塌的情况"},{"from":132.42,"to":133.92,"content":"而野生的虎鲸则不会"},{"from":133.92,"to":135.2,"content":"这也跟抑郁有关"},{"from":135.2,"to":137.42,"content":"所以你看猪猪长期被圈养起来"},{"from":137.42,"to":138.64,"content":"他怎么能不抑郁呢"},{"from":138.64,"to":139.76,"content":"这就跟咱们打工人"},{"from":139.76,"to":142.86,"content":"长期鸡在狭窄的工位上伏案工作也会抑郁一样"},{"from":142.86,"to":143.72,"content":"不仅会抑郁"},{"from":143.72,"to":145.46,"content":"长期工作对眼睛也不好"},{"from":145.46,"to":146.48,"content":"比如道容这几天"},{"from":146.48,"to":147.58,"content":"但连续熬夜赶稿"},{"from":147.58,"to":148.76,"content":"眼睛就难受得厉害"},{"from":148.76,"to":151.96,"content":"不过还好我有这台妙界蒸汽雾化眼部按摩仪"},{"from":151.96,"to":154.56,"content":"他急雾化点阵按摩热敷为一体"},{"from":154.56,"to":156.9,"content":"经常熬夜的朋友可以用它按摩眼袋"},{"from":156.9,"to":157.84,"content":"淡化黑眼圈"},{"from":157.84,"to":159.48,"content":"也可以给眼睛雾化补水"},{"from":159.48,"to":161.76,"content":"它还升级了新一代的点阵降噪技术"},{"from":161.76,"to":162.7,"content":"按摩不扰人"},{"from":162.7,"to":163.58,"content":"三八节期间"},{"from":163.58,"to":164.56,"content":"我薅到不少券"},{"from":164.56,"to":167.44,"content":"朋友们可以选它自用或是当礼物送给家人"},{"from":167.44,"to":168.52,"content":"像我们日常疲劳"},{"from":168.52,"to":170.24,"content":"眼睛酸涩干痒不适"},{"from":170.24,"to":171.4,"content":"都可能是干眼症"},{"from":171.4,"to":172.62,"content":"青光眼的预警信号"},{"from":172.62,"to":174.36,"content":"可以试下妙界的雾化功能"},{"from":174.36,"to":175.5,"content":"出物多还细腻"},{"from":175.5,"to":176.76,"content":"搭配上热敷泪液"},{"from":176.76,"to":178.08,"content":"很快就能覆盖角膜"},{"from":178.08,"to":179.24,"content":"放松效果特别好"},{"from":179.24,"to":180.8,"content":"而且升级的点阵按摩头"},{"from":180.8,"to":183,"content":"能物理按摩眼周穴位以及眼袋"},{"from":183,"to":183.6,"content":"太阳穴"},{"from":183.6,"to":185.14,"content":"用着比做眼操更舒服"},{"from":185.14,"to":187.08,"content":"我每次用完头脑都会很清醒"},{"from":187.08,"to":188.2,"content":"妙界续航还长"},{"from":188.2,"to":189.06,"content":"有五种模式"},{"from":189.06,"to":190.74,"content":"里面的弧形鼻翼能遮光"},{"from":190.74,"to":191.44,"content":"不压鼻子"},{"from":191.44,"to":192.98,"content":"出门带着放松很方便"},{"from":192.98,"to":195.66,"content":"日常能用来冰敷消肿或是连蓝牙放歌"},{"from":195.66,"to":197.64,"content":"听听立体双扬声器的好音质"},{"from":197.64,"to":199.46,"content":"确实是自用送礼的好选择"},{"from":199.46,"to":201.12,"content":"大家可以领三八节优惠券"},{"from":201.12,"to":201.86,"content":"抄底入手"},{"from":201.86,"to":202.74,"content":"保价送运险"},{"from":202.74,"to":204.9,"content":"一年内质量问题免费换新礼盒"},{"from":204.9,"to":206.12,"content":"包装能代写贺卡"},{"from":206.12,"to":207.3,"content":"需要的就来试试吧"},{"from":207.3,"to":210.02,"content":"那为什么我们平时都不觉得猪猪会抑郁呢"},{"from":210.02,"to":211.94,"content":"这主要是因为他们早就绝望了"},{"from":214.68,"to":217.18,"content":"当一些圈养的动物在反复逃跑失败后"},{"from":217.18,"to":218.98,"content":"大脑就会直接关闭挣扎系统"},{"from":218.98,"to":219.96,"content":"猪猪也是一样"},{"from":219.96,"to":221.28,"content":"出生就被关在圈里"},{"from":221.28,"to":221.7,"content":"逃不掉"},{"from":221.7,"to":223,"content":"躲不开也反抗不了"},{"from":223,"to":224.04,"content":"最后就麻木了"},{"from":224.04,"to":226.96,"content":"而咱们看到那些安静的趴在圈里一动不动的猪"},{"from":226.96,"to":227.86,"content":"不会觉得它抑郁"},{"from":227.86,"to":230.28,"content":"反而会认为这只猪性格很好很乖"},{"from":230.28,"to":232.76,"content":"再就是猪的寿命虽然有十几20年"},{"from":232.76,"to":233.98,"content":"但在现代化养殖下"},{"from":233.98,"to":235.94,"content":"商品猪一般六个月就出栏了"},{"from":235.94,"to":237.1,"content":"类比到人类的寿命"},{"from":237.1,"to":238.92,"content":"就相当于是两岁半就出栏了"},{"from":238.92,"to":240.46,"content":"猪神怪还没有形成的时候"},{"from":240.46,"to":241.4,"content":"就要被屠宰了"},{"from":241.4,"to":242.37,"content":"根本来不及"},{"from":242.37,"to":244.45,"content":"最后一点就是在大部分人看来"},{"from":244.45,"to":245.87,"content":"猪跟阿猫阿狗不一样"},{"from":245.87,"to":246.62,"content":"不是宠物"},{"from":246.62,"to":248.4,"content":"所以也不大关心他们的情绪"},{"from":248.4,"to":250.62,"content":"从出生到上桌也就180天"},{"from":250.62,"to":251.86,"content":"哪来得及跟你矫情"},{"from":251.86,"to":254.38,"content":"我管你这那的做成红烧肉还抑郁"},{"from":254.38,"to":258.3,"content":"不说出五名吓汝一跳"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:05:27.259Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:05:24.755Z"}}
