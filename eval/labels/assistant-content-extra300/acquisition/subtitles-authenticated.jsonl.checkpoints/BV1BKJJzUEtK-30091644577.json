{"schemaVersion":1,"bvid":"BV1BKJJzUEtK","cid":30091644577,"subtitles":[{"from":0.58,"to":3.62,"content":"最高端的厨师往往以食材的形式出现"},{"from":3.62,"to":7.52,"content":"就像最高级的猎人总是伪装成猎物吸引你上钩"},{"from":7.52,"to":10.84,"content":"最近两周大厨艾可菲应该被大家品尝啊"},{"from":10.84,"to":12.05,"content":"不品鉴够了"},{"from":12.05,"to":14.77,"content":"是时候开始今日份的元神大学习了"},{"from":14.77,"to":17.37,"content":"那就由我来讲一下艾可菲背后的历史"},{"from":17.37,"to":18.65,"content":"文化故事吧"},{"from":18.65,"to":19.69,"content":"很多人都说"},{"from":19.69,"to":23.55,"content":"他的原型是现代法餐的开创者奥古斯特艾科菲"},{"from":23.55,"to":25.47,"content":"但具体表现在哪里呢"},{"from":25.47,"to":27.08,"content":"这也得细细来品鉴"},{"from":27.08,"to":28.1,"content":"1846年"},{"from":28.1,"to":30.6,"content":"奥古斯特埃科菲出生于法国南部"},{"from":30.6,"to":31.94,"content":"尼斯附近的一个小镇"},{"from":31.94,"to":32.9,"content":"12岁开始"},{"from":32.9,"to":35.129,"content":"他就在叔叔的餐馆里当学徒"},{"from":35.129,"to":36.229,"content":"因为个子太矮"},{"from":36.229,"to":38.289,"content":"以至于无法打开烤箱的门"},{"from":38.289,"to":41.04,"content":"所以他坚持穿高跟靴子上班"},{"from":41.04,"to":43.84,"content":"经典法国矮子开局注定成就不凡"},{"from":43.84,"to":47.49,"content":"人生原神把他娘化成白丝高跟的美女"},{"from":47.49,"to":48.87,"content":"也是有理有据的"},{"from":48.87,"to":50.69,"content":"毕竟白丝高跟这些东西"},{"from":50.69,"to":52.65,"content":"不就是你们法国男人爱玩的吗"},{"from":52.65,"to":55.64,"content":"一比五四的路易14肯定会为此点赞"},{"from":55.64,"to":56.56,"content":"1865年"},{"from":56.56,"to":57.84,"content":"埃科菲应征入伍"},{"from":57.84,"to":59.38,"content":"成了炊事班掌勺的"},{"from":59.38,"to":60.28,"content":"但很可惜"},{"from":60.28,"to":62.62,"content":"法国矮子的风云时代早已远去"},{"from":62.62,"to":66.38,"content":"法军在几年后的普法战争中就被德国人蹂躏了"},{"from":66.38,"to":67.68,"content":"1870年时"},{"from":67.68,"to":70.78,"content":"埃科菲所属的部队与梅斯被德军围困"},{"from":70.78,"to":72.66,"content":"竟然坚持了两个月才投降"},{"from":72.66,"to":73.64,"content":"实属不易"},{"from":73.64,"to":75.94,"content":"正是在这物资匮乏的两个月中"},{"from":75.94,"to":78.16,"content":"埃科菲精进了自己的烹饪技巧"},{"from":78.16,"to":79.919,"content":"开始尝试改良法餐"},{"from":79.919,"to":82.639,"content":"日后他所创立的当代厨师制度"},{"from":82.639,"to":84.92,"content":"也和这段军旅生涯密不可分"},{"from":84.92,"to":87.24,"content":"它规定一个厨房必须由主厨"},{"from":87.24,"to":89,"content":"副主厨和负责烤肉"},{"from":89,"to":89.46,"content":"煎鱼"},{"from":89.46,"to":93.28,"content":"冷菜甜品等各种专门分工的细分厨师"},{"from":93.28,"to":95.56,"content":"由此构成一个厨房旅团"},{"from":95.56,"to":97.88,"content":"这正是效仿了军队的等级制度"},{"from":97.88,"to":100.18,"content":"建立起严格高效的指挥系统"},{"from":100.18,"to":101.65,"content":"在原始设定中"},{"from":101.65,"to":104.29,"content":"艾克菲之所以对下属如此严厉"},{"from":104.29,"to":105.57,"content":"甚至被称为暴君"},{"from":105.57,"to":108.07,"content":"也是这种旅团制度本身所要求的"},{"from":108.07,"to":110.14,"content":"所以他的后继者沙凡娜"},{"from":110.14,"to":112.28,"content":"自然也就继承了这种管理方式"},{"from":112.28,"to":115.02,"content":"埃科菲还把高大的厨师帽设为定制"},{"from":115.02,"to":117.539,"content":"这当然不是因为他太矮的缘故"},{"from":117.539,"to":119.159,"content":"当代厨师帽的形制"},{"from":119.159,"to":121.679,"content":"据传是由安托万卡雷姆设计的"},{"from":121.679,"to":125.35,"content":"但埃科菲正式把它纳入了厨师的标准制服中"},{"from":125.35,"to":127.09,"content":"当时厨子的地位较低"},{"from":127.09,"to":128.959,"content":"被认为是主菜的劳工"},{"from":128.959,"to":132.539,"content":"但标准化的制服使得他们看起来和医生"},{"from":132.539,"to":134.239,"content":"律师一样体面有范儿"},{"from":134.239,"to":137.67,"content":"头戴高帽的埃科菲大厨更是成为当时的明星"},{"from":137.67,"to":141.519,"content":"所以原神的艾可菲也骄傲地顶着厨师帽"},{"from":141.519,"to":144.339,"content":"安托万卡雷姆比埃科菲早了一个世纪"},{"from":144.339,"to":147.75,"content":"被称为第一位法国名厨和现代糕点之父"},{"from":147.75,"to":149.91,"content":"他尤其钟爱巨大的装置蛋糕"},{"from":149.91,"to":151.79,"content":"还为拿破仑做过婚礼蛋糕"},{"from":151.79,"to":153.91,"content":"原神剧情中的德波大蛋糕"},{"from":153.91,"to":155.9,"content":"正是卡雷姆风格的甜点"},{"from":155.9,"to":156.74,"content":"他的遗作"},{"from":156.74,"to":160.17,"content":"19世纪的法国烹饪艺术被后世奉为经典"},{"from":160.17,"to":162.57,"content":"艾克菲的很多菜式都取材于此"},{"from":162.57,"to":164.95,"content":"只不过加以改良发扬光大"},{"from":164.95,"to":168.86,"content":"他后来写成的烹饪指南至今仍是厨艺圣经"},{"from":168.86,"to":170.06,"content":"原神剧情中"},{"from":170.06,"to":173.42,"content":"艾可菲把德波大密典残破的手稿整理出来"},{"from":173.42,"to":174.52,"content":"并传给后人"},{"from":174.52,"to":176.76,"content":"正是对这段历史的致敬"},{"from":176.76,"to":180,"content":"塔林姆还奠定了法餐的四种基本武将"},{"from":180,"to":180.66,"content":"鹤酱"},{"from":180.66,"to":181.48,"content":"天鹅绒酱"},{"from":181.48,"to":183.38,"content":"贝夏梅尔酱和荷兰酱"},{"from":183.38,"to":185.3,"content":"埃科菲又增加了番茄酱"},{"from":185.3,"to":187.84,"content":"使之成为当今法餐五大母酱"},{"from":187.84,"to":190.84,"content":"此外埃科菲还有一项重要的制度革新"},{"from":190.84,"to":192.18,"content":"那就是分段上菜"},{"from":192.18,"to":194.1,"content":"这并不是法国料理的传统"},{"from":194.1,"to":195.86,"content":"而是来自于俄罗斯餐"},{"from":195.86,"to":197.6,"content":"艾克菲将此法引入"},{"from":201.46,"to":203.97,"content":"这也大大提高了法餐的逼格"},{"from":203.97,"to":205.81,"content":"原神艾可菲的命座中"},{"from":205.81,"to":209.11,"content":"从一命的餐前玄武到六命的甜点茶话"},{"from":209.11,"to":212.04,"content":"正式模拟了法餐的上菜顺序"},{"from":212.04,"to":214.24,"content":"但是在原神剧情中"},{"from":214.24,"to":216.8,"content":"艾可菲给我们做过一道经典黑暗料理"},{"from":216.8,"to":217.959,"content":"鱼与咏唱派"},{"from":217.959,"to":219.299,"content":"也就是英国名菜"},{"from":219.299,"to":220.159,"content":"仰望星空"},{"from":220.159,"to":221.459,"content":"这又是为什么呢"},{"from":221.459,"to":223.42,"content":"法国玩家看了会生气吗"},{"from":223.42,"to":225.26,"content":"这点还真不用我们担心"},{"from":225.26,"to":227.38,"content":"也是有历史原型做背书的"},{"from":227.38,"to":228.38,"content":"1884年"},{"from":228.38,"to":230.48,"content":"在法国已经小有名气的埃科菲"},{"from":230.48,"to":233.76,"content":"得到了知名酒店经理人凯撒利兹的赏识"},{"from":233.76,"to":235.32,"content":"后者于1890年"},{"from":235.32,"to":237.72,"content":"将他带到了英国的萨沃伊酒店"},{"from":237.72,"to":240.65,"content":"此后埃科菲开始征战黑暗料理界"},{"from":240.65,"to":242.17,"content":"在引入法餐的同时"},{"from":242.17,"to":244.3,"content":"他并未否定英国本土餐饮"},{"from":244.3,"to":246.98,"content":"更多的是进行厨房制度改革"},{"from":246.98,"to":249.16,"content":"以及推出照单点菜的模式"},{"from":249.16,"to":251.64,"content":"让客人可以自行选择菜品"},{"from":251.64,"to":253.44,"content":"如果在他的菜单上出现"},{"from":253.44,"to":255.51,"content":"仰望星空也并不是什么怪事"},{"from":255.51,"to":257.63,"content":"但埃克菲本人拒绝学习英语"},{"from":257.63,"to":260.13,"content":"因为他认为如果像英国人一样讲话"},{"from":260.13,"to":261.33,"content":"就会影响思维"},{"from":261.33,"to":263.6,"content":"最终难免会做出烂菜来"},{"from":263.6,"to":264.52,"content":"在英国"},{"from":264.52,"to":266.66,"content":"埃科菲也创制了不少新的菜品"},{"from":266.66,"to":269.4,"content":"其中最著名的当属蜜桃梅尔巴"},{"from":269.4,"to":272.38,"content":"当时澳大利亚女歌星梅尔巴来到英国"},{"from":272.38,"to":273.78,"content":"演唱瓦格纳的歌剧"},{"from":273.78,"to":276.13,"content":"罗恩格林在庆功晚宴上"},{"from":276.13,"to":278.41,"content":"埃科菲特制了一款甜点献给他"},{"from":278.41,"to":280.39,"content":"用桃子搭配香草冰淇淋"},{"from":280.39,"to":281.72,"content":"置于一个银盘上"},{"from":281.72,"to":284.98,"content":"旁边放着歌剧里的一只天鹅的冰雕"},{"from":284.98,"to":287.62,"content":"获得了在场贵族的一致好评"},{"from":287.62,"to":290.549,"content":"这道甜品最初被称为蜜桃天鹅"},{"from":290.549,"to":293.409,"content":"后来又被埃科菲加上了覆盆子泥"},{"from":293.409,"to":295.949,"content":"以蜜桃梅尔巴的名字流传后世"},{"from":295.949,"to":297.45,"content":"成为他的得意之作"},{"from":297.45,"to":300.43,"content":"这就是为什么爱可飞在游戏中的待机动作"},{"from":300.43,"to":302.3,"content":"会用冰雕出一只天鹅"},{"from":302.3,"to":304.98,"content":"埃科菲在英国还推广了冰淇淋"},{"from":304.98,"to":308.63,"content":"或许这也是艾可菲是冰系角色的原因"},{"from":308.63,"to":311.11,"content":"从蜜桃梅尔巴事件可以看出"},{"from":311.11,"to":312.82,"content":"埃科菲很善于营销"},{"from":312.82,"to":315.7,"content":"他总能在合适的时机推出合适的菜品"},{"from":315.7,"to":317.96,"content":"迎合当时权贵名流的喜好"},{"from":317.96,"to":320.1,"content":"甚至是蹭这些人的热度"},{"from":320.1,"to":322.98,"content":"英王和威尔士亲王等人都是他的常客"},{"from":322.98,"to":324.26,"content":"但树大招风"},{"from":324.26,"to":327.63,"content":"很快埃科菲就迎来了他人生的至暗时刻"},{"from":327.63,"to":328.75,"content":"1898年"},{"from":328.75,"to":330.79,"content":"埃科菲和他的合伙人凯撒利兹"},{"from":330.79,"to":333.57,"content":"被认为在酒店采购项目中吃回扣"},{"from":333.57,"to":335.87,"content":"萨沃伊酒店因此开除了埃克菲"},{"from":335.87,"to":336.7,"content":"据报道"},{"from":336.7,"to":339.48,"content":"酒店和厨房的工作人员都支持埃克菲"},{"from":339.48,"to":342.14,"content":"由此他们与管理方发生了激烈的冲突"},{"from":342.14,"to":344.36,"content":"最终利兹交了4000英镑"},{"from":344.36,"to":346.32,"content":"埃科菲交了500英镑的罚金"},{"from":346.32,"to":347.72,"content":"此事就此了结"},{"from":347.72,"to":349.36,"content":"两人因此也离开了英国"},{"from":349.36,"to":350.35,"content":"回到法国"},{"from":350.35,"to":354.3,"content":"这次事件就是游戏中艾可菲坐牢经历的原型"},{"from":354.3,"to":356.88,"content":"在剧情中也是采购部门出了问题"},{"from":356.88,"to":358.8,"content":"以艾可菲承担责任结束"},{"from":358.8,"to":362.52,"content":"不过编剧在这里巧妙地设置了幽光速的情节"},{"from":362.52,"to":365.62,"content":"由此把主题牵引到雷姆利亚人的饮食上"},{"from":365.62,"to":367.28,"content":"这也是有历史背景的"},{"from":367.28,"to":368.2,"content":"众所周知"},{"from":368.2,"to":369.72,"content":"雷姆利亚就是古罗马"},{"from":369.72,"to":371.44,"content":"而罗马人确实喜欢"},{"from":371.44,"to":374.32,"content":"在饮食中添加一种刺激性的有毒物质"},{"from":374.32,"to":375.32,"content":"那就是醋酸"},{"from":375.32,"to":375.58,"content":"铅"},{"from":375.58,"to":376.68,"content":"又称铅糖"},{"from":376.68,"to":379.16,"content":"由于甘蔗在中世纪才传入欧洲"},{"from":379.16,"to":380.68,"content":"而蜂蜜又过于昂贵"},{"from":380.68,"to":383.11,"content":"所以当时的罗马人缺乏甜味剂"},{"from":383.11,"to":385.09,"content":"而恰巧醋酸铅带甜味"},{"from":385.09,"to":386.64,"content":"就成了罗马人的挚爱"},{"from":386.64,"to":389.04,"content":"他们不仅用铅锅煮葡萄酒喝"},{"from":389.04,"to":390.92,"content":"还用此法熬制出糖浆"},{"from":390.92,"to":393.17,"content":"撒在食物上调味或调色"},{"from":393.17,"to":394.07,"content":"久而久之"},{"from":394.07,"to":396.74,"content":"大量罗马人患上了慢性铅中毒"},{"from":396.74,"to":399.08,"content":"罗马人不是不知道这东西的危害"},{"from":399.08,"to":401.72,"content":"老普林尼在自然史中就承认过"},{"from":401.72,"to":404.52,"content":"但糖的诱惑谁又能抵挡得了呢"},{"from":404.52,"to":406.34,"content":"于是他们依旧乐此不疲"},{"from":406.34,"to":407.72,"content":"甚至有学者认为"},{"from":407.72,"to":410.16,"content":"尼禄的疯癫是因为铅中毒"},{"from":410.16,"to":413.27,"content":"罗马的衰亡也和这种普遍的慢性病有关"},{"from":413.27,"to":415.63,"content":"所以在艾可菲的剧情最后"},{"from":415.63,"to":417.99,"content":"他发现雷莫利亚秘宝就是幽光速"},{"from":417.99,"to":419.9,"content":"并非什么了不得的东西"},{"from":419.9,"to":423.48,"content":"毕竟在那个年代连糖分提纯的技术都不成熟"},{"from":423.48,"to":425.02,"content":"更别说什么甜点了"},{"from":425.02,"to":427.86,"content":"稍微刺激一下味觉就成了稀世珍品"},{"from":427.86,"to":431.92,"content":"这句话完全可以视作对古罗马物资匮乏的吐槽"},{"from":431.92,"to":433.2,"content":"但说来可笑"},{"from":433.2,"to":434.4,"content":"在剧情里"},{"from":434.4,"to":437.78,"content":"幽光速被雷姆利亚用来刺激野蛮人的情绪"},{"from":437.78,"to":439.56,"content":"使之更好地为自己作战"},{"from":439.56,"to":441.62,"content":"最后反派却将之视为秘宝"},{"from":441.62,"to":442.36,"content":"苦苦追寻"},{"from":442.36,"to":443.26,"content":"费尽心机"},{"from":443.26,"to":445.13,"content":"换来古人的当场打脸"},{"from":445.13,"to":445.93,"content":"搞了半天"},{"from":445.93,"to":449.53,"content":"枫丹人还是被其精神祖宗视为该死的野蛮人"},{"from":449.53,"to":451.01,"content":"这一波兜兜转转"},{"from":451.01,"to":452.97,"content":"到最后还是变成了儒法"},{"from":452.97,"to":454.97,"content":"我们讲回埃科菲的人生"},{"from":454.97,"to":457.59,"content":"他跟随丽兹去了巴黎的丽兹酒店"},{"from":457.59,"to":458.92,"content":"随后又重返英国"},{"from":458.92,"to":461.28,"content":"在伦敦卡尔顿酒店重整旗鼓"},{"from":461.28,"to":464.24,"content":"吸引许多上流社会客户离开了萨沃伊"},{"from":464.24,"to":466.419,"content":"由此喜迎事业第二春"},{"from":466.419,"to":469.58,"content":"他的成功秘诀之一是对鲜味的发掘"},{"from":469.58,"to":472.54,"content":"当事人普遍相信亚里士多德的四味说"},{"from":472.54,"to":474.74,"content":"即基本味觉只有四种"},{"from":474.74,"to":476.92,"content":"酸甜苦咸鲜味"},{"from":476.92,"to":480.62,"content":"则是在日本人池田菊苗发现谷氨酸的作用后"},{"from":480.62,"to":482.34,"content":"才逐渐被西方认可"},{"from":482.34,"to":485.66,"content":"为第五位的埃科菲并不懂化学"},{"from":485.66,"to":487.88,"content":"但他依靠自己的直觉和经验"},{"from":487.88,"to":489.76,"content":"找到了制造鲜味的方法"},{"from":489.76,"to":492.58,"content":"它通常用非常高的温度烧一片肉"},{"from":492.58,"to":496.32,"content":"这样就借由美拉德反应产生了一层烧焦的硬皮"},{"from":496.32,"to":498.88,"content":"然后他再加上某种液体炖煮"},{"from":498.88,"to":500.28,"content":"如香浓的牛肉汤"},{"from":500.28,"to":502.28,"content":"液体的蒸腾会溶解"},{"from":502.28,"to":504.94,"content":"粘在锅底的烧焦的蛋白质碎屑"},{"from":504.94,"to":507.929,"content":"它们就赋予了埃科菲的调味汁以鲜味"},{"from":507.929,"to":510.529,"content":"艾可菲命作了第二层鲜香味"},{"from":510.529,"to":511.729,"content":"鱼的炖煮艺术"},{"from":511.729,"to":513.23,"content":"对应的正是这种技术"},{"from":513.23,"to":515.85,"content":"而美拉德反应是一种非酶褐变"},{"from":515.85,"to":518.13,"content":"也经常被埃科菲用于烘焙"},{"from":518.13,"to":522.15,"content":"这就是命座第三层焦糖褐变的烘烤魔法的来历"},{"from":522.15,"to":522.99,"content":"游戏里"},{"from":522.99,"to":526.6,"content":"艾可菲最为人所赞誉的就是对风味物质的拆解"},{"from":526.6,"to":528.86,"content":"对枫丹固有美味认知的挑战"},{"from":528.86,"to":532.74,"content":"这对应的也是埃科菲在制造鲜味上的种种尝试"},{"from":532.74,"to":535.18,"content":"不过艾可菲还更进一步"},{"from":535.18,"to":536.78,"content":"在枫丹机械的加持下"},{"from":536.78,"to":539.02,"content":"直接进入了分子料理的层面"},{"from":539.02,"to":540.88,"content":"其元素战技低温烹饪"},{"from":540.88,"to":541.87,"content":"反其道而行"},{"from":541.87,"to":543.33,"content":"限制美拉德反应"},{"from":543.33,"to":545.23,"content":"以保持食材本有的鲜味"},{"from":545.23,"to":549.47,"content":"这呼应的就是现代高端餐饮的新趋势了"},{"from":549.87,"to":552.29,"content":"艾可菲被称为统御味蕾的暴君"},{"from":552.29,"to":555.48,"content":"这对应的是其历史原型的厨皇称号"},{"from":555.48,"to":556.6,"content":"1913年"},{"from":556.6,"to":558.82,"content":"德皇威廉二世称赞埃科菲"},{"from":558.82,"to":560.3,"content":"我是德国的皇帝"},{"from":560.3,"to":562.01,"content":"而你是厨师的皇帝"},{"from":562.01,"to":564.17,"content":"由此厨房之名遍传天下"},{"from":564.17,"to":568.22,"content":"至今埃科菲厨皇会仍是世界上最大的厨师协会"},{"from":568.22,"to":569.2,"content":"而另一个组织"},{"from":572.68,"to":573.7,"content":"1919年"},{"from":573.7,"to":576.74,"content":"埃科菲被授予法国荣誉军团骑士称号"},{"from":576.74,"to":577.94,"content":"1928年"},{"from":577.94,"to":579.61,"content":"他又升为军官勋位"},{"from":579.61,"to":582.73,"content":"游戏中水神清风艾可菲为甜点大笑"},{"from":582.73,"to":584.56,"content":"这在原则上也是对等的"},{"from":584.56,"to":585.82,"content":"回到艾可菲身上"},{"from":585.82,"to":587.24,"content":"虽然我已经说了那么多"},{"from":587.24,"to":588.66,"content":"他和真实历史的对应"},{"from":588.66,"to":590.34,"content":"但还远远不止于此"},{"from":590.34,"to":592.22,"content":"原神无愧是荣耿之王"},{"from":592.22,"to":593.66,"content":"在他的人物剧情中"},{"from":593.66,"to":594.92,"content":"德波大饭店的故事"},{"from":594.92,"to":597.96,"content":"顺道Q了一下莫扎特与萨列里的恩怨情仇"},{"from":597.96,"to":599.26,"content":"有up主解析过了"},{"from":599.26,"to":600.96,"content":"我就不再赘述"},{"from":600.96,"to":602.12,"content":"艾克菲的设计"},{"from":602.12,"to":606.519,"content":"还参考了高版铜奶替切奈里绘等二次元角色"},{"from":606.519,"to":609.479,"content":"甚至PV还用了撒盐哥等各种网络梗"},{"from":609.479,"to":610.75,"content":"我也不一一拆解了"},{"from":610.75,"to":613.37,"content":"只能说原神编剧实在是用脸狂魔"},{"from":613.37,"to":614.79,"content":"我一个小小的up主"},{"from":614.79,"to":617.03,"content":"哪里干得过人家一整个团队呢"},{"from":617.03,"to":620.53,"content":"倒是德波大饭店的文化背景似乎还没有人提及"},{"from":620.53,"to":622.21,"content":"这里可以再衍生一下"},{"from":622.21,"to":626.13,"content":"德波这个名字来自于法国左翼思想家居一德波"},{"from":626.13,"to":628.13,"content":"而饭店的老板瓦纳格姆"},{"from":628.13,"to":631.95,"content":"则来自于另一位左翼思想家鲁尔瓦纳格姆"},{"from":631.95,"to":634.03,"content":"这两人是1960年代"},{"from":634.03,"to":636.27,"content":"情境主义国际组织的代表人物"},{"from":636.27,"to":639.35,"content":"着力于批判资本主义消费文化和拜物教"},{"from":639.35,"to":640.44,"content":"对人的异化"},{"from":640.44,"to":640.92,"content":"主张"},{"from":640.92,"to":643.42,"content":"用日常生活的瞬间创造艺术性"},{"from":643.42,"to":644.5,"content":"对抗性的体验"},{"from":644.5,"to":646.65,"content":"打破资本逻辑的惯性思维"},{"from":646.65,"to":648.74,"content":"采用异鬼的叙事策略"},{"from":648.74,"to":650.52,"content":"挪用资产阶级文化符号"},{"from":650.52,"to":652.02,"content":"并赋予其革命含义"},{"from":652.02,"to":653.74,"content":"如篡改广告文案"},{"from":653.74,"to":655.4,"content":"拼贴电影画面等"},{"from":655.4,"to":657.34,"content":"已形成反主流的叙事"},{"from":657.34,"to":658.52,"content":"某种意义上"},{"from":658.52,"to":659.86,"content":"原神的创作手法"},{"from":659.86,"to":661.8,"content":"尤其是对蒙德和枫丹的表现"},{"from":661.8,"to":663.12,"content":"就是一种异鬼"},{"from":663.12,"to":666.18,"content":"即借用西方符号来表达颠覆性的叙事"},{"from":666.18,"to":667.84,"content":"如去宗教化的德国"},{"from":667.84,"to":669.12,"content":"不信上帝的法国"},{"from":669.12,"to":670.66,"content":"没有昂撒的世界"},{"from":670.66,"to":673.36,"content":"具体请看我的原神政治学系列"},{"from":673.36,"to":674.92,"content":"而艾可菲的剧情"},{"from":674.92,"to":677.46,"content":"故事虽然大量借用了艾克菲的梗"},{"from":677.46,"to":679.68,"content":"却也未尝不是一种异鬼"},{"from":679.68,"to":683.42,"content":"表面上他对西方厨黄的人生进行了改编重组"},{"from":683.42,"to":686.819,"content":"但实际上讲的是一个很中国价值观的故事"},{"from":686.819,"to":688.739,"content":"西方文化崇拜天才"},{"from":688.739,"to":691.039,"content":"但艾可菲故事的核心告诉我们"},{"from":691.039,"to":692.539,"content":"没有什么天生奇才"},{"from":692.539,"to":694.49,"content":"只有天道酬勤而已"},{"from":694.49,"to":697.69,"content":"反派莫妮卡自认为找到了雷姆利亚的宝藏"},{"from":697.69,"to":699.57,"content":"其实是原始的药渣"},{"from":699.57,"to":701.77,"content":"被他毁掉的才是真正的文化"},{"from":701.77,"to":705.03,"content":"这讽刺的正是西方人自诩为罗马的精神后裔"},{"from":705.03,"to":706.77,"content":"继承到的却是其糟粕"},{"from":708.75,"to":711.83,"content":"而把高大上的西餐之神埃科菲娘画"},{"from":711.83,"to":714.41,"content":"配上经典路易14白丝高跟"},{"from":714.41,"to":717.73,"content":"这一设定本身就是一种细腻和趣味"},{"from":717.73,"to":719.13,"content":"让我们关掉滤镜"},{"from":719.13,"to":719.99,"content":"看西方"},{"from":719.99,"to":722.07,"content":"我想德波大饭店的设定"},{"from":722.07,"to":724.79,"content":"也是原神给我们留下的一扇窄门"},{"from":724.79,"to":726.39,"content":"只不过路是小的"},{"from":726.39,"to":727.77,"content":"找到的人也很少"},{"from":727.77,"to":728.87,"content":"只有有心的人"},{"from":728.87,"to":732.24,"content":"才可以从中窥见创作者最深藏的隐喻"},{"from":732.24,"to":734.94,"content":"最后非常感谢大家能把视频看到这里"},{"from":734.94,"to":738.08,"content":"也非常非常感谢今天的金主爸爸萌芽家"},{"from":738.08,"to":738.92,"content":"他们很主动"},{"from":738.92,"to":740.04,"content":"很贴心的跟我说"},{"from":740.04,"to":740.64,"content":"王老师"},{"from":740.64,"to":742.86,"content":"我们就把广告直接放片尾吧"},{"from":742.86,"to":745.9,"content":"放在中间可能会影响到大家观看的体验"},{"from":745.9,"to":747.46,"content":"这话说的我都泪目了"},{"from":747.46,"to":749.56,"content":"跟我之前接触的甲方可不一样"},{"from":749.56,"to":751.6,"content":"大家都知道放中间流量高"},{"from":751.6,"to":753.97,"content":"而他们主动放结尾真的很少见"},{"from":753.97,"to":755.85,"content":"所以希望大家能给我点时间"},{"from":755.85,"to":757.27,"content":"好好介绍他们的产品"},{"from":757.27,"to":759.14,"content":"顺便支持一下我的完播率"},{"from":759.14,"to":762.34,"content":"另外呢萌牙家布阵做广告非常良心时代"},{"from":762.34,"to":763.86,"content":"他们的产品也是非常不错"},{"from":763.86,"to":765.66,"content":"像他们家入门款的电动牙刷"},{"from":765.66,"to":766.9,"content":"特价才139"},{"from":766.9,"to":769.26,"content":"139他们也会保证大家用两年以上"},{"from":769.26,"to":770.06,"content":"两年内坏了"},{"from":770.06,"to":771.14,"content":"直接免费换新"},{"from":771.14,"to":773.66,"content":"两年以后坏了还可以半价以旧换新"},{"from":773.66,"to":775.3,"content":"这跟终身质保几乎没差"},{"from":775.3,"to":776.58,"content":"真的是非常靠谱"},{"from":776.58,"to":777.28,"content":"非常良心"},{"from":777.28,"to":778.52,"content":"当时我也很好奇"},{"from":778.52,"to":781.22,"content":"139的电动牙刷为什么质保能做这么好"},{"from":781.22,"to":782.3,"content":"萌牙小哥跟我说"},{"from":782.3,"to":784.54,"content":"他们家不管是100还是300多的"},{"from":784.54,"to":785.9,"content":"任何价位的电动牙刷"},{"from":785.9,"to":788.54,"content":"在出厂之前都必须经过38道品控"},{"from":788.54,"to":790.98,"content":"一向不合格是绝对不允许出厂的"},{"from":790.98,"to":792.24,"content":"所以这么好的品控"},{"from":792.24,"to":793.18,"content":"他们才敢承诺"},{"from":793.18,"to":793.98,"content":"两年内坏了"},{"from":793.98,"to":795.38,"content":"大家可以免费换新"},{"from":795.38,"to":798.36,"content":"另外可能也有朋友担心电动牙刷这么便宜"},{"from":798.36,"to":799.32,"content":"能刷干净吗"},{"from":799.32,"to":800.42,"content":"这完全可以放心"},{"from":800.42,"to":801.26,"content":"他们家说了"},{"from":801.26,"to":802.48,"content":"买回去31天内"},{"from":802.48,"to":803.64,"content":"要是感觉刷不干净"},{"from":803.64,"to":804.44,"content":"刷了没效果"},{"from":804.44,"to":806.16,"content":"包退保证退随便推"},{"from":806.16,"to":807.84,"content":"当然大家最关心的问题是什么"},{"from":807.84,"to":809.7,"content":"这电动牙刷再好再便宜"},{"from":809.7,"to":810.76,"content":"真的有必要用吗"},{"from":810.76,"to":812.54,"content":"刷个牙要整这么多花活吗"},{"from":812.54,"to":814.42,"content":"说实话我以前也是这么想的"},{"from":814.42,"to":816.82,"content":"但是我看了专业的权威的牙医"},{"from":816.82,"to":818.22,"content":"读的教科书上面说了"},{"from":818.22,"to":819.48,"content":"电动牙刷优于手动"},{"from":819.48,"to":822.08,"content":"还有另外一本也是教科书上面更是明确说"},{"from":822.08,"to":823.56,"content":"电动牙刷具有明确优势"},{"from":823.56,"to":824.3,"content":"你们想一想"},{"from":824.3,"to":826.36,"content":"如果这个电动牙刷没效果没用"},{"from":826.36,"to":827.54,"content":"教科书会推荐吗"},{"from":827.54,"to":829.38,"content":"如果手动牙刷真能刷干净"},{"from":829.38,"to":831.1,"content":"为什么很多人还长蛀牙"},{"from":831.1,"to":832.9,"content":"像我之前在德国牙坏了"},{"from":832.9,"to":835.22,"content":"还要等三个月才能等到牙医有空"},{"from":835.22,"to":836.54,"content":"真的非常非常麻烦"},{"from":836.54,"to":837.96,"content":"如果你们长过蛀牙"},{"from":837.96,"to":840.04,"content":"或者是花钱去牙科看过牙"},{"from":840.04,"to":842.04,"content":"就买一支电动牙刷好好刷"},{"from":842.04,"to":844.38,"content":"特别是把大牙窝沟上下刷干净"},{"from":844.38,"to":846.94,"content":"这样既可以让保护牙齿不长蛀牙"},{"from":846.94,"to":848.9,"content":"也不用花几百几千去看牙"},{"from":848.9,"to":849.66,"content":"款式的话"},{"from":849.66,"to":850.7,"content":"大家想入个门的"},{"from":850.7,"to":853.44,"content":"那就选他家的特价139的星光2.0"},{"from":853.44,"to":854.82,"content":"如果想要颜值更高"},{"from":854.82,"to":855.74,"content":"续航更久的"},{"from":855.74,"to":858.46,"content":"可以选他们家经典款星耀特价239"},{"from":858.46,"to":859.12,"content":"充一次电"},{"from":859.12,"to":860.38,"content":"可以用240天"},{"from":860.38,"to":861.46,"content":"这个续航真的很牛"},{"from":861.46,"to":862.48,"content":"但是我有一说一"},{"from":862.48,"to":864.56,"content":"无论是139的还是200多的"},{"from":864.56,"to":866.36,"content":"从清洁效果来讲是差不多的"},{"from":866.36,"to":868.56,"content":"所以大家完全可以根据自己的需求来选择"},{"from":868.56,"to":870.72,"content":"买之前呢别忘了去评论区领券"},{"from":870.72,"to":871.5,"content":"保证最低价"},{"from":871.5,"to":873.32,"content":"买贵了可随时退差价"}],"chapters":[{"from":0,"to":212,"content":"矮子的逆袭"},{"from":212,"to":453,"content":"黑暗的降临"},{"from":453,"to":874,"content":"再度的辉煌"}],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:03:29.808Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"available","chaptersFetchedAt":"2026-10-04T23:03:24.508Z"}}
