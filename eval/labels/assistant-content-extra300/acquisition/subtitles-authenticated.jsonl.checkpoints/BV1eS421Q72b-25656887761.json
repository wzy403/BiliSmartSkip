{"schemaVersion":1,"bvid":"BV1eS421Q72b","cid":25656887761,"subtitles":[{"from":0.12,"to":3,"content":"来咱们鉴定一下网络热门军事谣言啊"},{"from":3,"to":4.08,"content":"这个很重要"},{"from":4.08,"to":6.1,"content":"咱们今天这期回归科普了"},{"from":6.1,"to":7.22,"content":"咱们主打辟谣"},{"from":7.22,"to":8.34,"content":"因为前几期视频"},{"from":8.34,"to":11.21,"content":"我在网上搜索相关我国防弹衣的时候"},{"from":11.21,"to":13.25,"content":"发现了大量的谣言"},{"from":13.25,"to":14.97,"content":"被各大媒体传送"},{"from":14.97,"to":17.86,"content":"甚至到现在还有人以这个为核心"},{"from":17.86,"to":19.92,"content":"甚至坚信不疑的认为他是对的"},{"from":19.92,"to":21.94,"content":"而这样的大量的垃圾消息"},{"from":21.94,"to":24.48,"content":"隐蔽了真正的错误和其优秀的地方"},{"from":24.48,"to":25.36,"content":"咱们一个个来看"},{"from":25.36,"to":26.88,"content":"首先咱们先来看一个短视频"},{"from":26.88,"to":28.2,"content":"做开胃"},{"from":36.62,"to":40.23,"content":"抖音他就好像那个草丛里的盖伦"},{"from":40.23,"to":40.91,"content":"一上来给我干"},{"from":40.91,"to":41.41,"content":"沉默了"},{"from":41.41,"to":43.69,"content":"就唯一能说出来的就三个字"},{"from":43.69,"to":44.51,"content":"转人工"},{"from":44.51,"to":45.15,"content":"不哥们"},{"from":45.15,"to":46.35,"content":"你咋你乐高啊"},{"from":46.35,"to":47.46,"content":"你手腕不会动吗"},{"from":47.46,"to":49.58,"content":"他评论区也是一堆逆天的啊"},{"from":49.58,"to":52.14,"content":"还有自称当了好几年这个老兵不会玩的"},{"from":52.14,"to":53.58,"content":"有时候九五质量不好的"},{"from":53.58,"to":55.7,"content":"什么黑弹簧和黑炮克主打一个一眼盯"},{"from":55.7,"to":56.48,"content":"真纯纯"},{"from":56.48,"to":57.16,"content":"没摸过枪"},{"from":57.16,"to":59.56,"content":"我就很好奇那些信誓旦旦说九五不行的"},{"from":59.56,"to":60.52,"content":"他们有几个当过兵的"},{"from":60.52,"to":62.1,"content":"有几个真的摸过枪"},{"from":62.1,"to":63.28,"content":"我就不多说"},{"from":63.28,"to":64.54,"content":"都不要说主要用九五的"},{"from":64.54,"to":65.74,"content":"我们吧就说国外吧"},{"from":65.74,"to":68.6,"content":"国外给我们提供了就已经有很多的解决方案"},{"from":68.6,"to":69.08,"content":"都有很多"},{"from":69.08,"to":70.36,"content":"还卡手腕来"},{"from":70.36,"to":71.2,"content":"我告诉你怎么解决"},{"from":71.2,"to":72.32,"content":"有像这样的"},{"from":72.32,"to":73.54,"content":"还有像这样的"},{"from":73.54,"to":74.72,"content":"还有这样的啊"},{"from":74.72,"to":76.04,"content":"然后你就跟一个乐高小人似的"},{"from":76.04,"to":77.14,"content":"连拿起枪都不会哦"},{"from":77.14,"to":77.86,"content":"也不能这么说"},{"from":77.86,"to":79.26,"content":"毕竟乐高小人也能拿枪"},{"from":79.26,"to":81.34,"content":"那么请问你是做了个手腕结束手术吗"},{"from":81.34,"to":83.08,"content":"啊也别说什么对手腕不好"},{"from":83.08,"to":84.88,"content":"视频里那哥俩都他妈快切屏了"},{"from":84.88,"to":86.64,"content":"你也没见到他说什么对手腕不好"},{"from":86.64,"to":87.92,"content":"到中国人这这这么矫情"},{"from":87.92,"to":88.76,"content":"而且再说了"},{"from":88.76,"to":89.4,"content":"你切角的时候"},{"from":89.4,"to":90.36,"content":"你甚至可以抵墙上"},{"from":90.36,"to":91.32,"content":"这个都是可行的"},{"from":91.32,"to":93.88,"content":"要我说这种事就还是吃饱了导致的"},{"from":93.88,"to":95.42,"content":"这关键还有人信这个玩意"},{"from":95.42,"to":97.1,"content":"评价为枪是没摸过的"},{"from":97.1,"to":98.06,"content":"牛逼是要吹的"},{"from":98.06,"to":98.9,"content":"缺点是无知的"},{"from":98.9,"to":99.94,"content":"黑九五是必然的"},{"from":99.94,"to":100.54,"content":"你要这么说"},{"from":100.54,"to":101.1,"content":"有啥缺点"},{"from":101.1,"to":102.62,"content":"还不如来一个啊趴下"},{"from":102.62,"to":103.78,"content":"因为30发弹匣不好"},{"from":103.78,"to":104.46,"content":"射击还行"},{"from":104.46,"to":106.14,"content":"那那我这个确实还能理解"},{"from":106.14,"to":108.46,"content":"但是你可能不知道957十九二十发弹匣的"},{"from":108.46,"to":109.56,"content":"只不过很少很少"},{"from":109.56,"to":111.06,"content":"而这一上来一个抛壳窗"},{"from":111.06,"to":112.6,"content":"属于是军盲第一定律啊"},{"from":112.6,"to":114.7,"content":"正因为抛壳窗和他上厕所人把握不住"},{"from":114.7,"to":115.8,"content":"哎呀我不好评价"},{"from":115.8,"to":118.48,"content":"只能说这个玩意对枪械但凡有点了解的人"},{"from":118.48,"to":120.19,"content":"就一言丁真好吧好"},{"from":120.19,"to":122.32,"content":"那么咱们接着看下一个谣言"},{"from":122.56,"to":125.52,"content":"我在网上查了好几篇资料"},{"from":125.52,"to":127.08,"content":"那是越查越邪乎"},{"from":127.08,"to":129.68,"content":"我就感觉我的防弹衣和这些营销号的防弹衣"},{"from":129.68,"to":131.92,"content":"和这个自媒体的防弹衣就不一样"},{"from":131.92,"to":132.48,"content":"在他们眼里"},{"from":132.48,"to":134.48,"content":"这防弹衣他是个克苏鲁"},{"from":134.48,"to":135.52,"content":"就他们没回应"},{"from":135.52,"to":137.2,"content":"整在我这三四篇报道"},{"from":137.2,"to":138.32,"content":"咱们一起来统一讲讲"},{"from":138.32,"to":139.76,"content":"我这精选了三四篇报道啊"},{"from":139.76,"to":142.12,"content":"也算是现在网上一查就能查到的几篇报道"},{"from":142.12,"to":143.12,"content":"首先不管怎么样"},{"from":143.12,"to":146.14,"content":"开篇先说我国国产防弹衣多么牛逼"},{"from":146.14,"to":147.64,"content":"然后介绍质优价廉"},{"from":147.64,"to":148.6,"content":"唉这是必然的"},{"from":148.6,"to":149.76,"content":"然后不是中东"},{"from":149.76,"to":150.48,"content":"就是非洲"},{"from":150.48,"to":152.36,"content":"有一哥们儿依靠这玩意儿捡了一条命"},{"from":152.36,"to":153.22,"content":"或者维和部队"},{"from":153.22,"to":153.54,"content":"唉"},{"from":153.54,"to":155.7,"content":"然后就处于一个我不理解的心态下"},{"from":155.7,"to":158.42,"content":"在一个防弹装备下就会说出一些什么啊"},{"from":158.42,"to":160.37,"content":"防刺防砍防铁棍"},{"from":160.37,"to":162.41,"content":"不是你说这个防铁棍"},{"from":162.41,"to":165.07,"content":"这个铁棍是指什么钨钢穿甲弹吗"},{"from":165.07,"to":166.33,"content":"就我不是很能理解"},{"from":166.33,"to":169.73,"content":"因为他们到目前为止也没说过是哪个部位"},{"from":169.73,"to":171.65,"content":"因为我之前是做过测试的"},{"from":171.65,"to":173.13,"content":"凯夫拉这个材质可以防弹"},{"from":173.13,"to":174.07,"content":"但是它不防刺啊"},{"from":174.07,"to":174.85,"content":"弓箭一发"},{"from":174.85,"to":176.3,"content":"凯夫拉当场就躺下睡觉了"},{"from":176.3,"to":177.78,"content":"因为凯夫拉是纤维耶"},{"from":177.78,"to":178.38,"content":"你们知道吗"},{"from":178.38,"to":180.58,"content":"通过包裹弹头让它停下来"},{"from":180.58,"to":182.7,"content":"而弓箭有很多是开刃的"},{"from":182.7,"to":184.25,"content":"凯夫拉就好像一块布"},{"from":184.25,"to":185.45,"content":"你用石头扔过去"},{"from":185.45,"to":186.45,"content":"一般是能包住的"},{"from":186.45,"to":188.37,"content":"但是你要扔一把飞刀过去"},{"from":188.37,"to":190.25,"content":"那么这块布大概率你就不用回收了"},{"from":190.25,"to":192.18,"content":"当然这里不是说防弹衣防不了刺"},{"from":192.18,"to":193.1,"content":"大多数情况下"},{"from":193.1,"to":195.54,"content":"防弹衣是可以抵挡一般的刀劈斧砍的"},{"from":195.54,"to":196.94,"content":"倒不说它的强度有多高"},{"from":196.94,"to":198.24,"content":"单纯只是因为比较厚"},{"from":198.24,"to":199.3,"content":"非常厚啊"},{"from":199.3,"to":202.32,"content":"合格的这个防弹凯夫拉一般两到3cm啊"},{"from":202.32,"to":203,"content":"强度还高"},{"from":203,"to":204.24,"content":"能物理意义上的拦住他"},{"from":204.24,"to":205.64,"content":"但是面对开刃的装备"},{"from":205.64,"to":206.7,"content":"我个人建议你不要去赌"},{"from":206.7,"to":208.3,"content":"所以你说这玩意能防刀劈斧砍"},{"from":208.3,"to":209.48,"content":"其实某种意义上也对"},{"from":209.48,"to":211.38,"content":"但这个玩意你就是这玩意"},{"from":211.38,"to":212.98,"content":"它理论上它是不能防刺的"},{"from":212.98,"to":215.02,"content":"所以说这个事真有点误人子弟感"},{"from":215.02,"to":216.02,"content":"而且很有可能要命"},{"from":216.02,"to":216.66,"content":"你们知道吧"},{"from":216.66,"to":218.66,"content":"当然你说他有没有可以防刺的呢"},{"from":218.66,"to":219.26,"content":"其实是有"},{"from":219.26,"to":221.4,"content":"但那就是在里面加入金属那个层"},{"from":221.4,"to":224.04,"content":"或者是直接加入金属片那种也是可行的"},{"from":224.04,"to":225.6,"content":"然后下面这个就让我很迷惑了"},{"from":225.6,"to":228.11,"content":"他说严最严密的护具"},{"from":228.11,"to":230.43,"content":"然后配了个美军的LOTV啊"},{"from":230.43,"to":231.25,"content":"这就不说了"},{"from":231.25,"to":234.03,"content":"关键零六只能算是一个很正常"},{"from":234.03,"to":236.07,"content":"很普通的重型防弹衣啊"},{"from":236.07,"to":238.86,"content":"啊现代那些怪物都是护腋下"},{"from":238.86,"to":239.58,"content":"护腰腹"},{"from":239.58,"to":241.64,"content":"护大小腿上都取得了很高的评价"},{"from":244.32,"to":246.4,"content":"我就很不理解他到底哪里是第一名"},{"from":246.4,"to":250.03,"content":"然后最不利的就是这这一句就防弹等级六"},{"from":250.03,"to":252.61,"content":"就我看你像个六"},{"from":252.61,"to":254.43,"content":"然后关键这还不止一个人"},{"from":254.43,"to":256.89,"content":"是几乎所有人都在说房子等级六"},{"from":256.89,"to":257.839,"content":"我就不太好评"},{"from":257.839,"to":258.319,"content":"请假了"},{"from":258.319,"to":260.199,"content":"真的一般来讲我们说防弹衣"},{"from":260.199,"to":260.759,"content":"防弹等级"},{"from":260.759,"to":262.039,"content":"那都是优先说凯夫拉"},{"from":262.039,"to":263.799,"content":"而凯夫拉只有2~3级"},{"from":263.799,"to":264.799,"content":"一般没有四级的"},{