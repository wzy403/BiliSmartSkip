{"schemaVersion":1,"bvid":"BV1cs596oESZ","cid":38327222806,"subtitles":[{"from":0.04,"to":1.5,"content":"1873年9月"},{"from":1.5,"to":5.08,"content":"美国最大的银行家之一杰伊库克因债券到期"},{"from":5.08,"to":5.82,"content":"无法兑付"},{"from":5.82,"to":6.98,"content":"因而宣告破产"},{"from":6.98,"to":8.52,"content":"消息传到纽交所"},{"from":8.52,"to":10.26,"content":"随即引发美股暴跌"},{"from":10.26,"to":12.12,"content":"又因彼时英国的各大银行"},{"from":12.12,"to":15.24,"content":"都对美国的铁路工业有着巨额的投资"},{"from":15.24,"to":16.84,"content":"因此这场金融大火"},{"from":16.84,"to":20.09,"content":"很快的便蔓延到了万里之外的英国本土"},{"from":20.09,"to":21.49,"content":"前期占尽先机"},{"from":21.49,"to":25.13,"content":"几近辉煌顶点的维多利亚时代就此击毙爆发"},{"from":25.13,"to":26.69,"content":"进入了绵延22年"},{"from":26.69,"to":29.18,"content":"264个月的长萧条时期"},{"from":29.18,"to":31.24,"content":"不过不同于20世纪30年代"},{"from":31.24,"to":33.36,"content":"那场著名的全球经济大崩溃"},{"from":33.36,"to":35.02,"content":"英国长萧条的表征"},{"from":35.02,"to":38.04,"content":"则更多地体现为农产品价格的暴跌"},{"from":38.04,"to":41.48,"content":"这一现象固然导致了英国农业霸权的彻底终结"},{"from":43.94,"to":46.42,"content":"但在国内经济一路走低的大背景下"},{"from":46.42,"to":49.6,"content":"得益于冷藏运输和食品工业的迅猛发展"},{"from":49.6,"to":52.66,"content":"以及源源不断由新大陆运来的廉价谷物"},{"from":52.66,"to":56.16,"content":"英国及英国人的餐桌居然在持续的低迷中"},{"from":56.16,"to":57.64,"content":"迎来了一波虽然乏味"},{"from":57.64,"to":60.53,"content":"廉价却又充沛丰足的非常时期"},{"from":60.53,"to":61.29,"content":"在此期间"},{"from":61.29,"to":64.39,"content":"英国人几乎完全放弃了自给自足的农业幻想"},{"from":64.39,"to":66.21,"content":"转而开始倾力拥抱全球"},{"from":66.21,"to":68.06,"content":"食品工业化带来的种种红利"},{"from":68.06,"to":69.62,"content":"于是各种更白的面包"},{"from":69.62,"to":70.82,"content":"更廉价的蛋白质"},{"from":70.82,"to":73.22,"content":"更甜的下午茶开始相互组合"},{"from":73.22,"to":74.72,"content":"进而无孔不入的渗透"},{"from":74.72,"to":77.26,"content":"从而改变了英国人原有的餐桌风向"},{"from":77.26,"to":81.1,"content":"并最终初步形成了如今我们所熟识的英式饮食"},{"from":81.1,"to":84.82,"content":"而我们今天要聊的就是关于他们的故事"},{"from":87.54,"to":90.58,"content":"在本国农业几近崩溃的长萧条期间"},{"from":90.58,"to":92.02,"content":"来自美国的小麦"},{"from":92.02,"to":95.04,"content":"绝对是英国人碗中最重要的一块压舱石"},{"from":95.04,"to":95.68,"content":"讽刺的是"},{"from":95.68,"to":96.84,"content":"在长萧条以前"},{"from":96.84,"to":100.38,"content":"洁白细腻的小麦粉通常还是中产阶级的象征"},{"from":100.38,"to":103.52,"content":"而英国平民更多食用的还是含有麸皮"},{"from":103.52,"to":105.88,"content":"质地粗糙的黑面包或杂粮饼"},{"from":105.88,"to":107.68,"content":"但随着1870年代"},{"from":107.68,"to":110.1,"content":"美国中西部铁路网络的全面竣工"},{"from":110.1,"to":113.04,"content":"以及频繁往来于大西洋上的蒸汽货船"},{"from":113.04,"to":116.28,"content":"使得进口小麦的价格只有本土价格的一半"},{"from":116.28,"to":117.18,"content":"甚至更低"},{"from":117.18,"to":119.54,"content":"于是在英国产业工人的餐桌上"},{"from":119.54,"to":122.2,"content":"白面包就此摆脱了原有的阶级属性"},{"from":122.2,"to":124.8,"content":"转而成了这个国家的基本生存保障"},{"from":124.8,"to":125.96,"content":"这种变化可以说"},{"from":125.96,"to":128.539,"content":"极大缓和了长萧条带来的社会矛盾"},{"from":128.539,"to":131.399,"content":"让英国在企业利润大大缩减的情况下"},{"from":131.399,"to":134.5,"content":"工人的购买力反而获得了一定程度的提升"},{"from":134.5,"to":135.46,"content":"历史学家口中"},{"from":135.46,"to":136.58,"content":"所谓农民的毒药"},{"from":136.58,"to":139.14,"content":"工人的盛宴就是对他最好的形容"},{"from":139.14,"to":140.94,"content":"而随着恩格尔系数的下降"},{"from":140.94,"to":143.06,"content":"无形的大手也跟着持续发力"},{"from":143.06,"to":146.04,"content":"由于家庭中原本用于购买主食的支出"},{"from":146.04,"to":147.5,"content":"被极大的节省了下来"},{"from":147.5,"to":148.96,"content":"于是英国老百姓的钱"},{"from":148.96,"to":151.77,"content":"反而更多的开始流向了副食领域"},{"from":151.77,"to":153.07,"content":"比如廉价的食堂"},{"from":153.07,"to":155.07,"content":"开始带动了果酱业的繁荣"},{"from":155.07,"to":156.77,"content":"充满科技的人造黄油"},{"from":156.77,"to":159.11,"content":"开始与白面包组成固定的搭档"},{"from":159.11,"to":162.52,"content":"不过最突出的改变还是由进口小麦而起"},{"from":162.52,"to":165.44,"content":"由于它们都是些干燥易储存的半工业品"},{"from":165.44,"to":168.02,"content":"所以为了更从容省便地吃下它们"},{"from":168.02,"to":171.86,"content":"一大批将面粉与油脂汤汁混合的浓郁系食品"},{"from":171.86,"to":173.2,"content":"随开始在英国喂"},{"from":173.2,"to":173.6,"content":"然"},{"from":173.6,"to":175.1,"content":"这其中的种子选手"},{"from":175.1,"to":177.18,"content":"包括未来的英式代表菜之一"},{"from":177.18,"to":180.12,"content":"自18世纪中叶就被英国人一路改进"},{"from":180.12,"to":182.86,"content":"将廉价的猪牛羊的腰子包进酥皮"},{"from":182.86,"to":185.6,"content":"再在炉灶上慢蒸而成的腰子派"},{"from":185.6,"to":187.36,"content":"因德产业之变孤独"},{"from":187.36,"to":190.84,"content":"在兰开夏奥海姆等羊毛纺织重镇异常流行的"},{"from":190.84,"to":191.76,"content":"将羊肉馅儿"},{"from":191.76,"to":193.02,"content":"洋葱包进面皮"},{"from":193.02,"to":195.42,"content":"在上笼蒸熟的蓝开下肉布丁"},{"from":195.42,"to":198.78,"content":"由于这东西在蒸制时大都需要用布包裹"},{"from":198.78,"to":200.32,"content":"因此人还有一个别号"},{"from":200.32,"to":201.68,"content":"即破布布丁"},{"from":201.68,"to":204,"content":"此二者对于当时的英国工人来说"},{"from":204,"to":205.36,"content":"都属于外表朴素"},{"from":205.36,"to":206.04,"content":"价格便宜"},{"from":206.04,"to":206.84,"content":"还能保温"},{"from":206.84,"to":208.28,"content":"同时又顶饱扛饿"},{"from":208.28,"to":209.04,"content":"油脂丰足"},{"from":209.04,"to":210.69,"content":"味道浓郁的绝佳午餐"},{"from":210.69,"to":211.71,"content":"而除此之外"},{"from":211.71,"to":212.77,"content":"在伦敦地区"},{"from":212.77,"to":215.27,"content":"当时的工人阶级常吃的午餐组合"},{"from":215.27,"to":218.28,"content":"还有所谓的萨维洛伊香肠配肉汁面包"},{"from":218.28,"to":220.9,"content":"萨贝洛伊香肠是一种以猪肉为主料"},{"from":220.9,"to":221.88,"content":"另加面包屑"},{"from":221.88,"to":222.62,"content":"土豆淀粉"},{"from":222.62,"to":223.92,"content":"猪油和各种香料"},{"from":223.92,"to":227.4,"content":"它最大的特点是外表呈现出的夸张红色"},{"from":227.4,"to":230.86,"content":"老伦敦的吃法一般是先用水将香肠煮熟"},{"from":230.86,"to":232.3,"content":"然后夹在面包里"},{"from":232.3,"to":233.98,"content":"另配一些豌豆泥和肉汁"},{"from":233.98,"to":235.84,"content":"最后淋上一大坨芥末酱"},{"from":235.84,"to":237.5,"content":"总之在长萧条时期"},{"from":237.5,"to":239.88,"content":"在一传传美国小麦的助推之下"},{"from":239.88,"to":241.82,"content":"英国百姓原来常吃的燕麦"},{"from":241.82,"to":242.26,"content":"黑麦"},{"from":242.26,"to":244.56,"content":"大麦等主食均已日渐式微"},{"from":244.56,"to":247.54,"content":"而方便快捷地将小麦制成的面包打开"},{"from":247.54,"to":249.6,"content":"再向其中添加冷肉奶酪"},{"from":249.6,"to":251.46,"content":"培根果酱的三明治吃法"},{"from":253.8,"to":255.76,"content":"午餐食的一致选择"},{"from":255.76,"to":258.04,"content":"第二中场休息时间到清洁地板时"},{"from":258.04,"to":260.04,"content":"最难处理的不是垃圾本身"},{"from":260.04,"to":260.86,"content":"而是油污"},{"from":260.86,"to":262.54,"content":"顽固污渍和宠物毛发"},{"from":262.54,"to":264.48,"content":"游望这台云朵蒸汽洗地机"},{"from":264.48,"to":266.42,"content":"160度高温蒸汽直喷"},{"from":266.42,"to":268.76,"content":"想把顽固油污重新热熔了一遍"},{"from":268.76,"to":269.9,"content":"比冷水擦高效"},{"from":269.9,"to":271.48,"content":"而且比泡沫更彻底"},{"from":271.48,"to":273.08,"content":"一键开启热水模式"},{"from":273.08,"to":275.36,"content":"连美缝污垢也变得容易清理了"},{"from":275.36,"to":276.98,"content":"2万7000帕飓风吸力"},{"from":276.98,"to":277.84,"content":"边洗边吸"},{"from":277.84,"to":279.98,"content":"也不用担心毛发缠绕的问题"},{"from":279.98,"to":282.52,"content":"9.8cm超薄躺平设计床底"},{"from":282.52,"to":284.8,"content":"沙发底的灰尘猫毛也能一网打尽"},{"from":284.8,"to":286.44,"content":"地刷还支持整机防水"},{"from":286.44,"to":288.94,"content":"脏了直接冲洗高压水枪也不怕"},{"from":288.94,"to":289.88,"content":"拖回基站后"},{"from":289.88,"to":291.34,"content":"AI还会自动清洁"},{"from":291.34,"to":292.82,"content":"甚至顺手打包垃圾"},{"from":292.82,"to":295.42,"content":"双助力悬浮手柄轻轻一推就走"},{"from":295.42,"to":296.58,"content":"跟散步差不多"},{"from":296.58,"to":299.26,"content":"他几乎是把扫地拖地会遇到的麻烦事"},{"from":299.26,"to":300.84,"content":"都提前替你想好了"},{"from":300.84,"to":302.28,"content":"现在入手还有多重福利"},{"from":302.28,"to":305.74,"content":"感兴趣的朋友可以去看看置顶区链接"},{"from":308.44,"to":309.2,"content":"坦白地说"},{"from":309.2,"to":311.02,"content":"在英国人的饮食严格中"},{"from":311.02,"to":313.3,"content":"可能没有任何一种食物的宿命"},{"from":313.3,"to":314.99,"content":"会如土豆这般曲折"},{"from":314.99,"to":318.03,"content":"从16世纪末新大陆引入了奇花异草"},{"from":318.03,"to":320.39,"content":"到后来备受冷落的恶魔之果"},{"from":320.39,"to":322.44,"content":"再到爱尔兰人的救命稻草"},{"from":322.44,"to":324.52,"content":"拿破仑战争时的廉价军粮"},{"from":324.52,"to":326.62,"content":"土豆终于在步入19世纪后"},{"from":326.62,"to":329.14,"content":"基本摆脱了关于他的傲慢与偏见"},{"from":329.14,"to":332.89,"content":"化身成了整个工业社会里不错的引擎燃料"},{"from":332.89,"to":334.47,"content":"而在长萧条到来后"},{"from":334.47,"to":337.67,"content":"土豆更是完成了关于他的最后一次华丽转身"},{"from":337.67,"to":341.68,"content":"一跃成了能令整个英国都人见人爱的餐桌明星"},{"from":341.68,"to":343.22,"content":"这其中的表面原因"},{"from":343.22,"to":347.08,"content":"当然是关于土豆在营养与产量上如何如何充足"},{"from":347.08,"to":348.46,"content":"高效的老生常谈"},{"from":348.46,"to":350.14,"content":"但更深层次的缘故"},{"from":350.14,"to":352.76,"content":"则是因为土豆所具备的种种属性"},{"from":352.76,"to":355.14,"content":"让它在工业快餐化的变革中"},{"from":358.309,"to":361.629,"content":"首先土豆相比面包几乎不需任何设备"},{"from":361.629,"to":363.26,"content":"扔进火堆就能做熟"},{"from":363.26,"to":365.18,"content":"所以在城市的街头巷尾"},{"from":365.18,"to":366.68,"content":"新鲜出炉的烤土豆"},{"from":366.68,"to":369.14,"content":"一直都是最受欢迎的零食小吃"},{"from":369.14,"to":372.24,"content":"并且用这种做法做熟的土豆还能持续发热"},{"from":372.24,"to":373.86,"content":"因此在寒冷的冬日"},{"from":373.86,"to":376.1,"content":"将一枚滚烫的烤土豆揣进怀里"},{"from":376.1,"to":377.14,"content":"一面取暖"},{"from":377.14,"to":377.94,"content":"一面充饥"},{"from":377.94,"to":381.18,"content":"是几乎所有在外劳作的人们约定俗成的"},{"from":381.18,"to":382.19,"content":"生活小窍门"},{"from":382.19,"to":385.69,"content":"同时由于土豆拥有细胞结构相对致密的特性"},{"from":385.69,"to":388.31,"content":"使其在快捷高效的油炸烹饪中"},{"from":388.31,"to":391.06,"content":"不但表面能迅速结成一道美味的酥壳"},{"from":391.06,"to":393.4,"content":"还能将内部的水分牢牢锁住"},{"from":393.4,"to":395.92,"content":"最终形成一种表面焦酥咸脆"},{"from":395.92,"to":398.3,"content":"内里却绵软如泥的美妙反差"},{"from":398.3,"to":400.88,"content":"而能将这种特质发挥到极致的美食"},{"from":400.88,"to":401.66,"content":"毫无疑问"},{"from":401.66,"to":404.23,"content":"当首推大名鼎鼎的炸鱼薯条"},{"from":404.23,"to":407.23,"content":"另外由于土豆的绝大部分营养都来自于"},{"from":407.23,"to":408.75,"content":"吸水性超强的淀粉"},{"from":408.75,"to":411.11,"content":"因此若将几颗土豆煮熟捣碎"},{"from":411.11,"to":413.46,"content":"另加清水牛奶和人造黄油"},{"from":413.46,"to":416.38,"content":"便可直接得到一碗体积超大的土豆泥"},{"from":416.38,"to":418.42,"content":"在那个经济不景气的年月里"},{"from":418.42,"to":421.26,"content":"这种能让食物看起来变多的餐桌魔法"},{"from":421.26,"to":423.7,"content":"几乎是每个家庭主妇的必修课"},{"from":423.7,"to":426.14,"content":"而由土豆泥衍生而来的经典套餐"},{"from":426.14,"to":428.06,"content":"则有风行于伦敦东区"},{"from":428.06,"to":431.68,"content":"当地工人为之世上最好食物的馅儿饼配土豆泥"},{"from":431.68,"to":433.28,"content":"若是手头再宽绰的"},{"from":433.28,"to":434.76,"content":"则还需要再来上一份"},{"from":434.76,"to":437.42,"content":"以能在在肮脏缺氧的泰晤士河中存活了"},{"from":437.42,"to":439.12,"content":"欧洲蛮梨加高汤炖煮"},{"from":439.12,"to":443.01,"content":"并在放凉后凝结成型的鳗鱼冻来与之搭配"},{"from":443.01,"to":444.95,"content":"而到了英格兰的中部地区"},{"from":444.95,"to":446.37,"content":"土豆泥的最好搭档"},{"from":446.37,"to":448.49,"content":"则又成了猪肉工业的副产品"},{"from":448.49,"to":451.44,"content":"各种在流水线上无以为用的生猪下水"},{"from":451.44,"to":452.98,"content":"当地人把它们搅碎后"},{"from":452.98,"to":455.2,"content":"混合香草面包屑制成肉丸"},{"from":455.2,"to":458.95,"content":"并以猪网油包裹后烘烤制成所谓的猪杂肉丸"},{"from":458.95,"to":461.37,"content":"通常是在工厂附近的快餐小馆"},{"from":461.37,"to":463.35,"content":"店主会成批的制作此菜"},{"from":463.35,"to":464.37,"content":"并浇淋肉汁"},{"from":464.37,"to":465.77,"content":"佐以大量土豆泥"},{"from":465.77,"to":467.46,"content":"工人下班后趁热买走"},{"from":467.46,"to":469.06,"content":"当做回家后的正餐"},{"from":469.06,"to":471.46,"content":"并且据传这菜最令人称道的是"},{"from":471.46,"to":473.7,"content":"它拥有一种类似于鸭肉的口感"},{"from":473.7,"to":475.5,"content":"要知道在19世纪的英国"},{"from":475.5,"to":476.56,"content":"生长周期长"},{"from":476.56,"to":477.5,"content":"养殖成本高"},{"from":477.5,"to":480.96,"content":"脂肪含量足的鸭子属于彻头彻尾的高档食材"},{"from":480.96,"to":484.94,"content":"而粗料细做的猪杂肉丸竟能有幸成为它的平替"},{"from":484.94,"to":487.24,"content":"简直就是一道英国版的赛螃蟹"},{"from":487.24,"to":488.74,"content":"最后关于土豆的妙处"},{"from":488.74,"to":489.56,"content":"还有一个"},{"from":489.56,"to":491.8,"content":"那就是这东西特别适合宇宙搭配"},{"from":491.8,"to":492.74,"content":"狠狠熬煮"},{"from":492.74,"to":494.98,"content":"做成种种质地浓稠的炖菜"},{"from":494.98,"to":495.54,"content":"要知道"},{"from":495.54,"to":497.04,"content":"在常萧条时的英国"},{"from":497.04,"to":500.22,"content":"各种罐装肉类和通过冷冻运输而来的牛肉"},{"from":500.22,"to":502.8,"content":"乃是英国人蛋白质来源的主要一环"},{"from":502.8,"to":505.22,"content":"在价格上它们虽然并不昂贵"},{"from":505.22,"to":507.8,"content":"但与鲜肉相比普遍口感欠佳"},{"from":507.8,"to":509.2,"content":"这时能够吸收油脂"},{"from":509.2,"to":510.04,"content":"平衡风味"},{"from":510.04,"to":511.88,"content":"又能勾芡增稠的土豆"},{"from":511.88,"to":514.36,"content":"变成了协同增效的最好伙伴"},{"from":514.36,"to":515.6,"content":"而在长萧条期间"},{"from":515.6,"to":516.44,"content":"照此逻辑"},{"from":516.44,"to":518.18,"content":"从而流行的餐桌佳作"},{"from":518.18,"to":519.54,"content":"首推在风帆时代"},{"from":519.54,"to":523.28,"content":"便已获诸多海员亲口认证的利物浦炖菜"},{"from":523.28,"to":525.88,"content":"作为19世纪全球最大的港口之一"},{"from":525.88,"to":527.34,"content":"利物浦的码头工人"},{"from":527.34,"to":530.3,"content":"显然是最先受到长萧条冲击的一群人"},{"from":530.3,"to":533.5,"content":"而他们的应对之法便是在廉价的冷冻牛肉"},{"from":533.5,"to":536.84,"content":"甚至是骨头中加入大量土豆之后狠狠熬煮"},{"from":536.84,"to":538.46,"content":"只煮得土豆魂飞魄散"},{"from":538.46,"to":539.4,"content":"彻底化开"},{"from":539.4,"to":541.56,"content":"令汤汁变得如浆糊般浓稠"},{"from":541.56,"to":542.77,"content":"便调味出锅"},{"from":542.77,"to":546.15,"content":"再配上几片够味儿的老烟卷心菜和干硬的面包"},{"from":546.15,"to":549.36,"content":"便能令寒酸的餐桌升腾出暖心的味道"},{"from":549.36,"to":550.8,"content":"再有就是蓝开下锅"},{"from":550.8,"to":553.28,"content":"他跟之前提出了蓝开下肉布丁一样"},{"from":553.28,"to":557.08,"content":"都是由当地的核心产业衍生而来的地方性菜肴"},{"from":557.08,"to":559.18,"content":"只不过这次和羊肉搭档的主力"},{"from":559.18,"to":561.34,"content":"换成了切做原片的土豆子"},{"from":561.34,"to":563.72,"content":"英国人将它们像鱼鳞一样叠满餐盘"},{"from":563.72,"to":565.68,"content":"下面则是大块的羊颈肉"},{"from":565.68,"to":566.88,"content":"而在制作期间"},{"from":566.88,"to":570.22,"content":"此菜的最大特点便是不能放在炉火上狠煮"},{"from":570.22,"to":572.36,"content":"而要在烤箱中缓慢地烘烤"},{"from":572.36,"to":574.2,"content":"因为在19世纪末的英国啊"},{"from":574.2,"to":576.32,"content":"这是一道在上班离家前筹备"},{"from":576.32,"to":580.03,"content":"却要在下班归家后方能出锅食用的功夫菜"},{"from":580.03,"to":583.05,"content":"它的兴起和当时所有的饮食流行文化一样"},{"from":583.05,"to":585.17,"content":"都是在同一个萧索背景下"},{"from":585.17,"to":587.52,"content":"人们在全新的工业生活节奏中"},{"from":587.52,"to":590.54,"content":"基于市场供应和自身实力所摸索出的"},{"from":590.54,"to":593.96,"content":"关于如何吃饱吃好的餐桌艺术"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:03:48.637Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:03:46.070Z"}}
