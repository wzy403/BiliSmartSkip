{"schemaVersion":1,"bvid":"BV1iwrkBjE3B","cid":35422930482,"subtitles":[{"from":0,"to":1.66,"content":"在哥谭市的一天晚上"},{"from":1.66,"to":3.26,"content":"巴特一家遭到打劫"},{"from":3.26,"to":5.12,"content":"Hand over your wallet"},{"from":5.12,"to":11.82,"content":"You don't break me all my wife and darmy shut up"},{"from":11.82,"to":13,"content":"父母的惨死"},{"from":13,"to":15.86,"content":"让巴特幼小的心灵种下了复仇的种子"},{"from":15.86,"to":16.64,"content":"从此以后"},{"from":16.64,"to":18.22,"content":"巴特变得嫉恶如仇"},{"from":18.22,"to":19.64,"content":"与邪恶势力势不两立"},{"from":19.64,"to":20.72,"content":"将父母安葬好"},{"from":20.72,"to":23.14,"content":"巴特发誓一定要让凶手给个交代"},{"from":23.14,"to":24.66,"content":"但奈何和自己能力有限"},{"from":24.66,"to":25.86,"content":"不知该从何做起"},{"from":25.86,"to":27.42,"content":"这时老爷子闪亮登场"},{"from":27.42,"to":28.56,"content":"别看他弱不禁风"},{"from":28.56,"to":31.22,"content":"但他年轻时可是名深藏不露的高手"},{"from":31.22,"to":32.38,"content":"为了孙子的复仇"},{"from":32.38,"to":33.98,"content":"老爷子打算倾囊相授"},{"from":33.98,"to":37.2,"content":"虽然训练的过程有点像大家学校里的体操课"},{"from":37.2,"to":38.7,"content":"但经过这段时间的训练"},{"from":38.7,"to":40.74,"content":"巴特不仅学会了如何打击犯罪"},{"from":40.74,"to":42.4,"content":"还练出了一身腱子肉"},{"from":42.4,"to":43.44,"content":"吼吼holy"},{"from":43.44,"to":44,"content":"Hana"},{"from":44,"to":46.2,"content":"这下巴特终于可以当健身教练了"},{"from":46.2,"to":46.84,"content":"当然不是啊"},{"from":46.84,"to":48.12,"content":"正所谓夜黑风高"},{"from":48.12,"to":50.62,"content":"夜打劫爆贪天阿婆的报摊被抢号"},{"from":50.62,"to":51.78,"content":"拼命地呼喊求救"},{"from":51.78,"to":54.34,"content":"呼救声引来了巴特卡"},{"from":54.34,"to":55.16,"content":"Cu"},{"from":55.16,"to":58,"content":"I'm bartman"},{"from":61.42,"to":64.56,"content":"巴特处理完罪犯就将报纸送回了阿普的报摊"},{"from":64.56,"to":65.78,"content":"阿普很感谢巴特"},{"from":65.78,"to":68.84,"content":"为了八毛钱的报纸就将罪犯电得外焦里嫩"},{"from":68.84,"to":71.66,"content":"很快巴特的恶名就传遍了整个歌谭市"},{"from":71.66,"to":73,"content":"再经过电台的报道"},{"from":73,"to":76.36,"content":"将巴特打击犯罪奸除恶的形象进一步强化"},{"from":76.36,"to":79.7,"content":"现在的巴特已经不在乎是不是更在乎像不像"},{"from":79.7,"to":81.06,"content":"只要看起来像坏人"},{"from":81.06,"to":82.62,"content":"那就抓起来一顿痛扁"},{"from":82.62,"to":84.14,"content":"可这段时间的打击犯罪"},{"from":84.14,"to":86.28,"content":"却始终找不到那块小蛇标志"},{"from":86.28,"to":88.6,"content":"也就是杀害巴特父母的人啊"},{"from":88.6,"to":90.44,"content":"No snake tattoo"},{"from":91.08,"to":92.48,"content":"When will i find the man"},{"from":92.48,"to":93.92,"content":"Who murdered my parents"},{"from":93.92,"to":94.6,"content":"When"},{"from":94.6,"to":96.18,"content":"众里寻他千百度"},{"from":96.18,"to":97.86,"content":"那人就在头顶飞艇处"},{"from":97.86,"to":98.98,"content":"飞艇上的蛇哥"},{"from":98.98,"to":102,"content":"十分感谢巴特这段时间为自己清理同行"},{"from":102,"to":103.76,"content":"让蛇哥能偷更多的东西"},{"from":103.76,"to":104.7,"content":"但巴特觉得"},{"from":104.7,"to":105.52,"content":"只要是坏蛋"},{"from":105.52,"to":107.34,"content":"早晚都会被我拿下"},{"from":107.34,"to":109.64,"content":"I'm not a villain on a transfest"},{"from":109.64,"to":110.1,"content":"Tight"},{"from":110.1,"to":111.82,"content":"Explain that to your maker"},{"from":111.82,"to":112.88,"content":"A"},{"from":115,"to":116.04,"content":"I'll take it from here"},{"from":116.04,"to":117.48,"content":"Bart man"},{"from":118.51,"to":121.23,"content":"就在哥谭市举办博物展览会那天"},{"from":121.23,"to":123.16,"content":"博物馆中展览着奇珍异宝"},{"from":123.16,"to":125.56,"content":"当然最珍贵的东西莫过于这些珠宝"},{"from":125.56,"to":127.68,"content":"好在他们已经被警察严密监视"},{"from":127.68,"to":128.62,"content":"可就在这时"},{"from":128.62,"to":130.06,"content":"屋外传来靡靡之音"},{"from":130.06,"to":132.94,"content":"使得屋内的人们情不自禁的跳起舞来"},{"from":132.94,"to":134.36,"content":"原来是蛇哥在捣鬼"},{"from":134.36,"to":135.58,"content":"他让小弟继续吹"},{"from":135.58,"to":139.36,"content":"而自己将在大庭广众之下将这些宝贝收入囊中"},{"from":139.36,"to":141.24,"content":"谁知这时巴特从天而降"},{"from":141.24,"to":142.74,"content":"蛇哥吓得赶紧逃跑"},{"from":142.74,"to":144.66,"content":"但再快也快不过巴特的飞镖"},{"from":144.66,"to":146.04,"content":"小弟的乐器被打掉"},{"from":146.04,"to":147.28,"content":"众人立马清醒过来"},{"from":147.28,"to":148.9,"content":"在警察的层层包围下"},{"from":148.9,"to":150.4,"content":"蛇哥才终于束手就擒"},{"from":150.4,"to":151.84,"content":"巴特摘下蛇哥的头套"},{"from":151.84,"to":152.76,"content":"看到我身后"},{"from":152.76,"to":156.17,"content":"现在终于可以断定他就是杀害巴特父母的凶手"},{"from":156.17,"to":157.81,"content":"You you're the man"},{"from":157.81,"to":159.3,"content":"Who killed my parents"},{"from":159.3,"to":164.22,"content":"哈哈呃呃呜这么有趣的视频"},{"from":164.22,"to":166.18,"content":"当然用我新换的手机看才爽"},{"from":166.18,"to":168.4,"content":"不知道大家买了新的旧的都在怎么处理"},{"from":168.4,"to":169.66,"content":"像我那台IPHONE14"},{"from":169.66,"to":171.72,"content":"就找转转上门回收了1700多"},{"from":171.72,"to":172.84,"content":"他家是真方便"},{"from":172.84,"to":174.36,"content":"回收是最快一小时上门"},{"from":174.36,"to":176.14,"content":"不管是写字楼还是住宅区"},{"from":176.14,"to":177.08,"content":"都能随叫随到"},{"from":177.08,"to":179.32,"content":"而且转转是专业的二手回收平台"},{"from":179.32,"to":181.82,"content":"全国400多个城市都支持上门回收"},{"from":181.82,"to":182.56,"content":"当面报价"},{"from":182.56,"to":183.44,"content":"现场打钱"},{"from":183.44,"to":185.4,"content":"我还发现转转不止收手机"},{"from":185.4,"to":186.64,"content":"像各种数码产品"},{"from":186.64,"to":187.44,"content":"家用电器"},{"from":187.44,"to":187.94,"content":"黄金"},{"from":187.94,"to":188.92,"content":"甚至是LV包"},{"from":188.92,"to":189.88,"content":"腕表这种奢侈品"},{"from":189.88,"to":191.34,"content":"我一直想卖又懒得处理"},{"from":191.34,"to":192.12,"content":"现在有了赚转"},{"from":192.12,"to":194.2,"content":"一键下单就能通通打包带走"},{"from":194.2,"to":194.8,"content":"特别省心"},{"from":194.8,"to":196.76,"content":"要我说轻松处理闲置物品"},{"from":196.76,"to":198.64,"content":"找转转这种大平台准没错"},{"from":198.64,"to":200.3,"content":"虽然巴特复仇成功"},{"from":200.3,"to":201.9,"content":"父母终究不能起死回生"},{"from":201.9,"to":203.68,"content":"这时记者丽莎询问巴特"},{"from":203.68,"to":205.04,"content":"这些被你误杀的人"},{"from":205.04,"to":206.48,"content":"他们的死真的值得吗"},{"from":206.48,"to":207.36,"content":"别的不知道"},{"from":207.36,"to":209.46,"content":"至少巴特的念头算是通达了"},{"from":209.46,"to":211.56,"content":"I got no parents to tell me"},{"from":211.56,"to":213.99,"content":"What to do bart man"},{"from":213.99,"to":215.59,"content":"Don't you want to join us"},{"from":215.59,"to":218.28,"content":"Don't talk to me when i'm vibrating"},{"from":218.72,"to":220.28,"content":"虽然大家都能看出来"},{"from":220.28,"to":222.1,"content":"这个故事致敬的是蝙蝠侠"},{"from":222.1,"to":224.88,"content":"但具体致敬的哪一部就显得有些杂了"},{"from":224.88,"to":227.92,"content":"比如这个故事的名字叫做巴特侠诞生"},{"from":227.92,"to":231.16,"content":"恶搞的是诺兰在05年拍的蝙蝠侠诞生"},{"from":231.16,"to":234.2,"content":"更广为人知的艺名是蝙蝠侠侠影之谜"},{"from":234.2,"to":237.04,"content":"但剧情方面要对89年伯顿版蝙蝠侠"},{"from":237.04,"to":238.1,"content":"参考的多一点"},{"from":238.1,"to":239.54,"content":"当然最经典的一幕"},{"from":239.54,"to":240.58,"content":"我父母被杀"},{"from":240.58,"to":241.54,"content":"各版本都有"},{"from":241.54,"to":244.86,"content":"不过在伯顿版蝙蝠侠杀死韦恩父母的人是小丑"},{"from":244.86,"to":246.92,"content":"而不是蛇哥对应的眼镜王蛇"},{"from":246.92,"to":249.16,"content":"这集最后巴特摘掉蛇哥的头套"},{"from":249.16,"to":251.6,"content":"才得知蛇哥是杀害父母的凶手"},{"from":251.6,"to":255.14,"content":"这与伯顿版蝙蝠侠中得知小丑是凶手如出一辙"},{"from":255.14,"to":257.7,"content":"同样的两者都有关于博物馆的场景"},{"from":257.7,"to":259.34,"content":"虽然情节上有多处对应"},{"from":259.34,"to":260.64,"content":"但仍然算不上侵权"},{"from":260.64,"to":263.32,"content":"因为辛普森家的制作组为了防止侵权"},{"from":263.32,"to":266.58,"content":"特意没在巴特身上印有任何关于蝙蝠侠的标志"},{"from":266.58,"to":268.3,"content":"为的就是消除任何侵权的"},{"from":268.3,"to":270.08,"content":"可能要说人物之间的对应"},{"from":270.08,"to":271.02,"content":"那可真不少"},{"from":271.02,"to":272.7,"content":"巴特对应的蝙蝠侠就不用说了"},{"from":272.7,"to":275.82,"content":"奥托饰演的talker肯定恶搞的是小丑的joker"},{"from":275.82,"to":277.2,"content":"弗兰德饰演的欺诈人"},{"from":277.2,"to":278.74,"content":"恶搞的肯定是谜语人"},{"from":278.74,"to":281.42,"content":"汉斯饰演的鼹鼠先生恶搞的是极冻先生"},{"from":281.42,"to":283.5,"content":"怕帝和塞尔玛饰演的甜辣组合"},{"from":283.5,"to":285.72,"content":"恶搞的是双面人的两个美女助手"},{"from":285.72,"to":288.54,"content":"而莱妮这个异装癖恶搞的则是独藤女"},{"from":288.54,"to":291.54,"content":"最后还有前面提到的蛇哥对应的眼镜王蛇啊"},{"from":291.54,"to":293.64,"content":"抛开这集关于蝙蝠侠的元素"},{"from":293.64,"to":296.22,"content":"其实还有不少其他有趣的细节和彩蛋"},{"from":296.22,"to":297.54,"content":"比如故事的一开始"},{"from":297.54,"to":299.32,"content":"这里的背景音乐是创作于"},{"from":299.32,"to":301.3,"content":"1939年的大乘A号列车"},{"from":301.3,"to":303.88,"content":"本来这首曲子是要被扫进垃圾堆的"},{"from":303.88,"to":305.88,"content":"没错就是物理意义上的垃圾堆"},{"from":305.88,"to":308.66,"content":"当比利斯特雷霍恩创作完这首曲子后"},{"from":308.66,"to":309.7,"content":"觉得没什么亮点"},{"from":309.7,"to":310.86,"content":"就扔进了垃圾桶"},{"from":310.86,"to":313.26,"content":"后来被墨色捡出来并找人演奏后"},{"from":313.26,"to":316.46,"content":"才有了这首被美由全国公共广播电台列入"},{"from":316.46,"to":319.76,"content":"20世纪最重要的100首美国音乐作品的曲子"},{"from":319.76,"to":322.1,"content":"后面还有一部佐罗加入海军的电影"},{"from":322.1,"to":322.64,"content":"佐罗啊"},{"from":322.64,"to":324.52,"content":"可以说是西方文化中的侠客"},{"from":324.52,"to":325.7,"content":"或者说是异贼"},{"from":325.7,"to":328.7,"content":"因为这个角色啊比蝙蝠侠的创作还要早20年"},{"from":328.7,"to":331.92,"content":"所以后来的蝙蝠侠创作者鲍勃凯恩亲口承认"},{"from":331.92,"to":334.36,"content":"佐罗是蝙蝠侠的灵感来源之一"},{"from":334.36,"to":334.9,"content":"如果说"},{"from":334.9,"to":338.1,"content":"1951年的艾伯特和科斯特洛遇见隐形人"},{"from":338.1,"to":341.14,"content":"可以翻译成现在的两傻大战隐形人的艺名啊"},{"from":341.14,"to":344.42,"content":"那这集恶搞的艾伯特和科斯特洛遇见小孩麻痹"},{"from":344.42,"to":346.92,"content":"就可以翻译成两傻大战小二麻痹"},{"from":346.92,"to":349.44,"content":"后面还有一群人围着帝国大厦拍照"},{"from":349.44,"to":352.32,"content":"上面的金刚正带着纽约洋基队的帽子"},{"from":352.32,"to":353.42,"content":"向大家打招呼"},{"from":353.42,"to":355.38,"content":"最后聊一下蝙蝠侠的这个标志啊"},{"from":355.38,"to":356.74,"content":"有没有朋友和我一样"},{"from":356.74,"to":358.24,"content":"初次见到这个标志时"},{"from":358.24,"to":360,"content":"看的不是主体黑色的部分"},{"from":360,"to":361.28,"content":"而是背景颜色的部分"},{"from":361.28,"to":363.42,"content":"这时我们就可以看到一个大嘴巴"},{"from":363.42,"to":365.42,"content":"上面两颗大牙加一颗小牙"},{"from":365.42,"to":366.54,"content":"下面四颗大牙"},{"from":366.54,"to":367.62,"content":"当时我还纳闷"},{"from":367.62,"to":369.46,"content":"这怎么就是蝙蝠侠的标志啊"},{"from":369.46,"to":371.94,"content":"直到有一天我把注意力转移到黑色"},{"from":371.94,"to":372.72,"content":"才发现哦"},{"from":372.72,"to":373.98,"content":"原来是这么回事啊"},{"from":373.98,"to":374.9,"content":"十分感谢大家"},{"from":374.9,"to":376.92,"content":"上期随手改2070.1万赞"},{"from":376.92,"to":378.88,"content":"这期也希望大家随手点个赞吧"},{"from":378.88,"to":379.9,"content":"真的万分感谢"},{"from":379.9,"to":381.26,"content":"那么本期就到这里啦"},{"from":381.26,"to":382.34,"content":"我们下期再见"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:06:28.385Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:06:25.270Z"}}
