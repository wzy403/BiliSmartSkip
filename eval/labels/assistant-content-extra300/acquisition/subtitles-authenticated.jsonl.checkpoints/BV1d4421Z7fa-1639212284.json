{"schemaVersion":1,"bvid":"BV1d4421Z7fa","cid":1639212284,"subtitles":[{"from":0.2,"to":0.64,"content":"大家好"},{"from":0.64,"to":1.92,"content":"我是中喜爱"},{"from":1.92,"to":2.6,"content":"8月以来"},{"from":2.6,"to":3.38,"content":"浙江上海"},{"from":3.38,"to":6.16,"content":"江苏安徽江西等遭遇极端高温天气"},{"from":7.96,"to":11,"content":"今年的高温总体上范围不如2022年大"},{"from":11,"to":13.14,"content":"持续时间也不如2022年长"},{"from":13.14,"to":15.58,"content":"四川重庆没有加入极端高温队伍"},{"from":15.58,"to":17.78,"content":"湖南湖北等的高温极中时段"},{"from":17.78,"to":19.8,"content":"和江浙沪的高温集中时段错开"},{"from":19.8,"to":23.04,"content":"福建最热的时候和江浙沪最热的时候错开"},{"from":23.04,"to":24.92,"content":"极端高温没有同时发生"},{"from":24.92,"to":26.86,"content":"但是福建热的时间超长"},{"from":26.86,"to":27.68,"content":"峰值很高"},{"from":27.68,"to":30.8,"content":"江浙沪的高温强度和时间堪比2022年"},{"from":30.8,"to":31.3,"content":"上海"},{"from":31.3,"to":33.92,"content":"杭州等连续多日达到或超过40度"},{"from":33.92,"to":36.48,"content":"上海于8月4日达到40.4度"},{"from":36.48,"to":39.28,"content":"距离2022年和2017年的历史最高温"},{"from":39.28,"to":40.32,"content":"仅0.5度"},{"from":40.32,"to":42.8,"content":"杭州于8月3日达到41.9度"},{"from":42.8,"to":43.72,"content":"打破历史记录"},{"from":43.72,"to":46.12,"content":"萧山区地表温度曾经达到72度"},{"from":46.12,"to":48.84,"content":"南京也于八月五日下午3.44分"},{"from":48.84,"to":49.92,"content":"达到40.2度"},{"from":49.92,"to":51.12,"content":"为新世纪以来第二高"},{"from":51.12,"to":52.4,"content":"仅次于2022年"},{"from":52.4,"to":55.8,"content":"上海徐家汇最低夜温一度达到32.1度"},{"from":55.8,"to":56.72,"content":"打平的历史记录"},{"from":56.72,"to":59.44,"content":"江浙沪的自来水已经被高温烤煮热"},{"from":59.44,"to":62.16,"content":"不少朋友洗澡已经不用开热水器"},{"from":62.16,"to":64.06,"content":"有朋友白天上街走路"},{"from":64.06,"to":64.8,"content":"鞋子脱胶"},{"from":64.8,"to":65.88,"content":"甚至鞋底脱落"},{"from":65.88,"to":66.4,"content":"可以说"},{"from":66.4,"to":68.42,"content":"这次高温是区女性的极端高温"},{"from":68.42,"to":69.58,"content":"它还要持续很久"},{"from":69.58,"to":72,"content":"这个时候保湿又成了重中之重"},{"from":72,"to":73.68,"content":"我们的国产品牌移联"},{"from":73.68,"to":75.48,"content":"这个时候就要发挥大用场了"},{"from":75.48,"to":78.64,"content":"这里我要首先推荐颐莲玻尿酸深层保湿喷雾"},{"from":78.64,"to":79.04,"content":"2.0"},{"from":79.04,"to":82.44,"content":"它是移动的精华水库缺水机的随身好喷油"},{"from":82.44,"to":85.48,"content":"采用三重玻尿酸加哥伦比亚冰川矿泉水"},{"from":85.48,"to":87.28,"content":"加五重保湿精华"},{"from":87.28,"to":88.56,"content":"水雾超级细腻"},{"from":88.56,"to":89.92,"content":"能四小时长效保湿"},{"from":89.92,"to":91,"content":"闷热夏天喷一下"},{"from":91,"to":91.84,"content":"降温又养肤"},{"from":91.84,"to":92.64,"content":"提神又醒脑"},{"from":92.64,"to":93.2,"content":"超级爽"},{"from":93.2,"to":95.16,"content":"另外搭配一脸小耳朵面膜"},{"from":95.16,"to":97.3,"content":"它背靠福瑞达玻尿酸大肠"},{"from":97.3,"to":100.94,"content":"拥有十种玻尿酸加六种神经酰胺"},{"from":100.94,"to":103.32,"content":"加4%基草血提取液"},{"from":103.32,"to":105.36,"content":"能高保湿稳修护速退红"},{"from":105.36,"to":106.72,"content":"包括敏感肌在内"},{"from":106.72,"to":107.72,"content":"任何肤质都可用"},{"from":107.72,"to":108.52,"content":"用法也方便"},{"from":108.52,"to":110.61,"content":"一拉一挤白茶抹布一上脸"},{"from":110.61,"to":113.59,"content":"经常熬夜的朋友皮肤就能重回透亮健康皮"},{"from":113.59,"to":115.01,"content":"两种产品配合下来"},{"from":115.01,"to":116.73,"content":"力求将高保湿做到极致"},{"from":116.73,"to":119.3,"content":"满足国人最基础也是最重要的护肤诉求"},{"from":119.3,"to":121.32,"content":"在高温即将达到鼎盛期时"},{"from":121.32,"to":124.44,"content":"要保湿的朋友选择银联这两种产品准没错"},{"from":124.44,"to":125.7,"content":"最重要的是价格便宜"},{"from":125.7,"to":128.61,"content":"有需要的朋友点击置顶链接下单吧"},{"from":128.61,"to":130.85,"content":"不过高温已经有了松动的迹象"},{"from":130.85,"to":133.07,"content":"这几天南方的雷雨一天比一天多"},{"from":133.07,"to":134.09,"content":"一天比一天猛"},{"from":134.09,"to":134.97,"content":"一天比一天"},{"from":134.97,"to":135.22,"content":"早"},{"from":135.22,"to":136.06,"content":"在8月4日"},{"from":136.06,"to":136.78,"content":"浙江杭州"},{"from":136.78,"to":138.96,"content":"广东潮州等地的狂风暴雨后"},{"from":138.96,"to":139.66,"content":"8月5日"},{"from":139.66,"to":140.38,"content":"江苏中南部"},{"from":140.38,"to":141.3,"content":"安安徽南部"},{"from":141.3,"to":142.24,"content":"浙江西部"},{"from":142.24,"to":143.08,"content":"江西西部"},{"from":143.08,"to":143.8,"content":"湖南南部"},{"from":143.8,"to":146.2,"content":"广东和福建局部又出现了狂风暴雨"},{"from":146.2,"to":149.2,"content":"其中江苏常州还在逼近40度时下了冰雹"},{"from":149.2,"to":150.8,"content":"再一次突然降温十度"},{"from":150.8,"to":153.24,"content":"广东深圳附近出现强烈雷暴云团"},{"from":153.24,"to":155.36,"content":"当地发布了雷暴大风橙色预警"},{"from":155.36,"to":157,"content":"当然正如我们上期节目所说"},{"from":157,"to":159.4,"content":"这些雷雨是副高内部的热雷雨"},{"from":159.4,"to":160.4,"content":"是极端高温"},{"from":160.4,"to":162.36,"content":"低温热量聚集导致的"},{"from":162.36,"to":164.62,"content":"上升气流和海陆风共同影响所致"},{"from":164.62,"to":166.8,"content":"它们只能给局部地区消消暑"},{"from":166.8,"to":168.08,"content":"但不能击溃富高"},{"from":168.08,"to":169.82,"content":"不能让高温彻底减弱"},{"from":169.82,"to":171.84,"content":"环节下到雨的地方还是少数"},{"from":171.84,"to":172.84,"content":"没下到雨的"},{"from":172.84,"to":175.24,"content":"大多数地方还是酷热难耐"},{"from":175.24,"to":177.14,"content":"那么怎么才能击溃副高"},{"from":177.14,"to":178.28,"content":"答案很明确"},{"from":178.28,"to":179.4,"content":"北边的西风槽"},{"from":179.4,"to":180.5,"content":"南边的台风"},{"from":180.5,"to":182.28,"content":"由于目前副高实力太强"},{"from":182.28,"to":185.98,"content":"单靠西风槽或者单靠台风都无法单挑副高"},{"from":185.98,"to":189.6,"content":"台风和西风槽必须要联手才能击溃现在的副高"},{"from":189.6,"to":191.84,"content":"而8月5日这样的机会已经来了"},{"from":191.84,"to":194.3,"content":"目前西北太平洋有多个台风胚胎活动"},{"from":194.3,"to":195.34,"content":"它们分别是我国"},{"from":195.34,"to":197.76,"content":"台湾附近的93W和91W"},{"from":197.76,"to":200.54,"content":"以及日本以南的94W卫星云图"},{"from":200.54,"to":203.16,"content":"可见在副高强大的下沉气流作用下"},{"from":203.16,"to":204.5,"content":"他们都灿弱不堪"},{"from":204.5,"to":205.52,"content":"形态丑陋"},{"from":205.52,"to":206.42,"content":"难以发展"},{"from":206.42,"to":208.76,"content":"但是他们三组成的巨大低压区"},{"from":208.76,"to":211.32,"content":"也让副高难以统治整个西北太平洋"},{"from":211.32,"to":212.6,"content":"难以加强牺牲"},{"from":212.6,"to":213.72,"content":"而就在这时"},{"from":213.72,"to":215.96,"content":"一个西风潮已经悄悄来到新疆北部"},{"from":215.96,"to":218.92,"content":"接下来他用三天时间慢慢扫过新疆"},{"from":218.92,"to":220.72,"content":"带来一些不痛不痒的降温"},{"from":220.72,"to":223,"content":"譬如说乌鲁木齐从35度降到31度"},{"from":223,"to":225.28,"content":"吐鲁番从43度降到36度"},{"from":225.28,"to":226.9,"content":"但随后8月7日"},{"from":226.9,"to":228.3,"content":"它将加深加强"},{"from":228.3,"to":231.9,"content":"再用四天时间缓慢扫过陕甘宁和中东部地区"},{"from":231.9,"to":234.38,"content":"在西风潮和台风胚胎的联手作用下"},{"from":234.38,"to":236.54,"content":"我国近海副高中雨顶不住了"},{"from":236.54,"to":237.38,"content":"8月10日起"},{"from":237.38,"to":238.74,"content":"它就将大幅减弱"},{"from":238.74,"to":241.52,"content":"8月11到12日还可能全盘崩溃"},{"from":241.52,"to":242.08,"content":"正因为此"},{"from":244.2,"to":246.32,"content":"而南方高温将逐步南移"},{"from":246.32,"to":247.34,"content":"8月7日起"},{"from":247.34,"to":249,"content":"苏北皖北高温就有可能缓解"},{"from":249,"to":250.56,"content":"8月10日前后"},{"from":250.56,"to":252.14,"content":"川渝高温缓解"},{"from":252.14,"to":253.48,"content":"8月11到12日"},{"from":253.48,"to":254.26,"content":"苏南上海"},{"from":254.26,"to":255.36,"content":"浙江安徽中南部"},{"from":255.36,"to":257.24,"content":"湖北湖南江西高温有望减弱"},{"from":257.24,"to":259.66,"content":"但福建广东广西高温有可能增强"},{"from":259.66,"to":260.96,"content":"8月13日后"},{"from":260.96,"to":263.22,"content":"福建两广的高温也有望减弱"},{"from":263.22,"to":264.78,"content":"转为普通桑拿天"},{"from":264.78,"to":266.58,"content":"那么这几个台风胚胎要怎么走"},{"from":266.58,"to":267.64,"content":"答案很明确"},{"from":267.64,"to":269.4,"content":"因为我国近海副高峰会"},{"from":269.4,"to":272.38,"content":"他们无一例外都要去日本或日本附近地区"},{"from":272.38,"to":275.28,"content":"而风暴活跃的不只是西北太平洋"},{"from":275.28,"to":278.8,"content":"目前东太平洋北大西洋的飓风也非常活跃"},{"from":278.8,"to":281.74,"content":"其中东北太平洋有四个飓风或飓风胚胎发展"},{"from":281.74,"to":285,"content":"而北大西洋热带风暴呆比正在墨西哥湾"},{"from":285,"to":287.06,"content":"迅猛加强并靠近美国"},{"from":287.06,"to":287.58,"content":"佛州"},{"from":287.58,"to":290,"content":"黛比有可能一直加强到上岸前"},{"from":290,"to":292.62,"content":"有可能以巅峰强度登陆美国"},{"from":292.62,"to":293.02,"content":"好了"},{"from":293.02,"to":294.06,"content":"感谢收看本期节目"},{"from":294.06,"to":295.06,"content":"建议关注中下海"},{"from":295.06,"to":296.18,"content":"并一键三连"},{"from":296.18,"to":297.94,"content":"我们下期节目见"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:04:02.108Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:03:59.192Z"}}
