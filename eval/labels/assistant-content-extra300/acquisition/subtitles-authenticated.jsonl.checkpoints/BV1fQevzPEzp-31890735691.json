{"schemaVersion":1,"bvid":"BV1fQevzPEzp","cid":31890735691,"subtitles":[{"from":0.1,"to":0.8,"content":"在当下"},{"from":0.8,"to":1.74,"content":"2025年"},{"from":1.74,"to":5.08,"content":"美国人暂时拥有世界上最强的航母舰载机部队"},{"from":5.08,"to":6.62,"content":"论起其综合打击能力"},{"from":6.62,"to":9.399,"content":"综合作战能力数量确实没有什么敌手"},{"from":9.399,"to":10.759,"content":"但是随着大洋彼岸"},{"from":10.759,"to":13.719,"content":"歼三五战斗机开始频繁占据中外媒体版面"},{"from":13.719,"to":16.239,"content":"歼15T悄无声息地占据了辽宁"},{"from":16.239,"to":18.259,"content":"山东两舰甲板半壁江山"},{"from":18.259,"to":20.259,"content":"美国人对于好舰载机的建议"},{"from":20.259,"to":22.259,"content":"或许正在发生一些悄然变化"},{"from":22.259,"to":25.9,"content":"F18F35C他们是否还能够战胜新的对手"},{"from":25.9,"to":28.14,"content":"也许答案至今会非常难以回答"},{"from":28.14,"to":31.3,"content":"特别是当下F18系列在美军过去十个月里面"},{"from":31.3,"to":32.52,"content":"已经连摔了六架"},{"from":32.52,"to":33.32,"content":"S35"},{"from":33.32,"to":35.04,"content":"今年已经连摔俩的情况下"},{"from":35.04,"to":36.98,"content":"所以关于谁好谁坏这个问题"},{"from":36.98,"to":40.01,"content":"不如让我们从底层开始重新认识舰载机"},{"from":40.01,"to":42.31,"content":"舰载战斗机它们到底有何特别"},{"from":42.31,"to":44.21,"content":"舰载战斗机为何难以设计"},{"from":44.21,"to":46.93,"content":"特别是当下技术拔和愈演愈烈的今天"},{"from":46.93,"to":49.01,"content":"各位观众朋友们早上中午晚上好"},{"from":49.01,"to":50.53,"content":"欢迎来到本期的大局预定"},{"from":50.53,"to":53.85,"content":"今天我们来聊聊航母上的舰载机"},{"from":65.839,"to":68.039,"content":"当前各位最大的疑问肯定是"},{"from":68.039,"to":69.599,"content":"舰载机有什么特殊的"},{"from":69.599,"to":72.84,"content":"或者说当代舰载机和陆基战斗机有什么区别"},{"from":72.84,"to":74.78,"content":"这个问题说简单也简单"},{"from":74.78,"to":76.1,"content":"说复杂也复杂"},{"from":76.1,"to":78.42,"content":"我们先从最浅的地方开始讲"},{"from":78.42,"to":81.38,"content":"一架飞机能从航母甲板上起飞着陆"},{"from":81.38,"to":82.52,"content":"能在航母上运作"},{"from":82.52,"to":84.199,"content":"我们就可以称其为舰载机"},{"from":84.199,"to":85.939,"content":"听起来非常简单对吧"},{"from":85.939,"to":89.319,"content":"但其实如果一个飞机要围绕航母进行设计的话"},{"from":89.319,"to":91.199,"content":"这玩意儿就注定它哪哪都复杂"},{"from":91.199,"to":92.4,"content":"注定不简单"},{"from":92.4,"to":94.96,"content":"首先就是舰载机与地面上的战斗机"},{"from":94.96,"to":97.56,"content":"最不同的就是航母起降这个阶段"},{"from":97.56,"to":99.4,"content":"这里让我们先从起飞讲起"},{"from":99.4,"to":100.9,"content":"或者我们再精确一点"},{"from":100.9,"to":103.65,"content":"以弹射方式起飞的舰载机有什么不同"},{"from":103.65,"to":104.63,"content":"对于这类飞机"},{"from":104.63,"to":107.53,"content":"首先所有需要面临的挑战就是过载啊"},{"from":107.53,"to":109,"content":"过载什么过载"},{"from":109,"to":111.12,"content":"这里啊指的就是弹射的时候"},{"from":111.12,"to":113.92,"content":"飞机沿着机头的方向受到一个弹射器牵引"},{"from":113.92,"to":116.06,"content":"造成的纵向过载啊"},{"from":116.06,"to":117.04,"content":"按照常理来说"},{"from":117.04,"to":119.24,"content":"战斗机不是特别能扛大过载吗"},{"from":119.24,"to":122.34,"content":"这里橘猫有必要科普一下传统的陆基战斗机"},{"from":122.34,"to":125.02,"content":"在机动中所谓的8G9Z过载啊"},{"from":125.02,"to":127.58,"content":"这个过载方向呢其实主要就是击背方向"},{"from":127.58,"to":130.18,"content":"说白了就是飞机抬头这个动作向上"},{"from":130.18,"to":131.26,"content":"然后这个过载"},{"from":131.26,"to":134.42,"content":"其实基本上就是战斗机所能产生的最强过载了"},{"from":134.42,"to":135.28,"content":"其他情况"},{"from":135.28,"to":136.54,"content":"你要不是安东星超人"},{"from":136.54,"to":138.67,"content":"你要不学F35去海里游泳了"},{"from":138.67,"to":139.63,"content":"为啥这样呢"},{"from":139.63,"to":141.05,"content":"其实啊主要和人有关"},{"from":141.05,"to":141.87,"content":"结构啥的"},{"from":141.87,"to":143.31,"content":"真的能够设计成十几20"},{"from":143.31,"to":144.83,"content":"甚至更恐怖的三位数过载"},{"from":144.83,"to":146.44,"content":"但问题在于人扛不住啊"},{"from":146.44,"to":148.9,"content":"根据NASA和FAA的报告总结"},{"from":148.9,"to":150.68,"content":"训练后的飞行员在战斗机上"},{"from":150.68,"to":153.56,"content":"最多可以在短时间内承受7~9G的过载"},{"from":153.56,"to":154.88,"content":"但是控制和视觉"},{"from":154.88,"to":157.64,"content":"这些机能在6~7G左右就会开始下降了"},{"from":157.64,"to":159.64,"content":"如果反过来向下产生过载"},{"from":159.64,"to":162.51,"content":"只需要二到-3G就直接能产生红势"},{"from":162.51,"to":164.69,"content":"这是一种非常高风险的情境"},{"from":164.69,"to":168.16,"content":"至于前后左右则需要看约束来具体进行考量"},{"from":168.16,"to":170.04,"content":"所以为了避免过载太强"},{"from":170.04,"to":172.46,"content":"把血液甩进飞行员脑袋引发脑出血"},{"from":172.46,"to":174.7,"content":"战斗机的负过载一般限制在-3G"},{"from":174.7,"to":176.18,"content":"也就是除抬头向上外"},{"from":176.18,"to":178.5,"content":"对过载的要求最高的一个方向了"},{"from":178.5,"to":179.7,"content":"至于其他的方向"},{"from":179.7,"to":181.54,"content":"常规陆基飞机的前后左右方向"},{"from":181.54,"to":183.42,"content":"过载需求一般都没有什么要求"},{"from":183.42,"to":185.46,"content":"以当前人类航空器的技术水平"},{"from":185.46,"to":187.42,"content":"战斗机即便是在空载条件上"},{"from":187.42,"to":189.55,"content":"发动机的推重比也就是那样"},{"from":189.55,"to":191.35,"content":"能够作用到飞行员上的加速度"},{"from":191.35,"to":192.09,"content":"也就这么多"},{"from":192.09,"to":193.07,"content":"作用到飞机上啊"},{"from":193.07,"to":194.15,"content":"一点几都不得了了"},{"from":194.15,"to":195.54,"content":"撑死就到2G"},{"from":195.54,"to":197.52,"content":"但是舰载机它就不同了"},{"from":197.52,"to":198.62,"content":"弹射器这个玩意儿"},{"from":198.62,"to":200.88,"content":"可以轻轻松松给你干到3~4个G"},{"from":200.88,"to":202.06,"content":"极端一点的情况下"},{"from":202.06,"to":203.45,"content":"甚至能上五个G"},{"from":203.45,"to":205.41,"content":"所以这个弹射器暴力拉拽的过程"},{"from":205.41,"to":208.27,"content":"就会导致舰载机必须从前起落架到整体"},{"from":208.27,"to":209.69,"content":"再到机体到油箱"},{"from":209.69,"to":210.41,"content":"到发动机"},{"from":210.41,"to":211.8,"content":"乃至到挂架弹药"},{"from":211.8,"to":213.42,"content":"所有的机构设备结构"},{"from":213.42,"to":214.92,"content":"工作状态和安装强度"},{"from":214.92,"to":217.68,"content":"刚度都必须能够经受得了弹射起飞时"},{"from":217.68,"to":219.579,"content":"那最高武器的纵向过载"},{"from":219.579,"to":220.899,"content":"而且还有一点啊"},{"from":220.899,"to":222.759,"content":"这个过载不是像火箭一样的"},{"from":222.759,"to":224.219,"content":"承受一下就可以了"},{"from":224.219,"to":227.19,"content":"舰载机还必须要符合疲劳运作寿命准则"},{"from":227.19,"to":228.63,"content":"比如说你这架舰载机"},{"from":228.63,"to":230.31,"content":"是要能够弹射3000~5000次"},{"from":230.31,"to":231.95,"content":"之后才能出现问题的"},{"from":231.95,"to":234.15,"content":"各位观众朋友看到这里听我唠叨这么久"},{"from":234.15,"to":235.95,"content":"是不是也可以点一下三连呢"},{"from":235.95,"to":237.39,"content":"这还只是起飞"},{"from":237.39,"to":239.38,"content":"如今这个问题其实更麻烦"},{"from":239.38,"to":240.18,"content":"具体来说"},{"from":240.18,"to":241.52,"content":"舰载机除了挂拦阻索"},{"from":241.52,"to":243.66,"content":"猛拽一下所产生的负过载之外"},{"from":243.66,"to":246.53,"content":"还有两个陆基飞机不需要面对的降落问题"},{"from":246.53,"to":248.99,"content":"首先舰载飞机在航空母舰上着舰"},{"from":248.99,"to":251.07,"content":"通常采用无拉平的着舰模式"},{"from":251.07,"to":254.49,"content":"俗称呢啪的一下拍到甲板上作为对比"},{"from":254.49,"to":255.91,"content":"陆基飞机在降落的时候"},{"from":255.91,"to":257.93,"content":"通常需要进行小幅度的改平"},{"from":257.93,"to":261.23,"content":"即通过小幅度的抬头来减少垂直下降的速度"},{"from":261.23,"to":262.5,"content":"实现平稳着陆"},{"from":262.5,"to":264.22,"content":"这个动作说起来有点抽象"},{"from":264.22,"to":266.3,"content":"但是各位应该在坐国内航班的时候"},{"from":266.3,"to":268.18,"content":"应该会有一个比较明显的体验"},{"from":268.18,"to":270,"content":"舰载机的这种野蛮操作"},{"from":270,"to":273.24,"content":"其实主要是因为舰载机减速必须要依赖拦阻索"},{"from":273.24,"to":274.04,"content":"降落的时候"},{"from":274.04,"to":275.86,"content":"必须要精确地使飞机的尾钩"},{"from":275.86,"to":277.86,"content":"能够抓住甲板上的拦阻索"},{"from":277.86,"to":279.54,"content":"如果进行额外的改平动作"},{"from":279.54,"to":280.98,"content":"很有可能引入其他的变量"},{"from":280.98,"to":282.34,"content":"导致飞机飘过拦阻索"},{"from":282.34,"to":283.909,"content":"没有办法减速停下来"},{"from":283.909,"to":286.029,"content":"因此舰载机直接拍到甲板上"},{"from":286.029,"to":288.14,"content":"垂直速度要比陆基飞机大得多"},{"from":288.14,"to":290.4,"content":"美国国防情报中心的数据显示"},{"from":290.4,"to":293.14,"content":"舰载机降落时的冲击力是陆基飞机的两倍"},{"from":293.14,"to":294.14,"content":"非常暴躁"},{"from":294.14,"to":296.88,"content":"如果此时再考虑一下海上航行的恶劣天气"},{"from":296.88,"to":298.82,"content":"航母会有一定的沉浮运动"},{"from":298.82,"to":299.76,"content":"上下浮动"},{"from":299.76,"to":300.68,"content":"舰载机出现"},{"from":300.68,"to":301.8,"content":"那一下的下沉速度"},{"from":301.8,"to":304.59,"content":"甚至会达到陆基飞机的两到2.5倍以上"},{"from":304.59,"to":308.01,"content":"垂直速度甚至能够达到六到7米每秒这个量级"},{"from":308.01,"to":310.39,"content":"这些能量都需要依靠起落架来吸收"},{"from":310.39,"to":311.55,"content":"相比于陆基飞机"},{"from":311.55,"to":313.53,"content":"舰载机起落架吸收的垂直动能"},{"from":313.53,"to":315.34,"content":"约是陆基飞机的六倍以上"},{"from":315.34,"to":317.76,"content":"我们以发18EF大虫子为例"},{"from":317.76,"to":320.42,"content":"其设计在不影响机体寿命的前提下"},{"from":320.42,"to":322.66,"content":"起落架和机体结构要能够承受得住"},{"from":322.66,"to":324.72,"content":"7.32米每秒的下沉速度"},{"from":324.72,"to":325.32,"content":"差不多"},{"from":325.32,"to":328.16,"content":"相当于把这架小20吨重的舰载机吊起来"},{"from":328.16,"to":330.34,"content":"从一层楼的高度咣叽一下丢下去"},{"from":330.34,"to":330.98,"content":"然后撞地"},{"from":330.98,"to":333.66,"content":"这一下由飞机自身的起落架完全吸收掉"},{"from":333.66,"to":335.45,"content":"此时还不能产生弹跳"},{"from":335.45,"to":336.53,"content":"这就需要舰载机"},{"from":336.53,"to":338.57,"content":"拥有一个特别特别强壮的起落架"},{"from":338.57,"to":339.85,"content":"具体有多强壮呢"},{"from":339.85,"to":341.23,"content":"我们直接报数字吧"},{"from":341.23,"to":342.45,"content":"大虫子的主起标"},{"from":342.45,"to":344.69,"content":"加重量达到了620kg以上"},{"from":344.69,"to":346.55,"content":"前起落架280kg"},{"from":346.55,"to":348.27,"content":"加上小100kg的尾钩"},{"from":348.27,"to":351.06,"content":"整个起落装置的总重量就达到了一吨"},{"from":351.06,"to":351.98,"content":"各位要知道"},{"from":351.98,"to":354.06,"content":"这是不包含舰载机所需要付出额外"},{"from":354.06,"to":356.89,"content":"机体结构重量的情况下所付出的重量代价"},{"from":356.89,"to":359.55,"content":"而大虫子的整个飞机的空重有多大呢"},{"from":359.55,"to":361.28,"content":"区区13万吨出头啊"},{"from":361.28,"to":362.44,"content":"第二个问题就是"},{"from":362.44,"to":364.98,"content":"拦阻索会对飞机设计造成很大的限制"},{"from":364.98,"to":366.669,"content":"我们一步一步来讲"},{"from":366.669,"to":368.869,"content":"首先要精确的勾到拦阻索"},{"from":368.869,"to":370.229,"content":"舰载机才能降落"},{"from":370.229,"to":372.309,"content":"但是航母甲板不过区区百米"},{"from":372.309,"to":373.949,"content":"想要在这点距离上刹停"},{"from":373.949,"to":376.18,"content":"那么就只能依靠外力在航母上"},{"from":376.18,"to":377.64,"content":"这个外力就是拦阻索"},{"from":377.64,"to":379.18,"content":"在降落的时候一边下落"},{"from":379.18,"to":380.22,"content":"一边瞄准拦阻索"},{"from":380.22,"to":381.56,"content":"这个操作非常之难"},{"from":381.56,"to":382.96,"content":"这本身就需要舰载机"},{"from":382.96,"to":384.78,"content":"拥有非常好的低速飞行品质"},{"from":384.78,"to":386.83,"content":"以及低速操纵性和稳定性"},{"from":386.83,"to":387.85,"content":"说句人话"},{"from":387.85,"to":390.51,"content":"舰载机就是要能在尽量慢的速度下可控"},{"from":390.51,"to":392.39,"content":"还得是要非常精确可控的"},{"from":392.39,"to":393.65,"content":"才能落到拦阻索上"},{"from":393.65,"to":394.52,"content":"为什么呢"},{"from":394.52,"to":395.92,"content":"整个航母的拦阻系统"},{"from":395.92,"to":397.76,"content":"要把飞机在10米左右的距离上"},{"from":397.76,"to":399.289,"content":"直接活生生地拽住"},{"from":399.289,"to":402.649,"content":"但问题是拦阻索能够吸收的能量总归有个上限"},{"from":402.649,"to":404.369,"content":"这就牵扯到了一个问题"},{"from":404.369,"to":406.8,"content":"舰载机逐渐的时候可带回的重量"},{"from":406.8,"to":408.2,"content":"光说说非常抽象"},{"from":408.2,"to":410.5,"content":"让我们回顾一下高中物理动能公式"},{"from":410.5,"to":412.25,"content":"一等于二分之1MV方"},{"from":412.25,"to":415.15,"content":"当拦阻系统吸收的总能量一定的时候"},{"from":415.15,"to":416.67,"content":"舰载机的着舰速度越大"},{"from":416.67,"to":418.7,"content":"舰载机的可用质量就越小"},{"from":418.7,"to":421.46,"content":"这里舰载机的着舰重量就等于飞机的使用"},{"from":421.46,"to":423.23,"content":"空中加鱼油加弹药"},{"from":423.23,"to":425.77,"content":"而且分配重量啊也不是这么好搞的"},{"from":425.77,"to":428.67,"content":"首先舰载机的这个使用空中这个是定死的"},{"from":428.67,"to":429.63,"content":"燃料不值钱啊"},{"from":429.63,"to":431.88,"content":"还好说一吨也就8000块"},{"from":431.88,"to":433.64,"content":"舰载机只需要用于保留"},{"from":433.64,"to":435.34,"content":"付费用的基本燃料就可以了"},{"from":435.34,"to":437.66,"content":"其他大不了就多踩一脚油烧掉就行"},{"from":437.66,"to":440.72,"content":"那么剩下的重量就基本上就是给弹药的重量"},{"from":440.72,"to":442.56,"content":"此时舰载机的着舰重量越低"},{"from":442.56,"to":445.08,"content":"就意味着舰载机能够带回的弹药越少"},{"from":445.08,"to":447.04,"content":"对于常规的对地铁炸弹来说"},{"from":447.04,"to":448.56,"content":"丢了就丢了也还算好"},{"from":448.56,"to":450.82,"content":"但是在如今这个制导弹药的时代"},{"from":450.82,"to":453.42,"content":"一发AIM120动辄上百万美元"},{"from":453.42,"to":454.22,"content":"一发鱼叉"},{"from":454.22,"to":455.96,"content":"老特勒那也要几百万刀"},{"from":455.96,"to":457.62,"content":"那么弹药随便抛弃啊"},{"from":457.62,"to":458.73,"content":"显然不太现实"},{"from":458.73,"to":459.61,"content":"反过来说"},{"from":459.61,"to":461.25,"content":"为了防止高价值弹药浪费"},{"from":461.25,"to":464.03,"content":"那么就只能限制舰载机起飞式的弹药携带量"},{"from":464.03,"to":466.2,"content":"不过当然这也要分战术情况"},{"from":466.2,"to":468.08,"content":"你要执行的是战时第一波突袭"},{"from":468.08,"to":469.12,"content":"这种踹门任务"},{"from":469.12,"to":472.18,"content":"这种必然会把所有弹药丢出去的情况就无所谓"},{"from":472.18,"to":473.48,"content":"带多一点就带多点"},{"from":473.48,"to":476.03,"content":"但大多数战术场景都远没有这么理想"},{"from":476.03,"to":479.23,"content":"况且更糟糕的情况会限制飞机本身的机体设计"},{"from":479.23,"to":481.49,"content":"进一步会造成飞机的性能下降"},{"from":481.49,"to":484.63,"content":"所以在拦阻系统能够吸收能量有上限的情况下"},{"from":484.63,"to":487.4,"content":"就必然会对舰载机的设计提出更高的要求"},{"from":487.4,"to":488.86,"content":"这个问题怎么解决呢"},{"from":488.86,"to":492.34,"content":"从设计之初就尽可能地降低舰载机的着陆速度"},{"from":492.34,"to":494.22,"content":"放宽舰载机的使用条件"},{"from":494.22,"to":495.94,"content":"当然舰载机的着舰重量"},{"from":495.94,"to":498.32,"content":"绝非简单的动能公式就可以计算得出"},{"from":498.32,"to":499.56,"content":"在实际的计算中"},{"from":499.56,"to":501.38,"content":"至少还需要包括甲板摩擦力"},{"from":501.38,"to":502.94,"content":"气动力推力等等因素"},{"from":502.94,"to":505.65,"content":"我们用动能公式仅仅是方便大家理解"},{"from":505.65,"to":508.17,"content":"各位如果对这方面有兴趣的观众的话"},{"from":508.17,"to":510.19,"content":"橘猫提供一组简化的计算公式"},{"from":510.19,"to":511.85,"content":"各位可以自己算一下"},{"from":511.85,"to":513.73,"content":"现在我们各位已经知道了"},{"from":513.73,"to":515.25,"content":"舰载机需要从设计之初"},{"from":515.25,"to":517.65,"content":"就尽可能地降低舰载机的着陆速度"},{"from":517.65,"to":520.22,"content":"或者说提升低速情况下的操控性"},{"from":520.22,"to":522.44,"content":"首先具体到提升飞行品质"},{"from":522.44,"to":524.66,"content":"提升低速操作性方面的主要手段"},{"from":524.66,"to":526.32,"content":"有采用较大的显占比"},{"from":526.32,"to":527.599,"content":"增大机翼面积"},{"from":527.599,"to":530.159,"content":"使用比路基飞机更加有效的增生装置"},{"from":530.159,"to":532.74,"content":"甚至会使用一些非常规增生手段"},{"from":532.74,"to":536.24,"content":"如在翼面上采用边界层控制等手段实现增生"},{"from":536.24,"to":538.2,"content":"比如最经典的第二代舰载机"},{"from":538.2,"to":540.73,"content":"F4家族中的美国海军型F4B"},{"from":540.73,"to":542.25,"content":"英国海军型F4K"},{"from":542.25,"to":545.72,"content":"都采用了锦衣边界层控制的吹气锦衣增生技术"},{"from":545.72,"to":549,"content":"不过这些又会带来两个小小的新问题"},{"from":549,"to":552.14,"content":"增重和其他飞行速度区间性能劣化"},{"from":552.14,"to":555.06,"content":"橘猫这里我们以FA18小虫子为例"},{"from":555.06,"to":558.16,"content":"从YF17原型机进化到FA18的过程中"},{"from":558.16,"to":560.96,"content":"小虫子为了增加升力和保住低速操控性"},{"from":560.96,"to":562.06,"content":"增大了机翼面积"},{"from":562.06,"to":564.03,"content":"付出了180kg的代价"},{"from":564.03,"to":567.01,"content":"增加前缘锦衣付出了130kg的代价"},{"from":567.01,"to":569.31,"content":"为了满足舰上有限空间的使用需求"},{"from":569.31,"to":570.47,"content":"增加机翼折叠功能"},{"from":570.47,"to":572.37,"content":"付出了135kg的代价"},{"from":572.37,"to":574.87,"content":"再算上我们之前说的什么起落架增重"},{"from":574.87,"to":575.99,"content":"机体结构增重"},{"from":575.99,"to":578.01,"content":"纵向抗过载加强等等等等"},{"from":578.01,"to":580.19,"content":"即使是相同型号的不同子型号"},{"from":580.19,"to":583.77,"content":"舰载型也普遍比陆基型要增重10%到15"},{"from":583.77,"to":585.43,"content":"我们还是以小虫子为例"},{"from":585.43,"to":587.47,"content":"从YF17进化到FA18"},{"from":587.47,"to":589.55,"content":"B机的空重增加了超过一吨"},{"from":589.55,"to":591.59,"content":"再比如说现代化一点的F35C"},{"from":591.59,"to":593.29,"content":"再对比空军型的F35A"},{"from":593.29,"to":595.19,"content":"在少装机炮的前提之下"},{"from":595.19,"to":598.13,"content":"海军型还是比空军型重了差不多有2吨"},{"from":598.13,"to":600.77,"content":"所以说舰载机的设计啊是真的麻烦"},{"from":600.77,"to":603.69,"content":"不是简单的用陆基战斗机改一下就好了"},{"from":603.69,"to":604.41,"content":"想了想啊"},{"from":604.41,"to":605.579,"content":"就要掉不少头发"},{"from":605.579,"to":607.479,"content":"那说到掉头发脱发问题"},{"from":607.479,"to":610.839,"content":"那就不得不来提提我们本期的合作伙伴曼迪"},{"from":610.839,"to":612.839,"content":"像我前段时间熬了一个大夜"},{"from":612.839,"to":615.099,"content":"早上起来头发一抓也是一大把"},{"from":615.099,"to":616.58,"content":"头发也越来越细软"},{"from":616.58,"to":618.02,"content":"表面上看是脱发"},{"from":618.02,"to":620.64,"content":"但本质是毛囊健康出现了问题"},{"from":620.64,"to":622.349,"content":"逐渐萎缩至闭合"},{"from":622.349,"to":626.03,"content":"米诺地尔是脱发诊疗推荐指南的生发外用药"},{"from":626.03,"to":627.85,"content":"临床证据等级非常高"},{"from":627.85,"to":628.79,"content":"男女适用"},{"from":628.79,"to":630.85,"content":"但能够打开毛囊的供血通道"},{"from":630.85,"to":632.44,"content":"恢复原先的健康状态"},{"from":632.44,"to":634.46,"content":"传统溶液剂经常因为流动性"},{"from":634.46,"to":636.48,"content":"导致药物无法高效抵达毛囊"},{"from":636.48,"to":638.24,"content":"而浓度5%的泡沫剂"},{"from":638.24,"to":639.9,"content":"改变了原先的渗透方式"},{"from":639.9,"to":641.5,"content":"如同毛囊靶向导弹"},{"from":641.5,"to":643.18,"content":"精准附着于脱发区域"},{"from":643.18,"to":645.06,"content":"让毛囊周围有效的药物浓度"},{"from":645.06,"to":646.66,"content":"达到原先的2.85倍"},{"from":646.66,"to":649.02,"content":"坚持使用八周就可以初步看到效果"},{"from":649.02,"to":650.66,"content":"长出结实粗壮的毛发"},{"from":650.66,"to":652.22,"content":"使用方法也非常简单"},{"from":652.22,"to":653.06,"content":"挤出半瓶盖"},{"from":653.06,"to":655.6,"content":"用涂抹刷将泡沫直接涂抹在秃发位置"},{"from":655.6,"to":656.64,"content":"使用非常方便"},{"from":656.64,"to":657.76,"content":"因为不含丙二醇"},{"from":657.76,"to":658.82,"content":"使用感受温和"},{"from":658.82,"to":659.78,"content":"不刺激头皮"},{"from":659.78,"to":661.8,"content":"再搭配他们家的防脱洗发水"},{"from":661.8,"to":662.52,"content":"双效加持"},{"from":662.52,"to":663.66,"content":"1+1大于二"},{"from":663.66,"to":665.54,"content":"音乐的核心成分是米诺地尔"},{"from":665.54,"to":667.22,"content":"分子结构相似的乌诺地尔"},{"from":667.22,"to":668.26,"content":"可以有效地抑制"},{"from":668.26,"to":671.14,"content":"由于生活习惯不好导致的毛囊纤维化问题"},{"from":671.14,"to":672.56,"content":"让头发扎根毛囊"},{"from":672.56,"to":675.12,"content":"使四周掉发量就能减少38%"},{"from":675.12,"to":677.12,"content":"现在有脱发困扰的朋友们"},{"from":677.12,"to":680.03,"content":"可以趁着现在有优惠下手试试吧"},{"from":680.27,"to":681.71,"content":"让我们说回到航母"},{"from":681.71,"to":682.21,"content":"舰载机"},{"from":682.21,"to":683.25,"content":"说回到航母"},{"from":683.25,"to":683.89,"content":"在上面"},{"from":683.89,"to":687.13,"content":"我们小小的讲了下舰载机所要解决的起降问题"},{"from":687.13,"to":690.109,"content":"接下来我们就要开始深入到第二个难题了"},{"from":690.109,"to":691.989,"content":"舰载机是一个多用途平台"},{"from":691.989,"to":694.089,"content":"是以航母为平台的航空力量"},{"from":694.089,"to":695.589,"content":"首先为起降优化"},{"from":695.589,"to":698.8,"content":"会导致其他飞行速度期间的性能恶化更加严峻"},{"from":698.8,"to":701.95,"content":"根据NASA技术报告的服务器上的文献单说"},{"from":701.95,"to":703.03,"content":"舰载机增肥增重"},{"from":703.03,"to":706.27,"content":"这个问题就会导致舰载机在敏捷性重量"},{"from":706.27,"to":709.609,"content":"翼展面积和任务类型之间存在设计上的权衡"},{"from":709.609,"to":711.989,"content":"所以飞机在设计上必须要进行取舍"},{"from":711.989,"to":714.88,"content":"以牺牲部分性能来满足其他起降要求"},{"from":714.88,"to":718.38,"content":"第二航母所能搭载机的舰载机数量非常有限"},{"from":718.38,"to":719.8,"content":"哪怕到了作战的时刻"},{"from":719.8,"to":720.98,"content":"都有一个最大密度"},{"from":720.98,"to":722.16,"content":"不可能无限往上堆"},{"from":722.16,"to":723.41,"content":"飞机堆到满为止"},{"from":723.41,"to":724.13,"content":"举个例子"},{"from":724.13,"to":725.19,"content":"根据GAO的报告"},{"from":725.19,"to":728.17,"content":"哪怕是企业号在印度洋进行实战化部署的时候"},{"from":728.17,"to":730.98,"content":"每个中队减少了两架SH3直升机"},{"from":730.98,"to":733.22,"content":"以及卸载了航母上的C1A飞机"},{"from":733.22,"to":734.46,"content":"所能搭载的舰载机"},{"from":734.46,"to":736.42,"content":"在战时状态下的持续作战能力"},{"from":736.42,"to":739.3,"content":"也只不过高了不到五个百分点难点"},{"from":739.3,"to":739.9,"content":"综合起来"},{"from":739.9,"to":740.78,"content":"舰载机性能少"},{"from":740.78,"to":741.22,"content":"意味着"},{"from":741.22,"to":744.4,"content":"航母上几乎所有的任务都需要舰载机来干战斗"},{"from":744.4,"to":746.84,"content":"空中巡逻需要他干紧急起飞截击任务"},{"from":746.84,"to":748.16,"content":"需要他干对海攻击"},{"from":748.16,"to":749.38,"content":"需要他干对陆打击"},{"from":749.38,"to":750.46,"content":"也需要他干"},{"from":750.46,"to":751.9,"content":"而着舰需求的优化"},{"from":751.9,"to":754.02,"content":"低速飞行区间所造成的性能损失"},{"from":754.02,"to":756.64,"content":"其实也对于对海对陆攻击这些任务来说"},{"from":756.64,"to":758.06,"content":"其实问题也没那么大"},{"from":758.06,"to":760.1,"content":"那么最大的问题出在哪里呢"},{"from":760.1,"to":761.21,"content":"空对空作战"},{"from":761.21,"to":763.65,"content":"比如说以DOI为任务的截击任务"},{"from":763.65,"to":764.67,"content":"他要求什么呢"},{"from":764.67,"to":765.73,"content":"以最快的速度"},{"from":765.73,"to":767.81,"content":"最短的飞行时间飞到交战空域来"},{"from":767.81,"to":769.2,"content":"把来袭的目标记录"},{"from":769.2,"to":771.4,"content":"自然啊是需要高速飞行性能的"},{"from":771.4,"to":773.72,"content":"或者说长时间的高速飞行性能"},{"from":773.72,"to":775.08,"content":"而偏偏与之矛盾的"},{"from":775.08,"to":776.52,"content":"就是航母起降所需要的"},{"from":776.52,"to":778.5,"content":"低速飞行性能和低速操控性"},{"from":778.5,"to":779.94,"content":"从学术上来讲的话"},{"from":779.94,"to":781.84,"content":"这两项性能要求的非常极端"},{"from":781.84,"to":783.58,"content":"一个位于包线的最右端"},{"from":783.58,"to":785.24,"content":"一个位于包线的最左端"},{"from":785.24,"to":787.92,"content":"这一点在设计上非常难以兼顾"},{"from":787.92,"to":789.52,"content":"我们以侧卫家族为例"},{"from":789.52,"to":790.56,"content":"舰载型的苏三三"},{"from":790.56,"to":792.16,"content":"因为采用了前翼增升装置"},{"from":792.16,"to":793.78,"content":"所带来的额外诱导阻力"},{"from":793.78,"to":795.93,"content":"导致其高速性能显著下降"},{"from":795.93,"to":798.21,"content":"高空最大马赫数降至2.17"},{"from":798.21,"to":801.19,"content":"海平面最大飞行速度降到1300km每小时"},{"from":801.19,"to":802.81,"content":"若携带典型的作战挂载"},{"from":802.81,"to":804.65,"content":"则会掉到1200km每小时"},{"from":804.65,"to":806.47,"content":"当然啊侧位有一点好"},{"from":806.47,"to":807.07,"content":"内又多"},{"from":807.07,"to":808.35,"content":"不需要挂载副油箱"},{"from":808.35,"to":809.56,"content":"只需要挂弹即可"},{"from":809.56,"to":812.14,"content":"而且侧背还有个机腹的低压低阻区"},{"from":812.14,"to":813.56,"content":"所以在挂弹拦截任务中"},{"from":813.56,"to":815.22,"content":"实际上用起来啊还算不错"},{"from":815.22,"to":816.66,"content":"我们甚至可以绿皮的说"},{"from":816.66,"to":817.66,"content":"这架飞机足够大"},{"from":817.66,"to":818.26,"content":"足够暴力"},{"from":818.26,"to":818.82,"content":"可以力大"},{"from":818.82,"to":820.49,"content":"飞船增加了一堆潜翼"},{"from":820.49,"to":822.01,"content":"阻力大了没关系没关系"},{"from":822.01,"to":823.01,"content":"反正内油够多"},{"from":823.01,"to":823.99,"content":"不用挂副油箱"},{"from":823.99,"to":825.65,"content":"空空挂载就是干净挂载"},{"from":825.65,"to":827.85,"content":"杰洛发推特底加力硬怼就是了"},{"from":827.85,"to":830.09,"content":"空战的能量特性下降也没关系"},{"from":830.09,"to":831.09,"content":"载弹量量大不行"},{"from":831.09,"to":833,"content":"我就去挂远程空对空导弹吗"},{"from":833,"to":835.18,"content":"反正有一米巨大雷达罩和巨大的雷达"},{"from":835.18,"to":835.64,"content":"了不起"},{"from":835.64,"to":836.44,"content":"武器空战启动"},{"from":836.44,"to":838.51,"content":"把对方挨个排队枪毙就是了"},{"from":838.51,"to":840.21,"content":"那么谁难受呢"},{"from":840.21,"to":842.45,"content":"哎这里还是请一下我们的老朋友啊"},{"from":842.45,"to":844.26,"content":"发18EF大虫子"},{"from":844.26,"to":847.1,"content":"JLL执行DOI任务的时候得挂副油箱"},{"from":847.1,"to":849,"content":"翼下挂架是个外八字形"},{"from":849,"to":850.56,"content":"相当于自带减速板"},{"from":850.56,"to":853.58,"content":"虫子呢在经典的DOI任务的挂载情况下"},{"from":853.58,"to":855.31,"content":"两中两进三个副油箱"},{"from":855.31,"to":857.15,"content":"在4万英尺的高空飞行员"},{"from":857.15,"to":858.51,"content":"就算把迪Q多发推到底"},{"from":858.51,"to":861.75,"content":"油门加到底也只能以1.4马赫的速度赶路"},{"from":861.75,"to":862.83,"content":"这么慢的速度"},{"from":862.83,"to":865.77,"content":"其实也反映了当前舰载机设计的矛盾之处"},{"from":865.77,"to":866.63,"content":"众所周知"},{"from":866.63,"to":867.89,"content":"飞机在气动设计上"},{"from":867.89,"to":871.01,"content":"几乎很难实现从低速到高速的全面性能优化"},{"from":871.01,"to":872.89,"content":"而舰载机起降时的小迎角"},{"from":872.89,"to":874.53,"content":"低空低速性能是刚需"},{"from":874.53,"to":875.41,"content":"或者这么说"},{"from":875.41,"to":878.569,"content":"通常只能会着重优化一个速度区间的飞行性能"},{"from":878.569,"to":880.409,"content":"比如说战斗空中巡逻"},{"from":880.409,"to":881.469,"content":"也就是CAP"},{"from":881.469,"to":883.969,"content":"这活儿呢就要求舰载机以一定的速度"},{"from":883.969,"to":885.56,"content":"长时间在空中滞空"},{"from":885.56,"to":887.94,"content":"这里有一个互联网中的认知误区"},{"from":887.94,"to":889.76,"content":"当前互联网评价一架舰载机"},{"from":889.76,"to":891.64,"content":"执行cap任务的能力的时候"},{"from":891.64,"to":893.589,"content":"往往只考虑其滞空时间"},{"from":893.589,"to":896.669,"content":"其实呢就是大伙