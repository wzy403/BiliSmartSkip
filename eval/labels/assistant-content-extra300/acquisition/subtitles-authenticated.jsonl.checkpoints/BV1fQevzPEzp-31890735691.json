.99,"content":"在这种情况下"},{"from":1458.99,"to":1461.59,"content":"舰载机需要的不再是舰队里的辛勤工蚁"},{"from":1461.59,"to":1463.88,"content":"只需要把导弹从A搬到B就行"},{"from":1463.88,"to":1466.24,"content":"此时需要的是一个真正的舰队后卫"},{"from":1466.24,"to":1467.389,"content":"一个控球后卫"},{"from":1467.389,"to":1468.389,"content":"所以对于舰载机"},{"from":1468.389,"to":1470.189,"content":"我们还是以外媒的话来收尾吧"},{"from":1470.189,"to":1473.14,"content":"目前在很多地区冲突的风险已经非常高了"},{"from":1473.14,"to":1474.3,"content":"在未来的冲突中"},{"from":1474.3,"to":1476.94,"content":"谁能够最快速的整合跨区域的指挥力量"},{"from":1476.94,"to":1479.06,"content":"直接就能够拥有决定性的优势"},{"from":1479.06,"to":1482.32,"content":"歼三五从设计一开始就是为了抓住这一优势的"},{"from":1482.32,"to":1484.1,"content":"目前它是中国最雄心勃勃"},{"from":1484.1,"to":1485.52,"content":"也是最象征明显的"},{"from":1485.52,"to":1488.58,"content":"中国不仅仅要在五代机的领域上赶上西方"},{"from":1488.58,"to":1490.48,"content":"并且很快就要超越西方"},{"from":1490.48,"to":1492.14,"content":"如果量产按计划进行"},{"from":1492.14,"to":1495.4,"content":"那么歼三五很可能成为中国崛起的决定性战机"},{"from":1495.4,"to":1496.68,"content":"并在未来几十年里"},{"from":1496.68,"to":1499.159,"content":"成为决定西太制空权的关键因素"},{"from":1499.159,"to":1501.699,"content":"相信各位很快就能看到歼三五的奇迹"},{"from":1501.699,"to":1504.28,"content":"只是我们空军海军的一个起点"},{"from":1504.28,"to":1504.8,"content":"好了"},{"from":1504.8,"to":1505.7,"content":"感谢各位观看"},{"from":1505.7,"to":1507.08,"content":"喜欢更多航母知识的话"},{"from":1507.08,"to":1508.68,"content":"欢迎来到橘猫的主页看看"},{"from":1508.68,"to":1509.72,"content":"没有三连的话"},{"from":1509.72,"to":1511.1,"content":"麻烦各位点点三连"},{"from":1511.1,"to":1512.42,"content":"当然播放点赞越多"},{"from":1512.42,"to":1513.18,"content":"更新就越快"},{"from":1513.18,"to":1514.06,"content":"谢谢各位"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:05:13.772Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:05:10.904Z"}}
