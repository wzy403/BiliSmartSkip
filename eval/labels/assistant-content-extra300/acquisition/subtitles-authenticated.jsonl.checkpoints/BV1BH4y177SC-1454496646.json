{"schemaVersion":1,"bvid":"BV1BH4y177SC","cid":1454496646,"subtitles":[{"from":3.979,"to":8.329,"content":"有网友发现这个不锈钢盆子在雪地上原地滚动"},{"from":8.329,"to":10.8,"content":"同时还绕着接地点旋转"},{"from":14.319,"to":16.139,"content":"而这辆摩托车侧翻"},{"from":16.139,"to":19.3,"content":"摔倒后竟驴打滚站起来自行前进"},{"from":19.3,"to":22.15,"content":"有人说这是由于地球服务器存在bug"},{"from":22.15,"to":25.299,"content":"但更多人认为这些现象具有物理原因"},{"from":25.299,"to":27.999,"content":"说话间只见一个人头顶狗喷子"},{"from":27.999,"to":29.58,"content":"骑着摩托车过来了"},{"from":29.58,"to":31.02,"content":"原来是铲屎官"},{"from":31.02,"to":33.84,"content":"某萌老师正好让他来分析分析"},{"from":33.84,"to":34.62,"content":"同学们"},{"from":34.62,"to":35.46,"content":"如图所示"},{"from":35.46,"to":37.09,"content":"这是我家大黄的饭盆"},{"from":37.09,"to":39.01,"content":"现在让它旋转并掉落"},{"from":39.01,"to":40.96,"content":"就可看成下坠中的陀螺"},{"from":40.96,"to":42.55,"content":"因其具有自稳特性"},{"from":42.55,"to":44.05,"content":"边缘会首先触地"},{"from":44.05,"to":45.55,"content":"在雪地砸出凹坑"},{"from":45.55,"to":47.02,"content":"于是盆子陷入坑里"},{"from":47.02,"to":50.36,"content":"打滑步前由于地面支持力并不穿过重心"},{"from":50.36,"to":52.82,"content":"又可看成将该陀螺一端吊起"},{"from":52.82,"to":54.08,"content":"而另一端悬空"},{"from":54.08,"to":57.46,"content":"那么重力矩不仅使自转轴出现倾斜趋势"},{"from":57.46,"to":59.8,"content":"还沿着自转方向旋转90度"},{"from":59.8,"to":61.099,"content":"产生推动效果"},{"from":61.099,"to":63.379,"content":"驱动盆子绕数轴旋转起来"},{"from":63.379,"to":65.209,"content":"也就是出现了进动效应"},{"from":65.209,"to":66.4,"content":"正是由于进动"},{"from":66.4,"to":70.34,"content":"才让陀螺获得了和重力局等大反向的回转力矩"},{"from":70.34,"to":71.39,"content":"以保持不倒"},{"from":71.39,"to":74,"content":"由于回转力矩等于进动角速度"},{"from":74,"to":75.32,"content":"呈自旋角速度"},{"from":75.32,"to":77.92,"content":"再乘陀螺对自转轴的转动惯量"},{"from":77.92,"to":79.3,"content":"因此随着地面摩擦"},{"from":79.3,"to":81.37,"content":"造成盆子转速不断衰减"},{"from":81.37,"to":83.92,"content":"回转力矩会逐渐小于重力矩"},{"from":83.92,"to":85.57,"content":"导致盆子慢慢倾倒"},{"from":85.57,"to":86.08,"content":"躺平"},{"from":86.08,"to":88.87,"content":"如果把狗盆子换成异端悬挂的车轮"},{"from":88.87,"to":90.25,"content":"也是相同的情况"},{"from":90.25,"to":92.02,"content":"起初车轮绕竖直轴进动"},{"from":92.02,"to":95.14,"content":"所产生的回转力矩能够维持轴线水平"},{"from":95.14,"to":96.7,"content":"但转速不断衰减"},{"from":96.7,"to":98.8,"content":"回转力矩就不敌重力矩"},{"from":98.8,"to":100.9,"content":"于是像狗盆子一样躺平"},{"from":100.9,"to":102.82,"content":"通过萌萌老师的演示"},{"from":102.82,"to":105.61,"content":"我意识到站在雪地里看他比比划划"},{"from":105.61,"to":107.6,"content":"真不如躺在家里刷手机"},{"from":107.6,"to":109.1,"content":"但换季皮肤干痒"},{"from":109.1,"to":110.24,"content":"起皮糖久了"},{"from":110.24,"to":111.14,"content":"后背爱出油"},{"from":111.14,"to":111.8,"content":"还黏腻"},{"from":111.8,"to":112.88,"content":"爆痘可咋整"},{"from":112.88,"to":113.6,"content":"当然是用"},{"from":113.6,"to":116.98,"content":"这款某猫销量60万平的赫恩极地沐浴露"},{"from":116.98,"to":118.24,"content":"经广微测检测"},{"from":118.24,"to":120.64,"content":"其除螨抑菌率大于99%"},{"from":120.64,"to":122.5,"content":"还拥有五重专利成分"},{"from":122.5,"to":125.32,"content":"每天用一能够洗掉前胸后背的痘痘"},{"from":125.32,"to":127.42,"content":"轻松洗出丝滑的男声背"},{"from":127.42,"to":130.03,"content":"而且冲掉泡沫后还特别好搓泥"},{"from":130.03,"to":133.11,"content":"采用的护肤及配方12种保湿成分"},{"from":133.11,"to":135.12,"content":"搭配15重氨基酸复配"},{"from":135.12,"to":137.4,"content":"洗完之后身体乳都不用涂了"},{"from":137.4,"to":139.56,"content":"不但杰夫护肤更上一层楼"},{"from":139.56,"to":141.18,"content":"更是香水级的沐浴露"},{"from":141.18,"to":143.22,"content":"一觉醒来被窝都是香的"},{"from":143.22,"to":144.78,"content":"挤出来是檀香木"},{"from":144.78,"to":147.24,"content":"夹杂着雪松干燥冷冽的香气"},{"from":147.24,"to":150.64,"content":"并随着体温发散出层层递进的花果香"},{"from":150.64,"to":152.96,"content":"如同阳光覆盖在雪松枝桠"},{"from":152.96,"to":153.86,"content":"沉稳温暖"},{"from":153.86,"to":155.72,"content":"给女声满满的安全感"},{"from":155.72,"to":159.26,"content":"而且这一瓶500克大容量足够用大半年"},{"from":159.26,"to":162.88,"content":"评论区领专属优惠券组合购买更划算"},{"from":162.88,"to":163.66,"content":"说到这里"},{"from":163.66,"to":166.06,"content":"我突然想起来开头提到摩托车"},{"from":166.06,"to":166.76,"content":"驴打滚"},{"from":166.76,"to":167.84,"content":"扔下赛车手"},{"from":167.84,"to":171.579,"content":"自己前进是否也和陀螺的特性有关呢"},{"from":171.579,"to":172.629,"content":"确实如此"},{"from":172.629,"to":173.889,"content":"从慢放画面看"},{"from":173.889,"to":175.899,"content":"摩托车过弯时操控不当"},{"from":175.899,"to":176.769,"content":"剧烈摇摆"},{"from":176.769,"to":178.8,"content":"将棋手抛向弯道外侧"},{"from":178.8,"to":180.78,"content":"车身则被离心作用推动"},{"from":180.78,"to":181.56,"content":"快速侧翻"},{"from":181.56,"to":183.38,"content":"获得较大的横滚动能"},{"from":183.38,"to":184.82,"content":"随后车身抬起"},{"from":184.82,"to":185.69,"content":"车头撞地"},{"from":185.69,"to":187.28,"content":"开始底朝天横滚"},{"from":187.28,"to":188.51,"content":"在这种情况下"},{"from":188.51,"to":190.91,"content":"摩托车一边沿切线方向滑动"},{"from":190.91,"to":192.16,"content":"一边做驴打滚"},{"from":192.16,"to":193.18,"content":"直觉告诉我们"},{"from":193.18,"to":194.8,"content":"如果横滚动能不足"},{"from":194.8,"to":196.62,"content":"则车身向右侧躺平"},{"from":196.62,"to":198.12,"content":"而横滚动能过大"},{"from":198.12,"to":200.24,"content":"则站起后又向左侧躺平"},{"from":200.24,"to":201.38,"content":"总之会躺倒"},{"from":201.38,"to":203.09,"content":"并沿切线划出弯道"},{"from":203.09,"to":205.22,"content":"但如果考虑陀螺的进动效应"},{"from":205.22,"to":205.9,"content":"就会发现"},{"from":205.9,"to":208.579,"content":"只要车身横滚的转动动能足够大"},{"from":208.579,"to":211.099,"content":"可使轮子触地后重新站立起来"},{"from":211.099,"to":212.239,"content":"那么站立过程中"},{"from":212.239,"to":216.019,"content":"前轮的自转轴就会从上下方向向左右方向转动"},{"from":216.019,"to":217.68,"content":"通过上一个案例可知"},{"from":217.68,"to":220.2,"content":"由于轮轴不断被前叉推动偏转"},{"from":220.2,"to":222.62,"content":"使这个正在旋转的金属陀螺"},{"from":222.62,"to":225.11,"content":"受到了向树立方向旋转的力矩"},{"from":225.11,"to":228.68,"content":"而这个附加力矩会朝着向前旋转90度的方向"},{"from":228.68,"to":229.92,"content":"产生推动效果"},{"from":229.92,"to":231.75,"content":"使车轮向左进动旋转"},{"from":231.75,"to":233.37,"content":"这个动作相当关键"},{"from":233.37,"to":235.72,"content":"它使车身沿左转弧线运动"},{"from":235.72,"to":238.03,"content":"使重心受到向右的离心作用"},{"from":238.03,"to":240.34,"content":"从而抑制了车身继续左横滚"},{"from":246.369,"to":249.8,"content":"期间前叉一边靠稳定局自行转舵回中"},{"from":251.96,"to":254.48,"content":"由于该力矩依然要旋转90度"},{"from":254.48,"to":255.71,"content":"推动前轮进洞"},{"from":255.71,"to":257.78,"content":"因此车把又回到了右舵"},{"from":257.78,"to":260.38,"content":"使摩托车开始沿右转弧线运动"},{"from":260.38,"to":261.79,"content":"同时向右压重心"},{"from":261.79,"to":264.84,"content":"这样驴打滚的摩托车就通过前轮的进动"},{"from":264.84,"to":267.48,"content":"实现了先左舵推把向右压重心"},{"from":267.48,"to":268.5,"content":"再回到右舵"},{"from":268.5,"to":270.3,"content":"进入右转弯的逆舵操作"},{"from":270.3,"to":271.84,"content":"过弯不仅如此"},{"from":271.84,"to":273.55,"content":"如果重心压得不够低"},{"from":273.55,"to":274.89,"content":"车身向左偏白"},{"from":274.89,"to":277.05,"content":"就会使前轮再次发生进动"},{"from":277.05,"to":280.05,"content":"而力度推把将重心向右侧甩去"},{"from":280.05,"to":281.64,"content":"如果重心压得太低"},{"from":283.02,"to":285.24,"content":"则会使前轮反向进洞而顺"},{"from":285.24,"to":287.04,"content":"多通过增强离心作用"},{"from":287.04,"to":288.9,"content":"将重心向左侧甩去"},{"from":288.9,"to":292.76,"content":"因此无人驾驶摩托可通过前轮进洞而操作摇摆"},{"from":292.76,"to":294.62,"content":"使重心落在支持力和"},{"from":294.62,"to":296.82,"content":"侧向抓地力的合力作用线上"},{"from":296.82,"to":298.89,"content":"从而自动达到稳定姿态"},{"from":298.89,"to":302.77,"content":"然后以协调的右转弯顺着赛道扬长而去"},{"from":302.77,"to":303.79,"content":"如此看来"},{"from":303.79,"to":307.33,"content":"盆子和摩托车都是利用了陀螺进动效应"},{"from":307.33,"to":311.13,"content":"同时还暗示我自己就是这个看似转圈忙活"},{"from":311.13,"to":313.039,"content":"实则原地踏步的盆子"},{"from":313.039,"to":315.73,"content":"如果把摩托车比作我们公司"},{"from":315.73,"to":319.36,"content":"则说明不管有没有我公司一样跑得欢"},{"from":319.36,"to":321.34,"content":"那这又是什么原理呢"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:03:23.860Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:03:21.557Z"}}
