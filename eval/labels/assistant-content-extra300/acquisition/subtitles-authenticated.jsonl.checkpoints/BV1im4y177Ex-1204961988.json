{"schemaVersion":1,"bvid":"BV1im4y177Ex","cid":1204961988,"subtitles":[{"from":0.12,"to":0.78,"content":"嗨大家好"},{"from":0.78,"to":1.62,"content":"我是新雨"},{"from":1.62,"to":5.42,"content":"今天我们继续介绍二战时的日本航母机动舰队"},{"from":5.42,"to":6.08,"content":"本期视频"},{"from":6.08,"to":8.87,"content":"我们会围绕两个讨论度很高的问题进行"},{"from":8.87,"to":13.32,"content":"首先为什么如此重要的舰队要交给专业不对口"},{"from":13.32,"to":16.56,"content":"看上去能力平平的南云中医指挥呢"},{"from":16.56,"to":20.2,"content":"其次既然航空派得不到日本海海军的大力支持"},{"from":20.2,"to":22.06,"content":"那为什么日本人就想不起来"},{"from":22.06,"to":24.22,"content":"建立一支独立的空军呢"},{"from":24.22,"to":26.26,"content":"本期视频将为大家硬核详解"},{"from":26.26,"to":27.92,"content":"接下来咱们开宗明义"},{"from":27.92,"to":29.78,"content":"为什么是南云中医呢"},{"from":29.78,"to":30.75,"content":"或者这么问"},{"from":30.75,"to":34.22,"content":"航母舰队为什么不交给在航空领域作战"},{"from":34.22,"to":36.8,"content":"似乎更有研究的小泽治三郎"},{"from":36.8,"to":38.54,"content":"又或者是山口多闻呢"},{"from":38.54,"to":41.15,"content":"其实概括出来最重要的就是两个字"},{"from":41.15,"to":41.99,"content":"资历"},{"from":41.99,"to":43.79,"content":"我才看到资历这两个字"},{"from":43.79,"to":45.65,"content":"大家已经开始口诛笔伐了"},{"from":45.65,"to":47.2,"content":"但先别急着下结论"},{"from":47.2,"to":50.08,"content":"因为资历它并不代表着没有能力"},{"from":50.08,"to":51.1,"content":"而有的位置"},{"from":51.1,"to":54.5,"content":"资历本身更是能力能发挥出来的基础"},{"from":54.5,"to":57.14,"content":"能够指挥航母舰队这个事情的资历"},{"from":57.14,"to":58.64,"content":"我认为有两个方面"},{"from":58.64,"to":62.26,"content":"一是看这个人在航空作战上的履历和经历"},{"from":62.26,"to":64.48,"content":"还有就是更直接的那种资历"},{"from":64.48,"to":65.2,"content":"换而言之"},{"from":65.2,"to":66.14,"content":"排资论辈了"},{"from":66.14,"to":68.24,"content":"我把南云中医小泽治三郎"},{"from":68.24,"to":69.56,"content":"山口多闻三个人"},{"from":69.56,"to":72.14,"content":"一直到珍珠港袭击的大世纪"},{"from":72.14,"to":73.539,"content":"做了三个时间轴"},{"from":73.539,"to":75.459,"content":"起点是1912年末"},{"from":75.459,"to":76.119,"content":"在这一年"},{"from":76.119,"to":79.54,"content":"日本海军成立了海军航空署研究委员会"},{"from":79.54,"to":82.42,"content":"也首次使用了水上飞机参加了阅舰式"},{"from":82.42,"to":84.96,"content":"算是日日本海军航空队的元年了"},{"from":84.96,"to":86.7,"content":"接下来我们把这当中几位"},{"from":86.7,"to":89.34,"content":"接触航空作战领域的经历圈出来"},{"from":89.34,"to":90.64,"content":"那就非常明显"},{"from":90.64,"to":94.87,"content":"其实如果你要硬问谁最早正式接触到了航空兵"},{"from":94.87,"to":96.28,"content":"那最早的是南云啊"},{"from":96.28,"to":97.3,"content":"1933年"},{"from":97.3,"to":101.01,"content":"南云参加的这个航空站叫范起草委员会"},{"from":101.01,"to":104.52,"content":"是负责起草海军航空兵叫范材料的"},{"from":104.52,"to":105.36,"content":"当然你不能说"},{"from":105.36,"to":108.26,"content":"这就是南云起草了航空兵的指导材料"},{"from":108.26,"to":109.79,"content":"南云只是成员之一"},{"from":109.79,"to":111.86,"content":"他后来的参谋长草鹿龙之介"},{"from":111.86,"to":113.36,"content":"也在这个委员会里面"},{"from":113.36,"to":114.86,"content":"那小泽和山口"},{"from":114.86,"to":117.94,"content":"分别是在1939年和192040年"},{"from":117.94,"to":119.68,"content":"正式接触到了航空作战"},{"from":119.68,"to":123.46,"content":"但是一上手就是实际指挥战斗的指挥官了"},{"from":123.46,"to":125.82,"content":"并且当时侵华战争正在进行"},{"from":125.82,"to":127.2,"content":"所以小泽和山口"},{"from":127.2,"to":128.52,"content":"可以说是在战前"},{"from":128.52,"to":131.7,"content":"就有一定程度的指挥和实战经验了"},{"from":131.7,"to":135.32,"content":"因此这三个人南云是最先接触航空作战"},{"from":135.32,"to":138.53,"content":"但小泽和山口更早指挥过航空作战"},{"from":138.53,"to":139.64,"content":"这次做这个视频"},{"from":139.64,"to":143.3,"content":"我还发现一个细节是关于小泽和南云的"},{"from":143.3,"to":145.78,"content":"大家可以仔细看一下他俩的履历"},{"from":145.78,"to":148,"content":"有没有发现什么有意思的地方"},{"from":148,"to":150.28,"content":"我们待会儿会正式介绍到这个问题"},{"from":150.28,"to":152.59,"content":"已经发现的朋友不妨弹幕走一波"},{"from":152.59,"to":153.04,"content":"好的"},{"from":153.04,"to":156.419,"content":"我们总结一下在航空作战的履历和经历上"},{"from":156.419,"to":158.7,"content":"小泽和山口的确胜出一筹"},{"from":158.7,"to":161.22,"content":"这个事不仅我们今天梳理得很清楚"},{"from":161.22,"to":164.12,"content":"当时的日本海军不少人其实也是知道的"},{"from":164.12,"to":166.58,"content":"然而这没办法影响最终的结果"},{"from":166.58,"to":170.2,"content":"更硬性的谈资论辈才是一锤定音的因素"},{"from":170.2,"to":172.48,"content":"大家知道日本是啥领域"},{"from":172.48,"to":173.72,"content":"都要排资论辈"},{"from":173.72,"to":176.66,"content":"小智从绿毛虫开始收服的宝可梦"},{"from":176.66,"to":178.22,"content":"见到皮卡丘不鞠个躬"},{"from":178.22,"to":179.36,"content":"我都觉得不合理"},{"from":179.36,"to":181.06,"content":"那海军这里还了得"},{"from":181.06,"to":183.16,"content":"就日本海军资历怎么排呢"},{"from":183.16,"to":186.72,"content":"就看你在江田岛海军兵学校是第几期的"},{"from":186.72,"to":189.09,"content":"军队里的位置从高到低"},{"from":189.09,"to":191.74,"content":"海军兵学校的前辈们坐高位"},{"from":191.74,"to":193.09,"content":"后辈做低位"},{"from":193.09,"to":195.04,"content":"只有前辈进一步升迁"},{"from":195.04,"to":198.46,"content":"退了或者挂了后背才有可能往前走"},{"from":198.46,"to":200.41,"content":"我们结合一张图具体看看"},{"from":200.41,"to":202.99,"content":"以下是太平洋战争开始之时"},{"from":202.99,"to":205.63,"content":"海军还有联合舰队的主要编制"},{"from":205.63,"to":207.16,"content":"以及他们的指挥官"},{"from":207.16,"to":208.6,"content":"这当中军令部长"},{"from":208.6,"to":209.5,"content":"海军大臣"},{"from":209.5,"to":210.64,"content":"联合舰队司令"},{"from":210.64,"to":213.36,"content":"被人们称之为海军的三驾马车"},{"from":213.36,"to":216.12,"content":"可以说是最重要地位最高的位置了"},{"from":216.12,"to":218.52,"content":"其次是四个镇守府的编制"},{"from":218.52,"to":220.02,"content":"这四个镇守府当中"},{"from":220.02,"to":222.78,"content":"又以横须贺和吴镇守府最重要"},{"from":222.78,"to":224.56,"content":"接下来六支所属舰队"},{"from":224.56,"to":227.98,"content":"两支航空舰队和一个未执行南进计划"},{"from":227.98,"to":230.02,"content":"刚刚组建的南遣舰队"},{"from":230.02,"to":231.94,"content":"这当中部署兵力最强"},{"from":231.94,"to":234.34,"content":"主要由战列舰和重巡组成的"},{"from":234.34,"to":236.38,"content":"第一和第二舰队地位最高"},{"from":236.38,"to":237.6,"content":"两支航空舰队"},{"from":237.6,"to":239.46,"content":"因为航空作战的重要性"},{"from":239.46,"to":242.46,"content":"地位可能也要比34556舰队要高一些"},{"from":242.46,"to":243.96,"content":"这个序列明确以后"},{"from":243.96,"to":247.56,"content":"接下来我把这些指挥官是海军兵学校几期的"},{"from":247.56,"to":249.94,"content":"还有他们的毕业成绩都是第几名"},{"from":249.94,"to":252.63,"content":"全查了标上来供大家享用"},{"from":252.63,"to":255.5,"content":"请看是不是规律非常明显"},{"from":255.5,"to":257,"content":"一个萝卜一个坑"},{"from":257,"to":260.5,"content":"就是按照连续排出来的更高的位置"},{"from":260.5,"to":263.6,"content":"更重要的坑一定是那个更早一期"},{"from":263.6,"to":265.97,"content":"海军兵学校的前辈蹲着"},{"from":265.97,"to":268.64,"content":"随后所有人就这么一点点往上挪"},{"from":268.64,"to":271.34,"content":"小泽其实年龄还比南云大一岁"},{"from":271.34,"to":273.8,"content":"但是因为在江田岛是后一期的"},{"from":273.8,"to":275.9,"content":"这个更重要的第一航空舰队"},{"from":275.9,"to":277.88,"content":"就不可能是由他指挥的"},{"from":277.88,"to":278.84,"content":"或者我这么说"},{"from":278.84,"to":281.68,"content":"1941年不该是他可以后"},{"from":281.68,"to":282.66,"content":"多半是他"},{"from":282.66,"to":283.44,"content":"为什么呢"},{"from":283.44,"to":286.14,"content":"记得我说这个图有个有趣的细节吗"},{"from":286.14,"to":287.76,"content":"不知道大家是否有发现"},{"from":287.76,"to":290.85,"content":"小泽和南云在1930年以后"},{"from":290.85,"to":295.86,"content":"很多岗位的履历上是就还不是说履历是类似的"},{"from":295.86,"to":296.94,"content":"大量重要的位置"},{"from":296.94,"to":298.62,"content":"就是前后脚的关系"},{"from":298.62,"to":300.7,"content":"并且所有相同的岗位"},{"from":300.7,"to":303.42,"content":"上任时间相差基本就是一年"},{"from":303.42,"to":305.7,"content":"这保持了他们在海军兵学校"},{"from":305.7,"to":307.8,"content":"期数差一年的客观情况"},{"from":307.8,"to":308.98,"content":"咱们继续往后画"},{"from":308.98,"to":310.06,"content":"1942年"},{"from":310.06,"to":314.08,"content":"日本海军重编了以航母舰队为核心的第三舰队"},{"from":314.08,"to":317.26,"content":"这是瓜岛系列第四期我们详细介绍过的"},{"from":317.26,"to":319.48,"content":"南云是这支舰队的首任指挥"},{"from":319.48,"to":320.56,"content":"随后11月"},{"from":320.56,"to":322.3,"content":"南云被调离了这个岗位"},{"from":322.3,"to":325.44,"content":"有人认为是几场海战没有取得决定性的胜利"},{"from":325.44,"to":326.76,"content":"又或者是他的指挥"},{"from":326.76,"to":329.26,"content":"让联合舰队蒙受了巨大的损失等等"},{"from":329.26,"to":330.94,"content":"但是你看级别上"},{"from":330.94,"to":332.32,"content":"或者说习惯上"},{"from":332.32,"to":334.12,"content":"南云其实算是升职了"},{"from":334.12,"to":336.88,"content":"第2年甚至做了吴镇守府的长官"},{"from":336.88,"to":338.86,"content":"而他把航母交接给谁了"},{"from":338.86,"to":340.76,"content":"正是小泽治三郎"},{"from":340.76,"to":342.02,"content":"有意料之外吗"},{"from":342.02,"to":343.7,"content":"更多的是情理之中吧"},{"from":343.7,"to":345.419,"content":"大家说这死板嘛"},{"from":345.419,"to":347.369,"content":"最死板的可能还不算这个"},{"from":347.369,"to":349.349,"content":"因为还有一条规则"},{"from":349.349,"to":352.829,"content":"他在为这个论资排辈体系保驾护航"},{"from":352.829,"to":356.03,"content":"叫后辈永远不能指挥前辈"},{"from":356.03,"to":356.81,"content":"举个例子"},{"from":356.81,"to":358.73,"content":"比如海军军令部长永野"},{"from":358.73,"to":359.57,"content":"还有海象"},{"from":359.57,"to":361.49,"content":"两个人看山本56不顺眼"},{"from":361.49,"to":362.57,"content":"想把他给换了"},{"from":362.57,"to":364.14,"content":"直接在1941年"},{"from":364.14,"to":367.68,"content":"让航空专家小泽治三郎来指挥联合舰队"},{"from":367.68,"to":368.46,"content":"可不可以"},{"from":368.46,"to":369.9,"content":"理论上可以"},{"from":369.9,"to":372.59,"content":"但他一个后辈不能指挥前辈"},{"from":372.59,"to":375.89,"content":"小泽一个37期的人要当总司令"},{"from":375.89,"to":377.63,"content":"那就得让他的前辈们"},{"from":377.63,"to":382.29,"content":"三十五三十六期的调任转预备役来给他让位置"},{"from":382.29,"to":385.63,"content":"而换上来的人必须要比小泽毕业时间晚"},{"from":385.63,"to":387.73,"content":"得是38~39期"},{"from":387.73,"to":388.6,"content":"这样才行"},{"from":388.6,"to":390.13,"content":"大家说离谱吗"},{"from":390.13,"to":393.4,"content":"那战争后期小泽确实当了联合舰队司令"},{"from":393.4,"to":395.28,"content":"就出现了类似的情况"},{"from":395.28,"to":395.94,"content":"说到这里"},{"from":395.94,"to":396.78,"content":"大家发现没"},{"from":396.78,"to":397.92,"content":"南云的后辈"},{"from":397.92,"to":399.9,"content":"也就是37期的小泽"},{"from":399.9,"to":401.51,"content":"47的山口多闻"},{"from":401.51,"to":404.57,"content":"是绝对不可能与他竞争这个位置的"},{"from":404.57,"to":407.36,"content":"能与他竞争的其实只有他的同辈"},{"from":407.36,"to":410.96,"content":"也就是同为海军兵学校36期毕业的人"},{"from":410.96,"to":415.18,"content":"而这当中21年就任横须贺海军航空队之后"},{"from":415.18,"to":416.59,"content":"先后在凤翔号"},{"from":416.59,"to":417.82,"content":"赤城号上服役"},{"from":417.82,"to":419.56,"content":"比山口和小泽更早"},{"from":419.56,"to":423.12,"content":"实际指挥海军航空队的中援234哦"},{"from":423.12,"to":425.96,"content":"不冢原243这名字怎么回事"},{"from":425.96,"to":427.16,"content":"是锁屏密码吗"},{"from":427.16,"to":430.68,"content":"他才是这个岗位好毫无疑问的候选者"},{"from":430.68,"to":432.76,"content":"然而高能来袭"},{"from":432.76,"to":436.52,"content":"英勇的中国空军和苏联援华航空志愿队"},{"from":436.52,"to":438.44,"content":"在1939年10月"},{"from":438.44,"to":442.28,"content":"对当时日军控制的汉口机场进行了突然袭击"},{"from":442.28,"to":444.59,"content":"击毁日机50~60架"},{"from":444.59,"to":446,"content":"炸伤了这个种源"},{"from":446,"to":447.62,"content":"让他失去了左臂"},{"from":447.62,"to":452,"content":"被认定为无法继续出海进行对勤务工作"},{"from":452,"to":455.12,"content":"因此最后的最后只能找到这个宇航空站"},{"from":455.12,"to":459.48,"content":"几乎没有任何交集的南云来接盘这支航母舰队"},{"from":459.48,"to":462.88,"content":"这里我们要向这些守卫祖国蓝天的英雄"},{"from":462.88,"to":465.16,"content":"和苏联援华航空队致敬"},{"from":465.16,"to":467.659,"content":"抗日英雄永垂不朽"},{"from":467.659,"to":468.379,"content":"好的"},{"from":468.379,"to":469.639,"content":"所以现在是没办法"},{"from":469.639,"to":470.899,"content":"只能是南云了"},{"from":470.899,"to":473.7,"content":"可是他确实缺乏航空军事怎么办"},{"from":473.7,"to":477.75,"content":"日本海军于是给南云派了几位航空领域的参谋"},{"from":477.75,"to":478.74,"content":"草鹿龙之介"},{"from":478.74,"to":482.02,"content":"原田实两位对航空作战更了解的参谋"},{"from":482.02,"to":484.42,"content":"加入了这支航母舰队的指挥团队"},{"from":484.42,"to":486.04,"content":"尤其是原田实"},{"from":486.04,"to":488.06,"content":"他还是山本56的心腹"},{"from":488.06,"to":489.44,"content":"所以这也可以看作是"},{"from":489.44,"to":492.32,"content":"山本对这支最重要舰队的一种控制"},{"from":492.32,"to":493.58,"content":"好了说了这么多"},{"from":493.58,"to":496.16,"content":"合着南云除了资历没优点了吗"},{"from":496.16,"to":499.99,"content":"有第一听说南云这个人性格比较好"},{"from":499.99,"to":502.12,"content":"也比较尊重参谋的建议"},{"from":502.12,"to":504.01,"content":"甚至原田他提的方案"},{"from":504.01,"to":506,"content":"南云基本是照单全收"},{"from":506,"to":509.98,"content":"所以也有人直接把这支舰队称之为原田径队的"},{"from":509.98,"to":512.46,"content":"而且相对小泽山口的指挥风格"},{"from":512.46,"to":514.56,"content":"南云也的确更稳健一些"},{"from":514.56,"to":516.87,"content":"不会做出什么突发奇想的决策"},{"from":516.87,"to":518.58,"content":"第二其实我觉得更重要"},{"from":518.58,"to":522.539,"content":"就是南云熟悉大舰队的航海与指挥调度"},{"from":522.539,"to":524.909,"content":"航母舰队不是只有航母"},{"from":524.909,"to":525.779,"content":"航母作战"},{"from":525.779,"to":527.58,"content":"更不是只有飞机作战"},{"from":527.58,"to":529.74,"content":"我们以珍珠港袭击为参照"},{"from":529.74,"to":531.96,"content":"你能够突袭成功固然重要"},{"from":531.96,"to":535.26,"content":"但前提是你得把舰队开到夏威夷附近"},{"from":535.26,"to":539.89,"content":"要在一个陌生的气候恶劣的航线上超长程航行"},{"from":539.89,"to":540.97,"content":"在这个过程中"},{"from":540.97,"to":543.82,"content":"要保证自己的补给不会遇到任何问题"},{"from":543.82,"to":545.92,"content":"还得保证不被美国人发现"},{"from":545.92,"to":546.67,"content":"平心而论"},{"from":546.67,"to":548.68,"content":"这绝对不是一个简单的事情"},{"from":548.68,"to":551.599,"content":"而这种业务能力南云是很在行的"},{"from":551.599,"to":553.849,"content":"因此我同意一个日本海军军官"},{"from":553.849,"to":556.339,"content":"后来战后他也成为了航字的将领"},{"from":556.339,"to":557.16,"content":"奥公正母"},{"from":557.16,"to":558.51,"content":"他的这么一段描述"},{"from":558.51,"to":562.48,"content":"把珍珠港袭击的成功全部归结于山本和"},{"from":562.48,"to":565.839,"content":"把中途岛的失败责任全部归结于南云"},{"from":565.839,"to":567.639,"content":"这本身就是矛盾的"},{"from":567.639,"to":568.539,"content":"有道理啊"},{"from":568.539,"to":569.859,"content":"我们想是不是这样呢"},{"from":569.859,"to":571.58,"content":"因此为什么是南云"},{"from":571.58,"to":573.65,"content":"我用这个方式来为大家总结"},{"from":573.65,"to":577.779,"content":"因为他要指挥的是日本航母舰队"},{"from":577.779,"to":579.77,"content":"首先舰队是日本的"},{"from":579.77,"to":581.96,"content":"所以就得排资论辈这么走"},{"from":581.96,"to":584.09,"content":"而现在刚好轮到了南云"},{"from":584.09,"to":585.95,"content":"这届还没轮到小泽"},{"from":585.95,"to":587.78,"content":"更没有轮到山口多闻"},{"from":587.78,"to":589.37,"content":"其次航母"},{"from":589.37,"to":593.09,"content":"按理说同届的种源是更合适这个位置的"},{"from":593.09,"to":595.07,"content":"但是因伤退出了竞争"},{"from":595.07,"to":596.339,"content":"那么只能换人"},{"from":596.339,"to":598.859,"content":"舰队于是找到了谨慎的南云"},{"from":598.859,"to":600.239,"content":"一是宝贵的航母"},{"from":600.239,"to":602.129,"content":"给谨慎的将领他们放心"},{"from":602.129,"to":604.89,"content":"二是航空领域的