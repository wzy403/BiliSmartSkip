{"schemaVersion":1,"bvid":"BV1cYe4zLE55","cid":31868456371,"subtitles":[{"from":0.12,"to":0.56,"content":"Hello"},{"from":0.56,"to":1.04,"content":"大家好"},{"from":1.04,"to":2.66,"content":"好久没有这么打招呼了"},{"from":2.66,"to":5.38,"content":"先来跟我一起做一顿美味的菌子大餐吧"},{"from":5.38,"to":6.74,"content":"开火取锅热油"},{"from":6.74,"to":10.18,"content":"下姜片和葱白炒香后就可以直接下鸡块了"},{"from":10.18,"to":12.16,"content":"我这里用的是半只乌鸡块"},{"from":12.16,"to":12.6,"content":"翻炒"},{"from":12.6,"to":14.7,"content":"翻炒后可以加一些料酒增香"},{"from":14.7,"to":16.32,"content":"炒过的鸡肉再去炖汤"},{"from":16.32,"to":17.86,"content":"我觉得会更香醇一些"},{"from":17.86,"to":19.66,"content":"翻炒到鸡肉全部变色后"},{"from":19.66,"to":23.56,"content":"就可以转移到砂锅或者铸铁锅里啦"},{"from":25.02,"to":27.02,"content":"一次性要把水量加够"},{"from":27.02,"to":28.88,"content":"接着就可以开大火到沸腾"},{"from":28.88,"to":30.26,"content":"捞去表面的浮沫后"},{"from":30.26,"to":32.78,"content":"就可以开小火慢慢炖着啦"},{"from":35.54,"to":37.6,"content":"接着来处理一下今天的主角"},{"from":37.6,"to":39.16,"content":"又到了每年的菌子季"},{"from":39.16,"to":41.58,"content":"不知道今年有没有机会去云南摘菌子"},{"from":41.58,"to":43.52,"content":"有没有云南的小伙伴推荐一下"},{"from":43.52,"to":46.2,"content":"我最近想去云南的心情愈发强烈"},{"from":46.2,"to":49.26,"content":"最好是用陶瓷刀来把松茸表面的泥土削掉"},{"from":49.26,"to":52.06,"content":"表面的泥土可以用湿厨房纸慢慢的擦拭"},{"from":52.06,"to":55.22,"content":"其实我也不是很清楚我处理松茸的方式对不对"},{"from":55.22,"to":57.14,"content":"但是肉眼可见的没什么土了"},{"from":57.14,"to":59.24,"content":"对我来说就是可以吃的程度了"},{"from":59.24,"to":62.71,"content":"切片备用后就可以来准备做焖饭啦"},{"from":69.84,"to":70.8,"content":"水锅热油"},{"from":70.8,"to":72.58,"content":"直接下洗干净的排骨"},{"from":72.58,"to":74.22,"content":"再来几颗蒜粒增香"},{"from":74.22,"to":76.96,"content":"翻炒至排骨和蒜粒的表面全都金黄"},{"from":76.96,"to":79.9,"content":"就可以下提前准备好的胡萝卜丁"},{"from":81.4,"to":82.82,"content":"继续翻炒翻炒"},{"from":82.82,"to":84.48,"content":"加入适量切好的松茸"},{"from":84.48,"to":86,"content":"继续翻炒"},{"from":87.809,"to":90.569,"content":"炒到已经快要忍不住对着锅吃起来的时候"},{"from":90.569,"to":93.729,"content":"就可以把排骨转移到电饭锅里了"},{"from":96.14,"to":97.46,"content":"加入没过米饭"},{"from":97.46,"to":99.62,"content":"大概一个指关节不到的水量后"},{"from":99.62,"to":100.88,"content":"就可以盖盖焖煮啦"},{"from":100.88,"to":102.58,"content":"在焖煮前我深思熟虑"},{"from":102.58,"to":104.67,"content":"还是决定加了一把小腊肠丁"},{"from":104.67,"to":107.07,"content":"焖饭还是不能没有灵魂腊肠"},{"from":107.07,"to":108.87,"content":"接着就是盖盖等待啦"},{"from":108.87,"to":111.84,"content":"普通电饭锅的普通煮饭模式就可以"},{"from":111.84,"to":114.42,"content":"这时候鸡汤也差不多炖了半个小时了"},{"from":114.42,"to":117.12,"content":"开盖加入提前切好的松茸"},{"from":121.24,"to":123.48,"content":"盖盖继续炖到米饭煮熟"},{"from":123.48,"to":126.86,"content":"在电饭煲显示剩余时间15分钟左右的时候"},{"from":126.86,"to":129.73,"content":"可以开盖摆盘调味一下哇"},{"from":131.439,"to":135.239,"content":"哇有点烫鼻"},{"from":150.66,"to":153.98,"content":"好香好香诶"},{"from":168.34,"to":170.58,"content":"看那个酱油流到底下之后"},{"from":170.58,"to":173.04,"content":"电饭锅也可以做出这样的锅巴"},{"from":173.04,"to":175.66,"content":"太香了"},{"from":178.74,"to":182.78,"content":"嘿好完美的一锅哦"},{"from":196.92,"to":198.04,"content":"开了吗"},{"from":198.04,"to":198.8,"content":"开饭了"},{"from":199.96,"to":201.32,"content":"超香"},{"from":201.56,"to":203.1,"content":"看起来好补呀"},{"from":203.1,"to":204.94,"content":"对呀"},{"from":221.66,"to":225.38,"content":"熬汤还是得用铸铁锅放在砂锅里"},{"from":225.38,"to":226.38,"content":"汤少了一大半"},{"from":226.38,"to":228.11,"content":"都没多少汤了"},{"from":228.11,"to":231.35,"content":"比如说各个地方海滩那高山啊"},{"from":231.35,"to":233.45,"content":"我经在昆仑山上唱歌"},{"from":233.45,"to":235.78,"content":"还刚好嗯"},{"from":235.78,"to":238.58,"content":"女性的确是非常有力量"},{"from":238.58,"to":241.13,"content":"特别是上肢力量"},{"from":242.35,"to":244.91,"content":"为了不耽误第二天的这个排练"},{"from":244.91,"to":246.61,"content":"我们都有给自己约法"},{"from":246.61,"to":247.78,"content":"三章"},{"from":248.06,"to":249.6,"content":"主管就开始训话"},{"from":249.6,"to":251.54,"content":"当时现场有六七十个人"},{"from":251.54,"to":252.86,"content":"我站在第一排"},{"from":252.86,"to":255.63,"content":"大家一下就偷看我了"},{"from":255.63,"to":257.23,"content":"这个喷嚏有多大"},{"from":257.23,"to":258.37,"content":"我要再拿一点点"},{"from":258.37,"to":259.53,"content":"你还要吗"},{"from":259.53,"to":261.75,"content":"果然还要哈哈哈"},{"from":261.75,"to":263.31,"content":"准备去游个泳"},{"from":263.31,"to":264.73,"content":"这里是游泳装备"},{"from":264.73,"to":266.27,"content":"但是因为太久没有游泳了"},{"from":266.27,"to":267.79,"content":"我就找不到我的泳帽了"},{"from":267.79,"to":270.68,"content":"我们打算现在先去迪卡侬买个泳帽"},{"from":270.68,"to":272.9,"content":"然后去游泳"},{"from":272.9,"to":274.1,"content":"很想动动了"},{"from":274.1,"to":276.7,"content":"已经走了"},{"from":349.16,"to":350.5,"content":"哈喽大家"},{"from":350.5,"to":352.92,"content":"我的咖啡"},{"from":352.92,"to":355.26,"content":"还有我的司康"},{"from":355.26,"to":357.28,"content":"还有两颗小鸡蛋"},{"from":358.24,"to":359.4,"content":"都已经凉透了"},{"from":359.4,"to":360.76,"content":"我前面用空气炸锅"},{"from":360.76,"to":363.25,"content":"把司康好不容易复热到超级香"},{"from":363.25,"to":364.45,"content":"还有我的咖啡"},{"from":364.45,"to":367.33,"content":"然后前面本来想坐在我的懒人沙发上"},{"from":367.33,"to":369.289,"content":"好好享受我的周末早餐"},{"from":369.289,"to":371.449,"content":"结果突然间手机里面有工作微信"},{"from":371.449,"to":372.929,"content":"一回就是半个多小时"},{"from":372.929,"to":377.84,"content":"我的司康和我的咖啡现在都已经冰凉凉哎"},{"from":379.46,"to":381.18,"content":"周末为什么还要工作"},{"from":383.66,"to":389.15,"content":"嗯给大家看一下这两个思康诶"},{"from":389.63,"to":392.39,"content":"这个是之前我好像有在视频里面推荐过"},{"from":392.39,"to":395.41,"content":"我说苏州有一家线下做司康很好吃的店"},{"from":395.41,"to":397.2,"content":"这是那个老板寄给我的"},{"from":397.2,"to":400.3,"content":"然后这个里面是放了我们的咖啡液的"},{"from":400.3,"to":403.14,"content":"就是他正好想做几款咖啡味的司康"},{"from":403.14,"to":404.88,"content":"然后就是让我来试试看"},{"from":404.88,"to":406.38,"content":"我还挺期待味道的"},{"from":406.38,"to":407.52,"content":"但是已经有点凉了"},{"from":407.52,"to":409.96,"content":"应该没有关系吧"},{"from":416.74,"to":420.48,"content":"我想说他的司康做的还是一如既往的好吃"},{"from":420.48,"to":421.4,"content":"黄油味"},{"from":421.4,"to":423.26,"content":"香草味都超浓"},{"from":423.26,"to":425.909,"content":"但咖啡味我一点没吃出来"},{"from":425.96,"to":429.34,"content":"可能咖啡液放的还是太少了"},{"from":429.74,"to":430.46,"content":"哇"},{"from":430.46,"to":433.12,"content":"碱水的这个好香啊"},{"from":433.12,"to":438.1,"content":"但是咖啡味还是一点没吃出来"},{"from":438.1,"to":441.02,"content":"待会认真给他写个report咳"},{"from":460.38,"to":462.22,"content":"棒嗯不可以去"},{"from":462.22,"to":464.42,"content":"我枕头上紫米糕"},{"from":465.65,"to":467.45,"content":"来拆几个快递吧"},{"from":467.45,"to":470.81,"content":"准备9月份的时候给大家好好录一个购物分享"},{"from":470.81,"to":473.45,"content":"马上要到我最喜欢的秋天了"},{"from":473.69,"to":477.15,"content":"最近买的比较多的都是一些新加的零碎物件"},{"from":477.15,"to":478.42,"content":"还有个别的大件"},{"from":478.42,"to":479.68,"content":"什么燃气灶呀"},{"from":479.68,"to":481.24,"content":"热水器呀之类的"},{"from":481.24,"to":484.36,"content":"这里基本上都是我买的一些生活用品"},{"from":484.36,"to":486.06,"content":"来看这个吧"},{"from":486.49,"to":488.99,"content":"这个是我买的一个冲牙器"},{"from":488.99,"to":491.13,"content":"你们平时用不用冲牙器呀"},{"from":491.13,"to":492.97,"content":"我是在反复去看牙医之后"},{"from":492.97,"to":494.91,"content":"现在牙线冲牙器"},{"from":494.91,"to":497.17,"content":"漱口水该用的全部都用上了"},{"from":497.17,"to":498.89,"content":"我就怕我自己的牙又要出问题"},{"from":498.89,"to":501.799,"content":"我真的太讨厌去看牙医了"},{"from":501.799,"to":504.839,"content":"我买了小米的这款冲牙器"},{"from":504.839,"to":507.119,"content":"因为最近天猫有大牌美妆补贴"},{"from":507.119,"to":508.679,"content":"感觉活动价格也很划算"},{"from":508.679,"to":509.9,"content":"就想买来试试看"},{"from":509.9,"to":512.54,"content":"不知道买什么牌子的时候就看看小米"},{"from":512.54,"to":513.86,"content":"因为我很爱啃骨头"},{"from":513.86,"to":515.8,"content":"所以我的个别牙缝就会特别大"},{"from":515.8,"to":517.54,"content":"每次一卡肉或者菜的时候"},{"from":517.54,"to":519.169,"content":"第二天肯定就会发炎"},{"from":519.169,"to":521.929,"content":"我真的要奉劝跟我一样爱啃骨头的朋友"},{"from":521.929,"to":523.169,"content":"稍微悠着点"},{"from":523.169,"to":524.3,"content":"不要啃那么多骨头"},{"from":524.3,"to":525.86,"content":"因为你的牙一旦出现问题后"},{"from":525.86,"to":527.14,"content":"真的会反反复复"},{"from":527.14,"to":529.02,"content":"我现在吃饭的时候看到软骨"},{"from":529.02,"to":531.329,"content":"真的就是那种爱而不得的无力感"},{"from":531.329,"to":535.71,"content":"这只是这只three plus的洗面奶"},{"from":535.71,"to":536.41,"content":"囤个货"},{"from":536.41,"to":538.43,"content":"应该很多人都用过这款洗面奶吧"},{"from":538.43,"to":540.98,"content":"我在学生时期就一直有在反复回购"},{"from":540.98,"to":543.38,"content":"算是洗面奶里面的性价比之王了"},{"from":543.38,"to":544.4,"content":"非常的温和"},{"from":544.4,"to":546.12,"content":"我基本上也都只化淡妆"},{"from":546.12,"to":547.92,"content":"所以清洁力度也非常的够了"},{"from":547.92,"to":549.8,"content":"但是这种大热的美妆护肤品"},{"from":549.8,"to":551.98,"content":"我是建议一定要在官方的渠道买"},{"from":551.98,"to":554.52,"content":"因为市面上太容易买到假货了"},{"from":554.52,"to":558.32,"content":"但是最近天猫有美妆各户观其爆款补贴专场"},{"from":558.32,"to":559.68,"content":"都是官方品牌入驻"},{"from":559.68,"to":561.4,"content":"就不用担心会买到假货啦"},{"from":561.4,"to":564.28,"content":"现在可以直接上淘宝搜索大牌美妆补贴"},{"from":564.28,"to":565.64,"content":"就可以进入到会场了"},{"from":565.64,"to":567.4,"content":"还可以淘金币抵扣商品"},{"from":567.4,"to":568.74,"content":"到手八五折起"},{"from":568.74,"to":571.94,"content":"有美妆客户囤货需求的朋友不妨可以去看看"},{"from":571.94,"to":575.03,"content":"也可以点击视频下方置顶蓝链直达会场"},{"from":575.03,"to":576.71,"content":"然后是我买的一个面膜"},{"from":576.71,"to":578.97,"content":"这个牌子的面膜可能不是那么大众"},{"from":578.97,"to":581.94,"content":"但是使用感我很喜欢"},{"from":583.649,"to":584.909,"content":"因为我平时比较懒"},{"from":584.909,"to":586.769,"content":"所以涂抹式的面膜每次买了"},{"from":586.769,"to":588.369,"content":"用了几次就会放大很久"},{"from":588.369,"to":589.729,"content":"然后最后就会被浪费"},{"from":589.729,"to":592.84,"content":"这种颗粒式的涂抹面膜就会比较适合懒人"},{"from":592.84,"to":595.42,"content":"而且外出出行的时候带着也会比较方便"},{"from":595.42,"to":598.36,"content":"它一盒里面是有四种不同功效的面膜"},{"from":598.36,"to":599.6,"content":"然后可以组合着用"},{"from":599.6,"to":602.16,"content":"也可以单独用单层纹理清洁面膜"},{"from":602.16,"to":603.79,"content":"这一款我特别喜欢"},{"from":603.79,"to":605.91,"content":"接着还有两个没什么用的"},{"from":605.91,"to":609.61,"content":"可爱小废物的一个牛马kitty"},{"from":609.61,"to":612.77,"content":"自从入坑了长腿kitty之后"},{"from":612.77,"to":615.39,"content":"又多了一个花钱的地方"},{"from":615.63,"to":618.85,"content":"酱酱他就是这样的一只长腿kitty"},{"from":618.85,"to":620.11,"content":"拿着一个平板"},{"from":620.11,"to":621.33,"content":"挂着一个工牌"},{"from":621.33,"to":623.14,"content":"非常的牛马"},{"from":623.14,"to":627.01,"content":"还有一个是大姐给我寄的快递诶"},{"from":627.01,"to":629.45,"content":"销上面收件人写的还是紫米糕呢"},{"from":629.45,"to":630.85,"content":"我也不知道这个里面是什么"},{"from":630.85,"to":634.24,"content":"大姐说有一个很适合我的东西要给我"},{"from":634.24,"to":636.9,"content":"但是我直接把它归类为可爱小废物了"},{"from":636.9,"to":638.14,"content":"因为我觉得大姐应该不会给我"},{"from":638.14,"to":640.34,"content":"寄什么有用的东西"},{"from":641.88,"to":644.12,"content":"啊这个应该不是大姐给我寄的快递"},{"from":644.12,"to":645.96,"content":"这是她上次本来就要给我的东西"},{"from":645.96,"to":647.74,"content":"她就一起放在这快递箱里了"},{"from":647.74,"to":651.14,"content":"这个是上次大姐有一个朋友安利给紫米糕的"},{"from":651.14,"to":652.62,"content":"一个宠物的除臭剂"},{"from":652.62,"to":653.7,"content":"说这个非常好用"},{"from":653.7,"to":654.82,"content":"然后她就送给了大姐"},{"from":654.82,"to":656.1,"content":"让大姐转交给我"},{"from":656.1,"to":657.9,"content":"谢谢"},{"from":662.02,"to":666.14,"content":"原来在这里我差点把他当成垃圾扔掉了"},{"from":666.94,"to":674.34,"content":"哦哈啊这真的也太可爱了吧"},{"from":674.34,"to":675.829,"content":"天哪"},{"from":676.149,"to":679.4,"content":"我不知道有没有人看过这部动画"},{"from":679.4,"to":683.28,"content":"她真的是我跟大姐小时候的动画片的白月光"},{"from":683.28,"to":687.05,"content":"是我最喜欢最喜欢的一部卡通动漫"},{"from":687.05,"to":687.81,"content":"我跟你们说"},{"from":687.81,"to":689.25,"content":"我鸡皮疙瘩都起来了"},{"from":689.25,"to":691.45,"content":"但是我觉得可能没有看过这部动漫的人"},{"from":691.45,"to":694.37,"content":"理解不了我的那种心情"},{"from":694.96,"to":699.62,"content":"就是我是一个很少会为IP去买周边的人"},{"from":699.62,"to":701.96,"content":"但是只有小萌绿豆人民的周边"},{"from":701.96,"to":703.36,"content":"真的是我看到了必买"},{"from":703.36,"to":706.019,"content":"因为它周边很少看过这部动漫的人"},{"from":706.019,"to":707.239,"content":"好像也不是很多"},{"from":707.239,"to":711.13,"content":"他真的是我的小时候魔法少女动漫的那种启蒙"},{"from":711.13,"to":712.95,"content":"小时候天天就幻想自己是个魔女"},{"from":712.95,"to":714.96,"content":"可以做扫把飞上天哈"},{"from":714.96,"to":716.87,"content":"啊真的好可爱啊"},{"from":716.87,"to":718.51,"content":"好了不陶醉了"},{"from":718.51,"to":720.03