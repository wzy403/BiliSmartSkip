三名乌军"},{"from":583.62,"to":584.9,"content":"貌似有一名乌军受伤"},{"from":584.9,"to":585.82,"content":"他们行动缓慢"},{"from":585.82,"to":586.68,"content":"在寻找掩护"},{"from":586.68,"to":587.94,"content":"躲到一栋房屋里之后"},{"from":587.94,"to":591.8,"content":"俄军的PV无人机抵达在房屋的前方发生爆炸"},{"from":591.8,"to":592.46,"content":"过了一会"},{"from":592.46,"to":594.02,"content":"第二架FPV无人机抵达"},{"from":594.02,"to":596.5,"content":"这三名的乌军存活的可能性不高"},{"from":596.5,"to":597.9,"content":"现在俄军除了无人机"},{"from":597.9,"to":599.46,"content":"还大规模使用航空炸弹"},{"from":600.42,"to":601.38,"content":"在托列茨克方向"},{"from":601.38,"to":603.88,"content":"俄军航空兵每天使用制导炸弹"},{"from":603.88,"to":606.2,"content":"进行多达100次的轰炸攻击"},{"from":606.2,"to":608.54,"content":"现在在纽约方向作战的还有一支新部队"},{"from":608.54,"to":609.64,"content":"第41集团军"},{"from":609.64,"to":611.34,"content":"35独立摩托化步兵旅"},{"from":611.34,"to":612.46,"content":"这里还想提一下"},{"from":612.46,"to":615.24,"content":"有位朋友说我偏向俄方过火了"},{"from":615.24,"to":618.04,"content":"说我完全回避了俄罗斯从哪些战线抽调部队"},{"from":618.04,"to":619.92,"content":"这其实是乌克兰的最核心目的"},{"from":619.92,"to":620.56,"content":"能不能胜利"},{"from":620.56,"to":621.48,"content":"不是他能掌握的"},{"from":621.48,"to":624.56,"content":"但俄罗斯从顿巴斯哈尔科夫赫尔松抽调部队"},{"from":624.56,"to":626.93,"content":"这点上就在战略上输了半筹"},{"from":626.93,"to":627.97,"content":"既然这位朋友问到"},{"from":627.97,"to":628.77,"content":"那我就说一下"},{"from":628.77,"to":631.25,"content":"我密切关注着俄军调往库尔斯克的增援部队"},{"from":631.25,"to":634.01,"content":"第七空降师是来自赫尔松的第11空突旅"},{"from":634.01,"to":635.66,"content":"来自巴赫姆赫42师"},{"from":635.66,"to":638.22,"content":"来自扎波罗热810海军步兵师18师"},{"from":638.22,"to":638.74,"content":"128师"},{"from":638.74,"to":640.12,"content":"这都是哈尔科夫前线来的"},{"from":640.12,"to":641.54,"content":"而顿涅茨克前线"},{"from":641.54,"to":643.88,"content":"俄军一支部队都没有调走"},{"from":643.88,"to":644.66,"content":"为什么"},{"from":644.66,"to":646.08,"content":"因为顿涅茨克前线"},{"from":646.08,"to":648.6,"content":"是俄军夏季攻势最主要的方向"},{"from":648.6,"to":651.36,"content":"这里没有一支部队调往库尔斯克增援"},{"from":651.36,"to":653.66,"content":"反倒是乌军从纽约前线"},{"from":653.66,"to":656.85,"content":"把32机械化旅和53机械化旅调走了"},{"from":656.85,"to":658.53,"content":"这个操作也是很神奇的"},{"from":658.53,"to":659.77,"content":"现在我们看看这个态势"},{"from":659.77,"to":661.22,"content":"乌军在西边走不了了"},{"from":661.22,"to":662.36,"content":"只有北面的退路"},{"from":662.36,"to":664.34,"content":"城内的乌军如果无法发起反击"},{"from":664.34,"to":666.74,"content":"那么基本可以准备收拾行李上路了"},{"from":666.74,"to":667.26,"content":"说实话"},{"from":667.26,"to":668.54,"content":"纽约都被打成这样了"},{"from":668.54,"to":669.9,"content":"乌军不增兵防御"},{"from":669.9,"to":672.24,"content":"还他妈要在库尔斯克建立集群指挥部"},{"from":672.24,"to":673.1,"content":"也是很神奇的"},{"from":673.1,"to":675.05,"content":"操作西边红军村战线"},{"from":675.05,"to":676.45,"content":"俄军取得重要进展"},{"from":676.45,"to":677.83,"content":"已经攻入了格罗季夫卡"},{"from":677.83,"to":678.63,"content":"上期我们说过"},{"from":678.63,"to":681.08,"content":"这个伊万尼夫卡是这片非常重要的村庄"},{"from":681.08,"to":683.14,"content":"俄军8月10号控制了这个村子"},{"from":683.14,"to":684.5,"content":"然后立刻向北进攻"},{"from":684.5,"to":688.2,"content":"8月13日前后攻占了这个斯维里多尼夫卡"},{"from":688.2,"to":689.34,"content":"这是个很小的村子"},{"from":689.34,"to":691.94,"content":"然后开始向北进攻这个新托列茨克"},{"from":691.94,"to":693.36,"content":"注意这片不是空地"},{"from":693.36,"to":695.02,"content":"是有乌军防线和战壕的"},{"from":695.02,"to":696.38,"content":"俄军两天就打下来了"},{"from":696.38,"to":698.58,"content":"大家看这是一片水库和河流区域"},{"from":698.58,"to":700.7,"content":"俄军如果先占领这个新托列茨克"},{"from":700.7,"to":702.18,"content":"把这块区域都控制下来"},{"from":702.18,"to":704.24,"content":"那么就可以向南包抄格罗季夫卡"},{"from":704.24,"to":704.84,"content":"而同时"},{"from":704.84,"to":707.7,"content":"东南面另一路俄军已经开始进攻格罗季夫卡"},{"from":707.7,"to":708.4,"content":"8月9日"},{"from":708.4,"to":710.24,"content":"俄军控制了外围两个钓鱼塘"},{"from":710.24,"to":711.04,"content":"8月13日"},{"from":711.04,"to":712.6,"content":"俄军已经攻入格罗季夫卡"},{"from":712.6,"to":713.78,"content":"控制第一排建筑区"},{"from":713.78,"to":714.44,"content":"这样一来"},{"from":714.44,"to":716.44,"content":"格罗季夫卡已经进入巷战阶段"},{"from":716.44,"to":718.16,"content":"前面我们说的这四个钓鱼塘"},{"from":718.16,"to":719.72,"content":"都已经在俄军的控制下了"},{"from":719.72,"to":721.44,"content":"这个城镇的纵深有多少呢"},{"from":721.44,"to":722.74,"content":"我们来量一下"},{"from":722.74,"to":724.3,"content":"大约3km左右"},{"from":724.3,"to":726.14,"content":"比克拉斯诺格夫卡要小一点"},{"from":726.14,"to":727.5,"content":"只要把这个城镇打下来"},{"from":727.5,"to":729.7,"content":"那么俄军夏季攻势目标就完成了"},{"from":729.7,"to":730.34,"content":"番号方面"},{"from":730.34,"to":732.46,"content":"在此处作战的有第二集团军"},{"from":732.46,"to":733.74,"content":"第30摩托化步兵旅"},{"from":733.74,"to":735.42,"content":"还有第15摩托化步兵旅"},{"from":735.42,"to":737.14,"content":"乌军也有新番号投入战斗"},{"from":737.14,"to":738.38,"content":"第151机械化旅"},{"from":738.38,"to":740.36,"content":"这是2023年10月新组建的部队"},{"from":740.36,"to":741.46,"content":"之所以是机械化旅"},{"from":741.46,"to":743.22,"content":"不是因为拿到了北约的新装备"},{"from":743.22,"to":744.14,"content":"这轮不到他们"},{"from":744.14,"to":745.66,"content":"而是从苏联的库存里"},{"from":745.66,"to":748.02,"content":"找到了一些旧的BMP和卡车拿来用"},{"from":748.02,"to":749.62,"content":"有一定的机械化能力"},{"from":749.62,"to":752.44,"content":"我在他们部队的脸书上看到了他们训练的照片"},{"from":752.44,"to":754.37,"content":"照片中这几位怎么说呢"},{"from":754.37,"to":756.83,"content":"呃感觉跟战场有点格格不入"},{"from":756.83,"to":760.19,"content":"然后这几位疑似是生理女性拿着枪在训练"},{"from":760.19,"to":762.73,"content":"他们可能是谁的妻子或者母亲"},{"from":762.73,"to":764.91,"content":"连女性都被迫要上战场了呀"},{"from":764.91,"to":768.29,"content":"而乌克兰某著名飞行员兼居瑞士的军事博主"},{"from":768.29,"to":770.41,"content":"还在热情洋溢的骂着普京"},{"from":770.41,"to":771.26,"content":"Loser"},{"from":771.26,"to":772.58,"content":"151旅的战斗力"},{"from":772.58,"to":774.66,"content":"肯定是比不上乌军那些主力旅的"},{"from":774.66,"to":775.26,"content":"试想一下"},{"from":775.26,"to":776.98,"content":"乌军库尔斯克方向的53旅"},{"from":776.98,"to":777.74,"content":"80空突旅"},{"from":777.74,"to":779.46,"content":"82空突旅都在这里的话"},{"from":779.46,"to":781.56,"content":"俄军岂能打得如此顺利"},{"from":781.56,"to":783.32,"content":"然后沿着铁路线的西南面"},{"from":783.32,"to":784.48,"content":"8月13到14日"},{"from":784.48,"to":785.88,"content":"俄军发起多次攻势"},{"from":785.88,"to":788.16,"content":"把战线向前推进了整整3km"},{"from":788.16,"to":790.28,"content":"并且空占了这个奥利夫卡"},{"from":790.28,"to":793.34,"content":"而且也攻入了铁路线南面的村庄麦克莱夫卡"},{"from":793.34,"to":794.72,"content":"有消息说已经打下来了"},{"from":794.72,"to":796.3,"content":"但乌方的消息还没有确认"},{"from":796.3,"to":797.55,"content":"我们还是保守一点"},{"from":797.55,"to":798.23,"content":"在东边"},{"from":798.23,"to":799.07,"content":"8月13日"},{"from":799.07,"to":800.83,"content":"俄军攻占了这个热兰涅"},{"from":800.83,"to":802.01,"content":"这是个重要的进展"},{"from":802.01,"to":804.43,"content":"热兰涅和东面的诺布斯里夫"},{"from":804.43,"to":806.18,"content":"APERSIA都是比较大的村庄"},{"from":806.18,"to":809,"content":"俄军可以在这里集结人员装备作为前进基地"},{"from":809,"to":811.38,"content":"现在俄军可以以这两个村庄作为支点"},{"from":811.38,"to":813.64,"content":"尽快把南面的河流沿线吃下来"},{"from":813.64,"to":814.76,"content":"以巩固侧翼"},{"from":814.76,"to":816.68,"content":"此处在活动的主要是俄军"},{"from":816.68,"to":818.3,"content":"第27摩托化步兵师一部"},{"from":818.3,"to":820.74,"content":"以及第114独立摩托化步兵旅"},{"from":820.74,"to":823.66,"content":"现在我们看到红军村方向战况是最激烈的"},{"from":823.66,"to":824.66,"content":"可以做一个对比"},{"from":824.66,"to":825.92,"content":"在恰索夫亚尔方向"},{"from":825.92,"to":827.64,"content":"俄军每天最多进攻六次"},{"from":827.64,"to":828.76,"content":"在捷尔任斯克方向"},{"from":828.76,"to":830.5,"content":"俄军每天最多攻击八次"},{"from":830.5,"to":831.88,"content":"而在红军村方向"},{"from":831.88,"to":834.7,"content":"俄军每天进攻多达50次"},{"from":834.7,"to":837.1,"content":"然后我们讲讲西边赫尔松方向"},{"from":837.1,"to":838.36,"content":"有个值得注意的消息"},{"from":838.36,"to":840.22,"content":"8月13到14日前后"},{"from":840.22,"to":843.62,"content":"乌军派兵过河登陆地点在这个沙洲附近"},{"from":843.62,"to":845.48,"content":"这支小分队全军覆没"},{"from":845.48,"to":847.42,"content":"这是俄军无人机拍摄的视频"},{"from":847.42,"to":849.46,"content":"可以看到乌军登陆艇被击中"},{"from":849.46,"to":851.66,"content":"部分乌军士兵漂浮在海面上"},{"from":851.66,"to":852.6,"content":"无人机隔得远"},{"from":852.6,"to":854.16,"content":"画面还算比较友好的"},{"from":854.16,"to":856.86,"content":"我这里还有俄军士兵走到跟前的视频"},{"from":856.86,"to":858.48,"content":"简直惨不忍睹"},{"from":858.48,"to":860.28,"content":"这些乌军士兵在基辅看来"},{"from":860.28,"to":862.43,"content":"不知算阵亡还是算失踪呢"},{"from":865.17,"to":867.29,"content":"要求给失踪的亲人一个说法"},{"from":867.29,"to":868.85,"content":"可怜第聂河边骨"},{"from":868.85,"to":870.9,"content":"犹是深闺梦里人"},{"from":870.9,"to":871.98,"content":"最后过去这一周"},{"from":871.98,"to":873.26,"content":"我的评论区非常精彩"},{"from":873.26,"to":874.829,"content":"再挑两个给大家看一下"},{"from":874.829,"to":877.449,"content":"这位朋友说那库尔斯科为啥准备公投啊"},{"from":877.449,"to":879.389,"content":"我猜他应该想讲的是乌方"},{"from":879.389,"to":883.79,"content":"有些媒体报道库尔斯克州准备公投加入俄罗斯"},{"from":883.79,"to":884.83,"content":"这话怎么说呢"},{"from":884.83,"to":887.13,"content":"我建议有的朋友们先查一下是不是"},{"from":887.13,"to":888.35,"content":"然后再问为什么"},{"from":888.35,"to":890.86,"content":"再比如这位射程8万公里的民兵导弹"},{"from":890.86,"to":891.98,"content":"和930架F16"},{"from":891.98,"to":894,"content":"250架B21全部到了乌克兰"},{"from":894,"to":894.48,"content":"自开战"},{"from":894.48,"to":896.76,"content":"乌克兰有3.1万军人光荣83万"},{"from":896.76,"to":898.32,"content":"俄式乌拉潮流浩荡"},{"from":898.32,"to":899.72,"content":"文明战胜野蛮文明"},{"from":899.72,"to":901.9,"content":"如此从未清晰明确"},{"from":901.9,"to":903.27,"content":"两个大拇指呃"},{"from":903.27,"to":904.77,"content":"930架F16"},{"from":904.77,"to":905.53,"content":"我的理解"},{"from":905.53,"to":908.42,"content":"美军自己装备的F16也只有841架"},{"from":908.42,"to":910.1,"content":"如果乌克兰有930架"},{"from":910.1,"to":911.26,"content":"不是俄国人要害怕"},{"from":911.26,"to":912.52,"content":"是欧洲人要害怕"},{"from":912.52,"to":914.72,"content":"还有射程8万公里的民兵导弹"},{"from":914.72,"to":916.24,"content":"这话让我陷入了沉思"},{"from":916.24,"to":917.6,"content":"一时不知如何回答"},{"from":917.6,"to":918.96,"content":"因为在我的知识体系里"},{"from":918.96,"to":921.04,"content":"赤道全长也不过4万多公里"},{"from":921.04,"to":924.05,"content":"射程8万公里的导弹究竟是想打什么呢"},{"from":924.05,"to":925.39,"content":"不是不相信你啊"},{"from":925.39,"to":927.31,"content":"我们大家想开开眼界"},{"from":927.31,"to":928.67,"content":"好的今天先讲到这"},{"from":928.67,"to":930.71,"content":"评论区还有持久的优惠券可以领"},{"from":930.71,"to":931.65,"content":"比平时优惠很多"},{"from":931.65,"to":932.59,"content":"感谢大家的收看"},{"from":932.59,"to":934.95,"content":"喜欢的朋友欢迎点赞或打赏支持我的视频"},{"from":934.95,"to":936.18,"content":"我们下期再会"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:06:24.938Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:06:21.742Z"}}
