,"to":80.14,"content":"转炉流程"},{"from":80.14,"to":82.49,"content":"每吨钢能排2吨多的温室气体"},{"from":82.49,"to":84.29,"content":"为了整治这个碳排放大户"},{"from":84.29,"to":86.23,"content":"欧盟真金白银是哐哐的砸"},{"from":86.23,"to":87.73,"content":"比如退出碳边境税"},{"from":87.73,"to":89.39,"content":"2026年开始生效"},{"from":89.39,"to":91.81,"content":"这样进口的高碳钢铁就要多花钱"},{"from":91.81,"to":93.34,"content":"然后还搞了创新基金"},{"from":93.34,"to":95.12,"content":"专门补贴绿色钢铁技术"},{"from":95.12,"to":97.86,"content":"说白了这时候谁能搞出去碳化的炼钢"},{"from":97.86,"to":99.74,"content":"谁就是既采政策风口"},{"from":99.74,"to":101.16,"content":"又抢市场先机"},{"from":101.16,"to":104.74,"content":"而TEGRA当时喊出的氢气加可再生电力的路线"},{"from":104.74,"to":106.15,"content":"就是冲着这个痛点去的"},{"from":106.15,"to":108.35,"content":"至于这个250万吨的年产量"},{"from":108.35,"to":109.53,"content":"当然也不是随便报的"},{"from":109.53,"to":112.23,"content":"因为这个数据差不多能满足欧洲汽车行业"},{"from":112.23,"to":113.98,"content":"10%的高端钢材需求"},{"from":113.98,"to":115.04,"content":"真要是成了"},{"from":115.04,"to":117.78,"content":"这是全球首个规模化绿青炼钢厂"},{"from":117.78,"to":119.18,"content":"妥妥的行业标杆"},{"from":119.18,"to":120.92,"content":"咱们再来说这个STAGGRA"},{"from":120.92,"to":123.52,"content":"它的前身h two green steel的背景十分雄厚"},{"from":123.52,"to":125.72,"content":"由瑞典投资公司VEGAS后ding创立"},{"from":125.72,"to":129.16,"content":"旨在通过绿色氢气技术减少钢铁行业的碳排放"},{"from":129.16,"to":131.92,"content":"该公司由风险投资家highland mix领导"},{"from":131.92,"to":133.1,"content":"你可能对他不熟悉"},{"from":133.1,"to":136.42,"content":"但这位也是瑞典电池制造商北服的联合创始人"},{"from":136.42,"to":138.38,"content":"你就说这投资是不是很风险"},{"from":138.38,"to":140.04,"content":"2024年9月12号"},{"from":140.04,"to":141.78,"content":"他又正式更名为STAGARA"},{"from":141.78,"to":143.02,"content":"至于改名的原因"},{"from":143.02,"to":144.06,"content":"咱们之后再说"},{"from":144.06,"to":144.74,"content":"总之啊"},{"from":144.74,"to":146.38,"content":"截止2025年10月"},{"from":146.38,"to":149.62,"content":"SEGUA这个项目已经筹集65亿欧元的资金"},{"from":149.62,"to":153.58,"content":"用于在瑞典博登建设世界首座大型绿色钢铁厂"},{"from":153.58,"to":155.66,"content":"这些资金来自多方投资者"},{"from":155.66,"to":156.34,"content":"除此之外"},{"from":156.34,"to":158.76,"content":"绿色炼钢所需的如直接还原炉"},{"from":158.76,"to":159.62,"content":"电弧炉"},{"from":159.62,"to":160.9,"content":"冷轧加工设备等"},{"from":160.9,"to":164.46,"content":"整套技术方案则由德国设备制造商SMS提供"},{"from":164.46,"to":165.94,"content":"而所需的绿色氢气"},{"from":165.94,"to":169.1,"content":"STAGRAM也找到了多个设备供应商和能源合同方"},{"from":169.1,"to":171.46,"content":"由他与season group纽ca达成的协议"},{"from":171.46,"to":174.5,"content":"由后者提供超过700兆瓦级别的碱性水"},{"from":174.5,"to":175.16,"content":"电解设备"},{"from":175.16,"to":176.3,"content":"用于滤芯生产"},{"from":176.3,"to":177.06,"content":"电解装置"},{"from":177.06,"to":178.58,"content":"选用成熟的AW技术"},{"from":178.58,"to":181.54,"content":"得以实现24小时全天不间断的氢气供应"},{"from":181.54,"to":184.82,"content":"然后还与UNIPER签订了为期6年的六太瓦时"},{"from":184.82,"to":185.5,"content":"电力供应"},{"from":185.5,"to":187.86,"content":"用于它的氢气和钢铁生产系统"},{"from":187.86,"to":190.78,"content":"接着还得到了欧盟的大量政策支持"},{"from":190.78,"to":192.5,"content":"而take挂的选址也很讲究"},{"from":192.5,"to":194.04,"content":"位于瑞典北部的博登"},{"from":194.04,"to":195.6,"content":"这地方有几个巨大的优势"},{"from":195.6,"to":198.67,"content":"首先是本身就很靠近丰富的铁矿资源"},{"from":198.67,"to":201.11,"content":"边上还有一个可以容纳破冰船的港口"},{"from":201.11,"to":203.99,"content":"这为原料输出和成品出口提供了便利"},{"from":203.99,"to":205.31,"content":"其次是瑞典北部"},{"from":205.31,"to":207.56,"content":"这地方拥有欧洲最低的能源成本之一"},{"from":207.56,"to":210.18,"content":"最后当然是地方政府的大力扶持"},{"from":210.18,"to":211.88,"content":"可以说是要钱有钱要人"},{"from":211.88,"to":212.48,"content":"有人要地"},{"from":212.48,"to":213.24,"content":"有地要技术"},{"from":213.24,"to":213.8,"content":"有技术"},{"from":213.8,"to":214.7,"content":"兵马雄厚"},{"from":214.7,"to":215.6,"content":"粮草充足"},{"from":215.6,"to":217.64,"content":"小小钢铁厂还不是一把拿下"},{"from":217.64,"to":219.99,"content":"然后事情不出意外的出意外了"},{"from":219.99,"to":221.15,"content":"咱们先来解释一下"},{"from":221.15,"to":223.41,"content":"这个氢气还原技术到底是怎么一回事"},{"from":223.41,"to":224.07,"content":"简单来说"},{"from":224.07,"to":226.74,"content":"铁在矿物当中通常以氧化物的形