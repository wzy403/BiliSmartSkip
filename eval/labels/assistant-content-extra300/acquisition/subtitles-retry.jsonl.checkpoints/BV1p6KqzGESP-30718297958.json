{"schemaVersion":1,"bvid":"BV1p6KqzGESP","cid":30718297958,"subtitles":[{"from":0,"to":2.2,"content":"为什么大型食肉动物都是无毒的"},{"from":2.2,"to":3.94,"content":"首先就是用毒的成本太高"},{"from":3.94,"to":5.58,"content":"毒液的成分是小分子蛋白"},{"from":5.58,"to":7.8,"content":"而蛋白质是组成生命体的重要原料"},{"from":7.8,"to":9.64,"content":"所以喷毒其实就是在喷蛋白质"},{"from":9.64,"to":11.26,"content":"这哪个大型动物能背得住"},{"from":11.26,"to":12.22,"content":"类比到游戏里"},{"from":12.22,"to":14.36,"content":"如果说一般的捕猎是耗蓝型技能"},{"from":14.36,"to":16.36,"content":"毒液捕猎就属于是耗血型技能"},{"from":16.36,"to":17.18,"content":"以毒蛇为例"},{"from":17.18,"to":18.76,"content":"毒液的生产所消耗的能量"},{"from":18.76,"to":21,"content":"往往要占其总能耗的20%以上"},{"from":21,"to":22.64,"content":"而大型哺乳动物新陈代谢快"},{"from":22.64,"to":24.74,"content":"还要很大的一部分能量来维持体温"},{"from":24.74,"to":26.8,"content":"我光是躺着不动就很耗能了"},{"from":26.8,"to":29.06,"content":"自然就供氧不毒液这种奢侈的技能"},{"from":29.06,"to":31.28,"content":"所以用毒的基本上都是一些小型动物"},{"from":31.28,"to":32.86,"content":"蓝环章鱼蛇蜘蛛什么的"},{"from":32.86,"to":35.38,"content":"其次用毒在生物进化这条路上属实"},{"from":35.38,"to":36.3,"content":"不是什么好技能"},{"from":36.3,"to":37.78,"content":"跟力量和敏捷比起来"},{"from":37.78,"to":39.1,"content":"那就属于是奇技淫巧"},{"from":39.1,"to":41.72,"content":"旁门左道生物进化出毒液的目的就两个"},{"from":41.72,"to":42.72,"content":"第一个就是自保"},{"from":42.72,"to":43.7,"content":"第二个就是捕猎"},{"from":43.7,"to":44.72,"content":"就自保来讲"},{"from":44.72,"to":45.96,"content":"大型动物体型巨大化"},{"from":45.96,"to":48.36,"content":"把血量堆后本身就是最好的自保手段"},{"from":48.36,"to":50.6,"content":"就好像你玩游戏不知道出什么装备的时候"},{"from":50.6,"to":51.74,"content":"出肉装肯定没错"},{"from":51.74,"to":52.72,"content":"而就捕猎来讲"},{"from":52.72,"to":54.04,"content":"那用毒就更拉垮了"},{"from":54.04,"to":55.6,"content":"首先毒液有一个致命弱点"},{"from":55.6,"to":56.62,"content":"那就是出伤太慢"},{"from":56.62,"to":58.68,"content":"从中毒到死亡是有个过程的"},{"from":58.68,"to":61.14,"content":"大型食肉动物的猎物一般是大型食草动物"},{"from":61.14,"to":61.96,"content":"毒放多了吧"},{"from":61.96,"to":63.14,"content":"我自己身体扛不住"},{"from":63.14,"to":64.019,"content":"毒放少了吧"},{"from":64.019,"to":65.539,"content":"一时之间毒不死猎物"},{"from":65.539,"to":67.699,"content":"万一跑到别的食物动物的地盘才毒发"},{"from":67.699,"to":69.039,"content":"那就是为他人做嫁衣"},{"from":69.039,"to":71.699,"content":"咱们还是用游戏来类比一下毒的伤害机制"},{"from":71.699,"to":72.499,"content":"类似于dot"},{"from":72.499,"to":73.52,"content":"也就是延迟伤害"},{"from":73.52,"to":74.72,"content":"虽然总伤害很高"},{"from":74.72,"to":76.3,"content":"但每秒却跳那么一次伤害"},{"from":76.3,"to":77.64,"content":"这就导致了中毒的死亡"},{"from":77.64,"to":78.58,"content":"时间会被拉长"},{"from":78.58,"to":80.84,"content":"甚至可能会被对面用血条硬抗过去"},{"from":80.84,"to":82.24,"content":"最关键的是出伤慢"},{"from":82.24,"to":83.6,"content":"就有可能会被别人K头"},{"from":83.6,"to":84.94,"content":"你辛辛苦苦放了个毒"},{"from":84.94,"to":86,"content":"然后自己没补到刀"},{"from":86,"to":87.1,"content":"你说难受不难受"},{"from":87.1,"to":89.68,"content":"大型食肉动物从体型到力量都是顶级"},{"from":89.68,"to":91.04,"content":"无论是咬脖还是掏肛"},{"from":91.04,"to":92.18,"content":"都属于是瞬时伤害"},{"from":92.18,"to":94.44,"content":"从咬住猎物到致死也就12分钟"},{"from":94.44,"to":95.06,"content":"说白了"},{"from":95.06,"to":97.68,"content":"如果你一发平A就能让敌人血量清空的话"},{"from":97.68,"to":100.16,"content":"那大概率也就不需要什么延迟伤害类技能了"},{"from":100.16,"to":101.06,"content":"咱们设想一下"},{"from":101.06,"to":102.92,"content":"毒蛇一发毒液的总伤害10万"},{"from":102.92,"to":104.46,"content":"但每秒就跳20点伤害"},{"from":104.46,"to":106.18,"content":"而狮子普通攻击伤害2万"},{"from":106.18,"to":106.9,"content":"暴击5万"},{"from":106.9,"to":109.3,"content":"现在有一只血量5万且自带回血的猎物"},{"from":109.3,"to":111.22,"content":"你说你是选择用狮子的物理超度"},{"from":111.22,"to":112.54,"content":"还是用蛇的化学超度"},{"from":112.54,"to":114.1,"content":"而这时候蛇在跟狮子说"},{"from":114.1,"to":115.52,"content":"我这有个很牛逼的技能"},{"from":115.52,"to":116.22,"content":"你咬中它"},{"from":116.22,"to":116.74,"content":"它没秒掉"},{"from":116.74,"to":117.38,"content":"二吃点血"},{"from":117.38,"to":118.54,"content":"然后你跟着他诶"},{"from":118.54,"to":119.42,"content":"等他没血了"},{"from":119.42,"to":120.66,"content":"你就能享用大餐了"},{"from":120.66,"to":121.56,"content":"这么强的技能"},{"from":121.56,"to":122.08,"content":"狮子熊"},{"from":122.08,"to":123.02,"content":"你学不学呢"},{"from":123.02,"to":124.64,"content":"学学个屁"},{"from":125.88,"to":128.8,"content":"所以毒液攻击这种消耗大出伤慢的捕猎方式"},{"from":128.8,"to":130.32,"content":"它就只能适用于小型动物"},{"from":130.32,"to":132.2,"content":"在自然界每个生态位上的物种"},{"from":132.2,"to":133.76,"content":"都有适合自己的谋生手段"},{"from":133.76,"to":135.64,"content":"大型动物靠力量和敏捷生存"},{"from":135.64,"to":136.44,"content":"比如狮子老虎"},{"from":136.44,"to":137.64,"content":"小型动物靠毒液"},{"from":137.64,"to":139.08,"content":"比如蛇再小一点呢"},{"from":139.08,"to":140.2,"content":"可能就得靠寄生了"},{"from":140.2,"to":140.84,"content":"比如螨虫"},{"from":140.84,"to":142.34,"content":"就靠吃点人类残留在衣服"},{"from":142.34,"to":143.9,"content":"被子上的皮脂屑生存啊"},{"from":143.9,"to":144.56,"content":"说到螨虫"},{"from":144.56,"to":146.06,"content":"就不得不给大家推荐一下"},{"from":146.06,"to":147.94,"content":"我最近入手的大鱼除螨仪了"},{"from":147.94,"to":148.9,"content":"真的不用不知道"},{"from":148.9,"to":149.7,"content":"一用吓一跳"},{"from":149.7,"to":152.06,"content":"看着干净的床居然吸出这么多脏东西"},{"from":152.06,"to":152.92,"content":"睡觉身上痒"},{"from":152.92,"to":154.76,"content":"背上爱长痘的原因算是找到了"},{"from":154.76,"to":156,"content":"好在现在我有了大雨"},{"from":156,"to":157.96,"content":"隔三差五吸一吸可以安静不少"},{"from":157.96,"to":159.5,"content":"它搭载的是高强度马达"},{"from":159.5,"to":161.02,"content":"拍打力和吸力都在线"},{"from":161.02,"to":161.98,"content":"V型滚刷设计"},{"from":161.98,"to":162.84,"content":"能有效聚成"},{"from":162.84,"to":163.64,"content":"不易缠毛发"},{"from":163.64,"to":165.46,"content":"还有紫外线和超声波的加持"},{"from":165.46,"to":166.18,"content":"三管齐下"},{"from":166.18,"to":168.98,"content":"就算藏的再深的螨虫和脏东西也都插翅难逃"},{"from":168.98,"to":171.06,"content":"而且它的吸口比其他的除螨仪宽"},{"from":171.06,"to":172.12,"content":"效率直线上升"},{"from":172.12,"to":173.9,"content":"下雨天还能用热风去湿气"},{"from":173.9,"to":174.56,"content":"非常方便"},{"from":174.56,"to":176.3,"content":"双浴尘杯打理起来也省事"},{"from":176.3,"to":177.64,"content":"清理全屋只要倒一次"},{"from":177.64,"to":179.18,"content":"如果大家经常过敏鼻炎"},{"from":179.18,"to":180.72,"content":"很有可能就是尘螨引起的"},{"from":180.72,"to":182.2,"content":"建议可以像我一样搞个大雨"},{"from":182.2,"to":183.1,"content":"把家里吸一吸"},{"from":183.1,"to":183.96,"content":"减少过敏源"},{"from":183.96,"to":184.8,"content":"睡得也舒服"},{"from":184.8,"to":186.44,"content":"家里宠物掉毛的也很好用"},{"from":186.44,"to":187.44,"content":"感兴趣的兄弟们"},{"from":187.44,"to":189.04,"content":"欢迎评论领券送运费险"},{"from":189.04,"to":190.7,"content":"一年内质量问题免费换新"},{"from":190.7,"to":192.08,"content":"两年质保不要错过了"},{"from":192.08,"to":193.8,"content":"到这有人可能会反驳道"},{"from":193.8,"to":194.58,"content":"你说的不对"},{"from":194.58,"to":195.92,"content":"大型动物带毒的也有"},{"from":195.92,"to":197.16,"content":"科莫多巨蜥不就是吗"},{"from":197.16,"to":199.04,"content":"科莫多巨蜥嘴巴里确实有毒腺"},{"from":199.04,"to":200.02,"content":"但是毒性很低"},{"from":200.02,"to":201.44,"content":"以至于很多人都在争论"},{"from":201.44,"to":202.4,"content":"它到底是靠毒液"},{"from":202.4,"to":204.56,"content":"还是靠唾液里的细菌来弄死猎物的"},{"from":204.56,"to":205.4,"content":"当然不管怎样"},{"from":205.4,"to":206.76,"content":"科莫多巨蜥咬伤猎物后"},{"from":206.76,"to":208.12,"content":"会跟着猎物两到三天"},{"from":208.12,"to":208.98,"content":"等待它们死亡"},{"from":208.98,"to":209.84,"content":"然后再吃掉"},{"from":209.84,"to":212.66,"content":"这种捕猎方式妥妥的就是毒液的dot伤害类型"},{"from":212.66,"to":215.22,"content":"你可能会以为科莫多巨蜥看上去凶神恶煞"},{"from":215.22,"to":216.6,"content":"是一个很强的掠食者"},{"from":216.6,"to":218.68,"content":"实际上从生物演化的角度上来讲"},{"from":218.68,"to":219.7,"content":"他们简直弱爆了"},{"from":219.7,"to":222.3,"content":"科莫多巨蜥的这种捕猎策略之所以能够生效"},{"from":222.3,"to":224.42,"content":"是因为它们生存在几座特定的孤岛上"},{"from":224.42,"to":225,"content":"环境封闭"},{"from":225,"to":226.78,"content":"且岛上没有其他大型食肉动物"},{"from":226.78,"to":229.22,"content":"但凡岛上有个大型猫科动物来抢生态位"},{"from":229.22,"to":230.06,"content":"它们都得灭绝"},{"from":230.06,"to":232.28,"content":"然而即便是拥有这么得天独厚的条件"},{"from":232.28,"to":234.74,"content":"它们依然还是混到了经常要去食府的地步"},{"from":234.74,"to":237.58,"content":"所以我说毒实在是算不得什么高明的捕猎手段"},{"from":237.58,"to":238.42,"content":"可一点没下降"},{"from":238.42,"to":239.58,"content":"而对于蛇类来讲"},{"from":239.58,"to":241.34,"content":"有毒的蛇体型都相对较小"},{"from":241.34,"to":243.2,"content":"而体型大的蟒蛇都是无毒的"},{"from":243.2,"to":244.96,"content":"因为他们有更高效的捕猎手段"},{"from":244.96,"to":247.84,"content":"那就是靠着又粗又长又壮的身躯来绞杀猎物"},{"from":247.84,"to":249.64,"content":"也就是说在蛇的演化之路上"},{"from":249.64,"to":251.52,"content":"有两条岔路和巨大化"},{"from":251.52,"to":252.32,"content":"选择了毒液"},{"from":252.32,"to":254.42,"content":"珍贵的蛋白质就无法用在自己身上"},{"from":254.42,"to":255.5,"content":"体型就很难变大"},{"from":255.5,"to":256.1,"content":"体型不大"},{"from":256.1,"to":258.58,"content":"就限制了他们获取更多物质和能量的能力"},{"from":258.58,"to":260.16,"content":"又进一步限制了它们的体型"},{"from":260.16,"to":263.03,"content":"一代一代传下来就注定长不大了"},{"from":263.35,"to":265.84,"content":"说出五名吓汝一跳"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:23:44.751Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:23:39.950Z"}}
