nt":"到进化这么长的脚来卡住自己的"},{"from":302.48,"to":304.36,"content":"动动脑子好不好"},{"from":311.53,"to":312.37,"content":"屎都没写到"},{"from":312.37,"to":316.28,"content":"路十堵塞就是堵塞安全的车子高头"},{"from":316.28,"to":318,"content":"这是四川乐山的粉丝拍的"},{"from":318,"to":318.96,"content":"大家应该都很熟悉了"},{"from":318.96,"to":320.56,"content":"在咬伤粉丝毒蛇的系列中"},{"from":320.56,"to":322,"content":"经常出现一条原毛头"},{"from":322,"to":323.84,"content":"这种蛇在南方地区很常见啊"},{"from":323.84,"to":324.8,"content":"咬人数量非常多"},{"from":324.8,"to":326.44,"content":"大家一定要小心"},{"from":329.44,"to":331.06,"content":"看似像草皮的破布"},{"from":331.06,"to":332.8,"content":"其实是一张巨大的森然"},{"from":332.8,"to":334.4,"content":"蛇皮足足有9米多"},{"from":334.4,"to":334.66,"content":"长"},{"from":334.66,"to":335.8,"content":"相当于三层楼"},{"from":335.8,"to":337.88,"content":"那么这个纪录片我估计很多人都看过啊"},{"from":337.88,"to":339.4,"content":"我也忘记原片里怎么说了"},{"from":339.4,"to":341.8,"content":"反正从视觉上看是肯定没有9米的"},{"from":341.8,"to":343.84,"content":"因为奥斯丁的身高是1米87左右"},{"from":343.84,"to":345.72,"content":"这张皮连他的四倍身高刀都不到"},{"from":345.72,"to":346.94,"content":"显得连8米都没有"},{"from":346.94,"to":348.2,"content":"然后蛇皮还有拉伸"},{"from":348.2,"to":350.6,"content":"身上的蛇皮会拉升20%到40"},{"from":350.6,"to":352.68,"content":"所以这辆车的原始长度可能连6米都没有"},{"from":352.68,"to":353.94,"content":"就是一条普通的大个体"},{"from":353.94,"to":355.92,"content":"我给你们看一张真正的9米蛇皮"},{"from":355.92,"to":356.92,"content":"来自于网纹蟒"},{"from":356.92,"to":357.92,"content":"是不是相当震撼"},{"from":357.92,"to":360.289,"content":"然而它的原始长度也就7米左右"},{"from":362.64,"to":364.12,"content":"卧槽不是吧"},{"from":366.96,"to":367.86,"content":"这真的是辣条"},{"from":367.86,"to":371.53,"content":"卧槽本是在菜地里拍到的"},{"from":371.53,"to":373.23,"content":"小神问我是不是泰国圆斑奎"},{"from":373.23,"to":375.29,"content":"大家仔细看这个背部有像眼睛一样的花纹"},{"from":375.29,"to":376.24,"content":"整个背部诠释"},{"from":376.24,"to":377.24,"content":"那么就很明了了"},{"from":377.24,"to":379.08,"content":"全中国有这种花纹的只有一种蛇"},{"from":379.08,"to":380.24,"content":"它就是玉斑丽蛇"},{"from":380.24,"to":381.2,"content":"俗称美女蛇"},{"from":381.2,"to":381.56,"content":"没得到"},{"from":381.56,"to":383.04,"content":"不用怕"},{"from":392.26,"to":395.06,"content":"这是新加坡的网友拍的一条非常大的油蛇"},{"from":395.06,"to":396.06,"content":"黑网乌梢蛇"},{"from":396.06,"to":397.1,"content":"这种蛇主要分布于东"},{"from":397.1,"to":398.82,"content":"在中国的云南也有分布"},{"from":398.82,"to":400.3,"content":"视频里这条看起来得有2米多"},{"from":400.3,"to":402.24,"content":"但在黑网屋上实力只能算一般的"},{"from":402.24,"to":404.04,"content":"最大可长到3.5米以上"},{"from":404.04,"to":405.08,"content":"甚至有说4米的"},{"from":405.08,"to":407.08,"content":"不过没有具体标本"},{"from":410.36,"to":412.92,"content":"四斤七两乌梢蛇长2米六"},{"from":412.92,"to":416,"content":"长八斤三两的乌梢蛇长5米8长"},{"from":416,"to":417.64,"content":"这是我亲手抓到的"},{"from":417.64,"to":419.16,"content":"八斤三两的乌梢蛇"},{"from":419.16,"to":421.02,"content":"我抓了半个小时才搞定"},{"from":421.02,"to":422.6,"content":"几个吹牛逼的聚到一起了"},{"from":422.6,"to":423.48,"content":"四斤七两"},{"from":423.48,"to":424.64,"content":"2米六是没有问题的"},{"from":424.64,"to":426.96,"content":"但你八斤三两怎么就5米8了"},{"from":426.96,"to":428.08,"content":"谁告诉你体重翻倍"},{"from":428.08,"to":429,"content":"长度也要翻倍的"},{"from":429,"to":431.12,"content":"下次吹牛逼的先了解一下谁的基本常识"},{"from":431.12,"to":432.24,"content":"不然一眼露馅好吧"},{"from":432.24,"to":433.32,"content":"然后这个广东的哥们说"},{"from":433.32,"to":435.32,"content":"他6年抓了一条5米的乌梢蛇"},{"from":435.32,"to":437.12,"content":"又是小时候006年的时候"},{"from":437.12,"to":438.7,"content":"知道5米的卷尺有多长吗"},{"from":438.7,"to":439.88,"content":"你见过卷尺吗"},{"from":439.88,"to":440.22,"content":"啊"},{"from":440.22,"to":440.98,"content":"还有5米"},{"from":440.98,"to":442.16,"content":"下面又那个广东的哥们说"},{"from":442.16,"to":443.88,"content":"他去年做到过7米的眼镜王蛇"},{"from":443.88,"to":444.92,"content":"也就是2022年"},{"from":444.92,"to":445.76,"content":"我真的笑了"},{"from":445.76,"to":446.82,"content":"以前那些吹牛逼的"},{"from":446.82,"to":448.66,"content":"可以用年代久远来找借口质疑他"},{"from":448.66,"to":449.42,"content":"就说你没见过"},{"from":449.42,"to":450.18,"content":"不代表没有"},{"from":450.18,"to":451.22,"content":"都2022年了"},{"from":451.22,"to":452.22,"content":"你还敢吹牛逼"},{"from":452.22,"to":454.62,"content":"这可是2022年人手一部手机"},{"from":454.62,"to":455.94,"content":"在人类居住地做的眼镜"},{"from":455.94,"to":456.82,"content":"往往是带去放生"},{"from":456.82,"to":458.02,"content":"可是一点毛病都没有的"},{"from":458.02,"to":459.62,"content":"或者就是单纯的拍一张照片"},{"from":459.62,"to":460.5,"content":"边上有个参照物"},{"from":460.5,"to":461.9,"content":"所以不要跟我找这种借口"},{"from":461.9,"to":463.58,"content":"你在202年拿不出任何证据"},{"from":463.58,"to":464.5,"content":"在那纯吹牛逼"},{"from":464.5,"to":465.78,"content":"你怎么好意思说你没见过"},{"from":465.78,"to":467.98,"content":"不代表没有的啊"},{"from":476.68,"to":480.12,"content":"这是泰国的网友拍的一条泰国灵蛇"},{"from":480.12,"to":481.08,"content":"主要分布于南亚"},{"from":481.08,"to":481.4,"content":"东南亚"},{"from":481.4,"to":482.8,"content":"在中国的云南也有分布"},{"from":482.8,"to":483.28,"content":"泰国零食"},{"from":483.28,"to":485.2,"content":"这是一种大型的后沟牙微毒蛇"},{"from":485.2,"to":486.68,"content":"长度可以长到1.8米以上"},{"from":486.68,"to":487.24,"content":"以鸟类"},{"from":487.24,"to":488.22,"content":"小型哺乳类为食"},{"from":488.22,"to":489.3,"content":"和其他灵蛇一样"},{"from":489.3,"to":491.1,"content":"泰国灵蛇对人类毒性也非常弱"},{"from":491.1,"to":492.5,"content":"咬人一般不会有太大影响"},{"from":492.5,"to":494.18,"content":"所以不用害怕"},{"from":496.1,"to":497.26,"content":"1868年"},{"from":497.26,"to":500.38,"content":"印度的一名男子小帅来到一个地方奉命做砖"},{"from":500.38,"to":503.7,"content":"小帅闲暇之余就像两名男子学习如何诱蛇"},{"from":503.7,"to":504.82,"content":"然而他不知道的是"},{"from":504.82,"to":506.5,"content":"这两名男子其实是恶霸"},{"from":506.5,"to":508.1,"content":"在某一个星期天的晚上"},{"from":508.1,"to":509.82,"content":"恶霸突然说让蛇咬它们"},{"from":509.82,"to":511.2,"content":"还叫他们不用担心"},{"from":511.2,"to":512.679,"content":"恶霸会失宠救命"},{"from":512.679,"to":514.099,"content":"小帅虽然是个老实人"},{"from":514.099,"to":515.099,"content":"但也不是"},{"from":515.099,"to":515.979,"content":"他可不想被养"},{"from":515.979,"to":517.859,"content":"然而恶霸已经把他们控制住了"},{"from":517.859,"to":519.08,"content":"并带来了三条蛇"},{"from":519.08,"to":520.24,"content":"两条印度环蛇"},{"from":520.24,"to":521.62,"content":"一条印度眼镜蛇"},{"from":521.62,"to":524.68,"content":"恶霸把其中一条非常大的印度环蛇拿了过来"},{"from":524.68,"to":527.08,"content":"并让一名男子把手伸到蛇的旁边"},{"from":527.08,"to":528.26,"content":"起初蛇没有咬他"},{"from":528.26,"to":529.88,"content":"恶霸便拿手杖打蛇"},{"from":529.88,"to":532.36,"content":"受到伤害的蛇迅速咬了男子一口"},{"from":532.36,"to":533.92,"content":"随后他用同样的方式"},{"from":533.92,"to":535.86,"content":"让这条蛇咬了另外两名男子"},{"from":535.86,"to":537.18,"content":"最后又咬了小帅"},{"from":537.18,"to":537.74,"content":"完事后"},{"from":537.74,"to":539.74,"content":"恶霸开始念咒语企图复苏"},{"from":539.74,"to":542.46,"content":"第一个被咬的人很快出现中毒症状"},{"from":542.46,"to":543.54,"content":"开始口吐白沫"},{"from":543.54,"to":544.22,"content":"失去知觉"},{"from":544.22,"to":545.62,"content":"在当晚晚就死掉了"},{"from":545.62,"to":547.26,"content":"恶霸们见咒语不能救人"},{"from":547.26,"to":548.1,"content":"赶紧跑路"},{"from":548.1,"to":550.48,"content":"另外两人则在第二天中午死去"},{"from":550.48,"to":552.68,"content":"仅剩的小帅也逐渐失去知觉"},{"from":552.68,"to":554.28,"content":"好在他被人送到了医院"},{"from":554.28,"to":556.46,"content":"抢救了三天才保住性命"},{"from":556.46,"to":556.82,"content":"不得不说"},{"from":556.82,"to":558.18,"content":"这个咬人记录是真的抽象"},{"from":558.18,"to":559.1,"content":"迷信害人啊"},{"from":559.1,"to":560.8,"content":"最终恶霸们也是得到应有的惩法"},{"from":560.8,"to":562.72,"content":"原本后面还有五六个人等着被咬的"},{"from":562.72,"to":564.32,"content":"可能是恶霸打蛇打的太凶了"},{"from":564.32,"to":565.84,"content":"当时咬完小帅之后就不行"},{"from":565.84,"to":567.22,"content":"所以这是一条大个体"},{"from":567.22,"to":568.84,"content":"印度环蛇连咬四人"},{"from":568.84,"to":569.44,"content":"毒死三人"},{"from":569.44,"to":572.08,"content":"最后一个死里逃生的全球最牛逼咬人记录"},{"from":572.08,"to":573.28,"content":"第一个人是最惨的"},{"from":573.28,"to":573.84,"content":"从症状来看"},{"from":573.84,"to":575.24,"content":"他被注入了最多的毒液"},{"from":575.24,"to":576.4,"content":"小帅是最幸运的"},{"from":576.4,"to":577.96,"content":"咬踏实排毒量已经很低了"},{"from":577.96,"to":580.2,"content":"但这不代表这是印度环蛇把毒液用完了"},{"from":580.2,"to":581.92,"content":"正常情况下蛇是会保留一部分毒液的"},{"from":581.92,"to":583.64,"content":"而且他们是通过打蛇不咬"},{"from":583.64,"to":584.92,"content":"不是直接拿着不咬蛇"},{"from":584.92,"to":586.66,"content":"完全可以控制自己要不要排毒"},{"from":586.66,"to":588.78,"content":"重点是第一个被咬的排毒量溢出了"},{"from":588.78,"to":589.8,"content":"明显溢出很多"},{"from":589.8,"to":592.46,"content":"如果平均分配一下这个印度把毒液用完"},{"from":592.46,"to":593.98,"content":"说不定还真能毒死十个人"},{"from":593.98,"to":595.1,"content":"实在是太夸张了"},{"from":595.1,"to":597.06,"content":"要知道印度环蛇的排毒量是很低的"},{"from":597.06,"to":599.5,"content":"咱们再用KIMI来看一篇印度环蛇的毒液研究"},{"from":599.5,"to":601.02,"content":"看看印度环蛇还有哪些毒"},{"from":601.02,"to":602.58,"content":"总结的依然很准确"},{"from":602.58,"to":604.22,"content":"我们还可以让KIMI整理一个表格"},{"from":604.22,"to":606.58,"content":"这样印度环蛇的毒素含量就很直观了"},{"from":606.58,"to":607.42,"content":"像我做视频的话"},{"from":607.42,"to":609.18,"content":"是需要看大量文献的"},{"from":609.18,"to":610.98,"content":"从大量文献中找到我想要的内容"},{"from":610.98,"to":611.94,"content":"非常花时间"},{"from":611.94,"to":613.22,"content":"这个时候支持20万字"},{"from":613.22,"to":615.5,"content":"无损上下文的KIMI就非常香了"},{"from":615.5,"to":617.34,"content":"每次阅读前我又把多篇文献发给他"},{"from":617.34,"to":617.66,"content":"总结"},{"from":617.66,"to":618.86,"content":"看看有没有我想要的"},{"from":618.86,"to":619.88,"content":"再点进去详细看"},{"from":619.88,"to":620.8,"content":"非常省啊"},{"from":620.8,"to":622.32,"content":"而且KIMI还是免费的"},{"from":622.32,"to":623.76,"content":"现在点我评论区就可以下载"},{"from":623.76,"to":625.52,"content":"有需要的赶紧去试试哟"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:29:05.380Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:29:00.676Z"}}
