{"schemaVersion":1,"bvid":"BV1zXpweRESB","cid":25741560078,"subtitles":[{"from":0,"to":3.5,"content":"前两天一位同学在观看阿帕奇直升机的视频时"},{"from":3.5,"to":7.06,"content":"无意中听说该机搭载的是M230链式机炮"},{"from":7.06,"to":9.66,"content":"于是仔细查看阿帕奇的装弹过程"},{"from":9.66,"to":11.96,"content":"发现炮弹并没有用弹链串联"},{"from":11.96,"to":13.8,"content":"那为啥叫链式机炮呢"},{"from":13.8,"to":15.38,"content":"该同学经搜索了解到"},{"from":15.38,"to":17.56,"content":"这是靠外部能源驱动的火炮"},{"from":17.56,"to":19.38,"content":"据说它不仅射击平稳"},{"from":19.38,"to":20.24,"content":"后坐力小"},{"from":20.24,"to":21.96,"content":"而且构造简单可靠"},{"from":21.96,"to":22.84,"content":"精度较高"},{"from":22.84,"to":24.62,"content":"被大量配备在步战车"},{"from":24.62,"to":26.44,"content":"武装直升机和舰船上"},{"from":26.44,"to":27.56,"content":"后来他又发现"},{"from":27.56,"to":30.28,"content":"链式机炮可以用套筒扳手带动机芯"},{"from":30.28,"to":31.48,"content":"慢悠悠的运转时"},{"from":31.48,"to":33.64,"content":"会发出稀里哗啦的链条声响"},{"from":33.64,"to":34.62,"content":"炮弹放进去"},{"from":34.62,"to":36.04,"content":"经过上膛和退膛"},{"from":36.04,"to":37.84,"content":"又被近弹轮给送了出来"},{"from":37.84,"to":39.96,"content":"看起来和普通机炮大不相同"},{"from":39.96,"to":42.9,"content":"并且很多链式机炮的尾部还有个指示盘"},{"from":42.9,"to":45.74,"content":"每射击一次盘子上的指针就转一圈"},{"from":45.74,"to":48.34,"content":"这些怪异现象让人看的莫名其妙"},{"from":48.34,"to":49.14,"content":"既然如此"},{"from":49.14,"to":51.24,"content":"本期我们就来攒一个链式机炮"},{"from":51.24,"to":52.38,"content":"以探其奥妙"},{"from":52.38,"to":55.7,"content":"开始前建议久坐的同学先用妙结肩颈按摩仪"},{"from":55.7,"to":56.94,"content":"缓缓他的力道"},{"from":56.94,"to":57.4,"content":"酸爽"},{"from":57.4,"to":58.24,"content":"配置厚道"},{"from":58.24,"to":58.94,"content":"无虚标"},{"from":58.94,"to":60.34,"content":"实打实的八个爪子"},{"from":60.34,"to":61.98,"content":"比我还熟悉肩膀穴位"},{"from":61.98,"to":64.099,"content":"裹住脖子一点点按走酸痛"},{"from":64.099,"to":66.459,"content":"往下还照顾到斜方肌富贵包"},{"from":66.459,"to":68.739,"content":"这手劲堪比力道十足的老师傅"},{"from":68.739,"to":70.859,"content":"是我用过最像人手的按摩仪"},{"from":70.859,"to":72.619,"content":"很多人长时间低头久坐"},{"from":72.619,"to":74.18,"content":"肩颈疲劳一天下来"},{"from":74.18,"to":75.38,"content":"后背又酸又硬"},{"from":75.38,"to":77.48,"content":"久而久之难免患上颈椎病"},{"from":77.48,"to":79.3,"content":"选个好的按摩仪很有必要"},{"from":79.3,"to":80.38,"content":"但品牌众多"},{"from":80.38,"to":81.62,"content":"质量良莠不齐"},{"from":81.62,"to":83.92,"content":"一不留神就会买到差的妙界"},{"from":83.92,"to":85.2,"content":"不仅能放松肩颈"},{"from":85.2,"to":88.44,"content":"平时运动健身后还能用热敷功能舒缓腰腿"},{"from":88.44,"to":89.2,"content":"三档力度"},{"from":89.2,"to":90.08,"content":"随心调节"},{"from":90.08,"to":91.24,"content":"全家用的开心"},{"from":91.24,"to":92.46,"content":"这小钱花的值"},{"from":92.46,"to":94.2,"content":"忙碌一天后挂在身上"},{"from":94.2,"to":96.24,"content":"既想舒爽按摩还不耽误做事"},{"from":96.24,"to":98.86,"content":"而且使用一段时间腰板会自然挺直"},{"from":98.86,"to":100.08,"content":"为你的气质加分"},{"from":100.08,"to":101.92,"content":"评论区置顶领取优惠券"},{"from":101.92,"to":103.56,"content":"依旧有保价和运险"},{"from":103.56,"to":104.36,"content":"两年质保"},{"from":104.36,"to":105.18,"content":"一年换新"},{"from":105.18,"to":108.14,"content":"中秋教师节赠送礼品就选它了"},{"from":108.14,"to":109.06,"content":"链式机炮"},{"from":109.06,"to":109.78,"content":"顾名思义"},{"from":109.78,"to":111.84,"content":"它的机芯都有一段封闭链条"},{"from":111.84,"to":114.84,"content":"一般是上下双排围成一个矩形四角"},{"from":114.84,"to":115.86,"content":"各有一个链轮"},{"from":115.86,"to":118.28,"content":"其中三个是用来支撑的从动轮"},{"from":118.28,"to":120.35,"content":"一个是用于驱动的主动轮"},{"from":120.35,"to":122.57,"content":"四个链轮用上下夹板定位"},{"from":122.57,"to":124.43,"content":"就组成了链条驱动支架"},{"from":124.43,"to":127.38,"content":"主动链轮被一个带齿轮箱的电机驱动"},{"from":127.38,"to":128.74,"content":"使链条转动起来"},{"from":128.74,"to":130.84,"content":"同时主链结上还有个凸起物"},{"from":130.84,"to":132.4,"content":"叫做栓座驱动滑块"},{"from":132.4,"to":134.98,"content":"它的作用就是带动这个炮栓支座"},{"from":134.98,"to":136.64,"content":"观察该栓做的底面"},{"from":136.64,"to":138.28,"content":"可见一条纵向浅槽"},{"from":138.28,"to":141.32,"content":"石栓座能卡在支架的滑轨上前后移动"},{"from":141.32,"to":143.64,"content":"同时前端还有一条横向深槽"},{"from":143.64,"to":146.5,"content":"正好和链条上的驱动滑块尺寸吻合"},{"from":146.5,"to":148,"content":"将栓座嵌入导轨"},{"from":148,"to":149.78,"content":"同时滑块嵌入深槽"},{"from":149.78,"to":151.76,"content":"发现当滑块向前运动时"},{"from":151.76,"to":152.93,"content":"会推动开槽"},{"from":152.93,"to":154.09,"content":"使栓座前进"},{"from":154.09,"to":156.33,"content":"当滑块到达前端转弯横移"},{"from":156.33,"to":158.49,"content":"就会顺槽运动而失去推力"},{"from":158.49,"to":160.18,"content":"直至再次转弯返回时"},{"from":160.18,"to":162,"content":"又继续推动栓座后移"},{"from":162,"to":165.3,"content":"因此滑块循环运动就可使栓座不断的暂停"},{"from":165.3,"to":166.03,"content":"并换下"},{"from":166.03,"to":167.43,"content":"之所以如此运动"},{"from":167.43,"to":170.27,"content":"是为了让栓座里插入的炮栓跟着移动"},{"from":170.27,"to":172.7,"content":"这个炮栓子上有个栓体导转销"},{"from":172.7,"to":174.76,"content":"正好卡在栓座的凸轮槽里"},{"from":174.76,"to":177.28,"content":"其尾部的塞子是撞针弹簧的挡板"},{"from":177.28,"to":179.44,"content":"中间插入的撞针带有击针柄"},{"from":179.44,"to":181.68,"content":"当栓座即将到达前止点时"},{"from":181.68,"to":183.3,"content":"栓体已经顶进炮膛"},{"from":183.3,"to":184.1,"content":"无法前进"},{"from":184.1,"to":185.94,"content":"导致栓座独自继续移动"},{"from":185.94,"to":187.22,"content":"而推动导转销"},{"from":187.22,"to":189.68,"content":"使插进膛里的炮栓在原地旋转"},{"from":189.68,"to":190.92,"content":"完成炮膛锁闭"},{"from":190.92,"to":192.08,"content":"而栓座后退时"},{"from":192.08,"to":193.54,"content":"导转销又反向移动"},{"from":193.54,"to":195.08,"content":"使栓体反旋开锁"},{"from":195.08,"to":196.96,"content":"并在后退时沟壳抽桶"},{"from":196.96,"to":198.92,"content":"但炮弹是如何激发的呢"},{"from":198.92,"to":200.4,"content":"观察栓做后部发现"},{"from":200.4,"to":202.14,"content":"当栓体被炮膛顶住"},{"from":202.14,"to":202.94,"content":"开始旋转"},{"from":202.94,"to":203.54,"content":"闭锁时"},{"from":203.54,"to":206.38,"content":"机真弹簧挡板会被栓作推挤前移"},{"from":206.38,"to":209.78,"content":"而里面的机针尾巴又被滑轨上的挡片顶住"},{"from":209.78,"to":210.64,"content":"无法前进"},{"from":210.64,"to":212.7,"content":"导致机针弹簧压缩蓄力"},{"from":212.7,"to":215.88,"content":"同时挡板和机针都被炮栓带动一起旋转"},{"from":215.88,"to":217.6,"content":"最终鸡真柄转过了劲"},{"from":217.6,"to":219.1,"content":"脱离挡板释放出去"},{"from":219.1,"to":220.72,"content":"所以观察栓体前端"},{"from":220.72,"to":222.32,"content":"发现他刚完成闭锁"},{"from":222.32,"to":223.78,"content":"撞针就弹了出来"},{"from":223.78,"to":227.22,"content":"接下来我们安装一个带分度传动机构的齿轮箱"},{"from":227.22,"to":230.36,"content":"分别带动靠上的拨弹轮和靠下的近弹轮"},{"from":230.36,"to":232.82,"content":"工作时拨弹轮持续旋转送弹"},{"from":232.82,"to":235.1,"content":"而炮弹滑到下侧的近弹轮后"},{"from":235.1,"to":237.86,"content":"会在栓座到达后止点时转动一次"},{"from":237.86,"to":239.7,"content":"让炮弹掉在炮栓面前"},{"from":239.7,"to":241.7,"content":"此时栓座开始前进推弹"},{"from":241.7,"to":245.14,"content":"于是上膛闭锁击发开锁抽壳"},{"from":245.14,"to":246.12,"content":"一气呵成"},{"from":246.12,"to":248.18,"content":"期间近弹轮就像死了一样"},{"from":248.18,"to":250.86,"content":"在分度传动机构控制下静止不动"},{"from":250.86,"to":252.4,"content":"等套栓弹壳走到后"},{"from":252.4,"to":254.8,"content":"指点近弹轮及时的送来下一发"},{"from":254.8,"to":256.88,"content":"并顺便将废桶推到旁边"},{"from":256.88,"to":258,"content":"再次进弹时"},{"from":258,"to":261.56,"content":"栓座上的抛筒挺杆就将废桶从管道顶出"},{"from":261.56,"to":262.52,"content":"由此可见"},{"from":262.52,"to":264.36,"content":"链式机炮虽然机械简单"},{"from":264.36,"to":266.2,"content":"但电气控制部件复杂"},{"from":266.2,"to":266.92,"content":"如果卡壳"},{"from":266.92,"to":268.74,"content":"很难确定卡在哪个环节"},{"from":268.74,"to":270.94,"content":"因此需要个指示盘工作时"},{"from":270.94,"to":272.34,"content":"指针会循环指示"},{"from":272.34,"to":273.56,"content":"激发进弹"},{"from":273.56,"to":275.4,"content":"推弹闭锁发射"},{"from":275.4,"to":276.04,"content":"开锁"},{"from":276.04,"to":277.96,"content":"抽筒和抛壳八个步骤"},{"from":277.96,"to":279.5,"content":"卡在哪里就敲哪里"},{"from":279.5,"to":280.54,"content":"轻松又方便"},{"from":280.54,"to":282,"content":"虽然链条转速有限"},{"from":282,"to":283.26,"content":"导致其射速偏低"},{"from":283.26,"to":285.9,"content":"但炮栓在到达止点时减速均匀"},{"from":285.9,"to":286.84,"content":"冲击较小"},{"from":286.84,"to":289.92,"content":"又让这种机炮的射击精度和可靠性更高"},{"from":289.92,"to":291.5,"content":"况且它还是电动的"},{"from":291.5,"to":293.6,"content":"因此比普通机炮更加低碳"},{"from":293.6,"to":297.12,"content":"环保是顺应时代老少咸宜的新能源火炮"}],"chapters":[],"acquisition":{"