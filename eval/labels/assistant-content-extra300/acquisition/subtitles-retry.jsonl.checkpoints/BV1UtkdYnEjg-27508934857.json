{"schemaVersion":1,"bvid":"BV1UtkdYnEjg","cid":27508934857,"subtitles":[{"from":0.1,"to":1.4,"content":"当你在一个洞穴"},{"from":1.4,"to":2.98,"content":"一个很深很窄"},{"from":2.98,"to":4.98,"content":"又全是水的洞内迷路的话"},{"from":4.98,"to":5.86,"content":"会怎样呢"},{"from":5.86,"to":7.1,"content":"恐慌无助"},{"from":7.1,"to":7.64,"content":"绝望"},{"from":7.64,"to":9.84,"content":"一瞬间会立刻占据你的大脑"},{"from":9.84,"to":13.45,"content":"这个场景在佛罗里达阴潮天坑就真的出现过"},{"from":13.45,"to":15.21,"content":"没错又是佛罗里达"},{"from":15.21,"to":16.61,"content":"又是阴曹天坑"},{"from":16.61,"to":17.85,"content":"上期我们刚刚讲过"},{"from":17.85,"to":20.37,"content":"一对好友在这个洞内诡异死掉的事儿"},{"from":20.37,"to":21.94,"content":"这期又有高手来了"},{"from":21.94,"to":23.46,"content":"关于鹰巢天坑的信息"},{"from":23.46,"to":24.9,"content":"看过上期视频的朋友"},{"from":24.9,"to":26.88,"content":"可以直接跳到人物部分继续看"},{"from":26.88,"to":29.39,"content":"或者您再重温一下洞穴信息也行"},{"from":29.39,"to":32.23,"content":"鹰巢天坑位于美国佛罗里达赫尔南多县"},{"from":32.23,"to":34.71,"content":"查萨霍维茨卡野生动物管理区内"},{"from":34.71,"to":35.59,"content":"从外表看"},{"from":35.59,"to":37.39,"content":"它是一个直径约50米"},{"from":37.39,"to":38.87,"content":"深约12米的池塘"},{"from":38.87,"to":41.07,"content":"但这个池塘底部却有一个通道"},{"from":41.07,"to":42.23,"content":"连着另一个世界"},{"from":42.23,"to":45.379,"content":"那里就是我们本期故事的发生地鹰巢洞"},{"from":45.379,"to":48.399,"content":"我们现在看到的图是鹰巢洞的剖面图"},{"from":48.399,"to":49.919,"content":"它最深93米"},{"from":49.919,"to":51.02,"content":"跨度1000米"},{"from":51.02,"to":52.9,"content":"洞穴总长度1600米"},{"from":52.9,"to":54.4,"content":"里面灌满了地下水"},{"from":54.4,"to":57.66,"content":"洞穴整体分上游下游以及中间的沙漏区"},{"from":57.66,"to":58.66,"content":"这三个部分"},{"from":58.66,"to":59.9,"content":"上游通道更长"},{"from":59.9,"to":61.58,"content":"但下游的结构更为复杂"},{"from":61.58,"to":63.15,"content":"也更容易出现事故"},{"from":63.15,"to":65.09,"content":"2004年6月12日中午"},{"from":65.09,"to":66.79,"content":"一对好友驱车来到这里"},{"from":66.79,"to":69.25,"content":"他们分别是36岁的约翰罗宾逊"},{"from":69.25,"to":70.66,"content":"一名电气工程师"},{"from":70.66,"to":72.82,"content":"以及44岁的克雷格西蒙"},{"from":72.82,"to":74.76,"content":"一家园林绿化公司的老板"},{"from":74.76,"to":77.66,"content":"两人今天要探索的区域是鹰巢天坑的下游"},{"from":77.66,"to":78.94,"content":"如果不出意外的话"},{"from":78.94,"to":79.92,"content":"一个半小时后"},{"from":79.92,"to":81.62,"content":"他们就能结束这场探险"},{"from":81.62,"to":83.5,"content":"两人相识虽然才两年多"},{"from":83.5,"to":85.62,"content":"但早已成了如期似交的朋友"},{"from":85.62,"to":86.46,"content":"您没听错"},{"from":86.46,"to":88.78,"content":"那就是如期似交的正经朋友"},{"from":88.78,"to":90.84,"content":"36岁的约翰虽然年轻一些"},{"from":90.84,"to":93.68,"content":"但他的洞穴潜水经验已经有将近10年"},{"from":93.68,"to":96.14,"content":"西蒙的许多动潜技术都是他教的"},{"from":96.14,"to":98.24,"content":"但西蒙该有的相关认证也都有"},{"from":98.24,"to":100.02,"content":"甚至在某种程度上来说"},{"from":100.02,"to":103.24,"content":"只有两年经验的他比约翰更适合洞穴潜水"},{"from":103.24,"to":105.78,"content":"因为半年前两人在一处洞穴潜水时"},{"from":105.78,"to":108.78,"content":"经验丰富的约翰在水下突然爆发恐慌症"},{"from":108.78,"to":110.24,"content":"他拿掉自己的呼吸器"},{"from":110.24,"to":111.949,"content":"并朝西蒙乱踢乱抓"},{"from":111.949,"to":114.869,"content":"最后经验偏少的西蒙却凭借冷静的表现"},{"from":114.869,"to":115.86,"content":"把他救了出来"},{"from":115.86,"to":117.04,"content":"也因为这件事"},{"from":117.04,"to":119.7,"content":"再加上约翰这人的行事风格比较鲁莽"},{"from":119.7,"to":122.82,"content":"西蒙的妻子就反对丈夫再跟着约翰潜水"},{"from":122.82,"to":124.42,"content":"说万一哪天你被他坑了"},{"from":124.42,"to":126.2,"content":"我带着三个孩子该怎么过"},{"from":126.2,"to":127.94,"content":"西蒙理解妻子的担心"},{"from":127.94,"to":129.44,"content":"当时他也跟妻子保证"},{"from":129.44,"to":131.61,"content":"以后绝不再跟约翰一起潜水"},{"from":131.61,"to":132.97,"content":"谁知道几个月后"},{"from":132.97,"to":136.01,"content":"刚刚恢复的约翰就再次邀请西蒙一起潜水"},{"from":136.01,"to":137.75,"content":"目的地就是阴曹天坑"},{"from":137.75,"to":139.97,"content":"开始时西蒙直接拒绝了啊"},{"from":139.97,"to":141.05,"content":"因为妻子不愿意啊"},{"from":141.05,"to":142.83,"content":"可后来约翰跟他抱怨说"},{"from":142.83,"to":144.19,"content":"自己邀请了很多人"},{"from":144.19,"to":145.87,"content":"但没有一个人愿意陪他去"},{"from":145.87,"to":147.31,"content":"约翰非常伤心"},{"from":147.31,"to":149.11,"content":"西蒙听后也非常为难"},{"from":149.11,"to":150.93,"content":"他不想让老婆孩子担心"},{"from":150.93,"to":152.959,"content":"但也不想看到好友如此失落"},{"from":152.959,"to":153.859,"content":"纠结之后"},{"from":153.859,"to":155.559,"content":"西蒙还是选择了朋友"},{"from":155.559,"to":157.559,"content":"为此两口子还大吵一架"},{"from":157.559,"to":158.5,"content":"但吵归吵"},{"from":158.5,"to":159.38,"content":"两人出发后"},{"from":159.38,"to":160.76,"content":"妻子还是很担心的"},{"from":160.76,"to":164.26,"content":"他一直打电话叮嘱西蒙要记得随时汇报情况"},{"from":164.26,"to":167.519,"content":"西蒙欣然同意到达阴曹天坑的停车场后"},{"from":167.519,"to":169.41,"content":"两人立刻开始往下搬装备"},{"from":169.41,"to":172.95,"content":"受天气水流以及一种粉类化合物单宁的影响"},{"from":172.95,"to":175.32,"content":"这天的鹰巢天坑内水流变浑浊"},{"from":175.32,"to":177.3,"content":"又带着一点诡异的蓝黑色"},{"from":177.3,"to":178.2,"content":"腐烂的食物"},{"from":178.2,"to":181.17,"content":"不知名的虫子尸体在池塘处随处可见"},{"from":181.17,"to":183.79,"content":"所以潜完水一定要好好保养一下皮肤"},{"from":183.79,"to":184.59,"content":"说到这里啊"},{"from":184.59,"to":186.07,"content":"又懒又想变帅的兄弟们"},{"from":186.07,"to":188.59,"content":"海洋至尊就为咱们专门研究了一款新品"},{"from":188.59,"to":189.71,"content":"海洋至尊多效"},{"from":189.71,"to":191.6,"content":"如不管你是油脂分泌旺盛"},{"from":191.6,"to":193.58,"content":"粗糙暗沉还是干燥紧绷"},{"from":193.58,"to":195.86,"content":"它都能帮你全面改善肌肤状态"},{"from":195.86,"to":196.86,"content":"这款多效乳啊"},{"from":196.86,"to":199,"content":"目前排在某猫热销榜单第一名"},{"from":199,"to":200.92,"content":"全网累计热卖4万多瓶"},{"from":200.92,"to":201.72,"content":"简单来说"},{"from":201.72,"to":203.58,"content":"这是一款六效合一的产品"},{"from":203.58,"to":206.62,"content":"核心成分神经酰胺粒子依克多因和泛醇"},{"from":206.62,"to":209.24,"content":"真正做到28天有效改善肌肤屏障"},{"from":209.24,"to":212.14,"content":"比市面上保湿修护舒缓类产品的作用"},{"from":212.14,"to":213.22,"content":"链路更加多重"},{"from":213.22,"to":216.04,"content":"另外还有2%的自研专利控油组合物"},{"from":216.04,"to":217.18,"content":"以及八重玻尿酸"},{"from":217.18,"to":218.88,"content":"全方位调节水油平衡"},{"from":218.88,"to":220.08,"content":"再看它的外包装"},{"from":220.08,"to":221.24,"content":"线条流畅自然"},{"from":221.24,"to":222.26,"content":"科技感很强"},{"from":222.26,"to":224,"content":"它的质地也是非常轻薄"},{"from":224,"to":226.38,"content":"一抹化开上脸感受冰冰凉凉"},{"from":226.38,"to":227.48,"content":"很容易被吸收"},{"from":227.48,"to":230.16,"content":"吐完之后皮肤轻松变得水润有光泽"},{"from":230.16,"to":232.18,"content":"这还是一款美修全绿的产品"},{"from":232.18,"to":233.9,"content":"不管你是干皮还是油皮"},{"from":233.9,"to":235.48,"content":"都可以一瓶轻松搞定"},{"from":235.48,"to":236.88,"content":"主打一个简单高效"},{"from":236.88,"to":238.68,"content":"购买链接放在评论区置顶啊"},{"from":238.68,"to":240.38,"content":"还有大额优惠券可以领"},{"from":240.38,"to":240.96,"content":"放心冲"},{"from":240.96,"to":241.44,"content":"兄弟们"},{"from":241.44,"to":241.98,"content":"有了它"},{"from":241.98,"to":243.63,"content":"您就可以放心潜水了"},{"from":243.63,"to":245.47,"content":"经过一个小时的准备后"},{"from":245.47,"to":246.17,"content":"下午一点"},{"from":246.17,"to":248.2,"content":"西蒙与约翰正式潜入水中"},{"from":248.2,"to":250,"content":"在减压点放好减压瓶后"},{"from":250,"to":251.52,"content":"他们顺利穿过烟囱通道"},{"from":251.52,"to":252.56,"content":"进入了宴会厅"},{"from":252.56,"to":253.66,"content":"这个空间很大"},{"from":253.66,"to":254.56,"content":"也很漆黑"},{"from":254.56,"to":255.8,"content":"宽约45米"},{"from":255.8,"to":257.3,"content":"正下方有个沙石堆"},{"from":257.3,"to":260.46,"content":"石堆顶部还立着一块带有死神图案的警示牌"},{"from":260.46,"to":262.66,"content":"两人在这里又放置了两个减压瓶"},{"from":262.66,"to":264.28,"content":"然后开始往下游游去"},{"from":264.28,"to":265.82,"content":"在接下来的半小时里"},{"from":265.82,"to":269.19,"content":"他们顺着引导绳一路游过了大空间深渊通道"},{"from":269.19,"to":270.45,"content":"约翰的口袋入口"},{"from":270.45,"to":271.05,"content":"吉姆市"},{"from":271.05,"to":271.99,"content":"半月市等地"},{"from":271.99,"to":273.79,"content":"最后成功来到下游的尽头"},{"from":273.79,"to":274.6,"content":"梦幻屋"},{"from":274.6,"to":276.08,"content":"在这里停留一会儿后"},{"from":276.08,"to":278.7,"content":"他们于01:40分左右开始原路返回"},{"from":278.7,"to":280.12,"content":"回去时西蒙在前"},{"from":280.12,"to":280.98,"content":"约翰在后"},{"from":280.98,"to":284.54,"content":"很快两人就来到了被称为约翰的口袋的地方啊"},{"from":284.54,"to":286.08,"content":"这里其实是一个岔路口"},{"from":286.08,"to":288.15,"content":"要从俯视图上才能看得出来"},{"from":288.15,"to":290.59,"content":"约翰的口袋就是这块突出的空间"},{"from":290.59,"to":292.62,"content":"形状很像是一个口袋啊"},{"from":292.62,"to":294.4,"content":"至于为什么叫约翰的口袋空间"},{"from":294.4,"to":295.7,"content":"待会儿您就明白了"},{"from":295.7,"to":297.32,"content":"为了方便大家后面理解"},{"from":297.32,"to":299.46,"content":"我把这个口袋空间的俯视图部分"},{"from":299.46,"to":301.4,"content":"直接加到了剖面图上啊"},{"from":301.4,"to":303.49,"content":"大家知道这里是怎么回事就行了"},{"from":303.49,"to":304.97,"content":"按两人预定的路线"},{"from":304.97,"to":307.25,"content":"他们只是从口袋空间的入口经过"},{"from":307.25,"to":308.58,"content":"并不会进入里面"},{"from":308.58,"to":309.98,"content":"但在西蒙进入深渊"},{"from":309.98,"to":311.12,"content":"通道往上爬时"},{"from":311.12,"to":313.8,"content":"在岔路口等待的约翰突然有了一个想法"},{"from":313.8,"to":316.42,"content":"他想去旁边这个口袋空间看看啊"},{"from":316.42,"to":317.789,"content":"万一能给它命个名呢"},{"from":317.789,"to":320.429,"content":"于是他竟然在没有告诉西蒙的情况下"},{"from":320.429,"to":321.829,"content":"就直接钻了进去"},{"from":321.829,"to":325.18,"content":"另一边西蒙终于艰难地从深渊通道爬了出来"},{"from":325.18,"to":327.02,"content":"可当他回头时却没有发现"},{"from":327.02,"to":329.06,"content":"约翰考虑到约翰有恐慌症"},{"from":329.06,"to":329.82,"content":"容易出事"},{"from":329.82,"to":331.82,"content":"西蒙只得掉头回去找他"},{"from":331.82,"to":334.74,"content":"此时的约翰正在口袋空间里欣赏着美景"},{"from":334.74,"to":336.62,"content":"跟上期视频里的两人一样"},{"from":336.62,"to":339.7,"content":"他俩的装备也是一套全封闭式循环呼吸器"},{"from":339.7,"to":340.68,"content":"两个侧装气瓶"},{"from":340.68,"to":342.409,"content":"再加一个水下推进器"},{"from":342.409,"to":344.569,"content":"而意外就跟这个推进器有关"},{"from":344.569,"to":347.98,"content":"这种推进器依靠电力驱动螺旋桨在水中前进"},{"from":347.98,"to":350.18,"content":"它能在提高潜水员速度的同时"},{"from":350.18,"to":352.18,"content":"还能帮潜水员节省很多体力"},{"from":352.18,"to":354.3,"content":"进而让潜水者节省减压时间"},{"from":354.3,"to":356.33,"content":"以及减少携带的气瓶重量"},{"from":356.33,"to":359.06,"content":"所以在深度潜水时他很受欢迎"},{"from":359.06,"to":361.08,"content":"但水下推进器也有它的弊端"},{"from":361.08,"to":362.76,"content":"尤其是在洞穴潜水中"},{"from":362.76,"to":364.02,"content":"比如在比较狭窄"},{"from":364.02,"to":366.52,"content":"淤泥又多的通道带着它不仅不好"},{"from":366.52,"to":367.96,"content":"通过转动的螺旋桨"},{"from":367.96,"to":369.08,"content":"还会搅起沉积物"},{"from":369.08,"to":370.66,"content":"导致周围的能见度变差"},{"from":370.66,"to":374.08,"content":"而这个口袋空间里恰好就是淤泥较多的情况"},{"from":374.08,"to":377.32,"content":"所以推进器的螺旋桨再加约翰自己的游动"},{"from":377.32,"to":379.62,"content":"地上的沉积物很快就被搅动起来"},{"from":379.62,"to":381.86,"content":"约翰的四周立刻变得浑浊不堪"},{"from":381.86,"to":383.18,"content":"他试图退出这里"},{"from":383.18,"to":385.2,"content":"可是根本看不清出口在哪"},{"from":385.2,"to":386.3,"content":"于是约翰也没关"},{"from":386.3,"to":387.48,"content":"就扔掉了推进器"},{"from":387.48,"to":389.47,"content":"他试图顺着引导绳往外爬"},{"from":389.47,"to":391.93,"content":"可不知道是绳子上缺少方向标识"},{"from":391.93,"to":393.94,"content":"还是他根本就没有找到绳子"},{"from":393.94,"to":396.06,"content":"总之在此后的20多分钟里"},{"from":396.06,"to":397.24,"content":"约翰被困在里面"},{"from":397.24,"to":398.48,"content":"始终没能出去"},{"from":398.48,"to":399.66,"content":"在气体耗尽后"},{"from":399.66,"to":400.84,"content":"他就死在了那里"},{"from":400.84,"to":402.06,"content":"后来警方推测"},{"from":402.06,"to":403.76,"content":"口袋空间其实并不大"},{"from":403.76,"to":405.86,"content":"约翰应该是恐慌症又发作了"},{"from":405.86,"to":408.48,"content":"否则的话不可能那么久都找不到出口"},{"from":408.48,"to":411.86,"content":"而外面的西蒙这时还在往洞穴深处寻找约翰"},{"from":411.86,"to":413.65,"content":"但他注定是一无所获"},{"from":413.65,"to":414.31,"content":"没多久"},{"from":414.31,"to":415.85,"content":"他来到了拜月室区域"},{"from":415.85,"to":418.17,"content":"在这里引导绳出现了几个分叉"},{"from":418.17,"to":420.72,"content":"它们分别指向周围的几个小型空间"},{"from":420.72,"to":421.5,"content":"不幸的是"},{"from":421.5,"to":423.24,"content":"可能是西蒙太着急赶路"},{"from":423.24,"to":424.4,"content":"他经过这里时"},{"from":424.4,"to":426.84,"content":"身上的装备恰好被这些绳子缠住"},{"from":426.84,"to":428.51,"content":"约翰试图把绳子解开"},{"from":428.51,"to":429.55,"content":"可一番操作后"},{"from":429.55,"to":431.41,"content":"他整个人反而都被缠住了"},{"from":431.41,"to":433.29,"content":"最后他也因为氧气耗尽"},{"from":433.29,"to":434.31,"content":"死在了这里"},{"from":434.31,"to":436.03,"content":"时间来到了下午03:30"},{"from":436.03,"to":436.71,"content":"公园入口"},{"from":436.71,"to":437.51,"content":"登机处的人"},{"from":437.51,"to":440.39,"content":"看西蒙两人一直没有在离开的位置处签名"},{"from":440.39,"to":442.86,"content":"就委托一名潜水员过去查看情况"},{"from":442.86,"to":444.84,"content":"那名潜水员到达鹰巢天坑后"},{"from":444.84,"to":446.32,"content":"发现他们的汽车还在"},{"from":446.32,"to":448.6,"content":"但减压点的气瓶却没有被使用过"},{"from":448.6,"to":450.12,"content":"他意识到情况不妙"},{"from":450.12,"to":451.93,"content":"于是立刻选择了报警"},{"from":451.93,"to":454.45,"content":"随后美国洞穴潜水界的先驱人物"},{"from":454.45,"to":458.049,"content":"保罗海纳斯以及西蒙的妻子都赶到了鹰巢天坑"},{"from":458.049,"to":458.749,"content":"入水前"},{"from":458.749,"to":460.569,"content":"保罗还向西蒙的妻子保证"},{"from":460.569,"to":462.98,"content":"自己一定会把她的丈夫带回来的"},{"from":462.98,"to":465.22,"content":"可因为没有人知道他们的潜水计划"},{"from":465.22,"to":467.62,"content":"所以搜救队一直到第二天下午才发现"},{"from":467.62,"to":468.5,"content":"约翰的尸体"},{"from":468.5,"to":470.45,"content":"他依然在那个口袋空间内"},{"from":470.45,"to":472.79,"content":"之后搜救人员在附近找了一圈"},{"from":472.79,"to":473.99,"content":"但没有发现西蒙"},{"from":473.99,"to":476.52,"content":"他们只得先把约翰的尸体运出去"},{"from":476.52,"to":478.22,"content":"在两人潜水的第三天"},{"from":478.22,"to":479.88,"content":"当地忽然下起了暴雨"},{"from":479.88,"to":481.18,"content":"因为洞内比较浑浊"},{"from":481.18,"to":482.19,"content":"不适合救援"},{"from":482.19,"to":484.11,"content":"所以搜救行动也暂停一天"},{"from":484.11,"to":485.45,"content":"第四天雨停后"},{"from":485.45,"to":487.919,"content":"保罗等人再次进入洞内寻找西蒙"},{"from":487.919,"to":490.899,"content":"终于他们在半月室里发现了西蒙的尸体"},{"from":490.899,"to":492.579,"content":"当消息传回水面后"},{"from":492.579,"to":494.619,"content":"西蒙的妻子立刻昏迷过去"},{"from":494.619,"to":496.88,"content":"他最担心的事还是发生了"},{"from":496.88,"to":497.4,"content":"之后"},{"from":497.4,"to":498.96,"content":"搜救队又花了两天时间"},{"from":498.96,"to":500.88,"content":"才把西蒙的尸体打捞上来"},{"from":500.88,"to":502.7,"content":"到此这场耗时三天"},{"from":502.7,"to":505.84,"content":"出动了40名潜水员的搜救行动也宣告结束"},{"from":505.84,"to":509.52,"content":"后来经过尸检发现两人的死因都是缺氧后溺水"},{"from":512.7,"to":514.04,"content":"但从残留量来看"},{"from":514.04,"to":516.54,"content":"这应该是他在潜水的前几天吸的"},{"from":516.54,"to":516.96,"content":"那时"},{"from":516.96,"to":520.289,"content":"恰好也是他在妻子和朋友间左右为难的时候"},{"from":520.289,"to":523.809,"content":"但警方认为这并不影响到他当天的潜水活动"},{"from":526.98,"to":527.7,"content":"到这里"},{"from":527.7,"to":529.72,"content":"其实阴曹洞的故事并未结束"},{"from":529.72,"to":531.12,"content":"因为在之后的时间里"},{"from":531.12,"to":533.2,"content":"又有七人相继死在了里面"},{"from":533.2,"to":535.28,"content":"这也使得阴曹洞的总遇难人数"},{"from":535.28,"to":536.74,"content":"达到了12人之多"},{"from":536.74,"to":538.62,"content":"不过考虑到大家有可能会对"},{"from":538.62,"to":540.32,"content":"这个洞穴出现审美疲劳"},{"from":540.32,"to":543.16,"content":"所以其他事件我就不再单独拿出来讲了"},{"from":543.16,"to":546.62,"content":"下期我会把剩下的十集放在一块全部讲完"},{"from":546.62,"to":549.2,"content":"这样也算是凑够阴曹三部曲了"},{"from":549.2,"to":549.72,"content":"好了"},{"from":549.72,"to":551.76,"content":"那本期视频到这里就全部结束了"},{"from":551.76,"to":552.92,"content":"感谢各位的观看"},{"from":552.92,"to":554.38,"content":"我们下期再见"}],"chapters":[{"from":0,"to":22,"content":"引子"},{"from":22,"to":63,"content":"洞穴介绍"},{"from":63,"to":243,"content":"人物及背景"},{"from":243,"to":434,"content":"过程"},{"from":434,"to":506,"content":"救援"},{"from":506,"to":555,"content":"后续"}],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:30:22.399Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"available","chaptersFetchedAt":"2026-10-04T23:30:16.820Z"}}
