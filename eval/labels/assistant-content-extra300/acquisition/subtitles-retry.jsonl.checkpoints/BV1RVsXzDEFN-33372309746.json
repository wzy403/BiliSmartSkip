{"schemaVersion":1,"bvid":"BV1RVsXzDEFN","cid":33372309746,"subtitles":[{"from":3.84,"to":7.72,"content":"1942年11月28日晚上10.15分"},{"from":7.72,"to":8.73,"content":"感恩节"},{"from":8.73,"to":10.81,"content":"美国波士顿的消防员查尔斯"},{"from":10.81,"to":12.35,"content":"肯尼接到了一个任务"},{"from":12.35,"to":15.44,"content":"去当地的斯图尔特街处理一起火灾"},{"from":15.44,"to":16.58,"content":"碰见有个火警"},{"from":16.58,"to":18.34,"content":"报警箱发生了报警"},{"from":18.34,"to":19.88,"content":"查尔斯来到现场"},{"from":19.88,"to":21.979,"content":"发现是有辆车燃了起来"},{"from":21.979,"to":24.859,"content":"节日期间经常都会有点小事故"},{"from":24.859,"to":26.239,"content":"好在火势不大"},{"from":26.239,"to":28.48,"content":"他很快就把火扑灭了"},{"from":28.48,"to":30.78,"content":"而正当他准备返程时"},{"from":30.78,"to":34.36,"content":"他听到不远处另一个火警警报也响了起来"},{"from":34.36,"to":37.629,"content":"然后周边的多个报警箱都开始报警"},{"from":37.629,"to":38.809,"content":"什么情况"},{"from":38.809,"to":41.609,"content":"当时美国火警分了五个等级"},{"from":41.609,"to":44.31,"content":"第一二级的火灾规模通常不大"},{"from":44.31,"to":46.71,"content":"但到了第三集就十分严重"},{"from":46.71,"to":50.44,"content":"需要大量的设备和人力来扑灭新的告警示"},{"from":50.44,"to":51.4,"content":"三级警报"},{"from":51.4,"to":52.62,"content":"查尔斯赶紧救"},{"from":52.62,"to":54.25,"content":"驾车向前方赶去"},{"from":54.25,"to":56.11,"content":"大概开出了几10米"},{"from":56.11,"to":59.27,"content":"广播里传出了调度员惊慌的喊叫声"},{"from":59.27,"to":61.57,"content":"椰林俱乐部需要增援"},{"from":61.57,"to":62.709,"content":"需要增援"},{"from":62.709,"to":65.349,"content":"紧跟着他就听到火警警报"},{"from":65.349,"to":67.509,"content":"由三级升到了四级"},{"from":67.509,"to":69.82,"content":"又过了一会儿升到了五级"},{"from":69.82,"to":72.06,"content":"查尔斯只感到一股寒意"},{"from":72.06,"to":73.1,"content":"爬上了脊背"},{"from":73.1,"to":75.24,"content":"到底前面出什么事了"},{"from":75.24,"to":76.88,"content":"欢迎来到三更研究所"},{"from":76.88,"to":80.3,"content":"今天我们将介绍美国最严重的夜总会火灾"},{"from":80.3,"to":82.82,"content":"野野岭俱乐部大火"},{"from":82.98,"to":84.44,"content":"节目正式开始之前"},{"from":84.44,"to":86.5,"content":"先感谢我们老朋友转转的赞助"},{"from":86.5,"to":89.38,"content":"想问下大家平时的闲置物品都是怎么处理"},{"from":89.38,"to":91.34,"content":"像我都会叫个转转上门回收"},{"from":91.34,"to":92.88,"content":"他家回收品类很丰富"},{"from":92.88,"to":93.58,"content":"小到平板"},{"from":93.58,"to":95.08,"content":"笔记本这种数码产品"},{"from":95.08,"to":97.64,"content":"大到空气净化器之类的家用电器"},{"from":97.64,"to":100.36,"content":"甚至就连黄金奢侈品都能上门回收"},{"from":100.36,"to":101.08,"content":"价格满意"},{"from":101.08,"to":101.88,"content":"现场打钱"},{"from":101.88,"to":103.94,"content":"这比我挨个挂网上卖效率高多了"},{"from":103.94,"to":105.22,"content":"既不用拍照修图"},{"from":105.22,"to":106.76,"content":"又不用跟人扯皮讲价"},{"from":106.76,"to":109.6,"content":"特别适合我这种想卖闲置又怕麻烦的人"},{"from":109.6,"to":111.78,"content":"像我这次收拾出了七八件闲置"},{"from":111.78,"to":112.94,"content":"总共卖了1万多呢"},{"from":112.94,"to":114.46,"content":"总之有东西要回收"},{"from":114.46,"to":116.94,"content":"找转转这种大平台就对了"},{"from":116.94,"to":120.86,"content":"1942年11月28日晚上9.15分"},{"from":120.86,"to":122.82,"content":"火灾发生在一个小时前"},{"from":122.82,"to":126.48,"content":"18岁的乔伊斯斯佩克特显得特别心烦"},{"from":126.48,"to":129.2,"content":"今晚她准备拉着自己的男友贾斯汀"},{"from":129.2,"to":131.64,"content":"到椰林俱乐部共度良宵"},{"from":131.64,"to":132.62,"content":"一年前"},{"from":132.62,"to":134.8,"content":"美国刚经历了珍珠港事件"},{"from":134.8,"to":136.38,"content":"面对未知的战局"},{"from":136.38,"to":139.019,"content":"每人都笼罩在战争的阴霾之下"},{"from":139.019,"to":140.419,"content":"因此每到周末"},{"from":140.419,"to":144.73,"content":"光是顿然都喜欢到夜店消遣短暂的忘记烦恼"},{"from":144.73,"to":146.05,"content":"20世纪初"},{"from":146.05,"to":147.47,"content":"只要你是波士顿人"},{"from":147.47,"to":150.07,"content":"就一定听过椰林俱乐部证件"},{"from":150.07,"to":152.59,"content":"号称是美国天上人间的夜总会"},{"from":152.59,"to":154.76,"content":"坐落在波士顿的市中心"},{"from":154.76,"to":156.84,"content":"它有着跨时代的设计"},{"from":156.84,"to":159.9,"content":"椰林俱乐部的正门位于皮德蒙特街"},{"from":159.9,"to":162.42,"content":"是一扇十分阔气的旋转门"},{"from":162.42,"to":164.98,"content":"进入以后是主大厅行走"},{"from":164.98,"to":168.14,"content":"其中会看到大厅里满是奢华的家具"},{"from":168.14,"to":170.54,"content":"还布置有大量的人造棕榈树"},{"from":170.54,"to":172.28,"content":"充满了热带风情"},{"from":172.28,"to":175.66,"content":"主厅的中央设有一个巨大的木质舞池"},{"from":175.66,"to":177.96,"content":"舞池的顶部是个伸缩屋顶"},{"from":177.96,"to":179.8,"content":"天气晴朗时能打开"},{"from":179.8,"to":182.03,"content":"让宾客们在烦心下跳舞"},{"from":182.03,"to":184.01,"content":"舞厅旁有两个酒吧区"},{"from":184.01,"to":186.95,"content":"分别是漫画酒吧与百老汇酒廊"},{"from":186.95,"to":191.24,"content":"散生门的左手方有一条通往地下室的楼梯"},{"from":191.24,"to":194.36,"content":"地下室里设有一间宽阔的旋律酒廊"},{"from":194.36,"to":195.51,"content":"一间厨房"},{"from":195.51,"to":198.43,"content":"这里也是俱乐部最受欢迎的区域之一"},{"from":198.43,"to":201.959,"content":"旋律酒廊从地板到天花板只有2米多高"},{"from":201.959,"to":204.91,"content":"天花板上悬挂着蓝色的布艺装饰"},{"from":204.91,"to":206.63,"content":"顾客们从楼梯下来"},{"from":206.63,"to":207.67,"content":"便从波士顿"},{"from":207.67,"to":211.65,"content":"灰蒙蒙的街道被带入到一个永远是午夜的酒廊"},{"from":211.65,"to":214.16,"content":"尤其适合热恋的情侣"},{"from":214.16,"to":216.26,"content":"晚上09:30左右"},{"from":216.26,"to":219.28,"content":"乔伊斯与男友从旋转门进入到俱乐部"},{"from":219.28,"to":220.56,"content":"两人一路往下"},{"from":220.56,"to":220.84,"content":"来"},{"from":220.84,"to":222.67,"content":"到了地下室的旋律酒廊"},{"from":222.67,"to":224.16,"content":"听人点了杯酒"},{"from":224.16,"to":226.44,"content":"这两天俱乐部的生意特别好"},{"from":226.44,"to":227.96,"content":"顾客们源源不断"},{"from":227.96,"to":231.42,"content":"一楼的舞厅餐厅酒廊里全是人"},{"from":231.42,"to":233.04,"content":"根据后来的统计"},{"from":233.04,"to":236.5,"content":"英联俱乐部公开的容纳人数是460人"},{"from":236.5,"to":238.86,"content":"但当晚几薪的约1000人"},{"from":238.86,"to":240.4,"content":"好不容易挤进来"},{"from":240.4,"to":242.93,"content":"乔伊斯两人感觉自己还挺幸运"},{"from":242.93,"to":244.79,"content":"然而他们完全不知道"},{"from":244.79,"to":248.56,"content":"一场旷世灾难很快就会降临"},{"from":248.56,"to":249.92,"content":"哼了一会儿脚"},{"from":249.92,"to":251.98,"content":"晚上10:13分左右"},{"from":251.98,"to":254.75,"content":"乔伊斯看见了一个奇怪的场景"},{"from":254.75,"to":257.63,"content":"他见到有位服务员在不断的尝试"},{"from":257.63,"to":260.07,"content":"往棕榈树上换上一颗新的灯泡"},{"from":260.07,"to":262.33,"content":"但可能是因为周围太暗了"},{"from":262.33,"to":264.01,"content":"他始终也没法换好"},{"from":264.01,"to":266.37,"content":"于是服务员就点燃那根火柴"},{"from":266.37,"to":268.659,"content":"竟是光把灯泡给装上"},{"from":268.659,"to":270.259,"content":"而就在这时"},{"from":270.259,"to":273.019,"content":"乔伊斯看见旁边的人造棕榈树"},{"from":273.019,"to":275.62,"content":"似乎有两片叶子燃了起来"},{"from":275.62,"to":277.56,"content":"一旁的工作人员发现不对"},{"from":277.56,"to":279.38,"content":"赶紧用水来灭火"},{"from":279.38,"to":281.62,"content":"可小火不但没被扑灭"},{"from":281.62,"to":284.13,"content":"反倒开始顺着棕绿树往上爬"},{"from":284.13,"to":285.73,"content":"紧跟着噗的一声"},{"from":285.73,"to":289.27,"content":"整片天花板就像涂满了酒精的棉花一样"},{"from":289.27,"to":291.26,"content":"瞬间全部燃了起来"},{"from":291.26,"to":293.76,"content":"什么东西为啥这么快"},{"from":293.76,"to":295.62,"content":"乔伊斯听到有人在尖叫"},{"from":295.62,"to":297.28,"content":"情火辣情火了"},{"from":297.28,"to":298.86,"content":"她还没反应过来"},{"from":298.86,"to":300.44,"content":"就被男友一把抓住"},{"from":300.44,"to":302.47,"content":"迅速的往楼梯口逃跑"},{"from":302.47,"to":304.35,"content":"许多人在楼梯上摔倒"},{"from":304.35,"to":305.71,"content":"被众人踩踏"},{"from":305.71,"to":307.039,"content":"凄厉哀嚎"},{"from":307.039,"to":308.639,"content":"在巨大的混乱中"},{"from":308.639,"to":310.119,"content":"乔伊斯逃到了一楼"},{"from":310.119,"to":312.539,"content":"他下意识的回头看了下楼梯"},{"from":312.539,"to":314.87,"content":"整个人差点凝固了"},{"from":314.87,"to":317.95,"content":"楼梯的下面已经被黑色的烟雾灌满"},{"from":317.95,"to":321,"content":"而烟雾里有一个巨大的火球"},{"from":321,"to":325,"content":"正沿着楼梯向他们所在的位置滚了过来"},{"from":325,"to":328.23,"content":"这个火焰会追着人走"},{"from":328.23,"to":330.27,"content":"晚上10.16分"},{"from":330.27,"to":332.97,"content":"正在椰林俱乐部一楼玩耍的宾客们"},{"from":332.97,"to":335.549,"content":"东听到楼下传来了一阵骚动"},{"from":335.549,"to":337.549,"content":"接着就惊恐的看到"},{"from":337.549,"to":341.93,"content":"从楼梯口里冲出了一股铺天盖地的烟雾"},{"from":341.93,"to":344.23,"content":"他们还没搞懂发生了什么"},{"from":344.23,"to":346.47,"content":"竟我看到烟雾所到之处"},{"from":346.47,"to":347.21,"content":"楼梯口"},{"from":347.21,"to":350.65,"content":"舞厅入口一瞬间连环爆燃起来"},{"from":350.65,"to":352.91,"content":"站在门口的人瞬间着火"},{"from":352.91,"to":354.55,"content":"连叫都没叫出来"},{"from":354.55,"to":356.9,"content":"就倒在地上疯狂挣扎"},{"from":356.9,"to":358.7,"content":"火势的扩张极快"},{"from":358.7,"to":360.4,"content":"舞厅里的人造棕榈树"},{"from":360.4,"to":363.74,"content":"木质家具顷刻间全都化为火海"},{"from":363.74,"to":364.72,"content":"趴地上"},{"from":364.72,"to":366.7,"content":"整个房子的电力也断了"},{"from":366.7,"to":368.63,"content":"大厅里漆黑一片"},{"from":368.63,"to":370.43,"content":"火灾生火啦"},{"from":370.43,"to":373.55,"content":"俱乐部里到处都在爆发恐惧的尖叫"},{"from":373.55,"to":374.71,"content":"在黑暗里"},{"from":374.71,"to":377.16,"content":"人群开始疯狂奔逃"},{"from":377.44,"to":379.08,"content":"普通顾客想要逃离"},{"from":379.08,"to":379.6,"content":"俱乐部"},{"from":379.6,"to":381.08,"content":"有两扇门可以走"},{"from":381.08,"to":383.98,"content":"其中的一个是皮德蒙特街的主入口"},{"from":383.98,"to":386.13,"content":"另一个是百老汇街的后门"},{"from":386.13,"to":390.15,"content":"乔伊斯跟着人群准备往皮德蒙特街的入口逃跑"},{"from":390.15,"to":391.53,"content":"可刚跑到门口"},{"from":391.53,"to":392.78,"content":"队伍就停了"},{"from":392.78,"to":394.42,"content":"乔伊斯往前面一看"},{"from":394.42,"to":396.18,"content":"一下子尖叫起来"},{"from":396.18,"to":397.94,"content":"正是一扇旋转门"},{"from":397.94,"to":401.5,"content":"他看见有几个人的上半身已经冲出了门外"},{"from":401.5,"to":404.38,"content":"但下半身还被卡在旋转门里"},{"from":404.38,"to":406.68,"content":"随着身后的人不断推挤"},{"from":406.68,"to":408.26,"content":"门被越卡越死"},{"from":408.26,"to":410.36,"content":"被卡住的人扭动着身体"},{"from":410.36,"to":412.5,"content":"发出不像是人的尖叫"},{"from":412.5,"to":413.5,"content":"有人大喊"},{"from":413.5,"to":414.44,"content":"别过来了"},{"from":414.44,"to":415.24,"content":"别过来"},{"from":415.24,"to":419.32,"content":"但后面的人还在源源不断的涌过来"},{"from":419.32,"to":422,"content":"波士顿商业区的第一个活性警报"},{"from":422,"to":425.409,"content":"于11月28日晚上10:15分响起"},{"from":425.409,"to":429.009,"content":"附近的消防员才开始以为只是发生了小火灾"},{"from":429.009,"to":432.56,"content":"但很快周围的所有消防箱都开始报警"},{"from":432.56,"to":434.72,"content":"消防局这才惊恐地发现"},{"from":434.72,"to":437.61,"content":"当地知名的椰林俱乐部起火了"},{"from":437.61,"to":440.19,"content":"该俱乐部占地超过1000平方米"},{"from":440.19,"to":441.15,"content":"来到现场"},{"from":441.15,"to":444.66,"content":"消防员看到整个建筑四面八方都在冒烟"},{"from":444.66,"to":447.38,"content":"有的地方火焰已经开始往外冒"},{"from":447.38,"to":449.7,"content":"烟雾笼罩了小半个天空"},{"from":449.7,"to":452.22,"content":"与俱乐部相连的有三条街道"},{"from":452.22,"to":453.66,"content":"包括肖默特街"},{"from":453.66,"to":456.1,"content":"百老汇街与皮德蒙特街"},{"from":456.1,"to":458.84,"content":"每条街都分别有一个主出入口"},{"from":458.84,"to":461.74,"content":"他们首先赶到了皮德蒙特街的正门"},{"from":461.74,"to":465.1,"content":"刚靠近就倒吸了一口凉气"},{"from":465.1,"to":469.299,"content":"俱乐部的正门是一扇一米多宽的旋转门"},{"from":469.299,"to":473.619,"content":"他们看见在旋转门里堆起着2米多高的人体"},{"from":473.619,"to":476.479,"content":"大约有30几个人在门口挤成一团"},{"from":476.479,"to":478.12,"content":"化作了一堵人墙"},{"from":478.12,"to":481.2,"content":"有的尸体像被绳子扎好的香肠一样"},{"from":481.2,"to":483.75,"content":"腰部被门勒成了一条细线"},{"from":483.75,"to":486.13,"content":"火焰在不断的往门口燃烧"},{"from":486.13,"to":489.419,"content":"一些没死透的人正在凄厉哀嚎"},{"from":489.419,"to":493.82,"content":"他们不知道还有多少人被困在门的后面"},{"from":494.1,"to":496.78,"content":"11月28日晚上10.24分"},{"from":496.78,"to":499.66,"content":"消防局将警报油三级升成四级"},{"from":499.66,"to":501.28,"content":"再迅速升到五级"},{"from":501.28,"to":504.64,"content":"这恐怕是波士顿史无前例的火灾"},{"from":504.64,"to":508.42,"content":"因为皮德蒙特街的旋转门已经被完全堵死"},{"from":508.42,"to":512.14,"content":"香火队来到了百老汇街与萧默特街的两个出口"},{"from":512.14,"to":513.48,"content":"可来到现场"},{"from":513.48,"to":517.34,"content":"他们发现这里的两扇门也都被堵死了"},{"from":517.34,"to":520.14,"content":"正是因为两扇门全是内开门"},{"from":520.14,"to":521.7,"content":"在火灾发生当时"},{"from":521.7,"to":524.16,"content":"惊慌的人群向着门边涌入"},{"from":524.16,"to":527.94,"content":"可因为内开门与人群流动的方向是反的"},{"from":527.94,"to":529.98,"content":"前面的人想要把门打开"},{"from":529.98,"to":533.2,"content":"却被后面源源不断惊恐的人压住"},{"from":533.2,"to":537.05,"content":"所有的人像一捆一捆的木柴一样堆在了一起"},{"from":537.05,"to":539.91,"content":"在萧默特间的门旁有一排窗户"},{"from":539.91,"to":541.83,"content":"也有人想要砸窗逃生"},{"from":541.83,"to":543.22,"content":"可砸开玻璃后"},{"from":543.22,"to":545.04,"content":"氧气大量进入现场"},{"from":545.04,"to":546.76,"content":"又发生了闪然爆炸"},{"from":546.76,"to":548.76,"content":"他们被贴在窗户上烤熟"},{"from":548.76,"to":551.1,"content":"堵住了其他人的生路"},{"from":551.1,"to":553.7,"content":"石英点铃木凡总共有25次"},{"from":553.7,"to":555.3,"content":"消防队陆续赶到现场"},{"from":555.3,"to":557,"content":"因为找不到疏散考"},{"from":557,"to":560,"content":"整个建筑成了一个密闭的烤炉"},{"from":560,"to":563.52,"content":"空气里已经在传出一种烤肉的味道"},{"from":563.52,"to":566.94,"content":"消防队只有一点一点的砸坏门和墙壁"},{"from":566.94,"to":568.82,"content":"想办法把人往外面拖"},{"from":568.82,"to":570.88,"content":"并且向屋内不断的浇水"},{"from":570.88,"to":574.42,"content":"但水在接触高温以后又会产生大量的水蒸气"},{"from":574.42,"to":576.52,"content":"把受困者烫得哇哇大叫"},{"from":576.52,"to":578.16,"content":"他们只能眼睁睁的看着"},{"from":578.16,"to":581.03,"content":"里面的人被大火活活烘烤"},{"from":581.03,"to":584.71,"content":"起初许多幸存者还在里面呼喊尖叫"},{"from":584.71,"to":586.01,"content":"但过了一阵子"},{"from":586.01,"to":588.4,"content":"所有声音都戛然而止"},{"from":588.4,"to":590.3,"content":"晚上10.55分"},{"from":590.3,"to":592.46,"content":"火灾发生的约40分钟后"},{"from":592.46,"to":594.66,"content":"正门的旋转门终于被砸开"},{"from":594.66,"to":596.68,"content":"火情也逐渐受到控制"},{"from":596.68,"to":600.42,"content":"而接下来是梗心碎的巡视过程"},{"from":600.42,"to":602.38,"content":"从旋转门进入"},{"from":602.38,"to":603.78,"content":"里面叠了五层"},{"from":603.78,"to":604.48,"content":"人体"},{"from":604.48,"to":606.48,"content":"身体完全堵塞通道"},{"from":606.48,"to":609.68,"content":"消防员必须先将遗体一个一个的拖走"},{"from":609.68,"to":611.34,"content":"清理出一条路来"},{"from":611.34,"to":614.48,"content":"平均每个消防员要搬走20具尸体"},{"from":614.48,"to":617.84,"content":"由叫做康诺利的警官连续搬了15分钟"},{"from":617.84,"to":619.819,"content":"被烟熏得昏死在地"},{"from":619.819,"to":622.919,"content":"他在被人救活以后爬起来说了一句"},{"from":622.919,"to":623.899,"content":"我得回去"},{"from":623.899,"to":625.69,"content":"继母再次返回救人"},{"from":625.69,"to":627.47,"content":"花费了约半个小时"},{"from":627.47,"to":629.579,"content":"他们来到了主厅的内部"},{"from":629.579,"to":631.299,"content":"这里全是浓烟"},{"from":631.299,"to":632.819,"content":"伸手不见五指"},{"from":632.819,"to":635.039,"content":"除了火苗的噼啪声以外"},{"from":635.039,"to":637.04,"content":"现场一片死寂"},{"from":637.04,"to":638.64,"content":"刚打开手电筒"},{"from":638.64,"to":641.24,"content":"他们就看到了一个震撼的画面"},{"from":641.24,"to":643.569,"content":"在漫画酒吧与窗口间"},{"from":643.569,"to":646.169,"content":"一大堆的尸体清晰可见"},{"from":646.169,"to":647.809,"content":"这应该是在停电后"},{"from":647.809,"to":649.12,"content":"屋里一片漆黑"},{"from":649.12,"to":651.22,"content":"受害者们看到窗外有光线"},{"from":651.22,"to":653.1,"content":"就急匆往窗口逃生"},{"from":653.1,"to":655.32,"content":"但窗户外覆盖着铁栅栏"},{"from":655.32,"to":657.14,"content":"他们根本就无法出去"},{"from":657.14,"to":659.89,"content":"有的人当场被烤成了焦炭"},{"from":659.89,"to":661.31,"content":"再往里走"},{"from":661.31,"to":663.25,"content":"原本的舞厅餐厅"},{"from":663.25,"to":664.59,"content":"百老汇酒廊"},{"from":664.59,"to":668.1,"content":"从地板到天花板几乎全被烧毁"},{"from":668.1,"to":669.26,"content":"走到这里"},{"from":669.26,"to":671.72,"content":"消防员也开始不断的被绊倒"},{"from":671.72,"to":673.02,"content":"往下一照"},{"from":673.02,"to":674.8,"content":"地下密密麻麻"},{"from":674.8,"to":676.88,"content":"全是被烧死的受害者"},{"from":676.88,"to":680.11,"content":"很多尸体甚至与家具粘在一起"},{"from":680.11,"to":681.59,"content":"检查完的主厅"},{"from":681.59,"to":684.349,"content":"他们开始忐忑地前往地下室"},{"from":684.349,"to":686.569,"content":"从一楼到地下室的楼梯"},{"from":686.569,"to":689.51,"content":"需要先走完一个15米的U型转弯"},{"from":689.51,"to":691.33,"content":"走到转弯的尽头"},{"from":691.33,"to":692.99,"content":"众人没法动了"},{"from":692.99,"to":697.27,"content":"这段只有1.2米宽的楼梯里全是人"},{"from":697.27,"to":699.73,"content":"经过清理一个小时后"},{"from":699.73,"to":702.91,"content":"消防队终于来到了地下室的旋律酒廊"},{"from":702.91,"to":705.37,"content":"这里同样有满地的遗体"},{"from":705.37,"to":706.67,"content":"可奇怪的是"},{"from":706.67,"to":709.43,"content":"九郎的燃烧并没有想象的那么严重"},{"from":709.43,"to":711.27,"content":"而他们再往深处走"},{"from":711.27,"to":714.22,"content":"看到了一个极其诡异的场景"},{"from":714.22,"to":717.16,"content":"他们看到有的受害者还坐在座位上"},{"from":717.16,"to":719.4,"content":"保持着端起杯子的姿势"},{"from":719.4,"to":722.28,"content":"但显然早已死透了"},{"from":722.56,"to":723.6,"content":"据统计"},{"from":723.6,"to":726.12,"content":"当晚来到椰林俱乐部的宾客数量"},{"from":726.12,"to":728.4,"content":"大约为800~1000人"},{"from":728.4,"to":730.8,"content":"其中只有很少数逃了出来"},{"from":730.8,"to":733.42,"content":"逃出的基本都是熟悉地形的员工"},{"from":733.42,"to":736.11,"content":"与部分和员工一起行动的人"},{"from":736.11,"to":740.33,"content":"有少数人从地下室厨房旁边的一扇小窗户逃走"},{"from":740.33,"to":742.74,"content":"有人躲冰柜里逃过一劫"},{"from":742.74,"to":746.74,"content":"但绝大部分的宾客都堆积在了三道门前"},{"from":746.74,"to":750.05,"content":"被活活烧死或者挤压致死"},{"from":750.05,"to":751.77,"content":"当晚12点前后"},{"from":751.77,"to":755.579,"content":"遇难者的遗体被一排一排的摆在马路上"},{"from":755.579,"to":759.159,"content":"而在被送往波士顿医院的300多名伤者中"},{"from":759.159,"to":761.98,"content":"180人在到院以前就死亡"},{"from":761.98,"to":765.37,"content":"另有约40人在数日内相继死去"},{"from":765.37,"to":767.21,"content":"波士顿周日广告报"},{"from":767.21,"to":770.57,"content":"用了四个整版刊登了火灾遇难者的信息"},{"from":770.57,"to":772.2,"content":"根据最终统计"},{"from":772.2,"to":775.08,"content":"事故总计死亡人数为492人"},{"from":775.08,"to":776.96,"content":"重伤166人"},{"from":776.96,"to":780.56,"content":"是美国有史以来最严重的夜总会火灾"},{"from":781.68,"to":784.98,"content":"次日国家消防协会就展开了调查"},{"from":784.98,"to":786.96,"content":"专家组在调查时发现"},{"from":786.96,"to":789.72,"content":"瞬间里存在很多反常的地方"},{"from":789.72,"to":792.91,"content":"首先正常火灾的速度非常快"},{"from":792.91,"to":795.77,"content":"从火灾发生到消防员赶到现场"},{"from":795.77,"to":798.09,"content":"总共只花了10分钟的时间"},{"from":798.09,"to":801.19,"content":"但大火却已经几乎烧遍了整个建筑"},{"from":801.19,"to":804.65,"content":"另外为什么绝大部分的人都会卡在门前"},{"from":804.65,"to":805.55,"content":"俱乐部里"},{"from":805.55,"to":807.37,"content":"是否还有其他的出口"},{"from":807.37,"to":809.17,"content":"但是一大堆的问题"},{"from":809.17,"to":812.11,"content":"调查组进行了长达数个月的取证"},{"from":812.11,"to":815.87,"content":"最后他们得到了一个骇人听闻的真相"},{"from":817.47,"to":820.14,"content":"英灵俱乐部始建于1927年"},{"from":820.14,"to":822.72,"content":"所有者叫做巴黎维兰斯基"},{"from":822.72,"to":824.42,"content":"是俄罗斯籍移民"},{"from":824.42,"to":825.9,"content":"他有黑帮背景"},{"from":825.9,"to":828.39,"content":"在当地黑白两道都有人脉"},{"from":828.39,"to":830.35,"content":"巴尼一直以来的梦想"},{"from":830.35,"to":832.93,"content":"就是设计出全城最好的夜店"},{"from":832.93,"to":835.9,"content":"让宾客感受天上人间的服务"},{"from":835.9,"to":839.08,"content":"椰林俱乐部原本的位置是个修车厂"},{"from":839.08,"to":840.46,"content":"班尼把他接手过来"},{"from":840.46,"to":841.92,"content":"进行了全面的改造"},{"from":841.92,"to":846.27,"content":"打造出了一个以热带异域风情为主题的夜总会"},{"from":846.27,"to":847.53,"content":"因为地段好"},{"from":847.53,"to":848.63,"content":"风格独特"},{"from":848.63,"to":850.31,"content":"班尼又利用自己的人脉"},{"from":850.31,"to":852.19,"content":"邀请大量的名流来捧场"},{"from":852.19,"to":854.34,"content":"俱乐部的生意蒸蒸日上"},{"from":854.34,"to":855.26,"content":"几年间"},{"from":855.26,"to":857.72,"content":"巴你又买下了旁边的数个门面"},{"from":857.72,"to":860.52,"content":"将俱乐部从原本的480平米"},{"from":860.52,"to":864.13,"content":"扩展成了一个约1000平米的大型夜总会"},{"from":864.13,"to":867.41,"content":"渐渐的椰林俱乐部的名气越来越大"},{"from":867.41,"to":872.15,"content":"成了全波士顿乃至全美都数一数二的娱乐场所"},{"from":872.15,"to":876.47,"content":"然而没有人知道郑谦外表豪华的俱乐部里"},{"from":876.47,"to":879.069,"content":"隐藏着多么可怕的问题"},{"from":879.069,"to":882.709,"content":"班尼在店里采用恐怖管理及切运作"},{"from":882.709,"to":883.989,"content":"必须由他来决定"},{"from":883.989,"to":885.76,"content":"因为是黑帮律师出身"},{"from":885.76,"to":889.54,"content":"他在意怎么以最低的成本塞下更多的顾客"},{"from":889.54,"to":891.64,"content":"以及防止有人逃票闹事"},{"from":891.64,"to":894.78,"content":"基本就没考虑过怎么去防火的问题"},{"from":894.78,"to":897.08,"content":"俱乐部的前身是汽修厂"},{"from":897.08,"to":900.52,"content":"本身就不是为了公共聚集人群所设计的"},{"from":900.52,"to":902.3,"content":"后面并购了其他的门面"},{"from":902.3,"to":905.56,"content":"也没有进行过任何重新的整体性设计"},{"from":905.56,"to":908.14,"content":"宾客们能看到的地方大气美观"},{"from":908.14,"to":911.94,"content":"但看不到的地方存在大量以往建筑留下的隔间"},{"from":911.94,"to":912.94,"content":"衣帽间等"},{"from":912.94,"to":914.62,"content":"就跟迷宫一样"},{"from":914.62,"to":916.82,"content":"逃生通道没有任何指引"},{"from":916.82,"to":919,"content":"电路布线全是飞线"},{"from":919,"to":920.48,"content":"防火门太贵了"},{"from":920.48,"to":921.86,"content":"竟用时间没装"},{"from":921.86,"to":923.32,"content":"而更可怕的是"},{"from":923.32,"to":926.24,"content":"调查组检查了俱乐部内的15种材料"},{"from":926.24,"to":928.74,"content":"包括旋律九廊天花板的绸布"},{"from":928.74,"to":930.4,"content":"人造棕榈叶的塑料"},{"from":930.4,"to":932.3,"content":"以及面部建筑里的藤条"},{"from":932.3,"to":933.46,"content":"竹子等装饰"},{"from":933.46,"to":936.849,"content":"发现所有材料全部是超易燃物"},{"from":936.849,"to":939.63,"content":"另外二战期间氟利昂十分昂贵"},{"from":939.63,"to":943.15,"content":"俱乐部的空调系统采用了易燃的炉架"},{"from":943.15,"to":944.21,"content":"碗来作为替代"},{"from":944.21,"to":947.16,"content":"连舞厅里的气体也是易燃气体"},{"from":947.16,"to":951.54,"content":"整个俱乐部本身就是一个随时就绪的烤炉"},{"from":951.54,"to":953.48,"content":"在好几年的时间里"},{"from":953.48,"to":956.98,"content":"当地的消防部门也多次要求俱乐部进行整改"},{"from":956.98,"to":959.2,"content":"但老板巴尼遵守遮天"},{"from":959.2,"to":960.66,"content":"黑白两道都熟"},{"from":963.32,"to":965.7,"content":"每次检查都能蒙混过关"},{"from":965.7,"to":967.86,"content":"在火灾发生的十天前"},{"from":967.86,"to":971.34,"content":"消防局还有一名队长对椰林酒吧进行过检查"},{"from":971.34,"to":975.72,"content":"最后出具了一份俱乐部的防火能力良好的报告"},{"from":975.72,"to":977,"content":"11月28日"},{"from":977,"to":977.54,"content":"当晚"},{"from":977.54,"to":979.6,"content":"波士顿正好有棒球比赛"},{"from":979.6,"to":983.26,"content":"班尼为此请了很多的明星来俱乐部里大搞晚会"},{"from":983.26,"to":986.58,"content":"因此当晚俱乐部聚集了约1000名客人"},{"from":986.58,"to":988.56,"content":"包括了各界的社会名流"},{"from":988.56,"to":990.24,"content":"来凑热闹的年轻人"},{"from":990.24,"to":994.4,"content":"从战场上回来的士兵党老板巴尼当晚没在现场"},{"from":994.4,"to":997.49,"content":"他让弟弟詹姆斯在现场进行监督"},{"from":997.49,"to":999.71,"content":"火灾发生于一件小事"},{"from":999.71,"to":1002.13,"content":"大约晚上10:13分左右"},{"from":1002.13,"to":1004.1,"content":"在地下室的旋律酒廊里"},{"from":1004.1,"to":1006.38,"content":"某个男顾客与身边的女伴聊"},{"from":1006.38,"to":1009.8,"content":"高兴了就顺手把旁边的灯泡给拧了"},{"from":1009.8,"to":1013.43,"content":"想要创造一个更有利于情感表达的氛围"},{"from":1013.43,"to":1015.51,"content":"旋律酒廊里本来就昏暗"},{"from":1015.51,"to":1019.26,"content":"灯泡一背宁夏周围瞬间就暗的一大片"},{"from":1019.26,"to":1023.48,"content":"酒保看到后就叫16岁的服务员斯坦利去处理"},{"from":1023.48,"to":1024.82,"content":"因为太黑了"},{"from":1024.82,"to":1026.54,"content":"斯坦利看不清楚灯座"},{"from":1026.54,"to":1028.889,"content":"就点燃了一根火柴借光"},{"from":1028.889,"to":1031.449,"content":"可他一不小心就把火柴碰到了"},{"from":1031.449,"to":1033.45,"content":"旁边的人造棕榈树上"},{"from":1033.45,"to":1035.61,"content":"树上全是易燃装饰品"},{"from":1035.61,"to":1036.67,"content":"一经着火"},{"from":1036.67,"to":1039.849,"content":"火苗迅速沿着树顶向天花板攀爬"},{"from":1039.849,"to":1041.349,"content":"斯坦利返回灭火"},{"from":1041.349,"to":1043.099,"content":"但已经来不及了"},{"from":1043.099,"to":1045.839,"content":"在天花板上挂满了蓝色的织布"},{"from":1045.839,"to":1049.099,"content":"吊顶里面又存在部分独家版气体"},{"from":1049.099,"to":1051.039,"content":"因为可燃材料充足"},{"from":1051.039,"to":1052.44,"content":"又有助燃剂"},{"from":1052.44,"to":1055.6,"content":"火苗刚碰到楼顶就发生了爆炸案"},{"from":1055.6,"to":1057.74,"content":"形成了一个巨大的火球"},{"from":1057.74,"to":1061.54,"content":"距离火源近的人被直接碳化呼吸道与肺部"},{"from":1061.54,"to":1063.9,"content":"在吸入了高温的浓烟以后被烧穿"},{"from":1063.9,"to":1065.9,"content":"还保持着端杯子的姿势"},{"from":1065.9,"to":1067.34,"content":"就一下子死亡"},{"from":1067.34,"to":1070.36,"content":"距离远点的人开始疯狂逃命"},{"from":1070.36,"to":1072.46,"content":"因为地下室的空高很低"},{"from":1072.46,"to":1073.58,"content":"氧气有限"},{"from":1073.58,"to":1076.87,"content":"最大的氧气源就是通往一楼的楼梯"},{"from":1076.87,"to":1077.95,"content":"很短的时间"},{"from":1077.95,"to":1080.39,"content":"火焰就沿着天花板向楼梯扩散"},{"from":1080.39,"to":1084.03,"content":"因此火灾的起点反倒没有受到严重的焚毁"},{"from":1084.03,"to":1086.33,"content":"而楼梯里是个密闭空间"},{"from":1086.33,"to":1089.15,"content":"大火在楼梯中形成了烟囱效应"},{"from":1089.15,"to":1092.76,"content":"高达千度的过热气体和烟雾向上冲去"},{"from":1092.76,"to":1095.48,"content":"瞬间把一楼的天花板也给引燃了"},{"from":1095.48,"to":1098.51,"content":"然后开始朝着主厅的各区蔓延"},{"from":1098.51,"to":1101.77,"content":"整个舞厅的顶部都装满了大量的布条"},{"from":1101.77,"to":1104.44,"content":"墙壁上又装满了易燃的装饰品"},{"from":1104.44,"to":1107.16,"content":"大火一烧过去就形成火雨"},{"from":1107.16,"to":1108.35,"content":"往下降落"},{"from":1108.35,"to":1111.91,"content":"一楼舞厅的人们心情还以为是某种表演"},{"from":1111.91,"to":1113.25,"content":"然而几秒之后"},{"from":1113.25,"to":1115.32,"content":"他们就开始恐惧的哀嚎"},{"from":1115.32,"to":1117.78,"content":"因为楼里的电线全是飞线"},{"from":1117.78,"to":1119.58,"content":"大火一烧直接断了"},{"from":1119.58,"to":1121.11,"content":"四周一片漆黑"},{"from":1121.11,"to":1122.89,"content":"建筑里没有灭火系统"},{"from":1122.89,"to":1125.4,"content":"顾客们也根本无法自救"},{"from":1125.4,"to":1127.7,"content":"俱乐部里一共有八个出口"},{"from":1127.7,"to":1130.28,"content":"可当晚实际开放的只有两个"},{"from":1130.28,"to":1132.12,"content":"一个是正门的旋转门"},{"from":1132.12,"to":1134.34,"content":"另一个是百老汇街的后门"},{"from":1134.34,"to":1136.86,"content":"为了防止人们不付钱就离开"},{"from":1136.86,"to":1139.84,"content":"巴尼下令锁住了八个出口中的六个"},{"from":1139.84,"to":1140.9,"content":"他不但锁门"},{"from":1140.9,"to":1142.12,"content":"还用衣帽架子"},{"from":1142.12,"to":1143.16,"content":"窗帘来遮挡"},{"from":1143.16,"to":1145.55,"content":"让顾客毫无可乘之机"},{"from":1145.55,"to":1147.89,"content":"旋律九郎到一楼的楼梯口"},{"from":1147.89,"to":1150.13,"content":"本来直接就有个紧急出口"},{"from":1150.13,"to":1152.38,"content":"但这扇门被上了五把锁"},{"from":1152.38,"to":1154.78,"content":"舞厅旁边的肖姆特间的门"},{"from":1154.78,"to":1156.88,"content":"本来也是被藏在窗帘后面的"},{"from":1156.88,"to":1158.36,"content":"但看到发生了火灾"},{"from":1158.36,"to":1160.25,"content":"工作人员就把门弄了出来"},{"from":1160.25,"to":1163.93,"content":"神牛也开始往三个看得见的出口逃跑"},{"from":1163.93,"to":1166.62,"content":"门口安排的一些服务员不知道情况"},{"from":1166.62,"to":1168.44,"content":"看到这么多人跑了出来"},{"from":1168.44,"to":1170.44,"content":"还想要拦住客人付费"},{"from":1170.44,"to":1173.4,"content":"结果瞬间就被众人踩踏而过"},{"from":1173.4,"to":1175.889,"content":"皮德蒙特街的正门是旋转门"},{"from":1175.889,"to":1179.389,"content":"在设计上根本无法同时间通过太多宾客"},{"from":1179.389,"to":1182.71,"content":"直接就被涌入的人群用身体卡死"},{"from":1182.71,"to":1185.43,"content":"而另外的两扇门全是内开门"},{"from":1185.43,"to":1187.97,"content":"跟人群的移动路径是相反的"},{"from":1187.97,"to":1189.17,"content":"门刚被打开"},{"from":1189.17,"to":1191.81,"content":"竟被后面看不到情况的人起到关闭"},{"from":1191.81,"to":1193.37,"content":"更多的人也涌上来"},{"from":1193.37,"to":1194.17,"content":"压在一起"},{"from":1194.17,"to":1195.639,"content":"彻底把门堵死"},{"from":1195.639,"to":1198.039,"content":"因为门窗位置的氧气更多"},{"from":1198.039,"to":1199.959,"content":"火焰也朝着门窗蔓延"},{"from":1199.959,"to":1202.52,"content":"大部分堵在门口的人都死了"},{"from":1202.52,"to":1204.44,"content":"而老板的弟弟詹姆斯"},{"from":1204.44,"to":1206.64,"content":"不小心点火的服务员斯坦利"},{"from":1206.64,"to":1210.02,"content":"还有许多员工分别从各个隐藏的出口逃出"},{"from":1210.02,"to":1211.46,"content":"幸运的获救"},{"from":1212.1,"to":1213.54,"content":"1943年"},{"from":1213.54,"to":1215.26,"content":"在波士顿当地法院"},{"from":1215.26,"to":1215.86,"content":"俱乐部"},{"from":1215.86,"to":1219.66,"content":"老板巴尼韦兰斯基被以19项过失杀人罪"},{"from":1219.66,"to":1222.07,"content":"判处了12到15年监禁"},{"from":1222.07,"to":1224.25,"content":"之所以是19项善罪"},{"from":1224.25,"to":1226.29,"content":"是因为死的人太多了"},{"from":1226.29,"to":1229.929,"content":"因此法院随机选了19个受害者来执行判罚"},{"from":1229.929,"to":1231.949,"content":"巴妮在服刑近4年后"},{"from":1231.949,"to":1233.789,"content":"就在监狱里患上了癌症"},{"from":1236.089,"to":1237.429,"content":"在获释的九个月后"},{"from":1237.429,"to":1239.2,"content":"他就因病去世"},{"from":1239.2,"to":1241.7,"content":"点火的服务员斯坦利被调查"},{"from":1241.7,"to":1244.36,"content":"但考虑到火灾的主要原因是"},{"from":1244.36,"to":1246.92,"content":"俱乐部的整体防火有巨大缺陷"},{"from":1246.92,"to":1248.58,"content":"斯坦利没有被判刑"},{"from":1248.58,"to":1251.6,"content":"而那个拟下灯泡的宾客到底是谁"},{"from":1251.6,"to":1253.37,"content":"至今也没法确定"},{"from":1253.37,"to":1255.77,"content":"由于接连俱乐部几乎被摧毁"},{"from":1255.77,"to":1258.29,"content":"能用于赔偿的金额所剩无几"},{"from":1258.29,"to":1259.85,"content":"最后每位遇难者"},{"from":1259.85,"to":1263.09,"content":"仅获得了约150美元的赔偿"},{"from":1263.24,"to":1266.48,"content":"在波士顿甚至整个世界的火灾史上"},{"from":1266.48,"to":1269.96,"content":"英灵俱乐部火灾都是个让人恐慌的事件"},{"from":1269.96,"to":1271.96,"content":"该事件的影响巨大"},{"from":1271.96,"to":1272.78,"content":"在事后"},{"from":1272.78,"to":1275.36,"content":"波士顿当局颁布了一项永久禁令"},{"from":1275.36,"to":1278.659,"content":"辖区内的任何场所不能使用椰林的名字"},{"from":1278.659,"to":1281.059,"content":"它也促使美国乃至全世界"},{"from":1281.059,"to":1284.72,"content":"对公共场所的消防规范进行了一系列的改革"},{"from":1284.72,"to":1288.51,"content":"包括禁止公共聚集场所使用易燃装饰品"},{"from":1288.51,"to":1291.01,"content":"禁止使用内开式的安全出口门"},{"from":1291.01,"to":1292.87,"content":"并要求安全出口的标志"},{"from":1292.87,"to":1294.88,"content":"必须要有独立的电源照明"},{"from":1294.88,"to":1296.86,"content":"在浓烟里也能进行辨认"},{"from":1296.86,"to":1300.56,"content":"可以说与我们今天的生活也息息相关"},{"from":1300.84,"to":1303.18,"content":"1942年11月28日"},{"from":1303.18,"to":1305.84,"content":"乔伊斯幸运的在火灾里活了下来"},{"from":1305.84,"to":1308.34,"content":"她的男友为了救她被烧死了"},{"from":1308.34,"to":1311.32,"content":"乔伊斯逃到了旋转门旁边的一扇侧门"},{"from":1311.32,"to":1313.99,"content":"被消防员抓住头发拖出了房子"},{"from":1313.99,"to":1317.06,"content":"幸好乔伊斯患上了严重的心理创伤"},{"from":1317.06,"to":1318.02,"content":"但多年来"},{"from":1318.02,"to":1321.28,"content":"他一直帮助调查者回忆当晚的种种细节"},{"from":1321.28,"to":1324.46,"content":"他也成为了后来最关键的目击者之一"},{"from":1324.46,"to":1326.9,"content":"一位叫做约翰纽希的幸存者"},{"from":1326.9,"to":1330.85,"content":"在尸骨里全身超过了55%的烧伤音乐"},{"from":1330.85,"to":1333.25,"content":"使用了从来没有民用过的青霉素"},{"from":1333.25,"to":1334.36,"content":"对它进行了治疗"},{"from":1334.36,"to":1336.28,"content":"正在后续影响了全世界"},{"from":1336.28,"to":1339.64,"content":"医疗界处理严重烧伤患者的流程和规范"},{"from":1339.64,"to":1343.07,"content":"约翰在历经上百次手术以后艰难康复"},{"from":1343.07,"to":1344.45,"content":"但很不幸的是"},{"from":1344.45,"to":1345.73,"content":"在14年后"},{"from":1345.73,"to":1349.81,"content":"约翰因意外在一次车祸里被烧死了"},{"from":1349.81,"to":1351.15,"content":"2024年"},{"from":1351.15,"to":1353.51,"content":"乔伊斯在马赛诸塞州去世"},{"from":1353.51,"to":1354.87,"content":"享年100岁"},{"from":1354.87,"to":1358.889,"content":"目前灾难里唯一的幸存者是罗伯特舒姆韦"},{"from":1358.889,"to":1361.869,"content":"他是最后一个与事件相关的人"},{"from":1361.869,"to":1363.149,"content":"在他死后"},{"from":1363.149,"to":1366.81,"content":"所有一零火灾的亲历者都将离开人世"},{"from":1366.81,"to":1370.98,"content":"但这场可怕的灾难值得被每个人牢记"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:26:22.357Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:26:16.746Z"}}
