{"schemaVersion":1,"bvid":"BV1JLsjeNEr8","cid":500001662574721,"subtitles":[{"from":5.76,"to":8.64,"content":"这是一艘维斯比级隐身护卫舰"},{"from":8.64,"to":10.34,"content":"是瑞典海军的主力舰艇"},{"from":10.34,"to":11.96,"content":"从外形上就可以看出"},{"from":11.96,"to":14.11,"content":"维斯比奇不是一艘普通的军舰"},{"from":14.11,"to":15.63,"content":"其船身设计新颖"},{"from":15.63,"to":17.29,"content":"线条轮廓极其简洁"},{"from":17.29,"to":18.6,"content":"科技感十足"},{"from":18.6,"to":21.2,"content":"隐身能力是该级舰艇的重中之重"},{"from":21.2,"to":24.77,"content":"维斯比级是世界上第一艘投入使用的隐身战舰"},{"from":24.77,"to":26.01,"content":"但作为护卫舰"},{"from":26.01,"to":28.85,"content":"维斯比级的尺寸可以说是相当迷你了"},{"from":28.85,"to":30.11,"content":"其长72米"},{"from":30.11,"to":31.39,"content":"宽10.4米"},{"from":31.39,"to":33.37,"content":"满载排水量仅有620吨"},{"from":33.37,"to":35.31,"content":"但就是这样一艘迷你小军舰"},{"from":35.31,"to":36.59,"content":"可是价格不菲"},{"from":36.59,"to":38.85,"content":"每艘造价高达1.84亿美元"},{"from":38.85,"to":39.84,"content":"对比之下"},{"from":39.84,"to":43.44,"content":"美国海军建造的最后一级护卫舰佩里级"},{"from":43.44,"to":45.32,"content":"每艘只要1.22亿美元"},{"from":45.32,"to":48.16,"content":"但佩里级的吨位瑞典小艇的七倍"},{"from":48.16,"to":50.08,"content":"如果按照每吨造价来对比的话"},{"from":50.08,"to":53,"content":"维斯比级的价格甚至比同样是隐身战舰的"},{"from":53,"to":54.31,"content":"珠穆尔特旗还高"},{"from":54.31,"to":56.6,"content":"基本上是单位造价最高的舰艇了"},{"from":56.6,"to":59.02,"content":"瑞典海军一共建造了五艘维斯比奇"},{"from":59.02,"to":61.7,"content":"光是建造成本就达到了9.2亿美元"},{"from":61.7,"to":64.629,"content":"算上研发成本轻松突破10亿美元"},{"from":64.629,"to":67.009,"content":"虽然和其他动辄几10亿的舰艇相比"},{"from":67.009,"to":68.329,"content":"好像也不是很多"},{"from":68.329,"to":71.75,"content":"但这笔开支对于瑞典海军来说已经不算少了"},{"from":71.75,"to":74.95,"content":"毕竟目前瑞典海军吨位最大的水面战斗舰艇"},{"from":74.95,"to":76.21,"content":"就是维斯比级了"},{"from":76.21,"to":77.47,"content":"同样是10亿美元"},{"from":77.47,"to":78.79,"content":"他们完全可以打造一支"},{"from":78.79,"to":80.74,"content":"规模更庞大的水面作战力量"},{"from":80.74,"to":82.92,"content":"那瑞典海军为什么不走常规路线"},{"from":82.92,"to":85.94,"content":"反而要斥巨资研发这样一款隐身小艇"},{"from":85.94,"to":88.72,"content":"维斯比级究竟有哪些与众不同的特点"},{"from":88.72,"to":90.58,"content":"欢迎来到CHRIS的军事基地"},{"from":90.58,"to":92.14,"content":"聚焦各国军备鉴赏"},{"from":92.14,"to":96.08,"content":"今天我们来说说瑞典海军隐身小艇"},{"from":96.08,"to":98.649,"content":"维斯比级护卫舰"},{"from":102.44,"to":104.24,"content":"瑞典作为北欧五国之一"},{"from":104.24,"to":105.3,"content":"其地域辽阔"},{"from":105.3,"to":106.28,"content":"人口稀少"},{"from":106.28,"to":108.26,"content":"在2024年加入北约之前"},{"from":108.26,"to":111.37,"content":"瑞典在国际社会上一直都保持着中立态势"},{"from":111.38,"to":113.88,"content":"因此在各种武器装备的研发上"},{"from":113.88,"to":116.6,"content":"瑞典一直都在努力维持自己的军工自主性"},{"from":116.6,"to":119.97,"content":"希望用精良的装备来平衡军队数量上的不足"},{"from":119.97,"to":121.07,"content":"在冷战期间"},{"from":121.07,"to":124.23,"content":"对瑞典最迫切的威胁就是来自东边的苏联"},{"from":124.23,"to":126.69,"content":"和他们庞大的波罗的海舰队相比"},{"from":126.69,"to":128.85,"content":"瑞典海军的规模与实力有限"},{"from":128.85,"to":130.75,"content":"根本不可能在开阔水域"},{"from":130.75,"to":132.86,"content":"直接迎战强大的苏联海军"},{"from":132.86,"to":135.08,"content":"因此在上世纪60年代末"},{"from":135.08,"to":138.57,"content":"贝联海军决定用小型舰艇来充当他们的主力军"},{"from":138.57,"to":142.339,"content":"将主要战场设定在瑞典海岸线附近的峡湾地形"},{"from":142.339,"to":144.939,"content":"利用复杂的雷达背景回波来隐藏自己"},{"from":144.939,"to":146.499,"content":"增加苏联探测难度"},{"from":146.499,"to":149.41,"content":"为瑞典海军争取更多自卫与反击的时间"},{"from":149.41,"to":151.15,"content":"主打一个正面硬刚不行"},{"from":151.15,"to":153.92,"content":"那我们就迂回穿插G这一背景下"},{"from":153.92,"to":156.4,"content":"瑞典海军在上世纪80年代退役了"},{"from":156.4,"to":158.5,"content":"最后一批常规护卫舰和驱逐舰"},{"from":158.5,"to":160.24,"content":"然而1981年"},{"from":160.24,"to":162.829,"content":"发生了一件让瑞典海军毛骨悚然的事"},{"from":162.829,"to":166.149,"content":"苏联的威士忌级潜艇在携带核鱼雷的情况下"},{"from":166.149,"to":168.26,"content":"竟然在瑞典家门口搁浅了"},{"from":168.26,"to":170.26,"content":"距离瑞典最大的海军基地"},{"from":170.26,"to":172.82,"content":"卡尔斯克鲁纳港仅有10km"},{"from":172.82,"to":174.74,"content":"在瑞典眼皮子底下执行任务"},{"from":174.74,"to":176.2,"content":"他们竟然都没有察觉"},{"from":176.2,"to":177.42,"content":"这次事件过后"},{"from":177.42,"to":179.14,"content":"瑞典海军深刻意识到了"},{"from":179.14,"to":180.92,"content":"必须增强其反潜能力"},{"from":180.92,"to":184.56,"content":"维斯比吉就是在这样的背景下诞生的"},{"from":185.43,"to":186.59,"content":"1987年"},{"from":186.59,"to":189.22,"content":"瑞典海军决定开始研究舰艇的隐身技术"},{"from":189.22,"to":192.16,"content":"他们打造的第一艘隐身小艇是斯麦格号"},{"from":192.16,"to":195.42,"content":"这艘船是专门为测试舰艇隐身技术而建造的"},{"from":195.42,"to":196.13,"content":"试验艇"},{"from":196.13,"to":199.67,"content":"采用了侧壁式气垫船构型和全隐身设计"},{"from":199.67,"to":202.79,"content":"该艇于1991年完工并交付瑞典海军"},{"from":202.79,"to":205.39,"content":"他们随后在该艇上进行了多方面的研究"},{"from":205.39,"to":206.42,"content":"测试和评估"},{"from":206.42,"to":207.66,"content":"获得了宝贵经验"},{"from":207.66,"to":210.54,"content":"为接下来隐身舰艇的研发提供了很大的帮助"},{"from":210.54,"to":213.16,"content":"然而就当瑞典海军踌躇满志"},{"from":213.16,"to":215.3,"content":"准备打造全新的隐身战舰时"},{"from":215.3,"to":216.79,"content":"苏联轰然解体"},{"from":216.79,"to":218.35,"content":"没了苏联海军的威胁"},{"from":218.35,"to":221.47,"content":"新的隐身舰艇立马就显得毫无用武之地"},{"from":221.47,"to":224.28,"content":"因此维斯比奇经历了很多挫折"},{"from":224.28,"to":228.12,"content":"最初未来海军光是首批就打算采购12艘的"},{"from":228.12,"to":230.06,"content":"但政府随即缩减到了六艘"},{"from":230.06,"to":232.17,"content":"保留了额外采购四艘的选项"},{"from":232.17,"to":233.15,"content":"毫无疑问"},{"from":233.15,"to":235.55,"content":"额外采购的选项从来没有被激活过"},{"from":235.55,"to":237.97,"content":"甚至连第六艘的建造计划也被取消"},{"from":237.97,"to":240.99,"content":"原定的五艘采购计划包含了两个类别"},{"from":240.99,"to":244.05,"content":"四艘反潜用途和一艘水面作战用途"},{"from":244.05,"to":246.01,"content":"然而由于预算缩减"},{"from":246.01,"to":248.76,"content":"瑞典海军只能将配置改为多功能用途"},{"from":248.76,"to":250.3,"content":"为了进一步节约资金"},{"from":250.3,"to":252.72,"content":"原定计划中的直升机机库也被取消"},{"from":252.72,"to":253.86,"content":"磕磕绊绊"},{"from":253.86,"to":256.609,"content":"维斯比级首舰预计95年开工"},{"from":256.609,"to":257.789,"content":"2000年下水"},{"from":257.789,"to":259.189,"content":"2005年服役"},{"from":259.189,"to":262,"content":"但直到2012年才全面投入使用"},{"from":262,"to":264.789,"content":"对于一艘排水量只有600多吨的小船来说"},{"from":264.789,"to":266.589,"content":"时间线确实拉有点长了"},{"from":266.589,"to":267.869,"content":"但说完了起源"},{"from":267.869,"to":271.589,"content":"下面我们来说说维斯比级的具体设计细节"},{"from":272.49,"to":273.59,"content":"船体方面"},{"from":273.59,"to":275.73,"content":"维斯比级采用了内倾式船体"},{"from":275.73,"to":279.69,"content":"简单理解就是传统舰艇的船体都是上宽下窄"},{"from":279.69,"to":280.78,"content":"倒三角形"},{"from":280.78,"to":283.68,"content":"而维斯比级的船体则是上窄下宽"},{"from":283.68,"to":284.82,"content":"从远处看"},{"from":284.82,"to":287.96,"content":"水面以上的部分呈现出标准的三角形"},{"from":287.96,"to":290.83,"content":"不过维斯比奇的船体设计还算保守"},{"from":290.83,"to":291.99,"content":"仔细看的话"},{"from":291.99,"to":295.31,"content":"船体在出水线以上的部分是先向外拓展一点"},{"from":295.31,"to":296.52,"content":"再向内收的"},{"from":296.52,"to":299.12,"content":"可以和采用相同设计的美军隐身战舰"},{"from":299.12,"to":300,"content":"朱姆尔特级"},{"from":300,"to":300.81,"content":"对比一下"},{"from":300.81,"to":302.87,"content":"珠穆尔特级的设计更加激进"},{"from":302.87,"to":306.03,"content":"出水线以上的部分宽度是持续缩减的"},{"from":306.03,"to":307.45,"content":"采用这种船体设计"},{"from":307.45,"to":309.22,"content":"可以有效减少雷达回波"},{"from":309.22,"to":312.06,"content":"据维斯比级设计师简尼尔森透露"},{"from":312.06,"to":314.04,"content":"维斯比级的向内倾斜设计"},{"from":314.04,"to":316.38,"content":"可以减少99%的雷达截面"},{"from":316.38,"to":319.64,"content":"采用类似设计的还有我国的022型导弹艇"},{"from":319.64,"to":322.2,"content":"其使用了穿浪双船体内倾式设计"},{"from":322.2,"to":323.9,"content":"也同样具有隐身性能"},{"from":323.9,"to":325.26,"content":"那说回维斯比级"},{"from":325.26,"to":328.56,"content":"其船体材料使用了类似三明治的夹层设计"},{"from":328.56,"to":331.659,"content":"由碳纤维和各种聚乙烯材料压制而成"},{"from":331.659,"to":334.92,"content":"可以有效减少雷达回波并降低红外特征"},{"from":334.92,"to":336.88,"content":"由这种复合材料构成的船体"},{"from":336.88,"to":338.44,"content":"可以大幅降低磁信号"},{"from":338.44,"to":341.32,"content":"在对抗磁性水雷时有显著的优势"},{"from":341.32,"to":342.34,"content":"与此同时"},{"from":342.34,"to":344.14,"content":"复合材料的强度也很高"},{"from":344.14,"to":345.5,"content":"相对重量较轻"},{"from":345.5,"to":348.31,"content":"比同等强度的钢材大约轻了50%"},{"from":348.31,"to":351.21,"content":"因此才能做到仅有600多吨的排水量"},{"from":351.21,"to":352.27,"content":"涂装方面"},{"from":352.27,"to":355.37,"content":"其使用了灰白迷彩和瑞典附近海域的颜色"},{"from":355.37,"to":356.01,"content":"很接近"},{"from":356.01,"to":357.37,"content":"降低了其可信度"},{"from":357.37,"to":359.21,"content":"为了进一步减少红外特征"},{"from":359.21,"to":361.3,"content":"维斯比吉舍弃了传统烟囱"},{"from":361.3,"to":363.34,"content":"废气管路经过海水冷却后"},{"from":363.34,"to":366.26,"content":"再由剑尾底下的隐藏式排气口向下排出"},{"from":366.26,"to":368.62,"content":"而省去烟囱后也能增加甲板"},{"from":368.62,"to":371.13,"content":"可用空间并降低雷达反射截面"},{"from":371.13,"to":373.43,"content":"费尽各种手段加强隐身性能后"},{"from":373.43,"to":376.73,"content":"维斯比奇的雷达反射截面降低至仅有一根天线"},{"from":376.73,"to":377.57,"content":"相当的程度"},{"from":377.57,"to":379.2,"content":"红外特征也大幅减少"},{"from":379.2,"to":380.58,"content":"但是需要注意的是"},{"from":380.58,"to":383.88,"content":"任何隐身技术都不能做到来无影去无踪"},{"from":383.88,"to":386.4,"content":"只是能尽可能缩短敌人发现的时间"},{"from":386.4,"to":387.88,"content":"从而获取主动权"},{"from":387.88,"to":390.08,"content":"在首舰维斯比号的海上测试中"},{"from":390.08,"to":391.7,"content":"在海况良好的情况下"},{"from":391.7,"to":394.57,"content":"可接近至目标22km才会被雷达发现"},{"from":394.57,"to":397.23,"content":"恶劣海况下会缩减至13km"},{"from":397.23,"to":398.93,"content":"如果配合电子对抗措施"},{"from":398.93,"to":400.67,"content":"被目标雷达发现的距离"},{"from":400.67,"to":403.48,"content":"进一步缩短至11km与8km"},{"from":403.48,"to":404.8,"content":"推荐系统方面"},{"from":404.8,"to":407.32,"content":"维斯比奇为了最大程度强调隐身性能"},{"from":407.32,"to":408.64,"content":"降低声学特征"},{"from":408.64,"to":410.58,"content":"放弃了使用螺旋桨转"},{"from":410.58,"to":413.58,"content":"而采用了两台S2125喷水推进器"},{"from":413.58,"to":415.61,"content":"最高时速可达35节"},{"from":415.61,"to":417.43,"content":"以15节航速航行时"},{"from":417.43,"to":419.79,"content":"最大航程在4500km左右"},{"from":419.79,"to":422.189,"content":"相较于传统螺旋桨泵推系统"},{"from":422.189,"to":424.289,"content":"不仅具有出色的静音能力与机动性"},{"from":424.289,"to":426.129,"content":"还能降低舰艇的出水高度"},{"from":426.129,"to":429.789,"content":"特别适合瑞典海军的近岸潜水操作环境"},{"from":431.72,"to":434.34,"content":"前段时间天天对着电脑熬夜赶稿"},{"from":434.34,"to":435.36,"content":"脸经常会油"},{"from":435.36,"to":437.14,"content":"这豆豆黑头都疯狂找上了门"},{"from":437.14,"to":438.22,"content":"这里给大家推荐一款"},{"from":438.22,"to":441.26,"content":"我最近一直在用的溪木源男士控油洁面乳"},{"from":441.26,"to":442.54,"content":"不仅能有效清洁"},{"from":442.54,"to":443.58,"content":"还能源头控油"},{"from":443.58,"to":444.36,"content":"来改善痘痘"},{"from":444.36,"to":446.26,"content":"黑头和大毛孔等问题"},{"from":446.26,"to":448.58,"content":"携手清华珠三角研究院新桂园"},{"from":448.58,"to":451.95,"content":"专为男性调配的六比三比一强清洁氨基酸体系"},{"from":451.95,"to":453.33,"content":"能钻进毛孔深处"},{"from":453.33,"to":455.63,"content":"把藏着的油脂污垢全给洗出来"},{"from":455.63,"to":457.38,"content":"洗完还不会发干紧绷"},{"from":457.38,"to":460.23,"content":"另外专研的极光黑云山控油精粹"},{"from":460.23,"to":462.25,"content":"能从源头直接控制皮肤出油"},{"from":462.25,"to":464.47,"content":"让奶洗后的帅脸又干净又舒服"},{"from":464.47,"to":466.01,"content":"夏天除了把脸洗干净"},{"from":466.01,"to":468.15,"content":"保持身上的干净清爽也同样重要"},{"from":468.15,"to":471.05,"content":"像我就是搭配使用这款男士洗护套装"},{"from":471.05,"to":472.61,"content":"净澈控油能力很牛"},{"from":472.61,"to":475.169,"content":"洗完浑身都散发着清爽高级的木质香"},{"from":475.169,"to":477.409,"content":"再也不用担心身上尴尬的汗臭味了"},{"from":477.409,"to":480.569,"content":"他这套一经推出就登顶了洗护套装新品榜"},{"from":480.569,"to":482.21,"content":"口碑实力非常在线"},{"from":482.21,"to":483.73,"content":"沐浴露留香很持久"},{"from":483.73,"to":486.25,"content":"为男士特调的极光黑云杉木质香"},{"from":486.25,"to":488.13,"content":"可以说连香水钱都省了"},{"from":488.13,"to":489.21,"content":"加上它还有除螨率"},{"from":489.21,"to":490.87,"content":"大约99%的专业报告"},{"from":490.87,"to":492.96,"content":"能有效改善咱后背痘痘问题"},{"from":492.96,"to":495.54,"content":"洗发水里添加了新一代男士去屑专利"},{"from":495.54,"to":497.46,"content":"能从源头抑制马拉色菌"},{"from":497.46,"to":499.22,"content":"且控油止痒效果极佳"},{"from":499.22,"to":501.87,"content":"能让洗后的头发干净蓬松不止一整天"},{"from":501.87,"to":503.59,"content":"现在置顶领大额优惠券"},{"from":503.59,"to":504.71,"content":"到手更优惠"},{"from":504.71,"to":507.11,"content":"而且品牌还承诺过敏包退下单"},{"from":507.11,"to":509.62,"content":"有需要的小伙伴们可千万别错过了"},{"from":510.06,"to":511.1,"content":"火力方面"},{"from":511.1,"to":513,"content":"维斯比奇可谓是麻雀虽小"},{"from":513,"to":514,"content":"五脏俱全"},{"from":514,"to":515.39,"content":"功能很是全面"},{"from":515.39,"to":518.23,"content":"首先维斯比奇拥有一门57mm"},{"from":518.23,"to":519.85,"content":"博福斯mark3舰炮"},{"from":519.85,"to":521.67,"content":"每分钟射速220发"},{"from":521.67,"to":523.25,"content":"最高射程17km"},{"from":523.25,"to":525.09,"content":"炮塔同样采用隐身设计"},{"from":525.09,"to":526.99,"content":"不使用时枪管会折叠"},{"from":526.99,"to":528.11,"content":"被隐藏在炮塔中"},{"from":528.11,"to":529.5,"content":"以减少雷达信号"},{"from":529.5,"to":532.36,"content":"总计可以携带240发57mm炮弹"},{"from":532.36,"to":533.54,"content":"值得一提的是"},{"from":533.54,"to":534.86,"content":"除了普通炮弹外"},{"from":534.86,"to":537.05,"content":"该炮还可以发射可编程弹药"},{"from":537.05,"to":538.89,"content":"当炮弹抵达设定区域时"},{"from":538.89,"to":540.01,"content":"会自行引爆"},{"from":540.01,"to":541.97,"content":"并形成由2400颗直径"},{"from":541.97,"to":543.86,"content":"3mm无球组成的金属墙"},{"from":543.86,"to":545.56,"content":"杀伤能力不容小觑"},{"from":545.56,"to":546.9,"content":"不光在维斯比级上"},{"from":546.9,"to":548.5,"content":"有这门57mm舰炮"},{"from":548.5,"to":549.89,"content":"可以说是远销全球"},{"from":549.89,"to":552.15,"content":"数十个国家的舰艇上都有他的身影"},{"from":552.15,"to":554.95,"content":"其中就包括了美国海军的滨海战斗舰"},{"from":554.95,"to":556.53,"content":"自由级和独立级"},{"from":556.53,"to":557.67,"content":"除了舰炮外"},{"from":557.67,"to":560.87,"content":"维斯比级还安装有四门400mm鱼雷发射管"},{"from":560.87,"to":563.39,"content":"目前他们使用的是TP45型鱼雷"},{"from":563.39,"to":564.71,"content":"速度35节"},{"from":564.71,"to":566.35,"content":"射程在20km左右"},{"from":566.35,"to":567.25,"content":"除此以外"},{"from":567.25,"to":570.37,"content":"VCB机还可以携带双鹰mark3无人扫雷艇"},{"from":570.37,"to":573.31,"content":"以及八枚RBS15反舰导弹导弹"},{"from":573.31,"to":574.75,"content":"飞行速度0.9马赫"},{"from":574.75,"to":576.35,"content":"射程在200km左右"},{"from":576.35,"to":577.75,"content":"但由于空间有限"},{"from":577.75,"to":580.94,"content":"反舰导弹和无人扫雷艇只能二选一"},{"from":580.94,"to":581.9,"content":"通常来说"},{"from":581.9,"to":583.86,"content":"维斯比级都是装备扫雷艇的"},{"from":583.86,"to":585.04,"content":"不光能扫雷"},{"from":585.04,"to":588.34,"content":"且还具有铺设水雷和投放射手炸弹的能力"},{"from":588.34,"to":589.6,"content":"CB系统方面"},{"from":589.6,"to":591.5,"content":"维C比奇配备了莱茵金属公司"},{"from":591.5,"to":593.81,"content":"研发的多弹软杀伤系统"},{"from":593.81,"to":595.83,"content":"该系统可以发射在电磁波谱"},{"from":595.83,"to":597.79,"content":"所有相关波长内工作的诱饵"},{"from":597.79,"to":599.05,"content":"包括了紫外线"},{"from":599.05,"to":599.73,"content":"激光"},{"from":599.73,"to":601.29,"content":"红外线和雷达波"},{"from":601.29,"to":603.62,"content":"基本覆盖了大多数制导方式"},{"from":603.62,"to":604.96,"content":"虽然没有机库"},{"from":604.96,"to":606.9,"content":"但威SB及船尾的停机坪"},{"from":606.9,"to":610.31,"content":"可以携带一架aw109多用途直升机"},{"from":610.31,"to":611.75,"content":"人员配置方面"},{"from":611.75,"to":613.77,"content":"维斯比级基本编制43人"},{"from":613.77,"to":615.59,"content":"对于这样一艘小军舰来说"},{"from":615.59,"to":617.099,"content":"人已经不算少了"},{"from":617.099,"to":619.459,"content":"不过船员的住宿空间看起来还可以"},{"from":619.459,"to":621.59,"content":"都是双人间上下铺"},{"from":621.59,"to":623.35,"content":"街上有两到三名厨师"},{"from":623.35,"to":625.71,"content":"以及一张由两张桌子构成的小餐厅"},{"from":625.71,"to":628.08,"content":"满足基本使用肯定没什么大问题"},{"from":628.08,"to":629.22,"content":"值得一提的是"},{"from":629.22,"to":630.72,"content":"就这样一艘小军舰"},{"from":630.72,"to":632.9,"content":"竟然还能在犄角旮旯里塞几个单车"},{"from":632.9,"to":635.68,"content":"看样子瑞典人真的是很喜欢锻炼啊"},{"from":636.95,"to":638.37,"content":"自从冷战结束后"},{"from":638.37,"to":641.71,"content":"瑞典海军的水面战斗舰队已经从34艘"},{"from":641.71,"to":643.23,"content":"缩减到了仅有九艘"},{"from":643.23,"to":645.93,"content":"其中包括了五艘维斯比级护卫舰"},{"from":645.93,"to":647.63,"content":"两艘哥德堡级护卫舰"},{"from":647.63,"to":650,"content":"以及两艘斯德哥尔摩级护卫舰"},{"from":650,"to":652.04,"content":"由于苏联解体后的局势缓和"},{"from":652.04,"to":654.84,"content":"未来海军并没有为维斯比级配备防空导弹"},{"from":654.84,"to":656.26,"content":"一旦爆发战争"},{"from":656.26,"to":658.63,"content":"空中掩护将完全依赖瑞典空军"},{"from":658.63,"to":661.27,"content":"而瑞典空军的规模也从1987年的"},{"from":661.27,"to":664.47,"content":"501架作战飞机缩减到了如今的70多架"},{"from":664.47,"to":667.35,"content":"乍一看瑞典军队的规模不尽人意"},{"from":667.35,"to":669.56,"content":"但考虑到他所面临的潜在威胁"},{"from":669.56,"to":672.48,"content":"从苏联时期总计由33艘潜艇"},{"from":672.48,"to":673.66,"content":"两艘巡洋舰"},{"from":673.66,"to":674.96,"content":"14艘驱逐舰"},{"from":674.96,"to":676.2,"content":"14艘护卫舰"},{"from":676.2,"to":677.7,"content":"17艘轻型护卫舰"},{"from":677.7,"to":679.36,"content":"以及100多艘小型舰艇"},{"from":679.36,"to":681.24,"content":"组成的庞大的波罗的海舰队"},{"from":681.24,"to":682.76,"content":"缩减到俄罗斯时期"},{"from":682.76,"to":683.92,"content":"只有一艘潜艇"},{"from":683.92,"to":685.04,"content":"一艘驱逐舰"},{"from":685.04,"to":686.14,"content":"两艘护卫舰"},{"from":686.14,"to":688.76,"content":"以及25艘轻型护卫舰组成的迷你版"},{"from":688.76,"to":689.78,"content":"波罗的海舰队"},{"from":689.78,"to":691.94,"content":"瑞典军队的规模下降情有可原"},{"from":691.94,"to":694.12,"content":"更何况虽然规模下降了"},{"from":694.12,"to":696.17,"content":"但整体装备的质量却在提升"},{"from":696.17,"to":698.53,"content":"海军有威斯比奇这个黑科技军舰"},{"from":698.53,"to":699.89,"content":"空军有鹰师"},{"from":699.89,"to":702.31,"content":"陆军则是CV90步战车"},{"from":702.31,"to":703.77,"content":"瑞典版豹2A5"},{"from":703.77,"to":706.7,"content":"以及乌托战士SRTV103"},{"from":706.7,"to":708.1,"content":"整体的军工水平"},{"from":708.1,"to":710.33,"content":"可以说是五常以外独一档的存在"},{"from":710.33,"to":712.07,"content":"如果说2024年以前"},{"from":712.07,"to":713.85,"content":"瑞典还需要提防俄罗斯"},{"from":713.85,"to":716.65,"content":"那这一顾虑在其于今年3月加入北约后"},{"from":716.65,"to":717.69,"content":"就彻底打消"},{"from":717.69,"to":718.75,"content":"目前来看"},{"from":718.75,"to":720.35,"content":"作为北约成员国之一"},{"from":720.35,"to":721.95,"content":"维斯比基所具有的特点"},{"from":721.95,"to":725.16,"content":"都能成为北约在波罗的海制约俄罗斯的先锋军"},{"from":725.16,"to":726.06,"content":"OK啦"},{"from":726.06,"to":728.16,"content":"那以上就是本期视频的全部内容了"},{"from":728.16,"to":729,"content":"大家还想看什么"},{"from":729,"to":731.06,"content":"瑞典军备也可以打在评论区告诉我"},{"from":731.06,"to":732.14,"content":"我们一一安排"},{"from":732.14,"to":734.2,"content":"那如果对隐身战舰感兴趣的话"},{"from":734.2,"to":736.62,"content":"欢迎大家去看这期珠穆莫特技的讲解视频"},{"from":736.62,"to":738.44,"content":"是一艘相当下饭的军舰"},{"from":738.44,"to":740.14,"content":"如果觉得本期视频还不错的话"},{"from":740.14,"to":741.24,"content":"别忘了多多三连"},{"from":741.24,"to":742.44,"content":"我们下期视频再见"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:18:47.600Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:18:42.800Z"}}
