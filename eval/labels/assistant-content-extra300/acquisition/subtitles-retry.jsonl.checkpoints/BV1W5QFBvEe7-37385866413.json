{"schemaVersion":1,"bvid":"BV1W5QFBvEe7","cid":37385866413,"subtitles":[{"from":0.06,"to":2.4,"content":"上次和大家简单的聊了聊日本的裸纪"},{"from":2.4,"to":4.88,"content":"有不少朋友都觉得猎奇又难以理解"},{"from":4.88,"to":6.34,"content":"可你一定想不到的是"},{"from":6.34,"to":8.78,"content":"在日本长野县建坊的深山里"},{"from":8.78,"to":10.76,"content":"藏着一场比裸机更加癫狂"},{"from":10.76,"to":12.42,"content":"更加致命的千年祭奠"},{"from":12.42,"to":13.6,"content":"那就是御柱祭"},{"from":13.6,"to":14.9,"content":"今天咱们就聊一聊它"},{"from":14.9,"to":18.08,"content":"这是被日本人奉为三大奇迹之一的神圣仪式"},{"from":18.08,"to":20.06,"content":"1200多年从未中断过"},{"from":20.06,"to":21.38,"content":"每6年举办一届"},{"from":21.38,"to":23.46,"content":"当地人会砍下四棵17米高"},{"from":23.46,"to":25.2,"content":"重达10吨的冷山巨木"},{"from":25.2,"to":27.88,"content":"全靠人力从陡峭的山坡轰然而下"},{"from":27.88,"to":30.5,"content":"场面比好莱坞动作大片还要震撼热血"},{"from":30.5,"to":33.06,"content":"但在这看似神圣狂野的热闹背后"},{"from":33.06,"to":34.9,"content":"却是挥之不去的死亡阴影"},{"from":34.9,"to":37.8,"content":"基本上每一届举办都会有人摔死淹死"},{"from":37.8,"to":39.24,"content":"被剧目碾压身亡"},{"from":39.24,"to":41.02,"content":"受重伤的更是达到上百人"},{"from":41.02,"to":42.3,"content":"更让人难以理解的是"},{"from":42.3,"to":44.78,"content":"在当地由于祭奠而死亡或受伤"},{"from":44.78,"to":45.9,"content":"非但不是悲剧"},{"from":45.9,"to":47.48,"content":"反而被视作至高荣耀"},{"from":47.48,"to":49.32,"content":"是一种为神献身的传统"},{"from":49.32,"to":51.02,"content":"一条条鲜活的人命逝去"},{"from":51.02,"to":53.14,"content":"官方与社区却只轻飘飘一句"},{"from":53.14,"to":54.34,"content":"传统亦是如此"},{"from":54.34,"to":55.22,"content":"便翻篇了"},{"from":55.22,"to":56.96,"content":"而下一届依旧原样举办"},{"from":56.96,"to":60.33,"content":"用生命延续着这场威胁的信仰狂欢"},{"from":66.66,"to":68.3,"content":"眼看天气是越来越热了"},{"from":68.3,"to":69.64,"content":"不知道各位有没有和我一样"},{"from":69.64,"to":70.38,"content":"早上洗脸"},{"from":70.38,"to":72.16,"content":"不到中午就油的一塌糊涂了"},{"from":72.16,"to":75.02,"content":"最近海洋至尊就给我寄了这支多效修护焕能乳"},{"from":75.02,"to":76.16,"content":"它质地特别的轻"},{"from":76.16,"to":77.1,"content":"一抹就化开"},{"from":77.1,"to":79.5,"content":"完全不像其他护肤品一样会糊在脸上"},{"from":79.5,"to":80.66,"content":"管你是油到反光"},{"from":80.66,"to":82.38,"content":"干到起皮还是脸色暗沉"},{"from":82.38,"to":83.78,"content":"它都能帮你拉回正轨"},{"from":83.78,"to":85.32,"content":"新升级添加了核心成分"},{"from":85.32,"to":87.8,"content":"是由能量源控油的同时还能补水"},{"from":87.8,"to":89,"content":"根据实验数据显示"},{"from":89,"to":90.04,"content":"在使用八小时之后"},{"from":90.04,"to":92.92,"content":"他的油脂分泌改善量达到了60.05%"},{"from":92.92,"to":94,"content":"连续使用28天"},{"from":94,"to":96.12,"content":"油脂分泌改善量达到70.5%"},{"from":96.12,"to":97.14,"content":"二一瓶就顶了"},{"from":97.14,"to":99.18,"content":"保湿控油修护好几样式"},{"from":99.18,"to":101.06,"content":"特别适合咱们这种又怕麻烦"},{"from":101.06,"to":102.74,"content":"又想解决肌肤问题的懒人"},{"from":102.74,"to":104.36,"content":"如果你想有更好的护肤效果"},{"from":104.36,"to":105.38,"content":"离不开清洁第一"},{"from":105.38,"to":106.34,"content":"那说到洁面"},{"from":106.34,"to":107.5,"content":"也不得不提到他家"},{"from":107.5,"to":110.4,"content":"全网累计热销650万平的三棱镜洁面了"},{"from":110.4,"to":112.92,"content":"我每天都在使用大油皮亲测适配"},{"from":112.92,"to":115.18,"content":"轻轻一揉就能够搓出绵密的泡沫"},{"from":115.18,"to":116.76,"content":"洗完那叫一个通透清爽"},{"from":116.76,"to":118.64,"content":"那现在就点击我评论区置顶链接"},{"from":118.64,"to":120.46,"content":"品牌方为咱们设置了专属通道"},{"from":120.46,"to":121.9,"content":"下单即可领大额优惠券"},{"from":121.9,"to":123.52,"content":"并享受30天免费试用"},{"from":123.52,"to":125.58,"content":"体验后觉得不满意都可以随时退哦"},{"from":125.58,"to":127.76,"content":"先说说玉柱机到底是怎么一回事吧"},{"from":127.76,"to":130.1,"content":"想象一下四棵超级大的冷杉树"},{"from":130.1,"to":131.96,"content":"每棵高达17到19米"},{"from":131.96,"to":133.12,"content":"重达10吨以上"},{"from":133.12,"to":134.58,"content":"被当地人叫做玉柱"},{"from":134.58,"to":136.22,"content":"他们得从山里砍下来"},{"from":136.22,"to":138.5,"content":"拖到剑仿大师的四个神社上"},{"from":138.5,"to":139.2,"content":"设本宫"},{"from":139.2,"to":140.28,"content":"上设秋宫"},{"from":140.28,"to":142.52,"content":"下设春宫以及下设秋宫"},{"from":142.52,"to":144.26,"content":"整个过程分为三大阶段"},{"from":144.26,"to":146.91,"content":"即出山李业还有剑玉柱"},{"from":146.91,"to":148.69,"content":"意思就是从山里拉出来"},{"from":148.69,"to":149.89,"content":"在镇上拖着走"},{"from":149.89,"to":151.31,"content":"然后再把它竖起来"},{"from":151.31,"to":152.85,"content":"全程不用什么大的机器"},{"from":152.85,"to":155.04,"content":"全靠人力和一股子不要命的劲"},{"from":155.04,"to":156.04,"content":"在这过程当中"},{"from":156.04,"to":157.78,"content":"最刺激的莫过于木落了"},{"from":157.78,"to":160.34,"content":"继锯木从陡峭的山坡上滑下去"},{"from":160.34,"to":162.56,"content":"会有几十个男人骑在上面喊着"},{"from":162.56,"to":163.46,"content":"好呀好呀的"},{"from":163.46,"to":165.28,"content":"像骑着野马一样冲下山谷"},{"from":165.28,"to":166.5,"content":"那木头滚的飞快"},{"from":166.5,"to":167.64,"content":"一不小心就会失控"},{"from":167.64,"to":168.38,"content":"撞到石头"},{"from":168.38,"to":170.5,"content":"把人甩掉以及被碾压等等"},{"from":170.5,"to":171.84,"content":"想想都后背发凉"},{"from":171.84,"to":173.2,"content":"紧接着还得过河"},{"from":173.2,"to":175.22,"content":"人在记录里面得跟木头绑在一起"},{"from":175.22,"to":176.46,"content":"随时可能被冲走"},{"from":176.46,"to":178.08,"content":"而李业就更加热闹了"},{"from":178.08,"to":179.9,"content":"几千人拉着绳子穿过街道"},{"from":180.78,"to":181.9,"content":"但木头这么重"},{"from":181.9,"to":182.88,"content":"绳子一松劲"},{"from":182.88,"to":183.98,"content":"危险就来了"},{"from":183.98,"to":185.1,"content":"最后的剑玉柱"},{"from":185.1,"to":187.16,"content":"把木头竖成15米高的柱子"},{"from":187.16,"to":188.32,"content":"男人骑在顶上"},{"from":188.32,"to":189.88,"content":"随着绳子拉起来跳舞"},{"from":189.88,"to":191.44,"content":"完事还得爬上去清理"},{"from":191.44,"to":193.27,"content":"整个祭典要持续两个月"},{"from":193.27,"to":194.87,"content":"世子也叫当地信众"},{"from":194.87,"to":197.93,"content":"他们会把这当成一辈子最男人的一件事情"},{"from":197.93,"to":199.74,"content":"可你也别以为这就是表演"},{"from":199.74,"to":201.26,"content":"这是真真正正的信仰"},{"from":201.26,"to":202.26,"content":"在神道教里"},{"from":202.26,"to":203.98,"content":"这些玉柱就是神灵的化身"},{"from":203.98,"to":206.14,"content":"如果你骑上去并且拉上去"},{"from":206.14,"to":207.64,"content":"就等于跟神走在了一起"},{"from":207.64,"to":209.22,"content":"世子们从小就听老人说"},{"from":209.22,"to":210.5,"content":"是男人就去木落"},{"from":210.5,"to":211.18,"content":"没风险"},{"from":211.18,"to":212.46,"content":"那还叫玉柱计吗"},{"from":212.46,"to":213.68,"content":"但正因为这样"},{"from":213.68,"to":215.56,"content":"死亡的影子从来都没有离开过"},{"from":215.56,"to":216.5,"content":"近50年来"},{"from":216.5,"to":218.22,"content":"就有至少十人以上死亡"},{"from":218.22,"to":219.42,"content":"上百人重伤"},{"from":219.42,"to":221.5,"content":"几乎每次举办都会有死亡事件"},{"from":221.5,"to":224.1,"content":"事故大多都是在拉木头和监狱柱的时候"},{"from":224.1,"to":225.1,"content":"像绳子断掉"},{"from":225.1,"to":226.02,"content":"木头翻掉"},{"from":226.02,"to":227.7,"content":"从高空掉下来等等意外"},{"from":227.7,"to":229.32,"content":"日本人自己也觉得十分危险"},{"from":229.32,"to":232.48,"content":"而西方媒体更是称它为世界上最危险的基点"},{"from":232.48,"to":235.16,"content":"那些死掉的大多都是当地青壮年男人"},{"from":235.16,"to":236.1,"content":"然而离谱的是"},{"from":236.1,"to":237.66,"content":"这些重伤和死亡事件"},{"from":237.66,"to":238.94,"content":"他们觉得十分的荣耀"},{"from":238.94,"to":240.32,"content":"甚至还有一套说法称"},{"from":240.32,"to":241.62,"content":"被压死也光荣"},{"from":241.62,"to":243.12,"content":"可对于一些普通家庭来说"},{"from":243.12,"to":244.12,"content":"简直是天塌了"},{"from":244.12,"to":246.64,"content":"谁愿意看着自己家人拼了命的去参加祭典"},{"from":246.64,"to":248.34,"content":"然后断手断脚又断气"},{"from":248.34,"to":250.42,"content":"但又得强行说自己死的光荣呢"},{"from":250.42,"to":252.26,"content":"就算主办方后来加了安全绳"},{"from":252.26,"to":252.98,"content":"限制人数"},{"from":252.98,"to":253.96,"content":"收了观众席"},{"from":253.96,"to":256.52,"content":"可传统那一套还是坚持不能戴头盔"},{"from":256.52,"to":257.6,"content":"不能太过于保护"},{"from":257.6,"to":259.8,"content":"不然就违背了1200年的传承了"},{"from":259.8,"to":263.04,"content":"所以安全和信仰就这么一直拉扯着"},{"from":268.78,"to":271.34,"content":"那么这些死亡事件究竟有多么离谱呢"},{"from":271.34,"to":272.9,"content":"早在1980年上社"},{"from":272.9,"to":274.36,"content":"李烨准备竖柱子的时候"},{"from":274.36,"to":276.26,"content":"一根锯木突然倒了一个柿子"},{"from":276.26,"to":277.36,"content":"男人被压在了下面"},{"from":277.36,"to":278.22,"content":"当场就没了"},{"from":278.22,"to":279.7,"content":"当时木头靠杠杆撑着"},{"from":279.7,"to":280.94,"content":"绳子一松就失衡"},{"from":280.94,"to":282.14,"content":"现场乱成了一锅粥"},{"from":282.14,"to":284.24,"content":"救援的人用手扒木屑和血迹"},{"from":284.24,"to":285.98,"content":"这时候的安全措施十分的简陋"},{"from":285.98,"to":286.92,"content":"那也可以理解"},{"from":286.92,"to":288.2,"content":"下次改正就行了"},{"from":288.2,"to":291.06,"content":"然而这场事故却直接拉开了现代预祝季"},{"from":291.06,"to":292.64,"content":"每届都有死伤的序幕"},{"from":292.64,"to":293.64,"content":"到了1986年"},{"from":293.64,"to":295.44,"content":"一名女观众在旁边看热闹"},{"from":295.44,"to":297.2,"content":"被滚下来的石头砸中了脑袋"},{"from":297.2,"to":298.02,"content":"没抢救过来"},{"from":298.02,"to":300.42,"content":"她可能就是想近距离感受那股震撼劲"},{"from":300.42,"to":301.46,"content":"结果丢了性命"},{"from":301.46,"to":303.14,"content":"这件事情让主办方意识到"},{"from":303.14,"to":304.66,"content":"危险不止冲着参与者"},{"from":304.66,"to":306.18,"content":"游客也有可能被卷进去"},{"from":306.18,"to":307.86,"content":"后来他们才开始拉警戒线"},{"from":307.86,"to":308.9,"content":"卖付费座位"},{"from":308.9,"to":310.36,"content":"但隐患却一直藏着"},{"from":310.36,"to":311.18,"content":"1992年"},{"from":311.18,"to":312.38,"content":"又是拉木头的阶段"},{"from":312.38,"to":314.38,"content":"一个拉绳的男人被剧目卷了进去"},{"from":314.38,"to":315.12,"content":"当场死亡"},{"from":315.12,"to":316.74,"content":"有的说他是想拽绳子"},{"from":316.74,"to":318.34,"content":"结果被拖进河里淹死了"},{"from":318.34,"to":320.66,"content":"也有的说是在坡道上被碾压致死"},{"from":320.66,"to":323.16,"content":"反正巨魔那冲击力跟小车祸似的"},{"from":323.16,"to":324.58,"content":"人一失足就完蛋了"},{"from":324.58,"to":325.3,"content":"在视频里"},{"from":325.3,"to":327.3,"content":"那些骑在木头上的人都喊着号子"},{"from":327.3,"to":328.28,"content":"木头嘎吱响"},{"from":328.28,"to":329.08,"content":"尘土飞扬"},{"from":329.08,"to":330.56,"content":"有人就算是被甩飞了"},{"from":330.56,"to":331.8,"content":"爬起来还要继续跳"},{"from":331.8,"to":334.26,"content":"因为他们觉得跳不上去就不算男人"},{"from":334.26,"to":337.16,"content":"而这一年发生的意外也并没有让官方提高警惕"},{"from":337.16,"to":339.8,"content":"反倒是把玉柱机的致命魅力戳的更加深了"},{"from":339.8,"to":341.04,"content":"2010年5月8日"},{"from":341.04,"to":342.16,"content":"那是最严重的一次"},{"from":342.16,"to":344.38,"content":"在下撤春宫建玉柱的过程当中"},{"from":344.38,"to":346.36,"content":"三个人骑在了17米高的木头上"},{"from":346.36,"to":348.1,"content":"用绳子和钢丝拉着竖起来"},{"from":348.1,"to":349.38,"content":"突然一根钢丝断了"},{"from":349.38,"to":350.32,"content":"木头剧烈晃动"},{"from":350.32,"to":352.58,"content":"三个人直接从10米高的地方摔了下去"},{"from":352.58,"to":354.9,"content":"其中有两人撞到头部当场死亡"},{"from":354.9,"to":356.46,"content":"另一个人在掉下去的时候"},{"from":356.46,"to":357.7,"content":"刚好撞上了地上的人"},{"from":357.7,"to":358.68,"content":"有了一丝缓冲"},{"from":358.68,"to":360.08,"content":"两人都只受了轻伤"},{"from":360.08,"to":362.86,"content":"当时现场有几千人看着尖叫声混着木头"},{"from":362.86,"to":364.06,"content":"撞击声乱成了一片"},{"from":364.06,"to":366.4,"content":"调查说是钢丝老化或者拉力太大"},{"from":366.4,"to":367.9,"content":"他们当时没系好安全绳"},{"from":367.9,"to":368.74,"content":"全靠经验"},{"from":368.74,"to":370.9,"content":"其中一名死者还有个正在读小学的孩子"},{"from":370.9,"to":372.22,"content":"我想到那个小孩以后"},{"from":372.22,"to":374.46,"content":"得说我的爸爸是为神助而死的"},{"from":374.46,"to":375.5,"content":"心里就堵得慌"},{"from":375.5,"to":377.24,"content":"当时这件事情还上了全国新闻"},{"from":377.24,"to":378.58,"content":"大家都开始讨论到"},{"from":378.58,"to":380.76,"content":"传统和人命究竟哪个更加重要呢"},{"from":380.76,"to":381.98,"content":"2016年5月5日"},{"from":381.98,"to":383.76,"content":"在上社本宫建完柱子后"},{"from":383.76,"to":386.6,"content":"一名41岁的世子在柱顶清理绳子的时候"},{"from":386.6,"to":387.42,"content":"脚下一滑"},{"from":387.42,"to":388.82,"content":"安全绳挂的位置不对"},{"from":388.82,"to":389.78,"content":"他抓了一下横绳"},{"from":389.78,"to":390.62,"content":"还是没能抓住"},{"from":390.62,"to":392.16,"content":"从15米的高处摔了下来"},{"from":392.16,"to":393.72,"content":"砸在了下面机械屋顶上"},{"from":393.72,"to":394.48,"content":"当晚就走了"},{"from":394.48,"to":396.36,"content":"被发现的时候全身多处骨折"},{"from":396.36,"to":399.02,"content":"这次的后续才真正的算是离谱到爆了"},{"from":399.02,"to":400.32,"content":"事故刚发生的时候"},{"from":400.32,"to":401.22,"content":"祭奠还没有完"},{"from":401.22,"to":402.22,"content":"当时没有喊停"},{"from":402.22,"to":403.68,"content":"就继续办剩下的环节了"},{"from":403.68,"to":404.46,"content":"目击的人说"},{"from":404.46,"to":405.94,"content":"他本来都已经完成任务了"},{"from":405.94,"to":407,"content":"就差最后一步"},{"from":407,"to":407.76,"content":"在事故后"},{"from":407.76,"to":410.56,"content":"有律师在5月9日直接去法院申请停办"},{"from":410.56,"to":411.3,"content":"这次的祭典"},{"from":411.3,"to":413.38,"content":"可当时祭奠其实还在举办当中"},{"from":413.38,"to":414.8,"content":"结果呢并没有成功"},{"from":414.8,"to":417.28,"content":"地方法院和东京法院直接全部驳回"},{"from":417.28,"to":418.88,"content":"说祭典已经在进行中了"},{"from":418.88,"to":420.48,"content":"现在终止是不现实的"},{"from":420.48,"to":421.6,"content":"而律师不死心"},{"from":421.6,"to":423.22,"content":"还特别告到了最高法院"},{"from":423.22,"to":425.26,"content":"但这个时候祭奠却早已结束"},{"from":425.26,"to":426,"content":"更绝的是"},{"from":426,"to":426.84,"content":"5月13日"},{"from":426.84,"to":429.86,"content":"俩律师又向警方告发主办方业务过失致死"},{"from":429.86,"to":431.44,"content":"说他们没有尽安全义务"},{"from":431.44,"to":433.84,"content":"就比如清理环节本该禁止人上去"},{"from":433.84,"to":435.36,"content":"命神挂法有问题等等"},{"from":435.36,"to":436.76,"content":"但警方6月才受理"},{"from":436.76,"to":438.16,"content":"媒体还炒的挺大的"},{"from":438.16,"to":440.02,"content":"结果在2017年6月29日"},{"from":440.02,"to":442.36,"content":"朝野地方检察院直接不起诉处分"},{"from":442.36,"to":444.62,"content":"理由是证据不足或自愿参与"},{"from":444.62,"to":446.24,"content":"律师听到后直接气炸了"},{"from":446.24,"to":447.2,"content":"每届都死人"},{"from":447.2,"to":449.04,"content":"你们还拿传统来当挡箭牌"},{"from":449.04,"to":450.44,"content":"到了2017年7月"},{"from":450.44,"to":452.12,"content":"法院还驳回了一个相关诉讼"},{"from":452.12,"to":452.96,"content":"理由更离谱"},{"from":452.96,"to":455.34,"content":"只有死者的后代才能够告发外人"},{"from":455.34,"to":457.52,"content":"像是律师这样的是没有资格告发的"},{"from":457.52,"to":458.82,"content":"想想看人都死了"},{"from":458.82,"to":460.76,"content":"律师拼了命想用法律拦一拦"},{"from":460.76,"to":463.56,"content":"结果全被传统加自愿四个字怼了回去"},{"from":463.56,"to":464.7,"content":"而死者家属呢"},{"from":466.36,"to":468.9,"content":"有的甚至接受社区为神献身的慰问"},{"from":468.9,"to":471.22,"content":"虽然主办方事后加的双重安全绳"},{"from":471.22,"to":472.5,"content":"无人机监管啥的"},{"from":472.5,"to":475.44,"content":"但2022年还是有人从柱子上摔成重伤"},{"from":475.44,"to":476.7,"content":"祭典照样举办"},{"from":476.7,"to":478.52,"content":"其实这些并不是孤立的个案"},{"from":478.52,"to":480.78,"content":"在当地的医院历史当中一直有记载"},{"from":480.78,"to":482.56,"content":"每年祭典都有几十人受伤"},{"from":482.56,"to":483.28,"content":"像骨折"},{"from":483.28,"to":485.04,"content":"脑震荡压伤啥的都有"},{"from":485.04,"to":486.78,"content":"受伤的多半是壮年男人"},{"from":486.78,"to":488.54,"content":"他们把这当成荣耀的证明"},{"from":488.54,"to":490.9,"content":"但现在这个时代谁家又愿意呢"},{"from":490.9,"to":491.58,"content":"说到底"},{"from":491.58,"to":494.06,"content":"御柱界的危险根子就是它的本质"},{"from":494.06,"to":495.14,"content":"这不是一场秀"},{"from":495.14,"to":496.48,"content":"而是活生生的信仰"},{"from":496.48,"to":498.54,"content":"2022年那届据说没有死人"},{"from":498.54,"to":499.76,"content":"但还是有人受伤"},{"from":499.76,"to":500.98,"content":"风险永远在那"},{"from":500.98,"to":502.44,"content":"大家的意见也都分两派"},{"from":502.44,"to":504.24,"content":"一边说必须要改正或停止"},{"from":504.24,"to":506.88,"content":"而另外一边则是当地士子和文化爱好者"},{"from":506.88,"to":508.16,"content":"他们认为没有风险"},{"from":508.16,"to":509.38,"content":"这就不是玉柱了"},{"from":509.38,"to":511.4,"content":"主办方也说会尽量把安全放在第一"},{"from":511.4,"to":512.54,"content":"但精神不能丢"},{"from":512.54,"to":514.24,"content":"当地的旅游业倒是乐坏了"},{"from":514.24,"to":515.48,"content":"每届有几10万游客"},{"from":515.48,"to":516.62,"content":"经济也跟着起飞"},{"from":516.62,"to":518.76,"content":"可风险也跟着涨"},{"from":525.2,"to":526.98,"content":"那既然这种祭奠那么危险"},{"from":526.98,"to":529.16,"content":"为什么每次还有人奋不顾身的参与"},{"from":529.16,"to":531.98,"content":"还有不少当地人把祭典里出事甚至丢命"},{"from":531.98,"to":533.08,"content":"看成是一种荣耀"},{"from":533.08,"to":534.12,"content":"这怎么理解呢"},{"from":534.12,"to":537,"content":"咱先来说说最核心的神道教的信仰层面"},{"from":537,"to":538.74,"content":"月柱记不是普通的热闹祭点"},{"from":538.74,"to":541.24,"content":"它是建房大设最大最重要的城市"},{"from":541.24,"to":544.32,"content":"那些巨大的冷杉巨木在神道里不是普通的木头"},{"from":544.32,"to":546.14,"content":"而是神灵暂时依附的圣物"},{"from":546.14,"to":547.72,"content":"把山里的神木砍下来"},{"from":547.72,"to":549.22,"content":"拉进镇里再竖起来"},{"from":549.22,"to":550.98,"content":"等于请神灵从山里回家"},{"from":550.98,"to":552.16,"content":"更新神社的力量"},{"from":552.16,"to":553.44,"content":"保佑当地风调雨顺"},{"from":553.44,"to":554.28,"content":"五谷丰登"},{"from":554.28,"to":555.84,"content":"当地信众骑在木头上"},{"from":555.84,"to":557.84,"content":"就是在用身体直接侍奉神灵"},{"from":557.84,"to":559.3,"content":"如果你在过程当中被压死"},{"from":559.3,"to":560.7,"content":"摔死或者淹死的话"},{"from":560.7,"to":563.34,"content":"那在传统眼光里就等于把命献给了神"},{"from":563.34,"to":564.28,"content":"简单点来讲"},{"from":564.28,"to":565.22,"content":"死不是白死"},{"from":565.22,"to":566.66,"content":"而是为神而死"},{"from":566.66,"to":568.92,"content":"死者的灵魂可能直接去陪伴神灵了"},{"from":568.92,"to":570.32,"content":"或者给社区带来的祝福"},{"from":570.32,"to":573.34,"content":"这跟古代很多文化里的人身御供有点像"},{"from":573.34,"to":575.62,"content":"只是现代版更加强调自愿奉献"},{"from":575.62,"to":577.19,"content":"当地的老年人也常说"},{"from":577.19,"to":578.15,"content":"御柱矗立"},{"from":578.15,"to":579.05,"content":"神灵就高兴"},{"from":579.05,"to":579.85,"content":"庄稼就好"},{"from":579.85,"to":582.1,"content":"你用生命换来的自然是最高的供奉了"},{"from":582.1,"to":583.06,"content":"那再往下说"},{"from":583.06,"to":586.36,"content":"这还跟见访男人的男子汉证明紧密绑在一起"},{"from":586.36,"to":588.84,"content":"当地人从小时候起就听长辈说"},{"from":588.84,"to":591.26,"content":"是男人就要去部落参与预筑基"},{"from":591.26,"to":594.14,"content":"尤其是骑在柱顶或最前头拉绳子的"},{"from":594.14,"to":595.8,"content":"不是随便谁都能去的"},{"from":595.8,"to":597.3,"content":"得是地区里面人望高"},{"from":597.3,"to":599.4,"content":"平时为社区出力最多的名士"},{"from":599.4,"to":600.54,"content":"他就像成年礼"},{"from":600.54,"to":602.28,"content":"像一生追求的巅峰荣耀"},{"from":602.28,"to":602.94,"content":"想象一下"},{"from":602.94,"to":604.18,"content":"几千人喊着口号"},{"from":604.18,"to":605.94,"content":"旗子飘着木头嘎吱响"},{"from":605.94,"to":607.08,"content":"你站在上面挥手"},{"from":607.08,"to":608.86,"content":"那种热血和被认可的感觉"},{"from":608.86,"to":610.12,"content":"现代人可能很难懂"},{"from":610.12,"to":611.2,"content":"但对他们来说"},{"from":611.2,"to":613,"content":"这就是荣耀之巅的体现"},{"from":613,"to":613.88,"content":"如果死了呢"},{"from":613.88,"to":615.82,"content":"就说这个人为玉柱尽了力"},{"from":615.82,"to":616.62,"content":"是光荣的"},{"from":616.62,"to":618.68,"content":"把个人牺牲升华到了集体骄傲"},{"from":618.68,"to":619.74,"content":"但更接地气"},{"from":619.74,"to":621.82,"content":"是为了地方的神社和神灵的"},{"from":621.82,"to":624.9,"content":"第三点就是社区凝聚力和千年传统的力量"},{"from":624.9,"to":626.68,"content":"御柱机1200多年没断过"},{"from":626.68,"to":628.14,"content":"从平安时代传下来"},{"from":628.14,"to":629.42,"content":"整个过程不是表演"},{"from":629.42,"to":630.26,"content":"是活的信仰"},{"from":630.26,"to":631.14,"content":"大家一起出力"},{"from":631.14,"to":631.74,"content":"一起冒险"},{"from":631.74,"to":633.26,"content":"才能把神事办成死伤"},{"from":633.26,"to":633.94,"content":"虽然悲痛"},{"from":633.94,"to":636.46,"content":"但也被浪漫化成了英雄故事记录在地方"},{"from":636.46,"to":636.98,"content":"历史上"},{"from":636.98,"to":639.74,"content":"有的地区甚至要把办好祭典当成自己的骄傲"},{"from":639.74,"to":642.06,"content":"就比如某个区域负责处理救助子"},{"from":642.06,"to":643.52,"content":"长达438年"},{"from":643.52,"to":644.62,"content":"中间也死过人"},{"from":644.62,"to":646.82,"content":"但他们觉得神明的事就得扛着"},{"from":646.82,"to":648.74,"content":"现在反而成为了家族传统的骄傲"},{"from":648.74,"to":651.18,"content":"传统越老就越把有风险当成本质"},{"from":651.18,"to":652.22,"content":"没点真刀真枪"},{"from":652.22,"to":653.24,"content":"那还叫玉柱吗"},{"from":653.24,"to":655.24,"content":"他把整个社区紧密的相连起来"},{"from":655.24,"to":657.7,"content":"咱们外人看可能觉得有点野蛮或者危险"},{"from":657.7,"to":658.64,"content":"但对于当地人"},{"from":658.64,"to":660.36,"content":"这就是活生生的文化血脉"},{"from":660.36,"to":661.08,"content":"无论如何"},{"from":661.08,"to":662.6,"content":"这场祭奠还是会延续"},{"from":662.6,"to":663.2,"content":"再往后"},{"from":663.2,"to":664.96,"content":"2028年的下一届又要来了"},{"from":668.14,"to":669.52,"content":"或许死伤能够少点"},{"from":669.52,"to":671.36,"content":"但核心的矛盾还在传统"},{"from":671.36,"to":672.22,"content":"要是全安全了"},{"from":672.22,"to":674.72,"content":"还是那个让建坊人热血沸腾的玉柱吗"},{"from":674.72,"to":676.8,"content":"历史里鲜血从来都没有停过"},{"from":676.8,"to":678.26,"content":"却也把社区粘的更紧"},{"from":678.26,"to":679.6,"content":"而世子们则相信"},{"from":679.6,"to":680.84,"content":"神需要这样的献祭"},{"from":680.84,"to":682.44,"content":"才能保佑大家风调雨顺"},{"from":682.44,"to":684.48,"content":"御柱基的死亡也不是单纯的意外"},{"from":684.48,"to":687.12,"content":"他就是传统跟现代信仰跟理性的碰撞"},{"from":687.12,"to":689.94,"content":"当地人赞叹他壮观的时候得直面那代价"},{"from":689.94,"to":692,"content":"而真正的敬畏不是无谓的送命"},{"from":692,"to":693.9,"content":"而是让传统在安全里活下去"},{"from":693.9,"to":695.84,"content":"让后代不用拿命来换荣耀"},{"from":695.84,"to":696.44,"content":"那么好了"},{"from":696.44,"to":697.76,"content":"这就是本期的全部内容"},{"from":697.76,"to":699.52,"content":"各位对于日本既有什么看法"},{"from":699.52,"to":700.68,"content":"可以在评论区下方留言"},{"from":700.68,"to":701.84,"content":"如果觉得视频做得还不错的话"},{"from":701.84,"to":703.18,"content":"也别忘了点赞收藏跟分享"},{"from":703.18,"to":703.76,"content":"我是正正"},{"from":703.76,"to":705.52,"content":"咱们下期视频再见吧"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:31:22.901Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:31:17.031Z"}}
