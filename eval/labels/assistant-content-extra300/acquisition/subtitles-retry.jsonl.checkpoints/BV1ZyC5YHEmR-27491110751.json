nt":"我们不是说这种处理的方法思路有问题"},{"from":1220.38,"to":1221.86,"content":"而是处理事务啊"},{"from":1221.86,"to":1222.72,"content":"不像我们打游戏"},{"from":1222.72,"to":1225.5,"content":"我们按按鼠标敲敲键盘就能把事情立刻解决"},{"from":1225.5,"to":1227.58,"content":"如果这个帽子叔叔能够在现场"},{"from":1227.58,"to":1228.5,"content":"给出一些答案的话"},{"from":1228.5,"to":1229.14,"content":"那固然好"},{"from":1229.14,"to":1231.46,"content":"那其实给不出答案其实也是很正常的"},{"from":1231.46,"to":1233.86,"content":"因为帽子叔叔主要是维持秩序嘛"},{"from":1233.86,"to":1235.3,"content":"他不需要什么东西都懂"},{"from":1235.3,"to":1237.42,"content":"要不然要这个市监局要这么要"},{"from":1237.42,"to":1239.34,"content":"还什么这些那些的部门干什么对吧"},{"from":1239.34,"to":1240.22,"content":"术业有专攻"},{"from":1240.22,"to":1242.68,"content":"然后还有这个呃责任划分的问题"},{"from":1242.68,"to":1243.96,"content":"还有什么调查取证啊"},{"from":1243.96,"to":1245.96,"content":"以及等等很多的问题都需要时间"},{"from":1245.96,"to":1247.96,"content":"所以这里帽子叔叔给出的处理呢"},{"from":1247.96,"to":1249.52,"content":"我觉得就挺合理合法的"},{"from":1249.52,"to":1250.68,"content":"这个也没什么好说的"},{"from":1250.68,"to":1253.4,"content":"然后本来呢今天是想讲讲新机飞的回应的"},{"from":1253.4,"to":1254.9,"content":"然后说着说着又忘了"},{"from":1254.9,"to":1256.3,"content":"这期时间也这么长了"},{"from":1256.3,"to":1257.74,"content":"要不咱们还是下期吧好吧"},{"from":1257.74,"to":1258.66,"content":"反正也快过年了"},{"from":1258.66,"to":1260.08,"content":"我今年指标也完事了"},{"from":1260.08,"to":1261.48,"content":"流量差点就差点儿"},{"from":1261.48,"to":1262.4,"content":"然后咱们慢慢聊嘛"},{"from":1262.4,"to":1262.7,"content":"好吧"},{"from":1262.7,"to":1264.4,"content":"那么本期我们就先到这里"},{"from":1264.4,"to":1266.08,"content":"下期我一定要先讲心机肥"},{"from":1266.08,"to":1267.04,"content":"一定要先讲心肌肥"},{"from":1267.04,"to":1267.6,"content":"千万别忘"},{"from":1267.6,"to":1268.68,"content":"本期我们说到这里啊"},{"from":1268.68,"to":1269.46,"content":"我是讲述者"},{"from":1269.46,"to":1270.68,"content":"希望你开心"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:36:02.302Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:35:56.898Z"}}
