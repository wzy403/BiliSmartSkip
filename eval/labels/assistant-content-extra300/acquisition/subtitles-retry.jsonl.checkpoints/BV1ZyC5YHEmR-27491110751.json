{"schemaVersion":1,"bvid":"BV1ZyC5YHEmR","cid":27491110751,"subtitles":[{"from":0.04,"to":1.14,"content":"第四期来了啊"},{"from":1.14,"to":2.98,"content":"我是越看这个法务越逆天"},{"from":2.98,"to":4.84,"content":"真的本来寻思这个播放量不好"},{"from":4.84,"to":5.939,"content":"这个系列弃了算了"},{"from":5.939,"to":8.219,"content":"但是这个法务真的很值得说"},{"from":8.219,"to":9.939,"content":"不论是看乐子还是作为案例"},{"from":9.939,"to":12.44,"content":"给各位分享一些我知道的一些小知识都很好"},{"from":12.44,"to":15.34,"content":"然后上期剪辑是忘了把两个图贴上来了啊"},{"from":15.34,"to":17.18,"content":"就是小伙伴在看了我的视频之后"},{"from":17.18,"to":18.86,"content":"确实能在生活中有所应用"},{"from":18.86,"to":20.7,"content":"包括之前那个因为讲某个游戏"},{"from":20.7,"to":22.14,"content":"被发律师函的一位up主啊"},{"from":22.14,"to":23.9,"content":"给出的反馈呢都还不错"},{"from":23.9,"to":25.42,"content":"那确实是有人看乐子"},{"from":25.42,"to":26.3,"content":"有人学东西啊"},{"from":26.3,"to":28.18,"content":"然后这里也感谢各位给我的反馈"},{"from":28.18,"to":31.12,"content":"我儿时呢确实有过想当老师的梦想"},{"from":31.12,"to":33.18,"content":"但是有的时候天不遂人愿吧"},{"from":33.18,"to":34.02,"content":"各位的反馈呢"},{"from":34.02,"to":35.58,"content":"包括以前给过我反馈的各位"},{"from":35.58,"to":37.8,"content":"突然有了一种我已经当过老师"},{"from":37.8,"to":38.62,"content":"且教的学生"},{"from":38.62,"to":41.26,"content":"已经可以在社会上独当一面的欣慰感啊"},{"from":41.26,"to":41.82,"content":"非常好"},{"from":41.82,"to":43.74,"content":"之前也还有一些学校的老师啊"},{"from":43.74,"to":44.66,"content":"跟我反馈说"},{"from":44.66,"to":46.28,"content":"就是偶尔上课的时候"},{"from":46.28,"to":48.12,"content":"也会用我的某条片子作为教案"},{"from":48.12,"to":49.32,"content":"感谢各位的信任吧"},{"from":49.32,"to":51.32,"content":"但也希望各位老师在用我的片子"},{"from":51.32,"to":52.6,"content":"作为教案的时候呢"},{"from":52.6,"to":56.16,"content":"或者各位观众觉得我的什么地方值得借鉴的话"},{"from":56.16,"to":57.78,"content":"记得要注意辨别一下"},{"from":57.78,"to":58.84,"content":"因为我讲的东西"},{"from":58.84,"to":60.58,"content":"毕竟经验主义的内容比较多"},{"from":60.58,"to":62.66,"content":"所以很多时候它就只适用于我呀"},{"from":62.66,"to":64.14,"content":"那咱们在进行实践的时候"},{"from":64.14,"to":66.16,"content":"还是要考虑到具体的问题具体分析"},{"from":66.16,"to":69.14,"content":"对于理论的生搬硬套是很容易出问题的"},{"from":69.14,"to":70.96,"content":"就比如说这位法务啊"},{"from":70.96,"to":72.78,"content":"好的我们继续先看一下原片啊"},{"from":72.78,"to":73.88,"content":"因为这里面写个报告"},{"from":73.88,"to":76.44,"content":"第一次的检测我们统一都是从那个京东旗舰店"},{"from":76.44,"to":78.36,"content":"有这几个网红呢直接下单到海关的"},{"from":78.36,"to":80.56,"content":"第二次检测呢是我们当时公证的时候"},{"from":80.56,"to":82.32,"content":"他们会制作一个这个律师肯定懂"},{"from":82.32,"to":85.38,"content":"不一定他不一定他不一定他不一定懂"},{"from":85.38,"to":87.6,"content":"会制作一个这样的公证包裹"},{"from":87.6,"to":89.18,"content":"我今天带过来的是复印件"},{"from":89.18,"to":92.34,"content":"这个呢是我们就等他反诉我打他脸的东西"},{"from":92.34,"to":94.06,"content":"对他有兵上来不能诬陷我"},{"from":94.06,"to":95.94,"content":"我们上来什么数据都没有提"},{"from":95.94,"to":99.7,"content":"你看他上来还不我我等了你是啥了对吧"},{"from":99.7,"to":101.7,"content":"你看咱聊的这么好的原因是什么"},{"from":101.7,"to":103.1,"content":"是因为你说哎我问问工厂"},{"from":103.1,"to":104.22,"content":"他到底加加没加"},{"from":104.22,"to":105.38,"content":"然后我们也等你了"},{"from":105.38,"to":105.98,"content":"没成想"},{"from":105.98,"to":107.54,"content":"那老哥你也挺不讲究"},{"from":107.54,"to":109.14,"content":"为什么说我们等你等来的"},{"from":109.14,"to":111.76,"content":"并不是说工厂给我们的答案到底添没添加没加"},{"from":111.76,"to":114.04,"content":"然后你整出来这个这两位那个好朋友"},{"from":114.04,"to":116.24,"content":"哼哈哈这哼哼哈完咣咣给我们一顿喷"},{"from":116.24,"to":117.56,"content":"本来情绪一点也不激动"},{"from":117.56,"to":119.47,"content":"咱们细声细语的是吧"},{"from":119.47,"to":120.91,"content":"呃这个他不一定懂"},{"from":120.91,"to":123.07,"content":"我是真的有点绷不住好"},{"from":123.07,"to":125.83,"content":"其实这一段啊也是在给负责人上强度"},{"from":125.83,"to":126.99,"content":"但这个真的没啥好聊的"},{"from":126.99,"to":128.1,"content":"所以我们聊点别的嘛"},{"from":128.1,"to":130.18,"content":"之前我在做这个视频复盘的时候啊"},{"from":130.18,"to":133.12,"content":"其实一直都在按照一个线性的叙事结构在走"},{"from":133.12,"to":135,"content":"就是说松哥他们到了这个地方"},{"from":135,"to":135.8,"content":"然后发生了什么"},{"from":135.8,"to":136.76,"content":"在这个过程中呢"},{"from":136.76,"to":138.2,"content":"他们的思路是怎么样的"},{"from":138.2,"to":140.44,"content":"在这个位置有什么东西是需要注意的"},{"from":140.44,"to":142,"content":"有哪些地方可以更好的处理"},{"from":142,"to":144.04,"content":"是以这样的一种状态来拆内容"},{"from":144.04,"to":146.76,"content":"这样的好处是它比较简单易懂嘛"},{"from":146.76,"to":148.6,"content":"比讲什么大道理有意思多了对吧"},{"from":148.6,"to":149.92,"content":"也更加贴近生活"},{"from":149.92,"to":150.72,"content":"更实用一点"},{"from":150.72,"to":151.68,"content":"但坏处是啊"},{"from":151.68,"to":153.99,"content":"这种思维习惯就比较局部化"},{"from":153.99,"to":155.93,"content":"它是一种战术层面的一种状态"},{"from":155.93,"to":158.23,"content":"所以在我们正常的去看一个内容"},{"from":158.23,"to":159.59,"content":"或者说处理一个事情的时候"},{"from":159.59,"to":162.28,"content":"可以自己尝试在脑海里面建立一个知识地图"},{"from":162.28,"to":164.78,"content":"我们可以通过现场人物的发言和动作"},{"from":164.78,"to":167.42,"content":"来确定他们在这个知识地图的点位"},{"from":167.42,"to":169.86,"content":"然后我们自己带入到这个点位中"},{"from":169.86,"to":171.46,"content":"带到这个身份里面去"},{"from":171.46,"to":174.24,"content":"就可以充分的理解到现场当中的这些人物啊"},{"from":174.24,"to":176.84,"content":"他们彼此之间的逻辑动机和他们的目的"},{"from":176.84,"to":178.98,"content":"以及他们之间的偏差到底是什么"},{"from":178.98,"to":181.76,"content":"这种思维对我们解决问题来说是很有帮助的"},{"from":181.76,"to":183.6,"content":"但是我们不这样去讲内容呢"},{"from":183.6,"to":185.12,"content":"是因为这种内容太碎片化了"},{"from":185.12,"to":186.72,"content":"我的话自己是比较跳的"},{"from":186.72,"to":188.46,"content":"会在各个点位之间来回穿梭"},{"from":188.46,"to":190,"content":"结果就是这边视角说一句"},{"from":190,"to":190.96,"content":"那边视角说一句"},{"from":190.96,"to":192.18,"content":"各位能不能能听懂啊"},{"from":192.18,"to":192.9,"content":"是一回事"},{"from":192.9,"to":194.22,"content":"就我自己整理成稿的时候"},{"from":194.22,"to":195.86,"content":"可能能不能看懂又是一回事了"},{"from":195.86,"to":198.92,"content":"所以讲的话我们还是肯定要去线性的去讲"},{"from":198.92,"to":201,"content":"但是大家呢脑海里面一定要有一个概念"},{"from":201,"to":202.2,"content":"就是这个知识地图"},{"from":202.2,"to":203.24,"content":"我们的某一个点位"},{"from":203.24,"to":205.9,"content":"我们要代入这个身份去用他的视角去看问题"},{"from":205.9,"to":207.74,"content":"其次这里啊虽然我们一直在讲"},{"from":207.74,"to":209.08,"content":"这个法务非常逆天"},{"from":209.08,"to":210.66,"content":"那也确实是很逆天啊"},{"from":210.66,"to":212.34,"content":"但是他的这个逆天是逆天"},{"from":212.34,"to":213.78,"content":"在他脑子不够灵活"},{"from":213.78,"to":215.76,"content":"是对于方法论的生搬硬套"},{"from":215.76,"to":218.28,"content":"他是情绪化上头太急于表现自己等等"},{"from":218.28,"to":220.44,"content":"而不是它采用的技术是有问题的"},{"from":220.44,"to":222.6,"content":"它所采用的技术是针对一部分"},{"from":222.6,"to":225.32,"content":"可能说比较低端的职业打假人的这么一个行为"},{"from":225.32,"to":225.74,"content":"逻辑"},{"from":225.74,"to":227.34,"content":"是针对这些人的一个技法"},{"from":227.34,"to":230.74,"content":"也就是说这个法务太依赖于把这个方法论啊"},{"from":230.74,"to":231.82,"content":"去生搬硬套了"},{"from":231.82,"to":232.62,"content":"这是他的问题"},{"from":232.62,"to":233.86,"content":"那关于这些比较"},{"from":233.86,"to":235.34,"content":"我们说可能比较低端的"},{"from":235.34,"to":237.42,"content":"或者说比较常见的这么一些打假人吧"},{"from":237.42,"to":239.46,"content":"这些人确实他们的打假逻辑"},{"from":239.46,"to":241.62,"content":"和我们现在看到的这个网络打假吧"},{"from":241.62,"to":244.54,"content":"就像松哥这一类还是有比较大的区别的"},{"from":244.54,"to":246.92,"content":"最大的区别就是收益的路线不相同啊"},{"from":246.92,"to":248.68,"content":"我们在说这部分打假人的时候"},{"from":248.68,"to":250.42,"content":"他们的路线是这个样子的啊"},{"from":250.42,"to":253.92,"content":"首先去找到这些企业有关的这个或者不合规的"},{"from":253.92,"to":255.64,"content":"或者不合法的一个产品的线索"},{"from":255.64,"to":258.42,"content":"然后利用消费者保护的这个一些法条"},{"from":258.42,"to":259.459,"content":"比如说假一赔三啊"},{"from":259.459,"to":260.459,"content":"比如说这个不满1000"},{"from":260.459,"to":262.279,"content":"按1000算的这个相关法条"},{"from":262.279,"to":264.819,"content":"然后大量的去购入这家企业的这款产品"},{"from":264.819,"to":266.12,"content":"然后投诉到工商啊"},{"from":266.12,"to":268.08,"content":"事件啊等等相关的部门要求赔偿"},{"from":268.08,"to":270.68,"content":"当然也会有一些就是要求商家直接私了的"},{"from":270.68,"to":272.92,"content":"一些商家怕麻烦的可能也就认倒霉了"},{"from":272.92,"to":275.48,"content":"我记得之前啊有过这样的一个新闻"},{"from":275.48,"to":277.36,"content":"就是说有一个卖椅子的商家"},{"from":277.36,"to":278.8,"content":"号称是纯手工制作嘛"},{"from":278.8,"to":281.32,"content":"然后材料啥的用的也是什么高级材料"},{"from":281.32,"to":284.04,"content":"就有一帮职业打假人后觉得这个可能有利可图"},{"from