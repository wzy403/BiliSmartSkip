{"schemaVersion":1,"bvid":"BV1Ta411K72v","cid":796078347,"subtitles":[{"from":0,"to":2.49,"content":"俯卧撑作为最常见的一个动作之一"},{"from":2.49,"to":4.1,"content":"可能大家平时都做过"},{"from":4.1,"to":5.6,"content":"虽然它看起来简单"},{"from":5.6,"to":10.719,"content":"但实际上一个标准的俯卧撑需要很多肌群同时参与发力"},{"from":10.719,"to":12.669,"content":"如果你的某一个部位比较薄弱"},{"from":12.669,"to":14.85,"content":"就很容易出现动作变形"},{"from":14.85,"to":15.87,"content":"不仅难看"},{"from":15.87,"to":17.76,"content":"甚至还有受伤的风险"},{"from":17.76,"to":20.19,"content":"所以今天这期视频我们就一起来看一下"},{"from":20.19,"to":23.1,"content":"如何快速学会做一个标准的俯卧撑"},{"from":23.1,"to":26.7,"content":"以及如何在保持标准动作的同时增加数量"},{"from":26.7,"to":28.869,"content":"进而彻底掌握这个动作"},{"from":28.869,"to":32.8,"content":"咱们先来一起看一下一个标准的俯卧撑是如何完成的"},{"from":32.8,"to":35.35,"content":"首先保持一个平板支撑的动作"},{"from":35.35,"to":36.49,"content":"从侧面上看"},{"from":36.49,"to":38.63,"content":"我们的身体应该是一条直线"},{"from":38.63,"to":39.8,"content":"在下落过程中"},{"from":39.8,"to":42.89,"content":"只有肩关节和肘关节的角度才发生变化"},{"from":42.89,"to":44.15,"content":"到达最底部时"},{"from":44.15,"to":46.56,"content":"胸部几乎是贴近于地面的"},{"from":46.56,"to":49.71,"content":"而起身时身体也要时刻保持稳定"},{"from":49.71,"to":52.04,"content":"这就是一个标准俯卧撑的做法"},{"from":52.04,"to":54.5,"content":"但实际上在我们自己做的过程中"},{"from":54.5,"to":56.769,"content":"经常会出现以下几种情况"},{"from":56.769,"to":59.769,"content":"在起始位置身体就已经发生变形"},{"from":59.769,"to":62.199,"content":"很难维持平板支撑的状态"},{"from":62.199,"to":65.25,"content":"动作过程中出现手肘或手腕的疼痛"},{"from":65.25,"to":67.37,"content":"不自觉的耸肩或低头"},{"from":67.37,"to":69.71,"content":"下落时没法到达最低点"},{"from":69.71,"to":71.96,"content":"如果大家不知道自己有哪个问题"},{"from":71.96,"to":73.87,"content":"可以现在就做一个俯卧撑"},{"from":73.87,"to":77.17,"content":"然后用手机在侧面记录一下整个过程"},{"from":77.17,"to":80.14,"content":"我们就可以很直观地发现自己的问题"},{"from":80.14,"to":82.5,"content":"如果大家发现自己是第一种情况"},{"from":82.5,"to":84.66,"content":"在起始位置出现了塌腰"},{"from":84.66,"to":87.06,"content":"抬屁股或者膝盖弯曲等问题"},{"from":87.06,"to":90.65,"content":"那很有可能就是因为核心力量不足所导致的"},{"from":90.65,"to":92.42,"content":"那么在做标准俯卧撑之前"},{"from":92.42,"to":95.22,"content":"我们要练习一些加强核心的动作"},{"from":95.22,"to":97.05,"content":"我们可以先做一个仰卧"},{"from":97.05,"to":98.19,"content":"骨盆后倾"},{"from":98.19,"to":99.99,"content":"因为在做俯卧撑的过程中"},{"from":99.99,"to":104.11,"content":"我们的臀部全程都要保持一个后倾和收紧的状态"},{"from":104.11,"to":105.49,"content":"那么对于新手来说"},{"from":105.49,"to":108.97,"content":"躺在地上做会更容易找到后倾的感觉"},{"from":108.97,"to":110.44,"content":"练习八到十次之后"},{"from":110.44,"to":114.24,"content":"我们可以接着做十个臀桥来激活我们的臀大肌"},{"from":114.24,"to":115.83,"content":"感受臀部收缩"},{"from":115.83,"to":118.41,"content":"如果大家完成这两个动作都没有问题"},{"from":118.41,"to":120.09,"content":"我们可以进阶到死虫"},{"from":120.09,"to":123.09,"content":"这个动作在保持骨盆后倾的同时"},{"from":123.09,"to":126.3,"content":"将一侧腿和另一侧手向两边打开"},{"from":126.3,"to":127.5,"content":"到达底部时"},{"from":127.5,"to":129.06,"content":"大腿完全伸直"},{"from":129.06,"to":130.22,"content":"然后还原"},{"from":130.22,"to":132.83,"content":"如果大家能够标准的做十次这个动作"},{"from":132.83,"to":134.12,"content":"而不移动骨盆"},{"from":134.12,"to":136.97,"content":"我们就可以进阶到静态平板支撑了"},{"from":136.97,"to":138.92,"content":"我们的目标是在不塌腰"},{"from":138.92,"to":139.73,"content":"不撅臀"},{"from":139.73,"to":141.26,"content":"膝盖不弯曲的情况下"},{"from":141.26,"to":142.4,"content":"坚持30秒"},{"from":142.4,"to":146.99,"content":"这样就有足够的核心力量来支撑我们完成标准的俯卧撑了"},{"from":146.99,"to":149.54,"content":"如果你目前还无法完成起始动作"},{"from":149.54,"to":152.76,"content":"可以按这个流程来每天练习一下"},{"from":153.3,"to":154.76,"content":"那如果大家是第二种情"},{"from":154.76,"to":155.09,"content":"况"},{"from":155.09,"to":158.96,"content":"在动作过程中出现了手肘或手腕酸痛等问题"},{"from":158.96,"to":162.2,"content":"那很有可能就是手的位置不对所导致的"},{"from":162.2,"to":163.4,"content":"手的位置过宽"},{"from":163.4,"to":165.02,"content":"会缩短动作幅度"},{"from":165.02,"to":167.18,"content":"同时让我们肩膀受力过多"},{"from":167.18,"to":168.92,"content":"甚至造成肩膀损伤"},{"from":168.92,"to":170.15,"content":"而两手位置过窄"},{"from":170.15,"to":172.36,"content":"对于柔韧性不好的小伙伴来说"},{"from":172.36,"to":175.18,"content":"也很容易对手腕造成极大的压力"},{"from":175.18,"to":178.41,"content":"所以我们要找到最适合自己身体结构的位置"},{"from":178.41,"to":179.4,"content":"要做到这一点"},{"from":179.4,"to":181.56,"content":"最简单的方法是趴在地上"},{"from":181.56,"to":183.11,"content":"将两手放在身前"},{"from":183.11,"to":187.47,"content":"然后慢慢将肘部回缩到45~60度左右的位置"},{"from":187.47,"to":189.78,"content":"保持这个角度外旋我们的手肘"},{"from":189.78,"to":191.58,"content":"并将指尖微微冲外"},{"from":191.58,"to":192.57,"content":"从侧面上看"},{"from":192.57,"to":195.15,"content":"我们的小臂近似垂直于地面"},{"from":195.15,"to":196.5,"content":"对于绝大多数人来说"},{"from":196.5,"to":198.88,"content":"这是一个最安全的位置区间"},{"from":198.88,"to":201.31,"content":"同时为了避免肘部压力过大"},{"from":201.31,"to":202.96,"content":"我们可以用脚尖着地"},{"from":202.96,"to":204,"content":"而不是脚掌"},{"from":204,"to":206.79,"content":"并且在动作过程中以脚尖为支点"},{"from":206.79,"to":209.85,"content":"让身体以一个弧形来进行动作"},{"from":209.85,"to":211.05,"content":"这样既安全"},{"from":211.05,"to":213.89,"content":"也会对我们的胸部有更全面的刺激"},{"from":213.89,"to":218.269,"content":"而如果大家在动作过程中出现了耸肩或低头等问题"},{"from":218.269,"to":223.759,"content":"那么很有可能就是我们的下斜方肌力量不足或没有参与发力所导致的"},{"from":223.759,"to":225.24,"content":"那么在做俯卧撑之前"},{"from":225.24,"to":226.8,"content":"我们要先激活一下他"},{"from":226.8,"to":229.02,"content":"在2001年的调查牛中发现"},{"from":229.02,"to":231,"content":"相比于其他背部动作"},{"from":231,"to":235.47,"content":"俯身眼镜蛇收缩对于下斜方肌有着最高的刺激"},{"from":235.47,"to":240.49,"content":"所以我们可以用这个动作帮助我们改善在俯卧撑过程中的背部姿势"},{"from":240.49,"to":242.05,"content":"首先掌心向上"},{"from":242.05,"to":242.97,"content":"趴在地上"},{"from":242.97,"to":246.54,"content":"然后向上挺胸的同时收缩我们的背部"},{"from":246.54,"to":247.68,"content":"保持这个姿势"},{"from":247.68,"to":250.46,"content":"外旋手掌并向下后方发力"},{"from":250.46,"to":251.39,"content":"持续五秒"},{"from":251.39,"to":252.35,"content":"然后还原"},{"from":252.35,"to":253.92,"content":"总共做五次"},{"from":254.38,"to":256.11,"content":"在激活下斜方肌之后"},{"from":256.11,"to":257.73,"content":"如果大家希望强化它"},{"from":257.73,"to":259.29,"content":"可以尝试跪姿"},{"from":259.29,"to":260.96,"content":"外资收缩这个动作"},{"from":260.96,"to":262.13,"content":"跪在地上之后"},{"from":262.13,"to":263.51,"content":"身体微微前倾"},{"from":263.51,"to":266.99,"content":"然后将两只手一个y字形向两边打开"},{"from":266.99,"to":267.98,"content":"保持一秒"},{"from":267.98,"to":269.169,"content":"然后还原"},{"from":269.169,"to":270.519,"content":"结合这两个动作"},{"from":270.519,"to":274.68,"content":"就会对我们的下斜方肌有很好的激活和强化作用"},{"from":274.68,"to":277.26,"content":"做俯卧撑时有耸肩问题的小伙伴"},{"from":277.26,"to":279.56,"content":"你每天单独练习一下"},{"from":282,"to":283.79,"content":"如果大家是第四种情况"},{"from":283.79,"to":286.37,"content":"在动作过程中无法下到最低点"},{"from":286.37,"to":288.65,"content":"或者下到最低点却起不来"},{"from":288.65,"to":293.03,"content":"那么很有可能就是我们的手臂和胸部力量不足所导致的"},{"from":293.03,"to":296.88,"content":"那这样最好的办法就是先做一些简易版本的俯卧撑"},{"from":296.88,"to":299.4,"content":"来强化一下我们的手臂和胸部力量"},{"from":299.4,"to":302.49,"content":"因为身体与地面的夹角越高就越简单"},{"from":302.49,"to":305.69,"content":"我们可以先做60度左右的推墙俯卧撑"},{"from":305.69,"to":307.88,"content":"在可以标准地完成五个之后"},{"from":307.88,"to":310.85,"content":"我们可以降低角度进阶到45度"},{"from":310.85,"to":313.34,"content":"凳子俯卧撑或者膝盖俯卧撑"},{"from":313.34,"to":315.95,"content":"当这两种可以标准做五个以上时"},{"from":315.95,"to":321.58,"content":"我们就可以清洁到只在下落时保持标准姿势的三秒离心收缩俯卧撑"},{"from":321.58,"to":324.46,"content":"如果你能保持标准姿势做至少五个"},{"from":324.46,"to":329.11,"content":"那么最终我们就有足够的上肢力量来尝试标准俯卧撑了"},{"from":329.11,"to":330.22,"content":"值得注意的是"},{"from":330.22,"to":334.18,"content":"如果大家在做的过程中发现自己出现了动作变形"},{"from":334.18,"to":335.52,"content":"千万不要心急"},{"from":335.52,"to":339.02,"content":"回到之前的简单版本再慢慢进行尝试"},{"from":339.4,"to":342.76,"content":"最后如果大家已经能做一个标准的俯卧撑了"},{"from":342.76,"to":345.22,"content":"那我们该如何提高它的数量呢"},{"from":345.22,"to":348.37,"content":"其实最简单的办法还是要先了解自己的弱点"},{"from":348.37,"to":349.51,"content":"比如对于我来说"},{"from":349.51,"to":351.539,"content":"当我看自己的视频回放时"},{"from":351.539,"to":353.579,"content":"我发现做到第二个的时候"},{"from":353.579,"to":355.24,"content":"我的腰有些下塌"},{"from":355.24,"to":357.55,"content":"膝盖和臀部都产生了变形"},{"from":357.55,"to":360.16,"content":"那么就说明相比于手臂和胸部力量"},{"from":360.16,"to":362.43,"content":"我需要额外加