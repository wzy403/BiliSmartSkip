{"schemaVersion":1,"bvid":"BV1JJUsB4E21","cid":34184760275,"subtitles":[{"from":0.04,"to":4.14,"content":"大家好，欢迎回到我们的Linux和开源新闻节目"},{"from":4.14,"to":6.92,"content":"这周我们有关于NVIDIA的好消息"},{"from":6.92,"to":12.02,"content":"他们终于开始重视Linux，贡献开源驱动程序"},{"from":12.02,"to":14.57,"content":"同时也在尝试实施更多行业标准"},{"from":14.57,"to":20.25,"content":"这些标准旨在帮助整个Linux桌面生态"},{"from":20.25,"to":20.95,"content":"这真是太好了"},{"from":20.95,"to":23.49,"content":"我们也看到欧盟不幸地"},{"from":23.49,"to":25.91,"content":"他们可能向大科技公司妥协"},{"from":25.91,"to":30.42,"content":"大幅简化欧盟用户的保护措施"},{"from":30.42,"to":35.629,"content":"这意味着如果这些提案通过，隐私保护将受到重创"},{"from":35.629,"to":38.249,"content":"此外还有大量Linux桌面相关内容"},{"from":38.249,"to":39.409,"content":"桌面环境"},{"from":39.409,"to":42.009,"content":"网络浏览器和Linux游戏"},{"from":42.009,"to":44.36,"content":"我们还有一段赞助商信息"},{"from":44.36,"to":46.92,"content":"这段视频由Squarespace赞助"},{"from":46.92,"to":49.2,"content":"您可以在一个平台上完成创建"},{"from":49.2,"to":52.05,"content":"发布和管理自己的网站"},{"from":52.05,"to":56.71,"content":"他们提供了超级易用的工具打造在线形象"},{"from":56.71,"to":58.72,"content":"无论您是否懂编程"},{"from":58.72,"to":60.88,"content":"他们推出了蓝图系统"},{"from":60.88,"to":64.239,"content":"让您从多种预设模板中选择"},{"from":64.239,"to":66.199,"content":"适合各种类型的网站"},{"from":66.199,"to":67.779,"content":"无论是简单的博客"},{"from":67.779,"to":68.859,"content":"在线商店"},{"from":68.859,"to":69.959,"content":"视频平台"},{"from":69.959,"to":74.28,"content":"所有模板都优化了SEO效果"},{"from":74.28,"to":76.76,"content":"他们还提供多种SEO工具"},{"from":76.76,"to":78.04,"content":"确保您的网站"},{"from":78.04,"to":82.539,"content":"不会在谷歌搜索结果中排名靠后"},{"from":82.539,"to":84.099,"content":"除此之外"},{"from":84.099,"to":87.879,"content":"Squarespace有自己的设计引擎"},{"from":87.879,"to":90.86,"content":"您可以自由拖拽元素布局"},{"from":90.86,"to":92.06,"content":"调整颜色"},{"from":92.06,"to":92.72,"content":"字体"},{"from":92.72,"to":94.12,"content":"并修改模板"},{"from":94.12,"to":95.02,"content":"随心所欲"},{"from":95.02,"to":96.87,"content":"或者完全自动化操作"},{"from":96.87,"to":98.65,"content":"当您满意后"},{"from":98.65,"to":104.29,"content":"可添加在线商店等功能，集成信用卡支付系统"},{"from":104.29,"to":104.91,"content":"PayPal"},{"from":104.91,"to":106.43,"content":"Apple Pay等支付方式"},{"from":106.43,"to":110.73,"content":"甚至可设计专属Logo并注册域名"},{"from":110.73,"to":112.35,"content":"立即访问Squarespace"},{"from":112.35,"to":112.76,"content":"Com"},{"from":112.76,"to":114.1,"content":"Slash the Linux Experiment"},{"from":114.1,"to":116.14,"content":"或点击描述中的链接"},{"from":116.14,"to":120.639,"content":"首单网站或域名享10%折扣"},{"from":120.959,"to":121.379,"content":"好的"},{"from":121.379,"to":123.339,"content":"现在让我们开始聊NVIDIA"},{"from":123.339,"to":126.759,"content":"他们开始为Nova开源驱动贡献代码"},{"from":126.759,"to":131.83,"content":"那顶红色帽子是Timor Tabby的一位工程师几个月前开始的项目"},{"from":131.83,"to":136.49,"content":"他们提交了十一项补丁以添加对Nova驱动的图灵架构支持"},{"from":136.49,"to":140,"content":"这进一步增强了已有的Air架构支持"},{"from":140,"to":145.64,"content":"当然它使用了所有新NVIDIA显卡依赖的GSP固件"},{"from":145.64,"to":148.92,"content":"其中包含了运行这些显卡的核心代码"},{"from":148.92,"to":154.35,"content":"驱动程序通常调用位于GSP固件内部的代码"},{"from":154.35,"to":160.08,"content":"现在这些补丁使图灵显卡能够启动并访问GSP固件"},{"from":160.08,"to":165.37,"content":"尽管仍处于早期阶段且需要从Git获取最新Linux固件"},{"from":165.37,"to":171.94,"content":"但至少意味着GeForce 16/20系列将通过Nova获得支持"},{"from":171.94,"to":174.96,"content":"同时支持30/40/50系列"},{"from":174.96,"to":176.89,"content":"这真是太好了"},{"from":176.89,"to":177.25,"content":"现在"},{"from":177.25,"to":179.21,"content":"这个驱动还远未完善"},{"from":179.21,"to":184.15,"content":"我认为我们还需要几年时间才能将其作为默认选项取代Nouveau"},{"from":184.15,"to":189.11,"content":"但看到NVIDIA真正参与其中仍令人鼓舞"},{"from":189.11,"to":190.29,"content":"并持续改进它"},{"from":190.29,"to":196.369,"content":"或许这将开启未来所有用户都能使用Nova和Nvk的可能"},{"from":196.369,"to":200.98,"content":"在Linux系统中普通用户"},{"from":200.98,"to":205.11,"content":"或需要专业/商业支持的用户"},{"from":205.11,"to":205.55,"content":"或需要官方支持的用户"},{"from":205.55,"to":206.81,"content":"都可以选择NVIDIA驱动"},{"from":206.81,"to":209.99,"content":"这将非常美妙"},{"from":209.99,"to":212.499,"content":"我认为看到NVIDIA"},{"from":212.499,"to":216.65,"content":"终于拥抱Linux生态"},{"from":216.65,"to":217.89,"content":"不再固守自成一派"},{"from":217.89,"to":220.13,"content":"他们还在XDC开发者大会上做了演讲"},{"from":220.13,"to":221.23,"content":"开发者大会"},{"from":221.23,"to":226.64,"content":"讨论了Linux内核中DRM子系统的碎片化问题"},{"from":226.64,"to":228.14,"content":"也称为DRM"},{"from":228.14,"to":230.82,"content":"不要与数字版权管理混淆"},{"from":230.82,"to":235.88,"content":"这是污染所有文件格式的绝对祸患"},{"from":235.88,"to":239.6,"content":"这是Linux系统显示内容的核心系统"},{"from":239.6,"to":242.78,"content":"NVIDIA主张在此领域加强统一"},{"from":242.78,"to":243.5,"content":"例如"},{"from":243.5,"to":249.66,"content":"内核中有五个七种DRM驱动支持帧缓冲设备模拟"},{"from":249.66,"to":250.76,"content":"这是一个API"},{"from":250.76,"to":254.11,"content":"依赖兼容层在屏幕上显示内容"},{"from":254.11,"to":254.99,"content":"但例如"},{"from":254.99,"to":261.01,"content":"仅14个驱动支持Linux内核新推出的蓝屏死机功能"},{"from":261.01,"to":263.79,"content":"问题在于这两个功能"},{"from":263.79,"to":269.05,"content":"API应使用相同的机制绘制屏幕内容"},{"from":269.05,"to":273.58,"content":"但每个都在重复实现相同功能"},{"from":273.58,"to":278.16,"content":"这意味着开发者需要额外工作来支持这些功能"},{"from":278.16,"to":281.06,"content":"NVIDIA因此主张加强统一"},{"from":281.06,"to":283.4,"content":"因此可以在例如"},{"from":283.4,"to":284.1,"content":"例如"},{"from":284.1,"to":288.89,"content":"帧缓冲模拟与DRM内核崩溃功能之间复用调用"},{"from":288.89,"to":291.64,"content":"而非在两者中重复代码"},{"from":291.64,"to":295.58,"content":"他们还指出了Wayland屏幕录制"},{"from":295.58,"to":298.08,"content":"在合成器和应用程序中的支持问题"},{"from":298.08,"to":303.02,"content":"需要通过图形用户界面交互来选择要共享的内容"},{"from":303.02,"to":304.56,"content":"这会阻止自动化操作"},{"from":304.56,"to":310.65,"content":"客户端也无法自动请求特定屏幕或窗口进行屏幕录制"},{"from":310.65,"to":313.11,"content":"会话不一定可恢复"},{"from":313.11,"to":316.69,"content":"缺乏预先授权也是你的问题"},{"from":316.69,"to":318.13,"content":"这可以让用户声明"},{"from":318.13,"to":323.67,"content":"始终允许在屏幕Y上为应用X或Z进行屏幕录制"},{"from":323.67,"to":325.95,"content":"当然这是底层技术问题"},{"from":325.95,"to":327.13,"content":"但他们确实有道理"},{"from":327.13,"to":329.65,"content":"如果目标是在屏幕上绘制内容"},{"from":329.65,"to":332.91,"content":"现在应该采用统一方式处理"},{"from":332.91,"to":337.53,"content":"现在英伟达却在主张更多统一化"},{"from":337.53,"to":339.09,"content":"长期以来"},{"from":339.09,"to":344.73,"content":"他们完全忽视了他人的标准并试图构建自己的版本"},{"from":344.73,"to":345.03,"content":"这"},{"from":345.03,"to":346.86,"content":"显然无人采用"},{"from":346.86,"to":349.5,"content":"随后他们转向了正确标准"},{"from":349.5,"to":351.1,"content":"尤其是针对whaland支持"},{"from":351.1,"to":351.64,"content":"例如"},{"from":351.64,"to":353.36,"content":"根据whalen的屏幕录制规范"},{"from":353.36,"to":354,"content":"他们是对的"},{"from":354,"to":356.2,"content":"存在大量类似小问题"},{"from":356.2,"to":357.94,"content":"例如我使用obs"},{"from":357.94,"to":359.19,"content":"我有三个场景"},{"from":359.19,"to":361.53,"content":"其中两个使用屏幕共享"},{"from":361.53,"to":364.03,"content":"每次我都会被询问"},{"from":364.03,"to":365.45,"content":"我重新打开obs"},{"from":365.45,"to":368.21,"content":"要录制哪个窗口或屏幕"},{"from":368.21,"to":370.57,"content":"这非常无聊"},{"from":370.57,"to":371.43,"content":"操作很快"},{"from":371.43,"to":372.55,"content":"不算大问题"},{"from":372.55,"to":373.61,"content":"但令人烦躁"},{"from":373.61,"to":375.38,"content":"我希望它能记住偏好设置"},{"from":375.38,"to":378.16,"content":"不确定这是obs的问题还是wayland的问题"},{"from":378.16,"to":379.81,"content":"但必须修复"},{"from":379.81,"to":382.11,"content":"总结英伟达部分"},{"from":382.11,"to":383.79,"content":"这关乎nvk"},{"from":383.79,"to":385.33,"content":"并非来自英伟达"},{"from":385.33,"to":389.76,"content":"这次是由kola bora创建的vulkan驱动"},{"from":389.76,"to":390.92,"content":"主要基于信任"},{"from":390.92,"to":395.26,"content":"并且该驱动也有大量工作在进行"},{"from":395.26,"to":395.9,"content":"例如"},{"from":395.9,"to":398.71,"content":"他们添加了vulkan 1.4功能"},{"from":398.71,"to":401.11,"content":"还开发了协作矩阵"},{"from":401.11,"to":404.77,"content":"这是vulkan的AI和机器学习扩展"},{"from":404.77,"to":408.39,"content":"主要致力于提升驱动性能"},{"from":408.39,"to":410.82,"content":"实现实时延迟处理"},{"from":410.82,"to":411.96,"content":"更好的调度机制"},{"from":411.96,"to":414.98,"content":"更优的内存访问和图像压缩"},{"from":414.98,"to":419.06,"content":"但部分改动需要修改nouvo"},{"from":419.06,"to":423.5,"content":"根据信仰，目前勉强维持电力供应"},{"from":423.5,"to":428.38,"content":"这意味着这个驱动程序几乎得不到太多关注和工作量"},{"from":428.38,"to":434.78,"content":"因为可用资源有限，能投入nouvo开发的开发者数量太少"},{"from":434.78,"to":436.28,"content":"不过他们共享了图表"},{"from":436.28,"to":439.68,"content":"而在他们测试的游戏中使用nvk"},{"from":439.68,"to":443.66,"content":"达到了专有驱动约50%的性能"},{"from":443.66,"to":446.08,"content":"我推测这是nvk加nouvo的组合"},{"from":446.08,"to":448.36,"content":"尽管启用了图像压缩"},{"from":448.36,"to":452.74,"content":"某些游戏性能甚至更高，测试游戏包括《深海迷航》"},{"from":452.74,"to":453.64,"content":"《帝国时代》"},{"from":453.64,"to":454.94,"content":"《原子之心》"},{"from":454.94,"to":456.04,"content":"《深岩银河》"},{"from":456.04,"to":457.59,"content":"或《XCOM2》"},{"from":457.59,"to":457.95,"content":"现在"},{"from":457.95,"to":461.41,"content":"接下来nvk驱动的任务是完善"},{"from":461.41,"to":464.35,"content":"对硬件的Vulkan视频支持"},{"from":464.35,"to":466.14,"content":"加速视频解码"},{"from":466.14,"to":468.06,"content":"修复Zink驱动的漏洞"},{"from":468.06,"to":473.23,"content":"确保使用nvk驱动时OpenGL支持良好"},{"from":473.23,"to":478.659,"content":"当然还有提升性能以追上官方NVIDIA驱动"},{"from":478.659,"to":481.499,"content":"看到这一点真是太棒了"},{"from":481.499,"to":484.9,"content":"如果这个依赖旧nouvo驱动的驱动"},{"from":484.9,"to":488.54,"content":"能提供官方驱动50%的性能"},{"from":488.54,"to":489.22,"content":"这已经很好了"},{"from":489.22,"to":493.459,"content":"启用图像压缩时有时可达70%或80%"},{"from":493.459,"to":495.939,"content":"那效果就非常好"},{"from":495.939,"to":500.92,"content":"当nova进入Linux内核并成为默认驱动"},{"from":500.92,"to":502.44,"content":"或真正可用时"},{"from":502.44,"to":504.64,"content":"性能也会大幅提升"},{"from":504.64,"to":509.2,"content":"因为nouvo需处理大量遗留系统和旧NVIDIA显卡"},{"from":509.2,"to":511.92,"content":"而nova只需专注于新硬件"},{"from":511.92,"to":513.249,"content":"这是了不起的工作"},{"from":513.249,"to":516.609,"content":"我迫不及待要摆脱官方NVIDIA驱动"},{"from":516.609,"to":519.799,"content":"直接使用内核中的Mesa组件"},{"from":519.799,"to":521.099,"content":"这会很棒"},{"from":521.099,"to":523.099,"content":"现在欧盟正在准备新方案"},{"from":523.099,"to":525.459,"content":"他们称之为《数字单一市场条例》"},{"from":525.459,"to":529.73,"content":"既有积极影响也有严重负面影响"},{"from":529.73,"to":533.57,"content":"积极面可能是终结Cookie弹窗"},{"from":533.57,"to":534.09,"content":"当然"},{"from":534.09,"to":536.46,"content":"新规即将出台"},{"from":536.46,"to":542.19,"content":"最显著的是允许用户在浏览器层面一次性设置Cookie偏好"},{"from":542.19,"to":544.65,"content":"你可以在浏览器设置中"},{"from":544.65,"to":547.09,"content":"始终拒绝非必要Cookie"},{"from":547.09,"to":548.41,"content":"访问网站时"},{"from":548.41,"to":549.87,"content":"网站会查询此偏好"},{"from":549.87,"to":550.97,"content":"收到拒绝回复"},{"from":550.97,"to":553.11,"content":"无法使用非必要Cookie"},{"from":553.11,"to":554.99,"content":"甚至不会显示弹窗"},{"from":554.99,"to":559.61,"content":"网站必须遵守否则面临处罚，这太棒了"},{"from":559.61,"to":562.83,"content":"问题在于最初这不会是这种情况"},{"from":562.83,"to":564.55,"content":"规则将被大幅简化"},{"from":564.55,"to":567.73,"content":"因此Cookie弹窗将变为是或否选项"},{"from":567.73,"to":572.17,"content":"这显然比现有系统对普遍隐私更差"},{"from":572.17,"to":576.79,"content":"虽然当前那些充满暗黑设计的复杂弹窗方案"},{"from":576.79,"to":577.95,"content":"确实很糟糕"},{"from":577.95,"to":582.75,"content":"但仍允许用户配置不希望收集或存储的内容"},{"from":582.75,"to":588.709,"content":"而新方案在实施brazel偏好前完全不提供这种功能"},{"from":588.709,"to":590.129,"content":"但主要问题在于"},{"from":590.129,"to":596.48,"content":"这项数字综合法案已被广泛批评是重大隐私倒退"},{"from":596.48,"to":598.76,"content":"本质上只是放松监管"},{"from":598.76,"to":605.84,"content":"主要争议点在于允许任何AI主体使用个人用户数据训练"},{"from":605.84,"to":607.929,"content":"如果能证明正当性"},{"from":607.929,"to":612.3,"content":"但这为公司寻找正当理由留下了很大空间"},{"from":612.3,"to":617.06,"content":"这意味着已收集个人数据并训练的AI主体"},{"from":617.06,"to":620.36,"content":"无需从头开始或修改模型"},{"from":620.36,"to":621.02,"content":"完全不必"},{"from":621.02,"to":627.02,"content":"这已是重大问题，因为当开始在AI模型中包含个人数据"},{"from":627.02,"to":630.62,"content":"将打开大规模监控和画像的大门"},{"from":630.62,"to":634.59,"content":"这绝对是在剥夺人们的隐私"},{"from":634.59,"to":635.25,"content":"此外"},{"from":635.25,"to":639.27,"content":"GDPR框架上新增的诸多保护措施"},{"from":639.27,"to":642.71,"content":"将被移入GDP框架"},{"from":642.71,"to":645.5,"content":"这更加灵活"},{"from":645.5,"to":647.66,"content":"为企业留下更多操作空间"},{"from":647.66,"to":651.74,"content":"为企业提供大量例外可利用以争取批准"},{"from":651.74,"to":654.38,"content":"但我们确实需要这些信息"},{"from":654.38,"to":656.58,"content":"并且需要保留更久"},{"from":656.58,"to":658.72,"content":"因为这是出于正当利益"},{"from":658.72,"to":661.84,"content":"作为用户访问网站的交换条件"},{"from":661.84,"to":664,"content":"用于管理用户偏好"},{"from":664,"to":668,"content":"因此在线隐私将大幅减少"},{"from":668,"to":669.19,"content":"如果此方案通过"},{"from":669.19,"to":671.41,"content":"幸运的是这只是提案"},{"from":671.41,"to":672.98,"content":"仍可被否决"},{"from":672.98,"to":678.22,"content":"大多数隐私倡导者和组织都在强调这一点"},{"from":678.22,"to":682.48,"content":"这对欧盟隐私是巨大倒退"},{"from":682.48,"to":684.76,"content":"正被包装成能带来帮助的方案"},{"from":684.76,"to":685.26,"content":"呃"},{"from":685.26,"to":685.7,"content":"欧盟"},{"from":685.7,"to":688.16,"content":"企业与初创公司更具竞争力"},{"from":688.16,"to":690.44,"content":"在国际舞台上竞争"},{"from":690.44,"to":694.86,"content":"但显然这也将惠及所有大型科技公司"},{"from":694.86,"to":697.02,"content":"这些公司有能力收集所有数据"},{"from":697.02,"to":698.94,"content":"为自身决策进行辩护"},{"from":698.94,"to":700.14,"content":"声称是的"},{"from":700.14,"to":702.12,"content":"他们确实有正当理由收集这些数据"},{"from":702.12,"to":706.02,"content":"这几乎就是微软的大礼包"},{"from":706.02,"to":706.5,"content":"苹果"},{"from":706.5,"to":707.64,"content":"Meta亚马逊"},{"from":707.64,"to":709.85,"content":"而它简直糟糕透了"},{"from":709.85,"to":712.03,"content":"希望它能被否决"},{"from":712.03,"to":714.21,"content":"不过让我们继续更有趣的内容"},{"from":714.21,"to":714.65,"content":"首先"},{"from":714.65,"to":719.77,"content":"现在KDE有一个新原型可更好地处理在线账户"},{"from":719.77,"to":722.47,"content":"在Plasma Nextcloud的在线账户中"},{"from":722.47,"to":723.11,"content":"Own Cloud"},{"from":723.11,"to":726.069,"content":"谷歌和开放桌面是唯一选项"},{"from":726.069,"to":732.029,"content":"问题是这些功能大多无法渗透到整个桌面和应用程序"},{"from":732.029,"to":735.35,"content":"Dolphin使用Nextcloud和Own Cloud集成"},{"from":735.35,"to":737.91,"content":"谷歌账户完全未被使用"},{"from":737.91,"to":742.21,"content":"除了一个允许直接上传视频到YouTube的应用"},{"from":742.21,"to":744.53,"content":"谷歌甚至阻止通过Dolphin访问谷歌"},{"from":744.53,"to":745.77,"content":"Drive"},{"from":745.77,"to":746.45,"content":"例如"},{"from":746.45,"to":748.71,"content":"所以即使你设置了其中一个账户"},{"from":748.71,"to":749.73,"content":"你的所有邮件"},{"from":749.73,"to":750.23,"content":"联系人"},{"from":750.23,"to":751.04,"content":"日历"},{"from":751.04,"to":752.36,"content":"待办事项"},{"from":752.36,"to":755.79,"content":"任何KDE应用都无法同步这些数据"},{"from":755.79,"to":757.83,"content":"这简直糟糕透了"},{"from":757.83,"to":759.47,"content":"也没有Mastodon账户"},{"from":759.47,"to":763.34,"content":"没有矩阵支持，还有很多其他账户可以添加"},{"from":763.34,"to":764,"content":"基本上"},{"from":764,"to":766.34,"content":"现在这个功能没什么用"},{"from":766.34,"to":769.58,"content":"而且甚至无法与沙盒应用正常配合"},{"from":769.58,"to":772.3,"content":"因此有一个新原型与恶魔配合"},{"from":772.3,"to":777.8,"content":"需要为每个特定账户授权给das应用"},{"from":777.8,"to":779.38,"content":"以便访问其数据"},{"from":779.38,"to":782.98,"content":"类似于现代桌面的门户机制"},{"from":782.98,"to":787.39,"content":"恶魔处理从账户数据库到应用的登录流程"},{"from":787.39,"to":789.95,"content":"目前这个原型支持Nextcloud"},{"from":789.95,"to":793.05,"content":"现已集成到KD PM软件中"},{"from":793.05,"to":795.98,"content":"因此KMail、日历、联系人等"},{"from":795.98,"to":797.78,"content":"它还支持Mastodon"},{"from":797.78,"to":799.86,"content":"目前与Toko Dan集成"},{"from":799.86,"to":802.18,"content":"KDE的Mastodon客户端"},{"from":802.18,"to":804.4,"content":"同时处理谷歌账户"},{"from":804.4,"to":808.7,"content":"由KD个人信息管理应用处理"},{"from":808.7,"to":810.24,"content":"Soap联系人日历"},{"from":810.24,"to":811.6,"content":"等等和KMail"},{"from":811.6,"to":813.14,"content":"也就是说当你设置该账户后"},{"from":813.14,"to":818.12,"content":"相关账户信息会出现在应使用它的应用中"},{"from":818.12,"to":820.7,"content":"这是更好的解决方案"},{"from":820.7,"to":824.62,"content":"希望未来更实用并支持更多账户类型"},{"from":824.62,"to":825.839,"content":"随着时间推移"},{"from":825.839,"to":828.519,"content":"这是一个重大易用性功能"},{"from":828.519,"to":831.82,"content":"大多数人依赖数字生态系统"},{"from":831.82,"to":833.84,"content":"无论是通过Nextcloud自己的"},{"from":833.84,"to":837.31,"content":"或者他们的公司拥有Exchange或微软账户"},{"from":837.31,"to":843.39,"content":"或者是否整合谷歌服务只需在设置中一次简单登录"},{"from":843.39,"to":846.53,"content":"然后所有需要访问这些数据的应用都可以使用"},{"from":846.53,"to":847.68,"content":"如果你允许的话"},{"from":847.68,"to":852.89,"content":"这比在每个应用中重复输入信息要实用得多"},{"from":852.89,"to":854.03,"content":"你想要使用的应用"},{"from":854.03,"to":856.25,"content":"可能需要访问你的邮箱"},{"from":856.25,"to":856.63,"content":"联系人"},{"from":856.63,"to":857.29,"content":"日历"},{"from":857.29,"to":860.05,"content":"而且在Linux上也不是什么大问题"},{"from":860.05,"to":861.83,"content":"因为这些应用都是开源的"},{"from":861.83,"to":864.06,"content":"你知道代码可以审计"},{"from":864.06,"to":868,"content":"如果这些应用真的做了奇怪的操作处理你的账户数据"},{"from":868,"to":873.92,"content":"人们可能会发现像Zorinos十八版曾引发重大关注"},{"from":873.92,"to":874.46,"content":"报告"},{"from":874.46,"to":877.37,"content":"单月下载量达一百万"},{"from":877.37,"to":878.89,"content":"这相当可爱"},{"from":878.89,"to":882.59,"content":"前48小时仅下载十万次"},{"from":882.59,"to":887.139,"content":"现在发行版的发展速度极快"},{"from":887.139,"to":891.599,"content":"这可能包括许多对Windows 10生命周期结束不满的人"},{"from":891.599,"to":895.89,"content":"以及Windows 11实际上是个糟糕的操作系统"},{"from":895.89,"to":902.24,"content":"但也可能包括运行Zorino十七版的用户"},{"from":902.24,"to":905.4,"content":"因为他们没有真正的升级路径"},{"from":905.4,"to":910.35,"content":"但他们开始实验性测试"},{"from":910.35,"to":916.52,"content":"但显然存在严重问题，目前不应使用"},{"from":916.52,"to":920.08,"content":"所以许多用户直接下载新ISO覆盖旧系统"},{"from":920.08,"to":922.26,"content":"这个升级路径最终会解决"},{"from":922.26,"to":923.48,"content":"但如果你不想重新安装的话"},{"from":923.48,"to":925.16,"content":"只能耐心等待"},{"from":925.16,"to":928.969,"content":"另外一点"},{"from":928.969,"to":930.069,"content":"我希望更多发行版共享下载数据"},{"from":930.069,"to":932.169,"content":"他们确实有这些数据"},{"from":932.169,"to":933.789,"content":"当你从官网下载时"},{"from":933.789,"to":936.22,"content":"可以增加匿名追踪器"},{"from":936.22,"to":938.96,"content":"以统计每个镜像的下载量"},{"from":938.96,"to":941.05,"content":"同样适用于Torrent下载"},{"from":941.05,"to":944.51,"content":"最难追踪的是原地升级"},{"from":944.51,"to":947.4,"content":"因为你需要统计特定升级包的下载量"},{"f