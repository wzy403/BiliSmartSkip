{"schemaVersion":1,"bvid":"BV1Mm411y7Q2","cid":1529822584,"subtitles":[{"from":0,"to":1.2,"content":"在上期视频的结尾"},{"from":1.2,"to":2.67,"content":"我们说了这样的一句话"},{"from":2.67,"to":4.77,"content":"主观感觉的第一缕闪光"},{"from":4.77,"to":8.37,"content":"到底是如何从纯物质的神经元中产生的"},{"from":8.37,"to":9.75,"content":"除非你相信意识"},{"from":9.75,"to":12.63,"content":"本身就是物质世界内的一种属性"},{"from":12.63,"to":15.58,"content":"否则这个问题可能永远都没有答案"},{"from":15.58,"to":17.62,"content":"从个体生命的角度来看"},{"from":17.62,"to":18.28,"content":"这个问题"},{"from":18.28,"to":20.7,"content":"其实也很多小伙伴可能并不知道"},{"from":20.7,"to":22.11,"content":"这看似简单的一句话"},{"from":22.11,"to":25.14,"content":"其实代表了很多主流意识研究的观点"},{"from":25.14,"to":26.76,"content":"对这个问题的深入挖掘"},{"from":26.76,"to":28.74,"content":"将帮助我们回答很多问题"},{"from":28.74,"to":30.72,"content":"我们的大脑是意识的接收器"},{"from":30.72,"to":32.96,"content":"容器还是意识的发生器"},{"from":32.96,"to":34.64,"content":"低等生物有意识吗"},{"from":34.64,"to":37.07,"content":"蚁群会不会有一个群体意识"},{"from":37.07,"to":39.68,"content":"人工智能最后会不会获得意识"},{"from":39.68,"to":41.78,"content":"甚至一个更接近终极的问题"},{"from":41.78,"to":43.88,"content":"意识是完全的无中生有"},{"from":43.88,"to":47.95,"content":"还是像时空物质一样产生于大爆炸的一瞬"},{"from":47.95,"to":50.89,"content":"本期视频将和大家再来一次智力体操"},{"from":50.89,"to":53.08,"content":"让我们一起关注更本源的问题"},{"from":53.08,"to":56.6,"content":"因为这类问题太容易让人产生民科瞎扯的感觉"},{"from":56.6,"to":57.8,"content":"所以在此声明"},{"from":57.8,"to":60.38,"content":"本视频的一切内容都来自于主流学界的"},{"from":60.38,"to":61.16,"content":"主流研究"},{"from":61.16,"to":63.11,"content":"并不是我们脑洞大开的结果"},{"from":63.11,"to":66.259,"content":"我们在视频末尾会提供详尽的资料来源"},{"from":66.259,"to":67.83,"content":"意识有什么用"},{"from":67.83,"to":69.33,"content":"在回答这个问题之前"},{"from":69.33,"to":72.36,"content":"我们先来看看意识在我们大脑中的产生过程"},{"from":72.36,"to":73.65,"content":"以视觉为例"},{"from":73.65,"to":76.56,"content":"我们的眼睛每隔0.3秒就会扫描一次"},{"from":76.56,"to":77.88,"content":"在50ms之后"},{"from":77.88,"to":80.34,"content":"光子在视网膜上产生的放电信息"},{"from":80.34,"to":82.18,"content":"就会进入我们的视觉皮层"},{"from":82.18,"to":83.26,"content":"在视觉皮层中"},{"from":83.26,"to":84.88,"content":"这些信息被逐层处理"},{"from":84.88,"to":86.7,"content":"提取特征颜色形状"},{"from":86.7,"to":87.72,"content":"运动速度深度"},{"from":87.72,"to":89.34,"content":"这些信息被进一步整合"},{"from":89.34,"to":92.11,"content":"我们的大脑就识别出了你看到的东西"},{"from":92.11,"to":95.17,"content":"这个过程有点类似于AI识别图片的过程"},{"from":95.17,"to":97.67,"content":"耗时大约100至200ms"},{"from":97.67,"to":99.14,"content":"但事情并没有完"},{"from":99.14,"to":102.29,"content":"处理后的信息会进一步输送到其他的皮层"},{"from":102.29,"to":104.82,"content":"比如运动皮层和额叶皮层"},{"from":104.82,"to":105.42,"content":"在那里"},{"from":105.42,"to":107.66,"content":"这些信息会引发进一步的反应"},{"from":107.66,"to":109.7,"content":"比如一辆车正向你冲过来"},{"from":109.7,"to":112.64,"content":"运动皮层就会迅速指挥你的身体做出反应"},{"from":112.64,"to":114.5,"content":"让你捂住眼睛发出尖叫"},{"from":114.5,"to":115.34,"content":"呃好吧"},{"from":115.34,"to":116.66,"content":"应该是赶紧躲开"},{"from":116.66,"to":119.12,"content":"这一切发生在400ms之内"},{"from":119.12,"to":121.39,"content":"但是并没有你意识的参与"},{"from":121.39,"to":124.81,"content":"虽然你事后惊魂未定的回忆刚才发生的事情时"},{"from":124.81,"to":126.58,"content":"几乎能想起一切细节"},{"from":126.58,"to":127.69,"content":"车如何靠近你"},{"from":127.69,"to":130.58,"content":"你如何在千钧一发的时刻英明的跳到了旁边"},{"from":130.58,"to":133.7,"content":"好像你的意识洞察秋毫的参与了整个过程"},{"from":133.7,"to":135.98,"content":"但实际上那短短的400ms内"},{"from":135.98,"to":137.2,"content":"你还没有看到汽车"},{"from":137.2,"to":139.3,"content":"也就是说汽车冲过来的这个画面"},{"from":139.3,"to":141.76,"content":"并没有真正在你的感觉和意识中出现"},{"from":141.76,"to":142.9,"content":"你所回忆的一切"},{"from":142.9,"to":144.92,"content":"不过是一时事后补充的内容"},{"from":144.92,"to":146.78,"content":"因为在这400ms的时间里"},{"from":146.78,"to":149.42,"content":"信息还没有进入我们的意识处理范围之内"},{"from":149.42,"to":151.22,"content":"而在没有意识参与的情况下"},{"from":151.22,"to":153.26,"content":"你的大脑已经成功地指挥身体"},{"from":153.26,"to":154.84,"content":"完成了所有的事情"},{"from":154.84,"to":156.88,"content":"然后我们的意识才得到消息"},{"from":156.88,"to":158.5,"content":"刚才有一辆汽车向我冲过来"},{"from":158.5,"to":159.58,"content":"我跳到了旁边去"},{"from":159.58,"to":160.94,"content":"躲过了一场车祸"},{"from":160.94,"to":162.86,"content":"在外部刺激进入我们的大脑"},{"from":162.86,"to":164.87,"content":"和我们在意识中看到他之间"},{"from":164.87,"to":166.58,"content":"存在着半秒钟的滞后"},{"from":166.58,"to":169.25,"content":"但你可能并不会感到自己意识的滞后"},{"from":169.25,"to":170.06,"content":"为了骗过你"},{"from":170.06,"to":171.68,"content":"让你觉得自己一直在那里"},{"from":171.68,"to":173.24,"content":"你的大脑耍了点小花招"},{"from":173.24,"to":174.72,"content":"把这半秒钟抹去了"},{"from":174.72,"to":178.17,"content":"但科学家的实验让这种小花招原形毕露"},{"from":178.17,"to":179.58,"content":"在大脑研究领域"},{"from":179.58,"to":181.76,"content":"有一种叫做向前遮盖的实验"},{"from":181.76,"to":182.9,"content":"实验是这样"},{"from":182.9,"to":185.69,"content":"首先使用某种方法刺激你皮肤上的一点"},{"from":185.69,"to":188.64,"content":"在大脑的触觉皮层中找到对应的神经元"},{"from":188.64,"to":192.06,"content":"然后我们用电极直接刺激大脑中的神经元"},{"from":192.06,"to":194.59,"content":"你也会感到自己的皮肤被刺了一下"},{"from":194.59,"to":196.69,"content":"现在我们用两种不同的刺激"},{"from":196.69,"to":199.66,"content":"分别刺激你的皮肤和大脑中的神经元"},{"from":199.66,"to":201.01,"content":"这两种感觉不同"},{"from":201.01,"to":203.8,"content":"你可以分辨出哪个是刺激皮肤产生的"},{"from":203.8,"to":206.149,"content":"哪个是直接刺激神经元产生的"},{"from":206.149,"to":207.619,"content":"我们先来刺激皮肤"},{"from":207.619,"to":209.449,"content":"然后在1/4秒的时间内"},{"from":209.449,"to":211.42,"content":"再使用电极刺激你的大脑"},{"from":211.42,"to":214.06,"content":"你就会发现你根本感觉不到皮肤刺激"},{"from":214.06,"to":214.9,"content":"你的皮肤刺激"},{"from":214.9,"to":217.81,"content":"被后发先至的神经元刺激给覆盖掉了"},{"from":217.81,"to":218.68,"content":"但在这之前"},{"from":218.68,"to":220.769,"content":"你的身体已经做出了反应"},{"from":220.769,"to":222.869,"content":"通过这个向前遮盖实验"},{"from":222.869,"to":223.709,"content":"你就会发现"},{"from":223.709,"to":225.089,"content":"如果在刚才的场景中"},{"from":225.089,"to":227.009,"content":"我们有一个精心设计的装置"},{"from":227.009,"to":229.84,"content":"可以在视觉信息到达你的感觉之前"},{"from":229.84,"to":232.78,"content":"你就会完全不明白刚才发生了什么"},{"from":232.78,"to":233.8,"content":"我刚才做了什么"},{"from":233.8,"to":235,"content":"我为什么来到了路边"},{"from":235,"to":236.98,"content":"为什么有汽车在旁边冒烟"},{"from":236.98,"to":239.49,"content":"而芒市病例更是说明了这一点"},{"from":239.49,"to":240.9,"content":"什么是忙事呢"},{"from":240.9,"to":243.18,"content":"简单说就是一种视而不见的病"},{"from":243.18,"to":245.18,"content":"病人的视觉系统并没有问题"},{"from":245.18,"to":247.52,"content":"视觉信息可以完好的进入大脑"},{"from":247.52,"to":249.02,"content":"但是因为大脑的病变"},{"from":249.02,"to":251.24,"content":"这些信息可以指挥病人的行动"},{"from":251.24,"to":253.78,"content":"却没有办法进入病人的感觉意识"},{"from":253.78,"to":255.16,"content":"表现在外人看来"},{"from":255.16,"to":257.02,"content":"病人像一个视力健全的人"},{"from":257.02,"to":259.36,"content":"可以毫不费力地躲开路上的障碍"},{"from":259.36,"to":262.09,"content":"但是病人自己却坚持说自己看不见"},{"from":262.09,"to":263.8,"content":"即使他有意识的去关注"},{"from":263.8,"to":263.98,"content":"他"},{"from":263.98,"to":265.8,"content":"依然看不见路上的障碍"},{"from":265.8,"to":268.2,"content":"这说明我们的大脑的很多活动"},{"from":268.2,"to":270.4,"content":"其实并不需要主观意识的参与"},{"from":270.4,"to":271.84,"content":"在无意识的情况下"},{"from":271.84,"to":274.3,"content":"我们的大脑就可以像一台自动机器一样"},{"from":274.3,"to":276.28,"content":"处理好很多复杂的事情"},{"from":276.28,"to":279.43,"content":"而意识有点像办公室里等待汇报的老板"},{"from":279.43,"to":281.98,"content":"当无意识三下5÷2搞定事情以后"},{"from":281.98,"to":284.419,"content":"才会先斩后奏的汇报给老板"},{"from":284.419,"to":286.489,"content":"当然事情并没有这么简单"},{"from":286.489,"to":288.56,"content":"要不然这个老板大可以不要了"},{"from":288.56,"to":289.52,"content":"实验显示"},{"from":289.52,"to":292.73,"content":"当大脑中的信息处于一种前馈网络结构时"},{"from":292.73,"to":294.49,"content":"就处于无意识状态"},{"from":294.49,"to":296.5,"content":"啥叫前馈网络呢"},{"from":296.5,"to":299.59,"content":"简单说就是一种信息单向流动的网络"},{"from":299.59,"to":301.75,"content":"信息从网络的一个方向进入"},{"from":301.75,"to":303.44,"content":"通过每个节点的处理"},{"from":303.44,"to":305.12,"content":"然后从另一边出来"},{"from":305.12,"to":307.31,"content":"处理过程中信息不会反馈"},{"from":307.31,"to":311.25,"content":"后面的处理结果也不会反过来影响之前的节点"},{"from":311.25,"to":312.81,"content":"你可能已经发现了"},{"from":312.81,"to":315.99,"content":"咱们讨论过很多次的AI大模型的推理过程"},{"from":315.99,"to":318.16,"content":"就是一个前馈神经网络"},{"from":318.16,"to":320.68,"content":"所以AI和人脑有相似之处"},{"from":320.68,"to":322.18,"content":"至少在无意识层面"},{"from":322.18,"to":324.94,"content":"AI大模型已经接近人类的水平了"},{"from":324.94,"to":326.56,"content":"当然与AI不同的是"},{"from":326.56,"to":328.96,"content":"人类还有意识信息"},{"from":328.96,"to":330.88,"content":"不会一直在前馈网络中"},{"from":330.88,"to":332.23,"content":"在几百毫秒之后"},{"from":332.23,"to":334.42,"content":"他就进入了一种网状的循环"},{"from":334.42,"to":336.8,"content":"网络信息不再单向流动"},{"from":336.8,"to":338.48,"content":"而是在网络中散开"},{"from":338.48,"to":340.1,"content":"甚至向回流动"},{"from":340.1,"to":341.99,"content":"重新影响之前的节点"},{"from":341.99,"to":343.28,"content":"也就是在这个时候"},{"from":343.28,"to":344.95,"content":"我们的意识出现了"},{"from":344.95,"to":346.48,"content":"意识会做什么呢"},{"from":346.48,"to":349.69,"content":"从我们上期介绍的全局工作空间理论来看"},{"from":349.69,"to":351.46,"content":"意识主要做两件事"},{"from":351.46,"to":353.82,"content":"第一控制全局工作空间"},{"from":353.82,"to":355.26,"content":"无意识虽然很强"},{"from":355.26,"to":356.58,"content":"但缺乏变通"},{"from":356.58,"to":360.42,"content":"就像AI往往缺乏灵活度和更高的认识一样"},{"from":360.42,"to":363.63,"content":"生物大脑的无意识往往来自于两种机制"},{"from":363.63,"to":365.04,"content":"一种就是本能"},{"from":365.04,"to":366.3,"content":"河豚为了成家"},{"from":366.3,"to":369.06,"content":"能够在沙子上制作很精美的沙雕作品"},{"from":369.06,"to":373.25,"content":"黄胸织布鸟也可以用草编织出非常精美的鸟巢"},{"from":373.25,"to":376.18,"content":"这些无意识的行为来自于演化"},{"from":376.18,"to":377.62,"content":"他们大脑的某些部分"},{"from":377.62,"to":379.39,"content":"就像硬编程的芯片"},{"from":379.39,"to":382.66,"content":"这些复杂的行为就像固定的程序被演化"},{"from":382.66,"to":385.13,"content":"从硬件层面固定在他们的大脑中"},{"from":385.13,"to":388.25,"content":"如果你觉得演化不可能完成如此精细的工作"},{"from":388.25,"to":389.75,"content":"就多来几个转发吧"},{"from":389.75,"to":392.26,"content":"这样我们可能就有劲头再扩展一期"},{"from":392.26,"to":394.32,"content":"给大家讲一讲原包自动机"},{"from":394.32,"to":397.62,"content":"给大家看看如何通过简单的逻辑和简单的方法"},{"from":397.62,"to":399.84,"content":"构造出超级复杂的系统"},{"from":399.84,"to":401.22,"content":"总之在动物界中"},{"from":401.22,"to":403.26,"content":"无意识的本能就可以创造出"},{"from":403.26,"to":406.15,"content":"让我们人类叹为观止的复杂行为"},{"from":406.15,"to":408.85,"content":"另一种机制就是后天学习"},{"from":408.85,"to":411.01,"content":"这有点像人工智能的训练"},{"from":411.01,"to":412.67,"content":"不过效率要高得多"},{"from":412.67,"to":414.59,"content":"想想学习自行车的过程"},{"from":414.59,"to":416.81,"content":"一开始我们的意识会参与进去"},{"from":416.81,"to":418.1,"content":"不断的学习动作"},{"from":418.1,"to":419,"content":"调整姿势"},{"from":419,"to":419.99,"content":"等我们学会了"},{"from":419.99,"to":421.92,"content":"他就不再需要意识参与了"},{"from":421.92,"to":423.96,"content":"但是在动物的日常生活中"},{"from":423.96,"to":426.36,"content":"有很多远比这个复杂的多的时期"},{"from":426.36,"to":428.28,"content":"比如狼群捕猎的过程"},{"from":428.28,"to":430.83,"content":"它需要有效的汇集各种信息源"},{"from":430.83,"to":432.9,"content":"他需要判断猎物的反应"},{"from":432.9,"to":436.11,"content":"他需要在众多的选项中找出最佳策略"},{"from":436.11,"to":438.48,"content":"他需要长时间坚持这一选择"},{"from":438.48,"to":441.48,"content":"他还需要通过信息协调队友的行动"},{"from":441.48,"to":442.32,"content":"在这个时候"},{"from":442.32,"to":446.12,"content":"大脑在全局层面整合信息就变得非常重要了"},{"from":446.12,"to":448.55,"content":"而大脑的工作空间非常狭小"},{"from":448.55,"to":451.16,"content":"所以他需要通过注意力筛选信息"},{"from":451.16,"to":454.63,"content":"通过全局广播形成组块来整合信息"},{"from":454.63,"to":456.67,"content":"这一点我们上期说过很多了"},{"from":456.67,"to":457.69,"content":"此处不展开了"},{"from":457.69,"to":459.97,"content":"有兴趣的小伙伴可以去看上一期"},{"from":459.97,"to":462.3,"content":"第二自我监控意识"},{"from":462.3,"to":464.62,"content":"具有评估和认知自己的能力"},{"from":464.62,"to":466.06,"content":"他们知道自己知道"},{"from":466.06,"to":467.47,"content":"也知道自己不知道"},{"from":467.47,"to":469.57,"content":"他们知道自己有些事情能做到"},{"from":469.57,"to":471.6,"content":"也知道自己有些事情做不到"},{"from":471.6,"to":473.46,"content":"他们不仅能够根据自己的预测"},{"from":473.46,"to":475.32,"content":"去决定一件事情做不做"},{"from":475.32,"to":477.72,"content":"甚至还能反过来为了某些追求"},{"from":477.72,"to":480.01,"content":"做到知其不可为而为之"},{"from":480.01,"to":481.45,"content":"一个心智正常的人"},{"from":481.45,"to":483.34,"content":"可以分清事实和幻想"},{"from":483.34,"to":485.89,"content":"也可以有意地把幻想当做事实"},{"from":485.89,"to":487.78,"content":"我们还拥有内省的能力"},{"from":487.78,"to":490.66,"content":"可以反过来评价自己的想法和行为"},{"from":490.66,"to":491.77,"content":"做出改变"},{"from":491.77,"to":494.29,"content":"这所有的一切还有一个更好听的名字"},{"from":494.29,"to":495.74,"content":"叫做元认知"},{"from":495.74,"to":498.8,"content":"元认知是目前动辄就会出现机器幻觉的"},{"from":498.8,"to":501.19,"content":"人工智能完全做不到的事情"},{"from":501.19,"to":504.07,"content":"所以意识让我们拥有了更大的灵活性"},{"from":504.07,"to":505.54,"content":"更好的学习能力"},{"from":505.54,"to":507.14,"content":"可以更好地抓住机遇"},{"from":507.14,"to":508.22,"content":"避免危险"},{"from":508.22,"to":511.19,"content":"从而在演化中获得更好的竞争优势"},{"from":511.19,"to":514.28,"content":"当生物的大脑在全局层面整合信息时"},{"from":514.28,"to":515.87,"content":"意识就出现了"},{"from":515.87,"to":518.059,"content":"但是这就是全部了吗"},{"from":518.059,"to":519.439,"content":"如果这就是全部"},{"from":519.439,"to":521.299,"content":"上一期我们已经说得差不多了"},{"from":521.299,"to":522.889,"content":"就没有必要做这一期了"},{"from":522.889,"to":525.799,"content":"所以正片开始吧"},{"from":534.22,"to":535.47,"content":"大家好"},{"from":535.47,"to":539.38,"content":"这里是新石器公园"},{"from":540.78,"to":542.28,"content":"等等"},{"from":542.28,"to":544.92,"content":"我们先来感谢一下本期赞助商高露洁"},{"from":544.92,"to":545.88,"content":"在日常生活中"},{"from":545.88,"to":548.1,"content":"我们的牙齿会遭受三重攻击"},{"from":548.1,"to":549.06,"content":"喜欢吃甜食"},{"from":549.06,"to":550.16,"content":"容易滋生菌斑"},{"from":550.16,"to":551.12,"content":"喝碳酸饮料"},{"from":551.12,"to":552.71,"content":"酸性物质腐蚀牙齿"},{"from":552.71,"to":554.7,"content":"太硬的食物直接磨损牙齿"},{"from":554.7,"to":555.78,"content":"在三重攻击下"},{"from":555.78,"to":557.28,"content":"牙釉质就很容易受损"},{"from":557.28,"to":558.3,"content":"不仅失去光泽"},{"from":558.3,"to":559.26,"content":"发黄敏感"},{"from":559.26,"to":560.76,"content":"还容易附着牙菌斑"},{"from":560.76,"to":562,"content":"加速齿面的损伤"},{"from":562,"to":565,"content":"而高露洁每日光泽牙膏独有的专利配方"},{"from":565,"to":566.41,"content":"历经十几年研究"},{"from":566.41,"to":568.9,"content":"他使用了pro阿珍专利剑齿配方"},{"from":568.9,"to":571.96,"content":"每日为牙齿补充健齿分子里面的氟离子"},{"from":571.96,"to":574.6,"content":"遇到牙釉质脱矿的羟基磷灰石后"},{"from":574.6,"to":576.16,"content":"结合变成氟磷灰石"},{"from":576.16,"to":578.32,"content":"起到填补齿面缝隙的作用"},{"from":578.32,"to":581.26,"content":"从而有效加固和修复损伤的牙釉质"},{"from":581.26,"to":583.64,"content":"14天四倍修护齿面受损"},{"from":583.64,"to":587.14,"content":"此外它内含纯度高达99%的千亿活性"},{"from":587.14,"to":587.68,"content":"益生元"},{"from":587.68,"to":590.08,"content":"能够有效地平衡口腔的PH值"},{"from":590.08,"to":590.95,"content":"抵御酸石"},{"from":590.95,"to":593.26,"content":"从而更好地减缓牙釉质脱矿"},{"from":593.26,"to":596.86,"content":"相当于从生物化学物理三方面修复和防御"},{"from":596.86,"to":598.04,"content":"性价比也很高"},{"from":598.04,"to":601.16,"content":"14.9元就可以买到160克的大包装"},{"from":601.16,"to":602.81,"content":"有三种香味可供选择"},{"from":602.81,"to":606.74,"content":"有想要的小伙伴评论区链接直接拿走"},{"from":611.9,"to":612.76,"content":"前面说了"},{"from":612.76,"to":615.98,"content":"当前的人工智能只达到了我们的无意识层面"},{"from":615.98,"to":617.54,"content":"而要达到意识层面"},{"from":617.54,"to":619.55,"content":"至少需要再增加两种能力"},{"from":619.55,"to":622.88,"content":"控制全局工作空间和自我监控"},{"from":622.88,"to":624.47,"content":"控制全局工作空间"},{"from":624.47,"to":625.67,"content":"基于两个原因"},{"from":625.67,"to":629.19,"content":"第一高级意识做决策需要更多维的信息"},{"from":629.19,"to":632.13,"content":"第二生物大脑的工作记忆空间太小"},{"from":632.13,"to":634.069,"content":"只能通过注意力来筛选"},{"from":634.069,"to":636.409,"content":"但AI似乎不存在这样的限制"},{"from":636.409,"to":638.149,"content":"大模型已经向我们展示了"},{"from":638.149,"to":640.32,"content":"他远超人类的信息处理能力"},{"from":640.32,"to":643.08,"content":"它巨大的向量空间几乎无所不包"},{"from":643.08,"to":644.8,"content":"而且可以随时检索"},{"from":644.8,"to":648.22,"content":"而如果把长文本处理能力类比工作记忆的话"},{"from":648.22,"to":650.11,"content":"更是碾压生物大脑"},{"from":650.11,"to":653.47,"content":"所以AI似乎可以在一个非常大的信息空间中"},{"from":653.47,"to":655.839,"content":"任意检索信息组合答案"},{"from":655.839,"to":657.459,"content":"因此大模型推理"},{"from":657.459,"to":658.779,"content":"虽然从工作方式上"},{"from":658.779,"to":661.209,"content":"与生物大脑的无意识阶段相似"},{"from":661.209,"to":662.62,"content":"属于前馈网络"},{"from":662.62,"to":664.15,"content":"但却能处理语言"},{"from":664.15,"to":665.71,"content":"做简单的逻辑判断"},{"from":665.71,"to":669.319,"content":"完成生物大脑只有靠意识才能完成的部分事情"},{"from":669.319,"to":671.839,"content":"如果在此之上再单独训练一个模型"},{"from":671.839,"to":674.82,"content":"用于接收大模型无法一次处理的情况"},{"from":674.82,"to":676.26,"content":"生成新的提示词"},{"from":676.26,"to":677.73,"content":"去大模型寻找答案"},{"from":677.73,"to":679.32,"content":"是不是就基本可以完成"},{"from":679.32,"to":681.84,"content":"控制全局工作空间的任务呢"},{"from":681.84,"to":682.8,"content":"而第二点"},{"from":682.8,"to":685.87,"content":"自我监控似乎也并不是没有解决办法"},{"from":685.87,"to":688.75,"content":"还记得AI for science的那期视频中"},{"from":688.75,"to":692.56,"content":"我们介绍过一个解数学题的AI叫做fun search"},{"from":692.56,"to":694.36,"content":"他使用了一个评估程序"},{"from":694.36,"to":696.4,"content":"去评估大模型返回的结果"},{"from":696.4,"to":698.14,"content":"然后重新生成提示词"},{"from":698.14,"to":699.7,"content":"让大模型寻找答案"},{"from":699.7,"to":700.96,"content":"基于这种设计"},{"from":700.96,"to":703.72,"content":"AI就可以在冒险问题和装箱问题上"},{"from":703.72,"to":705.84,"content":"找到超越人类的解决方案"},{"from":705.84,"to":708.75,"content":"自我监控其实也可以采用类似的思路"},{"from":708.75,"to":710.52,"content":"一个更高层面的大模型"},{"from":710.52,"to":711.84,"content":"经过特别的训练"},{"from":711.84,"to":713.88,"content":"专门评估大模型的行为"},{"from":713.88,"to":717.12,"content":"甚至可以通过阈值决定是否积累新的数据"},{"from":717.12,"to":719.15,"content":"对大模型做进一步的微调"},{"from":719.15,"to":720.41,"content":"基于这样的设计"},{"from":720.41,"to":721.73,"content":"是不是我们也可以完成"},{"from":721.73,"to":723.97,"content":"学习新知识和内省的过程"},{"from":723.97,"to":725.08,"content":"话是没错"},{"from":725.08,"to":726.37,"content":"但是乔丹麦迪"},{"from":726.37,"to":727.69,"content":"咱不是要讲意识吗"},{"from":727.69,"to":729.07,"content":"咋又扯起AI来了"},{"from":729.07,"to":730.72,"content":"你确定没拿错剧本吗"},{"from":730.72,"to":731.23,"content":"好吧"},{"from":731.23,"to":732.92,"content":"那你看我怎么给你往回扯"},{"from":732.92,"to":736.73,"content":"一个拥有全局空间控制能力和自我监控的AI"},{"from":736.7