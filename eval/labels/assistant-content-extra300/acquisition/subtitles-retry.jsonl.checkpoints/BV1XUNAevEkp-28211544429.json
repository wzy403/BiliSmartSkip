{"schemaVersion":1,"bvid":"BV1XUNAevEkp","cid":28211544429,"subtitles":[{"from":0,"to":0.66,"content":"过年期间"},{"from":0.66,"to":2.86,"content":"有好奇网友转发来这段视频"},{"from":2.86,"to":5.2,"content":"只见灶台上烧了一大锅开水"},{"from":5.2,"to":8.62,"content":"水蒸气通过锅盖上的弯头和管子引入炉膛"},{"from":8.62,"to":12.52,"content":"看起来被水蒸气直吹的火苗子确实烧的更旺"},{"from":12.52,"to":14.14,"content":"这究竟是什么原因呢"},{"from":14.14,"to":16.22,"content":"为了研究蒸汽吹火的原理"},{"from":16.22,"to":17.54,"content":"我们来到铁路边"},{"from":17.54,"to":21.16,"content":"发现一个傻大笨粗的蒸汽火车头缓缓驶来"},{"from":21.16,"to":22.6,"content":"虽然他走的很慢"},{"from":22.6,"to":24.88,"content":"但看起来动力却十分充足"},{"from":24.88,"to":26.32,"content":"这不禁令人疑惑"},{"from":26.32,"to":28.16,"content":"它低速行驶或爬坡时"},{"from":28.16,"to":30.1,"content":"锅炉还能把气烧的很足"},{"from":30.1,"to":31.82,"content":"炉子里是怎么送风的呢"},{"from":31.82,"to":32.62,"content":"去掉外壳"},{"from":32.62,"to":36.23,"content":"发现机车火箱底部有一层熊熊燃烧的煤炭"},{"from":36.23,"to":39.78,"content":"而前面的锅炉里则通着若干有粗有细的烟管"},{"from":39.78,"to":41.24,"content":"这些大小号的烟管内"},{"from":41.24,"to":44,"content":"都充满了从火象而来的高温燃气"},{"from":44,"to":46.76,"content":"用来加热烟管外面的一肚子自来水"},{"from":46.76,"to":49.66,"content":"烧出来的饱和蒸汽则聚集在锅炉顶上"},{"from":49.66,"to":50.92,"content":"稳压器的气包里"},{"from":50.92,"to":52.26,"content":"为了提高热效率"},{"from":52.26,"to":54.74,"content":"稳压器里的蒸汽又被管道引出来"},{"from":54.74,"to":55.66,"content":"进入过热器"},{"from":55.66,"to":57.64,"content":"其中有一路较细的过热管"},{"from":57.64,"to":59.06,"content":"又将蒸汽引出来"},{"from":59.06,"to":60.79,"content":"进入一根大号烟管中"},{"from":60.79,"to":63.25,"content":"这根过热管走到头又拐回来"},{"from":63.25,"to":65.89,"content":"然后又掉头拐弯回去再返回来"},{"from":65.89,"to":68.42,"content":"在高温的烟管里来回跑了四趟"},{"from":68.42,"to":70.4,"content":"使过热管中的饱和水蒸气"},{"from":70.4,"to":72.4,"content":"在这根烟管里进一步吸热"},{"from":72.4,"to":75.32,"content":"变成了超过400℃的过热水蒸气"},{"from":75.32,"to":78.38,"content":"然后过热器又把过热管送来的高温蒸汽"},{"from":78.38,"to":79.26,"content":"通入气室"},{"from":79.26,"to":81.26,"content":"精气使阀分配进入气缸"},{"from":81.26,"to":83.66,"content":"推动里面直径约60cm的气缸"},{"from":83.66,"to":85.32,"content":"勾背前后运动处理"},{"from":85.32,"to":88.9,"content":"而从气缸排出的蒸汽还是有较高的温度和压力"},{"from":88.9,"to":90.68,"content":"又被通入烟囱底部"},{"from":90.68,"to":91.84,"content":"向出口喷射"},{"from":91.84,"to":94.22,"content":"此时蒸汽射流在急速膨胀中"},{"from":94.22,"to":95.52,"content":"压力骤然降低"},{"from":95.52,"to":97.06,"content":"形成了很强的负压"},{"from":97.06,"to":99.2,"content":"于是吸引出火箱内的燃气"},{"from":99.2,"to":101.54,"content":"并向火箱内吸入新鲜空气"},{"from":101.54,"to":104.24,"content":"被吸引的燃气顺着烟管向前运动"},{"from":104.24,"to":106.24,"content":"最后和水蒸气射流掺混"},{"from":106.24,"to":107.42,"content":"从烟囱排出"},{"from":107.42,"to":109.66,"content":"可见蒸汽机车慢速行驶时"},{"from":109.66,"to":113.22,"content":"是利用气缸向烟囱排出的蒸汽流制造负压"},{"from":113.22,"to":115.38,"content":"使火箱形成了诱导通风"},{"from":115.38,"to":116.72,"content":"而聪明的灶台主"},{"from":116.72,"to":119.34,"content":"也是通过喷管喷射蒸汽流的负压"},{"from":119.34,"to":121.38,"content":"吸引周围的空气同向运动"},{"from":121.38,"to":123.44,"content":"并掺混给炉灶里的玉米芯"},{"from":123.44,"to":127.1,"content":"送来一场蒸汽和空气混合的风暴进行助燃"},{"from":127.1,"to":128.14,"content":"说起风暴"},{"from":128.14,"to":132.19,"content":"那就不得不提起暴雪游戏旗下的魔兽世界"},{"from":132.19,"to":133.59,"content":"世界的新玩法"},{"from":133.59,"to":134.23,"content":"霸业风暴"},{"from":134.23,"to":135.97,"content":"那种在游戏里自由冒险"},{"from":135.97,"to":139.08,"content":"躲风暴的畅快和现实中严谨的科学原理"},{"from":139.08,"to":140.86,"content":"一对比还真是奇妙"},{"from":140.86,"to":143.26,"content":"此次上线的魔术版吃鸡霸业风暴"},{"from":143.26,"to":144.84,"content":"15分钟就能玩一局"},{"from":144.84,"to":146.74,"content":"新手小白也能轻松上手"},{"from":146.74,"to":148.66,"content":"节日和朋友开黑超合适"},{"from":148.66,"to":150.24,"content":"新增的躲风暴机制"},{"from":150.24,"to":152.44,"content":"巧妙利用地形躲避致命风暴"},{"from":152.44,"to":154.48,"content":"策略性和操作感都拉满"},{"from":154.48,"to":154.92,"content":"赢了"},{"from":154.92,"to":156.74,"content":"还有稀有幻化铁钩爪"},{"from":156.74,"to":158.78,"content":"闪前螃蟹等丰厚奖励"},{"from":158.78,"to":160.22,"content":"还有北伐的召唤"},{"from":160.22,"to":161.34,"content":"也重磅回归了"},{"from":161.34,"to":163.78,"content":"十人或25人的十字军试炼副本"},{"from":163.78,"to":164.98,"content":"难度大幅优化"},{"from":164.98,"to":166.86,"content":"30分钟就能轻松通关"},{"from":166.86,"to":169.36,"content":"帮你快速找回当年征战的热血"},{"from":169.36,"to":171.72,"content":"如今魔兽世界国服热度爆棚"},{"from":171.72,"to":173.52,"content":"活跃用户突破300万"},{"from":173.52,"to":176.02,"content":"经典副本和吃鸡玩法同时上线"},{"from":176.02,"to":177.86,"content":"经典与创新完美融合"},{"from":177.86,"to":179.64,"content":"不愧是MMO天花板"},{"from":179.64,"to":181.42,"content":"现在老玩家回归游戏"},{"from":181.42,"to":183.32,"content":"直接送三天免费时长"},{"from":183.32,"to":185.36,"content":"超值福利就在评论区置顶"},{"from":185.36,"to":186.48,"content":"千万别错过"},{"from":186.48,"to":190.12,"content":"既然蒸汽流能够通过诱导送风使燃烧更剧烈"},{"from":190.12,"to":191.98,"content":"那就引起人们进一步联想"},{"from":191.98,"to":194.6,"content":"如果给涡喷或涡扇发动机里滋水"},{"from":194.6,"to":197.7,"content":"能否让燃烧室里燃烧反应也更加剧烈"},{"from":197.7,"to":199.12,"content":"从而提高推力呢"},{"from":199.12,"to":200.34,"content":"答案是肯定的"},{"from":200.34,"to":201.32,"content":"如图所示"},{"from":201.32,"to":203.18,"content":"这台喷气发动机的压气机"},{"from":203.18,"to":206.12,"content":"将一个大气压的空气进行逐级压缩"},{"from":206.12,"to":207.64,"content":"使空气体积缩小"},{"from":207.64,"to":208.88,"content":"温度压力提高"},{"from":208.88,"to":210.56,"content":"进入燃烧室喷油点火"},{"from":210.56,"to":211.5,"content":"做定压吸热"},{"from":211.5,"to":212.84,"content":"体积急速膨胀"},{"from":212.84,"to":215.34,"content":"在涡轮前形成高温高压燃气"},{"from":215.34,"to":217.3,"content":"然后做近似的绝热膨胀"},{"from":217.3,"to":218.62,"content":"温度压力降低"},{"from":218.62,"to":219.42,"content":"体积增大"},{"from":219.42,"to":220.68,"content":"推动涡轮做功"},{"from":220.68,"to":222.18,"content":"废气排入大气后"},{"from":222.18,"to":224.42,"content":"以一个大气压继续定压放热"},{"from":224.42,"to":226.02,"content":"体积和温度都减小"},{"from":226.02,"to":227.58,"content":"又回到初始状态"},{"from":227.58,"to":229.46,"content":"从这个循环过程可以发现"},{"from":229.46,"to":232.82,"content":"如果给压气机里面滋水或纯水混合液"},{"from":232.82,"to":235.74,"content":"那么液体蒸发时就会吸收大量潜热"},{"from":235.74,"to":237.98,"content":"使压气机里空气温度降低"},{"from":237.98,"to":239.82,"content":"压气机的增压比扩大"},{"from":239.82,"to":242.26,"content":"造成到达压气机出口处于状态"},{"from":242.26,"to":244.44,"content":"二的空气压力被进一步提高"},{"from":244.44,"to":247.66,"content":"于是整个循环所围成的面积比原先扩大"},{"from":247.66,"to":249.34,"content":"说明滋水降温的动作"},{"from":249.34,"to":252.34,"content":"使燃烧室在单位时间里进入了更多空空气"},{"from":252.34,"to":253.74,"content":"烧掉了更多燃油"},{"from":253.74,"to":255.88,"content":"从而导致推力也相应提高"},{"from":255.88,"to":258.7,"content":"这就是喷气发动机的喷水加力原理"},{"from":258.7,"to":261.62,"content":"例如U2侦察机安装的普惠J75"},{"from":261.62,"to":263.34,"content":"双转子涡喷发动机"},{"from":263.34,"to":265.7,"content":"该机就可在压气机入口处喷水"},{"from":265.7,"to":267.82,"content":"以增大起飞和爬升推力"},{"from":267.82,"to":271.11,"content":"其喷水时的最大加力推力为11.8吨"},{"from":271.11,"to":273.33,"content":"而不喷水时为10.8吨"},{"from":273.33,"to":274.11,"content":"也就是说"},{"from":274.11,"to":276.37,"content":"只需通过喷水冷却压缩空气"},{"from":276.37,"to":278.4,"content":"即可白嫖约十千牛推力"},{"from":278.4,"to":281.36,"content":"而给汽车的涡轮增压发动机的进气管"},{"from":281.36,"to":282.56,"content":"装上中冷器"},{"from":282.56,"to":286.12,"content":"同样能使压缩空气因冷却降温而密度增大"},{"from":286.12,"to":288.58,"content":"使发动机的有效充气效率提高"},{"from":288.58,"to":290.34,"content":"从而能烧掉更多燃油"},{"from":290.34,"to":291.54,"content":"发出更大功率"},{"from":291.54,"to":292.3,"content":"据估算"},{"from":292.3,"to":295.7,"content":"如果涡轮送来的增压空气温度每下降十度"},{"from":295.7,"to":297.85,"content":"就可因匹配的喷油量提高"},{"from":297.85,"to":300.33,"content":"而使功率增加3%到五"},{"from":300.33,"to":301.37,"content":"由此可见"},{"from":301.37,"to":304.36,"content":"无论是向喷气发动机的压气机里喷水"},{"from":304.36,"to":307,"content":"还是像燃烧的炉膛里喷射水蒸气"},{"from":307,"to":308.86,"content":"都能使燃烧更加剧烈"},{"from":308.86,"to":310.56,"content":"从而起到加力作用"},{"from":310.56,"to":313.64,"content":"只不过看到炉膛烧出的水蒸气又通回来"},{"from":313.64,"to":315.2,"content":"给炉膛助燃的情景"},{"from":315.2,"to":319.52,"content":"难免让人油然而生一股相煎和太极的凄凉感"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:33:33.942Z","subtitleM