{"schemaVersion":1,"bvid":"BV1uqJNzwEnc","cid":30009656179,"subtitles":[{"from":0.04,"to":3.27,"content":"在地摊上买提拉米苏真的风险极高"},{"from":3.27,"to":4.27,"content":"但挡不住"},{"from":4.27,"to":5.89,"content":"有些人真心想探险"},{"from":5.89,"to":9.67,"content":"如果你真的是想要在摊上面买提拉米苏"},{"from":9.67,"to":11.07,"content":"是不是绝对不能买"},{"from":11.07,"to":11.8,"content":"也不是"},{"from":11.8,"to":12.86,"content":"但只能买一种"},{"from":12.86,"to":15.77,"content":"就是它有一个特别简陋的一个小盒子"},{"from":15.77,"to":17.51,"content":"然后里面就只有4~8个"},{"from":17.51,"to":21.39,"content":"然后就感觉摆的那个人又有点那种青涩和害羞"},{"from":21.39,"to":22.21,"content":"像这种的话"},{"from":22.21,"to":23.65,"content":"你也可以买一个尝一下"},{"from":23.65,"to":26.03,"content":"那为什么也是有原理的"},{"from":26.03,"to":29.61,"content":"就像新手刚拿驾照开车往往会比较小心"},{"from":29.61,"to":33.1,"content":"新人摆摊做东西也会特别用心"},{"from":33.1,"to":34.78,"content":"第一次或者第二次摆摊"},{"from":34.78,"to":35.62,"content":"我做了这几个"},{"from":35.62,"to":37.12,"content":"我特别担心我做的不好"},{"from":37.12,"to":38.92,"content":"担心收到不好的反馈"},{"from":38.92,"to":41.08,"content":"所以他们做东西的时候会非常的用心"},{"from":41.08,"to":42.76,"content":"而且本来就只做这几个"},{"from":42.76,"to":44.58,"content":"他们是真正不计成本的"},{"from":44.58,"to":46.89,"content":"只是想看这个生意能不能做"},{"from":46.89,"to":50.11,"content":"因为他真正的在用心的做一款非常简单"},{"from":50.11,"to":52.8,"content":"只需要原材料好就可以做的一个甜点"},{"from":52.8,"to":54.14,"content":"你趁他新手上路"},{"from":54.14,"to":55.04,"content":"胆子还小"},{"from":55.04,"to":56.38,"content":"买一块尝尝"},{"from":56.38,"to":57.94,"content":"搞不好味道还行"},{"from":57.94,"to":59.8,"content":"有点像以前的小龙虾"},{"from":59.8,"to":61.66,"content":"最开始是在田里捞"},{"from":61.66,"to":64.52,"content":"农民种完地回家路边稍微捞一点"},{"from":64.52,"to":65.48,"content":"当赚个外快"},{"from":65.48,"to":66.32,"content":"卖的便宜"},{"from":66.32,"to":67.18,"content":"味道也好"},{"from":67.18,"to":68.72,"content":"很受大家的喜欢"},{"from":68.72,"to":71.52,"content":"但是当他们转型养殖小龙虾以后"},{"from":71.52,"to":74.56,"content":"赚钱甚至赚大钱就要考虑成本"},{"from":74.56,"to":76.91,"content":"人工和饲料价钱贵了"},{"from":76.91,"to":79.29,"content":