{"schemaVersion":1,"bvid":"BV1qxCPY9ERS","cid":27524861247,"subtitles":[{"from":0.04,"to":0.8,"content":"第五期了啊"},{"from":0.8,"to":2.52,"content":"然后我们直接跳一下版本吧"},{"from":2.52,"to":4.38,"content":"因为松哥这边版本更新有点太快了"},{"from":4.38,"to":6.06,"content":"后边法务前居后宫的内容"},{"from":6.06,"to":6.98,"content":"我们就直接跳过去"},{"from":6.98,"to":8.14,"content":"应该大家都看过"},{"from":8.14,"to":9.3,"content":"就没必要再讲一遍了"},{"from":9.3,"to":11.42,"content":"反正那些内容呢也没什么特别有意思的地方"},{"from":11.42,"to":14.1,"content":"所以我们本期呢就直接跳版本到新机飞"},{"from":14.1,"to":15.56,"content":"回应松哥打虎的第一条内容"},{"from":15.56,"to":17.14,"content":"然后顺便我给自己叠一个甲"},{"from":17.14,"to":19.66,"content":"就我最近经常听到有很多的观众跟我说"},{"from":19.66,"to":22.38,"content":"建议我不要在自己不熟悉的领域做太多的言论"},{"from":22.38,"to":24.42,"content":"包括不要跟这些打假人走的太近"},{"from":24.42,"to":26.54,"content":"将来他们翻车会牵连到我之类的"},{"from":26.54,"to":27.28,"content":"感谢关心啊"},{"from":27.28,"to":29.3,"content":"但其实这里面还是有一些误会"},{"from":29.3,"to":31.16,"content":"就虽然我现在讲的看起来"},{"from":31.16,"to":32.88,"content":"好像是食品安全领域的内容"},{"from":32.88,"to":35.04,"content":"但实际上呢这个还在我的专业范围内"},{"from":35.04,"to":37.4,"content":"其实我讲的一直都是传播舆论公关"},{"from":37.4,"to":38.92,"content":"你们看我是不是从来都没有说过"},{"from":38.92,"to":39.96,"content":"这个什么检测报告"},{"from":39.96,"to":41.84,"content":"食品添加剂之类的这些那些的对吧"},{"from":41.84,"to":43.3,"content":"这个我确实不懂这些"},{"from":43.3,"to":44.62,"content":"他不在我的专业范围之内"},{"from":44.62,"to":46.28,"content":"我从始至终一直都在讲"},{"from":46.28,"to":48.34,"content":"如果我们自己遇到这种情况"},{"from":48.34,"to":49.46,"content":"应该如何去去应对"},{"from":49.46,"to":52.04,"content":"以及这些人在处理问题的过程当中"},{"from":52.04,"to":54.36,"content":"这些值得和不值得我们学习的地方"},{"from":54.36,"to":55.88,"content":"这几位听课有点不太认真啊"},{"from":55.88,"to":57.83,"content":"这个很不太对啊"},{"from":57.83,"to":61.04,"content":"其次呢我跟松哥是在铺子的系列内容认识的"},{"from":61.04,"to":63.36,"content":"然后他当时说我的分析就跟我在现场一样"},{"from":63.36,"to":65.44,"content":"我说他处理问题处理的非常专业啊"},{"from":65.44,"to":66,"content":"然后他跟我说"},{"from":66,"to":66.92,"content":"他要去开心际飞"},{"from":66.92,"to":68.28,"content":"那我说那可太好了"},{"from":68.28,"to":70.28,"content":"所以这里的因果关系啊是这样的"},{"from":70.28,"to":72.54,"content":"不是因为我占松哥才去跟着开心机飞"},{"from":72.54,"to":73.34,"content":"我谁都不占"},{"from":73.34,"to":75.68,"content":"而是因为心机飞被松哥给开了"},{"from":75.68,"to":78.4,"content":"我才会跟着去开心机飞是这么个关系"},{"from":78.4,"to":79.56,"content":"谁去开心机飞"},{"from":79.56,"to":80.76,"content":"我都可能会跟着开的"},{"from":80.76,"to":82.84,"content":"因为我认识一些食品行业的从业人员"},{"from":82.84,"to":85.56,"content":"所以对于新机飞没有什么太多的好感"},{"from":85.56,"to":87.72,"content":"就特别是从他科技与狠核的那个"},{"from":87.72,"to":89.24,"content":"一系列的关键词起号之后"},{"from":89.24,"to":91.18,"content":"他起号的基础其实就是贩卖焦虑"},{"from":91.18,"to":94.06,"content":"我之前跟大家分享过很多关于成成功学内容"},{"from":94.06,"to":96.86,"content":"他跟我分享他的从业经验和过往经历的时候"},{"from":96.86,"to":97.54,"content":"就跟我说过"},{"from":97.54,"to":100.26,"content":"就是近现代的很多成功学的模式呢比较基础"},{"from":100.26,"to":101.2,"content":"常用就这么几种"},{"from":101.2,"to":101.98,"content":"小孩怕笨"},{"from":101.98,"to":102.66,"content":"老的怕死"},{"from":102.66,"to":103.42,"content":"女的怕丑"},{"from":103.42,"to":104,"content":"男的怕穷"},{"from":104,"to":106.26,"content":"然后由此就衍生了四种暴利行业"},{"from":106.26,"to":107.52,"content":"就是学生的教培行业"},{"from":107.52,"to":108.74,"content":"老年的保健品行业"},{"from":108.74,"to":109.98,"content":"女性的美妆医美"},{"from":109.98,"to":111.72,"content":"还有各种各样的投资理财"},{"from":111.72,"to":112.9,"content":"金融类的这些内容"},{"from":112.9,"to":115.16,"content":"有些时候这类行业的某些产品啊"},{"from":115.16,"to":118.1,"content":"它们的基础可能就不在于他们本身产品的实力"},{"from":118.1,"to":119.38,"content":"能达到什么样的层次"},{"from":119.38,"to":121.56,"content":"而是在于他们的焦虑推得够不够高"},{"from":121.56,"to":122.54,"content":"我们去看辛吉飞"},{"from":122.54,"to":123.74,"content":"他的内容也是一样的"},{"from":123.74,"to":125.74,"content":"之前去看他这个科普食品知识"},{"from":125.74,"to":127.82,"content":"去讲关于用户应该如何去看配料表"},{"from":127.82,"to":129.08,"content":"这个其实本身没问题"},{"from":129.08,"to":130.1,"content":"专业知识不够硬"},{"from":130.1,"to":130.94,"content":"那你去慢慢学"},{"from":130.94,"to":132.3,"content":"然后有错误就认"},{"from":132.3,"to":133.14,"content":"然后去改正"},{"from":133.14,"to":134.2,"content":"我觉得也没什么问题"},{"from":134.2,"to":136.04,"content":"哪怕你说你去为了搞节目效果"},{"from":136.04,"to":138.16,"content":"去搞一什么嘴歪眼斜这种是吧"},{"from":138.16,"to":140.32,"content":"我也可以认为这就是整节目效果嘛"},{"from":140.32,"to":141.06,"content":"就整活嘛"},{"from":141.06,"to":142.44,"content":"要不然大家不喜欢看的话"},{"from":142.44,"to":143.82,"content":"你搞这个有什么意义呢"},{"from":143.82,"to":144.06,"content":"对吧"},{"from":144.06,"to":145.52,"content":"我觉得这个也很合理"},{"from":145.52,"to":147.18,"content":"但是我真的很讨厌什么呢"},{"from":147.18,"to":148.82,"content":"讨厌这种乱科普不改正的"},{"from":148.82,"to":149.54,"content":"只谈毒性"},{"from":149.54,"to":150.34,"content":"不谈剂量的"},{"from":150.34,"to":152.76,"content":"把本来是食品安安全用量的食品添加剂"},{"from":152.76,"to":154.84,"content":"宣传成了就是只要是添加了一点"},{"from":154.84,"to":156.38,"content":"就特别有害的这么一种状态"},{"from":156.38,"to":158.06,"content":"但其实即便是这样啊"},{"from":158.06,"to":160.08,"content":"我也没有很想开他的欲望"},{"from":160.08,"to":162.52,"content":"我真正开他的理由是他那些教徒"},{"from":162.52,"to":163.14,"content":"你知道吧"},{"from":163.14,"to":164.66,"content":"就他那些教徒有多抽象"},{"from":164.66,"to":165.92,"content":"大家应该也很清楚"},{"from":165.92,"to":167.16,"content":"所以我就被团结了嘛"},{"from":167.16,"to":168.2,"content":"就谁去开新机飞"},{"from":168.2,"to":169.34,"content":"我都有可能去跟着开"},{"from":169.34,"to":171,"content":"重点在于心机飞被开了"},{"from":171,"to":172.26,"content":"而不是谁去开的它"},{"from":172.26,"to":173.16,"content":"我讨厌心机飞"},{"from":173.16,"to":174.4,"content":"是因为他贩卖焦虑"},{"from":174.4,"to":175.68,"content":"但不至于让我去开他"},{"from":175.68,"to":178.02,"content":"我真正开他的原因是他那些抽象的粉丝"},{"from":178.02,"to":180.2,"content":"这完全就是粉丝行为上升到偶像了"},{"from":180.2,"to":181.12,"content":"所以我是没有粉丝"},{"from":181.12,"to":183.4,"content":"我一直都在说我的观众是如何如何的"},{"from":183.4,"to":185.42,"content":"但我也希望观众不要那么抽象啊"},{"from":185.42,"to":186.1,"content":"对好的"},{"from":186.1,"to":188.46,"content":"然后我们来看一下这个新军飞的回应"},{"from":188.46,"to":189.42,"content":"最近有人打假"},{"from":189.42,"to":190.6,"content":"飞哥推荐过产品"},{"from":190.6,"to":191.88,"content":"我发视频回应一下"},{"from":191.88,"to":194.38,"content":"如果我推荐的产品质监局调查了"},{"from":194.38,"to":195.78,"content":"出现产品质量问题"},{"from":195.78,"to":196.94,"content":"该我负的责任"},{"from":196.94,"to":198.06,"content":"我一点都逃不了"},{"from":198.06,"to":200.52,"content":"如果我指导教唆他人犯罪"},{"from":200.52,"to":201.63,"content":"更改配料表"},{"from":201.63,"to":202.67,"content":"这都是刑事责任"},{"from":202.67,"to":203.97,"content":"你直接报警就好了"},{"from":206.41,"to":207.83,"content":"那你想想给我抓起来"},{"from":207.83,"to":208.67,"content":"然后你再发视频"},{"from":208.67,"to":209.95,"content":"那效果不是更爆炸吗"},{"from":209.95,"to":211.27,"content":"OK这里一开口啊"},{"from":211.27,"to":212.79,"content":"就是经典的搅浑水了哈"},{"from":212.79,"to":215.26,"content":"这一段他为自己辩解的视角呢有这么几个问题"},{"from":215.26,"to":217.86,"content":"首先第一个叫假两难困境啊"},{"from":217.86,"to":218.7,"content":"如果我违法了"},{"from":218.7,"to":219.82,"content":"那么警方会来抓我"},{"from":219.82,"to":220.82,"content":"那么警方没来抓我"},{"from":220.82,"to":222.18,"content":"那就说明我没违法对吧"},{"from":222.18,"to":223,"content":"我们同类替换"},{"from":223,"to":224,"content":"如果你学历不高啊"},{"from":224,"to":225.12,"content":"那你就只能做掏粪工"},{"from":225.12,"to":226.08,"content":"如果你没做掏粪工"},{"from":226.08,"to":226.96,"content":"那么你就是高学历"},{"from":226.96,"to":228.24,"content":"我们再同类替换一下"},{"from":228.24,"to":228.96,"content":"如果你这么说"},{"from":228.96,"to":230,"content":"你就喜欢甜豆脑"},{"from":230,"to":230.64,"content":"如果你没这么说"},{"from":230.64,"to":231.9,"content":"那你就是喜欢甜豆脑"},{"from":231.9,"to":233.28,"content":"是不是听起来特别熟悉"},{"from":233.28,"to":235.18,"content":"来我们在同类替换到见证圈"},{"from":235.18,"to":237.6,"content":"再添加一个复合问题的假设就变成了啊"},{"from":237.6,"to":238.86,"content":"你要么就是支持我们"},{"from":238.86,"to":241.2,"content":"要么就是支持恐怖分子选择我们就是爱国的"},{"from":241.2,"to":241.8,"content":"不选择我们"},{"from":241.8,"to":243.4,"content":"你就是支持恐怖分子的这个东西"},{"from":243.4,"to":244.84,"content":"就叫假两难困境"},{"from":244.84,"to":247.18,"content":"当然也有一种逻辑谬误叫做和非黑即白"},{"from":247.18,"to":248.82,"content":"他们其实也非常像嘛"},{"from":248.82,"to":249.92,"content":"这个我们以后再说"},{"from":249.92,"to":252.46,"content":"但是他们的特点都是忽略其他所有的可能性"},{"from":252.46,"to":254.76,"content":"从两种不完全的可能性来进行推理"},{"from":254.76,"to":257.72,"content":"要么就是A要么就是B不存在CDEF等等"},{"from":257.72,"to":259.48,"content":"其他就是其他的可能性嘛"},{"from":259.48,"to":260.68,"content":"这个其实就很鬼扯了"},{"from":260.68,"to":261.72,"content":"类似于这种问题"},{"from":261.72,"to":263.56,"content":"其实破拆起来也挺简单的"},{"from":263.56,"to":265.18,"content":"就提出一个其他可能性就可以了"},{"from":265.18,"to":266.3,"content":"比如说那有没有一种可能"},{"from":266.3,"to":267.5,"content":"帽子叔叔正在调查你呢"},{"from":267.5,"to":268.62,"content":"或者有没有一种可能性是"},{"from":268.62,"to":270.94,"content":"帽子叔叔正在过过来抓你的过程中呢"},{"from":270.94,"to":272.18,"content":"那么有没有这种可能性是"},{"from":272.18,"to":273.5,"content":"帽子叔叔暂时还没有调查"},{"from":273.5,"to":274.54,"content":"你还在忙别的事呢"},{"from":274.54,"to":277.4,"content":"所以你有没有问题和你目前是不是被抓"},{"from":277.4,"to":279.16,"content":"没有什么必然的因果关系"},{"from":279.16,"to":280.8,"content":"我们可以再举一个简单的小例子"},{"from":280.8,"to":281.8,"content":"比如说你上学的时候"},{"from":281.8,"to":282.6,"content":"你同学欺负你"},{"from":282.6,"to":283.24,"content":"你很生气"},{"from":283.24,"to":284.32,"content":"但是他给你来了一句"},{"from":284.32,"to":285.44,"content":"那你去告老师嘛对吧"},{"from":285.44,"to":287.56,"content":"那你可能觉得说这么小的事情没有必要告老师"},{"from":287.56,"to":288.6,"content":"然后你就忍下来了"},{"from":288.6,"to":289.68,"content":"那按照辛吉飞的说法"},{"from":289.68,"to":291.64,"content":"那是不是意味着这个时候欺负你的同学"},{"from":291.64,"to":292.92,"content":"因为没有被老师批评"},{"from":292.92,"to":294.74,"content":"所以他的行为是没错的呢"},{"from":294.74,"to":295.9,"content":"肯定不合理吧对吧"},{"from":295.9,"to":297.76,"content":"另外这里呢还偷换了一个概念啊"},{"from":297.76,"to":299.52,"content":"就是峰哥这里所质疑的是"},{"from":299.52,"to":301.64,"content":"为什么工厂所提供的产品"},{"from":301.64,"to":303.8,"content":"配料表标注了那个添加剂是什么"},{"from":303.8,"to":304.24,"content":"我忘了"},{"from":304.24,"to":305.28,"content":"反正就是添加剂"},{"from":305.28,"to":306.44,"content":"而辛吉飞带的货"},{"from":306.44,"to":308.5,"content":"这个配料