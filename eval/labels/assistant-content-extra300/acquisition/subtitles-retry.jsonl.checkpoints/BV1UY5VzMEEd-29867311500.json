{"schemaVersion":1,"bvid":"BV1UY5VzMEEd","cid":29867311500,"subtitles":[{"from":0.2,"to":3.14,"content":"现在的共享单车骑一个小时要六七块钱"},{"from":3.14,"to":4.4,"content":"通货膨胀都赶不上它"},{"from":4.4,"to":5.04,"content":"涨价的速度"},{"from":5.04,"to":7.179,"content":"比坐公交坐地铁都贵还好"},{"from":7.179,"to":9.459,"content":"这是骑着共享单车享受春夏好时光"},{"from":9.459,"to":11.459,"content":"但是吃了一嘴柳絮和杨树的枪仔啊"},{"from":11.459,"to":12.11,"content":"呸呸呸"},{"from":12.11,"to":13.95,"content":"和这美好时光截然相反的呢"},{"from":13.95,"to":16.03,"content":"是现在的共享单车的价格啊"},{"from":16.03,"to":18.83,"content":"不得不承认它涨的速度比我的工资快多了"},{"from":18.83,"to":20.84,"content":"50分钟要了我六块钱"},{"from":20.84,"to":22.16,"content":"六块钱是什么概念呢"},{"from":22.16,"to":25.72,"content":"六块钱够我坐地铁从北京东边跑到北京西边了"},{"from":25.72,"to":27.7,"content":"难道是大城市的特权价格吗"},{"from":27.7,"to":28.92,"content":"然后我就去网上搜了一遍"},{"from":28.92,"to":31.68,"content":"发现北京共享单车的价格已经很克制了"},{"from":31.68,"to":32.76,"content":"从2019年之后"},{"from":32.76,"to":35.52,"content":"北京共享单车的起步价一直都是半小时一块五"},{"from":35.52,"to":38.06,"content":"而其他城市早就把起步价一块五的时间"},{"from":38.06,"to":40.75,"content":"从半小时缩短到10分钟和15分钟了"},{"from":40.75,"to":41.99,"content":"就在今年春节前后"},{"from":41.99,"to":43.23,"content":"哈罗单车进行了涨价"},{"from":43.23,"to":44.47,"content":"变成了现在的工作日"},{"from":44.47,"to":45.94,"content":"起步价一块55分钟"},{"from":45.94,"to":48.1,"content":"周末和节假日一块85分钟"},{"from":48.1,"to":50.49,"content":"超出的时间按15分钟一块五计算"},{"from":50.49,"to":52.69,"content":"美团和金鱼单车呢在北京还没有涨价"},{"from":52.69,"to":54.05,"content":"依旧是半小时计价值"},{"from":54.05,"to":54.73,"content":"这么算下来"},{"from":54.73,"to":57.16,"content":"工作日在北京骑一个小时的共享单车"},{"from":57.16,"to":58.56,"content":"哈罗要整整六块钱"},{"from":58.56,"to":60.36,"content":"青桔和美团要三块钱"},{"from":60.36,"to":63.44,"content":"怪不得每次地铁站门口剩下的都是蓝色的哈罗"},{"from":63.44,"to":65.22,"content":"大家不选他不是因为它不好骑"},{"from":65.22,"to":66.5,"content":"而是因为它贵"},{"from":66.5,"to":69.14,"content":"其实这些年共享单车涨价是一个大趋势"},{"from":69.14,"to":69.78,"content":"2016年"},{"from":69.78,"to":71.52,"content":"他很有钱的资本们为了抢夺市场"},{"from":71.52,"to":73.22,"content":"烧钱补贴出来了半小时"},{"from":73.22,"to":74.74,"content":"只要五毛钱的共享单车"},{"from":74.74,"to":76.02,"content":"国外资本呢没钱了"},{"from":76.02,"to":78.36,"content":"共享单车就回归到了一个正常的商业逻辑"},{"from":78.36,"to":80.74,"content":"也就是给老子赚钱盈利呀"},{"from":80.74,"to":81.98,"content":"或者至少不亏吧"},{"from":81.98,"to":84.4,"content":"然后涨价就成了最简单粗暴的手段"},{"from":84.4,"to":85.58,"content":"从2016年到现在"},{"from":85.58,"to":87.96,"content":"共享单车已经经历了差不多十次涨价"},{"from":87.96,"to":89.28,"content":"尤其是去年那波涨价"},{"from":89.28,"to":91.6,"content":"直接把一块钱一块五起步价的时长"},{"from":91.6,"to":93.46,"content":"从15分钟缩短到了10分钟"},{"from":93.46,"to":95.2,"content":"可不要小看这短短的5分钟啊"},{"from":95.2,"to":96.54,"content":"刚好对准了打工人"},{"from":96.54,"to":97.34,"content":"从地铁站"},{"from":97.34,"to":99.14,"content":"公交站到家和公司的距离"},{"from":99.14,"to":101.14,"content":"把我们这群打工仔拿捏得死死的"},{"from":101.14,"to":101.86,"content":"各位可以想一下"},{"from":101.86,"to":103.3,"content":"如果你某天早上出门"},{"from":103.3,"to":104.88,"content":"刷到了一辆没有掉链子"},{"from":104.88,"to":106.22,"content":"坐垫还在刹车"},{"from":106.22,"to":108.04,"content":"没锈成出土文物的共享单车"},{"from":108.04,"to":109.14,"content":"然后一路绿灯"},{"from":109.14,"to":110.14,"content":"红绿灯都给你面子"},{"from":110.14,"to":111.74,"content":"仿佛全世界都在给你让路"},{"from":111.74,"to":112.66,"content":"到了地铁站门口"},{"from":112.66,"to":114.52,"content":"刚好看到调度大哥收走了一批车"},{"from":114.52,"to":116.46,"content":"给你腾出了一个VIP停车位"},{"from":116.46,"to":117.9,"content":"然后你丝滑入位"},{"from":117.9,"to":118.76,"content":"一键锁车"},{"from":118.76,"to":121.26,"content":"不用像无头苍蝇一样满大街找停车位啊"},{"from":121.26,"to":123.9,"content":"恭喜你抽中了早八点的都市生存彩票"},{"from":123.9,"to":125.9,"content":"只有每天靠共享单车续命的打工人"},{"from":125.9,"to":127.19,"content":"才懂这个的含金量"},{"from":127.19,"to":130.01,"content":"但是但凡你运气少那么一点点"},{"from":130.01,"to":133.1,"content":"红灯长到足够你三倍速刷完一集电视剧"},{"from":133.1,"to":135.78,"content":"停车框里面永远塞满电驴祖宗app"},{"from":135.78,"to":137.3,"content":"死活不认你停进去了"},{"from":137.3,"to":139.06,"content":"然后你就会变成一只手拽着单车"},{"from":139.06,"to":140.32,"content":"一只手举着手机导航"},{"from":140.32,"to":141.32,"content":"像流浪汉一样"},{"from":141.32,"to":143,"content":"满大街的在找停车点啊"},{"from":143,"to":143.76,"content":"好不容易停好了"},{"from":143.76,"to":144.56,"content":"一看时间哈"},{"from":144.56,"to":145.56,"content":"11分钟了"},{"from":145.56,"to":147.12,"content":"原本只需要一块五或者一块八"},{"from":147.12,"to":148.92,"content":"现在因为涨价变成了三块钱"},{"from":148.92,"to":149.92,"content":"价格直接翻倍"},{"from":149.92,"to":151.06,"content":"你就说你气不气吧"},{"from":151.06,"to":152.17,"content":"他喵的"},{"from":152.17,"to":154.65,"content":"不过真正靠共享单车实现全勤打工人"},{"from":154.65,"to":156.17,"content":"可是对价格最敏感的人"},{"from":156.17,"to":158.53,"content":"怎么可能像冤大头一样按次付费呢"},{"from":158.53,"to":160.12,"content":"当然要选择月卡和季卡"},{"from":160.12,"to":161.78,"content":"以30天无限期的月卡为例啊"},{"from":161.78,"to":164,"content":"北京地区的美团青桔和哈罗包月"},{"from":164,"to":165.46,"content":"价格分别是35"},{"from":165.46,"to":166.71,"content":"25和35"},{"from":166.71,"to":168.95,"content":"但是啊没有人会原价购买的"},{"from":168.95,"to":170.35,"content":"基本上都会选择自动续费"},{"from":170.35,"to":171.73,"content":"价格就变成了16块八"},{"from":171.73,"to":173.36,"content":"16块八和17块九"},{"from":173.36,"to":174.04,"content":"这么算下来"},{"from":174.04,"to":175.96,"content":"哪怕除去不用上班的四个周末"},{"from":175.96,"to":178.579,"content":"基本上一天不到一块钱好像也还行"},{"from":178.579,"to":180.819,"content":"所以真正被共享单车涨价背刺的"},{"from":180.819,"to":183.36,"content":"还是因为各种原因需要按次付费的人群"},{"from":183.36,"to":185.92,"content":"就你买个次卡也比单次付费要划算"},{"from":185.92,"to":187.8,"content":"所以这个事就变成了共享单车"},{"from":187.8,"to":189.6,"content":"基本上都是声称要涨价"},{"from":189.6,"to":191.43,"content":"但是又不敢真正去涨价"},{"from":191.43,"to":193.49,"content":"这几家公司试探我们消费者的底线"},{"from":193.49,"to":194.55,"content":"又不敢得罪我们"},{"from":194.55,"to":195.79,"content":"毕竟他们内心也很清楚啊"},{"from":195.79,"to":198.67,"content":"惠骑共享单车的大部分人都是价格敏感型人群"},{"from":198.67,"to":200.209,"content":"我们都是比较抠门的嘛"},{"from":200.209,"to":201.829,"content":"咕咕休息时间到"},{"from":201.829,"to":202.809,"content":"大家看视频久了"},{"from":202.809,"to":203.989,"content":"是不是肩膀有点僵硬"},{"from":203.989,"to":205.129,"content":"脖子有点酸痛啊"},{"from":205.129,"to":205.649,"content":"来来来"},{"from":205.649,"to":207.8,"content":"快点试一下雪姬手上这款妙界吧"},{"from":207.8,"to":209.24,"content":"这双手可真给力啊"},{"from":209.24,"to":210.48,"content":"上次推荐给小伙伴之后"},{"from":210.48,"to":211.64,"content":"都说自动按了它"},{"from":211.64,"to":213.72,"content":"再也不去那些死贵死贵的按摩店了"},{"from":213.72,"to":215.52,"content":"用过的呢都被妙界给折服了"},{"from":215.52,"to":217.709,"content":"这肩膀确实比以前轻松多了"},{"from":217.709,"to":219.389,"content":"我现在电脑前写稿子的时候啊"},{"from":219.389,"to":221.229,"content":"都会背上它按摩巴黎按摩头"},{"from":221.229,"to":223.769,"content":"像虎口一样按摩到每一个酸痛的穴位"},{"from":223.769,"to":227.12,"content":"从后颈肉到肩胛骨斜方肌都被狠狠拿捏"},{"from":227.12,"to":228.8,"content":"搭配上热敷活络气血"},{"from":228.8,"to":230.28,"content":"深入化解不通之痛"},{"from":230.28,"to":232.76,"content":"我那些原本紧绷拥堵的肩颈肌肉"},{"from":232.76,"to":234.92,"content":"在和他的激情肉搏中逐渐疏通"},{"from":234.92,"to":235.62,"content":"加班之后"},{"from":235.62,"to":236.34,"content":"靠它按按腰"},{"from":236.34,"to":236.84,"content":"运动之后"},{"from":236.84,"to":238.6,"content":"按按腿放松肌肉都不在话下"},{"from":238.6,"to":239.28,"content":"这样一比呀"},{"from":239.28,"to":241.76,"content":"它的配置和手法真的比同类高很多"},{"from":241.76,"to":244.18,"content":"难怪能稳居回购好评销量榜的榜首"},{"from":244.18,"to":246.24,"content":"按摩类第一名确实名不虚传"},{"from":246.24,"to":247.08,"content":"身体轻松辣"},{"from":247.08,"to":248.4,"content":"思路更是流畅"},{"from":248.4,"to":249.48,"content":"雪姬提醒各位啊"},{"from":249.48,"to":250.5,"content":"长时间低头玩手机"},{"from":250.5,"to":253,"content":"看电脑工作都会让我们的颈椎受到压迫"},{"from":253,"to":255.36,"content":"初期呢只会感到肩颈肌肉酸痛"},{"from":255.36,"to":258.18,"content":"到了中期颈椎挤压神经就会感到头晕恶心"},{"from":258.18,"to":258.9,"content":"到了后期"},{"from":258.9,"to":261.12,"content":"颈椎病一旦形成就很难治愈了"},{"from":261.12,"to":262.2,"content":"一辈子缠上你"},{"from":262.2,"to":263.84,"content":"所以各位啊一定要经常运动"},{"from":263.84,"to":264.74,"content":"保持好习惯"},{"from":264.74,"to":266.04,"content":"真心安利大家试一下"},{"from":266.04,"to":268.1,"content":"妙姐日常按摩完全可以满足"},{"from":268.1,"to":269.18,"content":"而且还特别划算"},{"from":269.18,"to":271.2,"content":"需要的小伙伴呢记得在评论区里面领券"},{"from":271.2,"to":272.38,"content":"保价还送运费险"},{"from":272.38,"to":274.2,"content":"一年之内质量问题免费换新"},{"from":274.2,"to":275.48,"content":"马上就是母亲节了"},{"from":275.48,"to":276.12,"content":"送给父母"},{"from":276.12,"to":278.61,"content":"送给长辈也是一个不错的选择哦"},{"from":279.17,"to":281.01,"content":"而在这样的矛盾和纠结背后"},{"from":281.01,"to":283.69,"content":"是共享单车难以下降的成本和难以上涨的收入"},{"from":283.69,"to":285.14,"content":"对地形成的盈利问题"},{"from":285.14,"to":285.86,"content":"根据这篇报道"},{"from":285.86,"to":286.94,"content":"除去芯片和智能锁"},{"from":286.94,"to":288.78,"content":"现在一辆共享单车的制造成本在"},{"from":288.78,"to":289.7,"content":"五六百块钱左右"},{"from":289.7,"to":291.12,"content":"另外还要算上各种运营啊"},{"from":291.12,"to":291.54,"content":"仓储啊"},{"from":291.54,"to":292.18,"content":"折旧成本"},{"from":292.18,"to":294.54,"content":"我们经常在街上看到的共享单车调度大哥"},{"from":294.54,"to":297.32,"content":"他们的报酬是按搬运单车的数量给的"},{"from":297.32,"to":298.52,"content":"一般都是一台一块多"},{"from":298.52,"to":301.32,"content":"把这些共享单车从空闲的地方再运到地铁站"},{"from":301.32,"to":302.6,"content":"公交站也要算成本"},{"from":302.6,"to":305.72,"content":"而且共享单车的使用寿命要比家用单车短很多"},{"from":305.72,"to":306.68,"content":"能骑35年"},{"from":306.68,"to":307.78,"content":"基本上就是极品"},{"from":307.78,"to":309.64,"content":"像这种手动锁版的共享单车"},{"from":309.64,"to":311.289,"content":"在北京已经基本上看不到了"},{"from":311.289,"to":313.669,"content":"一方面是因为这样的版本单车太老了"},{"from":313.669,"to":314.569,"content":"到了使用年限"},{"from":314.569,"to":316.729,"content":"美团滴滴哈罗每年都会投放新的版本"},{"from":316.729,"to":317.809,"content":"来取代这些旧版本"},{"from":317.809,"to":320.3,"content":"另外一方面是因为这种手封锁版的共享单车"},{"from":320.3,"to":321.14,"content":"在禁停点"},{"from":321.14,"to":323.86,"content":"甚至某些荒无人烟的地方都是可以锁上的"},{"from":323.86,"to":325.4,"content":"非常不利于车辆管理"},{"from":325.4,"to":327.64,"content":"然后调度大哥去找车又要花钱"},{"from":327.64,"to":330.08,"content":"所以新的共享单车全部都是智能锁了"},{"from":330.08,"to":332.7,"content":"你必须要停在停放点停车区诶"},{"from":332.7,"to":334.8,"content":"这个技术背后又是研发成本"},{"from":334.8,"to":337,"content":"可以看到这个行业哪儿哪儿都花钱"},{"from":337,"to":338.57,"content":"就是用户不愿意掏钱"},{"from":338.57,"to":339.69,"content":"根据这篇报道测算"},{"from":339.69,"to":340.43,"content":"2024年"},{"from":340.43,"to":341.31,"content":"哈罗美团"},{"from":341.31,"to":344.25,"content":"青桔一年的运维成本分别是36.5亿"},{"from":344.25,"to":346.24,"content":"18.9亿和25.5亿"},{"from":346.24,"to":348.96,"content":"那么这三家靠共享单车赚到钱了吗"},{"from":348.96,"to":350.6,"content":"答案是都没有赚到钱"},{"from":350.6,"to":351.59,"content":"都在亏损"},{"from":351.59,"to":353.75,"content":"所以共享单车巨头现在面临的情况就是"},{"from":353.75,"to":354.97,"content":"为了满足市场需求"},{"from":354.97,"to":357.52,"content":"他们要不断增加更新更多的单车"},{"from":357.52,"to":358.18,"content":"但这么做啊"},{"from":358.18,"to":360.88,"content":"就意味着要用更多的钱去换更多的亏损"},{"from":360.88,"to":363.12,"content":"但现在已经没有金主爸爸可以给他们输血了"},{"from":363.12,"to":364.72,"content":"那他们只能够自己造些了"},{"from":364.72,"to":365.32,"content":"可以预见"},{"from":365.32,"to":366.76,"content":"随着哈罗美团青局"},{"from":366.76,"to":368.98,"content":"一步步试探的给单次进行涨价"},{"from":368.98,"to":372.44,"content":"月卡季卡次卡的费用以后也会逐渐上涨"},{"from":372.44,"to":374,"content":"除了涨价来赚钱之外"},{"from":374,"to":376.62,"content":"他们也在小范围的测试做广告投放和联名"},{"from":376.62,"to":378.06,"content":"来获得更多的额外收入"},{"from":378.06,"to":380.12,"content":"那就是效果嘛确实很难评啊"},{"from":380.12,"to":381.76,"content":"我们来看一下他们都是怎么做的"},{"from":381.76,"to":384.6,"content":"前阵子阿罗在上海和肯德基联名做了个广告"},{"from":384.6,"to":385.78,"content":"大家来听一下效果"},{"from":385.78,"to":387.26,"content":"又要去打工"},{"from":387.26,"to":389.35,"content":"谁能不发方啊"},{"from":389.35,"to":390.07,"content":"觉得怎么样呢"},{"from":390.07,"to":390.91,"content":"有人觉得很尬"},{"from":390.91,"to":391.77,"content":"有人觉得很有趣"},{"from":391.77,"to":392.91,"content":"还有早上本来就烦了"},{"from":392.91,"to":396.05,"content":"打工人听完之后想连夜暗杀肯德基老爷爷"},{"from":396.05,"to":398.13,"content":"精英那边呢选择车身广告联名"},{"from":398.13,"to":399.97,"content":"比如黑人悟空这两家联名啊"},{"from":399.97,"to":402.49,"content":"我们可以理解为是把单车变成了一个广告位"},{"from":402.49,"to":404.409,"content":"另外两家应该也会很快跟进"},{"from":404.409,"to":406.829,"content":"美团这边呢也开始在一些地方推出了"},{"from":406.829,"to":410,"content":"带共享充电宝的共享电动助力车"},{"from":410,"to":413.14,"content":"也就是在车身上面有一个共享充电宝的盒子"},{"from":413.14,"to":413.6,"content":"枪仔"},{"from":413.6,"to":415.56,"content":"我个人觉得想出这个产品的人"},{"from":415.56,"to":417.1,"content":"就是一个商业奇才"},{"from":417.1,"to":419.58,"content":"不仅可以让共享充电宝随时取随地"},{"from":419.58,"to":422.38,"content":"还同时还解决了不能够追着共享单车"},{"from":422.38,"to":423.78,"content":"还充电宝的这个痛点"},{"from":423.78,"to":425.54,"content":"一想到以后有人呢还充电宝"},{"from":425.54,"to":426.98,"content":"还得追着共享电驴的画面"},{"from":426.98,"to":428.57,"content":"就觉得超级搞笑"},{"from":428.57,"to":431.39,"content":"但这些方法真的能够帮助他们扭亏为盈吗"},{"from":431.39,"to":432.86,"content":"很显然并不能"},{"from":432.86,"to":434.82,"content":"腾讯和爱奇艺搞了那么多年"},{"from":434.82,"to":436.4,"content":"想出了那么多商业模式"},{"from":436.4,"to":438.96,"content":"最后还是靠会员包月涨价才赚到钱"},{"from":438.96,"to":440.46,"content":"所以啊各位等着吧"},{"from":440.46,"to":442.52,"content":"共享单车还会涨价的"},{"from":442.52,"to":444.44,"content":"当然你脑子里面可能有一些"},{"from":444.44,"to":445.9,"content":"可以帮助他们赚钱的点"},{"from":445.9,"to":447.42,"content":"千万不要打在弹幕上面"},{"from":447.42,"to":448.68,"content":"也不要发在评论区里面"},{"from":448.68,"to":450.06,"content":"他们真的会学习"},{"from":450.06,"to":451.1,"content":"会看到的好"},{"from":451.1,"to":452.08,"content":"这视频到此结束了"},{"from":452.08,"to":453.07,"content":"我们下视频再见"},{"from":453.07,"to":453.71,"content":"就看这里了"},{"from":453.71,"to":454.71,"content":"不来你三连就点关注吧"},{"from":454.71,"to":455.52,"content":"靓仔咕咕"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:30:30.836Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:30:24.875Z"}}
