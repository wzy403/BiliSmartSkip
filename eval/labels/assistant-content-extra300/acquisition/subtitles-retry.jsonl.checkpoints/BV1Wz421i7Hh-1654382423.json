{"schemaVersion":1,"bvid":"BV1Wz421i7Hh","cid":1654382423,"subtitles":[{"from":0.04,"to":1.8,"content":"2010年7月23日"},{"from":1.8,"to":4.76,"content":"加拿大皇家空军飞行员布莱恩贝斯"},{"from":4.76,"to":6.48,"content":"驾驶着他的cf18"},{"from":6.48,"to":8.53,"content":"为即将到来的航展做彩排"},{"from":8.53,"to":11.13,"content":"他先来了一个不收起落架的翻滚起飞"},{"from":11.13,"to":12.14,"content":"当做开胃菜"},{"from":12.14,"to":14.34,"content":"接下来他开始低空慢飞"},{"from":14.34,"to":16.48,"content":"准备来一个高仰角慢速过场"},{"from":16.48,"to":19.8,"content":"这个机动动作要求飞行员将机鼻高高扬起"},{"from":19.8,"to":21.25,"content":"大约30度左右"},{"from":21.25,"to":24.87,"content":"此时依靠发动机的强大推力和机翼升力"},{"from":24.87,"to":28.22,"content":"可以使飞机以200km每小时的速度低飞过场"},{"from":28.22,"to":29.68,"content":"对于现场观众来说"},{"from":29.68,"to":31.92,"content":"绝对是足以让他们印象深刻的表演"},{"from":31.92,"to":33.08,"content":"但不巧的是"},{"from":33.08,"to":34.46,"content":"就当布莱恩的飞机"},{"from":34.46,"to":36.87,"content":"刚刚进入到高仰角慢飞状态时"},{"from":36.87,"to":39.27,"content":"他的F18的右引擎突然失效"},{"from":39.27,"to":41.49,"content":"飞机开始不受控的向右偏转"},{"from":41.49,"to":43.18,"content":"距离地面仅有60米"},{"from":43.18,"to":44.26,"content":"生死关头"},{"from":44.26,"to":45.54,"content":"布莱恩别无选择"},{"from":45.54,"to":46.54,"content":"只能弹射"},{"from":46.54,"to":47.6,"content":"还不到一秒"},{"from":47.6,"to":50.3,"content":"他的F18就重重的砸到了地面上"},{"from":50.3,"to":51.7,"content":"变成了一团火球"},{"from":51.7,"to":52.68,"content":"幸运的是"},{"from":52.68,"to":54.3,"content":"弹射座椅救了他一命"},{"from":54.3,"to":55.97,"content":"类似的事故还有很多"},{"from":55.97,"to":57.27,"content":"像是2022年"},{"from":57.27,"to":60.41,"content":"美军的F35B在垂直起降时发生故障"},{"from":60.41,"to":62.11,"content":"飞行员只能弹射保命"},{"from":62.11,"to":63.25,"content":"截至今年8月"},{"from":63.25,"to":66.27,"content":"光是马丁贝克这一家弹射座椅生产商"},{"from":66.27,"to":69.61,"content":"就已经拯救了7727名飞行员的生命"},{"from":69.61,"to":71.7,"content":"弹射座椅的重要性不言而喻"},{"from":71.7,"to":75.34,"content":"然而这个现代战机必备飞行员保命神器"},{"from":75.34,"to":78.14,"content":"和他刚发明时可是完全不一样的状况"},{"from":78.14,"to":80.65,"content":"这背后又有着许多有趣的故事"},{"from":80.65,"to":82.35,"content":"欢迎来到CHRIS军事基地"},{"from":82.35,"to":83.85,"content":"军事十系列第三期"},{"from":83.85,"to":88.93,"content":"今天我们来说说弹射座椅是怎么拯救飞行员的"},{"from":92.45,"to":94.51,"content":"自被发明的那一刻起"},{"from":94.51,"to":96.09,"content":"怎么拯救飞行员的性命"},{"from":96.09,"to":97.94,"content":"就变成了工程师们的难题"},{"from":97.94,"to":99.7,"content":"在早期的双翼机时代"},{"from":99.7,"to":101.06,"content":"飞机要是出故障"},{"from":101.06,"to":103.26,"content":"飞行员只需要简单爬出座舱"},{"from":103.26,"to":104.88,"content":"朝侧面跳下去即可"},{"from":104.88,"to":106.66,"content":"那时的飞机速度很慢"},{"from":106.66,"to":107.82,"content":"结构也简单"},{"from":107.82,"to":110.15,"content":"从飞机上跳下去并不是什么难事"},{"from":110.15,"to":111.85,"content":"但随着航空技术的发展"},{"from":111.85,"to":113.37,"content":"飞机的速度越来越快"},{"from":113.37,"to":115.05,"content":"第二次世界大战爆发时"},{"from":115.05,"to":118.56,"content":"各国的主力战机速度都超过了500km每小时"},{"from":118.56,"to":121.68,"content":"在这种速度下逃脱驾驶舱几乎不可能"},{"from":121.68,"to":122.98,"content":"即便是跳出去了"},{"from":122.98,"to":124.4,"content":"生还的希望也不大"},{"from":124.4,"to":126.33,"content":"很有可能会撞上飞机尾翼"},{"from":126.33,"to":129.89,"content":"更别提像是德军的多尼尔335这种飞机了"},{"from":129.89,"to":131.43,"content":"尾部还有一个螺旋桨"},{"from":131.43,"to":133.49,"content":"分分钟把飞行员搅成肉酱"},{"from":133.49,"to":134.81,"content":"基于这一背景下"},{"from":134.81,"to":137.11,"content":"德国人开始率先研发弹射座椅"},{"from":137.11,"to":139.79,"content":"他们的想法是把飞行员弹出座舱"},{"from":139.79,"to":141.51,"content":"从而避免撞上飞机尾部"},{"from":141.51,"to":143.79,"content":"但摆在设计师面前的第一个难题"},{"from":143.79,"to":146.13,"content":"就是如何为弹射座椅提供动力"},{"from":146.13,"to":148.63,"content":"首个方案是在座椅下装满弹簧"},{"from":148.63,"to":150.73,"content":"依靠弹性势能转化为动能"},{"from":150.73,"to":152.17,"content":"帮助飞行员逃生"},{"from":152.17,"to":154.07,"content":"但这种方案有先天的不足"},{"from":154.07,"to":156.57,"content":"首先弹簧提供的能量不足"},{"from":156.57,"to":158.45,"content":"以将飞行员弹射到安全高度"},{"from":158.45,"to":162.38,"content":"而且飞行员在弹射前需要手动压缩弹簧后"},{"from":162.38,"to":163.48,"content":"再打开座舱"},{"from":163.48,"to":164.66,"content":"在紧急情况下"},{"from":164.66,"to":167.96,"content":"根本来不及弹簧的方案很快就被否决了"},{"from":167.96,"to":170.16,"content":"取而代之的是压缩空气"},{"from":170.16,"to":171.34,"content":"相比于弹簧"},{"from":171.34,"to":173.91,"content":"压缩空气可以提供更强劲的推力"},{"from":173.91,"to":175.61,"content":"使用起来也更加简易"},{"from":175.61,"to":177.29,"content":"这种设计被德国人采用"},{"from":177.29,"to":178.57,"content":"在整个二战中"},{"from":178.57,"to":180.49,"content":"德国人依靠他们的弹射座椅"},{"from":180.49,"to":182.76,"content":"拯救了大约60名飞行员的生命"},{"from":182.76,"to":184.93,"content":"但使用压缩空气还不是最终结"},{"from":184.93,"to":187.21,"content":"因为其需要大量额外的机械部件"},{"from":187.21,"to":189.29,"content":"像是气罐阀门之类的"},{"from":189.29,"to":190.83,"content":"整体设计不够简洁"},{"from":190.83,"to":192.81,"content":"还有升级的空间"},{"from":194.1,"to":195.24,"content":"二战结束后"},{"from":195.24,"to":196.589,"content":"英国人接过重任"},{"from":196.589,"to":199.709,"content":"马丁贝克公司开始研发他们的弹射座椅"},{"from":199.709,"to":201.369,"content":"不同于德国人的设计思路"},{"from":201.369,"to":204.579,"content":"他们决定用威力更强一点的材料提供动力"},{"from":204.579,"to":206.879,"content":"他们的弹射座椅包含了炸弹"},{"from":206.879,"to":207.699,"content":"弹射装置"},{"from":207.699,"to":209.299,"content":"安装在座椅背部里面"},{"from":209.299,"to":210.55,"content":"装满了无烟火药"},{"from":210.55,"to":212.23,"content":"当飞行员拉下面罩时"},{"from":212.23,"to":213.45,"content":"火药就会触发"},{"from":213.45,"to":215.03,"content":"将座椅高速弹出"},{"from":215.03,"to":218.23,"content":"工作原理就像是子弹从枪管里射出一样"},{"from":218.23,"to":219.47,"content":"有了基本的概念"},{"from":219.47,"to":220.91,"content":"下面就该测试了"},{"from":220.91,"to":224.029,"content":"测试弹射座椅可并非是项轻松的工作"},{"from":224.029,"to":227.189,"content":"弹射时产生的瞬间加速度会压缩脊柱"},{"from":227.189,"to":230.36,"content":"姿势正确力就可以顺着脊柱向下传递"},{"from":230.36,"to":231.84,"content":"但如果稍有弯曲"},{"from":231.84,"to":235.3,"content":"强大的推力会导致脊柱脱位甚至骨折"},{"from":235.3,"to":238.04,"content":"因此需要相当勇敢的人来测试他们"},{"from":238.04,"to":239.48,"content":"来自基层的装配工"},{"from":239.48,"to":241.54,"content":"伯纳德林奇充当了志愿者"},{"from":241.54,"to":243.96,"content":"一遍又一遍的挑战自己身体的极限"},{"from":243.96,"to":246.3,"content":"他的勇气不仅仅止于地面"},{"from":246.3,"to":248.08,"content":"1946年7月24日"},{"from":248.08,"to":250.64,"content":"他参加了马丁贝克的第一次空中试验"},{"from":250.64,"to":254.01,"content":"从时速480km每小时的飞机中成功弹射"},{"from":254.01,"to":256.03,"content":"但这可不是唯一的一次"},{"from":256.03,"to":257.79,"content":"他弹了整整30次"},{"from":257.79,"to":259.25,"content":"妥妥的大英超人"},{"from":259.25,"to":260.519,"content":"在他的帮助下"},{"from":260.519,"to":263.459,"content":"马丁贝克成功造出了第一个实用的弹射仪"},{"from":263.459,"to":266.479,"content":"很快这个弹射椅被派上了用场"},{"from":267.519,"to":268.979,"content":"1949年5月"},{"from":268.979,"to":273.219,"content":"英国在试验性的飞翼机aw52测试飞行时"},{"from":273.219,"to":275.53,"content":"飞机突然出现不可控制的颤动"},{"from":275.53,"to":278.06,"content":"整架飞机仿佛要在空中解体一般"},{"from":278.06,"to":281.1,"content":"飞行员果断选择弹射成功活了下来"},{"from":281.1,"to":282.54,"content":"虽然说取得了进步"},{"from":282.54,"to":285.539,"content":"但首款弹射座椅的使用还是过于复杂"},{"from":285.539,"to":288.81,"content":"飞行员需要手动分离座椅并拉开降落伞"},{"from":288.81,"to":291.43,"content":"这一系列操作怎么说也要十几秒"},{"from":291.43,"to":292.95,"content":"如果飞机高度过低"},{"from":292.95,"to":295.01,"content":"或者飞行员弹射时失去意识"},{"from":295.01,"to":296.6,"content":"都基本不可能存活"},{"from":296.6,"to":300.2,"content":"因此弹射座椅还有很大的改进空间"},{"from":301.86,"to":303.83,"content":"随着航空工业的进一步发展"},{"from":303.83,"to":305.99,"content":"飞机的速度又上升到了新的高度"},{"from":305.99,"to":307.91,"content":"超音速飞行已经是标配了"},{"from":307.91,"to":311.02,"content":"相应的飞机的尾翼也变得更大更高"},{"from":311.02,"to":313.8,"content":"工程师们又遇到了和二战时相同的问题"},{"from":313.8,"to":317.18,"content":"怎么让飞行员从飞得更快的飞机中弹射出来"},{"from":317.18,"to":318.49,"content":"还不会撞到尾翼"},{"from":318.49,"to":321.27,"content":"简单的方法就是给座椅增加更多的炸药"},{"from":321.27,"to":322.25,"content":"提升动力"},{"from":322.25,"to":324.41,"content":"但现有弹射座椅的瞬时加速度"},{"from":324.41,"to":325.98,"content":"已经逼近人类极限"},{"from":325.98,"to":327.56,"content":"再快基本上不可能"},{"from":327.56,"to":330.59,"content":"这时有的工程师就想出来一个骚操作"},{"from":330.59,"to":332.63,"content":"既然往上弹会撞到尾翼"},{"from":332.63,"to":333.95,"content":"那咱们就往下弹"},{"from":333.95,"to":337.43,"content":"隆重介绍美军F104新式战斗机"},{"from":337.43,"to":339.69,"content":"这款飞机配备了向下弹射的座椅"},{"from":339.69,"to":341.539,"content":"但这种方案有先天的缺陷"},{"from":341.539,"to":342.939,"content":"要想在低空弹射"},{"from":342.939,"to":344.839,"content":"飞行员必须要先翻滚飞机"},{"from":344.839,"to":347.01,"content":"将机腹朝上才能弹射"},{"from":347.01,"to":349.43,"content":"紧急情况时基本上就是必死"},{"from":349.43,"to":351.07,"content":"这款向下弹射的座椅"},{"from":351.07,"to":353.31,"content":"带走了20多名美军飞行员的生命"},{"from":353.31,"to":354.23,"content":"毫无疑问"},{"from":354.23,"to":355.79,"content":"该方案被彻底否决"},{"from":355.79,"to":357.73,"content":"为了解决无伤弹射的问题"},{"from":357.73,"to":359.49,"content":"工程师们重回设计阶段"},{"from":359.49,"to":361.25,"content":"开始寻找新的动力来源"},{"from":361.25,"to":363.32,"content":"要求在不伤害飞行员的前提下"},{"from":363.32,"to":365.82,"content":"尽可能增加弹射的高度和可控性"},{"from":365.82,"to":367.1,"content":"研究了一圈后"},{"from":367.1,"to":369.12,"content":"工程师们将目光瞄准上了火箭"},{"from":369.12,"to":371.06,"content":"助推器和炸药相比"},{"from":371.06,"to":372.76,"content":"火箭助推器有诸多优点"},{"from":372.76,"to":374.82,"content":"首先就是动力更澎湃"},{"from":374.82,"to":377.72,"content":"可以将更重的座椅更快的弹出飞机"},{"from":377.72,"to":380.08,"content":"其次使用炸药的弹射座椅"},{"from":380.08,"to":382.5,"content":"火药安装在座椅和座舱的连接处"},{"from":382.5,"to":385.24,"content":"在爆炸的一瞬间拥有最高的加速度"},{"from":385.24,"to":388.07,"content":"之后就完全是依靠惯性飞出座舱"},{"from":388.07,"to":390.76,"content":"弹出后座舱的姿态完全不可控"},{"from":390.76,"to":393.92,"content":"但火箭助推器可以绑在座椅后弹射时"},{"from":393.92,"to":396.48,"content":"其燃烧过程起码要耗费两到三秒"},{"from":396.48,"to":398.04,"content":"这使得在弹射过程中"},{"from":398.04,"to":401.1,"content":"座舱的姿态与轨迹均还有调整的空间"},{"from":401.1,"to":404.72,"content":"而且座椅的加速度相对来说平稳且持久"},{"from":404.72,"to":406.62,"content":"对飞行员的脊柱压力更小"},{"from":406.62,"to":408.22,"content":"有了火箭助推器的帮助"},{"from":408.22,"to":409.68,"content":"弹射的限制更小"},{"from":409.68,"to":412.24,"content":"可以做到零高度零速度的安全弹射"},{"from":412.24,"to":413.76,"content":"对于弹射座椅来说"},{"from":413.76,"to":416.17,"content":"火箭助推器就是版本答案了"},{"from":416.17,"to":418.41,"content":"但凡需要短时间持久加速的"},{"from":418.41,"to":420.35,"content":"基本上就离不开火箭助推器"},{"from":420.35,"to":423.77,"content":"比方说美军为了让F100可以短距离起飞"},{"from":423.77,"to":426.19,"content":"在飞机引擎后面加装火箭助推器"},{"from":426.19,"to":430.13,"content":"支个架子直接发射起飞或者更大吨位的运输机"},{"from":430.13,"to":433.3,"content":"C130也曾在机身绑满火箭助推器"},{"from":433.3,"to":434.38,"content":"力大专飞"},{"from":434.38,"to":437.08,"content":"让螺旋桨飞机也可以短距离起飞"},{"from":439.1,"to":441.48,"content":"为了提高坦克在泥滩地面上的通过性"},{"from":441.48,"to":443.43,"content":"甚至把火箭助推器搬了上去"},{"from":443.43,"to":446.57,"content":"可这种方案虽然说可以提高坦克的脱困性"},{"from":446.57,"to":448.33,"content":"但生存能力大大降低"},{"from":448.33,"to":450.41,"content":"火箭助推器挨一发就得GG"},{"from":450.41,"to":452.86,"content":"最终还是只停留在了设计阶段"},{"from":452.86,"to":454.42,"content":"虽然说现实中看不到了"},{"from":454.42,"to":458.039,"content":"但这样的设计却能在游戏中体验到坦克世界里"},{"from":458.039,"to":459.459,"content":"C系的BZ系列坦克"},{"from":459.459,"to":462.72,"content":"并在车体侧后部装配了这样一对火箭推进器"},{"from":462.72,"to":463.84,"content":"一次激活后"},{"from":463.84,"to":464.88,"content":"可以在短时间内"},{"from":464.88,"to":467.07,"content":"凭借高达30马力每吨的推重比"},{"from":467.07,"to":469.07,"content":"将60吨的巨型坦克加速至"},{"from":469.07,"to":470.41,"content":"接近60km每小时"},{"from":470.41,"to":471.99,"content":"称得上是力大砖飞了"},{"from":471.99,"to":473.05,"content":"8月20日"},{"from":473.05,"to":475.43,"content":"坦克世界国服周年庆活动已上线"},{"from":475.43,"to":476.21,"content":"登录游戏"},{"from":476.21,"to":478.669,"content":"参与活动即有机会获取丰富奖励"},{"from":478.669,"to":480.909,"content":"其中包含了以关羽为设计灵感"},{"from":480.909,"to":484.13,"content":"制作的C系火箭推进坦克BZ75"},{"from":484.13,"to":485.27,"content":"神威勇武"},{"from":485.27,"to":486.31,"content":"在战场上"},{"from":486.31,"to":488.929,"content":"BZ75身背18枚火箭助推器"},{"from":488.929,"to":490.469,"content":"在广阔的平原飙车"},{"from":490.469,"to":492.229,"content":"机动性堪比中型坦克"},{"from":492.229,"to":494.769,"content":"更不用说这款全新的关羽皮肤"},{"from":494.769,"to":496.12,"content":"简直是帅到不行"},{"from":496.12,"to":499.58,"content":"给人一种穿越现实坦克变身赤兔马的感觉"},{"from":499.58,"to":501.32,"content":"想要在真实的坦克作战中"},{"from":501.32,"to":503.76,"content":"操控身背火箭助推器的关羽战车"},{"from":503.76,"to":505.62,"content":"亲自驾驶坦克驰骋疆场"},{"from":505.62,"to":506.4,"content":"转动炮塔"},{"from":506.4,"to":509.49,"content":"一发入魂的坦克世界是你最好的选择"},{"from":509.49,"to":511.17,"content":"快来下载坦克世界国服"},{"from":511.17,"to":513.57,"content":"体验精彩刺激的坦克对决吧"},{"from":514.23,"to":516.37,"content":"那说回弹射座椅"},{"from":516.37,"to":519.43,"content":"在确定了使用火箭助推器作为新的动力来源后"},{"from":519.43,"to":521.03,"content":"剩下的工作还有很多"},{"from":521.03,"to":524.17,"content":"从超音速飞机弹射面临着一个很大的问题"},{"from":524.17,"to":525.59,"content":"那就是过快的风速"},{"from":525.59,"to":527.88,"content":"会导致飞行员体验剧烈的减速度"},{"from":527.88,"to":530.16,"content":"没人知道飞行员的身体能承受多少"},{"from":530.16,"to":533.75,"content":"毕竟从来没有人在超音速的情况下测试过弹射"},{"from":533.75,"to":534.71,"content":"那说到这儿"},{"from":534.71,"to":535.27,"content":"就得提"},{"from":535.27,"to":538.49,"content":"另一位在弹射座椅发展中做出重要贡献的人了"},{"from":538.49,"to":540.88,"content":"美利坚超人约翰斯塔普"},{"from":540.88,"to":541.88,"content":"他非常好奇"},{"from":541.88,"to":544.62,"content":"快速减速会对人类身体造成哪些影响"},{"from":544.62,"to":547.9,"content":"因此制造了一个绑满火箭助推器的轨道车"},{"from":547.9,"to":550.72,"content":"火箭助推器可以提供1.8吨的推力"},{"from":550.72,"to":554.2,"content":"在轨道上将小车加速到960km每小时"},{"from":554.2,"to":556.1,"content":"然后全速冲向减速水坑"},{"from":556.1,"to":558.44,"content":"在不到1.5秒的时间内完全停止"},{"from":558.44,"to":559.849,"content":"这几乎就是玩命"},{"from":559.849,"to":562.289,"content":"斯塔普受到的减速度达到了20G"},{"from":562.289,"to":563.409,"content":"实验结束后"},{"from":563.409,"to":564.689,"content":"他的肋骨断裂"},{"from":564.689,"to":567.069,"content":"眼球里的毛细血管全部被撕裂"},{"from":567.069,"to":568.469,"content":"但斯塔普还不满意"},{"from":568.469,"to":569.87,"content":"他还想挑战极限"},{"from":569.87,"to":571.35,"content":"在他最后一次测试中"},{"from":571.35,"to":573.07,"content":"直接全部拉满身体"},{"from":573.07,"to":575.39,"content":"车道的瞬间减速度达到了40G"},{"from":575.39,"to":576.93,"content":"已经超出极限的两倍"},{"from":576.93,"to":578.819,"content":"最终他还是活了下来"},{"from":578.819,"to":580.379,"content":"他的实验成功证明了"},{"from":580.379,"to":582.539,"content":"在超音速下弹射是可以存活的"},{"from":582.539,"to":583.579,"content":"1955年"},{"from":583.579,"to":585.84,"content":"在F100的超音速试飞测试中"},{"from":585.84,"to":588.24,"content":"飞机在2千米左右的高度失去控制"},{"from":588.24,"to":589.68,"content":"机头向下猛冲"},{"from":589.68,"to":592.08,"content":"速度达到了1250km每小时"},{"from":592.08,"to":593.54,"content":"飞行员只能弹射"},{"from":593.54,"to":594.08,"content":"身体"},{"from":594.08,"to":596.12,"content":"同样承受将近40G的减速度"},{"from":596.12,"to":597.42,"content":"虽然全身肿胀"},{"from":597.42,"to":599.14,"content":"但飞行员最终活了下来"},{"from":599.14,"to":601.36,"content":"在解决了超音速弹射这个难题后"},{"from":601.36,"to":603.66,"content":"弹射座椅又迈上了新的台阶"},{"from":603.66,"to":605.12,"content":"在之后的发展过程中"},{"from":605.12,"to":607.58,"content":"也不乏有趣的座椅设计"},{"from":609.32,"to":611.26,"content":"1956年"},{"from":611.26,"to":614.46,"content":"美军最新的超音速轰炸机B58问世"},{"from":614.46,"to":616.48,"content":"其最高时速达到了两倍音速"},{"from":616.48,"to":618.64,"content":"最大升限19000千米"},{"from":618.64,"to":619.62,"content":"在这种条件下"},{"from":619.62,"to":621.579,"content":"弹射飞行员肯定活不了"},{"from":621.579,"to":622.259,"content":"工程师们"},{"from":622.259,"to":625.159,"content":"必须要专门为B58打造一套弹射座椅"},{"from":625.159,"to":626.419,"content":"他们的方案是"},{"from":626.419,"to":629.4,"content":"将每个飞行员都完整的包裹在弹射弹中"},{"from":629.4,"to":631.05,"content":"在弹射程序触发时"},{"from":631.05,"to":633.51,"content":"机械装置会将飞行员的腿拉进座椅"},{"from":633.51,"to":636.23,"content":"随后完整的弹壳就会包裹住飞行员"},{"from":636.23,"to":638.43,"content":"弹射弹内部还会进行加压"},{"from":638.43,"to":640.02,"content":"并给飞行员提供氧气"},{"from":640.02,"to":642.9,"content":"整体一套方案听起来还是很稳妥的"},{"from":642.9,"to":645.26,"content":"但这次弹射的实验风险实在是太高"},{"from":645.26,"to":647.13,"content":"让飞行员冒险不太现实"},{"from":647.13,"to":649.29,"content":"为了验证他们的弹射弹是否管用"},{"from":649.29,"to":651.67,"content":"美国空军将一只小黑熊放了进去"},{"from":651.67,"to":654.96,"content":"让他在1万多米的高度完成了一次超音速弹射"},{"from":654.96,"to":657.39,"content":"结果是成功的熊活了下来"},{"from":657.39,"to":658.93,"content":"不过看他这个舌头状态"},{"from":658.93,"to":660.29,"content":"估计已经吓傻了"},{"from":660.29,"to":661.29,"content":"总体来说"},{"from":661.29,"to":662.91,"content":"弹射弹的设计是成功的"},{"from":662.91,"to":664.13,"content":"在冷战时期"},{"from":664.13,"to":666.27,"content":"B58总计成功弹射了九次"},{"from":666.27,"to":668.73,"content":"拯救了十几名飞行员的生命"},{"from":670.06,"to":671.86,"content":"类似有趣的弹射座椅设计"},{"from":671.86,"to":674.54,"content":"还有F11和其他飞机都不同"},{"from":674.54,"to":676.9,"content":"F11的弹射不是射座椅"},{"from":676.9,"to":679.16,"content":"而是将整个驾驶舱都完全弹出"},{"from":679.23,"to":680.93,"content":"有点像让太空返回舱"},{"from":680.93,"to":683.03,"content":"当飞行员拉动弹射手柄时"},{"from":683.03,"to":684.65,"content":"安全带会自动收紧"},{"from":684.65,"to":686.45,"content":"迫使飞行员脊柱竖直"},{"from":686.45,"to":688.17,"content":"紧急供氧系统会开始工作"},{"from":688.17,"to":690.25,"content":"可以给飞行员提供10分钟氧气"},{"from":690.25,"to":694.06,"content":"随后各种连接到驾驶舱的线缆会被炸药切断"},{"from":694.06,"to":696.84,"content":"之后座舱的火箭发动机便会点火"},{"from":696.84,"to":697.88,"content":"机增的压力"},{"from":697.88,"to":699.84,"content":"点燃座舱和机身连接处的炸药"},{"from":699.84,"to":701.39,"content":"将机舱完全分离"},{"from":701.39,"to":703.09,"content":"火箭助推器有两个喷口"},{"from":703.09,"to":705.05,"content":"传感器会根据弹射时的速度"},{"from":705.05,"to":706.55,"content":"调整两个喷口的推力"},{"from":706.55,"to":709.28,"content":"当弹射速度在550km每小时的时候"},{"from":709.28,"to":711.16,"content":"主喷口会提供4吨的推力"},{"from":711.16,"to":713.22,"content":"副喷口会提供3.2吨的推力"},{"from":713.22,"to":714.68,"content":"两个喷口协调工作"},{"from":714.68,"to":717.52,"content":"以确保座舱姿态水平和弹射的座椅相比"},{"from":717.52,"to":719.12,"content":"这种设计稳定性更强"},{"from":719.12,"to":721.22,"content":"机组人员的不适感被大大降低"},{"from":721.22,"to":722.62,"content":"在越南战争时期"},{"from":722.62,"to":726.22,"content":"FL的弹射座舱拯救了很多飞行员的生命"},{"from":727.14,"to":729.12,"content":"虽然说从超音速飞机上弹射"},{"from":729.12,"to":730.66,"content":"在技术上很有挑战性"},{"from":730.66,"to":731.7,"content":"但在现实生活中"},{"from":731.7,"to":733.609,"content":"这种情况还是比较罕见"},{"from":733.609,"to":736.209,"content":"大多数弹射都是发生在低速状态下"},{"from":736.209,"to":737.829,"content":"加上起飞降落阶段"},{"from":737.829,"to":741.109,"content":"那下一个需要解决的问题就是当飞行员弹射时"},{"from":741.109,"to":743.009,"content":"一般都失去了对飞机的控制"},{"from":743.009,"to":746.19,"content":"这时的飞机可能处于各种不同的姿态当中"},{"from":746.19,"to":749.29,"content":"从这种状态下弹射座椅会不受控制旋转"},{"from":749.29,"to":750.71,"content":"如果不能及时调整"},{"from":750.71,"to":752.37,"content":"就不能迅速部署降落伞"},{"from":752.37,"to":755.13,"content":"晚上一两秒钟都可能是不一样的结果"},{"from":755.13,"to":757.37,"content":"那说回咱们视频开头的那次事故"},{"from":757.37,"to":760.41,"content":"那架F18在60米的高度失去了控制"},{"from":760.41,"to":762.01,"content":"飞机开始向右偏转"},{"from":762.01,"to":763.29,"content":"当飞行员弹射时"},{"from":763.29,"to":766.46,"content":"你可以看到他的身体其实是和地面平行的"},{"from":766.46,"to":768.72,"content":"如果弹射足以以重姿态飞行的话"},{"from":768.72,"to":771.92,"content":"60米的高度是根本来不及展开降落伞的"},{"from":771.92,"to":774.24,"content":"这时你可以看到他座椅的火箭"},{"from":774.24,"to":776.64,"content":"助推器的喷嘴略微改变了方向"},{"from":776.64,"to":780.1,"content":"几乎在一瞬间就将飞行员的坐姿调整到了水平"},{"from":780.1,"to":781.64,"content":"随后散包迅速推出"},{"from":781.64,"to":782.78,"content":"不到一秒后"},{"from":782.78,"to":784.42,"content":"IP18就重重砸地"},{"from":784.42,"to":785.72,"content":"在这场事故中"},{"from":785.72,"to":788.06,"content":"弹射座椅在每一个环节都做到了极致"},{"from":788.06,"to":789.98,"content":"可以说每一秒都至关重要"},{"from":789.98,"to":791.06,"content":"稍有瑕疵"},{"from":791.06,"to":793.75,"content":"飞行员就得和世界说拜拜了"},{"from":794.899,"to":796.819,"content":"在经过了80年的发展迭代"},{"from":796.819,"to":799.199,"content":"如今的弹射座椅已经无比智能"},{"from":799.199,"to":801.329,"content":"各种芯片传感器遍布座椅"},{"from":801.329,"to":802.989,"content":"飞行员只需要拉动把手"},{"from":802.989,"to":804.349,"content":"剩下的就交给座椅"},{"from":804.349,"to":805.869,"content":"座椅会自动调整姿态"},{"from":805.869,"to":806.569,"content":"自动分离"},{"from":806.569,"to":808.41,"content":"飞行员自动部署降落伞"},{"from":808.41,"to":809.83,"content":"降落伞的展开速度"},{"from":809.83,"to":812.21,"content":"从1949年手动展开的30秒"},{"from":812.21,"to":814.15,"content":"缩短到了现在的不到0.3秒"},{"from":814.15,"to":816.66,"content":"在美国海军的F35上弹射时"},{"from":816.66,"to":817.94,"content":"你都不需要飞行员操控"},{"from":817.94,"to":820.88,"content":"当智能电脑检测到飞机无法从紧状态恢复时"},{"from":820.88,"to":822.1,"content":"便会自动弹射"},{"from":822.1,"to":824.14,"content":"从而最大程度缩短弹射时间"},{"from":824.14,"to":826.28,"content":"相信这还不是弹射座椅的最终形态"},{"from":826.28,"to":828,"content":"随着航空工业的进一步发展"},{"from":828,"to":829.54,"content":"还会有更多不同的思路"},{"from":829.54,"to":831.02,"content":"那如果大家对F11"},{"from":831.02,"to":832.64,"content":"稀奇的弹射座舱感兴趣的话"},{"from":832.64,"to":834.9,"content":"欢迎大家去看这期F1的讲解视频"},{"from":834.9,"to":836.83,"content":"也是一款冷战的黑科技之作"},{"from":836.83,"to":839.57,"content":"OK啦那以上就是本期视频的全部内容了"},{"from":839.57,"to":840.79,"content":"如果觉得还不错的话"},{"from":840.79,"to":842.03,"content":"别忘了多多三连哦"},{"from":842.03,"to":842.99,"content":"还想看什么"},{"from":842.99,"to":844.069,"content":"评论区告诉我"},{"from":844.069,"to":844.949,"content":"别忘了"},{"from":844.949,"to":846.849,"content":"8月20号坦克世界周年庆"},{"from":846.849,"to":848.669,"content":"新老玩家都有超多奖励哦"},{"from":848.669,"to":850.44,"content":"那我们下期视频再见"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:32:09.792Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:32:04.901Z"}}
