不需要说一个字"},{"from":620.84,"to":622.78,"content":"观众自然会替他辩经的"},{"from":622.78,"to":626.04,"content":"所以我说最厉害的公关您就记住四个字"},{"from":626.04,"to":627.67,"content":"功在平时"},{"from":627.67,"to":631.19,"content":"平时就在受众的心里头存够足额的情感余额"},{"from":631.19,"to":632.83,"content":"那哪怕到了危机的时候"},{"from":632.83,"to":635.73,"content":"这些情感余额呢也能帮助品牌消化冲击"},{"from":635.73,"to":636.76,"content":"度过危机"},{"from":636.76,"to":639.4,"content":"特别是在产品品质安全方面下了功夫"},{"from":639.4,"to":642.02,"content":"这种靠诚信经营积累下来的金融货币"},{"from":642.02,"to":645.22,"content":"不是一两个代言人的翻车鱼型就能够透支掉的"},{"from":645.22,"to":648.09,"content":"就比如知名购物平台京东超市"},{"from":648.09,"to":650.77,"content":"将产品质量和食品安全把关作为切入点"},{"from":650.77,"to":652.81,"content":"推出了京东超市品质实验室"},{"from":652.81,"to":653.67,"content":"嘿嘿没想到吧"},{"from":653.67,"to":654.87,"content":"真正的广告在这呢"},{"from":654.87,"to":656.73,"content":"哎平台主打是检测把关"},{"from":656.73,"to":657.29,"content":"安心购买"},{"from":657.29,"to":659.13,"content":"京东除了有自己独立的检测实验室"},{"from":659.13,"to":661.21,"content":"还和多家有资质的实验室进行了战略合作"},{"from":661.21,"to":662.96,"content":"比如华测北京中任等等"},{"from":662.96,"to":664.2,"content":"抓的就是食品安全问题"},{"from":664.2,"to":666.96,"content":"对上架京东超市的产品做抽检和提高准入门槛"},{"from":666.96,"to":669,"content":"比如水果生鲜呢就要检测农残"},{"from":669,"to":669.48,"content":"禽出肉"},{"from":669.48,"to":671.28,"content":"还有水产品就要检测兽药残留"},{"from":671.28,"to":673.18,"content":"个别商家肉制品可能存在掺假"},{"from":673.18,"to":674.1,"content":"比如说用鸭肉"},{"from":674.1,"to":674.94,"content":"马肉冒充牛肉"},{"from":674.94,"to":676.58,"content":"那平台就得做好溯源性检测"},{"from":676.58,"to":678.32,"content":"看有没有挂牛头卖鸭肉"},{"from":678.32,"to":679.46,"content":"通过实验室的检测"},{"from":679.46,"to":681.33,"content":"为产品摆一道质量关"},{"from":681.33,"to":683.61,"content":"所以希望所有品牌能理解一个道理"},{"from":683.61,"to":685.43,"content":"只有这种对产品质量的把关"},{"from":685.43,"to":688.4,"content":"才是真正给品牌积累信任的余额"},{"from":688.4,"to":690.74,"content":"但是呢这种余额啊他也不是无限的"},{"from":690.74,"to":693.96,"content":"也不可能任由品牌去无限度的透支和消耗"},{"from":693.96,"to":695.8,"content":"它也是需要往里面补充的"},{"from":695.8,"to":698.18,"content":"所以呢去做一些标准化的公关动作"},{"from":698.18,"to":699.36,"content":"在热度降级之后"},{"from":699.36,"to":700.6,"content":"在特定的渠道"},{"from":700.6,"to":701.38,"content":"特定的平台"},{"from":701.38,"to":702.64,"content":"特定的影响范围内"},{"from":702.64,"to":704.02,"content":"您去出一份公关函"},{"from":704.02,"to":705.62,"content":"那还是有一定的好处的"},{"from":705.62,"to":708.04,"content":"如果是金主让我来处理这个case的话"},{"from":708.04,"to":711.16,"content":"那我会按照切割整改上价值的思路"},{"from":711.16,"to":712.54,"content":"给再写一篇公关稿"},{"from":712.54,"to":713.84,"content":"我给大家感受一下啊"},{"from":713.84,"to":717.1,"content":"呃首要任务肯定是要做切割对吧"},{"from":717.1,"to":720.19,"content":"呃今日央视315晚会报道"},{"from":720.19,"to":722.39,"content":"宜昌某门店违规操作事件"},{"from":722.39,"to":725.87,"content":"犹如一件重锤敲在雪王的心头"},{"from":725.87,"to":726.85,"content":"我们深知"},{"from":726.85,"to":730.03,"content":"次元的柠檬水承载的不仅是解渴的需求"},{"from":730.03,"to":734.3,"content":"更是亿万消费者对雪王的信任的托付啊"},{"from":734.3,"to":737.1,"content":"现在就这个事件的处理和未来的承诺"},{"from":737.1,"to":739.28,"content":"向全社会郑重声明啊"},{"from":739.28,"to":740.24,"content":"经调查"},{"from":740.24,"to":743.36,"content":"某某门店出现鲜果切片储存不当的问题"},{"from":743.36,"to":746.08,"content":"已经触犯了蜜雪冰城加盟管理条例"},{"from":746.08,"to":747.68,"content":"叉叉叉原则啊"},{"from":747.68,"to":750.98,"content":"肯定我们首先要强调这个是个别加盟店的问题"},{"from":750.98,"to":753.04,"content":"品牌呢对这个事是零容忍的"},{"from":753.04,"to":755.08,"content":"而且在单门店发生问题以后"},{"from":755.08,"to":757.93,"content":"我们也开始了对所有门店的严查啊"},{"from":757.93,"to":759.35,"content":"这首先是摆明一个态度嘛"},{"from":759.35,"to":761.19,"content":"我是和你消费者站在一起的"},{"from":761.19,"to":763.25,"content":"不是说加盟商给我交加盟费"},{"from":763.25,"to":764.05,"content":"为我赚钱"},{"from":764.05,"to":766.39,"content":"我就给他们去辩解站台的啊"},{"from":766.39,"to":768.08,"content":"这是第一第二哎"},{"from":768.08,"to":768.92,"content":"我要说整改"},{"from":768.92,"to":770.18,"content":"那针对现有的问题"},{"from":772.92,"to":774.98,"content":"就比如说我把食品安全的投诉率"},{"from":774.98,"to":777.16,"content":"和加盟商的保证金直接挂钩"},{"from":777.16,"to":780.32,"content":"从机制上去加大惩罚的力度和监管的力度"},{"from":780.32,"to":781.36,"content":"那请大家相信"},{"from":781.36,"to":784.76,"content":"食品安全永远是我们蜜雪冰城最在意的红线啊"},{"from":786.22,"to":787.36,"content":"不管是真的假的"},{"from":787.36,"to":788.8,"content":"你得有个措施对吧"},{"from":788.8,"to":789.5,"content":"第三呢"},{"from":789.5,"to":792.94,"content":"你要针对用户的暖心评论做回应和肯定"},{"from":792.94,"to":794.64,"content":"让支持蜜雪冰城的用户啊"},{"from":794.64,"to":796.34,"content":"有一种被看见的感觉"},{"from":796.34,"to":798.46,"content":"尽管有网友为我们辩护"},{"from":798.46,"to":800.06,"content":"四块钱还要什么自行车"},{"from":800.06,"to":801.52,"content":"但是我们深知"},{"from":801.52,"to":803.9,"content":"即使评价在食品安全领域"},{"from":803.9,"to":805.99,"content":"我们也不享有任何的特权"},{"from":805.99,"to":808.63,"content":"我们坚持只有最好的出品品质"},{"from":808.63,"to":811.49,"content":"才能对得起广大用户对我们的信任"},{"from":811.49,"to":812.82,"content":"评价不等于低质"},{"from":812.82,"to":815.44,"content":"我们也绝不会因为评价就放松"},{"from":815.44,"to":817.04,"content":"对品质的管理和要求"},{"from":817.04,"to":818.26,"content":"最后要上价值了"},{"from":818.26,"to":820.84,"content":"从河南的小巷走出的雪王"},{"from":820.84,"to":822.72,"content":"始终记得是谁"},{"from":822.72,"to":827.08,"content":"用一杯杯的柠檬水把我们送上港股千亿的市值"},{"from":827.08,"to":831.1,"content":"我们恳请大家继续用放大镜来监督我们"},{"from":831.1,"to":833.1,"content":"因为蜜雪冰城的终极梦想"},{"from":833.1,"to":838.1,"content":"就是让每个街角都能喝到放心又平价的柠檬水"},{"from":838.1,"to":842.37,"content":"蜜雪冰城经商表达呢对用户的感恩感谢"},{"from":842.37,"to":844.17,"content":"重塑品牌的价值主张"},{"from":844.17,"to":846.85,"content":"那不知道大家能给我这个公关稿打几分啊"},{"from":846.85,"to":848.38,"content":"毕竟我是律师出身"},{"from":848.38,"to":850.42,"content":"主要的技能是公关领域的法律服务"},{"from":850.42,"to":853.04,"content":"公关水平呢在我们这个团队里应该是最菜的"},{"from":853.04,"to":853.8,"content":"但是你看啊"},{"from":853.8,"to":857.22,"content":"就是切割整改上价值最简单的三板斧"},{"from":857.22,"to":860.75,"content":"就能在危机发生之后实现危机的降级"},{"from":860.75,"to":861.87,"content":"好感的升级"},{"from":861.87,"to":865.77,"content":"再把品牌价廉质优的价值主张再强化一遍啊"},{"from":865.77,"to":868.34,"content":"顺便呢也接住了用户的这种溺爱"},{"from":868.34,"to":871.3,"content":"让用户能感觉到我对品牌的付出和热爱"},{"from":871.3,"to":872.54,"content":"它是一种双向奔赴"},{"from":872.54,"to":876.19,"content":"我不是那个被坑了还替人家说话的傻帽啊"},{"from":876.19,"to":877.63,"content":"避免用户的这种感情"},{"from":877.63,"to":880.09,"content":"被网络上一些负面的声音给消耗掉"},{"from":880.09,"to":882.08,"content":"但其实啊这次315晚会之后"},{"from":882.08,"to":883.98,"content":"还有一家公司用了一招"},{"from":883.98,"to":885.96,"content":"号称是放弃公关的方式"},{"from":885.96,"to":887.93,"content":"发了一篇公关稿来打真诚牌"},{"from":887.93,"to":890.99,"content":"那这家公司的公关稿放在业内人士的角度来看"},{"from":890.99,"to":892.39,"content":"你说可以打几分呢"},{"from":892.39,"to":895.94,"content":"为什么同样的切割整改上价值的三板斧"},{"from":895.94,"to":896.8,"content":"打真诚牌"},{"from":896.8,"to":898.86,"content":"用户却不买他的账呢"},{"from":898.86,"to":900.66,"content":"这个问题要展开讲啊"},{"from":900.66,"to":901.98,"content":"又说不完了哈"},{"from":901.98,"to":903.4,"content":"后期老师肯定要骂我了"},{"from":903.4,"to":904.22,"content":"讲太长呢"},{"from":904.22,"to":905.44,"content":"这个完播率肯定要掉"},{"from":905.44,"to":907.02,"content":"我们这期呢就先聊到这儿"},{"from":907.02,"to":907.9,"content":"大家给点点赞"},{"from":907.9,"to":909.98,"content":"我呢让后期老师给帮忙加加班"},{"from":909.98,"to":911.66,"content":"早点把下一期给大家做出来"},{"from":911.66,"to":912.54,"content":"比起做广告呢"},{"from":912.54,"to":913.48,"content":"有公关需求"},{"from":913.48,"to":914.38,"content":"法律需求哎"},{"from":914.38,"to":915.3,"content":"后台私信我"},{"from":915.3,"to":916.44,"content":"多给金主拉业务"},{"from":916.44,"to":918.16,"content":"明年呢接着给我续律师费"},{"from":918.16,"to":918.92,"content":"我是樊老师"},{"from":918.92,"to":921.12,"content":"一个被公关公司包养的废物律师啊"},{"from":921.12,"to":921.6,"content":"朋友们"},{"from":921.6,"to":922.76,"content":"我们下期见"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:27:42.144Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:27:36.748Z"}}
