{"schemaVersion":1,"bvid":"BV1gw4m1i7HA","cid":1574442574,"subtitles":[{"from":1.82,"to":3.4,"content":"日本自古地小物稀"},{"from":3.4,"to":4.22,"content":"物产贫瘠"},{"from":4.22,"to":6.6,"content":"如何把士兵喂饱一直是一个难题"},{"from":6.6,"to":7.94,"content":"尤其在战国时期"},{"from":7.94,"to":10.9,"content":"一支数百人的大军就能吃垮一个小国家"},{"from":10.9,"to":13.1,"content":"因此此日本庸医就用红萝卜"},{"from":13.1,"to":13.66,"content":"荞麦面"},{"from":13.66,"to":16.16,"content":"甘草等搓成三公分大的冰凉丸"},{"from":16.16,"to":19.26,"content":"声称一天吃三粒就不用担心消耗体力"},{"from":19.26,"to":20.84,"content":"武士们天天吃这玩意儿"},{"from":20.84,"to":21.32,"content":"也难怪"},{"from":21.32,"to":24.4,"content":"1米69的织田信长就能被称为参天巨汉了"},{"from":24.4,"to":25.84,"content":"直到1799年"},{"from":25.84,"to":28.46,"content":"一名医生向江户城主端上贡品"},{"from":28.46,"to":29.52,"content":"我应该告诉你"},{"from":29.52,"to":30.52,"content":"这是一味神药"},{"from":30.52,"to":32.72,"content":"城主疑惑的让士兵们磕上一粒"},{"from":32.72,"to":34.2,"content":"他们不但腰腿不疼了"},{"from":34.2,"to":35.22,"content":"饭也不用吃了"},{"from":35.22,"to":36.48,"content":"个个都倍有精神"},{"from":36.48,"to":37.18,"content":"城主大喜"},{"from":37.18,"to":39.02,"content":"这下连冰凉丸都节省了"},{"from":39.02,"to":41.3,"content":"就把这种药品命名为伊利金丹"},{"from":41.3,"to":44.66,"content":"实际上这就是庸医手搓的罂粟丸"},{"from":45.08,"to":46.94,"content":"世界大抬杠"},{"from":46.94,"to":50.04,"content":"这样的情况一直持续到鸦片战争之后"},{"from":50.04,"to":52.66,"content":"大英帝国用鸦片祸害了大清国"},{"from":52.66,"to":54.02,"content":"幸好日本不是海啸"},{"from":54.02,"to":54.74,"content":"就是火山"},{"from":54.74,"to":56.52,"content":"自古就是兵家不争之地"},{"from":56.52,"to":58.3,"content":"才侥幸没有被大英毒害"},{"from":58.3,"to":60.52,"content":"明治天皇不希望日本沦为大清"},{"from":60.52,"to":62.2,"content":"就颁布了鸦片禁止令"},{"from":62.2,"to":63.58,"content":"吸食者要罚巨款"},{"from":63.58,"to":64.44,"content":"如果敢来卖"},{"from":64.44,"to":65.48,"content":"那就满门抄斩"},{"from":65.48,"to":67.82,"content":"但天皇也经不住这种毒物的诱惑"},{"from":67.82,"to":69.88,"content":"就在律法上面又加了一行小字"},{"from":72.5,"to":74.12,"content":"本着穷则独善其身"},{"from":74.12,"to":75.82,"content":"达则兼济天下的原则"},{"from":75.82,"to":77.9,"content":"天皇靠着生意发了财"},{"from":77.9,"to":79.14,"content":"就开始发动战争"},{"from":79.14,"to":81.3,"content":"在海外新建了大量种植园"},{"from":81.3,"to":83.48,"content":"鸦片年产量高达60万斤"},{"from":86.4,"to":88.4,"content":"更是位居世界第一"},{"from":88.4,"to":91.64,"content":"此时的日本已经成为了当之无愧的东亚毒王"},{"from":91.64,"to":92.82,"content":"1888年"},{"from":96.9,"to":98.66,"content":"意外发现了"},{"from":98.66,"to":101.76,"content":"事实上关于的起源有五种说法"},{"from":101.76,"to":103.82,"content":"且五种说法都是日本人发明的"},{"from":103.82,"to":105.6,"content":"被长井长义博士发明"},{"from":105.6,"to":107.08,"content":"是最广为人知的一种"},{"from":107.08,"to":108.78,"content":"日本军方很快就发现"},{"from":108.78,"to":111.08,"content":"吃了这种药的人可以四天不吃饭"},{"from":111.08,"to":112.02,"content":"三天不睡觉"},{"from":112.02,"to":113.58,"content":"情绪高涨易暴躁"},{"from":113.58,"to":116.34,"content":"他们称吃了这种药的士兵获得了觉醒"},{"from":116.34,"to":118.52,"content":"就将该药品命名为觉醒剂"},{"from":118.52,"to":119.84,"content":"在日俄战争期间"},{"from":119.84,"to":122.16,"content":"士兵们普遍遭遇了脚气病的困扰"},{"from":122.16,"to":122.88,"content":"没有精神"},{"from":122.88,"to":123.96,"content":"没有勇气"},{"from":123.96,"to":127.04,"content":"伊森欧外开的征勇争鹿丸更是致死了3万"},{"from":127.04,"to":127.58,"content":"日本兵"},{"from":127.58,"to":128.92,"content":"靠着一颗颗觉醒技"},{"from":128.92,"to":130.699,"content":"他们才勉强打败了沙俄"},{"from":130.699,"to":133.679,"content":"靠觉醒技就想一直赢得战争总会输的"},{"from":133.679,"to":136.279,"content":"就像我们普通人想要变富也不能靠做梦"},{"from":136.279,"to":137.26,"content":"要学会存钱"},{"from":137.26,"to":138.54,"content":"养成记账的好习惯"},{"from":138.54,"to":139.64,"content":"会让你越来越富"},{"from":139.64,"to":141.7,"content":"如果你平时存钱又懒得记账"},{"from":141.7,"to":143.76,"content":"或者根本不知道钱都花去哪了"},{"from":143.76,"to":145.54,"content":"就一定要试试喵喵记账"},{"from":145.54,"to":147.42,"content":"我记账最大的痛点就是懒"},{"from":147.42,"to":149.56,"content":"尝试过好几次都没有坚下来"},{"from":149.56,"to":151.8,"content":"好在喵喵记账有自动记账功能"},{"from":151.8,"to":153.9,"content":"平时买了早餐几块几毛的"},{"from":153.9,"to":155.58,"content":"花了钱就可以自动记下来"},{"from":155.58,"to":157.08,"content":"简直是我这种懒人的救星"},{"from":157.08,"to":158.36,"content":"我用的这几个月"},{"from":158.36,"to":160.7,"content":"每个月都会把花销梳理的特别清晰"},{"from":160.7,"to":162.74,"content":"电子支付让人花钱没有感觉"},{"from":162.74,"to":165.46,"content":"但是自己自从每次复盘看统计表之后"},{"from":165.46,"to":166.66,"content":"就摆脱了这个问题"},{"from":166.66,"to":168.76,"content":"看见哪些地方又花了两三千"},{"from":168.76,"to":170.62,"content":"高价收的摄像头落灰了"},{"from":170.62,"to":171.92,"content":"都还没出去拍几次"},{"from":171.92,"to":172.78,"content":"更重要的是"},{"from":172.78,"to":175.8,"content":"还可以在喵喵记账设计各种周期存钱计划"},{"from":175.8,"to":177.02,"content":"我定了一个小目标"},{"from":177.02,"to":178.96,"content":"通过一天十块20的小积累"},{"from":178.96,"to":182.2,"content":"我的365天存钱计划已经存了10万多了"},{"from":182.2,"to":183.84,"content":"也是靠自己的努力发了财"},{"from":183.84,"to":186.78,"content":"如果你也需要一款方便好上手的记账软件"},{"from":186.78,"to":188.38,"content":"点击评论区置顶链接"},{"from":188.38,"to":189.7,"content":"赶快下载试试吧"},{"from":189.7,"to":193.06,"content":"其实觉醒记中的并不是什么神药"},{"from":193.06,"to":194.88,"content":"在今天它被称为"},{"from":200.88,"to":202.54,"content":"1926年圣诞节"},{"from":202.54,"to":203.74,"content":"裕仁天皇登基"},{"from":203.74,"to":204.74,"content":"年号昭和"},{"from":204.74,"to":206.46,"content":"从他的长相不难看出"},{"from":206.46,"to":207.44,"content":"不是唐中唐"},{"from":207.44,"to":208.34,"content":"就是理科王"},{"from":208.34,"to":210,"content":"作为一名顶级生物学家"},{"from":210,"to":211.72,"content":"他对生物战很感兴趣"},{"from":211.72,"to":213.82,"content":"用生物去进攻对手有点难度"},{"from":213.82,"to":216.6,"content":"但是如果把士兵变成无脑且疯狂的生物"},{"from":216.6,"to":218.38,"content":"只需要喂点"},{"from":218.38,"to":219.56,"content":"在育人的鼓动下"},{"from":219.56,"to":220.98,"content":"日本化学家和医生"},{"from":220.98,"to":223.52,"content":"就用研发新版药品"},{"from":223.52,"to":224.56,"content":"要便宜量大"},{"from":224.56,"to":226.26,"content":"能覆盖一线作战部队"},{"from":226.26,"to":228.8,"content":"又根据日本海军和陆军的需求不同"},{"from":228.8,"to":231.3,"content":"他们研发新药的功效也略有差异"},{"from":231.3,"to":234.74,"content":"当时的日本海军正在进行一项非常邪门的训练"},{"from":234.74,"to":235.24,"content":"科目"},{"from":235.24,"to":236.2,"content":"猫眼练习"},{"from":236.2,"to":238.42,"content":"他们吃下大量的鳗鱼和鱼肝油"},{"from":238.42,"to":239.64,"content":"恶补维生素A"},{"from":239.64,"to":240.86,"content":"苦练夜间实力"},{"from":240.86,"to":243.88,"content":"最离谱的是要让士兵在大白天对着太阳"},{"from":243.88,"to":245.74,"content":"还要把天上的星星找出来"},{"from":245.74,"to":247.02,"content":"海军军部声称"},{"from":247.02,"to":250.56,"content":"猫眼练习的终极目标是要能够用肉眼对抗雷达"},{"from":250.56,"to":251.06,"content":"军医"},{"from":251.06,"to":252.76,"content":"在江田岛海军兵学校"},{"from":252.76,"to":254.96,"content":"下发了一种叫做希洛本的新药"},{"from":254.96,"to":256.94,"content":"学生吃了之后兴奋地高呼"},{"from":256.94,"to":258.88,"content":"真的能看见太阳旁的星星了"},{"from":258.88,"to":261.399,"content":"海军就将这种新药命名为猫目锭"},{"from":261.399,"to":265.019,"content":"日本著名小说家丹羽文雄参加过太平洋战争"},{"from":265.019,"to":267.9,"content":"他的作品海战中描述了这种猫目神功"},{"from":267.9,"to":269.56,"content":"伸手不见五指的黑夜里"},{"from":269.56,"to":273.06,"content":"猫目瞭望员可以精准报告8km外的敌舰方位"},{"from":273.06,"to":274.74,"content":"有明确历史记载的是"},{"from":274.74,"to":276.4,"content":"1942年8月9日"},{"from":276.4,"to":277.2,"content":"瓜岛夜战"},{"from":277.2,"to":278.28,"content":"凌晨一点钟"},{"from":278.28,"to":280.4,"content":"三川军一将军手下的辽望员"},{"from":280.4,"to":282.62,"content":"率先发现了美国两艘驱逐舰"},{"from":282.62,"to":284.08,"content":"直到三四十分钟后"},{"from":284.08,"to":287.63,"content":"装配了三进雷达的美军帕特森号才发现了日军"},{"from":289.29,"to":292.29,"content":"海军头子山本56大将更是瘾君子"},{"from":292.29,"to":293.65,"content":"他是日本第一赌神"},{"from":293.65,"to":295.75,"content":"本来就需要巨大的脑力和算力"},{"from":295.75,"to":297.48,"content":"可他又频繁通过酒馆"},{"from":297.48,"to":299.72,"content":"在艺妓怀中透支了太多精力"},{"from":299.72,"to":301.72,"content":"就服用了一种突击定的药品"},{"from":301.72,"to":303.46,"content":"吃完之后还夸下豪言"},{"from":303.46,"to":305.22,"content":"如果天皇给我一年时间"},{"from":305.22,"to":307.8,"content":"我能在赌场为日本赢回一艘战列舰"},{"from":307.8,"to":310.2,"content":"他服用的突击锭是专供陆军的"},{"from":310.2,"to":311.96,"content":"和猫目锭的主要成分一样"},{"from":311.96,"to":314.04,"content":"唯一的区别是服用后的效果"},{"from":314.04,"to":316.08,"content":"海军吃了一生气就杀人"},{"from":316.08,"to":317.96,"content":"陆军吃了不杀人就生气"},{"from":317.96,"to":320,"content":"日本陆军曾在太行山行军"},{"from":320,"to":321.42,"content":"赶着骡子运机枪"},{"from":321.42,"to":322.52,"content":"每次想休息"},{"from":322.52,"to":324.48,"content":"长官就会喂他们一颗突击锭"},{"from":324.48,"to":326.04,"content":"吃完以后极度亢奋"},{"from":326.04,"to":327.5,"content":"一连走了四天四夜"},{"from":327.5,"to":328.94,"content":"体重也掉了十几斤"},{"from":328.94,"to":330.56,"content":"在太平洋战争爆发后"},{"from":330.56,"to":333.8,"content":"日本陆军嗑完药丢失士兵的借口也不找了"},{"from":333.8,"to":335.5,"content":"挥师南下强攻菲律宾"},{"from":335.5,"to":336.78,"content":"马来印尼和越南"},{"from":336.78,"to":338.9,"content":"不到半年就控制了东南亚"},{"from":338.9,"to":341.34,"content":"因此这种小药片又换了新包装"},{"from":341.34,"to":342.32,"content":"禁军之友"},{"from":342.32,"to":343.26,"content":"日本的盟友"},{"from":344.8,"to":346.1,"content":"科学家迈尔发现"},{"from":346.1,"to":348.38,"content":"有消除疲劳的作用后"},{"from":348.38,"to":349.58,"content":"就推荐给了军队"},{"from":349.58,"to":351.28,"content":"被德国人命名博菲丁"},{"from":351.28,"to":353.5,"content":"吃过的士兵都变成雅利安超人"},{"from":353.5,"to":355.72,"content":"不到六周就完成了环法拉力赛"},{"from":355.72,"to":357.56,"content":"士兵们还给他起了个绰号"},{"from":357.56,"to":358.64,"content":"坦克巧克力"},{"from":358.64,"to":361.74,"content":"德国庸医莫奈尔博士掌握了这款神药后"},{"from":361.74,"to":363.98,"content":"硬是把元首希特勒变成了希特勒"},{"from":363.98,"to":365.4,"content":"4年扎了800多针"},{"from":365.4,"to":366.89,"content":"彻底沦为帕金森"},{"from":366.89,"to":368.13,"content":"到了二战末期"},{"from":368.13,"to":370.09,"content":"日本的海外殖民地越来越少"},{"from":373.6,"to":376.4,"content":"能配发给士兵的突击锭也成了稀罕物"},{"from":376.4,"to":379.26,"content":"这些珍贵的突击锭被优先配备给海军"},{"from":379.26,"to":380.26,"content":"神风特工队"},{"from":380.26,"to":380.78,"content":"氪了后"},{"from":380.78,"to":382.42,"content":"就在太平洋变成了骨灰"},{"from":382.42,"to":384.72,"content":"海军舍不得把突击锭送给陆军"},{"from":384.72,"to":387.92,"content":"因为陆军执行特工命令时也只能喝送行酒"},{"from":387.92,"to":391.24,"content":"这才让万朵队的佐佐木有刺保持了最后的清醒"},{"from":391.24,"to":393.96,"content":"执行九次任务都想办法苟活了下来"},{"from":393.96,"to":397.42,"content":"这一时期有的国家已经开始研究无人驾驶飞机"},{"from":397.42,"to":399.98,"content":"而日本则开始研究有人驾驶炸弹"},{"from":399.98,"to":401.22,"content":"炸弹分为两种"},{"from":401.22,"to":403.16,"content":"空中飞的名为樱花飞机"},{"from":403.16,"to":405.02,"content":"大佐抓上几个昭和二百五"},{"from":405.02,"to":406.9,"content":"往嘴里塞上一颗突击锭"},{"from":406.9,"to":407.98,"content":"再灌一口清酒"},{"from":407.98,"to":410.22,"content":"他们就雄赳赳的去执行特工任务"},{"from":410.22,"to":411.78,"content":"由于操作过于拟人"},{"from":411.78,"to":413.76,"content":"还被美军戏称为八嘎炸弹"},{"from":413.76,"to":415.46,"content":"还有一种是在水里游的"},{"from":415.46,"to":416.74,"content":"名为回天鱼雷"},{"from":416.74,"to":418.8,"content":"仅需单程燃料和烈性炸药"},{"from":418.8,"to":420.81,"content":"外加一个磕了药的日本佬"},{"from":420.81,"to":422.27,"content":"到了1945年"},{"from":422.27,"to":424.49,"content":"更多日本底层牛马走向战场"},{"from":424.49,"to":425.55,"content":"他们不参军的话"},{"from":425.55,"to":427.17,"content":"经济状况就得出问题"},{"from":427.17,"to":428.45,"content":"但他们参了军的话"},{"from":428.45,"to":430.12,"content":"精神状况就得出问题"},{"from":430.12,"to":432.78,"content":"嗑了药的士兵们戒断反应越来越严重"},{"from":432.78,"to":434.02,"content":"许多人营养不良"},{"from":434.02,"to":434.78,"content":"两眼无神"},{"from":434.78,"to":437.06,"content":"还有人出现了幻觉和暴力倾向"},{"from":439.28,"to":441.34,"content":"士兵引发的并发症也越来越多"},{"from":441.34,"to":441.96,"content":"流鼻涕"},{"from":441.96,"to":442.58,"content":"流口水"},{"from":442.58,"to":443.42,"content":"肌肉酸痛"},{"from":443.42,"to":444.22,"content":"肠胃痉挛"},{"from":444.22,"to":445.24,"content":"打不了仗不说"},{"from":445.24,"to":447.1,"content":"还要在军医处消费资源"},{"from":449.88,"to":451.84,"content":"冲绳岛硫磺岛殊死一战"},{"from":451.84,"to":453.54,"content":"成功为日本招来了核弹"},{"from":457.5,"to":460.76,"content":"1945年8月30日下午"},{"from":460.76,"to":463.28,"content":"麦克阿瑟降临神奈川厚木机场"},{"from":463.28,"to":465.02,"content":"他的飞机起名巴丹号"},{"from":465.02,"to":468.32,"content":"寓意他曾在巴丹半岛被日军打的飙车逃跑"},{"from":468.32,"to":469.12,"content":"卷土重来"},{"from":469.12,"to":470.34,"content":"他已成日本领导"},{"from":470.34,"to":471.48,"content":"站在天皇身边"},{"from":471.48,"to":472.44,"content":"比他高出不少"},{"from":472.44,"to":475.08,"content":"麦克阿瑟并没有控制日本的问题"},{"from":475.08,"to":476.82,"content":"反正这些牛马与他无关"},{"from":476.82,"to":477.84,"content":"死的越多越好"},{"from":477.84,"to":480.66,"content":"他只要求国际社会不要惩罚天皇"},{"from":480.66,"to":483.66,"content":"声称昭和军人的疯狂行为是粉丝行为"},{"from":483.66,"to":485.32,"content":"不能上升到他们的偶像"},{"from":486.68,"to":489.46,"content":"他接受了战后遗留的巨量"},{"from":489.46,"to":490.84,"content":"将他们混在药品里"},{"from":490.84,"to":492.54,"content":"通通发放给了医药机关"},{"from":492.54,"to":494.02,"content":"再次包装成觉醒记"},{"from":494.02,"to":495.32,"content":"在各大药店出售"},{"from":495.32,"to":496.26,"content":"战后的日本"},{"from":496.26,"to":497.72,"content":"充满了悲观和挫败"},{"from":497.72,"to":500.9,"content":"沮丧的民众们在觉醒记中寻找暂时的安慰"},{"from":500.9,"to":503.9,"content":"作家和艺人更是成了觉醒记的重要客户"},{"from":503.9,"to":506.9,"content":"战后的日本人也依旧没能摆脱牛马的命运"},{"from":506.9,"to":509.12,"content":"他们继续在工厂里疯狂加班"},{"from":509.12,"to":510.88,"content":"后羿射不掉他们的工作日"},{"from":510.88,"to":512.7,"content":"女娲也补不了他们的星期天"},{"from":512.7,"to":513.86,"content":"在这样的内卷下"},{"from":513.86,"to":516.76,"content":"200多万工人加入了购买觉醒技的大军"},{"from":516.76,"to":517.82,"content":"1947年"},{"from":517.82,"to":520.5,"content":"日本的工程队曾在泰国竞标一个项目"},{"from":520.5,"to":522.68,"content":"报价竟比其他国家的成本都低"},{"from":522.68,"to":524.96,"content":"工期更是只需要其他国家的一半"},{"from":524.96,"to":526.26,"content":"泰国人在惊讶之余"},{"from":526.26,"to":529.14,"content":"眼睁睁的看着这帮日本人嗑下一粒觉醒剂"},{"from":529.14,"to":530.82,"content":"每天工作18个小时"},{"from":530.82,"to":533.26,"content":"三个月后干废了一批就再换一拨"},{"from":533.26,"to":534.94,"content":"日本人硬是完成了工作"},{"from":534.94,"to":535.92,"content":"同样的工作"},{"from":535.92,"to":538.67,"content":"日本人的工资不到美国人的1/30"},{"from":538.67,"to":541.17,"content":"裕仁天皇彻底被麦克阿瑟洗白"},{"from":541.17,"to":542.27,"content":"每天吃牛排"},{"from":542.27,"to":542.89,"content":"喝洋酒"},{"from":542.89,"to":543.55,"content":"坐豪车"},{"from":543.55,"to":546.32,"content":"批判是体验西方制度的劣根性育人"},{"from":546.32,"to":549.72,"content":"曾经的爪牙合法黑帮黑龙会被麦卡瑟取缔"},{"from":552.34,"to":553.86,"content":"这些人流入社会后"},{"from":553.86,"to":555.86,"content":"成了日本战后的初代黑社会"},{"from":555.86,"to":557.7,"content":"他们盯上了在日的美国大兵"},{"from":557.7,"to":559.62,"content":"以招聘女事务员为幌子"},{"from":559.62,"to":561.32,"content":"招募了6万名年轻女性"},{"from":561.32,"to":562.28,"content":"服务美国大兵"},{"from":562.28,"to":565.64,"content":"美国政府一次性发放娱乐费3500万美元"},{"from":565.64,"to":567.74,"content":"全部流入了日本黑社会的口袋"},{"from":567.74,"to":569.18,"content":"拿着这笔启动资金"},{"from":569.18,"to":571.92,"content":"黑帮将日本风俗业发展到了世界第一"},{"from":571.92,"to":573.68,"content":"更是重整觉醒技行业"},{"from":573.68,"to":574.62,"content":"哄抬价格"},{"from":574.62,"to":576.08,"content":"诱骗青少年购买"},{"from":576.08,"to":577.5,"content":"到了1949年时"},{"from":577.5,"to":579.68,"content":"觉醒技已经被黑帮卖到脱销"},{"from":579.68,"to":581.44,"content":"青少年甚至不惜偷抢"},{"from":581.44,"to":582.7,"content":"走上了犯罪道路"},{"from":582.7,"to":583.64,"content":"直到两年后"},{"from":583.64,"to":585.94,"content":"日本正式出台觉醒剂取缔法"},{"from":585.94,"to":588.24,"content":"禁止的生产和销售"},{"from":588.24,"to":590.42,"content":"同年日本还发生了一件大事"},{"from":593.28,"to":595.12,"content":"以平民的身份离开日本"},{"from":595.12,"to":597.46,"content":"却受到了上百万日本民众的挽留"},{"from":597.46,"to":599.64,"content":"日本朝日新闻这样描述报道"},{"from":599.64,"to":600.82,"content":"麦克阿瑟的解职"},{"from":600.82,"to":604.41,"content":"是日本自战争结束以来遇到的最大打击"},{"from":604.77,"to":605.73,"content":"事实证明"},{"from":605.73,"to":608.89,"content":"麦克阿瑟的离开对当时的日本的确是件坏事"},{"from":608.89,"to":609.95,"content":"没了他的威慑"},{"from":609.95,"to":612,"content":"日本黑帮开始了无限扩张"},{"from":612,"to":615.36,"content":"其中以山口组为首的黑帮经过腥风血雨的火拼"},{"from":615.36,"to":616.82,"content":"统一了觉醒技市场"},{"from":616.82,"to":618.4,"content":"日本帮会还有一个规矩"},{"from":618.4,"to":619.7,"content":"如果犯了重大错误"},{"from":619.7,"to":621,"content":"或是要金盆洗手"},{"from":621,"to":622.66,"content":"必须切下半截小拇指"},{"from":622.66,"to":623.56,"content":"代表决心"},{"from":623.56,"to":624.78,"content":"在切纸仪式前"},{"from":624.78,"to":626.92,"content":"他们就会用觉醒技振奋自己"},{"from":626.92,"to":628.44,"content":"还能起到镇痛效果"},{"from":628.44,"to":630.06,"content":"上世纪70年代中期"},{"from":630.06,"to":631.98,"content":"日本再次发挥毒王天赋"},{"from":635.08,"to":638,"content":"把从粉末变成了白色晶体"},{"from":638,"to":641.16,"content":"这种新毒品学名为盐酸盐"},{"from":641.16,"to":642.6,"content":"因为看起来像冰块"},{"from":642.6,"to":644.68,"content":"它还有一个更广为人知的名字"},{"from":644.68,"to":646.65,"content":"产品升级后"},{"from":646.65,"to":649.04,"content":"日本黑帮派人联络到一批韩国人"},{"from":649.04,"to":652.36,"content":"这些人在二战期间曾为日本军方制作觉醒记"},{"from":652.36,"to":653.4,"content":"他们一拍即合"},{"from":653.4,"to":656.08,"content":"在韩国建立了第一个扩散地"},{"from":656.08,"to":657.08,"content":"由日本研发"},{"from":657.08,"to":658.78,"content":"韩国生产的"},{"from":658.78,"to":660.44,"content":"就像一颗剧毒的蒲公英"},{"from":660.44,"to":661.6,"content":"跳到了世界各地"},{"from":661.6,"to":662.92,"content":"他也因制作简单"},{"from":662.92,"to":663.64,"content":"售价不高"},{"from":665.36,"to":667.12,"content":"因此扩张的更为迅速"},{"from":667.12,"to":670.22,"content":"尤其在金三角地区就有50家生产工厂"},{"from":670.22,"to":671.38,"content":"各种瘾君子中"},{"from":671.38,"to":673.56,"content":"其他都体的男女比例为八比二"},{"from":673.56,"to":675.32,"content":"但会刺激人的欲望"},{"from":675.32,"to":676.78,"content":"让人失去荣辱心"},{"from":676.78,"to":678.96,"content":"正好适合日本发达的风俗业"},{"from":678.96,"to":681.98,"content":"因此吸食的男女比例变成了五比五"},{"from":681.98,"to":684.8,"content":"也诞生出了一个恐怖的新职业冰妹"},{"from":684.8,"to":685.96,"content":"1989年"},{"from":685.96,"to":687.22,"content":"昭和天皇病逝"},{"from":687.22,"to":689.44,"content":"此时正值日本泡沫经济破裂"},{"from":689.44,"to":692.68,"content":"日本社会再次像一个瘾君子一样陷入了空虚"},{"from":692.68,"to":694.96,"content":"昔日的昭和男儿沦为平成废柴"},{"from":694.96,"to":697.58,"content":"再次依靠觉醒技填补内心的空虚"},{"from":700.96,"to":703.14,"content":"随着各类制作难度降低"},{"from":703.14,"to":705.36,"content":"日本的问题也变得更加严重"},{"from":705.36,"to":706.66,"content":"在东亚和东南亚"},{"from":706.66,"to":708.92,"content":"发现的461种新型中"},{"from":708.92,"to":711.34,"content":"发明地在日本的就有366种"},{"from":711.34,"to":712.42,"content":"日本的昭和时代"},{"from":712.42,"to":714.16,"content":"就像注入了一针觉醒剂"},{"from":714.16,"to":715.84,"content":"在战争时狂放迸发"},{"from":715.84,"to":717.82,"content":"药效过继后又疲软无力"},{"from":717.82,"to":719.2,"content":"再注入一针觉醒剂"},{"from":719.2,"to":720.88,"content":"它就能疯狂发展经济"},{"from":720.88,"to":722.52,"content":"声称完成了昭和奇迹"},{"from":722.52,"to":724.7,"content":"可到头来又是一场泡沫经济"},{"from":724.7,"to":726.04,"content":"智慧的人一旦偷懒"},{"from":726.04,"to":727.64,"content":"就害怕自己即将失败"},{"from":727.64,"to":729.22,"content":"但愚蠢的人一旦投机"},{"from":729.22,"to":730.76,"content":"就认为自己马上成功"},{"from":730.76,"to":732.54,"content":"他们把精力都放在投机上"},{"from":732.54,"to":733.68,"content":"以为一粒冰凉丸"},{"from":733.68,"to":734.42,"content":"一粒金丹"},{"from":734.42,"to":735.44,"content":"一颗突击锭"},{"from":735.44,"to":738.78,"content":"一记觉醒技就能让他们弯道超车走上捷径"},{"from":738.78,"to":740.24,"content":"可在弯道上开快车"},{"from":740.24,"to":741.16,"content":"不止会超车"},{"from":741.16,"to":742.08,"content":"还会翻车"},{"from":742.08,"to":744.04,"content":"这就是本期视频的全部内容了"},{"from":744.04,"to":744.72,"content":"点击关注"},{"from":744.72,"to":746.28,"content":"为你带来更多硬核故事"},{"from":746.28,"to":746.88,"content":"我是抬杠"},{"from":746.88,"to":748.2,"content":"我们下期再见"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:16:44.419Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:16:38.832Z"}}
