{"schemaVersion":1,"bvid":"BV1Xm421g7ED","cid":1629314960,"subtitles":[{"from":3.48,"to":6.13,"content":"这是一艘库兹涅佐夫号航空母舰"},{"from":6.13,"to":8.05,"content":"是目前俄罗斯唯一的航母"},{"from":8.05,"to":10.11,"content":"也是其吨位最大的水面舰艇"},{"from":10.11,"to":11.65,"content":"对于苏联海军来说"},{"from":11.65,"to":13.19,"content":"它具有里程碑的意义"},{"from":13.19,"to":16.19,"content":"库兹涅佐夫号是第一艘使用滑跃起飞"},{"from":16.19,"to":17.89,"content":"拦阻索降落配置的航母"},{"from":17.89,"to":20.49,"content":"在航母发展史上是不同于美国的"},{"from":20.49,"to":21.93,"content":"专属于苏联的路线"},{"from":21.93,"to":25.49,"content":"库兹涅佐夫号满载排水量67500吨左右"},{"from":25.49,"to":27.75,"content":"最多可以携带超过40架飞机"},{"from":27.75,"to":30.28,"content":"常规配置包括了18架苏三三"},{"from":30.28,"to":32.31,"content":"六架米格29K"},{"from":32.71,"to":34.85,"content":"两架卡二七反潜直升机"},{"from":34.85,"to":37.21,"content":"两架卡三一预警直升机"},{"from":37.21,"to":39.59,"content":"以及两架最新的武装直升机"},{"from":39.59,"to":42.4,"content":"卡52K和常规航母不同的是"},{"from":42.4,"to":45.36,"content":"库兹涅佐夫号上拥有很多驱逐舰和巡"},{"from":45.36,"to":46.79,"content":"洋舰上才会有的东西"},{"from":46.79,"to":48.05,"content":"火力很是恐怖"},{"from":48.05,"to":51.21,"content":"这其中包括了八套卡什坦近防系统"},{"from":51.21,"to":53.49,"content":"四座SAN9垂直发射系统"},{"from":53.49,"to":56.82,"content":"每座有六个发射单元用于发射防空导弹"},{"from":56.82,"to":60.22,"content":"还有六门AK6306管30mm舰炮"},{"from":60.22,"to":61.84,"content":"以及四套反潜系统"},{"from":61.84,"to":63.28,"content":"除去防御性武器外"},{"from":63.28,"to":66.58,"content":"库兹涅佐夫号上还搭载有12枚P700"},{"from":66.58,"to":67.94,"content":"花岗岩反舰导弹"},{"from":67.94,"to":70.4,"content":"这赋予了其远程打击舰艇的能力"},{"from":70.4,"to":73.72,"content":"听起来库兹涅佐夫号就像是一个缝合怪"},{"from":73.72,"to":74.78,"content":"什么都能干"},{"from":74.78,"to":75.78,"content":"一艘航母"},{"from":75.78,"to":77.24,"content":"堪比一个小型舰队"},{"from":77.24,"to":78.81,"content":"纸面实力感觉不错"},{"from":78.81,"to":81.41,"content":"可俄罗斯这艘航母与其说是航母"},{"from":81.41,"to":82.79,"content":"不如说是镇家之宝"},{"from":82.79,"to":84.05,"content":"服役30余年"},{"from":84.05,"to":87.83,"content":"一共只在地中海和大西洋进行了六次短期部署"},{"from":87.83,"to":90.25,"content":"每年平均出海时间只有15天"},{"from":90.25,"to":93.35,"content":"其余的大部分时间都停靠在摩尔曼斯克"},{"from":93.35,"to":94.75,"content":"或者在造船厂维修"},{"from":94.75,"to":95.83,"content":"事故频发"},{"from":95.83,"to":96.83,"content":"疾病缠身"},{"from":96.83,"to":99.2,"content":"是库兹涅佐夫号逃不掉的两个话题"},{"from":99.2,"to":102.36,"content":"那么这艘俄罗斯海军旗舰究竟都经历了什么"},{"from":102.36,"to":104.76,"content":"它的命运又是为何如此曲折"},{"from":104.76,"to":106.52,"content":"欢迎来到CHRIS的军事基地"},{"from":106.52,"to":108.08,"content":"聚焦各国军备鉴赏"},{"from":108.08,"to":110.96,"content":"今天我们来说说苏俄海军"},{"from":110.96,"to":113.26,"content":"库兹涅佐夫号航空母舰"},{"from":113.26,"to":114.32,"content":"不"},{"from":116.38,"to":119.33,"content":"上世纪60年代古巴导弹危机期间"},{"from":119.33,"to":122.17,"content":"为了应对苏联在古巴部署远程弹道导弹"},{"from":122.17,"to":124.31,"content":"美国出动了68个空军中队"},{"from":124.31,"to":125.67,"content":"以及八艘航空母舰"},{"from":125.67,"to":127.12,"content":"总计90艘军舰"},{"from":127.12,"to":129.329,"content":"将整个古巴海域完全封锁"},{"from":129.329,"to":130.629,"content":"随着时间的流逝"},{"from":130.629,"to":132.849,"content":"苏联意识到封锁拖得越久"},{"from":132.849,"to":134.769,"content":"苏联的损失比美国就越大"},{"from":134.769,"to":137.68,"content":"最终赫鲁晓夫同意了将导弹撤出古巴"},{"from":137.68,"to":140.26,"content":"相应的美国人也从土耳其撤军"},{"from":140.26,"to":142.86,"content":"虽然说这次危机没有什么胜负之分"},{"from":142.86,"to":146.28,"content":"但美国人的强力封锁还是让苏联深刻意识到了"},{"from":146.28,"to":148.7,"content":"拥有一支庞大的航母舰队的重要性"},{"from":148.7,"to":152.68,"content":"于是在苏联首款直升机航母莫斯科即问世后"},{"from":154.14,"to":155.84,"content":"可以搭载固定翼飞机的航母"},{"from":155.84,"to":157.16,"content":"也就是基辅级"},{"from":157.16,"to":159.04,"content":"基辅级是世界上第一款"},{"from":159.04,"to":160.64,"content":"搭载垂直起降飞机的航母"},{"from":162.49,"to":165.21,"content":"因为基辅级还不算是真正意义上的航母"},{"from":165.21,"to":167.29,"content":"并不能起飞常规作战的飞机"},{"from":167.29,"to":168.45,"content":"1973年"},{"from":168.45,"to":171.14,"content":"苏联军方提出了建造核动力航母的方案"},{"from":171.14,"to":173,"content":"设计排水量85000吨"},{"from":173,"to":176.16,"content":"配备有蒸汽弹射器以及拦阻索回收的组合"},{"from":176.16,"to":178.519,"content":"最多可携带超过65架飞机"},{"from":178.519,"to":180.979,"content":"基本上就和美军的航母是同一路线"},{"from":180.979,"to":182.419,"content":"可理想是丰满的"},{"from":182.419,"to":183.6,"content":"现实是骨感的"},{"from":186.72,"to":188.07,"content":"预算高的吓人"},{"from":188.07,"to":190.07,"content":"不光是航母本身的建造费用"},{"from":190.07,"to":192.85,"content":"还有建造造船厂和相关设施的费用"},{"from":192.85,"to":195.19,"content":"最终该方案进行了重新设计"},{"from":195.19,"to":196.75,"content":"变为常规动力舰艇"},{"from":196.75,"to":198.15,"content":"整体尺寸也变小"},{"from":198.15,"to":199.49,"content":"放弃了蒸汽弹射"},{"from":199.49,"to":200.93,"content":"改用滑跃起飞"},{"from":200.93,"to":203.93,"content":"相比于弹射器滑跃起飞的优点在于"},{"from":203.93,"to":205.57,"content":"其不用担心发生机械故障"},{"from":205.57,"to":206.87,"content":"只要飞机没问题"},{"from":206.87,"to":207.86,"content":"那就能飞"},{"from":207.86,"to":210.98,"content":"但相应的飞机起飞的最大重量就要低不少"},{"from":210.98,"to":212.14,"content":"也不能搭载固定翼"},{"from":212.14,"to":212.82,"content":"预警机"},{"from":212.82,"to":214.26,"content":"只能用直升机代替"},{"from":214.26,"to":216.22,"content":"预警范围也要小不少"},{"from":216.22,"to":217.829,"content":"确立了大体的方案后"},{"from":217.829,"to":219.589,"content":"苏霍伊和米高扬设计局"},{"from":219.589,"to":222.689,"content":"开始着手改造他们的米格二九和苏二七"},{"from":222.689,"to":224.51,"content":"以适应航母使用的需求"},{"from":224.51,"to":226.79,"content":"为了承受航母降落时的猛烈冲击"},{"from":226.79,"to":229.35,"content":"起落架以及机身结构得到了加强"},{"from":229.35,"to":230.51,"content":"机翼面积增大"},{"from":230.51,"to":231.55,"content":"以提高升力"},{"from":231.55,"to":233.23,"content":"并改为了可折叠设计"},{"from":233.23,"to":235.01,"content":"从而最大程度节省空间"},{"from":235.01,"to":237.29,"content":"改装后的两架飞机被命名为"},{"from":237.29,"to":239.93,"content":"苏27K和米格29K"},{"from":241.16,"to":242.26,"content":"在设计阶段"},{"from":242.26,"to":245.14,"content":"最新的苏联重型航母被命名为苏联号"},{"from":245.14,"to":247.22,"content":"但当船体龙骨开始铺设时"},{"from":247.22,"to":248.48,"content":"更名为李佳号"},{"from":248.48,"to":249.56,"content":"1982年"},{"from":249.56,"to":251.02,"content":"勃列日涅夫去世后"},{"from":251.02,"to":252.02,"content":"为了纪念他"},{"from":252.02,"to":253.89,"content":"又更名为勃列日涅夫号"},{"from":253.89,"to":256.73,"content":"航母下水后又改名为第比利斯号"},{"from":256.73,"to":258.77,"content":"然而苏联解体前夕"},{"from":258.77,"to":260.69,"content":"第比利斯公开反对苏联"},{"from":260.69,"to":262.91,"content":"苏联海军不希望他们的主力舰艇"},{"from":262.91,"to":264.81,"content":"以反对苏联的城市命名"},{"from":264.81,"to":266.19,"content":"1990年9月"},{"from":266.19,"to":269.41,"content":"他们又将帝比利斯号改名为库切佐夫号"},{"from":269.41,"to":271.33,"content":"频繁改名可不是件好事"},{"from":271.33,"to":275.13,"content":"在海军迷信清单里带香蕉上船会带来霉运"},{"from":275.13,"to":276.81,"content":"登船前看到红发女郎"},{"from":276.81,"to":278.09,"content":"那真是太倒霉了"},{"from":278.09,"to":279.69,"content":"可如果更改船的名字"},{"from":279.69,"to":280.93,"content":"还改了这么多次"},{"from":280.93,"to":282.31,"content":"那就是没上加眉"},{"from":282.31,"to":283.35,"content":"霉到不行"},{"from":283.35,"to":285.63,"content":"在库建所符号之后的服役生涯里"},{"from":285.63,"to":288.289,"content":"基本上可以说是霉运不断了"},{"from":288.689,"to":291.309,"content":"首先当航母准备开始服役时"},{"from":291.309,"to":294.049,"content":"苏联海军还没有准备好运营这样一艘船"},{"from":294.049,"to":296.229,"content":"几乎没有任何相应的配套设施"},{"from":296.229,"to":297.589,"content":"没有舰载机部队"},{"from":297.589,"to":298.749,"content":"没有航母编队"},{"from":298.749,"to":300.069,"content":"没有空中管制组"},{"from":300.069,"to":301.84,"content":"航母根本无法正常运行"},{"from":301.84,"to":304.38,"content":"甚至连第一任舰长维克多亚里金"},{"from":304.38,"to":305.84,"content":"也向苏联媒体表示"},{"from":305.84,"to":308.39,"content":"苏联海军并没有准备好迎接这样一艘船"},{"from":308.39,"to":310.85,"content":"在库舰于1991年1月服役时"},{"from":310.85,"to":312.43,"content":"航母没有任何战斗力"},{"from":312.43,"to":314.79,"content":"两年内都没有接收一架舰载机"},{"from":314.79,"to":316.5,"content":"只是个漂浮的空壳子"},{"from":316.5,"to":318.4,"content":"然而服役还没几天"},{"from":318.4,"to":319.4,"content":"家就没了"},{"from":319.4,"to":321.18,"content":"1991年的8月24日"},{"from":322.42,"to":323.659,"content":"从苏联脱离"},{"from":323.659,"to":325.779,"content":"可由于大多数军官都亲俄罗斯"},{"from":325.779,"to":327.879,"content":"因此乌克兰和俄罗斯"},{"from":327.879,"to":331.15,"content":"在如何处理黑海舰队的问题上开始出现争执"},{"from":331.15,"to":333.679,"content":"他们都想获取库兹涅佐夫号的控制权"},{"from":333.679,"to":335.559,"content":"乌克兰总统列昂尼德宣布"},{"from":335.559,"to":337.399,"content":"库切佐夫号是乌克兰财产"},{"from":337.399,"to":339.51,"content":"并要求该舰继续停留在乌克兰"},{"from":339.51,"to":340.77,"content":"等待进一步命令"},{"from":340.77,"to":342.09,"content":"这并不是没有道理"},{"from":342.09,"to":343.63,"content":"毕竟库界生于乌克兰"},{"from":343.63,"to":344.69,"content":"长于乌克兰"},{"from":344.69,"to":346.33,"content":"但舰长维克多并不同意"},{"from":346.33,"to":348.73,"content":"他认为乌克兰尚未举行公投"},{"from":348.73,"to":350.5,"content":"还不能作为一个国家存在"},{"from":350.5,"to":352.88,"content":"于是1991年12月1日"},{"from":352.88,"to":355.5,"content":"就当90%的乌克兰人都忙着投票"},{"from":355.5,"to":356.48,"content":"支持独立时"},{"from":356.48,"to":359.92,"content":"库涅佐夫号接到了来自俄罗斯北方舰队的命令"},{"from":359.92,"to":360.96,"content":"离开黑海"},{"from":360.96,"to":362.32,"content":"前往摩尔曼斯克"},{"from":362.32,"to":364.22,"content":"1/3的船员跟随航母"},{"from":364.22,"to":365.72,"content":"其余的则留在了乌克兰"},{"from":365.72,"to":367,"content":"严格意义来说"},{"from":367,"to":369.04,"content":"库切佐夫号并不是航母"},{"from":369.04,"to":371.05,"content":"至少俄罗斯人不能称之是航母"},{"from":371.05,"to":373.95,"content":"他们称库兹涅佐夫号为舰载机巡洋舰"},{"from":373.95,"to":375.59,"content":"因为根据蒙特勒公约"},{"from":375.59,"to":377.67,"content":"排水量超过15000吨的航母"},{"from":377.67,"to":379.73,"content":"是不允许穿过土耳其海峡的"},{"from":379.73,"to":382.23,"content":"所以为了让库建佐夫号能够离开黑海"},{"from":382.23,"to":385.45,"content":"他的称呼必须要和航母划清界限"},{"from":386.35,"to":388.41,"content":"在被编入俄罗斯的北方舰队后"},{"from":388.41,"to":392.29,"content":"库涅佐夫号于1993年接受了其舰载机联队"},{"from":392.29,"to":394.05,"content":"库舰一共有两部升降机"},{"from":394.05,"to":395.44,"content":"都位于甲板右侧"},{"from":395.44,"to":397.18,"content":"舰载机有三个起飞位置"},{"from":397.18,"to":399.38,"content":"分别位于甲板前四后中间"},{"from":399.38,"to":401.18,"content":"3号位的起飞距离最远"},{"from":401.18,"to":403.06,"content":"专门用于起飞加重的飞机"},{"from":403.06,"to":404.56,"content":"和美军航母不同的是"},{"from":404.56,"to":406.24,"content":"由于其滑跃甲板的设计"},{"from":406.24,"to":408,"content":"一次只能起飞一架飞机"},{"from":408,"to":409.04,"content":"那说到飞机"},{"from":409.04,"to":413.42,"content":"就不得不说经常开战斗机的兄弟们肯定都知道"},{"from":413.42,"to":414.62,"content":"开久了很累的"},{"from":414.62,"to":417.32,"content":"尤其是夏天汗流浃背是常有的事"},{"from":417.32,"to":419.65,"content":"还好我有这款赫恩冷水沐浴露"},{"from":419.65,"to":420.83,"content":"10年老国货"},{"from":420.83,"to":422.27,"content":"还是运动冠军同款"},{"from":422.27,"to":424.01,"content":"难怪某宝卖爆了70万"},{"from":424.01,"to":425.72,"content":"加夏日冰爽配方"},{"from":425.72,"to":427.04,"content":"主打一个透心凉"},{"from":427.04,"to":429.54,"content":"里面加了冰川水加清凉薄荷"},{"from":429.54,"to":431.47,"content":"像是给身体套了个降温Buff"},{"from":431.47,"to":434.45,"content":"这款沐浴露还做了28天真人祛痘测试"},{"from":434.45,"to":436.03,"content":"拥有控油祛痘"},{"from":436.03,"to":439.2,"content":"温和舒缓保湿五大功效报告"},{"from":439.2,"to":440.74,"content":"战斗力比毛子还猛"},{"from":440.74,"to":442.56,"content":"被痘尘螨都能给你洗掉"},{"from":442.56,"to":444.919,"content":"氨基酸加PG清洁体系"},{"from":444.919,"to":447.119,"content":"挤一泵就能打出好多泡沫"},{"from":447.119,"to":448.479,"content":"洗的干净还舒服"},{"from":448.479,"to":449.879,"content":"味道还是好闻的"},{"from":449.879,"to":452.33,"content":"撩妹香妹子一闻就走不动道"},{"from":452.33,"to":454.96,"content":"500克大容量一瓶能用大半年"},{"from":454.96,"to":455.56,"content":"对了"},{"from":455.56,"to":457.76,"content":"他家还出了冠军同款礼盒套装"},{"from":457.76,"to":459.46,"content":"洗头洗脸都给你配齐了"},{"from":459.46,"to":461.22,"content":"评论区领我的专属大额券"},{"from":461.22,"to":463.409,"content":"一套买更划算"},{"from":463.809,"to":466.69,"content":"那下面我们来说说固件的出海经历"},{"from":466.69,"to":469.83,"content":"库舰所夫号的首次任务发生于1995年"},{"from":469.83,"to":471.49,"content":"其被部署到地中海区域"},{"from":471.49,"to":472.97,"content":"持续了三个月左右"},{"from":472.97,"to":475.63,"content":"主要任务是负责展示俄罗斯海军旗舰"},{"from":475.63,"to":477.75,"content":"并进行一些舰载机起降训练"},{"from":477.75,"to":479.73,"content":"然而在其首次部署中"},{"from":479.73,"to":481.27,"content":"却发生了许多小插曲"},{"from":481.27,"to":482.63,"content":"最著名的就是"},{"from":482.63,"to":485.09,"content":"航母上的海水蒸馏器突然出现故障"},{"from":485.09,"to":488.09,"content":"导致2000多名船员每天都得抢水用"},{"from":488.09,"to":489.91,"content":"一天只提供20分钟用水"},{"from":489.91,"to":490.97,"content":"早上10分钟"},{"from":490.97,"to":492.05,"content":"晚上10分钟"},{"from":492.05,"to":493.52,"content":"水资源相当紧张"},{"from":493.52,"to":496.6,"content":"据说美国海军甚至都一度准备提供淡水"},{"from":496.6,"to":499.539,"content":"来帮助库切索夫号首次部署结束后"},{"from":499.539,"to":500.939,"content":"库舰便返厂大修"},{"from":500.939,"to":502.839,"content":"这一修就修了4年"},{"from":502.839,"to":505.339,"content":"直到2000年才准备再次部署"},{"from":505.339,"to":507.06,"content":"但2000年8月12日"},{"from":507.06,"to":510.44,"content":"俄罗斯库尔斯克号核潜艇在巴伦支海沉没"},{"from":510.44,"to":512.34,"content":"艇上118人全部遇难"},{"from":512.34,"to":515.4,"content":"这一事件推迟了库建索夫号的第二次部署"},{"from":515.4,"to":517.08,"content":"这一等就是7年"},{"from":517.08,"to":518.54,"content":"直到2007年底"},{"from":518.54,"to":519.8,"content":"时隔12年"},{"from":519.8,"to":523.109,"content":"库兹涅佐夫号前往地中海区域执行第二次部署"},{"from":523.109,"to":525.049,"content":"这次任务总体来说还算顺利"},{"from":525.049,"to":526.369,"content":"没有什么小插曲"},{"from":526.369,"to":528.569,"content":"一年后迎来了第三次部署"},{"from":528.569,"to":529.95,"content":"还是在地中海区域"},{"from":529.95,"to":532.27,"content":"但这次部署却没有那么顺利了"},{"from":532.27,"to":533.97,"content":"2009年1月7日"},{"from":533.97,"to":536.91,"content":"停泊在土耳其附近的库涅佐夫发生火灾"},{"from":536.91,"to":538.33,"content":"火灾由短路引起"},{"from":538.33,"to":540.61,"content":"导致一名船员一氧化碳中毒死亡"},{"from":540.61,"to":541.57,"content":"一个月后"},{"from":541.57,"to":543.16,"content":"在返回本土的途中"},{"from":543.16,"to":545.16,"content":"库建在爱尔兰南部加油时"},{"from":545.16,"to":547.13,"content":"又发生了大规模漏油事件"},{"from":547.13,"to":548.15,"content":"两年半后"},{"from":548.15,"to":550.21,"content":"2011年第四次部署"},{"from":550.21,"to":552.33,"content":"库建佐夫号前往大西洋区域"},{"from":552.33,"to":555.16,"content":"这次部署的小插曲被推进系统故障"},{"from":555.16,"to":556.82,"content":"库界所负号推进系统"},{"from":556.82,"to":559.9,"content":"由八个增压锅炉和四台蒸汽轮机组成"},{"from":559.9,"to":561.76,"content":"这些机械系统磨损严重"},{"from":561.76,"to":562.8,"content":"可靠性一般"},{"from":562.8,"to":563.92,"content":"经常出问题"},{"from":563.92,"to":566.13,"content":"导致航母在大洋中间失去动力"},{"from":566.13,"to":568.47,"content":"尽管推进系统可以在海上完成修理"},{"from":568.47,"to":570.67,"content":"但有时也不得不呼叫拖船"},{"from":570.67,"to":571.97,"content":"在这次部署中"},{"from":571.97,"to":574.02,"content":"库舰在返航时失去推进力"},{"from":574.02,"to":576.06,"content":"只能呼叫拖船将该舰拖回"},{"from":576.06,"to":577.2,"content":"这次任务后"},{"from":577.2,"to":579.04,"content":"库涅佐夫号但凡出远门"},{"from":579.04,"to":580.579,"content":"拖船都是必备选项"},{"from":580.579,"to":581.799,"content":"但这就很奇怪"},{"from":581.799,"to":584.039,"content":"因为库舰出海时间寥寥无几"},{"from":584.039,"to":585.86,"content":"锅炉怎么会过度使用呢"},{"from":585.86,"to":588.74,"content":"这是因为苏联最初在制造库建所符号时"},{"from":588.74,"to":591.95,"content":"大部分资金都分配给了船舶开发和制造"},{"from":591.95,"to":594.99,"content":"只有很小一部分资金用于船只的日常维护"},{"from":594.99,"to":597.43,"content":"这导致相关的支持设施严重不足"},{"from":597.43,"to":600.29,"content":"唯一能给库涅佐夫号提供完善补给的地方"},{"from":600.29,"to":601.45,"content":"就是它的建造地"},{"from":601.45,"to":603.85,"content":"也就是乌克兰的尼古拉耶夫造船厂"},{"from":603.85,"to":606.4,"content":"这是苏联时期唯一能造航母的地方"},{"from":606.4,"to":608.58,"content":"而俄罗斯并没有相关的配套支持"},{"from":608.58,"to":610.64,"content":"这导致库兹佐夫号靠岸时"},{"from":610.64,"to":613.16,"content":"还得依靠自己的锅炉提供电力和热水"},{"from":613.16,"to":614.1,"content":"对比之下"},{"from":614.1,"to":616.4,"content":"当尼米兹级停留在其永久港口时"},{"from":616.4,"to":618.14,"content":"会提供全面的岸上服务"},{"from":618.14,"to":619.86,"content":"包括了供电供水"},{"from":619.86,"to":622.12,"content":"航母上的核反应堆则会关闭"},{"from":622.12,"to":624.84,"content":"由于库建索夫号大部分时间都在岸边度过"},{"from":624.84,"to":627.08,"content":"船上涉税的使用寿命都花在了"},{"from":627.08,"to":628.42,"content":"给船员提供服务上"},{"from":628.42,"to":630.14,"content":"导致其锅炉过早损坏"},{"from":630.14,"to":630.94,"content":"据报道"},{"from":630.94,"to":634.62,"content":"他的八台KVG4锅炉中的四台因为磨损严重"},{"from":634.62,"to":636.54,"content":"在中期改装时都要更换"},{"from":636.54,"to":639.26,"content":"但推进系统和其他机械系统的故障"},{"from":639.26,"to":641.359,"content":"并不是固定锁符号唯一的问题"},{"from":641.359,"to":643.059,"content":"由于其维护工作不到位"},{"from":643.059,"to":645.89,"content":"航母上的绝大多数设备都有故障情况"},{"from":645.89,"to":647.69,"content":"虽然说库舰小毛病不断"},{"from":647.69,"to":648.73,"content":"故障频发"},{"from":648.73,"to":650.29,"content":"但对武器最好的检验"},{"from":650.29,"to":652.38,"content":"莫过于来一场真刀真枪的实战"},{"from":652.38,"to":653.5,"content":"2013年"},{"from":653.5,"to":656.12,"content":"在库建所符号完成第五次常规部署后"},{"from":656.12,"to":658.95,"content":"终于要迎来最大的考验了"},{"from":659.27,"to":661.07,"content":"2016年10月15日"},{"from":661.07,"to":663.93,"content":"为了支持叙利亚政府军打击反叛力量"},{"from":663.93,"to":664.91,"content":"库兹涅佐夫号"},{"from":664.91,"to":667.21,"content":"从摩尔曼斯克的北方舰队基地出发"},{"from":667.21,"to":670.25,"content":"随行的还有其他七艘俄罗斯海军舰艇"},{"from":670.25,"to":671.85,"content":"包括了核动力巡洋舰"},{"from":671.85,"to":674.69,"content":"彼得大帝号和两艘无畏级驱逐舰"},{"from":674.69,"to":676.39,"content":"由于潜在的推进器故障"},{"from":676.39,"to":678.65,"content":"一艘远洋拖船作为预防措施"},{"from":678.65,"to":679.69,"content":"陪伴了这艘航母"},{"from":679.69,"to":682.95,"content":"这是俄罗斯自冷战以来最大规模的军事部署"},{"from":682.95,"to":683.93,"content":"据俄媒报道"},{"from":683.93,"to":685.05,"content":"在部署期间"},{"from":685.05,"to":686.19,"content":"库舰多次出动"},{"from":686.19,"to":689.15,"content":"苏三三轰炸叙利亚境内的恐怖组织阵地"},{"from":689.15,"to":691.21,"content":"总计执行了420次作战任务"},{"from":691.21,"to":693.44,"content":"击中了超过1200个敌军目标"},{"from":693.44,"to":694.52,"content":"说完了战果"},{"from":694.52,"to":696.42,"content":"该说说这次部署的小插曲了"},{"from":696.42,"to":698.68,"content":"首先在叙利亚部署期间"},{"from":698.68,"to":701.5,"content":"库兹涅佐夫号的黑烟引来了不小的关注"},{"from":701.5,"to":702.48,"content":"目前来看"},{"from":702.48,"to":705.23,"content":"最有可能的原因是库舰的燃料问题"},{"from":705.23,"to":708.39,"content":"不同于其他使用燃气轮机和核动力的军舰"},{"from":708.39,"to":709.59,"content":"库兹佐夫号"},{"from":709.59,"to":712.49,"content":"是一艘使用重油作为燃料的常规动力舰艇"},{"from":712.49,"to":714.33,"content":"重油相对来说物美价廉"},{"from":714.33,"to":715.29,"content":"量大管饱"},{"from":715.29,"to":717.13,"content":"但其使用起来很是麻烦"},{"from":717.13,"to":719.49,"content":"必须使用复杂的锅炉和管道系统"},{"from":719.49,"to":721.319,"content":"对燃料进行预热和加压"},{"from":721.319,"to":724.259,"content":"如果发动机启动前未能充分预热燃料"},{"from":724.259,"to":725.919,"content":"就会导致其燃烧不充分"},{"from":725.919,"to":728.23,"content":"最终产生漫长的黑烟轨迹"},{"from":728.23,"to":730.53,"content":"产生的黑烟不光容易暴露自身"},{"from":730.53,"to":732.77,"content":"还会引发船上水手的健康问题"},{"from":732.77,"to":735.15,"content":"其次就是航母上的拦阻索故障"},{"from":735.15,"to":738.19,"content":"这导致两架战斗机在尝试降落时坠毁"},{"from":738.19,"to":740.18,"content":"2016年11月14日"},{"from":740.18,"to":742.5,"content":"三架飞机从库兹佐夫号上起飞"},{"from":742.5,"to":744.14,"content":"其中两架成功回收"},{"from":744.14,"to":747.43,"content":"但第二架飞机降落时损坏了两根拦阻索"},{"from":747.43,"to":750.49,"content":"这导致第三架米格29K只能在空中盘旋"},{"from":750.49,"to":752.99,"content":"等待拦阻索修复一个小时后"},{"from":752.99,"to":753.95,"content":"燃料耗尽"},{"from":753.95,"to":755.339,"content":"飞行员只能弹射"},{"from":755.339,"to":756.219,"content":"两周后"},{"from":756.219,"to":757.319,"content":"12月3日"},{"from":757.319,"to":758.999,"content":"一架苏33在降落时"},{"from":758.999,"to":760.579,"content":"拦阻索再次被冲断"},{"from":760.579,"to":762.04,"content":"导致其滑出甲板"},{"from":762.04,"to":762.86,"content":"幸运的是"},{"from":762.86,"to":764.18,"content":"飞行员成功弹射"},{"from":764.18,"to":765.18,"content":"保住了小命"},{"from":765.18,"to":766.97,"content":"在经历了如此多的事故后"},{"from":766.97,"to":769.37,"content":"俄罗斯终于准备对库舰来一个"},{"from":769.37,"to":770.99,"content":"全方位的大修和改造了"},{"from":770.99,"to":774.81,"content":"可谁知库舰连维修都能发生事故"},{"from":776.119,"to":777.199,"content":"2017年"},{"from":777.199,"to":778.819,"content":"为了延长其使用寿命"},{"from":778.819,"to":782.15,"content":"库切佐夫号返回摩尔曼斯克进行中期改装"},{"from":782.15,"to":783.49,"content":"作为改装的一部分"},{"from":783.49,"to":785.92,"content":"他必须要在干船坞里待上一段时间"},{"from":785.92,"to":789.22,"content":"而俄罗斯北部唯一可用的就是pd50"},{"from":789.22,"to":790.42,"content":"浮动干船坞"},{"from":790.42,"to":792.36,"content":"但2018年10月30日"},{"from":792.36,"to":794.34,"content":"船坞失去了岸上电力供给"},{"from":794.34,"to":795.92,"content":"水泵随即停止工作"},{"from":795.92,"to":797.8,"content":"压载水舱里的水越来越多"},{"from":797.8,"to":800.88,"content":"这导致船坞慢慢倾斜并逐渐下沉"},{"from":800.88,"to":803.579,"content":"结果一台70吨重的起重机倒塌"},{"from":803.579,"to":805.599,"content":"并狠狠地砸在了航母甲板上"},{"from":805.599,"to":808.79,"content":"硬生生在甲板上开了一个19平方米大小的洞"},{"from":808.79,"to":810.93,"content":"如果pd50有应急发电机的话"},{"from":810.93,"to":812.91,"content":"船坞的沉没本来是可以避免的"},{"from":812.91,"to":814.089,"content":"但有趣的是"},{"from":814.089,"to":816.369,"content":"其实它是有备用的柴油发电机的"},{"from":816.369,"to":818.81,"content":"只是这些发电机从来没有添加过燃料"},{"from":818.81,"to":822.43,"content":"这种事在库舰上发生已经是见怪不怪了"},{"from":825.71,"to":828.599,"content":"并被指控从维修资金里窃取了65万美元"},{"from":828.599,"to":829.599,"content":"这还没完"},{"from":829.599,"to":831.159,"content":"2019年12月"},{"from":831.159,"to":833.379,"content":"正在维修的库建发生的火灾事故"},{"from":833.379,"to":834.559,"content":"导致一人死亡"},{"from":834.559,"to":835.639,"content":"12人受伤"},{"from":835.639,"to":838,"content":"又损失了800万美元左右"},{"from":838.88,"to":840.15,"content":"服役30余年"},{"from":840.15,"to":842.83,"content":"库兹涅佐夫号对于俄罗斯海军来说"},{"from":842.83,"to":844.17,"content":"更多的是象征意义"},{"from":844.17,"to":845.67,"content":"而不是实际的战斗力量"},{"from":845.67,"to":848.26,"content":"毕竟30年里一共没出门几次"},{"from":848.26,"to":849.28,"content":"虽然这么说"},{"from":849.28,"to":852.52,"content":"但维护和保留库兹佐夫号还是相当重要的"},{"from":852.52,"to":854.66,"content":"对于俄罗斯这样的海上强国来说"},{"from":854.66,"to":855.84,"content":"航母可以不行"},{"from":855.84,"to":857.18,"content":"但万万不能没有"},{"from":857.18,"to":858.8,"content":"这是国家力量的象征"},{"from":858.8,"to":860.66,"content":"毕竟没有几个国家拥有"},{"from":860.66,"to":862.42,"content":"能搭载固定翼舰载机的航母"},{"from":862.42,"to":863.16,"content":"再说"},{"from":863.16,"to":865.2,"content":"如果俄罗斯放弃库森索夫号"},{"from":865.2,"to":867.32,"content":"整个五常里就你没航母"},{"from":867.32,"to":870.46,"content":"相信对于俄罗斯人来说也是万万不可接受的"},{"from":870.46,"to":871.5,"content":"目前来看"},{"from":871.5,"to":873.569,"content":"库建已完成基本的修理工作"},{"from":873.569,"to":875.209,"content":"有望年底重返服役"},{"from":875.209,"to":876.749,"content":"据俄罗斯海军所说"},{"from":876.749,"to":880.02,"content":"他们期望库舰至少还能服役25年以上"},{"from":880.02,"to":881.88,"content":"至于库建能不能逆天改命"},{"from":881.88,"to":882.84,"content":"不再倒霉"},{"from":882.84,"to":884.62,"content":"那就得看他以后的发挥了"},{"from":884.62,"to":885.28,"content":"OK了"},{"from":885.28,"to":887.16,"content":"那以上就是本期视频的全部内容了"},{"from":887.16,"to":888.38,"content":"如果觉得还不错的话"},{"from":888.38,"to":889.7,"content":"别忘了多多三连哦"},{"from":889.7,"to":892.06,"content":"还想看什么军备打在评论区告诉我"},{"from":892.06,"to":893.14,"content":"我们一一安排"},{"from":893.14,"to":895.26,"content":"那我们下期视频再见"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:33:05.722Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:33:01.037Z"}}
