{"schemaVersion":1,"bvid":"BV1V3QJBMEPP","cid":37524604453,"subtitles":[{"from":0.04,"to":2.81,"content":"性能过剩是科技史上的经典辩题"},{"from":2.81,"to":3.73,"content":"2000年"},{"from":3.73,"to":5.63,"content":"AMD和英特尔开打频率战争"},{"from":5.63,"to":8.4,"content":"相继发布了主频超过1G赫兹的芯片"},{"from":8.4,"to":10.2,"content":"当年的数码宝贝们锐评"},{"from":10.2,"to":14.09,"content":"这不就是花上千美元买了一根高价电炉丝吗"},{"from":14.09,"to":15.37,"content":"乔布斯表示同意"},{"from":15.37,"to":17.52,"content":"并在发布会上开了嘲讽"},{"from":17.52,"to":18.64,"content":"2013年"},{"from":18.64,"to":22.34,"content":"联发科和三星相继推出了给手机用的八核芯片"},{"from":22.34,"to":25.54,"content":"彼时坚守四核的高通睿频八核处理器"},{"from":25.54,"to":27.74,"content":"就是把八台割草机引擎放在一起"},{"from":27.74,"to":29.67,"content":"假装这是八缸法拉利"},{"from":29.67,"to":32.23,"content":"诚然乔布斯和高通都是对的"},{"from":32.23,"to":34.29,"content":"因为在2001年的Mac上打字"},{"from":34.29,"to":34.83,"content":"发邮件"},{"from":34.83,"to":35.56,"content":"看网页"},{"from":35.56,"to":37.52,"content":"在2013年的手机上玩神庙"},{"from":37.52,"to":41.01,"content":"逃亡和愤怒的小鸟确实用不上这么强的芯片"},{"from":41.01,"to":43.87,"content":"如今同样的剧本又在车圈上演了"},{"from":43.87,"to":45.39,"content":"辅助驾驶芯片的算力"},{"from":45.39,"to":47.75,"content":"一路从10tops上到了100tops"},{"from":47.75,"to":49.59,"content":"又到了300~500tops"},{"from":49.59,"to":52.39,"content":"直到有车企在二三十万的车上装了一颗"},{"from":52.39,"to":54.66,"content":"1500tops的芯片"},{"from":54.66,"to":57.66,"content":"所以汽车的算力是不是过剩了"},{"from":57.66,"to":60.96,"content":"装上1500TX芯片的车就会更聪明吗"},{"from":60.96,"to":63.7,"content":"欢迎来到这一期的车圈化简"},{"from":64.22,"to":65.54,"content":"即使是专业人士"},{"from":65.54,"to":68.39,"content":"也很难预测新技术会消耗多少算力"},{"from":68.39,"to":69.33,"content":"2022年"},{"from":69.33,"to":72.11,"content":"有汽车芯片厂商预估辅助驾驶的等级"},{"from":72.11,"to":75.36,"content":"每增加一级所需的算力大概是翻十几倍"},{"from":75.36,"to":77.52,"content":"比如L2需要二到2.5tops"},{"from":77.52,"to":79.4,"content":"L3需要20~30tops"},{"from":79.4,"to":81.53,"content":"L4需要200tops以上"},{"from":81.53,"to":83.65,"content":"如今200top4遍地都是"},{"from":83.65,"to":85.71,"content":"但L4还遥遥无期"},{"from":85.71,"to":89.43,"content":"这是因为现实的算力需求远超这个预估"},{"from":89.43,"to":90.99,"content":"在2020年前后"},{"from":90.99,"to":94.35,"content":"辅助驾驶还在用以规则代码为主的CNN架构"},{"from":94.35,"to":97.61,"content":"当时确实只需要不到10top次芯片就行"},{"from":97.61,"to":99.19,"content":"到了2012年前后"},{"from":99.19,"to":101.85,"content":"潮流变成了有3D俯视图的transformer"},{"from":101.85,"to":102.91,"content":"加BEV架构"},{"from":102.91,"to":105.91,"content":"这就需要20~100tops算力的芯片了"},{"from":105.91,"to":107.53,"content":"再到2024年前后"},{"from":107.53,"to":110.71,"content":"所有车企都宣称自己上了端到端大模型"},{"from":110.71,"to":112.19,"content":"开起来像老司机"},{"from":112.19,"to":115.09,"content":"这时的辅助驾驶能力虽然还没到L3"},{"from":115.09,"to":118.4,"content":"但已经要100tops以上的芯片才够用了"},{"from":118.4,"to":120.1,"content":"现在我们实际买车的时候"},{"from":120.1,"to":123.38,"content":"芯片算力小于30tops只能算是中杯"},{"from":123.38,"to":124.7,"content":"只提供车道保持"},{"from":124.7,"to":126.6,"content":"自动泊车等基础功能"},{"from":126.6,"to":129.38,"content":"算力在30~150TOS之间的"},{"from":129.38,"to":130.3,"content":"可以算大杯"},{"from":130.3,"to":131.54,"content":"支持高速NOA"},{"from":131.54,"to":133.209,"content":"但没有城市NOA"},{"from":133.209,"to":136.029,"content":"算力大于150tops的才能算超大杯"},{"from":136.029,"to":138.38,"content":"提供城市OA等复杂功能"},{"from":138.38,"to":139.68,"content":"而如今自动驾驶"},{"from":139.68,"to":143.34,"content":"最新最热门的是VRM或者VRA模型"},{"from":143.34,"to":144.88,"content":"它不光用上了大模型"},{"from":144.88,"to":147.22,"content":"还号称具备人类世界的常识"},{"from":147.22,"to":150.04,"content":"能理解画面和语言并输出控制指令"},{"from":150.04,"to":151.87,"content":"具备很强的可解释性"},{"from":151.87,"to":154.19,"content":"而它最低也要300~500"},{"from":154.19,"to":156.17,"content":"tops的芯片才能满足需求"},{"from":156.17,"to":157.57,"content":"所以到了2025年"},{"from":157.57,"to":160.37,"content":"英伟达又根据现实发展做了新预估"},{"from":160.37,"to":163.15,"content":"说L2对算力的需求是10tops以下"},{"from":163.15,"to":165.23,"content":"L2加就要100TOS以上"},{"from":165.23,"to":168.329,"content":"到了L3L4就得突破1000大关了"},{"from":168.329,"to":169.349,"content":"具体要多少"},{"from":169.349,"to":171.019,"content":"那谁也不知道"},{"from":171.019,"to":174.419,"content":"可以说在辅助驾驶年年都有新玩法的当下"},{"from":174.419,"to":176.539,"content":"消费者只需要操心算力不够"},{"from":176.539,"to":178.59,"content":"完全不用担心算力过剩"},{"from":178.59,"to":181.53,"content":"就好比在电脑和手机狂飙突进的年代"},{"from":181.53,"to":184.31,"content":"大家都只是表面上说算力过剩"},{"from":184.31,"to":186.959,"content":"实际上都在急头白脸的对信呢"},{"from":186.959,"to":189.179,"content":"当年乔布斯在开完嘲讽半年之后"},{"from":189.179,"to":192.579,"content":"苹果就给新款Mac装上了双路1G赫兹的处理器"},{"from":192.579,"to":194.539,"content":"在瑞平完联发科和三星后"},{"from":194.539,"to":197.659,"content":"高通也在半年后赶紧推出了八核的骁龙六"},{"from":197.659,"to":199.76,"content":"154滑转身啊"},{"from":199.76,"to":200.98,"content":"真香哎呀"},{"from":200.98,"to":203.4,"content":"而辅助驾驶对算力提前量的要求"},{"from":203.4,"to":205.14,"content":"比电脑手机更高"},{"from":205.14,"to":206.3,"content":"作为迭代频率高"},{"from":206.3,"to":208.14,"content":"但更换周期极长的产品"},{"from":208.14,"to":210.7,"content":"新能源汽车必须提前留足算力冗余"},{"from":210.7,"to":213.18,"content":"否则刚买回来可能就会被新技术抛下"},{"from":213.18,"to":216.02,"content":"尤其是对于采用纯视觉方案的车型来说"},{"from":216.02,"to":217.02,"content":"摄像头都在"},{"from":217.02,"to":218.72,"content":"只要芯片算力够用"},{"from":218.72,"to":222.05,"content":"理论上就能一直通过OTA用上最新模型"},{"from":222.05,"to":224.45,"content":"当然所有纸面上的参数优势"},{"from":224.45,"to":227.47,"content":"都必须转化成实际体验才有意义"},{"from":227.47,"to":230.75,"content":"所以这次我们就来到了我的家乡合肥"},{"from":230.75,"to":233.22,"content":"试驾的这台最新发布的鱼冻零八"},{"from":233.22,"to":236.7,"content":"它搭载了两颗750TP的图灵AI芯片"},{"from":236.7,"to":238.86,"content":"本地有效算力高达1500"},{"from":238.86,"to":241.04,"content":"tops是同级车型的两到三倍"},{"from":241.04,"to":243.66,"content":"号称5年后依然能打"},{"from":250.16,"to":252.9,"content":"呼我们开着它在合肥兜了几天"},{"from":252.9,"to":256.14,"content":"就是想来体验一下高算力加持下的最新模型"},{"from":256.14,"to":258.459,"content":"实际表现是不是真的更好"},{"from":258.459,"to":259.699,"content":"这是在公共道路上"},{"from":259.699,"to":263.459,"content":"我们基本全程开着城市NOA在前进的时候"},{"from":263.459,"to":265.3,"content":"你再按一下前进档"},{"from":265.3,"to":267.48,"content":"它就自动进入辅助驾驶模式了"},{"from":267.48,"to":270.02,"content":"然后他屏幕上面的车道线也会变成蓝色"},{"from":270.02,"to":272.039,"content":"现在它就是一个辅助驾驶的状态"},{"from":272.039,"to":273.799,"content":"然后它还可以拨杆变道"},{"from":273.799,"to":276.019,"content":"比如说我现在想变道左边的方向诶"},{"from":276.019,"to":277.49,"content":"我直接打下方向灯"},{"from":277.49,"to":279.09,"content":"在NOA的模式下"},{"from":279.09,"to":282.33,"content":"它会自己判断我要向左变道了"},{"from":282.33,"to":282.83,"content":"顿了一下"},{"from":282.83,"to":285.49,"content":"是因为前面白车占据了左边的车道"},{"from":285.49,"to":286.89,"content":"你看他现在就变过来了"},{"from":286.89,"to":288.92,"content":"那我现在还可以让它向右变道"},{"from":288.92,"to":289.48,"content":"你好"},{"from":289.48,"to":291,"content":"大众向右变道"},{"from":291,"to":291.96,"content":"好的"},{"from":291.96,"to":294.32,"content":"即将向右变道"},{"from":298.24,"to":300.28,"content":"那就是在辅助驾驶的模式下"},{"from":300.28,"to":302.22,"content":"语音变道也是可以完成的"},{"from":302.22,"to":306.56,"content":"我们看一看它能不能通过合肥政务区"},{"from":306.56,"to":308.26,"content":"最繁忙的路口之一啊"},{"from":308.26,"to":309.08,"content":"你看前面"},{"from":309.08,"to":312.48,"content":"其实现在车辆行人都是蛮多的"},{"from":313.399,"to":314.799,"content":"啊它自动停了"},{"from":314.799,"to":316.279,"content":"让行人了"},{"from":317.74,"to":320.46,"content":"等行人过去了诶"},{"from":320.46,"to":322.18,"content":"他又开始启动"},{"from":322.64,"to":326.2,"content":"这边还有左边是维修车"},{"from":326.2,"to":327.36,"content":"右边是交警啊"},{"from":327.36,"to":328.88,"content":"也成功过去了"},{"from":328.88,"to":331.74,"content":"到达合肥万象城西南门附近"},{"from":331.74,"to":333.2,"content":"目的地在您右侧"},{"from":333.2,"to":334.94,"content":"其实刚才还可以哈"},{"from":334.94,"to":338.909,"content":"那这次辅助驾驶过来就是完全没有接管"},{"from":338.909,"to":339.969,"content":"看我们的体验"},{"from":339.969,"to":341.389,"content":"大家应该能感受到"},{"from":341.389,"to":343.84,"content":"宇宙零八的辅助驾驶是很聪明的"},{"from":343.84,"to":345.48,"content":"用过辅助驾驶的朋友应该知道啊"},{"from":345.48,"to":346.74,"content":"在一些复杂路口"},{"from":346.74,"to":348.82,"content":"有些车就一直等在那不敢动了"},{"from":348.82,"to":349.84,"content":"或者一步一停"},{"from":349.84,"to":351.15,"content":"你就只能接管"},{"from":351.15,"to":352.23,"content":"但我开了两天"},{"from":352.23,"to":354.17,"content":"宇宙零八完全没有这种问题"},{"from":354.17,"to":355.29,"content":"他的变道诶"},{"from":355.29,"to":358.21,"content":"你看他找到了这个右转的专用道"},{"from":358.21,"to":360.01,"content":"其实这个右转专用道是在侧边的"},{"from":360.01,"to":364.75,"content":"站物识别启停的响应速度都做得很好"},{"from":364.75,"to":365.75,"content":"我开了两天"},{"from":365.75,"to":366.95,"content":"只接管过两次"},{"from":366.95,"to":368.19,"content":"一次是施工道路"},{"from":368.19,"to":369.27,"content":"他多变了一次道"},{"from":369.27,"to":369.99,"content":"当时车多"},{"from":369.99,"to":370.88,"content":"我就接管了"},{"from":370.88,"to":371.32,"content":"一次"},{"from":371.32,"to":373.52,"content":"是在没有中间护栏的路上掉头后"},{"from":373.52,"to":374.7,"content":"没有识别到正确车道"},{"from":374.7,"to":375.72,"content":"我也接管了"},{"from":375.72,"to":376.58,"content":"除此之外"},{"from":376.58,"to":377.799,"content":"他都开得很好"},{"from":377.799,"to":380.919,"content":"我们觉得这一方面跟他1500tops的高算力"},{"from":380.919,"to":383.03,"content":"还有车上的几十颗传感器有关"},{"from":383.03,"to":385.59,"content":"另一方面也跟他现在已经用上了"},{"from":385.59,"to":388.04,"content":"最新的VLA模型有很大关系"},{"from":388.04,"to":389.64,"content":"就是他能理解路况"},{"from":389.64,"to":391.32,"content":"开起来确实像真人"},{"from":391.32,"to":393.9,"content":"把参数优势转化成了用户体验"},{"from":393.9,"to":395.26,"content":"另外还有一个很好的点"},{"from":395.26,"to":397.4,"content":"就是它有一个人车共驾功能"},{"from":397.4,"to":399.86,"content":"你自己动一下方向盘或者踩一脚加速啊"},{"from":399.86,"to":401.69,"content":"它是不会退出辅助驾驶的"},{"from":401.69,"to":403.33,"content":"就比如说这个转向诶"},{"from":403.33,"to":404.41,"content":"我不放心的话"},{"from":404.41,"to":406.03,"content":"我也可以自己打方向盘"},{"from":406.03,"to":409.05,"content":"它会提示我说已经进入共价模式了"},{"from":409.05,"to":410.47,"content":"您正在控制车辆"},{"from":410.47,"to":411.77,"content":"然后到直道上之后"},{"from":411.77,"to":412.89,"content":"我再让他自己开"},{"from":412.89,"to":415.48,"content":"他就会再次接管我的车辆"},{"from":415.68,"to":417.4,"content":"并不会退出辅助驾驶"},{"from":417.4,"to":418.8,"con