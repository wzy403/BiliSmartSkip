:"但这些也仅限于微软自家的主机和系统"},{"from":80.56,"to":81.79,"content":"并无对外兼容"},{"from":81.79,"to":83.36,"content":"我们似乎看到了一个规律"},{"from":83.36,"to":84.44,"content":"在上个时代"},{"from":84.44,"to":88.96,"content":"VRXBOX和PS4跟电脑还算同父异母的亲兄弟"},{"from":88.96,"to":91.03,"content":"在某个层面上有着一定的关联"},{"from":91.03,"to":92.24,"content":"但是在这个时代"},{"from":92.24,"to":93.71,"content":"独创技术越来越多"},{"from":93.71,"to":96.29,"content":"好像主机与PC之间的差距越来越大"},{"from":96.29,"to":98.53,"content":"主机与主机之间也渐行渐远"},{"from":98.53,"to":100.48,"content":"哪怕在显卡行业也是如此"},{"from":100.48,"to":102.25,"content":"早期A卡N卡一个样"},{"from":102.25,"to":103.3,"content":"哪个运行速度快"},{"from":103.3,"to":104.29,"content":"哪个性价比高"},{"from":104.29,"to":105.52,"content":"玩家就会买哪个"},{"from":105.52,"to":109.32,"content":"但是如今A卡和N卡各自独占的技术越来越多"},{"from":109.32,"to":110.97,"content":"架构上也大相径庭"},{"from":110.97,"to":113.04,"content":"似乎拼命的想跟对方撇清关系"},{"from":113.04,"to":114.18,"content":"然后告诉消费者"},{"from":114.18,"to":115.19,"content":"我们不一样"},{"from":115.19,"to":118.17,"content":"而差异化带来的注定是更贵的入场券"},{"from":118.17,"to":118.95,"content":"在当下"},{"from":118.95,"to":122.22,"content":"想要体验走在游戏界前沿的技术成本越来越高"},{"from":122.22,"to":123.78,"content":"哪怕是拥有顶配PC"},{"from":123.78,"to":125.58,"content":"也需要为其配对两个手柄"},{"from":125.58,"to":126.66,"content":"一个XBOX手柄"},{"from":126.66,"to":129.96,"content":"为了兼容性和无线操控和另一个PS5的手柄"},{"from":129.96,"to":133.019,"content":"用来体验特别适配的游戏的那些细腻震动"},{"from":133.019,"to":133.859,"content":"不过不要怕"},{"from":133.859,"to":135.359,"content":"本期视频不仅要科普"},{"from":135.359,"to":136.289,"content":"还带着福利"},{"from":136.289,"to":138.449,"content":"因为拼多多目前正有数码机大促"},{"from":138.449,"to":139.919,"content":"这边小唐第一次接广告"},{"from":139.919,"to":141.76,"content":"联合拼多多给粉丝准备了福利"},{"from":141.76,"to":144.67,"content":"特意拿出一批全新正品的索尼PS5做秒杀"},{"from":144.67,"to":145.54,"content":"只要九块九"},{"from":145.54,"to":147.44,"content":"你也可以拥有最新的PS5"},{"from":147.44,"to":149.18,"content":"无论是刚才聊到的自适应扳机"},{"from":149.18,"to":149.84,"content":"还是震动"},{"from":149.84,"to":1