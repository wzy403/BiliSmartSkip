{"schemaVersion":1,"bvid":"BV1oZ42187Nc","cid":1468544432,"subtitles":[{"from":0.02,"to":0.44,"content":"大家好"},{"from":0.44,"to":1.58,"content":"我是春花"},{"from":1.58,"to":4.16,"content":"今天我们来聊聊吸渣体质"},{"from":4.16,"to":5.66,"content":"不知道你是不是这样的人"},{"from":5.66,"to":7.64,"content":"经常感觉自己气场不强"},{"from":7.64,"to":8.42,"content":"运气不好"},{"from":8.42,"to":10.58,"content":"对这个世界怀有很多好意"},{"from":10.58,"to":12.58,"content":"却总是被世界伤害"},{"from":12.58,"to":14.86,"content":"容易陷入烂人烂事儿"},{"from":14.86,"to":16.66,"content":"我好像被下了某种诅咒"},{"from":16.66,"to":19.63,"content":"你永远不可能获得幸福快乐"},{"from":19.63,"to":20.95,"content":"经过这些年的踩坑"},{"from":20.95,"to":23.69,"content":"我发现这些都不是玄学问题"},{"from":23.69,"to":25.64,"content":"而是由性格弱点导致的"},{"from":25.64,"to":26.88,"content":"最近我在读荣格"},{"from":26.88,"to":28.2,"content":"他提出的一个观点"},{"from":28.2,"to":31.38,"content":"正好把我这些年的经验性感悟理论化了"},{"from":31.38,"to":32.46,"content":"今天结合荣格"},{"from":32.46,"to":33.75,"content":"我就跟大家聊一下"},{"from":33.75,"to":35.99,"content":"如何从西站走向好运"},{"from":35.99,"to":37.94,"content":"做自己运气的主人"},{"from":37.94,"to":41.84,"content":"首先我们来看一下什么样的人更容易吸渣"},{"from":41.84,"to":43.04,"content":"在荣格的理论里"},{"from":43.04,"to":46.28,"content":"他把我们每个人的人格发展阶段分成三个部分"},{"from":46.28,"to":48.19,"content":"韩融调整中心化"},{"from":48.19,"to":49.24,"content":"在繁荣阶段"},{"from":49.24,"to":50.35,"content":"我们被支持"},{"from":50.35,"to":51.01,"content":"被喜爱"},{"from":51.01,"to":52.82,"content":"我们就好像活在伊甸园中"},{"from":52.82,"to":55.67,"content":"周围的环境都是温暖安全有序的"},{"from":55.67,"to":56.9,"content":"而到了调整阶段"},{"from":56.9,"to":58.76,"content":"我们从温柔乡中离开"},{"from":58.76,"to":61.34,"content":"逐渐认识到外部环境的凶险"},{"from":61.34,"to":63.61,"content":"我们被迫要去适应社会"},{"from":63.61,"to":64.9,"content":"迎接现实挑战"},{"from":64.9,"to":66.34,"content":"而到了中心化阶段"},{"from":66.34,"to":69.04,"content":"我们则可以平衡好外部需求和内部需求"},{"from":69.04,"to":70.55,"content":"走向自我实现"},{"from":70.55,"to":73.76,"content":"可以用三个词简单概括一下这三个阶段"},{"from":73.76,"to":75.26,"content":"母姓父姓"},{"from":75.26,"to":76.03,"content":"自姓"},{"from":76.03,"to":77.05,"content":"越往后发展"},{"from":77.05,"to":78.49,"content":"你的人格就会越成熟"},{"from":78.49,"to":80.53,"content":"那这个和西渣有什么关系呢"},{"from":80.53,"to":82.33,"content":"如果一个人的大部分自我"},{"from":82.33,"to":84.86,"content":"还停留在对韩荣阶段的依恋中"},{"from":84.86,"to":88.19,"content":"他不愿意看见和接纳现世的险恶"},{"from":88.19,"to":91.09,"content":"还对外部世界怀有大量的伊甸园幻想"},{"from":91.09,"to":94.89,"content":"那这个人就好像自带了某种厄运引力"},{"from":94.89,"to":96.81,"content":"极容易陷入烂人烂事"},{"from":96.81,"to":99.24,"content":"这个逻辑乍一听你一定会有很多疑问"},{"from":99.24,"to":99.99,"content":"没关系啊"},{"from":99.99,"to":101.43,"content":"我们来慢慢解释"},{"from":101.43,"to":102.96,"content":"首先会有人问"},{"from":102.96,"to":104.73,"content":"我早就放弃伊甸园幻想"},{"from":104.73,"to":106.11,"content":"接受现实险恶了"},{"from":106.11,"to":108.27,"content":"那我是不是就没有吸渣体质了呢"},{"from":108.27,"to":110.35,"content":"不你以为你接受了"},{"from":110.35,"to":111.46,"content":"其实你没有"},{"from":111.46,"to":113.05,"content":"比如你可以自问啊"},{"from":113.05,"to":114.55,"content":"在你的内心深处"},{"from":114.55,"to":118.54,"content":"你是否还对这个世界怀有过多美好的期待"},{"from":118.54,"to":120.28,"content":"比如说我早先工作的时候"},{"from":120.28,"to":123.1,"content":"我会经常因为别人的不真诚而被刺痛"},{"from":123.1,"to":125.6,"content":"如果有人在我面前虚伪的恭维我说"},{"from":126.38,"to":127.78,"content":"您可真厉害啊"},{"from":127.78,"to":129.55,"content":"我下一秒能直接哭给他看"},{"from":129.55,"to":132.22,"content":"因为我心里期待真诚友好的关系"},{"from":132.22,"to":134.26,"content":"别人的虚伪会让我觉得"},{"from":134.26,"to":136.94,"content":"这个人和人之间怎么就这样了呢"},{"from":136.94,"to":139.85,"content":"有过相似感受的朋友可以在弹幕里举个手"},{"from":139.85,"to":141.92,"content":"为什么有人会军训爱上教官"},{"from":141.92,"to":142.82,"content":"看病爱上医生"},{"from":142.82,"to":143.76,"content":"上学爱上老师"},{"from":143.76,"to":145.92,"content":"那是因为这个人时时刻刻都在期待"},{"from":145.92,"to":147.54,"content":"一场澎湃的心动"},{"from":147.54,"to":149.54,"content":"他还活在对浪漫爱的幻想中"},{"from":149.54,"to":152.48,"content":"为什么有人和父母沟通明明很痛苦"},{"from":152.48,"to":154.61,"content":"却还是会持之以恒的沟通呢"},{"from":154.61,"to":156.14,"content":"那是因为他不愿放弃"},{"from":156.14,"to":158.26,"content":"对家庭幸福和父母之爱的期待"},{"from":158.26,"to":161.83,"content":"他无法接受父母可能根本不能爱他的事实"},{"from":161.83,"to":164.98,"content":"如果你觉得你没有这些个体层面的幻想"},{"from":164.98,"to":167.41,"content":"那你也很难逃脱集体大梦"},{"from":167.41,"to":170.83,"content":"中国青年呢目前就集体怀抱着两个假梦"},{"from":170.83,"to":172.46,"content":"一是上岸之梦"},{"from":172.46,"to":175.16,"content":"他们期待结束看不到头的颠沛生活"},{"from":175.16,"to":179.52,"content":"因为某个关键性事件可能是考公考研或回老家"},{"from":179.52,"to":181.959,"content":"而收获想象中的稳定和宁静"},{"from":181.959,"to":184.119,"content":"第二个是旷野之梦"},{"from":184.119,"to":187.36,"content":"他们现在对结构性压抑和控制的彻底逃脱"},{"from":187.36,"to":191.02,"content":"因为一次勇敢的脱轨而收获旷野的自由"},{"from":191.02,"to":193,"content":"去大理裸辞润雪"},{"from":193,"to":194.75,"content":"都是旷野之梦的表征"},{"from":194.75,"to":196.55,"content":"我之所以说这些是梦"},{"from":196.55,"to":198.35,"content":"是因为人们对他的期待"},{"from":198.35,"to":200.79,"content":"已经超过了他所能承载的程度"},{"from":200.79,"to":202.59,"content":"而带你迎上前去"},{"from":202.59,"to":205.29,"content":"你就会发现其中的琐碎和龌龊"},{"from":205.29,"to":206.25,"content":"我这么一说"},{"from":206.25,"to":208.86,"content":"你是不是觉得你在生活的某些方面"},{"from":208.86,"to":211.81,"content":"也或多或少的抱有伊甸人幻想"},{"from":211.81,"to":213.01,"content":"这是必然的"},{"from":213.01,"to":216.34,"content":"当你发现你对某个事物有着放不下的渴望"},{"from":216.34,"to":217.69,"content":"这个渴望已经大到"},{"from":217.69,"to":220.52,"content":"为这个事物蒙上了一层玫瑰色的光晕"},{"from":220.52,"to":222.53,"content":"已经达到了may的程度"},{"from":222.53,"to":225.02,"content":"那么你就对他陷入了伊甸园幻想"},{"from":225.02,"to":226.88,"content":"大家也可以在弹幕里分享一下"},{"from":226.88,"to":228.23,"content":"你们的伊甸园幻想"},{"from":228.23,"to":230.66,"content":"期待和幻想在某个阶段是好事"},{"from":230.66,"to":232.74,"content":"它给我们提供了新生的动力"},{"from":232.74,"to":235.17,"content":"但是如果你对某件事物的期待"},{"from":235.17,"to":237.84,"content":"大到遮蔽了你对现实的认知"},{"from":237.84,"to":239.82,"content":"那你就会陷入厄运"},{"from":239.82,"to":242.3,"content":"这也是我接下来要回答的第二个问题"},{"from":242.3,"to":245.18,"content":"为什么伊甸园幻想会欺诈"},{"from":245.18,"to":248.06,"content":"不知道你有没有读过房思琪的初恋乐园"},{"from":248.06,"to":249.4,"content":"书里有一个细节"},{"from":249.4,"to":251.08,"content":"语文老师李国华呢"},{"from":251.08,"to":253.48,"content":"在中学生中物色可以骚扰的对象"},{"from":253.48,"to":255.47,"content":"是他在心里做了一个判断"},{"from":255.47,"to":256.88,"content":"有钱呢不能惹"},{"from":256.88,"to":258.47,"content":"因为人家家长会搞我"},{"from":258.47,"to":260.24,"content":"性格强硬的不敢惹"},{"from":260.24,"to":261.67,"content":"因为他会到处乱说"},{"from":261.67,"to":263.8,"content":"最后呢他选择了房思琪"},{"from":263.8,"to":265.15,"content":"为什么是他呢"},{"from":265.15,"to":267.11,"content":"书里对房思琪的描述是啊"},{"from":267.11,"to":269.81,"content":"他就像是一个精致的陶瓷娃娃"},{"from":269.81,"to":270.83,"content":"他热爱文学"},{"from":270.83,"to":271.55,"content":"尊重知识"},{"from":271.55,"to":272.36,"content":"尊重老师"},{"from":272.36,"to":275.62,"content":"李国华判定房思琪太纯洁了"},{"from":275.62,"to":278.98,"content":"他一定无法接受这么脏的事情发生在自己身上"},{"from":278.98,"to":280.06,"content":"于是他会闭嘴"},{"from":280.06,"to":281.53,"content":"正如他所料"},{"from":281.53,"to":283.06,"content":"房思琪被诱奸之后呢"},{"from":283.06,"to":284.47,"content":"他感觉非常痛苦"},{"from":284.47,"to":286.61,"content":"他无法接受老师是这样的人"},{"from":286.61,"to":288.17,"content":"于是他反问自己"},{"from":288.17,"to":290.84,"content":"这是不是就是老师爱我的方式"},{"from":290.84,"to":293.5,"content":"当一个人抱有强烈的伊甸园幻想时"},{"from":293.5,"to":296.44,"content":"他会倾向于否认和幻想不同的感受"},{"from":296.44,"to":297.76,"content":"遇到烂人烂事后"},{"from":297.76,"to":299.8,"content":"他的第一反应不是保护自己"},{"from":299.8,"to":301.72,"content":"而是保护伊甸园幻想"},{"from":301.72,"to":303.94,"content":"正常人踩到屎他会离远"},{"from":303.94,"to":306.039,"content":"而有伊甸园幻想的人踩到屎呢"},{"from":306.039,"to":310.239,"content":"他会强忍着痛苦凑上前去研究这些东西"},{"from":310.239,"to":313.429,"content":"他会想这真的是屎吗"},{"from":313.429,"to":317.329,"content":"会不会在某些地方还有我未曾发现的金子呢"},{"from":317.329,"to":319.579,"content":"于是前者摆脱厄运"},{"from":319.579,"to":321.46,"content":"后者则会和厄运纠缠"},{"from":321.46,"to":322.42,"content":"之所以这样"},{"from":322.42,"to":324.04,"content":"并不是因为后者更矫情"},{"from":324.04,"to":326.32,"content":"而是因为它本质上不愿意接受"},{"from":326.32,"to":328.5,"content":"这个世界上有史的存在"},{"from":328.5,"to":330.24,"content":"除了否认真实感受外呢"},{"from":330.24,"to":331.74,"content":"为了维护伊甸园幻想"},{"from":331.74,"to":335.13,"content":"当事人还会做另一个伤害性更大的行为"},{"from":335.13,"to":336.09,"content":"自我否认"},{"from":336.09,"to":338.29,"content":"只有证明自己是坏"},{"from":338.29,"to":340.45,"content":"才能证明世界是好的"},{"from":340.45,"to":342.86,"content":"房思琪在书中的最终结局是自杀"},{"from":342.86,"to":346.13,"content":"他实在没有办法调和现实和幻想之间的冲突"},{"from":346.13,"to":348.13,"content":"于是他只能转而攻击自己"},{"from":348.13,"to":350.35,"content":"他觉得是我导致了这一切"},{"from":350.35,"to":351.73,"content":"感受到痛苦之后"},{"from":351.73,"to":353.62,"content":"他没有选择报复李国华"},{"from":353.62,"to":354.96,"content":"而是跳楼自杀"},{"from":354.96,"to":358.05,"content":"很多大学生在离开校园走入社会之后"},{"from":358.05,"to":360.66,"content":"也会经历大量的伊甸园破灭"},{"from":360.66,"to":362.3,"content":"我们从讲文明"},{"from":362.3,"to":365.48,"content":"懂规矩的校园进入这个鱼龙混杂的社会"},{"from":365.48,"to":368.2,"content":"大学生们会在生活的方方面面踩坑"},{"from":368.2,"to":369.16,"content":"初入社会呢"},{"from":369.16,"to":370,"content":"我经历了坑"},{"from":370,"to":371.92,"content":"包括但不限于被房东骗钱"},{"from":371.92,"to":372.7,"content":"被同事造谣"},{"from":372.7,"to":373.54,"content":"被老板下套"},{"from":373.54,"to":374.44,"content":"遭遇这些的时候"},{"from":374.44,"to":375.93,"content":"我们倾向于自我否认"},{"from":375.93,"to":377.01,"content":"我们会想啊"},{"from":377.01,"to":378.75,"content":"是不是我当时没说清楚呢"},{"from":378.75,"to":380.7,"content":"是不是我给了别人错误的暗示呢"},{"from":380.7,"to":382.38,"content":"是不是我太过于不小心呢"},{"from":382.38,"to":385.36,"content":"这些自我否认给我们提供了一种想象的可能性"},{"from":385.36,"to":387.52,"content":"是不是只要我做的足够好"},{"from":387.52,"to":390.43,"content":"我就可以安全就可以活在伊甸园中呢"},{"from":390.43,"to":392.57,"content":"我们忽视了纯哥的存在"},{"from":392.57,"to":393.71,"content":"我们否认啊"},{"from":393.71,"to":397.66,"content":"这个社会本身就是充斥着各种没有指向性的恶"},{"from":397.66,"to":398.92,"content":"不管你怎么规避"},{"from":398.92,"to":400.99,"content":"你也会有很大概率碰上它"},{"from":400.99,"to":402.22,"content":"通过我上面这些描述"},{"from":402.22,"to":402.94,"content":"你会发现"},{"from":402.94,"to":405.24,"content":"如果一个人不能直面假丑恶"},{"from":405.24,"to":407.01,"content":"不能走出伊甸园幻想"},{"from":407.01,"to":410.73,"content":"那这个人就像是一个丰硕的等待被采摘的果子"},{"from":410.73,"to":411.66,"content":"我是烂人"},{"from":411.66,"to":413.18,"content":"我当然也找你了"},{"from":413.18,"to":414.68,"content":"因为当我行恶之后"},{"from":414.68,"to":416.18,"content":"你非但不会惩罚我"},{"from":416.18,"to":417.56,"content":"你还会责怪你自己"},{"from":417.56,"to":419.3,"content":"甚至有时为了维护你的幻想"},{"from":419.3,"to":420.64,"content":"你还会替我说话"},{"from":420.64,"to":422.8,"content":"这是多么完美的受害者呀"},{"from":422.8,"to":427.62,"content":"这就是吸渣的来源以及清纯的诅咒"},{"from":427.62,"to":428.7,"content":"说到这里呢"},{"from":428.7,"to":430.71,"content":"这个话题已经完成了一大半"},{"from":430.71,"to":433.58,"content":"如果你觉得我的分析能够帮你转运的话"},{"from":433.58,"to":435.8,"content":"那就让我们隆重请出"},{"from":435.8,"to":439.45,"content":"今天这个视频的金主妈妈HDN"},{"from":439.45,"to":442.75,"content":"为了防止伊甸园幻想影响自己的感受"},{"from":442.75,"to":445.44,"content":"每天呢我都会花15分钟的时间"},{"from":445.44,"to":447.42,"content":"用来回忆当天发生的事儿"},{"from":447.42,"to":449.14,"content":"和自己的感受建立连接"},{"from":449.14,"to":450.19,"content":"面对感受"},{"from":450.19,"to":451.42,"content":"我既不改造它"},{"from":451.42,"to":452.38,"content":"也不无视它"},{"from":452.38,"to":454.5,"content":"而只是倾听体验"},{"from":454.5,"to":456,"content":"想要效果更好的话"},{"from":456,"to":458.15,"content":"你可以在做仪式前洗一个澡"},{"from":458.15,"to":460.04,"content":"带上我们的晚导伴侣"},{"from":460.04,"to":461.93,"content":"HBN双A醇晚霜"},{"from":461.93,"to":462.68,"content":"2.0"},{"from":462.68,"to":465.97,"content":"这款晚霜最显著的功效是抗皱紧致"},{"from":465.97,"to":468.22,"content":"如果你平时的情绪起伏比较大"},{"from":468.22,"to":469.15,"content":"思虑过重"},{"from":469.15,"to":471.31,"content":"很容易出现细纹粗糙"},{"from":471.31,"to":472.9,"content":"甚至皮肤弹性下降"},{"from":472.9,"to":475.6,"content":"双A醇晚霜采用了科学配比的"},{"from":475.6,"to":477.76,"content":"双重A醇加双重A制"},{"from":477.76,"to":480.88,"content":"而且2.0还升级了吸收转换的技术"},{"from":480.88,"to":484.95,"content":"能够高效率促生胶原有成倍的紧致淡纹效果"},{"from":484.95,"to":486.21,"content":"坚持用了一个月后"},{"from":486.21,"to":488.61,"content":"我最明显的感受是皮肤变细腻了"},{"from":488.61,"to":489.96,"content":"更有弹性了"},{"from":489.96,"to":491.88,"content":"它的使用体验也非常舒适"},{"from":491.88,"to":493.74,"content":"它使用的是真空按压"},{"from":493.74,"to":495.26,"content":"能够最大限度保鲜"},{"from":495.26,"to":497.18,"content":"加上黄金微粒的包裹"},{"from":497.18,"to":499.4,"content":"抹在脸上的感觉会更温和"},{"from":499.4,"to":503.11,"content":"HBN是国内口碑很好的功效护肤品牌"},{"from":503.11,"to":505.51,"content":"A醇抗老也是他家最拿手的项目"},{"from":505.51,"to":509.6,"content":"这款晚霜一直都是各大平台回购口碑top one"},{"from":509.6,"to":512,"content":"所以想要效果明显的抗老面霜"},{"from":512,"to":514.31,"content":"还是得选HBN霜"},{"from":514.31,"to":515.789,"content":"A醇晚霜"},{"from":515.789,"to":519.77,"content":"最后呢我还想再推进一步深入补充一个问题"},{"from":519.77,"to":521.99,"content":"而聪明的朋友可能会疑惑了"},{"from":521.99,"to":524.87,"content":"那既然音乐园幻想会给我带来厄运"},{"from":524.87,"to":526.76,"content":"那我为啥还是放不下他呢"},{"from":526.76,"to":528.62,"content":"事实上就算是告诉你"},{"from":528.62,"to":531.62,"content":"你所憧憬的东西都是一团幻光"},{"from":531.62,"to":533.66,"content":"就算是我把这个幻光掰开了"},{"from":533.66,"to":534.2,"content":"揉碎了"},{"from":534.2,"to":536.2,"content":"让你看到里面的肮脏之处"},{"from":536.2,"to":538.06,"content":"你也依旧无法放下它"},{"from":538.06,"to":539.29,"content":"这是为什么呢"},{"from":539.29,"to":540.1,"content":"那是因为"},{"from":540.1,"to":542.08,"content":"伊甸园幻想在你的精神上"},{"from":542.08,"to":543.74,"content":"承担着一项重要的功能"},{"from":543.74,"to":546.35,"content":"比如呢大家身边应该都会有这样的夫妻"},{"from":546.35,"to":547.79,"content":"常见于上一代人"},{"from":547.79,"to":549.66,"content":"妻子希望丈夫能够外向一"},{"from":549.66,"to":552.48,"content":"而她的丈夫本质上是一个彻底的爱人"},{"from":552.48,"to":554.82,"content":"这个妻子就会不断的抱怨"},{"from":554.82,"to":557.41,"content":"试图通过指责速度她丈夫的改变"},{"from":557.41,"to":559.18,"content":"然而40年过去了"},{"from":559.18,"to":561.28,"content":"你还不知道你老公啥货色"},{"from":561.28,"to":562.72,"content":"但是她仍旧不会放弃"},{"from":562.72,"to":563.5,"content":"期待她"},{"from":563.5,"to":566.8,"content":"下一次呢会像第一次一样抱怨她的丈夫"},{"from":566.8,"to":567.92,"content":"诉诸对方改变"},{"from":567.92,"to":569.36,"content":"为什么会这样呢"},{"from":569.36,"to":570.26,"content":"因为这样啊"},{"from":570.26,"to":571.1,"content":"这个妻子呢"},{"from":571.1,"to":574.75,"content":"就可以把幸福生活的希望寄托在别人身上"},{"from":574.75,"to":577.54,"content":"因为只要外部环境满足了我的期待"},{"from":577.54,"to":580.17,"content":"我的丈夫改变了我就可以幸福"},{"from":580.17,"to":582.51,"content":"而当她一旦放弃期待"},{"from":582.51,"to":583.86,"content":"直面丈夫的性格"},{"from":583.86,"to":586.02,"content":"他就被迫要面对一个问题"},{"from":586.02,"to":588.319,"content":"我是否还要继续这段关系"},{"from":588.319,"to":590.299,"content":"他就被迫要面对他的婚姻"},{"from":590.299,"to":592.1,"content":"长达几十年的沉没成本"},{"from":592.1,"to":593.36,"content":"如果要在一起"},{"from":593.36,"to":596.42,"content":"那我要怎么找到一种让两个人都舒服的方式"},{"from":596.42,"to":597.56,"content":"如果不要"},{"from":597.56,"to":599.8,"content":"那我要如何开始一个人的生活"},{"from":599.8,"to":600.82,"content":"可以看出呢"},{"from":600.82,"to":603.91,"content":"伊甸园幻想拉开了我们与真实世界的距离"},{"from":603.91,"to":607.12,"content":"它让我们得以避免处理真实世界的复杂问题"},{"from":607.12,"to":609.73,"content":"他卸下了我们肩上沉重的责任"},{"from":609.73,"to":611.68,"content":"容易沉浸在伊甸园幻想的人呢"},{"from":611.68,"to":613.58,"content":"本质上是不相信自己的能力"},{"from":613.58,"to":616.49,"content":"他们不相信自己可以直面假丑恶"},{"from":616.49,"to":618.35,"content":"可以应对复杂的现实"},{"from":618.35,"to":621.01,"content":"他们认为摆在自己面前的只有两条路"},{"from":621.01,"to":624.07,"content":"要么找一个能满足他伊甸园幻想的环境"},{"from":624.07,"to":626.2,"content":"然后幸福快乐的生活在其中"},{"from":626.2,"to":628.27,"content":"要么陷入自怜自艾"},{"from":628.27,"to":629.38,"content":"发出天问"},{"from":629.38,"to":630.39,"content":"为什么"},{"from":630.39,"to":632.4,"content":"为什么世界是这样的"},{"from":632.4,"to":634.22,"content":"为什么我是如此不幸"},{"from":634.22,"to":636.89,"content":"然后沉浸于一种审美上的破碎感中"},{"from":636.89,"to":637.82,"content":"第一条路"},{"from":637.82,"to":639.74,"content":"你是一个被满足的幸福婴儿"},{"from":639.74,"to":640.58,"content":"第二条路"},{"from":640.58,"to":642.69,"content":"你是一个被剥夺的无助婴儿"},{"from":642.69,"to":644.4,"content":"总之你是婴儿"},{"from":644.4,"to":646.8,"content":"你在被动地等待世界的投喂"},{"from":646.8,"to":649.46,"content":"而非主动向世界发起挑战"},{"from":649.46,"to":651.05,"content":"这也是为什么荣格说"},{"from":651.05,"to":653,"content":"一个人只有脱离了繁荣阶段"},{"from":653,"to":654.38,"content":"脱离了伊甸园幻想"},{"from":654.38,"to":657.2,"content":"他的人格才会真正开始走向成熟"},{"from":657.2,"to":660.26,"content":"很多人会认为啊活在幻想里很美"},{"from":660.26,"to":663.82,"content":"但我认为那是因为你从来都没有走出来过"},{"from":663.82,"to":667.12,"content":"伊甸园给人提供的是一种婴儿式的安宁"},{"from":667.12,"to":670.8,"content":"而真实世界能给人提供一种英雄式的安宁"},{"from":670.8,"to":672.81,"content":"前者的安宁来自环境"},{"from":672.81,"to":675.08,"content":"后者的安宁来自自我力量"},{"from":675.08,"to":676.4,"content":"当你离开幻想"},{"from":676.4,"to":677.66,"content":"走入真实世界"},{"from":677.66,"to":681.36,"content":"你会发现真实世界尽管危险复杂"},{"from":681.36,"to":684.15,"content":"但是呢它也更为刺激有趣"},{"from":684.15,"to":686.04,"content":"当你戳破伊甸园幻想后呢"},{"from":686.04,"to":688.94,"content":"你的主线剧情才会进行到下一个阶段"},{"from":688.94,"to":691.28,"content":"此时音乐响起"},{"from":691.28,"to":693.69,"content":"你的面前出现八个大字"},{"from":693.69,"to":696.4,"content":"欢迎来到真实世界"}],"chapters":[{"from":0,"to":38,"content":"开始"},{"from":38,"to":243,"content":"什么是吸渣体质？"},{"from":243,"to":517,"content":"为什么会吸渣？"},{"from":517,"to":702,"content":"如何避免？"}],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:23:36.617Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"available","chaptersFetchedAt":"2026-10-04T23:23:31.958Z"}}
