":634.98,"content":"这是乱糟的花边啊"},{"from":634.98,"to":636.1,"content":"还是花圈呢"},{"from":636.1,"to":638.08,"content":"紧接着呀就是道格的作品了"},{"from":638.08,"to":642.78,"content":"他倒是很好奇那根最大的骨头来源于什么动物"},{"from":655.96,"to":657.96,"content":"不一般哎呦"},{"from":657.96,"to":660.44,"content":"这小刀柄这手感这个润这个滑哟"},{"from":660.44,"to":662.44,"content":"这个这让我想起了初恋"},{"from":662.44,"to":663,"content":"奈何呀"},{"from":663,"to":664.62,"content":"可能是打磨的过多了"},{"from":664.62,"to":665.8,"content":"稍微它有些短"},{"from":665.8,"to":667.36,"content":"不过整体的结构很牢固"},{"from":667.36,"to":668.62,"content":"刃口更夸张"},{"from":668.62,"to":671.099,"content":"甚至都找不到受击点哇"},{"from":671.099,"to":672.319,"content":"有点能耐"},{"from":672.319,"to":675.019,"content":"最后呢就是贾斯丁的表现了"},{"from":686.14,"to":687.44,"content":"本以为会骑根蛇"},{"from":687.44,"to":689.58,"content":"它毕竟连接处啊略显薄弱"},{"from":689.58,"to":691.5,"content":"结果还真就顶住了"},{"from":691.5,"to":693.78,"content":"而且这么大个空腔也都给治好了"},{"from":693.78,"to":695.28,"content":"且刃口依旧锋利"},{"from":695.28,"to":695.86,"content":"然后呢"},{"from":695.86,"to":699.14,"content":"由狗哥指刃进行水果忍者的锋利度测试"},{"from":699.14,"to":701.14,"content":"还是花哥的花刀"},{"from":701.14,"to":701.94,"content":"先来呃"},{"from":701.94,"to":702.95,"content":"Quack quack"},{"from":702.95,"to":704.67,"content":"Let's do this"},{"from":724.98,"to":727.28,"content":"这把刀啊上部分很锋利"},{"from":727.28,"to":729.34,"content":"但中间这部分不太行啊"},{"from":729.34,"to":730.56,"content":"无法一刀断肉"},{"from":730.56,"to":732.2,"content":"而且土豆还卡住了"},{"from":732.2,"to":734.16,"content":"再来看看道格的表现"},{"from":756.94,"to":758.78,"content":"一刀下去"},{"from":758.78,"to":760.46,"content":"肉类呢还是有些藕断丝"},{"from":760.46,"to":760.68,"content":"连"},{"from":760.68,"to":762.38,"content":"蔬菜水果全部攻克"},{"from":762.38,"to":765.18,"content":"最后呢是贾斯丁的表现"},{"from":781.86,"to":783.78,"content":"这算是最锋利的一把了"},{"from":783.78,"to":784.94,"content":"哈密瓜扔歪了"},{"from":784.94,"to":786.66,"content":"要不也得是一刀两断"},{"from":786.66,"to":788.3,"content":"狮驼岭三巨头呢经过商议"},{"from":788.3,"to":790.08,"content":"最后还是淘