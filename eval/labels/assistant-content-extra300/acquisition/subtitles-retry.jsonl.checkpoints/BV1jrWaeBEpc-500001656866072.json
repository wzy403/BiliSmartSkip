{"schemaVersion":1,"bvid":"BV1jrWaeBEpc","cid":500001656866072,"subtitles":[{"from":0.08,"to":2.24,"content":"我们的摆摊团伙即将面临解散"},{"from":2.24,"to":4.88,"content":"我们四个人都认为应该及时止损"},{"from":4.88,"to":6.84,"content":"不能再毫无意义的耗下去"},{"from":6.84,"to":8.76,"content":"四个人干一个摊位的话"},{"from":8.76,"to":11.01,"content":"确实利润根本不够分"},{"from":11.01,"to":13.19,"content":"还达不到上班工资的标准"},{"from":13.19,"to":14.67,"content":"所以呢我们决定分开"},{"from":14.67,"to":17.06,"content":"有人说合伙生意肯定是不能做的"},{"from":17.06,"to":18.48,"content":"最后都会发生冲突"},{"from":18.48,"to":19.3,"content":"发生矛盾"},{"from":19.3,"to":20.68,"content":"其实这些都还好"},{"from":20.68,"to":21.94,"content":"基本不会出现"},{"from":21.94,"to":23.84,"content":"现在主要的问题是钱不够分"},{"from":23.84,"to":25.08,"content":"要么减少人员"},{"from":25.08,"to":26.42,"content":"要么让生意变好"},{"from":26.42,"to":27.42,"content":"利润增加"},{"from":27.42,"to":29.08,"content":"但这有多不容易"},{"from":29.08,"to":30.93,"content":"大家伙应该都知道"},{"from":30.93,"to":33.93,"content":"所以呢我们这个现在就是埋头苦干"},{"from":33.93,"to":35.25,"content":"没有任何技巧"},{"from":35.25,"to":37.05,"content":"就是说你再去努力"},{"from":37.05,"to":38.53,"content":"好像也没有任何意义"},{"from":38.53,"to":41.39,"content":"我们后期的规划是要么我和大哥去上班"},{"from":41.39,"to":43.19,"content":"把摊位留给两个小伙"},{"from":43.19,"to":45.33,"content":"或者说他们两个小伙去上班"},{"from":45.33,"to":46.69,"content":"我和大哥接着摆摊"},{"from":46.69,"to":49.68,"content":"当然这个决策呢还在考虑当中"},{"from":49.68,"to":51.92,"content":"大家伙也可以给我们一些建议"},{"from":51.92,"to":54.02,"content":"现在虽然已经快进入秋天了"},{"from":54.02,"to":55.9,"content":"在厨房干活或者出去摆摊"},{"from":55.9,"to":57.02,"content":"依然是很热"},{"from":57.02,"to":59.66,"content":"之前同事品牌方给我寄的循环小风扇"},{"from":59.66,"to":62.06,"content":"现在成功被两位总监给我霸占了"},{"from":62.06,"to":64.44,"content":"结果呢品牌方又赶紧给我寄了一个过来"},{"from":64.44,"to":66.07,"content":"这次呢是一个白色的"},{"from":66.07,"to":67.73,"content":"依然还是很有质感"},{"from":67.73,"to":68.67,"content":"我特别喜欢"},{"from":68.67,"to":69.65,"content":"别看它长得小"},{"from":69.65,"to":70.88,"content":"但锋利真的很猛"},{"from":70.88,"to":71.64,"content":"但奇怪的是"},{"from":71.64,"to":72.4,"content":"风又很柔和"},{"from":72.4,"to":73.36,"content":"吹着就很舒服"},{"from":73.36,"to":74.44,"content":"是那种凉凉的"},{"from":74.44,"to":76.26,"content":"不像有的风扇吹出来是热风"},{"from":76.26,"to":79.14,"content":"比我之前买的那种两个档位的落地风扇"},{"from":79.14,"to":80.1,"content":"真的强太多了"},{"from":80.1,"to":81.14,"content":"要么就是风太大"},{"from":81.14,"to":81.98,"content":"吹得我脑壳疼"},{"from":81.98,"to":83.62,"content":"要么就是风小不管用"},{"from":83.62,"to":85.789,"content":"而且这个风扇的话用起来也很方便"},{"from":85.789,"to":87.429,"content":"厨房卧室剪视频"},{"from":87.429,"to":88.789,"content":"吃饭摆摊哪儿都能用"},{"from":88.789,"to":89.589,"content":"还不占地方"},{"from":89.589,"to":90.429,"content":"又能粘到墙上"},{"from":90.429,"to":91.58,"content":"一边炒菜一边吹"},{"from":91.58,"to":93.42,"content":"又能放到桌上带出去"},{"from":93.42,"to":94.56,"content":"摆摊也不用充电"},{"from":94.56,"to":96.12,"content":"完全实现了无线自由"},{"from":96.12,"to":98.64,"content":"两位总监和我想放到哪去都行"},{"from":98.64,"to":99.4,"content":"我放在那里"},{"from":99.4,"to":100.44,"content":"他们就给我搬走了"},{"from":100.44,"to":102.28,"content":"反正一句话就很方便"},{"from":102.28,"to":103,"content":"摆摊回来"},{"from":103,"to":105.2,"content":"晚上还可以接着用这个小风扇吹着睡觉"},{"from":105.2,"to":105.68,"content":"说实话"},{"from":105.68,"to":107.08,"content":"空调吹久了真的很难受"},{"from":107.08,"to":108.78,"content":"所以呢我就尽量不吹空调"},{"from":108.78,"to":109.82,"content":"关于质量吧"},{"from":109.82,"to":111.32,"content":"咱也就不多说了"},{"from":111.32,"to":112.56,"content":"肯定是杠杠的"},{"from":112.56,"to":114.22,"content":"有需要的朋友就赶紧去看看"},{"from":114.22,"to":115.2,"content":"点评论区链接"},{"from":115.2,"to":116.46,"content":"还有大额优惠券了"},{"from":116.46,"to":118.29,"content":"最近很少发视频"},{"from":118.29,"to":119.57,"content":"也不知道是为什么"},{"from":119.57,"to":121.75,"content":"有可能是焦虑不想发"},{"from":121.75,"to":123.44,"content":"因为现在的烧烤的话"},{"from":123.44,"to":125,"content":"生意说差不差"},{"from":125,"to":126.32,"content":"说好也不好"},{"from":126.32,"to":129.06,"content":"但是卤肉这方面呢生意还行"},{"from":129.06,"to":130.66,"content":"但是整个市场来说"},{"from":130.66,"to":133.82,"content":"它只能容下这么多的营业额"},{"from":133.82,"to":135.38,"content":"就是营业额不会说太高"},{"from":135.38,"to":137.4,"content":"然后呢利润也不会太高"},{"from":137.4,"to":139.589,"content":"毕竟都是工人"},{"from":139.589,"to":140.869,"content":"都是上班的"},{"from":140.869,"to":142.569,"content":"所以说挺矛盾的"},{"from":142.569,"to":144.309,"content":"导致人也比较焦虑"},{"from":144.309,"to":146.869,"content":"如果说挣的钱还不如上班"},{"from":146.869,"to":149.81,"content":"所以这就很困难"},{"from":149.81,"to":153.45,"content":"导致了这个事情没有办法继续进展下去"},{"from":153.45,"to":154.69,"content":"能做就做"},{"from":154.69,"to":155.64,"content":"做不下去"},{"from":155.64,"to":156.56,"content":"咱也上班"},{"from":156.56,"to":158.54,"content":"总之不管做任何选择"},{"from":158.54,"to":159.52,"content":"做任何事情"},{"from":159.52,"to":162.12,"content":"我想应该都是一种进步"},{"from":162.12,"to":163.99,"content":"这次摆摊嗯"},{"from":163.99,"to":164.97,"content":"投资不大"},{"from":164.97,"to":169.6,"content":"就是说没有赚到我们心目中想要的那个目标"},{"from":169.6,"to":171.22,"content":"但是的话也没有亏本"},{"from":171.22,"to":172.74,"content":"今天我还加了个新品"},{"from":172.74,"to":174.24,"content":"就是这个卤味串串"},{"from":174.24,"to":178.02,"content":"就是最近从去年前年网上就可火的卤味串串"},{"from":178.02,"to":178.94,"content":"就是把蔬菜啊"},{"from":178.94,"to":180.04,"content":"丸子啊串成串"},{"from":180.04,"to":181.66,"content":"然后再拿出去几块钱一串"},{"from":181.66,"to":183.1,"content":"然后我也尝试了一下"},{"from":183.1,"to":186.16,"content":"其实做这个卤味串串比做卤菜"},{"from":186.16,"to":187.18,"content":"卤猪头肉啊"},{"from":187.18,"to":188.92,"content":"卤猪蹄啊这些还要简单"},{"from":188.92,"to":189.78,"content":"还要方便"},{"from":189.78,"to":191.08,"content":"还要快很多"},{"from":191.08,"to":192.42,"content":"就是蔬菜一切"},{"from":192.42,"to":194.54,"content":"然后丸子一下锅一卤出来"},{"from":194.54,"to":195.8,"content":"一窜很快"},{"from":195.8,"to":199.16,"content":"但这个呢我感觉不是长久之计"},{"from":199.16,"to":201.8,"content":"毕竟在工地上都是以肉食为主"},{"from":201.8,"to":203.14,"content":"我可以搭一些"},{"from":203.14,"to":206.52,"content":"但是我个人哦是不怎么喜欢吃这些丸子的"},{"from":206.52,"to":208.32,"content":"我出去吃烧烤或者什么的"},{"from":208.32,"to":209.64,"content":"我都不喜欢买半成品"},{"from":209.64,"to":211.66,"content":"我喜欢买新鲜的现川的"},{"from":211.66,"to":214.18,"content":"现在我们的烧烤摊问题出现在哪里呢"},{"from":214.18,"to":215.18,"content":"都是半成品"},{"from":215.18,"to":217.92,"content":"我不知道吃烧烤人他你们的想法"},{"from":217.92,"to":220.92,"content":"但我知道我不怎么喜欢吃那种半成品"},{"from":220.92,"to":224.509,"content":"特别是那种呃奥尔良口味的呀啊那种"},{"from":224.509,"to":227.029,"content":"反正奇奇怪怪的味道我就吃不来"},{"from":227.029,"to":228.749,"content":"我宁愿诶穿个羊肉串"},{"from":228.749,"to":231.18,"content":"穿个猪肉串直接上火烤"},{"from":231.18,"to":233.42,"content":"我觉得那种我会更喜欢吃"},{"from":233.42,"to":236.3,"content":"但是呢在这边就算是你买半成品"},{"from":236.3,"to":237.98,"content":"去买新鲜的肉回来穿"},{"from":237.98,"to":240.66,"content":"因为穿好了之后再出摊"},{"from":240.66,"to":243.06,"content":"感觉自己穿的这个吧"},{"from":243.06,"to":246.74,"content":"那还不如去买的半成品长得好看"},{"from":246.74,"to":249.739,"content":"现在很多人吃东西"},{"from":249.739,"to":250.679,"content":"它得看卖相"},{"from":250.679,"to":252.699,"content":"那个卖相都长得不好看"},{"from":252.699,"to":253.959,"content":"就没有食欲"},{"from":253.959,"to":255.639,"content":"问题就出现在这里了"},{"from":255.639,"to":257.86,"content":"是不是自己穿半成品"},{"from":257.86,"to":260.64,"content":"也得去买点高科技搅和搅和"},{"from":260.64,"to":262.86,"content":"这样看起来卖相更好"},{"from":262.86,"to":266.56,"content":"或者说是我们技术不到位呢"},{"from":266.56,"to":267.68,"content":"还是怎么办呢"},{"from":267.68,"to":269.4,"content":"就是说你自己穿串的话"},{"from":269.4,"to":271.3,"content":"这个工作量还会增加"},{"from":271.3,"to":272.34,"content":"这个怎么形容呢"},{"from":272.34,"to":274.14,"content":"要需要几个人搭配的很好"},{"from":274.14,"to":275.66,"content":"这个活儿才能干得出来"},{"from":275.66,"to":277.68,"content":"就是跟上班一样"},{"from":277.68,"to":280.4,"content":"流水线一个环节扣着一个环节"},{"from":280.4,"to":282.08,"content":"但现在问题就出在这里了"},{"from":282.08,"to":282.68,"content":"对不对"},{"from":282.68,"to":285.379,"content":"有时候大家伙都是睡醒了才起来"},{"from":285.379,"to":286.099,"content":"等你睡醒起来"},{"from":286.099,"to":286.579,"content":"我跟你说"},{"from":286.579,"to":287.139,"content":"都过年了"},{"from":287.139,"to":288.079,"content":"肉都买不到了"},{"from":288.079,"to":290.359,"content":"所以呢我就是想跟大家伙聊聊天"},{"from":290.359,"to":293.74,"content":"把这些我们遇到的困难分享分享"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:19:03.521Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:18:59.209Z"}}
