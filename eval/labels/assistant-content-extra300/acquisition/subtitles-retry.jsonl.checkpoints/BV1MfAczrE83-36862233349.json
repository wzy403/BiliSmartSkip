{"schemaVersion":1,"bvid":"BV1MfAczrE83","cid":36862233349,"subtitles":[{"from":0,"to":0.68,"content":"2017年"},{"from":0.68,"to":3.4,"content":"洛杉矶网名叫JOE的安全研究员突发奇想"},{"from":3.4,"to":5.08,"content":"将自己的新车牌号设成了闹"},{"from":5.08,"to":6.76,"content":"他原本以为如果交警给他开罚单"},{"from":6.76,"to":8.16,"content":"那系统在读取车牌时呢"},{"from":8.16,"to":10.16,"content":"就会因为毒的闹而触发空值报错"},{"from":10.16,"to":11.52,"content":"从而导致罚单无法录入"},{"from":11.52,"to":12.62,"content":"然而不出意外的话"},{"from":12.62,"to":13.68,"content":"马上就要出意外了"},{"from":13.68,"to":14.28,"content":"2018年"},{"from":14.28,"to":15.76,"content":"他因为忘贴车牌注册标签"},{"from":15.76,"to":17.58,"content":"设了一张60美元的真实罚单"},{"from":17.58,"to":19.02,"content":"而就在他交纳罚款的那一刻"},{"from":19.02,"to":20.5,"content":"系统正式将字符串now"},{"from":20.5,"to":22.42,"content":"与他的真实姓名强绑定在了一起"},{"from":22.42,"to":23.759,"content":"是的全家照都无头账"},{"from":23.759,"to":24.919,"content":"就全被寄到了他头上"},{"from":24.919,"to":25.519,"content":"没过多久"},{"from":25.519,"to":27.719,"content":"金额高达1万2049美元的罚单"},{"from":27.719,"to":29.3,"content":"就把他的邮箱塞得满满当当"},{"from":29.3,"to":30.58,"content":"在2019年的黑客大会上"},{"from":30.58,"to":32.16,"content":"当他分享起成为逆天的经历时"},{"from":32.16,"to":33.44,"content":"现场笑得满地找头"},{"from":33.44,"to":34.58,"content":"这件事归根结底是"},{"from":34.58,"to":35.86,"content":"日常词汇和计算机词汇"},{"from":35.86,"to":37.38,"content":"之间发生了神秘的跨界碰撞"},{"from":37.38,"to":39.18,"content":"那么计算机里还有哪些让人一眼看出来"},{"from":39.18,"to":39.92,"content":"满脸通红"},{"from":39.92,"to":41.62,"content":"疯狂怀疑人生的神秘词汇呢"},{"from":41.62,"to":42.02,"content":"大家好"},{"from":42.02,"to":42.62,"content":"这里是改bug"},{"from":42.62,"to":43.82,"content":"汤姆学长准备好了吗"},{"from":43.82,"to":44.18,"content":"别忘了"},{"from":44.18,"to":46.62,"content":"一键三连大的要来了"},{"from":48.2,"to":50.32,"content":"鲁棒性最摸不着头脑的一集"},{"from":50.32,"to":51.04,"content":"树冠这个词啊"},{"from":51.04,"to":52.74,"content":"可以说是完全不知道是什么意思"},{"from":52.74,"to":53.66,"content":"尤其是近几年啊"},{"from":53.66,"to":55.18,"content":"一些神秘的网络文化的发展"},{"from":55.18,"to":57.5,"content":"更是让这个词听起来像是提醒人去干点什么"},{"from":57.5,"to":59.36,"content":"但这其实其实是一个纯粹的英文音译"},{"from":59.36,"to":61.76,"content":"意思是系统在异常和危险情况下生存的能力"},{"from":61.76,"to":62.48,"content":"1979年"},{"from":62.48,"to":64.68,"content":"南开大学的涂凤生教授和齐永峰教授"},{"from":64.68,"to":66.6,"content":"在信息与控制期刊上发表了论文"},{"from":66.6,"to":68.28,"content":"首次使用了鲁棒性这个音译"},{"from":68.28,"to":69,"content":"但按理来说啊"},{"from":69,"to":71.22,"content":"翻译成健壮性或者稳健性要雅致的多"},{"from":71.22,"to":71.96,"content":"但奇妙的是"},{"from":71.96,"to":73,"content":"这个略带狂野的词"},{"from":73,"to":74.74,"content":"还就硬生生的成为了学术用语"},{"from":74.74,"to":76.06,"content":"那可能就有人要问了"},{"from":76.06,"to":76.98,"content":"听起来这么奇葩"},{"from":76.98,"to":78.36,"content":"就没人想过要抢救一下"},{"from":78.36,"to":79.44,"content":"改改这种叫法吗"},{"from":79.44,"to":80.4,"content":"唉可能还真有"},{"from":80.4,"to":82.54,"content":"但随着时间的发展和学术论文的传播"},{"from":82.54,"to":85.14,"content":"几乎每一门科学学科都涉及到鲁棒性的问题"},{"from":85.14,"to":87.5,"content":"而各家的鲁棒性涉及的又不止一种概念"},{"from":87.5,"to":89.6,"content":"不能简单的用健壮性或者稳健性来表示"},{"from":89.6,"to":91.94,"content":"于是鲁邦信就这么顺理成章的传下来了"},{"from":91.94,"to":93.62,"content":"其实想来这个词汇也很形象"},{"from":93.62,"to":95.48,"content":"听上去有一种五大三粗的强度美"},{"from":95.48,"to":97,"content":"那如果我们再考究一点"},{"from":97,"to":98.5,"content":"查查这个词汇的拉丁语次元"},{"from":98.5,"to":99.6,"content":"神奇的事情发生了"},{"from":99.6,"to":101.32,"content":"robust这个词的拉丁语起源"},{"from":101.32,"to":104.7,"content":"字面意思就是像项目一样强壮的破案了"},{"from":104.7,"to":105.12,"content":"兄弟们"},{"from":105.12,"to":106.76,"content":"原来鲁棒性这个翻译看似随意"},{"from":106.76,"to":109.62,"content":"其实是兼顾了拉丁文原义的音形义三位一体"},{"from":109.62,"to":112.16,"content":"这下不得不佩服老资历们的惊天智慧了"},{"from":112.16,"to":114.22,"content":"所以啊学会这个词就大胆的用"},{"from":114.22,"to":115.96,"content":"下次玩到新游戏手忙脚乱"},{"from":115.96,"to":117.04,"content":"被队友疯狂问候时"},{"from":117.04,"to":117.9,"content":"请大胆的说"},{"from":117.9,"to":118.6,"content":"不是我菜"},{"from":118.6,"to":119.88,"content":"是我这个鲁棒性啊"},{"from":119.88,"to":121.34,"content":"太差了"},{"from":121.34,"to":124.16,"content":"如果在计算机类专业术语的社死界排个名"},{"from":124.16,"to":124.76,"content":"菊花链"},{"from":124.76,"to":126.74,"content":"绝对能以压倒性的优势取得胜利"},{"from":126.74,"to":127.38,"content":"无法想象"},{"from":127.38,"to":128.4,"content":"在严肃的课堂上"},{"from":128.4,"to":129.34,"content":"老教授推了推眼镜"},{"from":129.34,"to":130.36,"content":"一本正经的指着黑板"},{"from":130.36,"to":132.18,"content":"对着台下的同学们念出这个词诗"},{"from":132.18,"to":133.78,"content":"台下的同学们是怎样的表情"},{"from":133.78,"to":135.14,"content":"和其他的奇葩词汇一样"},{"from":135.14,"to":136.62,"content":"这个看起来惊世骇俗的翻译"},{"from":136.62,"to":138.22,"content":"其实有一个纯洁而美好的过去"},{"from":138.22,"to":139.74,"content":"它的英文原词叫daisy chain"},{"from":139.74,"to":140.9,"content":"直译啊雏菊恋"},{"from":140.9,"to":142.74,"content":"这原本是一个极富诗意的词"},{"from":142.74,"to":143.58,"content":"指的是春天里"},{"from":143.58,"to":145.84,"content":"女孩们把一朵朵小雏菊收尾串联起起来"},{"from":145.84,"to":147,"content":"变成一个美丽的花环"},{"from":147,"to":148.94,"content":"所以啊在计算机网络拓扑结构中"},{"from":148.94,"to":151.04,"content":"这种A连着BB连着C首尾相连"},{"from":151.04,"to":152.24,"content":"连成一串的连接方式"},{"from":152.24,"to":153.8,"content":"就被浪漫的命名为daisy chain"},{"from":153.8,"to":155.38,"content":"现在这个词啊在工业自动化"},{"from":155.38,"to":155.9,"content":"网络通信"},{"from":155.9,"to":157.66,"content":"电力分配等领域都有一定的运用"},{"from":157.66,"to":158.42,"content":"而对于我们来说"},{"from":158.42,"to":159.22,"content":"最常见的地方"},{"from":159.22,"to":161.14,"content":"其实出现在你想扩展你的屏幕的时候"},{"from":161.14,"to":163.28,"content":"是的就是DP接口的菊花链扩展技术"},{"from":163.28,"to":165.04,"content":"如果在合适的设备上使用DP线"},{"from":165.04,"to":166.52,"content":"把三台显示器串在一起"},{"from":166.52,"to":167.62,"content":"就能成为一条菊花链"},{"from":167.62,"to":168.66,"content":"这样既能扩展屏幕"},{"from":168.66,"to":169.96,"content":"离线也会变得非常方便"},{"from":169.96,"to":171.8,"content":"这些资料的收集也多亏我新换的平板"},{"from":171.8,"to":172.88,"content":"整理起来流畅了不少"},{"from":172.88,"to":173.04,"content":"诶"},{"from":173.04,"to":174.42,"content":"大家换新后旧要怎么处理"},{"from":174.42,"to":176.98,"content":"像我那台旧平板找转转上门回收了4400多"},{"from":176.98,"to":178.18,"content":"转转是一个很好的买家"},{"from":178.18,"to":179.3,"content":"不仅回收品类丰富"},{"from":179.3,"to":180.5,"content":"而且变现特别快"},{"from":180.5,"to":182.66,"content":"像手机平板switch这样的数码产品"},{"from":182.66,"to":184.1,"content":"甚至是吉他台球杆之类"},{"from":184.1,"to":185.1,"content":"不好卖的小众品类"},{"from":185.1,"to":186.54,"content":"但他那儿都能随时换成钱"},{"from":186.54,"to":188.34,"content":"比起之前挂网商一直卖不出去"},{"from":188.34,"to":189.92,"content":"还得跟买家斗智斗勇转转"},{"from":189.92,"to":192.46,"content":"特别适合我这种想快速变现又图省事的人"},{"from":192.46,"to":193.7,"content":"我替你们都试过了"},{"from":193.7,"to":194.98,"content":"回收价格也很不错"},{"from":194.98,"to":197.1,"content":"我之前那款欧米茄还卖了2万4000多呢"},{"from":197.1,"to":198.74,"content":"要我说又懒得处理的闲置"},{"from":198.74,"to":199.78,"content":"就直接卖给转转"},{"from":199.78,"to":201.78,"content":"钱到手才是硬道理"},{"from":202.28,"to":203.96,"content":"呃回到刚才的话题上"},{"from":203.96,"to":205.78,"content":"雏菊恋这个名字是不是听起来还不错"},{"from":205.78,"to":208.4,"content":"问题恰恰就出在把他引进国内的那个时代"},{"from":208.4,"to":209.68,"content":"在上世纪八九十年代"},{"from":209.68,"to":210.88,"content":"老一辈的翻译专家们"},{"from":210.88,"to":212.56,"content":"在翻译厚厚的国际标准文档时"},{"from":212.56,"to":215.2,"content":"可能觉得直译苦菊恋三个字读起来有些拗口啊"},{"from":215.2,"to":216.4,"content":"不太符合我们的语言习惯"},{"from":216.4,"to":218.1,"content":"于是为了追求学术词汇的简练"},{"from":218.1,"to":219.36,"content":"一位脑子里大笔一挥"},{"from":219.36,"to":221.16,"content":"这玩意以后就叫菊花恋了"},{"from":221.16,"to":222.48,"content":"要知道在那个年代"},{"from":222.48,"to":224.3,"content":"菊花还只是一种植物"},{"from":224.3,"to":225.16,"content":"谁都没有想到"},{"from":225.16,"to":226.06,"content":"谁都没有想到"},{"from":226.06,"to":226.98,"content":"到了21世纪"},{"from":226.98,"to":227.72,"content":"互联网文化"},{"from":227.72,"to":230.14,"content":"直接给大伙来了个大的一个不可名状的含义"},{"from":230.14,"to":231.7,"content":"不知何时戴在了菊花身上"},{"from":231.7,"to":233.42,"content":"不光菊花已经不是原来的菊花了"},{"from":233.42,"to":235.3,"content":"整个词语看起来更是有了别样的意味"},{"from":235.3,"to":235.76,"content":"这下坏了"},{"from":235.76,"to":238.08,"content":"当一个清纯的牛马打开交换机的配置文档"},{"from":238.08,"to":238.44,"content":"看到"},{"from":238.44,"to":239.66,"content":"为了防止环路风暴"},{"from":239.66,"to":242.26,"content":"请避免在菊花链的末端进行盲目拔插"},{"from":242.26,"to":243.26,"content":"这这不对吧"},{"from":243.26,"to":244.9,"content":"我看的真的是技术文档吗"},{"from":244.9,"to":247.24,"content":"这就导致现在很多硬件工程师和汽车工程师"},{"from":247.24,"to":248.34,"content":"在说到这个词时呢"},{"from":248.34,"to":249.9,"content":"可能都要经过一番心理斗争"},{"from":249.9,"to":250.82,"content":"为了避免尬住啊"},{"from":250.82,"to":252.5,"content":"也有人改口叫吉连或者串联"},{"from":252.5,"to":253.82,"content":"所以啊下次看到这个词"},{"from":253.82,"to":254.64,"content":"请不要笑"},{"from":254.64,"to":257.14,"content":"这真的是个正经词汇啊"},{"from":258.19,"to":260.47,"content":"少年你经受过被骗的滋味吧"},{"from":260.47,"to":261.47,"content":"啊没有啊"},{"from":261.47,"to":263.59,"content":"那今天透明这个词绝对能骗你一回"},{"from":263.59,"to":264.99,"content":"在咱们日常汉语的语境里"},{"from":264.99,"to":265.83,"content":"透明的意思是什么"},{"from":265.83,"to":266.84,"content":"是公开可见"},{"from":266.84,"to":267.5,"content":"毫无保留"},{"from":267.5,"to":268.84,"content":"比如梦里的老板对你说"},{"from":268.84,"to":270.94,"content":"咱们公司的财务状况向全体员工透明"},{"from":270.94,"to":273.26,"content":"意思不就是账本孙一查主打一个坦诚吗"},{"from":273.26,"to":274.14,"content":"但在计算机领域"},{"from":274.14,"to":275.98,"content":"这个词的意思似乎恰恰相反"},{"from":275.98,"to":277.46,"content":"当你在教材上看到这样一句话"},{"from":277.46,"to":280.16,"content":"底层的TCPIP协议对普通用户是透明的"},{"from":280.16,"to":280.7,"content":"何异味"},{"from":280.7,"to":282.84,"content":"难道真的把底层细节全公开给用户看吗"},{"from":282.84,"to":284.72,"content":"发个微信还能看见数据是怎么封装呢"},{"from":284.72,"to":285.46,"content":"哎错了"},{"from":285.46,"to":287.7,"content":"在计算机语境里说一个东西对你透明"},{"from":287.7,"to":289.58,"content":"他的意思是你根本看不见它"},{"from":289.58,"to":291.18,"content":"你也完全感知不到它的存在"},{"from":291.18,"to":292.14,"content":"那有人就要问了"},{"from":292.14,"to":293.06,"content":"完全相反的意思"},{"from":293.06,"to":294.52,"content":"咋就用上了同一个词汇呢"},{"from":294.52,"to":295.72,"content":"但其实也不是相反"},{"from":295.72,"to":297,"content":"毕竟计算机里的透明"},{"from":297,"to":298.44,"content":"是对用户完全看不见的事物"},{"from":298.44,"to":299.52,"content":"描述了物理属性"},{"from":299.52,"to":301,"content":"好比你站在屋里看着窗外"},{"from":301,"to":302.36,"content":"你能清晰的看到外面的风景"},{"from":302.36,"to":303.74,"content":"但是你看不见玻璃本身"},{"from":303.74,"to":304.82,"content":"因为玻璃是透明的"},{"from":304.82,"to":307.38,"content":"所以他隐身了底层的脏活累活全都让他干了"},{"from":307.38,"to":308.98,"content":"绝不搬出一堆黑框框来烦你"},{"from":308.98,"to":309.62,"content":"唉还不快"},{"from":309.62,"to":310.42,"content":"谢谢程旭哥"},{"from":310.42,"to":311.06,"content":"长知识了吧"},{"from":311.06,"to":312.34,"content":"其实你给汤姆投两个硬币"},{"from":312.34,"to":314.18,"content":"这两个硬币变成汤姆的0.2个硬币"},{"from":314.18,"to":316.1,"content":"这个过程对同学们来说也是透明的"},{"from":316.1,"to":317.14,"content":"那多的去哪里了"},{"from":317.14,"to":317.44,"content":"诶"},{"from":317.44,"to":319.58,"content":"其实变成20经验降到你的经验条上了"},{"from":319.58,"to":320.74,"content":"咋样神奇吧"},{"from":320.74,"to":322.78,"content":"嘿嘿是的"},{"from":322.78,"to":324.58,"content":"看起来又是两个八竿子打不着的东西"},{"from":324.58,"to":325.24,"content":"组合在一起"},{"from":325.24,"to":326.48,"content":"但这玩意既不是零食"},{"from":326.48,"to":328.3,"content":"也不是说语法要装唐阴你一手"},{"from":328.3,"to":329.72,"content":"所以这个词到底是啥意思呢"},{"from":329.72,"to":331.44,"content":"哎这就得回到1964年"},{"from":331.44,"to":333.36,"content":"问问英国的计算机科学家彼得兰丁"},{"from":333.36,"to":335.16,"content":"他当时正在研究早期的编程语言"},{"from":335.16,"to":337.56,"content":"当时的编程语言啊讲的就是一个反人类机器"},{"from":337.56,"to":338.88,"content":"怎么想人就得怎么写"},{"from":338.88,"to":340.08,"content":"冷不丁就机魂不悦"},{"from":340.08,"to":341.78,"content":"但马种长不说还晦涩难懂"},{"from":341.78,"to":344.3,"content":"所以蓝丁在设计一种名为ASWIM"},{"from":344.3,"to":345.56,"content":"概念性编程语言时"},{"from":345.56,"to":347.94,"content":"引入了一种极其符合人类直觉的简写语法"},{"from":347.94,"to":348.42,"content":"他指出"},{"from":348.42,"to":350.94,"content":"这些简写语法对于机器底层的计算逻辑来说"},{"from":350.94,"to":352.7,"content":"没有增加任何实质性的新功能"},{"from":352.7,"to":353.66,"content":"但对程序员来说"},{"from":353.66,"to":354.86,"content":"它能极大的减少代码量"},{"from":354.86,"to":356.9,"content":"让阅读和编写变得像吃糖一样的愉悦"},{"from":356.9,"to":358,"content":"于是他大笔一挥"},{"from":358,"to":360.24,"content":"在学术论文中写下了syntactic sugar"},{"from":360.24,"to":361.88,"content":"诶语法糖就这么诞生了"},{"from":361.88,"to":362.78,"content":"在计算机看来啊"},{"from":362.78,"to":364.38,"content":"一切代码最终都要变成零和一"},{"from":364.38,"to":365.9,"content":"机器确实不需要觉得舒服"},{"from":365.9,"to":367.46,"content":"但敲代码的牛马可得哄啊"},{"from":367.46,"to":368.3,"content":"举个简单的例子"},{"from":368.3,"to":370.42,"content":"假设你口袋里的钱每天要增加一块钱"},{"from":370.42,"to":372.86,"content":"没有糖的语法就是直接写出A等于A加一"},{"from":372.86,"to":374.9,"content":"有种把大象拿出来再塞进冰箱里的美"},{"from":374.9,"to":375.78,"content":"而有了糖的写法"},{"from":375.78,"to":377.82,"content":"就变成了A加等于或者A加加"},{"from":377.82,"to":380.34,"content":"再比如以前你要遍历查找一个列表里的东西"},{"from":380.34,"to":381.82,"content":"要写一个长达五行的for循环"},{"from":381.82,"to":383.22,"content":"然后小心翼翼的控制计数器"},{"from":383.22,"to":384.86,"content":"一不注意就给咱报个月见异常"},{"from":384.86,"to":385.66,"content":"那现在很多语言"},{"from":385.66,"to":387.84,"content":"比如java则提供了一颗名为poor eh的糖"},{"from":387.84,"to":388.9,"content":"一行代码就能搞定"},{"from":388.9,"to":389.38,"content":"不得不说"},{"from":389.38,"to":390.78,"content":"因为键盘和剑鞘的耐久度"},{"from":390.78,"to":392.54,"content":"语法糖还是做了很大的贡献的"},{"from":392.54,"to":394.62,"content":"但这其实完全没有改变程序的执行效率"},{"from":394.62,"to":395.92,"content":"甚至在编译器进行编译时"},{"from":395.92,"to":397.08,"content":"还会发动无情铁手"},{"from":397.08,"to":399.16,"content":"给代码变回更基础原始的语法结构"},{"from":399.16,"to":400.34,"content":"这个过程也很形象"},{"from":400.34,"to":401.22,"content":"叫拖堂"},{"from":401.22,"to":403.9,"content":"所以啊这整个过程就纯粹是为了哄成全"},{"from":403.9,"to":404.76,"content":"开心一点啦"},{"from":404.76,"to":405.04,"content":"好了"},{"from":405.04,"to":406.24,"content":"今天的盘点就到这里"},{"from":406.24,"to":408.24,"content":"同学们还觉得计算机里有什么神秘的词汇"},{"from":408.24,"to":410.02,"content":"也可以在评论区打出来和我们一起讨论"},{"from":410.02,"to":411.36,"content":"那如果你喜欢这期视频的话"},{"from":411.36,"to":412.94,"content":"不要忘了给汤姆一个一键三连"},{"from":412.94,"to":414.9,"content":"也不要忘了把这期视频转发给你身边的人"},{"from":414.9,"to":415.48,"content":"点赞越多"},{"from":415.48,"to":416.1,"content":"更新越快"},{"from":416.1,"to":417.72,"content":"我们下期视频再见"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:20:46.167Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:20:40.925Z"}}
