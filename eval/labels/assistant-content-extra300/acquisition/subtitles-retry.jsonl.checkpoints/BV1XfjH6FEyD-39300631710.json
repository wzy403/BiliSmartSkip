{"schemaVersion":1,"bvid":"BV1XfjH6FEyD","cid":39300631710,"subtitles":[{"from":0,"to":1,"content":"在观看这期视频前"},{"from":1,"to":3.33,"content":"你必须抛开对艾因的某些刻板印象"},{"from":3.33,"to":3.65,"content":"Hello"},{"from":3.65,"to":4.01,"content":"大家好"},{"from":4.01,"to":4.75,"content":"这里是白叔"},{"from":4.75,"to":6.45,"content":"欢迎收看本期的桂冠之下"},{"from":6.45,"to":7.57,"content":"本期要介绍的萌王"},{"from":7.57,"to":9.57,"content":"可能也是历代萌王里最出圈的一位"},{"from":9.57,"to":12.49,"content":"靠着无数的梗图表情包时常活跃于互联网"},{"from":12.49,"to":14.67,"content":"甚至成为了某种现象级的文化符号"},{"from":14.67,"to":17.39,"content":"可这个符号的底色远比表情包复杂的多"},{"from":17.39,"to":19.01,"content":"那么我现在必须隆重向你介绍"},{"from":19.01,"to":21.72,"content":"2024年的世萌萌王千早爱因"},{"from":21.72,"to":23.38,"content":"另外如果你喜欢我的视频的话"},{"from":23.38,"to":24.56,"content":"可以点一个免费的关注吗"},{"from":24.56,"to":25.88,"content":"这对我真的很重要"},{"from":25.88,"to":28.04,"content":"如果你是一位资深的少女乐队爱好者"},{"from":28.04,"to":29.04,"content":"那你一定不难发现"},{"from":29.04,"to":30.4,"content":"在传统少女乐队叙事里"},{"from":30.4,"to":31.72,"content":"主角们总是先爱上音乐"},{"from":31.72,"to":32.44,"content":"再去组乐队"},{"from":32.44,"to":34.76,"content":"而且大多数的角色都有一个比较鲜明的标签"},{"from":34.76,"to":37.32,"content":"比如孤独摇滚里波奇酱的社恐天才"},{"from":37.32,"to":38.599,"content":"还有梁的面瘫脸"},{"from":38.599,"to":40.439,"content":"那么我们爱因组乐队的动机是什么呢"},{"from":40.439,"to":41.839,"content":"他只是因为大家都在玩"},{"from":41.839,"to":42.94,"content":"自己也想去玩而已"},{"from":42.94,"to":44.1,"content":"纵观整部MGO"},{"from":44.1,"to":44.78,"content":"你几乎找不到"},{"from":44.78,"to":46.64,"content":"艾因因为热爱音乐而弹吉他的瞬间"},{"from":46.64,"to":48.1,"content":"甚至出现了因为练吉他太难"},{"from":48.1,"to":48.46,"content":"太麻烦"},{"from":48.46,"to":49.24,"content":"不想练的情况"},{"from":49.24,"to":51.14,"content":"这放到其他乐队翻绝对是大忌啊"},{"from":51.14,"to":53.34,"content":"而在多为扁平角色的少女乐队番里"},{"from":53.34,"to":55.48,"content":"艾因则被刻画的更像是一个真正的人"},{"from":55.48,"to":57.6,"content":"她虚荣逃避3分钟热度"},{"from":57.6,"to":59.34,"content":"这些都是不体面和有些尴尬的"},{"from":59.34,"to":60.97,"content":"因为我们都在自己身上见过"},{"from":60.97,"to":62.17,"content":"再来看看乐队的成员"},{"from":62.17,"to":63.01,"content":"一个臭企鹅"},{"from":63.01,"to":64.01,"content":"一个纯情压力怪"},{"from":64.01,"to":65.09,"content":"一个心机腹黑女"},{"from":65.09,"to":66.11,"content":"还有一个动物朋友"},{"from":66.11,"to":67.65,"content":"在这支全是神人的乐队里"},{"from":67.65,"to":69.21,"content":"艾因明显是最像人的一个"},{"from":69.21,"to":71.49,"content":"然后三位C团遗老一言不合就开爆"},{"from":71.49,"to":72.82,"content":"比苦力怕还能爆"},{"from":72.82,"to":74.02,"content":"想要维持他们的关系"},{"from":74.02,"to":75.9,"content":"就必须要靠一位外人来介入"},{"from":75.9,"to":77.7,"content":"但你又不可能让动物朋友来"},{"from":77.7,"to":79.84,"content":"所以这个重任就落在了艾因头上"},{"from":79.84,"to":81.88,"content":"然后艾因还真给整支队伍拉起来了"},{"from":81.88,"to":82.72,"content":"C团散了之后"},{"from":82.72,"to":85.1,"content":"这三位C团遗老多多少少都有点PTSD"},{"from":85.1,"to":86.78,"content":"艾因跟C团半毛钱关系都没有"},{"from":86.78,"to":88.22,"content":"硬是把这支队伍给拼起来了"},{"from":88.22,"to":88.78,"content":"就这样"},{"from":88.78,"to":89.82,"content":"甚至还被当成外人说"},{"from":89.82,"to":90.56,"content":"不需要他"},{"from":90.56,"to":91.58,"content":"说白了没有"},{"from":91.58,"to":93.13,"content":"艾因他们还组个鸡毛乐队"},{"from":93.13,"to":94.91,"content":"传统的主角通常跟太阳一样"},{"from":94.91,"to":96.51,"content":"他们主动拥抱队友的创伤"},{"from":96.51,"to":98.63,"content":"像太阳一样不求回报的照耀所有人"},{"from":100.62,"to":101.9,"content":"通过第一集艾因的独白"},{"from":101.9,"to":102.5,"content":"我们可以知道"},{"from":102.5,"to":104.56,"content":"艾因的粘合则是带有一丝算计的底色"},{"from":104.56,"to":105.36,"content":"就像接近灯"},{"from":105.36,"to":107.42,"content":"只是因为这只臭企鹅人畜无害而已"},{"from":107.42,"to":109.28,"content":"而且艾因的善意输出不是单向的"},{"from":109.28,"to":110.24,"content":"他需要回报"},{"from":110.24,"to":111.68,"content":"在听到素食只想重组C团"},{"from":111.68,"to":112.94,"content":"而自己只是个外人的时候"},{"from":112.94,"to":114.18,"content":"艾因选择直接跑路"},{"from":114.18,"to":115.52,"content":"他的存在感来自被需要"},{"from":115.52,"to":116.18,"content":"简单来说"},{"from":116.18,"to":117.28,"content":"传统主角是给予者"},{"from":117.28,"to":118.43,"content":"艾因则是交换者"},{"from":118.43,"to":119.87,"content":"听起来可能有点贬低爱因"},{"from":119.87,"to":122.37,"content":"但这种关系实际上比给予关系更健康和真实"},{"from":122.37,"to":124.79,"content":"给予关系建立在一种不对等的神性假设上"},{"from":124.79,"to":126.55,"content":"而交换关系建立在两个平等的人"},{"from":126.55,"to":127.84,"content":"各取所需的基础上"},{"from":127.84,"to":129.34,"content":"艾因从来不想当神"},{"from":129.34,"to":130.44,"content":"他想当一个人"},{"from":130.44,"to":132.98,"content":"还有就是艾因的成长轨迹几乎是反传统的"},{"from":132.98,"to":134.04,"content":"正常的成长轨迹"},{"from":134.04,"to":135.06,"content":"成长是线性的"},{"from":135.06,"to":135.83,"content":"向上的"},{"from":135.83,"to":137.23,"content":"第一集她可能有些笨拙"},{"from":137.23,"to":138.03,"content":"到了最后一集"},{"from":138.03,"to":139.77,"content":"他一定站在聚光灯下闪闪发光"},{"from":139.77,"to":140.61,"content":"而爱因不同"},{"from":140.61,"to":142.52,"content":"她在初中时就是别人眼里的完美少女"},{"from":142.52,"to":144.44,"content":"在组乐队时也想当吉他兼主唱"},{"from":144.44,"to":145.98,"content":"很多事也是想让自己主导"},{"from":145.98,"to":148.28,"content":"但到了后期则是将主唱让给了灯"},{"from":148.28,"to":149.72,"content":"为了乐队做了很多的让步"},{"from":149.72,"to":150.08,"content":"退步"},{"from":150.08,"to":151.42,"content":"包括在母鸡卡里也一样"},{"from":151.42,"to":154.24,"content":"所以爱因的成长轨迹是从想站在聚光灯下"},{"from":154.24,"to":155.18,"content":"变成接受自己"},{"from":155.18,"to":156.38,"content":"可以不在聚光灯下"},{"from":156.38,"to":158.04,"content":"话说各位还在找能互动"},{"from":158.04,"to":159.7,"content":"有剧情的二次元AI女友吗"},{"from":159.7,"to":162.96,"content":"心跳原力这不就安排上了金发齐刘海的女仆"},{"from":162.96,"to":165.56,"content":"野木奈子是自带中二属性的天然呆"},{"from":165.56,"to":166.32,"content":"甜食控"},{"from":166.32,"to":167.16,"content":"元气软萌"},{"from":167.16,"to":167.78,"content":"爱撒娇"},{"from":167.78,"to":169.68,"content":"日常陪伴鲜活又治愈"},{"from":169.68,"to":172.1,"content":"白发狐娘走妩媚御姐路线"},{"from":172.1,"to":174.18,"content":"胡耳九尾搭配温柔声线"},{"from":174.18,"to":175.4,"content":"腹黑又懂人心"},{"from":175.4,"to":178.06,"content":"柔声唤你少爷氛围感直接拉满"},{"from":178.06,"to":179.9,"content":"两位角色均有专属互动剧情"},{"from":179.9,"to":180.7,"content":"还支持心跳"},{"from":180.7,"to":181.93,"content":"原力2pro联动"},{"from":181.93,"to":183.37,"content":"再谈一下麋鹿这个主题"},{"from":183.37,"to":184.79,"content":"买go的核心意向是麋鹿"},{"from":184.79,"to":186.81,"content":"五个不知道自己要往哪去的人凑在一起"},{"from":186.81,"to":188.21,"content":"边走边停边犹豫"},{"from":188.21,"to":190.759,"content":"而传统的是执行有一个明确的目标"},{"from":190.759,"to":192.879,"content":"观众从一开始就知道终点在哪里"},{"from":192.879,"to":195.039,"content":"看的就是角色们如何到达"},{"from":195.039,"to":198.34,"content":"爱因跟麋鹿这个意象的适配度比任何人都高"},{"from":198.34,"to":200,"content":"因为他从来没有一个清晰的目标"},{"from":200,"to":201.72,"content":"组乐队是随大流"},{"from":201.72,"to":202.58,"content":"留在MGO"},{"from":202.58,"to":203.88,"content":"也是被灯拉回来的"},{"from":203.88,"to":205.91,"content":"他活在一个走一步看一步的状态里"},{"from":205.91,"to":207.71,"content":"但这个最没有方向感的人"},{"from":207.71,"to":209.77,"content":"却成了整个团队里最踏实的那个"},{"from":209.77,"to":211.27,"content":"因为迷路的人有一个特点"},{"from":211.27,"to":212.37,"content":"他们不看远方"},{"from":212.37,"to":215.339,"content":"他们只看脚下爱因不看一辈子的终点在哪里"},{"from":215.339,"to":217.179,"content":"他就管今天要不要去练习宿舍"},{"from":217.179,"to":218.079,"content":"今天心情怎么样"},{"from":218.079,"to":219.279,"content":"登今天有没有好好吃饭"},{"from":219.279,"to":222.399,"content":"这些琐碎的脚下的东西被他一个一个捡起来"},{"from":222.399,"to":223.359,"content":"铺成了一条路"},{"from":223.359,"to":225.86,"content":"其他四个人多少都在看远方灯"},{"from":225.86,"to":228.02,"content":"看的是能不能不伤害任何人利息"},{"from":228.02,"to":229.86,"content":"看的是能不能做到最好速事"},{"from":229.86,"to":231.269,"content":"看的是能不能回到过去"},{"from":231.269,"to":233.289,"content":"乐奈看的是有没有有趣的东西"},{"from":233.289,"to":234.809,"content":"只有艾因在看当下"},{"from":234.809,"to":235.429,"content":"这种务实"},{"from":235.429,"to":238.35,"content":"让他成了所有迷路者里面唯一真正在走路的人"},{"from":238.35,"to":239.63,"content":"再聊聊世萌爱因"},{"from":239.63,"to":240.71,"content":"在整个2024赛季"},{"from":240.71,"to":242.05,"content":"他一度豪取30连胜"},{"from":242.05,"to":244.03,"content":"虽在胜者组半决赛以约1000票之差"},{"from":244.03,"to":244.83,"content":"负于丰川翔子"},{"from":244.83,"to":245.57,"content":"跌入败者组"},{"from":245.57,"to":247.58,"content":"但在败者组决赛再次面对翔子时"},{"from":247.58,"to":249.58,"content":"他反以约1400票的优势获胜"},{"from":249.58,"to":250.22,"content":"完成复仇"},{"from":250.22,"to":250.82,"content":"挺进决赛"},{"from":250.82,"to":251.64,"content":"然后到了决赛"},{"from":251.64,"to":253.82,"content":"对上了同样是少女乐队和粉毛的波奇酱"},{"from":253.82,"to":256.18,"content":"不得不说那几年真就是少女乐队大乱斗啊"},{"from":256.18,"to":258.06,"content":"最后艾因以微弱的优势获胜"},{"from":258.06,"to":260.85,"content":"成为了击球山林之后第二位少女乐队萌王"},{"from":260.85,"to":263.47,"content":"最后再聊聊艾因和传统少女乐队的区别"},{"from":263.47,"to":266.05,"content":"传统少女乐队写的是我要成为什么样的人"},{"from":266.05,"to":268.23,"content":"爱因写的则是我这样也行吧"},{"from":268.23,"to":269.39,"content":"前者是有志气的"},{"from":269.39,"to":270.39,"content":"后者是和解的"},{"from":270.39,"to":272.51,"content":"前者相信努力可以抵达某个确定的彼岸"},{"from":272.51,"to":274.29,"content":"后者承认可能永远到不了彼岸"},{"from":274.29,"to":276.32,"content":"但岸边的水也挺暖和的"},{"from":276.32,"to":278.08,"content":"艾因身上没有那种燃的东西"},{"from":278.08,"to":279,"content":"它不热血"},{"from":279,"to":279.86,"content":"不纯粹"},{"from":279.86,"to":281.82,"content":"不为了什么崇高的目标燃烧自己"},{"from":281.82,"to":283.62,"content":"他就是在那一会儿冒个泡"},{"from":283.62,"to":284.52,"content":"一会缩回去"},{"from":284.52,"to":285.6,"content":"一会被人拉一把"},{"from":285.6,"to":286.75,"content":"一会拉别人一把"},{"from":286.75,"to":289.05,"content":"这种角色放在10年前不会被写成主角"},{"from":289.05,"to":290.419,"content":"因为看起来不够有戏"},{"from":290.419,"to":292.279,"content":"但现在她成了最受欢迎的那个"},{"from":292.279,"to":293.259,"content":"因为大家看明白了"},{"from":293.259,"to":295.119,"content":"我们自己的青春里没有那么多武道馆"},{"from":295.119,"to":297.139,"content":"更多的就是这种我也不知道要去哪"},{"from":297.139,"to":298.48,"content":"但先跟你走一段的状态"},{"from":298.48,"to":299.08,"content":"千早爱音"},{"from":299.08,"to":301.38,"content":"把少女乐队这个类型从一个讲梦想的故事"},{"from":301.38,"to":302.92,"content":"变成了一个讲维系的故事"},{"from":302.92,"to":304.9,"content":"而维系比梦想难多了"},{"from":304.9,"to":306.14,"content":"梦想只要冲就行了"},{"from":306.14,"to":307.58,"content":"维系需要你一次次的选择"},{"from":307.58,"to":308.08,"content":"不放手"},{"from":308.08,"to":310.7,"content":"爱因在每个可以放手的关口都选择了不放手"},{"from":310.7,"to":312.8,"content":"这大概就是他跟所有传统主角之间"},{"from":312.8,"to":314.1,"content":"最根本的那条界线"},{"from":314.1,"to":316.06,"content":"千早爱因这个角色有意思的地方"},{"from":316.06,"to":316.92,"content":"不在他有多好"},{"from":316.92,"to":317.96,"content":"在他有多普通"},{"from":317.96,"to":319.66,"content":"这个普通不是谦虚的说法"},{"from":319.66,"to":321.84,"content":"是真的普通普通到他的缺点"},{"from":321.84,"to":324.37,"content":"每一个人都能在自己身上找到对应虚荣心"},{"from":324.37,"to":325.15,"content":"想被关注"},{"from":325.15,"to":327.31,"content":"遇到困难先想跑计划做的漂亮"},{"from":327.31,"to":328.45,"content":"但执行的一塌糊涂"},{"from":328.45,"to":329.43,"content":"这些东西不光彩"},{"from":329.43,"to":332.23,"content":"但真实世萌夺冠这件事放在他身上"},{"from":332.23,"to":333.97,"content":"本身就有一种错位的喜剧感"},{"from":333.97,"to":335.67,"content":"一个连留学都搞不定的人"},{"from":335.67,"to":338.53,"content":"一个因为怕被问你怎么回来了就换学校的人"},{"from":338.53,"to":341.73,"content":"最后被一群素不相识的人投票投成了年度第一"},{"from":341.73,"to":343.25,"content":"这个结果如果写成小说"},{"from":343.25,"to":344.69,"content":"读者大概会觉得太刻意了"},{"from":344.69,"to":345.73,"content":"但它就是发生了"},{"from":345.73,"to":347.56,"content":"因为观众在他身上看到了自己"},{"from":347.56,"to":348.7,"content":"这话说出来很俗"},{"from":348.7,"to":350.2,"content":"但事情就是这么回事"},{"from":350.2,"to":351.58,"content":"那些投票给艾因的人"},{"from":351.58,"to":354.74,"content":"有多少是真的觉得他最值得这个称号"},{"from":354.74,"to":356.66,"content":"恐怕更多的是一种下意识的认同"},{"from":356.66,"to":357.58,"content":"这个人跟我一样"},{"from":357.58,"to":358.46,"content":"搞砸过事情"},{"from":358.46,"to":359.3,"content":"逃避过问题"},{"from":359.3,"to":361.34,"content":"在某个深夜觉得自己什么都不是"},{"from":361.34,"to":362.54,"content":"但他还在往前走"},{"from":362.54,"to":363.44,"content":"走的不太好看"},{"from":363.44,"to":364.74,"content":"甚至边走边回头"},{"from":364.74,"to":365.83,"content":"但总算没有停"},{"from":365.83,"to":368.29,"content":"这种认同跟传统盟战里那种我喜欢它"},{"from":368.29,"to":369.91,"content":"因为它很完美的认同不太一样"},{"from":369.91,"to":371.01,"content":"后者更像追光"},{"from":371.01,"to":372.55,"content":"前者更像对着一面镜子"},{"from":372.55,"to":374.57,"content":"艾因是一面不那么光亮的镜子"},{"from":374.57,"to":376.53,"content":"照出来的东西也不那么光鲜"},{"from":376.53,"to":379.21,"content":"但恰恰因为这样才让人愿意多看几眼"},{"from":379.21,"to":381.57,"content":"千早爱因证明了迷路的人可以走的很远"},{"from":381.57,"to":383.53,"content":"远到他自己大概也没想过的高度"},{"from":383.53,"to":385.77,"content":"他的加冕本质上不是对优秀的加冕"},{"from":385.77,"to":387.22,"content":"是对还在走的加冕"},{"from":387.22,"to":388.1,"content":"还在走"},{"from":388.1,"to":389.28,"content":"就算一步三回头"},{"from":389.28,"to":390.54,"content":"就算不知道要去哪"},{"from":390.54,"to":391.98,"content":"就算经常走的不太好看"},{"from":391.98,"to":392.96,"content":"这些都没关系"},{"from":392.96,"to":395.33,"content":"因为走本身就是全部的答案"},{"from":395.33,"to":398.17,"content":"桂冠戴在那个愿意陪你一起迷路的人头上"},{"from":398.17,"to":401.2,"content":"可能比带在任何完美的人头上都更合适"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:32:42.587Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:32:36.880Z"}}
