{"schemaVersion":1,"bvid":"BV1vd2UYXEZk","cid":26243629115,"subtitles":[{"from":0.04,"to":2.44,"content":"前段时间啊我们发布了一期视频来聊"},{"from":2.44,"to":4.32,"content":"为什么中国流行吃炒菜"},{"from":4.32,"to":5.96,"content":"当时碍于篇幅限制"},{"from":5.96,"to":7.98,"content":"只能从国内视角去探讨"},{"from":7.98,"to":9.76,"content":"炒菜在中国诞生的原因"},{"from":9.76,"to":11.8,"content":"少了点国际视野的文化比较"},{"from":11.8,"to":13,"content":"很多观众也表示啊"},{"from":13,"to":15.88,"content":"对为什么炒菜只在中国流行感到好奇"},{"from":15.88,"to":19.009,"content":"于是我们决定再出一期视频来做补充"},{"from":19.009,"to":22.669,"content":"实际上炒在西餐烹饪中还是挺常见的"},{"from":22.669,"to":26.689,"content":"法餐中SD就是食材在油脂里跳跃的意思"},{"from":26.689,"to":28.809,"content":"这种技法最早出现在17世纪"},{"from":28.809,"to":30.609,"content":"比如这道黄油蔗菇肉"},{"from":30.609,"to":32.6,"content":"先用平底锅融化黄油"},{"from":32.6,"to":33.9,"content":"放入浙菇肉柳"},{"from":33.9,"to":36.94,"content":"当一面熟了以后再颠锅料理另外一面"},{"from":36.94,"to":38.2,"content":"这与其说是炒啊"},{"from":38.2,"to":40.36,"content":"不如说是煎或者是小火翻炒"},{"from":40.36,"to":41.02,"content":"那同样"},{"from":41.02,"to":42.42,"content":"许多意大利菜在烹饪"},{"from":42.42,"to":45.28,"content":"趁前期就对香料或者蔬菜处理的时候"},{"from":45.28,"to":46.7,"content":"也会用到小火翻炒"},{"from":46.7,"to":48.08,"content":"不过与中餐相比啊"},{"from":48.08,"to":50.9,"content":"炒在西餐中的地位远不如煎和烤"},{"from":50.9,"to":52.64,"content":"只能算是小透明般的存在"},{"from":52.64,"to":53.24,"content":"再者啊"},{"from":53.24,"to":56,"content":"西餐也没有进化出猛火爆炒的技法"},{"from":56,"to":59.54,"content":"连早期中餐馆里的干爆菜都没有信达雅的翻译"},{"from":59.54,"to":62.02,"content":"那么为什么西餐很少有炒菜呢"},{"from":62.02,"to":65.319,"content":"或者说为什么西餐没有进化出爆炒呢"},{"from":65.319,"to":65.839,"content":"大家好"},{"from":65.839,"to":66.119,"content":"这是菜"},{"from":66.119,"to":66.439,"content":"不是路"},{"from":66.439,"to":66.879,"content":"而香香"},{"from":66.879,"to":68.119,"content":"今天又请大家吃"},{"from":70.159,"to":74.07,"content":"炒菜在之前聊炒菜的视频中"},{"from":74.07,"to":74.81,"content":"我们说过呀"},{"from":74.81,"to":78.6,"content":"炒菜诞生的必要条件是油脂和铁锅的广泛普及"},{"from":78.6,"to":80.2,"content":"那么我们就可以得出结论了"},{"from":80.2,"to":82.8,"content":"欧洲是因为没有满足这两项必要条件"},{"from":82.8,"to":85.93,"content":"所以才很少有炒菜的吗"},{"from":86.45,"to":87.49,"content":"吊诡的事啊"},{"from":87.49,"to":90.65,"content":"虽然在时间轴上比中国延后了六七个世纪"},{"from":90.65,"to":92.29,"content":"但这两项标准啊在欧洲"},{"from":92.29,"to":95.02,"content":"其实至少在18世纪末也已经达到了"},{"from":95.02,"to":95.9,"content":"咱们按顺序啊"},{"from":95.9,"to":97,"content":"先从油纸说起"},{"from":97,"to":99.7,"content":"这是1377年到1440年之间"},{"from":99.7,"to":103.28,"content":"三个英国城市建筑工人年度实物开支账单"},{"from":103.28,"to":104.08,"content":"可以看出啊"},{"from":104.08,"to":106.82,"content":"它们的食用油有普通油脂与黄油"},{"from":106.82,"to":107.92,"content":"黄油自不必说"},{"from":107.92,"to":110.24,"content":"是动物乳液加工出来的副产品"},{"from":110.24,"to":111.34,"content":"属于动物油脂"},{"from":111.34,"to":113.68,"content":"而普通油脂多是植物油脂"},{"from":113.68,"to":114.78,"content":"自中世纪起"},{"from":114.78,"to":117.28,"content":"欧洲人在斋戒期间需要用到植物油"},{"from":117.28,"to":119.12,"content":"去煎制鱼肉和糕点"},{"from":119.12,"to":121.26,"content":"这里没有明确标注植物油的种类"},{"from":121.26,"to":124.84,"content":"当时整个欧洲社会自上而下流行吃杏仁油"},{"from":124.84,"to":125.7,"content":"葡萄籽油"},{"from":125.7,"to":126.44,"content":"核桃油"},{"from":126.44,"to":127.38,"content":"罂粟籽油"},{"from":127.38,"to":128.18,"content":"橄榄油"},{"from":128.18,"to":128.92,"content":"亚麻油"},{"from":128.92,"to":131.84,"content":"那基于英国的地理位置和建筑工人的消费能力"},{"from":131.84,"to":133.76,"content":"那他们吃的大概率是亚麻油"},{"from":133.76,"to":136.24,"content":"如果工种变成乡村农场收割工"},{"from":136.24,"to":138.7,"content":"那么他们就会获得更高配额的黄油"},{"from":138.7,"to":139.62,"content":"甚至是猪油"},{"from":139.62,"to":140.14,"content":"没错"},{"from":140.14,"to":143.72,"content":"你别看现在欧洲人嫌弃猪油什么饱和脂肪高啊"},{"from":143.72,"to":145.2,"content":"他们以前吃的可香了"},{"from":145.2,"to":148.11,"content":"无论是制作馅儿饼还是汤羹提香"},{"from":148.11,"to":149.71,"content":"他们都喜欢放些猪油"},{"from":149.71,"to":152.11,"content":"比如法国家常菜韭葱汤"},{"from":152.11,"to":155.17,"content":"最初版本就是用酒葱牛奶猪油制作的"},{"from":155.17,"to":157.24,"content":"后来才改成黄油或者橄榄油"},{"from":157.24,"to":159.24,"content":"甚至美国早年的经济来源之一"},{"from":159.24,"to":160.84,"content":"就是向欧洲出口猪油"},{"from":160.84,"to":161.8,"content":"以英国为例"},{"from":161.8,"to":163.06,"content":"到1875年"},{"from":163.06,"to":164.74,"content":"美国每年会向英国出口"},{"from":164.74,"to":166.7,"content":"价值7500万英镑的猪油"},{"from":166.7,"to":167.58,"content":"20多年后"},{"from":167.58,"to":169.49,"content":"这个数字超过了2亿英镑"},{"from":169.49,"to":173.68,"content":"可见呀油脂尤其是动物油脂在欧洲算不上稀缺"},{"from":173.68,"to":174.7,"content":"再说铁锅呀"},{"from":174.7,"to":175.68,"content":"咱们之前说过呀"},{"from":175.68,"to":176.66,"content":"由于柴荒"},{"from":176.66,"to":179.4,"content":"宋代大规模使用了新能源煤炭"},{"from":179.4,"to":180.84,"content":"这提高了冶铁的效率"},{"from":180.84,"to":182.36,"content":"也增加了铁器的产量"},{"from":182.36,"to":184.86,"content":"铁器突破传统耕战的应用场景"},{"from":184.86,"to":186.02,"content":"下沉至厨房"},{"from":186.02,"to":187.16,"content":"诞生出了铁锅"},{"from":187.16,"to":188.02,"content":"无独有偶啊"},{"from":188.02,"to":189.8,"content":"这套叙事在几个世纪以后"},{"from":189.8,"to":191.6,"content":"又被搬上了欧洲的历史舞台"},{"from":191.6,"to":192.68,"content":"17世纪以前"},{"from":192.68,"to":195.1,"content":"欧洲冶铁主要靠木炭提供能源"},{"from":195.1,"to":196.96,"content":"然而随着帝国疆域的扩张"},{"from":196.96,"to":198.52,"content":"海上战争和贸易"},{"from":198.52,"to":200.88,"content":"促使了大量木材被投入到造船业"},{"from":200.88,"to":203.6,"content":"人口增长以及伦敦大火之后的住房建设"},{"from":203.6,"to":204.7,"content":"也急需木材"},{"from":204.7,"to":205.64,"content":"两两相乘"},{"from":205.64,"to":207.3,"content":"导致了17世纪初期"},{"from":207.3,"to":209.3,"content":"英国木材供应亮起了红灯"},{"from":209.3,"to":212.22,"content":"同时帝国的扩张还导致了对战争资源"},{"from":212.22,"to":213.48,"content":"铁的消耗飙升"},{"from":213.48,"to":215.58,"content":"英国陷入了无铁可用的境地"},{"from":215.58,"to":217.06,"content":"不得不从瑞典进口"},{"from":217.06,"to":218.26,"content":"17世纪中期"},{"from":218.26,"to":221.16,"content":"英国进口铁矿仅占总进口的2%"},{"from":221.16,"to":222.36,"content":"直到17世纪末"},{"from":222.36,"to":224.2,"content":"这个数字上升至28%"},{"from":224.2,"to":226.96,"content":"这些情况让英国进入到一种恶性链条中"},{"from":226.96,"to":228.46,"content":"木材原材料短缺"},{"from":228.46,"to":230.16,"content":"导致了木炭供应不足"},{"from":230.16,"to":231.92,"content":"阻碍了本土炼铁业"},{"from":231.92,"to":233.3,"content":"冶铁又依赖进口"},{"from":233.3,"to":235.2,"content":"为了保障帝国的扩张进度"},{"from":235.2,"to":237.06,"content":"就必须要提高铁的产量"},{"from":237.06,"to":238.7,"content":"而要想提高铁的产量"},{"from":238.7,"to":240.94,"content":"就必须找到一种可以代替木炭的"},{"from":240.94,"to":242.6,"content":"更高效率的冶铁燃料"},{"from":242.6,"to":243.48,"content":"找来找去"},{"from":243.48,"to":244.72,"content":"找到了已经在玻璃"},{"from":244.72,"to":247.82,"content":"制砖等行业得到广泛应用的煤炭"},{"from":247.82,"to":249.9,"content":"然而仅仅是煤炭还不够啊"},{"from":249.9,"to":250.78,"content":"18世纪初"},{"from":250.78,"to":253.38,"content":"一名叫做亚伯拉罕达比的英国人"},{"from":253.38,"to":256.54,"content":"率先利用提纯过的焦炭进行高炉炼铁"},{"from":256.54,"to":259.96,"content":"使得熔炼的温度足够达到1500℃以上"},{"from":259.96,"to":261.68,"content":"从而达到更高质量的铁"},{"from":261.68,"to":265.04,"content":"焦炭炼铁的成功只是英国炼铁业革命的起点"},{"from":265.04,"to":267.3,"content":"生产出的铁被设计成了零部件"},{"from":267.3,"to":268.58,"content":"制作成蒸汽机"},{"from":268.58,"to":270.56,"content":"蒸汽机又代替了水力鼓风"},{"from":270.56,"to":272.28,"content":"在高炉炼铁中得到应用"},{"from":272.28,"to":275.88,"content":"这令英国铁业摆脱了对木材和水利的双重依赖"},{"from":275.88,"to":277.18,"content":"极大解放了生产力"},{"from":277.18,"to":278.46,"content":"低廉质优的熟铁"},{"from":278.46,"to":280.62,"content":"又构成了英国纵横交错的铁路"},{"from":280.62,"to":282.68,"content":"源源不断地将远处的煤炭"},{"from":282.68,"to":285.32,"content":"铁矿送进这颗欧洲工业心脏"},{"from":285.32,"to":286.08,"content":"工业革命前"},{"from":286.08,"to":287.12,"content":"1740年"},{"from":287.12,"to":289.16,"content":"英国铁产量只有1.7万吨"},{"from":289.16,"to":291.28,"content":"1788年达到了6.8万吨"},{"from":291.28,"to":293.82,"content":"而1806年则达到了26万吨"},{"from":293.82,"to":295,"content":"到1844年"},{"from":295,"to":297.56,"content":"英国甚至生产出了300万吨铁铁"},{"from":297.56,"to":298.42,"content":"产量上来了"},{"from":298.42,"to":300,"content":"铁骑数量也跟着上扬"},{"from":300,"to":301.9,"content":"还是这位亚伯拉罕达比"},{"from":301.9,"to":303.88,"content":"不仅倒腾出了高炉炼铁"},{"from":303.88,"to":306.9,"content":"还用沙子制作铁锅模具来降本增效"},{"from":306.9,"to":308.38,"content":"并创办了钢铁公司"},{"from":308.38,"to":311.11,"content":"在欧美全境推广铸铁和铁锅"},{"from":311.11,"to":312.11,"content":"那么问题来了"},{"from":312.11,"to":314.43,"content":"为什么同样拥有铁锅和油脂的欧洲"},{"from":314.43,"to":316.59,"content":"没有像中国一样流行吃炒菜呢"},{"from":316.59,"to":317.99,"content":"这时候可能有朋友要说了"},{"from":317.99,"to":319.35,"content":"那是因为欧洲人吃的油啊"},{"from":319.35,"to":320.4,"content":"烟点太低了"},{"from":320.4,"to":321.36,"content":"耐热性差"},{"from":321.36,"to":323.28,"content":"炒菜温度可是要达到160到"},{"from":323.28,"to":324.36,"content":"220℃的"},{"from":324.36,"to":325.4,"content":"这锅温刚上来"},{"from":325.4,"to":326.48,"content":"油就变得焦黑"},{"from":326.48,"to":328.22,"content":"当然没法一顿爆炒了"},{"from":328.22,"to":328.9,"content":"有道理啊"},{"from":328.9,"to":330.68,"content":"像是欧洲人常用的黄油"},{"from":330.68,"to":331.28,"content":"核桃油"},{"from":331.28,"to":332.36,"content":"要是拿来炒菜"},{"from":332.36,"to":334.04,"content":"那当场给你表演个糊锅呀"},{"from":334.04,"to":334.78,"content":"但是别忘了"},{"from":334.78,"to":336.36,"content":"他们还常吃猪油啊"},{"from":336.36,"to":337.88,"content":"猪油的烟点可不低"},{"from":337.88,"to":339.28,"content":"再加上20世纪以后"},{"from":339.28,"to":340.36,"content":"花生大豆"},{"from":340.36,"to":342.62,"content":"棕榈等油料作物的大面积种植"},{"from":342.62,"to":344.44,"content":"植物油精炼技术的完善"},{"from":344.44,"to":345.66,"content":"获得高油烟点"},{"from":345.66,"to":347.9,"content":"能炒菜的油脂并非什么难事"},{"from":347.9,"to":349.26,"content":"那可能又有朋友要说啦"},{"from":349.26,"to":351.26,"content":"他们普及铁锅的时间太迟了"},{"from":351.26,"to":352.76,"content":"已经形成了饮食习惯"},{"from":352.76,"to":353.56,"content":"很难改了"},{"from":353.56,"to":354.42,"content":"也有道理啊"},{"from":354.42,"to":357.16,"content":"但是正如我们前面多期节目讲过的"},{"from":357.16,"to":358.28,"content":"近一个世纪以来"},{"from":358.28,"to":360.14,"content":"日韩这种传统稻作国家"},{"from":360.14,"to":362.34,"content":"稻米的消费数量都日渐衰退"},{"from":362.34,"to":363.78,"content":"远不如面粉吃的多"},{"from":363.78,"to":366.22,"content":"面包面条的风头都要盖过米饭了"},{"from":366.22,"to":369.22,"content":"人类的饮食习惯似乎也没有那么难以去改变"},{"from":369.22,"to":371.76,"content":"因此如果答题区只写油脂"},{"from":371.76,"to":374.98,"content":"烟点低与饮食习惯难以改变两个论点"},{"from":374.98,"to":376.62,"content":"为什么欧洲不流行吃炒菜"},{"from":376.62,"to":378.7,"content":"这道论述题恐怕是要丢分的"},{"from":378.7,"to":381.82,"content":"那么还有什么论点是我们漏血了的呢"},{"from":381.82,"to":385.36,"content":"因为欧洲人的副食结构是荤多素少啊"},{"from":385.36,"to":387.1,"content":"我们在之前的视频里也说过呀"},{"from":387.1,"to":390.14,"content":"偏好素食是触发中国人炒菜的条件之一"},{"from":390.14,"to":391.92,"content":"所谓素食就是以蔬菜"},{"from":391.92,"to":392.56,"content":"豆制品"},{"from":392.56,"to":394.58,"content":"竹笋菌类为原料的食物"},{"from":394.58,"to":397.34,"content":"中国传统以精耕细作的种植业见长"},{"from":397.34,"to":399.02,"content":"加上境内疆域辽阔"},{"from":399.02,"to":400.28,"content":"山河地貌多元"},{"from":400.28,"to":402.46,"content":"可食用菌类多达900多种"},{"from":402.46,"to":403.64,"content":"常见的根茎类"},{"from":403.64,"to":404.4,"content":"叶菜类"},{"from":404.4,"to":405.12,"content":"花果类"},{"from":405.12,"to":405.92,"content":"茎叶类"},{"from":405.92,"to":406.56,"content":"豆荚类"},{"from":406.56,"to":408.22,"content":"蔬菜种类高达300多种"},{"from":408.22,"to":409.16,"content":"反观畜牧业"},{"from":409.16,"to":409.9,"content":"除了新新疆"},{"from":409.9,"to":410.8,"content":"内蒙等地区"},{"from":410.8,"to":412.1,"content":"中国本就不发达"},{"from":412.1,"to":415.3,"content":"加之古代耕牛在明面上更是禁止宰杀"},{"from":415.3,"to":416.2,"content":"相对而言呢"},{"from":416.2,"to":417.68,"content":"牛羊肉供给较少"},{"from":417.68,"to":419.52,"content":"肉食基本盘就靠猪肉"},{"from":419.52,"to":422.74,"content":"以鸡鸭鹅为代表的禽类和鱼虾蟹"},{"from":422.74,"to":425.2,"content":"这种水产基于先天农业禀赋呢"},{"from":425.2,"to":426.46,"content":"中国人自上而而下"},{"from":426.46,"to":427.72,"content":"或因宗教斋戒"},{"from":427.72,"to":429,"content":"或因身体养生"},{"from":429,"to":430.26,"content":"或因囊中羞涩"},{"from":430.26,"to":432.74,"content":"腹食天平就倾向于素食素食"},{"from":432.74,"to":434.48,"content":"若是直接水煮水蒸"},{"from":434.48,"to":436.78,"content":"虽能尝到食材的原味口感"},{"from":436.78,"to":438.26,"content":"但味道却也难免单调"},{"from":438.26,"to":441.7,"content":"于是烈火烹油的炒菜就开拓出了烹饪的新思路"},{"from":441.7,"to":444.52,"content":"在铁锅和油脂的双重导热介质下呢"},{"from":444.52,"to":447.46,"content":"温令包裹油脂的食材表面瞬间焦化"},{"from":447.46,"to":449.04,"content":"从而获得了脆嫩的口感"},{"from":449.04,"to":451.78,"content":"并散发出中餐独有的芬芳物质"},{"from":451.78,"to":452.65,"content":"锅气"},{"from":452.65,"to":453.29,"content":"明末"},{"from":453.29,"to":456.71,"content":"来中国传教的拉斯科台斯神父曾在日记里写道"},{"from":456.71,"to":457.37,"content":"在中国"},{"from":457.37,"to":460.03,"content":"即使有钱人好像只是为了增加食欲"},{"from":460.03,"to":461.84,"content":"才加几块猪肉鸡肉"},{"from":461.84,"to":462.52,"content":"其他肉"},{"from":462.52,"to":463.72,"content":"不管他们多有钱"},{"from":463.72,"to":464.64,"content":"地位多高"},{"from":464.64,"to":466.54,"content":"消费的肉食也为数甚少"},{"from":466.54,"to":469.26,"content":"而且他们吃肉食总喜欢切成小块"},{"from":469.26,"to":470.12,"content":"甚至剁馅儿"},{"from":470.12,"to":470.9,"content":"配着蔬菜"},{"from":470.9,"to":471.94,"content":"无论多么讲究"},{"from":471.94,"to":472.64,"content":"多么精细"},{"from":472.64,"to":473.78,"content":"在欧洲人的眼里"},{"from":473.78,"to":474.92,"content":"数量都太少了"},{"from":474.92,"to":477.08,"content":"这里可以画一下重点消费的肉食"},{"from":477.08,"to":478.1,"content":"为数甚少"},{"from":478.1,"to":480.88,"content":"切成小块甚至剁馅儿讲究精细"},{"from":480.88,"to":483.54,"content":"那再看开头那份英国建筑工人的伙食"},{"from":483.54,"to":484.68,"content":"可以直观地看到"},{"from":484.68,"to":487.1,"content":"复式结构里肉食的占比达到了三十十%"},{"from":487.1,"to":487.34,"content":"三"},{"from":487.34,"to":488.16,"content":"39%"},{"from":488.16,"to":489.74,"content":"甚至是49%"},{"from":489.74,"to":493.88,"content":"而蔬菜却只能和盐油芝士这种调味副食品混合"},{"from":493.88,"to":494.3,"content":"统计"},{"from":494.3,"to":496.58,"content":"占比最高也没有超过10%"},{"from":496.58,"to":500.12,"content":"在布罗代尔的论著15~18世纪的物质文明"},{"from":500.12,"to":501.74,"content":"经济和资本主义一书中"},{"from":501.74,"to":504.08,"content":"也有一小节名为肉食者的欧洲"},{"from":504.08,"to":506.42,"content":"引述了欧洲各国肉类消费的情况"},{"from":506.42,"to":508.18,"content":"1751年到1854年"},{"from":508.18,"to":511.74,"content":"巴黎平均每人每年消费50亿到65kg肉"},{"from":511.74,"to":514.88,"content":"这个数字在法国全境约为23.5kg"},{"from":514.88,"to":516.12,"content":"18世纪的汉堡"},{"from":516.12,"to":518.76,"content":"每人每年消费肉量达到60kg"},{"from":518.76,"to":521.36,"content":"德国全境则减少至20kg每人"},{"from":521.36,"to":524.54,"content":"这种荤多素少的副食结构无关经济水平"},{"from":524.54,"to":526.7,"content":"而是欧洲先天的农业禀赋使然"},{"from":526.7,"to":528.68,"content":"大家想想欧洲的第一作物是什么呢"},{"from":528.68,"to":530.959,"content":"小麦土豆都不是"},{"from":530.959,"to":533.139,"content":"是这一眼望不到头的牧草"},{"from":533.139,"to":535.499,"content":"欧洲尤其是西欧地处温带"},{"from":535.499,"to":536.439,"content":"冬季温和"},{"from":536.439,"to":537.34,"content":"夏季凉爽"},{"from":537.34,"to":539.52,"content":"气温年较差和日较差较小"},{"from":539.52,"to":541.3,"content":"地形以开阔平原为主"},{"from":541.3,"to":543.86,"content":"加之温带海洋性气候温暖湿润"},{"from":543.86,"to":545.56,"content":"广袤的土地长满了牧草"},{"from":545.56,"to":547.98,"content":"在畜牧业这块可以说是天赋异禀"},{"from":547.98,"to":550.42,"content":"欧洲传统的土地耕作制度为三普"},{"from":550.42,"to":551.68,"content":"四普的轮作制度"},{"from":551.68,"to":552.86,"content":"以四普之为例"},{"from":552.86,"to":554.68,"content":"将耕地分为四个区域"},{"from":554.68,"to":556.84,"content":"依次种植小麦萝卜"},{"from":556.84,"to":558.96,"content":"大麦三叶草和黑麦草"},{"from":558.96,"to":562.26,"content":"三叶草和黑麦草被放牧或割草作为饲料"},{"from":562.26,"to":564.38,"content":"萝卜则是在冬天用来喂牛羊"},{"from":564.38,"to":567.84,"content":"而牛羊拉出的粪便又能为土地提供天然的肥料"},{"from":567.84,"to":570.26,"content":"形成一个自给自足的生态小循环"},{"from":570.26,"to":571.34,"content":"由此也能看出"},{"from":571.34,"to":573.24,"content":"欧洲传统农业利用土地"},{"from":573.24,"to":574.76,"content":"除了获取主食谷物"},{"from":574.76,"to":576.62,"content":"最重要的就是收割牧草"},{"from":576.62,"to":577.54,"content":"发展畜牧业"},{"from":577.54,"to":578.28,"content":"直到今天"},{"from":578.28,"to":580.02,"content":"欧洲畜牧业也相对发达"},{"from":580.02,"to":582.38,"content":"各国畜牧业占农业总产值的比重"},{"from":582.38,"to":583.94,"content":"大多超过了50%"},{"from":583.94,"to":586.6,"content":"然而上帝给欧洲打开畜牧业的大门"},{"from":586.6,"to":589.18,"content":"也就顺带关上了蔬菜这扇窗"},{"from":589.18,"to":591,"content":"即使算上新大陆移植来的"},{"from":591,"to":593.46,"content":"欧洲本土产的蔬菜品种也比较单一"},{"from":593.46,"to":594.56,"content":"以根茎类为主"},{"from":594.56,"to":596.08,"content":"像是莴苣萝卜"},{"from":596.08,"to":600.68,"content":"玉米土豆洋葱番茄绿叶菜也是罗勒百里香"},{"from":600.68,"to":602.74,"content":"迷迭香酒葱这类香料"},{"from":602.74,"to":603.98,"content":"以及少部分的豆类"},{"from":603.98,"to":605.82,"content":"这种荤多素少的副食结构"},{"from":605.82,"to":608.22,"content":"对于牛羊肉食用率较高的欧洲人来说"},{"from":608.22,"to":610.5,"content":"最高效的烹饪方法就是切成大块"},{"from":610.5,"to":611.7,"content":"煎烤或者是炖煮"},{"from":611.7,"to":614.62,"content":"因此即使18世纪以后出现了欧洲铁锅"},{"from":614.62,"to":616.64,"content":"其形态也并非易于翻炒"},{"from":616.64,"to":618.56,"content":"控制火候的圆底炒锅"},{"from":618.56,"to":620.6,"content":"而是煎烤友好型的平底锅"},{"from":620.6,"to":622.8,"content":"如果要点亮炒菜这一技能"},{"from":622.8,"to":627.1,"content":"那就意味着食材必须经过切块切片切丝切丁"},{"from":627.1,"to":628.16,"content":"切末的预处理"},{"from":628.16,"to":631.96,"content":"才能进化为可以在国内腾跃翻滚的小块形态"},{"from":631.96,"to":634.78,"content":"在没有绞肉机擦司机的前工业时代"},{"from":634.78,"to":635.92,"content":"这对于欧洲人来说"},{"from":635.92,"to":639.32,"content":"无疑是一种人工和时间成本双高的烹饪方式"},{"from":639.32,"to":641.12,"content":"因为炒菜本身也是一种饮食"},{"from":641.12,"to":642.7,"content":"文明高度发达的体现"},{"from":642.7,"to":645.38,"content":"炒菜不仅要求本土拥有丰富的铁矿"},{"from":645.38,"to":646.76,"content":"煤炭油脂资源"},{"from":646.76,"to":650.12,"content":"还需要跨过冶铁榨油烘摩的技术门槛"},{"from":650.12,"to":652.71,"content":"以及全民对于食物极致的追求"},{"from":652.71,"to":655.98,"content":"汉学家牟复礼曾在中国文化中的饮食指出"},{"from":655.98,"to":657.66,"content":"至少在19世纪以前啊"},{"from":657.66,"to":658.8,"content":"中国人是亚洲"},{"from":658.8,"to":661.42,"content":"或许是世界上吃的最好的民族之一"},{"from":661.42,"to":663.02,"content":"以稻米小麦为主食"},{"from":663.02,"to":664.1,"content":"喜欢热食"},{"from":664.1,"to":665.68,"content":"意味着需要大量的燃料"},{"from":665.68,"to":667.54,"content":"日常能吃到新鲜的果蔬"},{"from":667.54,"to":670,"content":"豆腐还能弥补动物蛋白质的不足"},{"from":670,"to":672.88,"content":"因此相比于其他民族本土发达的农业"},{"from":672.88,"to":676.24,"content":"使得中国人对待食物有着超越生存之外的思考"},{"from":676.24,"to":677.08,"content":"或因美味"},{"from":677.08,"to":677.96,"content":"婚因养生"},{"from":677.96,"to":678.82,"content":"或因宗教"},{"from":678.82,"to":679.66,"content":"或因艺术"},{"from":679.66,"to":680.64,"content":"社会各个阶层"},{"from":680.64,"to":682,"content":"无论贫贱富贵"},{"from":682,"to":684.7,"content":"都对食物有一种刁钻复杂的追求"},{"from":684.7,"to":687.68,"content":"炒这一精细的烹饪方式就是最好的例证"},{"from":687.68,"to":688.64,"content":"总而言之"},{"from":688.64,"to":691.02,"content":"炒是中国古代及自然资源"},{"from":691.02,"to":691.82,"content":"工业科技"},{"from":691.82,"to":694.04,"content":"饮食文明之大成的烹饪方式"},{"from":694.04,"to":695.7,"content":"直到饮食全球化的今天"},{"from":695.7,"to":698.91,"content":"炒菜依旧在中国人餐桌上独领风骚"},{"from":698.91,"to":700.41,"content":"奈何中式炒菜"},{"from":700.41,"to":703.9,"content":"尤其是爆炒会产生大量的油烟与有害物质"},{"from":703.9,"to":705.1,"content":"如pm2.5"},{"from":705.1,"to":707.78,"content":"在这一份清华大学学者编撰的"},{"from":707.78,"to":711.18,"content":"家庭烹饪产生的pm2.5防护指南中显示"},{"from":711.18,"to":715.15,"content":"超煎炸等高温烹饪所产生的pm2.5"},{"from":715.15,"to":717.34,"content":"平均浓度会升高数十倍"},{"from":717.34,"to":719.86,"content":"占到室内pm2.5的70%以上"},{"from":719.86,"to":722.2,"content":"并通过呼吸与皮肤进入人体"},{"from":722.2,"to":724.72,"content":"造成呼吸系统和心血管系统受损"},{"from":724.72,"to":726.98,"content":"而作为西方舶来品的油烟机"},{"from":726.98,"to":730.08,"content":"则是基于以煎烤炖煮见长的"},{"from":730.08,"to":731.96,"content":"稀式低油烟烹饪而设计的"},{"from":731.96,"to":734.24,"content":"这种中央负压方式的油烟机"},{"from":734.24,"to":737.96,"content":"对中式高温油炒产生的高油烟和pm2.5"},{"from":737.96,"to":739.52,"content":"很难做到有效吸除"},{"from":739.52,"to":741.3,"content":"而且易受干扰而泄漏"},{"from":741.3,"to":743.08,"content":"那么面对厨房的油烟问题"},{"from":743.08,"to":745.01,"content":"我们就无计可施了吗"},{"from":745.01,"to":748.67,"content":"米家智能净烟机为我们提供了中式高温烹饪"},{"from":748.67,"to":750.75,"content":"净除细颗粒物的新思路"},{"from":750.75,"to":754.35,"content":"以静为标准的产品研发逻辑和工作原理"},{"from":754.35,"to":756.23,"content":"研发出的米家净烟机P1"},{"from":756.23,"to":757.45,"content":"其禁烟禁味"},{"from":757.45,"to":759.94,"content":"净呼吸的烹饪体验获得了市场好评"},{"from":759.94,"to":760.86,"content":"在今年618"},{"from":760.86,"to":764.08,"content":"就斩获了京东油烟机品类累计销量top1"},{"from":764.08,"to":767.12,"content":"天猫油烟机品类累计销售额top前三"},{"from":767.12,"to":768.84,"content":"根据奥维云网的数据显示"},{"from":768.84,"to":771.56,"content":"8月烟灶套装米家净烟机的P1"},{"from":771.56,"to":773.42,"content":"销售量与销售额双料第一"},{"from":773.42,"to":775.9,"content":"而全新升级推出的米家净烟机P2"},{"from":775.9,"to":779.88,"content":"继承了P1上就广受好评的动态微粒捕集技术"},{"from":779.88,"to":781.16,"content":"四涡气旋技术"},{"from":781.16,"to":783.82,"content":"先从源头抓住pm2.5与油烟"},{"from":783.82,"to":786.26,"content":"紧接着教会高速气流后倾技术"},{"from":786.26,"to":787.28,"content":"快速排吸"},{"from":787.28,"to":789.22,"content":"试图从顶部逃逸的油烟"},{"from":789.22,"to":792.26,"content":"则会被防疫气帘吹回高速补给区"},{"from":792.26,"to":795.38,"content":"保障我们在热油爆香爆炒颠勺的时候"},{"from":795.38,"to":797.54,"content":"达到油烟和pm2.5不泄漏"},{"from":797.54,"to":798.98,"content":"不扩散的禁烟效果"},{"from":798.98,"to":801.9,"content":"并且屏幕上也会实时显示pm2.5数值"},{"from":801.9,"to":803.12,"content":"效果一目了然"},{"from":803.12,"to":803.8,"content":"与此同时"},{"from":803.8,"to":807.069,"content":"被吸走的pm2.5也使得油烟气味没了附着物"},{"from":807.069,"to":808.809,"content":"从而实现进味的效果"},{"from":808.809,"to":810.749,"content":"连爆炒辣椒都闻不到味道"},{"from":810.749,"to":811.829,"content":"不做饭的时候啊"},{"from":811.829,"to":814.64,"content":"还有全新升级的负离子净化功能"},{"from":814.64,"to":816.74,"content":"可以释放超过2100万个"},{"from":816.74,"to":819.26,"content":"每立方厘米的超高浓度负离子"},{"from":819.26,"to":820.82,"content":"从而净化厨房空气"},{"from":820.82,"to":821.9,"content":"pm2.5颗粒"},{"from":821.9,"to":823.08,"content":"空气微尘等污染"},{"from":823.08,"to":824.47,"content":"抑制细菌滋生"},{"from":824.47,"to":826.91,"content":"全天候保障厨房的空气健康"},{"from":826.91,"to":829.07,"content":"此外米家净烟机P2机身"},{"from":829.07,"to":832.78,"content":"还升级了搭载一氧化碳传感器与甲烷传感器"},{"from":832.78,"to":836.12,"content":"实现了对一氧化碳和燃气泄漏的实时监测"},{"from":836.12,"to":837.66,"content":"防止安全隐患发生"},{"from":837.66,"to":840.86,"content":"米家净烟机回归了中国人烹饪需求的原点"},{"from":840.86,"to":842.22,"content":"从油烟机的本质"},{"from":842.22,"to":843.88,"content":"一种有效去除烟味"},{"from":843.88,"to":846.64,"content":"油烟味以及pm2.5等有害物质"},{"from":846.64,"to":849.76,"content":"保护烹饪者以及家人不受有害威力伤害"},{"from":849.76,"to":852.3,"content":"不受油烟味和油污无困扰的作用"},{"from":852.3,"to":853.54,"content":"去做技术创新"},{"from":853.54,"to":856.96,"content":"为中国家庭带来了安全健康的烹饪环境"},{"from":856.96,"to":858.64,"content":"自宋代普及以来啊"},{"from":858.64,"to":861.82,"content":"炒菜在中国烹饪史上犹如一块纪念丰碑"},{"from":861.82,"to":863,"content":"屹立千年不倒"},{"from":863,"to":866.64,"content":"它曾是中国烹饪科技和文明鸟瞰世界的象征"},{"from":866.64,"to":869.16,"content":"然而在讲究健康饮食的新时代"},{"from":869.16,"to":871.94,"content":"却因产生油烟pm2.5而遭到诟病"},{"from":871.94,"to":873.7,"content":"一时有一时之科技"},{"from":873.7,"to":877.45,"content":"以拥有动态微粒捕集技术的米家净烟机为代表"},{"from":877.45,"to":880.66,"content":"随着适应中式烹饪的创新型经验机诞生"},{"from":880.66,"to":883.68,"content":"解决了高温烹饪带来的油烟和pm2.5"},{"from":883.68,"to":884.58,"content":"千古难题"},{"from":884.58,"to":886.58,"content":"将中式炒菜的下厨环境"},{"from":886.58,"to":889.36,"content":"进化为了禁烟净味的新中式厨房"},{"from":889.36,"to":892.5,"content":"为炒菜在新时代的存续注入了生命力"},{"from":892.5,"to":894.7,"content":"更续了中国炒菜的历史脉络"},{"from":894.7,"to":897.7,"content":"成为了中式烹饪的守护者"},{"from":898.04,"to":900,"content":"这里是赛博实录"},{"from":900,"to":901.68,"content":"如果你觉得今天的视频还不错"},{"from":901.68,"to":902.87,"content":"欢迎一键三连"},{"from":902.87,"to":904.71,"content":"如果你也想知道在这个时代"},{"from":904.71,"to":905.93,"content":"谁决定了我们吃什么"},{"from":905.93,"to":906.81,"content":"可以关注我们"},{"from":906.81,"to":907.77,"content":"下期再见"},{"from":907.77,"to":908.44,"content":"拜拜"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:30:53.823Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:30:48.849Z"}}
