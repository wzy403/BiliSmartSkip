{"schemaVersion":1,"bvid":"BV1rm41197RE","cid":1429488301,"subtitles":[{"from":0.02,"to":3.41,"content":"2011年台湾省知名节目关键时刻"},{"from":3.41,"to":6.32,"content":"就是代表作为大陆人吃不起榨菜的那个"},{"from":6.32,"to":8.22,"content":"引用了美国的一项实验实验"},{"from":8.22,"to":11.16,"content":"通过胶囊内镜的方式拍摄的手工拉面"},{"from":11.16,"to":13.68,"content":"与方便面被吃进肚子里的情况对比"},{"from":13.68,"to":14.76,"content":"主持人声称啊"},{"from":14.76,"to":17.9,"content":"手工拉面在32小时后已经完全被消化"},{"from":17.9,"to":20.45,"content":"而方便面则没有完全被消化"},{"from":20.45,"to":23.96,"content":"方便面无法被消化的原因是为了延长保质期"},{"from":23.96,"to":26.8,"content":"在里面添加了136种的抗氧化剂"},{"from":26.8,"to":28.78,"content":"随后更是输出了方便面"},{"from":28.78,"to":31.48,"content":"调料包有24种钠盐与重金属"},{"from":31.48,"to":34.06,"content":"泡面碗遇热溶解危害物质等内容"},{"from":34.06,"to":35.08,"content":"我的天呐"},{"from":35.08,"to":36.46,"content":"我们吃喜欢吃的泡面"},{"from":36.46,"to":39.4,"content":"他既然这里面在调味包里面还有那么多重金属"},{"from":39.4,"to":42.52,"content":"这篇集方便面有害论之大成的报道啊"},{"from":42.52,"to":45.91,"content":"西涧之大陆历经N加一次集体创作"},{"from":45.91,"to":48.46,"content":"以泡面32天不消化的新面目"},{"from":48.46,"to":49.9,"content":"流行于互联网世界"},{"from":49.9,"to":52.26,"content":"类似这样的方便面谣言还有很多"},{"from":52.26,"to":53.82,"content":"例如泡面会致癌"},{"from":53.82,"to":55.44,"content":"方便面充斥着防腐剂"},{"from":55.44,"to":58.38,"content":"吃桶装的方便面就是吃塑料等等等等"},{"from":58.38,"to":60.18,"content":"这些说法更是无本之末"},{"from":60.18,"to":60.98,"content":"难以溯源"},{"from":60.98,"to":63.26,"content":"那么方便面真的是不健康的吗"},{"from":63.26,"to":65.9,"content":"方便面真实的营养成分又有多少呢"},{"from":65.9,"to":66.2,"content":"大家好"},{"from":66.2,"to":66.62,"content":"这是赛博"},{"from":66.62,"to":67.34,"content":"是鹿耳锵锵"},{"from":67.34,"to":72.43,"content":"今天我请大家吃方便面"},{"from":72.95,"to":74.38,"content":"这是一桶方便面"},{"from":74.38,"to":76.48,"content":"可以简单的拆解为面饼"},{"from":76.48,"to":77.289,"content":"调味包"},{"from":77.289,"to":79.449,"content":"蔬菜包面桶四个部分"},{"from":79.449,"to":81.309,"content":"这四个部分全部都收到了"},{"from":81.309,"to":83.349,"content":"方便面有害论的无差别攻击"},{"from":83.349,"to":86.1,"content":"首先是面饼开头"},{"from":87.78,"to":90.39,"content":"原本是由媒体从业者史蒂芬巴丁"},{"from":90.39,"to":93.44,"content":"和研究胃肠道科学的医生布雷登郭"},{"from":93.44,"to":94.82,"content":"合作的拍摄项目"},{"from":94.82,"to":96.92,"content":"这些图像并非凭空捏造"},{"from":96.92,"to":99.08,"content":"但是台湾主持人对他的解读"},{"from":99.08,"to":101.14,"content":"却与实验研究者背道而驰"},{"from":101.14,"to":102.82,"content":"史蒂芬巴丁明确说道啊"},{"from":102.82,"to":104.08,"content":"拉面与方便面"},{"from":104.08,"to":106.76,"content":"在吃完后两个多小时就已经基本消化了"},{"from":106.76,"to":109.52,"content":"同时拍摄所使用的胶囊内镜"},{"from":109.52,"to":111.64,"content":"每次的拍摄时长只有八个小时"},{"from":111.64,"to":113.32,"content":"这跟台湾主持人所说的"},{"from":113.32,"to":115.66,"content":"方便面32小时都无法消化的结论"},{"from":115.66,"to":117.02,"content":"完全是天差地别"},{"from":117.02,"to":118.58,"content":"至于为了延长保质期"},{"from":118.58,"to":121.34,"content":"在面饼里面添加了136种抗氧化剂"},{"from":121.34,"to":122.42,"content":"的说法嗯"},{"from":122.42,"to":124.35,"content":"只能说品牌的钱也是钱"},{"from":124.35,"to":125.49,"content":"没有哪个冤大头"},{"from":125.49,"to":127.77,"content":"品牌会放着成熟的干燥脱水技术"},{"from":127.77,"to":129.99,"content":"不用以提高生产成本为代价"},{"from":129.99,"to":133.4,"content":"在面饼中多添加100多种添加剂来保值"},{"from":133.4,"to":134.3,"content":"事实上啊"},{"from":134.3,"to":138.05,"content":"方便面面饼保质主要靠的是干燥脱水技术"},{"from":138.05,"to":139.22,"content":"根据技术差异啊"},{"from":139.22,"to":141.92,"content":"面饼分为油炸型和非油炸型两种"},{"from":141.92,"to":143.12,"content":"油炸型的面饼呢"},{"from":143.12,"to":146,"content":"也就是把面饼丢进130~140度的高温"},{"from":146,"to":146.45,"content":"油炸"},{"from":146.45,"to":147.44,"content":"脱水硬化"},{"from":147.44,"to":149.75,"content":"非油炸面饼则是利用热风"},{"from":149.75,"to":152.39,"content":"微波真空等工艺进行脱水"},{"from":152.39,"to":154.7,"content":"相比于含水量30%的鲜面啊"},{"from":154.7,"to":157.22,"content":"无论是油炸型还是非油炸馅的面饼"},{"from":157.22,"to":159.6,"content":"含水量都只有3%到4%"},{"from":159.6,"to":163,"content":"霉菌是无法在这种干燥又密闭的环境下生存的"},{"from":163,"to":165.4,"content":"所以可以达到防腐保质的效果"},{"from":165.4,"to":165.88,"content":"不过啊"},{"from":165.88,"to":169.63,"content":"经过高温脱水的面饼中会产生致癌物丙烯酰胺"},{"from":169.63,"to":173.23,"content":"这给方便面又招引来了一顶皇帝的新帽子"},{"from":173.23,"to":174.81,"content":"吃方便面致癌"},{"from":174.81,"to":177.78,"content":"据国家食品安全风险评估中心发布的"},{"from":177.78,"to":180.74,"content":"食品中丙烯酰胺的危险性评估显示"},{"from":180.74,"to":183.38,"content":"丙烯酰胺主要在高碳水化合物"},{"from":183.38,"to":186.14,"content":"低蛋白质的植物固性食物的加热"},{"from":186.14,"to":188.96,"content":"烹调过程中形成140~180度"},{"from":188.96,"to":190.43,"content":"为生成的最佳温度"},{"from":190.43,"to":192.6,"content":"丙烯酰胺被世界卫生组织"},{"from":192.6,"to":194.1,"content":"国际癌症研究机构"},{"from":194.1,"to":196.74,"content":"致癌物清单列为2A类致癌物"},{"from":196.74,"to":197.46,"content":"也就是说"},{"from":197.46,"to":200.46,"content":"此类致癌物对人致癌性的证据有限"},{"from":200.46,"to":203.52,"content":"而对实验动物致癌性证据则比较充分"},{"from":203.52,"to":204.48,"content":"咱们都知道啊"},{"from":204.48,"to":207.06,"content":"抛开剂量谈毒性约等于耍流氓"},{"from":207.06,"to":208.78,"content":"那么根据这篇研究显示啊"},{"from":208.78,"to":210.88,"content":"丙烯酰胺的人体致癌剂量"},{"from":210.88,"to":214.26,"content":"约为2.6到16微克每公斤每天"},{"from":214.26,"to":217.02,"content":"这意味着一个体重60kg的成年人"},{"from":217.02,"to":220.14,"content":"每天至少摄入156微克的丙烯酰胺"},{"from":220.14,"to":221.18,"content":"才有可能致癌"},{"from":221.18,"to":222.62,"content":"而中国农业大学"},{"from":222.62,"to":226.18,"content":"食品科学与营养工程学院的胡晓松教授指出"},{"from":226.18,"to":229.45,"content":"油炸方便面中的丙烯酰胺的含量相对较低"},{"from":229.45,"to":231.52,"content":"不同品牌的几十种方便面中"},{"from":231.52,"to":233.32,"content":"丙烯酰胺的平均含量范围"},{"from":233.32,"to":235.66,"content":"在15~80微克每公斤"},{"from":235.66,"to":238.72,"content":"就算以最高的80微克每公斤来计算"},{"from":238.72,"to":240.82,"content":"你一天就得吃20块面饼"},{"from":240.82,"to":242.94,"content":"才有一定概率触发癌症的按钮"},{"from":242.94,"to":245.16,"content":"我们再说回100多种添加剂啊"},{"from":245.16,"to":247.38,"content":"查看方便面背后的配料表"},{"from":247.38,"to":251.1,"content":"我们会发现面饼和调料包中都有一串添加剂"},{"from":251.1,"to":253.5,"content":"利用食品添加剂来稳定品质"},{"from":253.5,"to":255.34,"content":"是工业食品的常规操作"},{"from":255.34,"to":257.14,"content":"我们频道不止一次说过呀"},{"from":257.14,"to":259.06,"content":"食品添加剂不等于妖魔鬼怪"},{"from":259.06,"to":261.22,"content":"只要符合食品添加剂使用标准"},{"from":261.22,"to":263.66,"content":"都可以安心使用这些食品添加剂"},{"from":263.66,"to":264.62,"content":"各司其职"},{"from":264.62,"to":267.44,"content":"为方便面的色香味添砖加瓦"},{"from":267.44,"to":269.26,"content":"对于蔬菜包里的蔬菜干"},{"from":269.26,"to":272.17,"content":"也有人质疑是添加的防腐剂来保鲜"},{"from":272.17,"to":273.88,"content":"这其实和面饼一样啊"},{"from":273.88,"to":277.09,"content":"也是靠脱水技术而非防腐剂来实现的"},{"from":277.09,"to":278.96,"content":"目前蔬菜脱水干制"},{"from":278.96,"to":282.08,"content":"应用比较多的是热风干燥脱水和冷冻"},{"from":282.08,"to":283.3,"content":"真空干燥脱水"},{"from":283.3,"to":284.38,"content":"在脱水过程中呢"},{"from":284.38,"to":286.54,"content":"蔬菜中的水分会降低到3%"},{"from":286.54,"to":287.8,"content":"到14%以下"},{"from":287.8,"to":290.04,"content":"从而能更好地抑制微生物生长"},{"from":290.04,"to":292.53,"content":"避免蔬菜中的各种酶产生化学反应"},{"from":292.53,"to":296.77,"content":"但是代价是会流失水溶性维生素等营养物质"},{"from":296.77,"to":298.21,"content":"就如这份研究显示"},{"from":298.21,"to":299.8,"content":"相比于新鲜的胡萝卜"},{"from":299.8,"to":303.18,"content":"经过烘干脱水的胡萝卜维C含量有所流失"},{"from":303.18,"to":305.1,"content":"最后一个关于方便面的谣言呀"},{"from":305.1,"to":308.24,"content":"是方便面桶内侧上了一层防水蜡"},{"from":308.24,"to":311.12,"content":"用热水冲泡就会溶解出有毒物质"},{"from":311.12,"to":313.04,"content":"这层滑溜溜的防水膜呀"},{"from":313.04,"to":315.66,"content":"其实是食品级的聚乙烯镀膜"},{"from":315.66,"to":318.3,"content":"而聚乙烯的熔点在110度左右"},{"from":318.3,"to":319.56,"content":"我们小学就学过呀"},{"from":319.56,"to":320.88,"content":"在标准大气压下"},{"from":320.88,"to":322.74,"content":"水的沸点就是100℃"},{"from":322.74,"to":324.42,"content":"开了之后再继续加热"},{"from":324.42,"to":326.04,"content":"水的温度也不会上升了"},{"from":326.04,"to":327.72,"content":"所以即便是最滚烫的开水"},{"from":327.72,"to":330.96,"content":"也无法将面桶上的这层聚乙烯镀膜融化"},{"from":330.96,"to":333.87,"content":"虽然我们批了这么多方便面不健康的谣言"},{"from":333.87,"to":335.1,"content":"但是坦白来说"},{"from":335.1,"to":337.29,"content":"方便面是一种非常神奇的食品"},{"from":337.29,"to":338.86,"content":"瘦的人吃别人会说"},{"from":338.86,"to":339.88,"content":"难怪你这么瘦"},{"from":339.88,"to":341.5,"content":"胖的人吃别人会说"},{"from":341.5,"to":342.46,"content":"难怪你这么胖"},{"from":342.46,"to":343.96,"content":"这种矛盾对立的论调"},{"from":343.96,"to":346.42,"content":"背后隐藏着的是方便面的硬伤"},{"from":346.42,"to":348.24,"content":"高热量和营养不均衡"},{"from":348.24,"to":350.55,"content":"翻过面桶背后的营养成分表"},{"from":350.55,"to":351.51,"content":"我们会发现"},{"from":351.51,"to":353.34,"content":"方便面作为独立的一餐"},{"from":353.34,"to":355.62,"content":"营养均衡指数是并不达标的"},{"from":355.62,"to":357.14,"content":"存在高钠高脂肪"},{"from":357.14,"to":358.1,"content":"缺少蛋白质"},{"from":358.1,"to":359.96,"content":"维生素不足等客观问题"},{"from":359.96,"to":362.18,"content":"但这似乎也并不能推导出"},{"from":362.18,"to":364.18,"content":"方便面就等于垃圾食品的结论"},{"from":364.18,"to":365.32,"content":"为什么这么说呢"},{"from":365.32,"to":366.88,"content":"根据食品安全法的规定啊"},{"from":366.88,"to":370.16,"content":"有特定的色香味行等感官性状"},{"from":370.16,"to":372.14,"content":"有食品固有的一些营养成分"},{"from":372.14,"to":375.42,"content":"不会对人体健康产生各种急性慢性危害的食品"},{"from":375.42,"to":377.82,"content":"都不能被简单地当作垃圾食品"},{"from":377.82,"to":378.96,"content":"早在2016年"},{"from":378.96,"to":381.12,"content":"国家食品安全风险评估中心"},{"from":381.12,"to":383.8,"content":"风险交流部副主任钟凯就坦言呀"},{"from":383.8,"to":385.3,"content":"没有所谓的垃圾食品"},{"from":385.3,"to":387.34,"content":"只有不健康的膳食搭配"},{"from":387.34,"to":389.5,"content":"食物本身是没有好坏之分的"},{"from":389.5,"to":391.84,"content":"在无法获得新鲜食物的环境下"},{"from":391.84,"to":394.12,"content":"方便面仍然是一种好的选择"},{"from":394.12,"to":396.16,"content":"既能迅速解决人的温饱问题"},{"from":396.16,"to":397.96,"content":"还能保证基本的食品安全"},{"from":397.96,"to":400.86,"content":"认为方便面有损健康的观点可能源于"},{"from":400.86,"to":402.36,"content":"长期吃某一种食物"},{"from":402.36,"to":404.52,"content":"导致摄入某种营养成分过量"},{"from":404.52,"to":406.38,"content":"而其他营养成分摄入不足"},{"from":406.38,"to":408.57,"content":"从而出现了膳食不平衡的情况"},{"from":408.57,"to":410.88,"content":"因此呀方便面是不是垃圾食品"},{"from":410.88,"to":412.67,"content":"主要取决于你的吃法"},{"from":412.67,"to":413.54,"content":"换一种吃法"},{"from":413.54,"to":415.16,"content":"方便面也可以很健康"},{"from":415.16,"to":416.12,"content":"架锅烧水"},{"from":416.12,"to":417.74,"content":"将面饼过水去油"},{"from":417.74,"to":419.9,"content":"或者直接选择非油炸型的面饼"},{"from":419.9,"to":422,"content":"也可以有效的减少油脂的摄入"},{"from":422,"to":424.04,"content":"如果想要控制好钠盐的摄入"},{"from":424.04,"to":425.42,"content":"可以少放些调料包"},{"from":425.42,"to":427.32,"content":"再简单搭配上鸡蛋"},{"from":427.32,"to":428.01,"content":"动物肉"},{"from":428.01,"to":431.1,"content":"蔬菜来填补蛋白质和维生素的亏空"},{"from":431.1,"to":432.96,"content":"那健康就有了美味"},{"from":432.96,"to":433.88,"content":"也不能落后啊"},{"from":433.88,"to":436.1,"content":"加入这么多食材炖煮方便面"},{"from":436.1,"to":437.76,"content":"汤底就显得尤为重要"},{"from":437.76,"to":439.38,"content":"一碗方便面好不好吃"},{"from":439.38,"to":441.03,"content":"尝这一口汤就知道了"},{"from":441.03,"to":443.76,"content":"2024年新一代白象汤好喝"},{"from":443.76,"to":446.56,"content":"真味汤馆推出了山君老母鸡汤面"},{"from":446.56,"to":449.54,"content":"和白玉萝卜牛肉汤面两款招牌产品"},{"from":449.54,"to":451.16,"content":"真味汤馆系列面饼"},{"from":451.16,"to":454.5,"content":"选取麦芯最优质的30%作为主要原料"},{"from":454.5,"to":458.04,"content":"使用国产小麦与进口优质小麦科学配比"},{"from":458.04,"to":459.6,"content":"再加入鸡全蛋粉"},{"from":459.6,"to":461.76,"content":"使面条更加筋道鲜爽"},{"from":461.76,"to":463.36,"content":"配菜就是真材实料"},{"from":463.36,"to":464.74,"content":"山君老母鸡汤面"},{"from":464.74,"to":466.06,"content":"搭配冻干鸡肉"},{"from":466.06,"to":466.84,"content":"杏鲍菇"},{"from":466.84,"to":467.56,"content":"白玉菇"},{"from":467.56,"to":470.38,"content":"虫草花枸杞白玉萝卜牛肉汤面"},{"from":470.38,"to":471.82,"content":"搭配冻干牛肉"},{"from":471.82,"to":472.51,"content":"白萝卜"},{"from":472.51,"to":473.19,"content":"蒜苗"},{"from":473.19,"to":476.31,"content":"香菜高汤包代替粉包酱包"},{"from":476.31,"to":480.6,"content":"用传统中式熬汤工艺100度文火慢熬六小时"},{"from":480.6,"to":483.12,"content":"将食材本味锁进每一滴汤汁里"},{"from":483.12,"to":483.9,"content":"零防腐剂"},{"from":483.9,"to":485.1,"content":"零反式脂肪酸"},{"from":485.1,"to":486.7,"content":"通过地道熬煮工艺"},{"from":486.7,"to":487.9,"content":"搭配地道食材"},{"from":487.9,"to":490.51,"content":"为大家还原一碗地道好汤面"},{"from":490.51,"to":492.9,"content":"工业食品啊是现代化的馈赠"},{"from":492.9,"to":494.79,"content":"尽管一个新生事物的出现"},{"from":494.79,"to":496.8,"content":"几乎一定会遭受排异反应"},{"from":496.8,"to":498.96,"content":"但是文明的伟大之处就在于"},{"from":498.96,"to":501.18,"content":"我们会利用工具去无存精"},{"from":501.18,"to":502.02,"content":"为我所用"},{"from":502.02,"to":504.94,"content":"单吃方便面可能称不上膳食均衡"},{"from":504.94,"to":506.98,"content":"但是他可以在某个加班后"},{"from":506.98,"to":508.48,"content":"成为打工人的救命药草"},{"from":508.48,"to":510.64,"content":"也可以在第一时间赶到灾区"},{"from":510.64,"to":512.44,"content":"成为救急应灾的食品"},{"from":512.44,"to":515.1,"content":"更可以凭借其百搭方便的特性"},{"from":515.1,"to":516.6,"content":"搭配蔬果蛋奶"},{"from":516.6,"to":522.109,"content":"成为一顿丰盛美味又营养健康的暖人佳肴"},{"from":522.389,"to":523.669,"content":"这里是赛博实录"},{"from":523.669,"to":525.349,"content":"如果你觉得今天的视频还不错"},{"from":525.349,"to":526.51,"content":"欢迎一键三连"},{"from":526.51,"to":528.37,"content":"如果你也想知道在这个时代"},{"from":528.37,"to":529.63,"content":"谁决定了我们吃什么"},{"from":529.63,"to":530.56,"content":"可以关注我们"},{"from":530.56,"to":532.1,"content":"下期再见拜拜"}],"chapters":[],"acquisition":{"subtitles":"available","subtitleReason":null,"subtitleFetchedAt":"2026-10-04T23:25:25.599Z","subtitleMethod":"cli-legacy-player-api","subtitleLanguage":"ai-zh","subtitleSource":"ai","chapters":"empty","chaptersFetchedAt":"2026-10-04T23:25:21.020Z"}}
