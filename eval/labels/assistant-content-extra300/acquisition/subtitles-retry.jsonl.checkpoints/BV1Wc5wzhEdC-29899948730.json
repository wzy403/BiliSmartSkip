nt":"资源被封锁"},{"from":416.97,"to":417.87,"content":"外交受挫"},{"from":417.87,"to":419.31,"content":"国内局势紧张"},{"from":419.31,"to":420.95,"content":"站在命运的十字路口"},{"from":420.95,"to":423.53,"content":"日本必须在有限的时间内做出选择"},{"from":423.53,"to":426.17,"content":"是向美国妥协还是以战争破局"},{"from":426.17,"to":428.49,"content":"当时的日本面临两个难题"},{"from":428.49,"to":430.95,"content":"首先是资源危机的步步紧逼"},{"from":430.95,"to":432.89,"content":"自美国实施石油禁运以来"},{"from":432.89,"to":435.79,"content":"日本的燃料储备迅速成为最紧迫的问题"},{"from":435.79,"to":438,"content":"按照海军省与陆军省的推算"},{"from":438,"to":440.16,"content":"即便采取最严格的节约措施"},{"from":440.16,"to":442.08,"content":"日本的石油库存也只能维持"},{"from":442.08,"to":443.82,"content":"一年到一年半的作战需求"},{"from":443.82,"to":445.51,"content":"如果继续消极等待"},{"from":445.51,"to":448.71,"content":"日本不仅在未来会因油料耗尽而陷入瘫痪"},{"from":448.71,"to":451.49,"content":"而且会在外交谈判中彻底丧失筹码"},{"from":451.49,"to":454.33,"content":"因此尽快夺取资源丰富的南方区域"},{"from":454.33,"to":456.409,"content":"成为日本不得不考虑的选项"},{"from":456.409,"to":459.249,"content":"南方资源地带即包括英属马来亚"},{"from":460.169,"to":461.069,"content":"缅甸等地"},{"from":461.069,"to":463.029,"content":"是当时世界上最重要的石油"},{"from":463.029,"to":464.9,"content":"橡胶和锡矿产地之一"},{"from":468.2,"to":470.419,"content":"正是日本渴望已久的战略目标"},{"from":470.419,"to":472.039,"content":"然而要向南扩张"},{"from":472.039,"to":474.7,"content":"就必然触碰到英美两国的利益防线"},{"from":474.7,"to":475.78,"content":"更重要的是"},{"from":475.78,"to":478.7,"content":"美国在菲律宾群岛部署了强大的军事力量"},{"from":478.7,"to":479.92,"content":"一旦日本动手"},{"from":479.92,"to":482.07,"content":"美国必然采取反制措施"},{"from":482.07,"to":484.47,"content":"因此日本若要夺取南方资源"},{"from":484.47,"to":486.65,"content":"必须首先解决背后的最大障碍"},{"from":489.81,"to":491.13,"content":"1941年10月"},{"from":493.909,"to":495.249,"content":"东条出身陆军"},{"from":495.249,"to":496.829,"content":"主张对外扩张政策"},{"from":496.829,"to":498.229,"content":"反对在中国撤军"},{"from":498.229,"to":500.76,"content":"对于美国的谈判持极度悲观态度"},{"from":500.76,"to":501.96,"content":"他的上台意味着"},{"from":501.96,"to":505.21,"content":"日本政府整体倾向于以武力解决国际矛盾"},{"f