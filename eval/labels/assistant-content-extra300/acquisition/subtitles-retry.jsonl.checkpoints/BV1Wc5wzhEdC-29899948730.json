{"schemaVersion":1,"bvid":"BV1Wc5wzhEdC","cid":29899948730,"subtitles":[{"from":0.04,"to":1.86,"content":"1941年12月7日"},{"from":1.86,"to":3.429,"content":"夏威夷群岛的清晨"},{"from":3.429,"to":5.509,"content":"阳光洒在宁静的珍珠港上"},{"from":5.509,"to":7.189,"content":"军舰停泊在港口中"},{"from":7.189,"to":9.469,"content":"美军士兵们有的在甲板上忙碌"},{"from":9.469,"to":11.58,"content":"有的还在睡梦中没有起床"},{"from":11.58,"to":12.42,"content":"与此同时"},{"from":12.42,"to":15.26,"content":"在珍珠港北方约370km的海域上"},{"from":15.26,"to":18.54,"content":"数百架日本战机在远洋航母上整装待发"},{"from":18.54,"to":20.6,"content":"他们穿越太平洋的茫茫云海"},{"from":20.6,"to":22.08,"content":"只为执行一个命令"},{"from":22.08,"to":23.84,"content":"重创美国太平洋舰队"},{"from":23.84,"to":26.41,"content":"为日本夺取亚洲霸权扫清障碍"},{"from":26.41,"to":29.03,"content":"当第一批日本鱼雷击中美军战舰"},{"from":29.03,"to":30.13,"content":"巨大的爆炸声"},{"from":30.13,"to":31.53,"content":"划破了清晨的宁静"},{"from":31.53,"to":34.17,"content":"船上的美国人立刻从沉睡中惊醒"},{"from":34.17,"to":36.53,"content":"日本联合舰队出动六艘航母"},{"from":36.53,"to":38.65,"content":"近400架战机向美国"},{"from":38.65,"to":40.79,"content":"夏威夷的珍珠港发动猛烈进攻"},{"from":40.79,"to":42.31,"content":"港口被炮火覆盖"},{"from":42.31,"to":43.79,"content":"战舰也大量沉没"},{"from":43.79,"to":45.49,"content":"岛上的美国人乱作一团"},{"from":45.49,"to":46.489,"content":"伤亡惨重"},{"from":46.489,"to":48.709,"content":"这就是震惊世界的珍珠港事件"},{"from":48.709,"to":51.169,"content":"这场偷袭标志着太平洋战争的爆发"},{"from":51.169,"to":54.37,"content":"也将一直观战的美国拉入了第二次世界大战"},{"from":54.37,"to":56.75,"content":"日本为什么敢冒天下之大不韪"},{"from":56.75,"to":59.43,"content":"主动挑衅一个远比自己强大的国家"},{"from":59.43,"to":61.53,"content":"这个决策背后是冲动误判"},{"from":61.53,"to":63.55,"content":"还是深思熟虑后的孤注一掷"},{"from":63.55,"to":67.47,"content":"本期我们就来回顾一下珍珠港事件背后的故事"},{"from":73.14,"to":76.48,"content":"日本和美国的矛盾在二战前就由来已久"},{"from":76.48,"to":79.62,"content":"日本和美国这两个国家都是从19世纪末"},{"from":79.62,"to":81.73,"content":"在东亚开始了各自的扩张道路"},{"from":81.73,"to":84.21,"content":"日本在1895年甲午海战胜利后"},{"from":84.21,"to":86.68,"content":"获得了台湾和朝鲜半岛的控制权"},{"from":86.68,"to":89.2,"content":"美国则通过1899年的美菲战争"},{"from":89.2,"to":90.52,"content":"成功占领了菲律宾"},{"from":90.52,"to":93.09,"content":"从此两国就产生了地缘战略矛盾"},{"from":93.09,"to":94.87,"content":"1905年日俄战争后"},{"from":94.87,"to":97.04,"content":"日本在东亚的地位进一步上升"},{"from":97.04,"to":97.6,"content":"一战后"},{"from":97.6,"to":98.72,"content":"由于德国的战败"},{"from":98.72,"to":101.46,"content":"日本更是获取了德国在中国山东的权益"},{"from":101.46,"to":104.07,"content":"还开始在南洋群岛建立委任统治"},{"from":104.07,"to":105.93,"content":"而日本势力的不断扩张"},{"from":105.93,"to":107.23,"content":"直接威胁到了美国"},{"from":107.23,"to":109.61,"content":"在亚洲的经济利益和政治影响力"},{"from":109.61,"to":110.75,"content":"1921年"},{"from":110.75,"to":112.91,"content":"美国主导召开了华盛顿会议"},{"from":112.91,"to":114.75,"content":"意图限制日本海军扩军"},{"from":114.75,"to":118.43,"content":"规定了美英日三国的战列舰比例为五比五比三"},{"from":118.43,"to":119.77,"content":"日本被迫接受"},{"from":119.77,"to":121.21,"content":"但仍然心存不满"},{"from":121.21,"to":123.79,"content":"日本内部出现强烈的摆脱欧美限制"},{"from":123.79,"to":125.05,"content":"扩大国力的声音"},{"from":125.05,"to":127.539,"content":"美日在军事上也逐渐走向敌对"},{"from":127.539,"to":129.019,"content":"20世纪30年代"},{"from":129.019,"to":130.779,"content":"经济大萧条席卷全球"},{"from":130.779,"to":132.15,"content":"世界秩序崩塌"},{"from":132.15,"to":134.97,"content":"各国为了争夺资源和市场而彼此对立"},{"from":134.97,"to":136.91,"content":"国际社会变得越发动荡"},{"from":136.91,"to":138.19,"content":"日本国土贫瘠"},{"from":138.19,"to":139.01,"content":"资源匮乏"},{"from":139.01,"to":142.11,"content":"这一现实问题一直困扰着日本的国策制定者"},{"from":142.11,"to":143.63,"content":"尤其是石油橡胶"},{"from":143.63,"to":146.39,"content":"铁矿石等现代工业社会不可或缺的资源"},{"from":146.39,"to":148.81,"content":"日本本土几乎无法独自供应"},{"from":148.81,"to":150.69,"content":"为了支撑国家的工业化进程"},{"from":150.69,"to":152.44,"content":"和日益膨胀的军事需求"},{"from":152.44,"to":154.68,"content":"日本开始向外寻求资源供应"},{"from":154.68,"to":157.96,"content":"而最直接的目标就是亚洲大陆和东南亚地区"},{"from":157.96,"to":159.86,"content":"那些蕴藏丰富资源的地方"},{"from":159.86,"to":161.14,"content":"在这样的背景下"},{"from":161.14,"to":163.269,"content":"日本加快了对外侵略的步伐"},{"from":163.269,"to":164.229,"content":"1931年"},{"from":166.929,"to":169.019,"content":"并在那里建立了伪满洲国"},{"from":169.019,"to":172.079,"content":"这一事件更是成为了日美矛盾加剧的导火索"},{"from":172.079,"to":174.399,"content":"美国一贯奉行门户开放政策"},{"from":174.399,"to":175.719,"content":"强调利益均沾"},{"from":175.719,"to":178.019,"content":"而不希望出现一家独大的局面"},{"from":178.019,"to":179.739,"content":"日本对中国东北的占领"},{"from":179.739,"to":181.299,"content":"直接破坏了这一原则"},{"from":181.299,"to":183.329,"content":"引起了美国的强烈不满"},{"from":183.329,"to":185.509,"content":"然而在当时的国际局势下"},{"from":185.509,"to":187.769,"content":"美国采取的手段仍然较为温和"},{"from":187.769,"to":189.94,"content":"由于正处于经济大萧条时期"},{"from":189.94,"to":192.5,"content":"美国政府更加关注国内经济复苏"},{"from":192.5,"to":194.19,"content":"对外政策趋于保守"},{"from":197.33,"to":200.65,"content":"但并未采取更为激烈的经济制裁或军事措施"},{"from":200.65,"to":202.41,"content":"时间进入到1937年"},{"from":202.41,"to":204.11,"content":"日本进一步扩大侵略"},{"from":204.11,"to":206.33,"content":"发动了对中国的全面侵略战争"},{"from":206.33,"to":207.94,"content":"及著名的七七事变"},{"from":207.94,"to":209.56,"content":"随后局势愈演愈烈"},{"from":209.56,"to":210.36,"content":"淞沪会战"},{"from":210.36,"to":211.36,"content":"南京大屠杀"},{"from":211.36,"to":213.46,"content":"以及对中国东部的长期占领"},{"from":213.46,"to":216.54,"content":"使得国际社会对日本的谴责之声不断高涨"},{"from":216.54,"to":218.98,"content":"美国国内的舆论也逐渐转向反日"},{"from":218.98,"to":221.529,"content":"要求对日本采取更为严厉的政策"},{"from":221.529,"to":222.609,"content":"尽管如此"},{"from":222.609,"to":225.569,"content":"美国政府在最初几年仍然试图保持中立"},{"from":225.569,"to":227.649,"content":"主要通过经济援助中国的方式"},{"from":227.649,"to":228.91,"content":"间接支持抗日"},{"from":228.91,"to":230.25,"content":"直到1940年"},{"from":230.25,"to":232.65,"content":"欧洲战场爆发了更加剧烈的冲突"},{"from":232.65,"to":234.35,"content":"德国迅速横扫西欧"},{"from":234.35,"to":234.93,"content":"法国"},{"from":234.93,"to":237.11,"content":"荷兰等殖民帝国相继败退"},{"from":237.11,"to":239.85,"content":"这为日本进一步南进提供了绝佳机会"},{"from":239.85,"to":241.52,"content":"日本趁机向南推进"},{"from":241.52,"to":242.84,"content":"图谋占领东南亚"},{"from":242.84,"to":244.18,"content":"尤其是富含石油"},{"from":247.61,"to":248.53,"content":"在此期间"},{"from":248.53,"to":249.77,"content":"日本与纳粹德国"},{"from":249.77,"to":251.57,"content":"意大利结成了轴心国集团"},{"from":251.57,"to":254.17,"content":"于1940年签署三国同盟条约"},{"from":254.17,"to":254.89,"content":"这一举动"},{"from":254.89,"to":257.53,"content":"标志着日本正式站在了反英美的立场上"},{"from":257.53,"to":260.69,"content":"公开挑衅美国在太平洋地区的利益"},{"from":261.279,"to":263.279,"content":"1940年"},{"from":264.979,"to":267.099,"content":"以图切断中国的对外补给线"},{"from":267.099,"to":269.659,"content":"同时为南下东南亚做战略准备"},{"from":269.659,"to":272.079,"content":"这一系列动作极大刺激了美国"},{"from":272.079,"to":273.099,"content":"美国意识到"},{"from":273.099,"to":274.639,"content":"如果任由日本扩张"},{"from":274.639,"to":276.019,"content":"整个西太平洋地区"},{"from":276.019,"to":278.17,"content":"乃至东南亚都将落入日本之手"},{"from":278.17,"to":280.77,"content":"威胁到美国在亚洲的长期战略利益"},{"from":280.77,"to":283.61,"content":"尤其是菲律宾群岛和夏威夷群岛的安全"},{"from":283.61,"to":286.65,"content":"于是美国开始转向更为强硬的对日政策"},{"from":286.65,"to":290.19,"content":"首先美国政府宣布对日本实施部分经济制裁"},{"from":290.19,"to":292.19,"content":"限制对日本出口航空燃油"},{"from":292.19,"to":293.94,"content":"钢铁等重要战略物资"},{"from":297.12,"to":299.23,"content":"美国的态度变得更加严厉"},{"from":299.23,"to":300.73,"content":"1941年7月"},{"from":300.73,"to":302.93,"content":"美国宣布冻结日本在美资产"},{"from":302.93,"to":303.97,"content":"并联合英国"},{"from":303.97,"to":306.409,"content":"荷兰等国对日本实行全面禁运"},{"from":306.409,"to":308.9,"content":"特别是切断了对日本的石油出口"},{"from":308.9,"to":311.78,"content":"石油禁运对日本来说无异于致命打击"},{"from":311.78,"to":315.32,"content":"彼时日本每年消耗的石油大部分依赖进口"},{"from":315.32,"to":317.28,"content":"其中绝大多数来自美国"},{"from":317.28,"to":318.88,"content":"一旦没有石油供应"},{"from":318.88,"to":319.76,"content":"日本海军"},{"from":319.76,"to":323.15,"content":"空军乃至整个国家的工业机器都将陷入停摆"},{"from":323.15,"to":324.81,"content":"根据日本军方的估算"},{"from":324.81,"to":326.53,"content":"如果不采取果断行动"},{"from":326.53,"to":329.77,"content":"日本储备的石油最多只能支持一年半的时间"},{"from":329.77,"to":331.53,"content":"面对严峻的资源危机"},{"from":331.53,"to":334.25,"content":"日本国内围绕对