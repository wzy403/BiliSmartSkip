{"schemaVersion":1,"bvid":"BV1wJ4m1e7Yv","cid":29427631507,"subtitles":[{"from":4.019,"to":5.579,"content":"小动力课堂开课了"},{"from":5.579,"to":7.659,"content":"电脑硬盘天天爆满怎么办呢"},{"from":7.659,"to":9.51,"content":"多半是垃圾太多了"},{"from":9.51,"to":12.39,"content":"网络上C盘清理的教程呢实在也是太多太多了"},{"from":12.39,"to":14.53,"content":"在B站的一搜一页都是啊"},{"from":14.53,"to":16.259,"content":"有用吗有用"},{"from":16.259,"to":17.679,"content":"但是治标不治本"},{"from":17.679,"to":19.179,"content":"电脑空间就那么多"},{"from":19.179,"to":20.799,"content":"装几部小电影就满了"},{"from":20.799,"to":22.779,"content":"那这个时候呢还在清理C盘吗"},{"from":22.779,"to":26.129,"content":"这个时候你要做的就是加装硬盘"},{"from":26.129,"to":27.629,"content":"这个时候呢身为小白的"},{"from":27.629,"to":30.349,"content":"你肯定是会把电脑带去电脑店啊"},{"from":30.349,"to":31.61,"content":"购买硬盘"},{"from":31.61,"to":32.49,"content":"到了电脑店"},{"from":32.49,"to":33.97,"content":"人家给你聊一圈下来"},{"from":33.97,"to":35.17,"content":"硬盘赚你100"},{"from":35.17,"to":37.39,"content":"安装费呢最少也赚你个50"},{"from":37.39,"to":38.97,"content":"如果要装个系统"},{"from":38.97,"to":40.33,"content":"然后又赚你几十块钱"},{"from":40.33,"to":42.11,"content":"对于很多不懂电脑的朋友来说呢"},{"from":42.11,"to":43.73,"content":"风险确实小了"},{"from":43.73,"to":46.11,"content":"但是其实固态硬盘的安装和更换"},{"from":46.11,"to":49.28,"content":"其实是更换电脑硬件最简单的一项了"},{"from":49.28,"to":50.66,"content":"只要操作正确"},{"from":50.66,"to":54.49,"content":"就可以保证硬件99%是安全的"},{"from":54.49,"to":55.41,"content":"那本期视频呢"},{"from":55.41,"to":57.49,"content":"我们将带领零基础的小伙伴们"},{"from":57.49,"to":59.27,"content":"走进硬盘这个领域"},{"from":59.27,"to":62.61,"content":"让空间爆满的电脑重获熏声"},{"from":62.61,"to":64.39,"content":"本期视频呢将分为三个部分"},{"from":64.39,"to":65.03,"content":"第一个部分呢"},{"from":65.03,"to":67.88,"content":"将会科普我们所见到的硬盘的种类"},{"from":67.88,"to":71.02,"content":"那之后呢将会告诉大家如何找到固态硬盘"},{"from":71.02,"to":73.56,"content":"并且呢进行拆解和更换"},{"from":73.56,"to":76.12,"content":"觉得本期内容不错且实用的朋友们"},{"from":76.12,"to":77.68,"content":"一定要给我们个一键三连哦"},{"from":77.68,"to":79.23,"content":"也可以先收藏"},{"from":79.59,"to":81.19,"content":"首先呢我们来说一下"},{"from":81.19,"to":83.87,"content":"现在消费级的硬盘呢被分为两大类"},{"from":83.87,"to":85.25,"content":"一种呢是机械硬盘"},{"from":85.25,"to":86.9,"content":"一种呢是固态硬盘"},{"from":86.9,"to":89.78,"content":"前者机械硬盘呢是比较传统的存储方式"},{"from":89.78,"to":91.06,"content":"速度呢比较慢"},{"from":91.06,"to":92.78,"content":"但是硬盘呢如果损坏的话呢"},{"from":92.78,"to":94.06,"content":"数据是可以修复的"},{"from":94.06,"to":95.64,"content":"就适合存储数据"},{"from":95.64,"to":99.72,"content":"而固态硬盘呢采用了flash闪存颗粒"},{"from":99.72,"to":100.92,"content":"读写速度快"},{"from":100.92,"to":102.08,"content":"适合作为系统盘"},{"from":102.08,"to":103.32,"content":"还有游戏盘来使用"},{"from":103.32,"to":104.32,"content":"重要的数据呢"},{"from":104.32,"to":106.64,"content":"建议是备份至机械硬盘"},{"from":106.64,"to":108.44,"content":"因为固态硬盘它的损坏呢"},{"from":108.44,"to":110.18,"content":"数据恢复是比较难的"},{"from":110.18,"to":111.96,"content":"目前呢我们能够接触到的硬盘呢"},{"from":111.96,"to":113.32,"content":"就主要分为2.5寸"},{"from":113.32,"to":113.96,"content":"3.5寸"},{"from":113.96,"to":115.289,"content":"还有SATA接口的硬盘"},{"from":115.289,"to":117.169,"content":"然后M2接口的SATA协议"},{"from":117.169,"to":119.109,"content":"还有NVM1协议固态硬盘"},{"from":119.109,"to":120.749,"content":"AIC固态硬盘"},{"from":120.749,"to":123.13,"content":"还有少有的U2硬盘"},{"from":123.13,"to":125.17,"content":"U2还有AIC固态硬盘的"},{"from":125.17,"to":127.35,"content":"一般都是企业级别的硬盘啊"},{"from":127.35,"to":130.1,"content":"然后市面上虽然它也有销售"},{"from":130.1,"to":131.26,"content":"但是呢不是主流"},{"from":131.26,"to":134.4,"content":"所以呢我们就不给新手朋友来介绍了"},{"from":134.6,"to":136.92,"content":"首先我们来说一下SATA接口的硬盘"},{"from":136.92,"to":139.44,"content":"我们见到的2.5英寸还有3.5英寸硬盘"},{"from":139.44,"to":140.94,"content":"它使用的都是SATA"},{"from":140.94,"to":143.3,"content":"SATA呢是一种物理接口标准"},{"from":143.3,"to":146.86,"content":"那目前呢SATA3的最大带宽呢是6GBPS"},{"from":146.86,"to":148.86,"content":"市面上主流的SATA接口的固态硬盘"},{"from":148.86,"to":151.83,"content":"的最大传输速率呢大约是每秒600兆"},{"from":151.83,"to":154.63,"content":"是常规机械硬盘的两倍之多"},{"from":154.63,"to":158.61,"content":"当然部分厂商呢在SATA的基础上面研发了sata express"},{"from":158.61,"to":161.78,"content":"然后呢使用的是PCIE成二通道"},{"from":161.78,"to":164.16,"content":"最大带宽呢可以达到16GBPS"},{"from":164.16,"to":167.32,"content":"但是由于兼容32GBPS的M点二接口"},{"from":167.32,"to":171.579,"content":"出现sata express呢就显得有点不上不下了"},{"from":171.579,"to":173.619,"content":"在介绍硬盘尺寸之前"},{"from":173.619,"to":174.999,"content":"我们先来说个知识点"},{"from":174.999,"to":177.579,"content":"硬盘的英寸呢不是指外壳的尺寸"},{"from":177.579,"to":180.63,"content":"而是硬盘盘片的直径尺寸呢"},{"from":180.63,"to":182.899,"content":"好接下来进入正题"},{"from":183.299,"to":184.819,"content":"虽然3.5英寸的硬盘呢"},{"from":184.819,"to":186.339,"content":"早在1984年的时候呢"},{"from":186.339,"to":187.339,"content":"就已经诞生了"},{"from":187.339,"to":189.019,"content":"但是由于当时无人重视"},{"from":189.019,"to":190.67,"content":"所以呢没落了一段时间"},{"from":190.67,"to":194.43,"content":"其真正发扬光大还是在1991年"},{"from":194.43,"to":198.11,"content":"IBM推出首款容量为1GB的机械硬盘"},{"from":198.11,"to":200.79,"content":"0663112的时候"},{"from":200.79,"to":202.55,"content":"这款硬盘呢开创了小尺寸"},{"from":202.55,"to":205.11,"content":"民用级的GB级硬盘的先河"},{"from":205.11,"to":206.59,"content":"而3.5寸硬盘的规格呢"},{"from":206.59,"to":209.67,"content":"也成为了后来呃硬盘的标准规格"},{"from":209.67,"to":211.43,"content":"取代了早期转速慢"},{"from":211.43,"to":214.05,"content":"尺寸大的5.25英寸硬盘"},{"from":214.05,"to":217.49,"content":"3.5寸硬盘常规的长度呢是147mm"},{"from":217.49,"to":219.13,"content":"宽度呢是102mm"},{"from":219.13,"to":221.45,"content":"不同的产品的尺寸略有差异"},{"from":221.45,"to":223.45,"content":"但其恐惧基本相同"},{"from":223.45,"to":226.94,"content":"那这样才能够符合机箱预留孔的安装标准吗"},{"from":226.94,"to":228.74,"content":"目前主流的机械硬盘的厚度呢"},{"from":228.74,"to":230.22,"content":"都在26mm左右"},{"from":230.22,"to":232.74,"content":"也是目前市场上较为标准的厚度"},{"from":232.74,"to":233.16,"content":"当然了"},{"from":233.16,"to":236.22,"content":"3.5英寸硬盘呢它绝大部分都是机械硬盘"},{"from":236.22,"to":240.32,"content":"所以呢厚度跟盘内封装的盘片数量是有关的"},{"from":240.52,"to":242.76,"content":"由于3.5英寸的硬盘的尺寸比较大"},{"from":242.76,"to":243.68,"content":"1989年"},{"from":243.68,"to":245.96,"content":"一家新兴存储厂商就推出了"},{"from":245.96,"to":247.7,"content":"用尺寸为2.5英寸的硬盘"},{"from":247.7,"to":250.019,"content":"就成为了当时硬盘领域的焦点了"},{"from":250.019,"to":253.619,"content":"2.5寸硬盘的特点呢就是它的尺寸小轻便"},{"from":253.619,"to":255.34,"content":"不需要太多的供电"},{"from":255.34,"to":257.5,"content":"因此之后的30多年的时间里面"},{"from":257.5,"to":260.12,"content":"2.5英寸硬盘呢一直都是笔记本电脑"},{"from":260.12,"to":262.54,"content":"还有移动设备存储的热门产品"},{"from":262.54,"to":266.12,"content":"2.5寸硬盘的长度呢一般为100mm"},{"from":266.12,"to":268.02,"content":"宽度呢为70mm"},{"from":268.02,"to":268.5,"content":"当然了"},{"from":268.5,"to":271.36,"content":"厚度是2.5英寸硬盘差距较大的地方"},{"from":271.36,"to":273.4,"content":"目前常见的厚度有5mm"},{"from":273.4,"to":274.02,"content":"7mm"},{"from":274.02,"to":274.82,"content":"9.5mm"},{"from":274.82,"to":276.92,"content":"12.5mm和15mm"},{"from":276.92,"to":279.12,"content":"由于笔记本电脑它追求轻薄嘛"},{"from":279.12,"to":281.68,"content":"所以大部分预留的2.5硬盘的槽位的"},{"from":281.68,"to":282.36,"content":"笔记本电脑呢"},{"from":282.36,"to":284,"content":"它只兼容了7mm的厚度"},{"from":284,"to":284.56,"content":"后来呢"},{"from":284.56,"to":287.96,"content":"固态硬盘SSD开始占领了2.5英寸"},{"from":287.96,"to":289.53,"content":"机械硬盘的市场"},{"from":289.53,"to":292.87,"content":"在同样的空间内做到与机械硬盘相同"},{"from":292.87,"to":294.47,"content":"甚至超过它的容量"},{"from":294.47,"to":296.11,"content":"于是呢2.5英寸硬盘呢"},{"from":296.11,"to":299.19,"content":"同时被机械硬盘和固态硬盘占据"},{"from":299.19,"to":302.05,"content":"而它也兼容绝大多数的设备"},{"from":302.41,"to":304.67,"content":"NDI接口呢是当下主流的接口"},{"from":304.67,"to":307.92,"content":"在大部分的桌面级移动端上面都有出现"},{"from":307.92,"to":309.7,"content":"取代的是MSATA接口"},{"from":309.7,"to":313.6,"content":"M2接口呢可以兼容SATAPCIEUSBHS"},{"from":313.6,"to":318.479,"content":"ICU a RT s m bus等多种通信协议"},{"from":318.479,"to":320.779,"content":"是目前最广泛的固态硬盘接口"},{"from":320.779,"to":323.18,"content":"也是未来多年的主要发展趋势"},{"from":323.18,"to":325.12,"content":"而M2硬盘呢又有多种规格"},{"from":325.12,"to":328.18,"content":"其中就包括M2NGFF"},{"from":328.18,"to":330.13,"content":"还有M2MM1"},{"from":330.13,"to":331.33,"content":"在选购硬盘的时候呢"},{"from":331.33,"to":335.61,"content":"要尽量选择NBM1协议的M2硬盘"},{"from":335.61,"to":336.33,"content":"速度快"},{"from":336.33,"to":337.05,"content":"体验好"},{"from":337.05,"to":342.55,"content":"我们俗称的NGFF是取代M萨塔的硬盘规格"},{"from":342.55,"to":344.6,"content":"那这种硬盘呢它的速度比较慢"},{"from":344.6,"to":347.04,"content":"分辨这两块硬盘呢也比较简单啊"},{"from":347.04,"to":350.84,"content":"俗称的mg f f硬盘呢在尖手指有两个缺口"},{"from":350.84,"to":353.18,"content":"而NVME硬盘呢它只有一个缺口"},{"from":353.18,"to":355.74,"content":"当然M2硬盘有多种规格"},{"from":355.74,"to":360.4,"content":"其中包括223022422260280"},{"from":360.4,"to":362.83,"content":"以及企业级别的22110"},{"from":362.83,"to":364.77,"content":"目前的2230硬盘比较少"},{"from":364.77,"to":369.97,"content":"多用于相机cf1卡改造或者是steam deck的拓展"},{"from":369.97,"to":371.25,"content":"2242硬盘呢"},{"from":371.25,"to":373.51,"content":"一般是多用于小规格的移动设备"},{"from":373.51,"to":377.41,"content":"比较有代表性的呢就是联想小新办公类笔记本"},{"from":377.41,"to":379.49,"content":"用的就是这种规格的硬盘"},{"from":379.49,"to":382.13,"content":"2260呢同样也是一些笔记本在使用的"},{"from":382.13,"to":382.79,"content":"但是不多"},{"from":382.79,"to":385.52,"content":"2280硬盘呢可以兼容大多数的设备"},{"from":385.52,"to":387.08,"content":"包括桌面及电脑"},{"from":387.08,"to":387.96,"content":"移动端电脑"},{"from":387.96,"to":390.86,"content":"还有PS5游戏机服务器等等等等"},{"from":390.86,"to":392.909,"content":"是目前主流硬盘的规格"},{"from":392.909,"to":395.409,"content":"而R2110呢是服务器的规格"},{"from":395.409,"to":398.149,"content":"虽然也有部分中高端的桌面级电脑支持"},{"from":398.149,"to":401.3,"content":"但是硬盘大部分都是服务上面淘汰下来的"},{"from":401.3,"to":404.56,"content":"能够买到全新的R2110硬盘实在是少啊"},{"from":404.56,"to":406.45,"content":"所以呢不建议使用"},{"from":406.73,"to":408.73,"content":"首先呢来说一下机械硬盘"},{"from":408.73,"to":411.17,"content":"而机械硬盘呢简称HDD"},{"from":411.17,"to":413.33,"content":"一块机械硬盘呢由盘片"},{"from":413.33,"to":417.54,"content":"磁头盘片转轴控制电机磁头控制器"},{"from":417.54,"to":418.74,"content":"数据转换器"},{"from":418.74,"to":421.45,"content":"接口缓存等多个部分组成"},{"from":421.45,"to":422.73,"content":"其主要原理呢是由"},{"from":422.73,"to":424.99,"content":"磁头会沿着盘片的半径来运转"},{"from":424.99,"to":427.79,"content":"而盘片呢会跟随着转轴进行"},{"from":427.79,"to":429.65,"content":"每分钟几千转的旋转"},{"from":429.65,"to":433.12,"content":"此时读写的数据呢会通过磁头上面的电磁流"},{"from":433.12,"to":434.5,"content":"来写入到磁盘上"},{"from":434.5,"to":436.46,"content":"这就是机械硬盘的基本构造"},{"from":436.46,"to":438.4,"content":"目前机械硬盘的存储速度呢"},{"from":438.4,"to":439.72,"content":"是远不如固态硬盘的"},{"from":439.72,"to":442.049,"content":"由于机械硬盘的盘片组成"},{"from":442.049,"to":444.969,"content":"如果机械硬盘的某个部位出现了损坏"},{"from":444.969,"to":446.089,"content":"盘片完好的话呢"},{"from":446.089,"to":447.729,"content":"里面的数据也是可以恢复的"},{"from":447.729,"to":448.749,"content":"但是要注意哦"},{"from":448.749,"to":451.8,"content":"机械硬盘它是属于精密的仪器"},{"from":451.8,"to":453.8,"content":"首先不要拆开硬盘"},{"from":453.8,"to":457.159,"content":"其次就是千万不要去敲打摔碎机械硬盘"},{"from":457.159,"to":458.999,"content":"如果造成盘片损坏的话呢"},{"from":458.999,"to":462.32,"content":"你的数据基本上是很难恢复回来的"},{"from":462.52,"to":464.2,"content":"当然现在买机械硬盘呢"},{"from":464.2,"to":465.64,"content":"我们要先抛开转速"},{"from":465.64,"to":467.38,"content":"我们直接来看一下硬盘规格"},{"from":467.38,"to":469.36,"content":"这里呢就涉及到两个词了"},{"from":469.36,"to":471.53,"content":"其中呢包括SMR"},{"from":471.53,"to":472.63,"content":"还有PMR"},{"from":472.63,"to":476.97,"content":"其中PMR呢指的是垂直式磁记录技术"},{"from":476.97,"to":478.49,"content":"也就是垂直盘"},{"from":478.49,"to":481.03,"content":"而CMR还有PMR的意思相同"},{"from":481.03,"to":484.19,"content":"SMR则是叠瓦式磁记录技术"},{"from":484.19,"to":485.789,"content":"也称叠瓦盘"},{"from":485.789,"to":488.829,"content":"是基于PMR上面发展出来的一种技术"},{"from":488.829,"to":491.18,"content":"早年呢还有LMR"},{"from":491.18,"to":492.74,"content":"但是基本上没有应用了"},{"from":492.74,"to":495.48,"content":"所以呢我们就介绍垂直盘还有叠瓦盘的区别"},{"from":495.48,"to":499.62,"content":"垂直盘呢在磁道之间留出了一定的间隙"},{"from":499.62,"to":501.72,"content":"以避免不同磁道之间的数据干扰"},{"from":501.72,"to":502.74,"content":"读写操作时呢"},{"from":502.74,"to":504.74,"content":"磁头是不需要多次往返的"},{"from":504.74,"to":507.08,"content":"呃相对来说呢读写原理也更简单"},{"from":507.08,"to":508.44,"content":"步骤内有所减少"},{"from":508.44,"to":510.49,"content":"速度和寿命有所提升"},{"from":510.49,"to":513.23,"content":"但是考虑到硬盘容量出现了瓶颈"},{"from":513.23,"to":515.48,"content":"于是呢就出现了叠瓦盘这种产品"},{"from":515.48,"to":517.44,"content":"叠瓦盘一方面呢是可以提升容量"},{"from":517.44,"to":520.2,"content":"另一方面呢是可以降低厂家的成本"},{"from":520.2,"to":521.64,"content":"提高产品的利润"},{"from":521.64,"to":525.44,"content":"叠瓦盘的特点呢就是磁道像瓦片一样叠在一起"},{"from":525.44,"to":527.18,"content":"在存放了较多数据之后呢"},{"from":527.18,"to":528.22,"content":"再次写入数据呢"},{"from":528.22,"to":530.84,"content":"就会反复迁移扇区内的数据"},{"from":530.84,"to":534.22,"content":"就导致盘片还有磁头的工作时间会加长"},{"from":534.22,"to":534.84,"content":"这样一来呢"},{"from":534.84,"to":536.22,"content":"硬盘的工作量增大"},{"from":536.22,"to":537.7,"content":"硬盘寿命减少"},{"from":537.7,"to":539.12,"content":"数据呢还有丢失的风险"},{"from":539.12,"to":541.16,"content":"所以我的建议是不要买"},{"from":541.16,"to":542.86,"content":"目前3.5英寸的硬盘"},{"from":542.86,"to":545.51,"content":"除了一些低端产品采用的是叠瓦盘"},{"from":545.51,"to":547.69,"content":"容量1tb之类的小硬盘"},{"from":547.69,"to":551.25,"content":"以及其他高端企业级以及监控级的产品"},{"from":551.25,"to":552.89,"content":"都是垂直盘"},{"from":552.89,"to":554.8,"content":"2.5英寸的硬盘部分"},{"from":554.8,"to":556.28,"content":"512G的硬盘"},{"from":556.28,"to":558.24,"content":"还有企业级的硬盘呢是垂直盘"},{"from":558.24,"to":560.76,"content":"然后其他大容量的机械盘的"},{"from":560.76,"to":562.54,"content":"基本上一律是可以认为是叠瓦盘"},{"from":562.54,"to":563.78,"content":"在购买的时候要注意"},{"from":563.78,"to":566.38,"content":"有些不良商家呢会在标题上面写"},{"from":566.38,"to":569.22,"content":"PMR里面卖的呢是包含了CMR"},{"from":569.22,"to":571.74,"content":"还有SMR叠瓦盘两种产品"},{"from":571.74,"to":575.17,"content":"所以购买的时候请一定一定一定要确认好"},{"from":575.17,"to":578.72,"content":"最好呢是认准CMR3个字来购买"},{"from":579.08,"to":581.94,"content":"常见的硬盘指标呢还有转速之分"},{"from":581.94,"to":584.38,"content":"最多的就是每分钟5400转"},{"from":584.38,"to":585.84,"content":"还有7200转的硬盘"},{"from":585.84,"to":587.29,"content":"那么有什么区别呢"},{"from":587.29,"to":588.83,"content":"有的但是不多"},{"from":588.83,"to":590.56,"content":"我们直接打两个比方啊"},{"from":590.56,"to":592.16,"content":"5400转的硬盘呢"},{"from":592.16,"to":594.52,"content":"它转一圈耗时是11.11ms"},{"from":594.52,"to":597,"content":"7200转的转一圈呢是8.33ms"},{"from":597,"to":598.55,"content":"提升了15%的水平"},{"from":598.55,"to":600.43,"content":"但我们在日常的使用当中呢"},{"from":600.43,"to":602.1,"content":"它两者并没有很大的区别"},{"from":602.1,"to":603.9,"content":"只是在随机读写的部分呢"},{"from":603.9,"to":606.02,"content":"7200转的硬盘呢会比5400转呢"},{"from":606.02,"to":608.78,"content":"它要优秀个约20%的水平"},{"from":608.78,"to":609.22,"content":"当然了"},{"from":609.22,"to":610.82,"content":"像是一些服务器级别的硬盘呢"},{"from":610.82,"to":612.88,"content":"是可以达到每分钟1万转"},{"from":612.88,"to":614.62,"content":"甚至是1万5转的水平的"},{"from":614.62,"to":617.29,"content":"而希捷的监控级别的硬盘酷"},{"from":617.29,"to":619.59,"content":"因为了考虑硬盘的工作稳定性"},{"from":619.59,"to":622.82,"content":"将转速控制在了5900转每分钟的水平"},{"from":622.82,"to":625.36,"content":"所以呢对于我们这种消费者来说"},{"from":625.36,"to":628.94,"content":"它的转速它并不是很重要的指标"},{"from":629.26,"to":630.58,"content":"固态硬盘的简称"},{"from":630.58,"to":634.16,"content":"SSD原理呢就是通过半导体来进行存储"},{"from":634.16,"to":636.64,"content":"数据存储在闪存当中"},{"from":636.64,"to":639.14,"content":"通过主控来执行文件的读写"},{"from":639.14,"to":640.82,"content":"优点就是尺寸小"},{"from":640.82,"to":641.76,"content":"读写速度快"},{"from":641.76,"to":642.52,"content":"没有噪音"},{"from":642.52,"to":643.86,"content":"而抗震能力强"},{"from":643.86,"to":646.62,"content":"缺点呢就是部分的固态硬盘的发热严重"},{"from":646.62,"to":648.76,"content":"而且呢闪存颗粒有寿命上限"},{"from":648.76,"to":651.41,"content":"硬盘损坏之后无法维修"},{"from":651.41,"to":656.009,"content":"常规的固态硬盘呢主要由PCB板接口供电模块"},{"from":656.009,"to":657.189,"content":"外置缓存"},{"from":657.189,"to":659.669,"content":"主控还有闪存颗粒组成"},{"from":659.669,"to":660.949,"content":"一块硬盘的好坏呢"},{"from":660.949,"to":663.73,"content":"就是根据主控还有颗粒来判断的"},{"from":663.73,"to":666.77,"content":"目前的固态硬盘呢主要有三种存储介质"},{"from":666.77,"to":668.65,"content":"分别是flash闪存颗粒"},{"from":668.65,"to":671.49,"content":"还有dream动态随机存取存储器"},{"from":671.49,"to":673.1,"content":"还有3D x point"},{"from":673.1,"to":675.5,"content":"那其中最常见也是我们最常用的"},{"from":675.5,"to":677.65,"content":"就是这个flash闪存颗粒"},{"from":677.65,"to":681.01,"content":"目前的闪存颗粒呢分为SLCMLC"},{"from":681.01,"to":681.61,"content":"T l c"},{"from":681.61,"to":682.56,"content":"还有QLC"},{"from":682.56,"to":684.42,"content":"那最好的就是SLC"},{"from":684.42,"to":685.86,"content":"最差的是QLC"},{"from":685.86,"to":688.27,"content":"我们简单来说一下他们四个的区别"},{"from":688.27,"to":690.59,"content":"我们把存储颗粒呢比作一个大房子"},{"from":690.59,"to":691.95,"content":"SLC呢是一个大房间"},{"from":691.95,"to":694.29,"content":"一个空间呢只能存储一个一比特的数据"},{"from":694.29,"to":698.38,"content":"使用零和一等高低电压存储及精准又快速"},{"from":698.38,"to":700.96,"content":"SLC单颗粒理论擦写次数呢是10万次以上"},{"from":700.96,"to":702.82,"content":"也就是说你要读写10万次"},{"from":702.82,"to":703.829,"content":"它才会坏"},{"from":703.829,"to":705.9,"content":"寿命长是它最大的特点"},{"from":705.9,"to":706.5,"content":"当然了"},{"from":706.5,"to":707.96,"content":"速度快也是它的特点之一"},{"from":707.96,"to":709.46,"content":"但是呢SLC的缺点呢"},{"from":709.46,"to":710.9,"content":"就是在相同规格的情况下"},{"from":710.9,"to":712.2,"content":"它的存储空间比较小"},{"from":712.2,"to":714.26,"content":"然后使用成本极高"},{"from":714.26,"to":718,"content":"MLC呢是将一个大房子分割成两个部分"},{"from":718,"to":720.46,"content":"一个单位空间可以存储两比特的数据"},{"from":720.46,"to":722.81,"content":"但是呢MLC的单颗粒"},{"from":722.81,"to":726.27,"content":"理论擦写次数呢是在3000~5000次左右"},{"from":726.27,"to":728.29,"content":"也就是说虽然存储的空间大了"},{"from":728.29,"to":729.78,"content":"但是理论寿命降低了"},{"from":729.78,"to":733.16,"content":"不过呢换来的就是存储空间的提高"},{"from":733.16,"to":734.69,"content":"价格的降低"},{"from":734.69,"to":737.43,"content":"TLC呢是目前最主流的固态硬盘颗粒类型"},{"from":737.43,"to":739.72,"content":"它的一个单位空间呢是被压缩到"},{"from":739.72,"to":741.36,"content":"可以存储三比特的数据的"},{"from":741.36,"to":743.6,"content":"但是呢它的单颗粒读写寿命呢"},{"from":743.6,"to":745.51,"content":"只有500~3000次"},{"from":745.51,"to":747.75,"content":"但是呢换回来的是更大的存储空间"},{"from":747.75,"to":748.97,"content":"更廉价的价格"},{"from":748.97,"to":751.54,"content":"而且呢为了提高硬盘的使用体验"},{"from":751.54,"to":754.84,"content":"很多硬盘厂家呢会用模拟SLC"},{"from":754.84,"to":756.78,"content":"来提升硬盘的性能"},{"from":756.78,"to":759.22,"content":"那我们常见的硬盘缓外掉速"},{"from":759.22,"to":762.84,"content":"就是写完模拟SLC进入TOC直写速度"},{"from":762.84,"to":766.16,"content":"KLC呢是低端固态的颗粒类型"},{"from":766.16,"to":768.8,"content":"即一个单位空间呢可以存储四比特的数据"},{"from":768.8,"to":770.46,"content":"这就好比是群租房"},{"from":770.46,"to":771.82,"content":"价格便宜量还大"},{"from":771.82,"to":773.94,"content":"不过呢换来的就是单颗粒"},{"from":773.94,"to":776.56,"content":"理论读写寿命呢它只有100~300次"},{"from":776.56,"to":777.94,"content":"寿命非常的短"},{"from":777.94,"to":781.729,"content":"目前市面上比较多的M2NVM1硬盘的"},{"from":781.729,"to":783.509,"content":"都是TLC和QLC颗粒"},{"from":783.509,"to":785.669,"content":"大家可以选购TC购买即可"},{"from":785.669,"to":787.78,"content":"建议是不要买QLC啊"},{"from":787.78,"to":790.06,"content":"所以买盘的时候一定一定要问问卖家"},{"from":790.06,"to":792.819,"content":"他到底是QLC还是TLC"},{"from":792.819,"to":795.259,"content":"而闪存颗粒的购买呢也是有讲究的"},{"from":795.259,"to":798.769,"content":"我们先来说一下目前造闪存颗粒的几个厂家吧"},{"from":798.769,"to":800.269,"content":"分别是三星凯侠"},{"from":800.269,"to":802.129,"content":"西数海力士镁光沙拉袋"},{"from":802.129,"to":804.88,"content":"还有长江存储等等品牌"},{"from":804.88,"to":805.96,"content":"在买硬盘的时候呢"},{"from":805.96,"to":807.36,"content":"如果原厂有合适的"},{"from":807.36,"to":808.98,"content":"就建议直接买原厂"},{"from":808.98,"to":811.13,"content":"那原片是有保障的"},{"from":811.13,"to":812.81,"content":"当然购买固态硬盘的时候呢"},{"from":812.81,"to":814.89,"content":"还要注意甄别闪存颗粒"},{"from":814.89,"to":816.05,"content":"除了正片以外"},{"from":816.05,"to":816.95,"content":"还有黑片"},{"from":816.95,"to":817.89,"content":"还有白片"},{"from":817.89,"to":820.61,"content":"白片呢就是部分未通过测试的闪存"},{"from":820.61,"to":823.03,"content":"这些闪存呢会再度进行测试"},{"from":823.03,"to":824.25,"content":"如果测试通过"},{"from":824.25,"to":825.73,"content":"那不影响使用"},{"from":825.73,"to":828.41,"content":"就打标和正片一样销售"},{"from":828.41,"to":830.69,"content":"那一般来说呢正规渠道的白边"},{"from":830.69,"to":832.65,"content":"还有正片的性能是没有差别的"},{"from":832.65,"to":833.75,"content":"性能也不会很差"},{"from":833.75,"to":836.41,"content":"但是黑片就不太行了"},{"from":836.41,"to":839.09,"content":"黑片呢是基本上没有通过测试的闪存"},{"from":839.09,"to":841.25,"content":"或者是报废的闪存芯片"},{"from":841.25,"to":843.24,"content":"他们没有标识"},{"from":843.24,"to":844.1,"content":"闪存厂呢"},{"from":844.1,"to":847.62,"content":"是通过非常规渠道出售给那些制造硬盘"},{"from":847.62,"to":849.19,"content":"还有U盘的代工厂"},{"from":849.19,"to":851.69,"content":"而代工厂呢再通过打上自己的一些标签"},{"from":851.69,"to":852.99,"content":"将黑片洗成白片"},{"from":852.99,"to":854.79,"content":"然后销售还有什么啊"},{"from":854.79,"to":857.92,"content":"拆机片呀啊划线片呀这类词语"},{"from":857.92,"to":861.42,"content":"我建议是硬盘新手玩家就不要去随意的趟水啊"},{"from":861.42,"to":863.99,"content":"否则会坑的是自己的数据"},{"from":863.99,"to":865.25,"content":"老老实实的买原片"},{"from":865.25,"to":867.589,"content":"还有白片的产品就可以了"},{"from":867.789,"to":869.029,"content":"好再来说说主控"},{"from":869.029,"to":871.449,"content":"主控呢是固态硬盘的核心控制器"},{"from":871.449,"to":873.88,"content":"它可以合理的分配各个闪存的工作负载"},{"from":873.88,"to":875.44,"content":"并且呢起到数据调用"},{"from":875.44,"to":876.64,"content":"还有中转的任务"},{"from":876.64,"to":879.2,"content":"不同的主控呢在硬盘的读写速度"},{"from":879.2,"to":882.079,"content":"还有算法等方面都有非常大的区别"},{"from":882.079,"to":887.19,"content":"目前使用的比较多的主控品牌呢有三星马牌"},{"from":887.19,"to":892.65,"content":"慧荣群联应认一些国产的主控呢有规格的EV"},{"from":892.65,"to":894.39,"content":"还有国科威记忆"},{"from":894.39,"to":896.98,"content":"海思华兰威长江存储"},{"from":896.98,"to":898.96,"content":"目前呢也是慢慢的在占领市场"},{"from":898.96,"to":902.68,"content":"而缓存呢一般都是装在了主控边上面的dream颗粒"},{"from":902.68,"to":904.74,"content":"起到了数据缓冲的作用"},{"from":904.74,"to":906.98,"content":"当然目前单论反应速度来说呢"},{"from":906.98,"to":908.46,"content":"固态硬盘的闪存颗粒呢"},{"from":908.46,"to":910.52,"content":"一般都是在0.2ms内"},{"from":910.52,"to":913.49,"content":"和缓存相比呢并没有很大的差别"},{"from":913.49,"to":915.81,"content":"所以呢目前有很多的固态硬盘呢"},{"from":915.81,"to":917.6,"content":"已经取消了缓存"},{"from":917.76,"to":920,"content":"我们最后再来聊一聊传输协议"},{"from":920,"to":922.92,"content":"目前硬盘的传输方式呢和协议共分为四大类"},{"from":922.92,"to":924.22,"content":"涉及到物理接口"},{"from":924.22,"to":925.26,"content":"协议和通道"},{"from":925.26,"to":927.4,"content":"为了方便各位小白快速的理解"},{"from":927.4,"to":930.1,"content":"我们用比较形象的方式来进行一个展示"},{"from":930.1,"to":932.22,"content":"把物理接口比作山洞"},{"from":932.22,"to":934.38,"content":"协议呢比作交通工具"},{"from":934.38,"to":936.34,"content":"通道比作道路"},{"from":936.34,"to":938.17,"content":"CPU呢比作目的地"},{"from":938.17,"to":939.59,"content":"我们先来举例啊"},{"from":939.59,"to":941.95,"content":"由于SARA呢是比较窄的山洞"},{"from":941.95,"to":943.71,"content":"而SATA通道呢也比较窄"},{"from":943.71,"to":945.21,"content":"只能够兼容尺寸小"},{"from":945.21,"to":948.07,"content":"速度慢的AHCI协议"},{"from":948.07,"to":949.31,"content":"通过SA呢"},{"from":949.31,"to":952.65,"content":"加上AHCI传输协议的最大传输速度是每秒"},{"from":952.65,"to":954.55,"content":"最高只能够达到600兆"},{"from":954.55,"to":956.43,"content":"其次呢是M2接口"},{"from":956.43,"to":957.63,"content":"由于其比较新"},{"from":957.63,"to":960.15,"content":"所以呢山洞的道路比较宽"},{"from":960.15,"to":963.28,"content":"既可以使用速度较慢的AHCI协议"},{"from":963.28,"to":964.26,"content":"走三的道路"},{"from":964.26,"to":967.3,"content":"又可以使用速度超快的MM协议"},{"from":967.3,"to":969.06,"content":"走宽敞的PCIE通道"},{"from":969.06,"to":971.74,"content":"实现超高速的传输速度"},{"from":971.74,"to":973.38,"content":"目前的PCIE5.0通道的"},{"from":973.38,"to":976.02,"content":"最大可以兼容16GBPS的传输速率"},{"from":976.02,"to":977.74,"content":"支持PCIE5.0的固态硬盘呢"},{"from":977.74,"to":980.78,"content":"可以达到每秒约1万兆的传输速率"},{"from":980.78,"to":983.52,"content":"所以呢目前的固态硬盘呢主要有三大类"},{"from":983.52,"to":986.02,"content":"一种呢是传统SATA接口的固态硬盘"},{"from":986.02,"to":988.82,"content":"一种呢是M2接口的SATA通道固态硬盘"},{"from":988.82,"to":993.16,"content":"一种呢是PCIE通道NVM1的M2固态硬盘"},{"from":993.56,"to":997.22,"content":"先带大家来看一下电脑里面使用的是什么硬盘"},{"from":997.22,"to":999.75,"content":"或者是具备什么硬盘槽位"},{"from":999.75,"to":1001.43,"content":"这里呢涉及到拆机啊"},{"from":1001.43,"to":1002.73,"content":"就需要一套工具了"},{"from":1002.73,"to":1004.15,"content":"大家只要跟着我的步骤"},{"from":1004.15,"to":1006.579,"content":"基本上是不会出错的"},{"from":1006.899,"to":1008.659,"content":"首先呢我们来说一下桌面端"},{"from":1008.659,"to":1011.259,"content":"也就是俗称的台式机"},{"from":1011.259,"to":1014.079,"content":"下来简单教大家如何看自己的硬盘"},{"from":1014.079,"to":1016.299,"content":"然后第一步就打开机箱的侧板"},{"from":1016.299,"to":1020.15,"content":"我们就可以看到电脑的硬盘接口以及拓展槽位"},{"from":1020.15,"to":1023.23,"content":"早期机箱呢在机箱内部呢安装有硬盘支架"},{"from":1023.23,"to":1024.93,"content":"或者是硬盘螺丝孔"},{"from":1024.93,"to":1027.24,"content":"而有一些电脑机箱呢为了美观嘛"},{"from":1027.24,"to":1030.02,"content":"会将硬盘槽位就放在了机箱的背板"},{"from":1030.02,"to":1032.52,"content":"如果没有在机箱上找到外挂的硬盘"},{"from":1032.52,"to":1034,"content":"可以看看主板上面有没有"},{"from":1034,"to":1035.66,"content":"集成M2接口的硬盘呢"},{"from":1035.66,"to":1036.82,"content":"关于这些硬盘的规格"},{"from":1036.82,"to":1037.38,"content":"还有尺寸"},{"from":1037.38,"to":1038.55,"content":"我们会具体介绍"},{"from":1038.55,"to":1040.29,"content":"拆卸机械硬盘的比较复杂"},{"from":1040.29,"to":1042.47,"content":"需要将硬盘的抽屉抽出来"},{"from":1042.47,"to":1046.52,"content":"把硬盘螺栓口对准硬盘的螺栓孔"},{"from":1046.52,"to":1048.36,"content":"然后拧上螺丝"},{"from":1048.36,"to":1050.25,"content":"再把抽屉塞回支架"},{"from":1050.25,"to":1053.57,"content":"将与主板连接的SATA线连接上安装"},{"from":1053.57,"to":1056.31,"content":"就完成了台式机的硬件配置非常的多"},{"from":1056.31,"to":1058.13,"content":"而且呢根据CPU的代数不同"},{"from":1058.13,"to":1060.44,"content":"主板芯片的代数呢也会有所差异"},{"from":1060.44,"to":1061.76,"content":"不同代数的主板芯片"},{"from":1061.76,"to":1063.88,"content":"兼容的硬盘种类呢也有所不同"},{"from":1063.88,"to":1066.64,"content":"比如说AI接口最早呢是在2014年"},{"from":1066.64,"to":1070.18,"content":"英特尔九系列的高端主板上才开始原生支持"},{"from":1070.18,"to":1071.52,"content":"所以选购固态硬盘呢"},{"from":1071.52,"to":1074.1,"content":"一定要看你的主板是否兼容ELVA的"},{"from":1074.1,"to":1075.26,"content":"拆装呢非常的简单"},{"from":1075.26,"to":1076.92,"content":"直接把固定螺丝拧下"},{"from":1076.92,"to":1077.5,"content":"45度"},{"from":1077.5,"to":1079.909,"content":"把硬盘插入AA插槽"},{"from":1079.909,"to":1081.029,"content":"压下去之后呢"},{"from":1081.029,"to":1082.889,"content":"拧上螺丝固定即可"},{"from":1083.209,"to":1085.269,"content":"笔记本的拆解呢就会比较麻烦"},{"from":1085.269,"to":1088.429,"content":"大家如果想事先了解自己的电脑硬盘型号"},{"from":1088.429,"to":1090.6,"content":"可以找到电脑背面的型号贴纸"},{"from":1090.6,"to":1093.16,"content":"然后到网上去查询一下具体的配置"},{"from":1093.16,"to":1095.449,"content":"以及电脑兼容的硬盘槽位"},{"from":1095.449,"to":1098.169,"content":"大家如果想要自己动手更换硬盘的话呢"},{"from":1098.169,"to":1099.52,"content":"一定要咨询厂家"},{"from":1099.52,"to":1102.08,"content":"拆盖是否还会具备保修"},{"from":1102.08,"to":1104.81,"content":"而且呢拆盖它需要一定的动手能力"},{"from":1104.81,"to":1106.57,"content":"大多数笔记本的打开方式呢"},{"from":1106.57,"to":1108.87,"content":"都是通过拧开后盖的螺栓"},{"from":1108.87,"to":1111.01,"content":"然后拧开螺栓以后"},{"from":1111.01,"to":1113.01,"content":"通过撬棒撬开后盖"},{"from":1113.01,"to":1115.42,"content":"就可以看到笔记本的主板的背面了"},{"from":1115.42,"to":1117.46,"content":"而目前常规的14寸办公本呢"},{"from":1117.46,"to":1119.29,"content":"它只有一个M2硬盘槽"},{"from":1119.29,"to":1121.05,"content":"15.6寸以上的笔记本呢"},{"from":1121.05,"to":1122.87,"content":"大多数都是有两块硬盘的"},{"from":1122.87,"to":1125.01,"content":"部分新款的机型呢为了轻量化嘛"},{"from":1125.01,"to":1127.02,"content":"都是双M2接口"},{"from":1127.02,"to":1129.84,"content":"较早的一些笔记本的都是M2加SATA的配置"},{"from":1129.84,"to":1132.76,"content":"但个别厂家呢给了两个M2槽位"},{"from":1132.76,"to":1134.95,"content":"却只给了一个接口"},{"from":1134.95,"to":1137.05,"content":"这里就不点名批评了"},{"from":1137.05,"to":1138.05,"content":"笔记本的拆装"},{"from":1138.05,"to":1139.51,"content":"硬盘呢非常的方便"},{"from":1139.51,"to":1141.97,"content":"具体的M2硬盘的拆装和台式机一样"},{"from":1141.97,"to":1143.07,"content":"都是相同的步骤"},{"from":1143.07,"to":1145.429,"content":"3A硬盘的安装呢也比较简单"},{"from":1145.429,"to":1147.509,"content":"将硬盘的减震支架取下"},{"from":1147.509,"to":1148.789,"content":"再把硬盘固定上去"},{"from":1148.789,"to":1150.96,"content":"最后呢插到电脑上即可完成"},{"from":1150.96,"to":1153.64,"content":"千万要注意在操作这些之前"},{"from":1153.64,"to":1156.05,"content":"一定要拔掉电脑的电池"},{"from":1156.05,"to":1159.23,"content":"并且长按开机键放光静电"},{"from":1159.23,"to":1160.65,"content":"否则呢插拔的时候呢"},{"from":1160.65,"to":1162.85,"content":"你的硬盘可能会损坏哦"},{"from":1163.17,"to":1164.05