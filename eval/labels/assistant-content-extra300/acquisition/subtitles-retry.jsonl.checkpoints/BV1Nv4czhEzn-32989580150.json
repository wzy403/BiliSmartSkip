{"schemaVersion":1,"bvid":"BV1Nv4czhEzn","cid":32989580150,"subtitles":[{"from":0.04,"to":0.64,"content":"大家好"},{"from":0.64,"to":1.79,"content":"我是钟琪爱"},{"from":1.79,"to":5.11,"content":"持续多日的华西北方秋雨终于有了结束的信号"},{"from":5.11,"to":6.49,"content":"然而在正式结束之前"},{"from":6.49,"to":7.83,"content":"11月11到13日"},{"from":7.83,"to":9.82,"content":"这场秋雨还要在南压中加强"},{"from":9.82,"to":11.62,"content":"雨带已经从山西北部"},{"from":11.62,"to":14.06,"content":"京津冀北部一线逐渐来到四川"},{"from":14.06,"to":14.72,"content":"重庆北部"},{"from":14.72,"to":15.62,"content":"湖北西北部"},{"from":15.62,"to":16.42,"content":"陕西中南部"},{"from":16.42,"to":17.02,"content":"山西南部"},{"from":17.02,"to":18.96,"content":"河北南部以及河南和山东"},{"from":18.96,"to":21.68,"content":"其中雨带西段也就是秦岭以南的陕西南部"},{"from":21.68,"to":22.56,"content":"四川和重庆北部"},{"from":22.56,"to":25,"content":"湖北西北部等地将有大到暴雨"},{"from":25,"to":26.06,"content":"局部大暴雨"},{"from":26.06,"to":27.62,"content":"东段上雨小一些"},{"from":27.62,"to":29.7,"content":"但也有中到大雨甚至暴雨"},{"from":29.7,"to":31.78,"content":"不管对东段还是西段来说"},{"from":31.78,"to":34.62,"content":"这又是一次10月罕见的强降雨过程"},{"from":34.62,"to":36.629,"content":"尤其是对河南山东来说"},{"from":36.629,"to":39.069,"content":"这在连续一个多月的秋雨后"},{"from":39.069,"to":40.469,"content":"还要再下这么些雨"},{"from":40.469,"to":41.86,"content":"属实让人绷不住"},{"from":41.86,"to":42.54,"content":"在雨中"},{"from":42.54,"to":44.28,"content":"各地气温都跌到了15度以下"},{"from":44.28,"to":46.62,"content":"譬如说郑州和济南10月10日最高"},{"from":46.62,"to":48.48,"content":"白天都是14度左右"},{"from":48.48,"to":50.02,"content":"体会到了深秋的感觉"},{"from":50.02,"to":51.2,"content":"在降雨加持下"},{"from":51.2,"to":52.96,"content":"冷空气已经接力南下"},{"from":52.96,"to":54.44,"content":"冷空气接力南下"},{"from":54.44,"to":56.16,"content":"北方多地体感已经明显转凉"},{"from":56.16,"to":57.82,"content":"出门一定得添层外套"},{"from":57.82,"to":59.69,"content":"备秋装可得提上日程"},{"from":59.69,"to":62.57,"content":"淘宝每月8号的男装三件八折福利"},{"from":62.57,"to":64.879,"content":"简直是为降温天气量身准备的"},{"from":64.879,"to":66.779,"content":"这三件就是我最近入手的"},{"from":66.779,"to":67.919,"content":"上淘宝搜男装"},{"from":67.919,"to":69.85,"content":"三件八折就能锁定爆款"},{"from":69.85,"to":71.53,"content":"北方干冷的朋友别错过"},{"from":71.53,"to":73.45,"content":"马德工装骨汤夹克男装top"},{"from":73.45,"to":75.16,"content":"商家出品的美式猎装风"},{"from":75.16,"to":76.58,"content":"防风保暖还百搭"},{"from":76.58,"to":78.28,"content":"学生党日常抗凉就穿"},{"from":78.28,"to":79.02,"content":"悟空有货"},{"from":79.02,"to":81.08,"content":"美式polo衫和阔腿裤太合适"},{"from":81.08,"to":82.78,"content":"早晚冷风里赶路也舒服"},{"from":82.78,"to":85.58,"content":"撞色设计拿下青春校园男装top1"},{"from":85.58,"to":88.12,"content":"现在下单还能跨店凑单更划算"},{"from":88.12,"to":90.52,"content":"像我凑的这三件直接立省80元"},{"from":90.52,"to":91.52,"content":"原来要350元"},{"from":91.52,"to":93.64,"content":"现在赶上优惠到手只要270元"},{"from":93.64,"to":96.78,"content":"谁能懂均价90加的秋冬衣服的含金量"},{"from":96.78,"to":99.28,"content":"上淘宝首页搜索栏顶部找到穿搭"},{"from":99.28,"to":101.76,"content":"点击进去也能直接参与三件八折"},{"from":101.76,"to":103.86,"content":"赶紧趁优惠提前备好秋装"},{"from":103.86,"to":105.38,"content":"冷空气来也不慌"},{"from":105.38,"to":107.02,"content":"不过正如我们之前节目所说"},{"from":107.02,"to":109.1,"content":"这些接力南下的冷空气都比较弱"},{"from":109.1,"to":111.32,"content":"在强大的副热带高压笼罩下"},{"from":111.32,"to":113.02,"content":"南方的暖湿气流极强"},{"from":113.02,"to":114.92,"content":"从10月9日到10月10日"},{"from":114.92,"to":116.84,"content":"冷空气用了整整一天时间"},{"from":116.84,"to":118.96,"content":"也就是刚刚渗透进湖北省"},{"from":118.96,"to":120.56,"content":"安徽省和江苏徐州"},{"from":120.56,"to":122.2,"content":"正为此11月10日下午"},{"from":122.2,"to":123.58,"content":"合肥降到了19度"},{"from":123.58,"to":124.78,"content":"然而与此同时"},{"from":124.78,"to":126.84,"content":"南京武汉却超过32度"},{"from":126.84,"to":129.02,"content":"和合肥是两个细节"},{"from":129.02,"to":131.32,"content":"南方出现大范围35度以上高温"},{"from":131.32,"to":134.34,"content":"江西湖南重庆还出现了37度以上高温"},{"from":134.34,"to":135.16,"content":"江西宜黄"},{"from":135.16,"to":135.98,"content":"湖南衡阳"},{"from":135.98,"to":138.54,"content":"重庆江津等达到或超过38度"},{"from":138.54,"to":139.58,"content":"重庆长沙"},{"from":139.58,"to":141.42,"content":"南昌打破最晚高温纪录"},{"from":141.42,"to":143,"content":"是一派炎炎盛夏"},{"from":143,"to":144.82,"content":"因为冷空气在底层渗透"},{"from":144.82,"to":147.08,"content":"而暖湿气流在高空强力北上"},{"from":147.08,"to":147.96,"content":"河南鸡公山"},{"from":147.96,"to":151.47,"content":"还出现了看似违背对流层规律的事情"},{"from":151.47,"to":154.19,"content":"山上气温比山脚高了十度左右"},{"from":154.19,"to":156.03,"content":"为什么今年10月副高这么强"},{"from":156.03,"to":157.24,"content":"暖湿气流这么强"},{"from":157.24,"to":158.7,"content":"第一现在越来越暖"},{"from":158.7,"to":160.5,"content":"高温越来越晚是趋势"},{"from":160.5,"to":162.56,"content":"这几年盛夏高温记录不断打破"},{"from":162.56,"to":164.44,"content":"最晚高温记录打破的更多"},{"from":164.44,"to":168.02,"content":"第二今年有一些偶然的气候因素可能有影响"},{"from":168.02,"to":168.62,"content":"一方面"},{"from":168.62,"to":170.42,"content":"这几年我国中东部出现西风"},{"from":170.42,"to":173.44,"content":"暖脊和副高叠加的热穹顶形式在增多"},{"from":173.44,"to":176.08,"content":"这可能和拉尼娜频繁出现有关系"},{"from":176.08,"to":176.64,"content":"另一方面"},{"from":176.64,"to":178.28,"content":"在持续热穹顶影响下"},{"from":178.28,"to":180.62,"content":"今年我国东海到日本以南洋面"},{"from":180.62,"to":182.38,"content":"海温异常大幅偏高"},{"from":182.38,"to":183.46,"content":"譬如说10月10日"},{"from":183.46,"to":185.74,"content":"东海大部海温仍然在29度以上"},{"from":187.78,"to":189.32,"content":"不仅高于南海海温"},{"from":189.32,"to":191.76,"content":"甚至高于菲律宾一种暖池海文"},{"from":191.76,"to":194.4,"content":"这在哪怕10年前都是无法想象的"},{"from":194.4,"to":196.44,"content":"而这一片大面积的高缓温带"},{"from":196.44,"to":199.78,"content":"可能又对副高的顽固赖皮起到了支持作用"},{"from":199.78,"to":200.84,"content":"那么海温这么高"},{"from":200.84,"to":203.76,"content":"会不会导致东海孕育出季节的超强台风"},{"from":203.76,"to":205.24,"content":"在10月登陆江浙沪"},{"from":205.24,"to":206.54,"content":"答案是否定的"},{"from":206.54,"to":208.6,"content":"台风的生成不仅需要海温条件"},{"from":208.6,"to":210.26,"content":"更需要大气环流条件"},{"from":210.26,"to":211.26,"content":"光是海温高"},{"from":211.26,"to":212.76,"content":"无法自动生成台风"},{"from":212.76,"to":213.5,"content":"恰恰相反"},{"from":213.5,"to":216.1,"content":"在强盛副高控制下的高海温洋面上"},{"from":216.1,"to":217.28,"content":"台风五无法晋升"},{"from":217.28,"to":218.54,"content":"更谈不上登陆我国"},{"from":218.54,"to":220.92,"content":"譬如说今年第23号台风纳基利"},{"from":222.86,"to":223.96,"content":"无法进入我国东海"},{"from":223.96,"to":225.12,"content":"无法抗衡"},{"from":225.12,"to":227.74,"content":"副高也无法缓解滑动高温"},{"from":227.74,"to":230.38,"content":"不过接下来悬在副高头顶的北方龙系"},{"from":230.38,"to":233.3,"content":"还是要用三天时间逐步渗透进四川"},{"from":233.3,"to":233.72,"content":"重庆"},{"from":233.72,"to":234.88,"content":"湖北江苏上海"},{"from":234.88,"to":237.26,"content":"因此安徽高温已经开始减弱"},{"from":237.26,"to":238.38,"content":"10月12日前后"},{"from":238.38,"to":239.62,"content":"重庆高温就将缓解"},{"from":239.62,"to":241.12,"content":"11月13到14日"},{"from":241.12,"to":243.38,"content":"湖北湖南江苏上海高温环节"},{"from":243.38,"to":245.74,"content":"江西浙江的高温也将有所减弱"},{"from":245.74,"to":248.6,"content":"譬如说南昌将从37度降到33度"},{"from":248.6,"to":250.66,"content":"随之减弱的还有副热带高压"},{"from":250.66,"to":251.76,"content":"11月13日起"},{"from":251.76,"to":252.96,"content":"他将撤离秦岭"},{"from":252.96,"to":253.89,"content":"淮河一线"},{"from":253.89,"to":254.95,"content":"退向江南"},{"from":254.95,"to":256.15,"content":"势力大为减弱"},{"from":256.15,"to":256.85,"content":"正因为此"},{"from":256.85,"to":259.29,"content":"伏高难测的热带系统又将有所发展"},{"from":259.29,"to":262.46,"content":"有可能在10月月中旬末下旬初发展为台风胚胎"},{"from":262.46,"to":264.5,"content":"并向我国东南沿海靠近"},{"from":264.5,"to":267.04,"content":"而此时已经蓄能完成的西伯利亚冷库"},{"from":267.04,"to":269.82,"content":"将向南释放出一股强大的冷空气"},{"from":269.82,"to":271.02,"content":"在横扫北方之后"},{"from":271.02,"to":272.02,"content":"10月18日起"},{"from":272.02,"to":275,"content":"他将在台风胚胎的加速中大举南下"},{"from":275,"to":277.18,"content":"用两到三天时间抵达广东"},{"from":277.18,"to":278.12,"content":"甚至海南"},{"from":278.12,"to":279.52,"content":"11月21日前后"},{"from":279.52,"to":282.18,"content":"虽然南方还不能完全和夏天告别"},{"from":282.18,"to":285.27,"content":"但我国的高温有望彻底结束好了"},{"from":285.27,"to":286.39,"content":"感谢收看本期节目"},{"from":286.39,"to":287.27,"content":"建议关注中气爱"},{"from":287.27,"to":288.25,"content":"并一键三连"},{"from":288.25,"to":290.06,"content":"我们下期节目见"}],"chapters":[],"