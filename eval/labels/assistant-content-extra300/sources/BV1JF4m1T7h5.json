    },
    {
      "from": 218.27,
      "to": 220.63,
      "content": "为了打造出合格的乘波体飞行器"
    },
    {
      "from": 220.63,
      "to": 223.78,
      "content": "我们一般会通过如下三种方式进行设计工作"
    },
    {
      "from": 223.78,
      "to": 225.49,
      "content": "它们分别是正设计方法"
    },
    {
      "from": 225.49,
      "to": 227.11,
      "content": "反设计方法和更为全面"
    },
    {
      "from": 227.11,
      "to": 229.57,
      "content": "但仍处于理论研究阶段的生成体法"
    },
    {
      "from": 229.57,
      "to": 231.6,
      "content": "三者具有发展继承关系"
    },
    {
      "from": 231.6,
      "to": 233.16,
      "content": "最早出现的正设计法"
    },
    {
      "from": 233.16,
      "to": 235.23,
      "content": "需要先给定激波的基本流程"
    },
    {
      "from": 235.23,
      "to": 237.74,
      "content": "再根据流程确定乘波体前缘形状"
    },
    {
      "from": 237.74,
      "to": 239.66,
      "content": "这种设计方法的典型代表是"
    },
    {
      "from": 239.66,
      "to": 241.94,
      "content": "通过楔形流场设计的楔导乘波体"
    },
    {
      "from": 241.94,
      "to": 244.519,
      "content": "与通过锥形流场设计的锥导乘波体"
    },
    {
      "from": 244.519,
      "to": 247.189,
      "content": "这类乘波体设计的具体操作方法是"
    },
    {
      "from": 247.189,
      "to": 249.13,
      "content": "给定楔形或锥形激波后"
    },
    {
      "from": 249.13,
      "to": 251.74,
      "content": "先选取一个柱面作为流动捕获管"
    },
    {
      "from": 251.74,
      "to": 253.87,
      "content": "并将这个捕获管插入流场内"
    },
    {
      "from": 253.87,
      "to": 254.89,
      "content": "与激波面相交"
    },
    {
      "from": 254.89,
      "to": 256.12,
      "content": "形成承波体前缘"
    },
    {
      "from": 256.12,
      "to": 258.48,
      "content": "然后在前缘曲线上选定若干个点"
    },
    {
      "from": 258.48,
      "to": 261.3,
      "content": "求出每个点在诱导出激波后流产的流线"
    },
    {
      "from": 261.3,
      "to": 263.04,
      "content": "最后根据流线组成的流面"
    },
    {
      "from": 263.04,
      "to": 264.78,
      "content": "来设计成波体的下表面"
    },
    {
      "from": 264.78,
      "to": 267.169,
      "content": "因此其上表面一般为简单曲面"
    },
    {
      "from": 267.169,
      "to": 268.519,
      "content": "这是X43"
    },
    {
      "from": 268.519,
      "to": 271.73,
      "content": "X51等早期高超音速飞行器前提的特征"
    },
    {
      "from": 271.73,
      "to": 274.16,
      "content": "反设计方法则是反其道而行之"
    },
    {
      "from": 274.16,
      "to": 276.59,
      "content": "根据激波出口型线反推激波流畅"
    },
    {
      "from": 276.59,
      "to": 278.12,
      "content": "进而进行成波体设计"
    },
    {
      "from": 278.12,
      "to": 280.659,
      "content": "其典型代表是密切锥成波体构型"
    },
    {
      "from": 280.659,
      "to": 281.619,
      "content": "操作方法为"
    },
    {
      "from": 281.619,
      "to": 284.409,
      "content": "根据给定激波出口形线的当地曲率半径"
    },
    {
      "from": 284.409,
      "to": 286.549,
      "content": "将前者分解为多段小圆弧"
    },
    {
      "from": 286.549,
      "to": 289.699,
      "content": "进而反向求解出多个小型圆锥激波流畅"
    },
    {
      "from": 289.699,
      "to": 292.6,
      "content": "再组合起来即可拟合出整体的三维流畅"
    },
    {
      "from": 292.6,
      "to": 295.24,
      "content": "最后根据基准面上给定的上表运行线"
    },
    {
      "from": 295.24,
      "to": 296.38,
      "content": "投影到激波曲面"
    },
    {
      "from": 296.38,
      "to": 297.62,
      "content": "已获得前缘线"
    },
    {
      "from": 297.62,
      "to": 300.53,
      "content": "密切锥乘波体的特点是可以指定激波形状"
    },
    {
      "from": 300.53,
      "to": 303.35,
      "content": "而不是局限于圆锥激波流场进行设计"
    },
