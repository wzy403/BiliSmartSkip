    {
      "from": 290.22,
      "to": 291.06,
      "content": "过了一会"
    },
    {
      "from": 291.06,
      "to": 292.72,
      "content": "他发现气体即将耗尽"
    },
    {
      "from": 292.72,
      "to": 294.16,
      "content": "于是决定退出去"
    },
    {
      "from": 294.16,
      "to": 296.64,
      "content": "可这个位置恰好是一个喇叭状结构"
    },
    {
      "from": 296.64,
      "to": 298.34,
      "content": "或者说是一个楔形结构"
    },
    {
      "from": 298.34,
      "to": 298.96,
      "content": "钻进来"
    },
    {
      "from": 298.96,
      "to": 300.86,
      "content": "可以想后退非常困难"
    },
    {
      "from": 300.86,
      "to": 303.8,
      "content": "斯文森的臀部和气瓶恰好被岩石卡住"
    },
    {
      "from": 303.8,
      "to": 304.82,
      "content": "更糟糕的是"
    },
    {
      "from": 304.82,
      "to": 305.8,
      "content": "这里不仅狭窄"
    },
    {
      "from": 305.8,
      "to": 307.08,
      "content": "而且还是个弯道"
    },
    {
      "from": 307.08,
      "to": 308.83,
      "content": "他想拆气瓶都拆不了"
    },
    {
      "from": 308.83,
      "to": 310.43,
      "content": "斯文森被彻底卡死"
    },
    {
      "from": 310.43,
      "to": 311.89,
      "content": "眼看气体越来越少"
    },
    {
      "from": 311.89,
      "to": 313.27,
      "content": "他立刻恐慌起来"
    },
    {
      "from": 313.27,
      "to": 315.87,
      "content": "而这时岸上的三个朋友还在聊天"
    },
    {
      "from": 315.87,
      "to": 318.07,
      "content": "他们根本不知道下面发生了什么"
    },
    {
      "from": 318.07,
      "to": 321.09,
      "content": "也想不到斯文森会鲁莽的钻进洞穴深处"
    },
    {
      "from": 321.09,
      "to": 323.45,
      "content": "但慢慢的他们开始发现有点不对"
    },
    {
      "from": 323.45,
      "to": 324.89,
      "content": "因为水面上没有气泡"
    },
    {
      "from": 324.89,
      "to": 325.56,
      "content": "出现了"
    },
    {
      "from": 325.56,
      "to": 327.58,
      "content": "三人中的爱丽丝决定下去看看"
    },
    {
      "from": 327.58,
      "to": 328.24,
      "content": "入水后"
    },
    {
      "from": 328.24,
      "to": 329.94,
      "content": "他发现水体依旧浑浊"
