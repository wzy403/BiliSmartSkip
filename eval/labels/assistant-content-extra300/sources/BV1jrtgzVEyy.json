    {
      "from": 293.17,
      "to": 294.05,
      "content": "情急之中"
    },
    {
      "from": 294.05,
      "to": 295.29,
      "content": "他撞向地雷"
    },
    {
      "from": 295.29,
      "to": 297.31,
      "content": "我们连长撞左脚对调"
    },
    {
      "from": 297.31,
      "to": 299.47,
      "content": "现在对面感觉刚刚那波亏了呀"
    },
    {
      "from": 299.47,
      "to": 300.95,
      "content": "他开始掉子防守"
    },
    {
      "from": 300.95,
      "to": 303.57,
      "content": "我们出二线工兵再抓他的司令"
    },
    {
      "from": 303.57,
      "to": 304.45,
      "content": "他躲一步"
    },
    {
      "from": 304.45,
      "to": 305.75,
      "content": "你看他还是比较怕的啊"
    },
    {
      "from": 305.75,
      "to": 307.01,
      "content": "那我们就收回工兵"
    },
    {
      "from": 307.01,
      "to": 308.43,
      "content": "把右路的炸弹拉过来"
    },
    {
      "from": 308.43,
      "to": 310.98,
      "content": "拉到左路辅助工兵进攻"
    },
    {
      "from": 310.98,
      "to": 312.34,
      "content": "这里掉炸弹的过程"
    },
    {
      "from": 312.34,
      "to": 314.44,
      "content": "我们快进一下啊"
    },
    {
      "from": 319.6,
      "to": 322.3,
      "content": "我们看到对面没反应啊"
    },
    {
      "from": 322.3,
      "to": 324.81,
      "content": "看来只要是不威胁他司令的都没事"
    },
    {
      "from": 324.81,
      "to": 327.63,
      "content": "我们在工兵的掩护下把炸弹伤到他三线"
    },
    {
      "from": 327.63,
      "to": 330.1,
      "content": "然后再上工兵继续抓四尾"
    },
    {
      "from": 330.1,
      "to": 331.86,
      "content": "这司令一看工兵来了"
    },
    {
      "from": 331.86,
      "to": 333.34,
      "content": "赶紧退回四县"
    },
    {
      "from": 333.34,
      "to": 334.66,
      "content": "我们则点到为止"
    },
    {
      "from": 334.66,
      "to": 335.44,
      "content": "不继续抓了"
    },
    {
      "from": 335.44,
      "to": 336.78,
      "content": "把炸弹卡进缝里"
    },
    {
      "from": 336.78,
      "to": 337.8,
      "content": "准备进攻左路"
    },
    {
      "from": 337.8,
      "to": 338.46,
      "content": "没办法"
    },
    {
      "from": 338.46,
      "to": 340.11,
      "content": "这右路防守太严了"
    },
    {
      "from": 340.11,
      "to": 341.75,
      "content": "你看他上来在抓工兵"
    },
    {
      "from": 341.75,
      "to": 342.63,
      "content": "我们退回来"
    },
    {
      "from": 342.63,
      "to": 344.65,
      "content": "这个工兵不要非他无限进攻"
    },
    {
      "from": 344.65,
      "to": 346.56,
      "content": "我们换下营的工兵来"
    },
    {
      "from": 346.56,
      "to": 347.5,
      "content": "为什么呢"
    },
    {
      "from": 347.5,
      "to": 349.7,
      "content": "因为这个工兵已经伪装的很好了"
    },
    {
      "from": 349.7,
      "to": 351.5,
      "content": "他他就是一个炸弹呢"
    },
    {
      "from": 351.5,
      "to": 354.56,
      "content": "一般情况下我们怎么能用炸弹排地雷呢"
    },
    {
      "from": 354.56,
      "to": 355.299,
      "content": "是不是"
    },
    {
      "from": 355.299,
      "to": 358.739,
      "content": "现在当我们用新钓上来的工兵飞他五二的时候"
    },
    {
      "from": 358.739,
      "to": 359.819,
      "content": "对面明显慌了"
    },
    {
      "from": 359.819,
      "to": 362.33,
      "content": "他拉右路小子过来挡这里"
    },
    {
      "from": 362.33,
      "to": 365.21,
      "content": "我们肯定是要军长跳出来吃他的炸弹"
    },
    {
      "from": 365.21,
      "to": 366.01,
      "content": "卡在三线"
    },
    {
      "from": 366.01,
      "to": 368.03,
      "content": "他是不敢来占军长这个上影的"
    },
    {
      "from": 368.03,
      "to": 369.33,
      "content": "你看那司令上来啊"
    },
    {
      "from": 369.33,
      "to": 370.34,
      "content": "我们又回去"
    },
    {
      "from": 370.34,
      "to": 372.22,
      "content": "现在他司令停在中路"
    },
    {
      "from": 372.22,
      "to": 374.74,
      "content": "我们直接掏出五三的炸弹哈"
    },
    {
      "from": 374.74,
      "to": 375.68,
      "content": "不要犹豫"
    },
    {
      "from": 375.68,
      "to": 377.92,
      "content": "出来就直奔他司令而去"
    },
    {
      "from": 377.92,
      "to": 379.66,
      "content": "对面沉思许久啊"
    },
    {
      "from": 379.66,
      "to": 383.65,
      "content": "脑海中浮现出司令本局被欺负的种种场面啊"
    },
    {
      "from": 383.65,
      "to": 385.95,
      "content": "最终他选择英勇就义诶"
    },
    {
      "from": 385.95,
      "to": 387.71,
      "content": "结束了躲藏的一生"
    },
    {
      "from": 387.71,
      "to": 388.85,
      "content": "他不信呐"
    },
    {
      "from": 388.85,
      "to": 389.73,
      "content": "这么胆大的"
    },
    {
      "from": 389.73,
      "to": 390.73,
      "content": "怎么能是炸弹呢"
    },
    {
      "from": 390.73,
      "to": 392.25,
      "content": "是不是好了"
    },
    {
      "from": 392.25,
      "to": 393.05,
      "content": "炸掉司令"
    },
    {
      "from": 393.05,
      "to": 395.57,
      "content": "我们把工兵拉回下营防守对面"
    },
    {
      "from": 395.57,
      "to": 397.09,
      "content": "上营出子非右有雷"
    },
    {
      "from": 397.09,
      "to": 397.55,
      "content": "哎"
    },
    {
      "from": 397.55,
      "to": 400.52,
      "content": "这也能解释刚刚为什么不用上营子施诈"
    },
    {
      "from": 400.52,
      "to": 402.64,
      "content": "之前是就丢了上兵"
    },
    {
      "from": 402.64,
      "to": 405.1,
      "content": "这次是工兵不敢碰了呀"
    },
    {
      "from": 405.1,
      "to": 405.66,
      "content": "好吧"
    },
    {
      "from": 405.66,
      "to": 407.74,
      "content": "我们用底线排长吃掉工兵"
    },
    {
      "from": 407.74,
      "to": 410.49,
      "content": "结果对面右脚子直接吃下来"
    },
    {
      "from": 410.49,
      "to": 411.81,
      "content": "来者不善呐"
    },
    {
      "from": 411.81,
      "to": 412.49,
      "content": "司令没了"
    },
    {
      "from": 412.49,
      "to": 414.31,
      "content": "很有可能要破釜沉舟了"
    },
    {
      "from": 414.31,
      "to": 416.91,
      "content": "所以我赶紧拉出司令拦住他"
    },
    {
      "from": 416.91,
      "to": 417.85,
      "content": "掐指一算"
    },
    {
      "from": 417.85,
      "to": 420.4,
      "content": "搏杀我们军旗正好差一步"
    },
    {
      "from": 420.4,
      "to": 422.62,
      "content": "于是他出军旗营子抓司令"
    },
    {
      "from": 422.62,
      "to": 424.5,
      "content": "我们一线有连长挡住"
    },
    {
      "from": 424.5,
      "to": 426.84,
      "content": "结果他下吃连长哎"
    },
    {
      "from": 426.84,
      "to": 427.78,
      "content": "不是炸弹"
    },
    {
      "from": 427.78,
      "to": 429.98,
      "content": "那我们司令就先吃一线子"
    },
    {
      "from": 429.98,
      "to": 431.34,
      "content": "他三线往外出子"
    },
    {
      "from": 431.34,
      "to": 432.08,
      "content": "不要怕诶"
    },
    {
      "from": 432.08,
      "to": 433.22,
      "content": "直接回吃"
    },
    {
      "from": 433.22,
      "to": 434.86,
      "content": "这个子威胁太大了"
    },
    {
      "from": 434.86,
      "to": 436.01,
      "content": "一定要吃掉"
    },
    {
      "from": 436.01,
      "to": 438.07,
      "content": "自然也是遭遇了炸弹"
    },
    {
      "from": 438.07,
      "to": 440.29,
      "content": "之前我们团长碰过一个炸弹啊"
    },
    {
      "from": 440.29,
      "to": 441.89,
      "content": "现在对面已经没炸了"
    },
    {
      "from": 441.89,
      "to": 445.31,
      "content": "我们拉出军长用炸弹占住他的中影"
    },
    {
      "from": 445.31,
      "to": 446.79,
      "content": "对面也是很痛快啊"
    },
    {
      "from": 446.79,
      "to": 448.15,
      "content": "骑上子直接出来"
    },
    {
      "from": 448.15,
      "to": 449.23,
      "content": "要和我们比大小"
    },
    {
      "from": 449.23,
      "to": 451.99,
      "content": "我们军长一拦他就和我们军长诶"
    },
    {
      "from": 451.99,
      "to": 453.78,
      "content": "没有同归于尽"
    },
    {
      "from": 453.78,
      "to": 456.14,
      "content": "那最大子儿没有撞过对面"
    },
    {
      "from": 456.14,
      "to": 457.6,
      "content": "选择拔线投降"
    },
    {
      "from": 457.6,
      "to": 459.98,
      "content": "我们也就拿下这局视频的"
    },
    {
      "from": 459.98,
      "to": 463,
      "content": "最后感谢宗主的衣柜的包年充电"
    },
    {
      "from": 463,
      "to": 464.66,
      "content": "还有其他粉丝的充电"
    },
    {
      "from": 464.66,
