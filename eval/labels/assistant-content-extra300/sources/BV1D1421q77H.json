    {
      "from": 241.32,
      "to": 243.44,
      "content": "1983年11月2日早九点"
    },
    {
      "from": 243.44,
      "to": 245.34,
      "content": "山西汾阳空八师24团"
    },
    {
      "from": 245.34,
      "to": 246.8,
      "content": "一架轰六轰炸机"
    },
    {
      "from": 246.8,
      "to": 250,
      "content": "与河北承德空24师71团的歼六战斗机"
    },
    {
      "from": 250,
      "to": 251.8,
      "content": "进行歼轰对抗演习"
    },
    {
      "from": 251.8,
      "to": 252.72,
      "content": "9.50分"
    },
    {
      "from": 252.72,
      "to": 255.1,
      "content": "一架歼六模拟攻击时脱离过晚"
