      "content": "出于安全考虑"
    },
    {
      "from": 618,
      "to": 620.04,
      "content": "就先让他游出洞穴休息了"
    },
    {
      "from": 620.04,
      "to": 621.42,
      "content": "再次评估情况后"
    },
    {
      "from": 621.42,
      "to": 624.42,
      "content": "他们决定让许世德在最前方做引导员"
