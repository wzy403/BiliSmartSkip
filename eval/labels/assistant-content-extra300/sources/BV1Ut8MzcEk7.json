    {
      "from": 244.249,
      "to": 245.38,
      "content": "就代表秋分"
    },
    {
      "from": 245.38,
      "to": 246.22,
      "content": "到了元代"
    },
    {
      "from": 246.22,
      "to": 248.78,
      "content": "天文学家郭守敬进一步改进了这套工具"
    },
    {
      "from": 248.78,
      "to": 250.4,
      "content": "他发现龟表建得越高"
    },
    {
      "from": 250.4,
      "to": 251.66,
