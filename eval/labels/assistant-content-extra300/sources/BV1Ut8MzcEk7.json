    },
    {
      "from": 398.84,
      "to": 399.74,
      "content": "在立夏那天"
    },
    {
      "from": 399.74,
      "to": 402,
      "content": "我们不能立刻就感觉到夏天开始了"
    },
    {
      "from": 402,
      "to": 403.08,
      "content": "但在夏至这一天"
    },
    {
      "from": 403.08,
      "to": 404.66,
      "content": "我们一定知道现在是夏天"
    },
    {
      "from": 404.66,
      "to": 407.64,
      "content": "通过规定每个正常月份都必须有一个中期"
    },
    {
      "from": 407.64,
      "to": 410.12,
      "content": "就能确保了冬至永远在农历11月"
    },
    {
      "from": 410.12,
      "to": 412.04,
