    {
      "from": 282.06,
      "to": 283.36,
      "content": "活活的锁死在里面"
    },
    {
      "from": 283.36,
      "to": 285.94,
      "content": "保安丹尼尔阿列科据说是主要执行者"
    },
    {
      "from": 285.94,
      "to": 288.56,
      "content": "他按照指令拉下了主门和紧急出口的铁门"
    },
    {
      "from": 288.56,
      "to": 290.7,
      "content": "门卷帘门把顾客牢牢的锁死"
    },
    {
      "from": 290.7,
      "to": 291.72,
      "content": "还有目击者回忆"
    },
    {
      "from": 291.72,
      "to": 294.1,
      "content": "当时甚至有人看到保安掏出了手枪"
    },
    {
      "from": 294.1,
      "to": 295.04,
      "content": "朝天鸣枪"
    },
    {
      "from": 295.04,
      "to": 296.66,
      "content": "试图阻止人们靠近出口"
    },
    {
      "from": 296.66,
      "to": 299.36,
      "content": "一位住在超市附近的女士后来颤抖的回忆道"
    },
    {
      "from": 299.36,
      "to": 300.44,
      "content": "我当时就在外面"
    },
    {
      "from": 300.44,
      "to": 302.64,
      "content": "眼睁睁的看着里面的人拼命的往外挤"
    },
    {
      "from": 302.64,
      "to": 304.68,
      "content": "但此时的门已被关的死死的"
    },
    {
      "from": 304.68,
      "to": 306.12,
      "content": "外面的人想冲进去救人"
    },
    {
      "from": 306.12,
      "to": 307.96,
      "content": "却发现入口全被封住了"
    },
    {
      "from": 307.96,
      "to": 309.64,
      "content": "里面的人开始慌乱踩踏"
    },
    {
      "from": 309.64,
      "to": 311.82,
      "content": "有的人绝望的喊着开门开门"
    },
    {
      "from": 311.82,
      "to": 313.7,
      "content": "可实际上门根本就不会打开"
    },
    {
      "from": 313.7,
      "to": 315.1,
      "content": "而烟雾也越来越浓"
    },
    {
      "from": 315.1,
      "to": 317.72,
      "content": "许多人就倒在离出口只有几米远的地方"
    },
    {
      "from": 317.72,
      "to": 319.54,
      "content": "相互拥抱着离开了人世"
    },
    {
      "from": 319.54,
      "to": 321.98,
      "content": "还有的母亲用自己的身体紧紧护住孩子"
    },
    {
      "from": 321.98,
      "to": 324,
      "content": "最后两人一起被浓烟吞没"
    },
    {
      "from": 324,
      "to": 326.66,
      "content": "其实这家超市的应急出口由于常年不使用"
    },
    {
      "from": 326.66,
      "to": 328.82,
      "content": "平时就被锁住或者堆积了货物"
    },
    {
      "from": 328.82,
      "to": 329.9,
      "content": "导致通道不畅"
    },
    {
      "from": 329.9,
      "to": 331.74,
      "content": "火灾时更是完全无法使用"
    },
    {
      "from": 331.74,
      "to": 333.16,
      "content": "有一个保安后来承认"
    },
    {
      "from": 333.16,
      "to": 336.06,
      "content": "他通过对讲机接到了锁门防止偷窃的指令"
    },
    {
      "from": 336.06,
      "to": 338.7,
      "content": "当时他也没想到火势会失控到这种地步"
    },
    {
      "from": 338.7,
      "to": 339.78,
      "content": "但是为了自己的饭碗"
    },
    {
      "from": 339.78,
      "to": 341.1,
      "content": "他也不敢违抗这个命令"
    },
    {
      "from": 341.1,
      "to": 343.06,
      "content": "最后只能被迫执行这个决定"
    },
    {
      "from": 343.06,
      "to": 344.9,
      "content": "带来的后果简直灾难到极点"
    },
    {
      "from": 344.9,
      "to": 347.9,
      "content": "他直接把一场可能只会死几十人的火灾"
    },
    {
      "from": 347.9,
      "to": 350.44,
      "content": "硬生生的推成了死几百人的超级惨剧"
    },
    {
      "from": 350.44,
      "to": 352.72,
      "content": "很多人本来离出口就差这么几米"
    },
    {
      "from": 352.72,
      "to": 354.2,
      "content": "却因为一道缓缓下降"
    },
    {
      "from": 354.2,
      "to": 357.28,
      "content": "最终锁死的卷帘门被活活地困在烟火地狱里"
    },
    {
      "from": 357.28,
      "to": 360.04,
      "content": "有的人躲进厕所冷藏柜试图喘口气"
    },
    {
      "from": 360.04,
      "to": 361.58,
      "content": "最后还是没能逃出来"
    },
    {
      "from": 361.58,
      "to": 363.76,
      "content": "而地下停车场的状况更为惨烈"
    },
    {
      "from": 363.76,
      "to": 366.52,
      "content": "汽车爆炸产生的浓烟和火焰向下蔓延"
    },
    {
      "from": 366.52,
      "to": 368.36,
      "content": "许多正在取车的人被困在车里"
    },
    {
      "from": 368.36,
      "to": 370.04,
      "content": "连车门都还没来得及打开"
    },
    {
      "from": 370.04,
      "to": 370.96,
      "content": "这一系列操作"
    },
    {
      "from": 370.96,
      "to": 372.38,
      "content": "简直让狗看了都摇头"
    },
    {
      "from": 372.38,
      "to": 374.24,
      "content": "这帮人当时到底在想什么"
    },
    {
      "from": 374.24,
      "to": 375.52,
      "content": "就是怕丢了点货"
    },
    {
      "from": 375.52,
      "to": 377.74,
      "content": "能够把几百条人命一起搭进去"
    },
    {
      "from": 377.74,
      "to": 378.96,
      "content": "这哪里是做生意"
    },
    {
      "from": 378.96,
      "to": 381.98,
      "content": "简直就是把顾客当成了可以随便牺牲的库存"
    },
    {
      "from": 381.98,
      "to": 386.74,
      "content": "整场灾难把荒唐短视自私体现的淋漓尽致"
    },
    {
      "from": 393.22,
      "to": 395.18,
      "content": "亚索村的消防队在接到报警后"
    },
    {
      "from": 395.18,
      "to": 396.14,
      "content": "迅速赶到现场"
    },
    {
      "from": 396.14,
      "to": 398.1,
      "content": "但他们面对的却是重重阻碍"
    },
    {
      "from": 398.1,
      "to": 399.9,
      "content": "由于主要出口都被铁门封死"
    },
    {
      "from": 399.9,
      "to": 402.26,
      "content": "断电让铁门失去了再次打开的可能"
    },
    {
      "from": 402.26,
      "to": 403.7,
      "content": "再加上内部结构复杂"
    },
    {
      "from": 403.7,
      "to": 404.46,
      "content": "浓烟和高温"
    },
    {
      "from": 404.46,
      "to": 405.74,
      "content": "让进入变得极其困难"
    },
    {
      "from": 405.74,
      "to": 408.78,
      "content": "消防员们只能用斧头和工具在墙壁上凿开缺口"
    },
    {
      "from": 408.78,
      "to": 410.46,
      "content": "一点点的向里面推进之后"
    },
    {
      "from": 410.46,
      "to": 412.5,
      "content": "他们看到的景象将会永生难忘"
    },
    {
      "from": 412.5,
      "to": 413.88,
      "content": "尸体堆积在出口附近"
    },
    {
      "from": 413.88,
      "to": 415.32,
      "content": "许多人相互拥抱在一起"
    },
    {
      "from": 415.32,
      "to": 416.46,
      "content": "还有人躲在角落里"
    },
    {
      "from": 416.46,
      "to": 417.98,
      "content": "没能等待到最后的救援"
    },
    {
      "from": 417.98,
      "to": 420.1,
      "content": "整个行动持续了近七八个小时"
    },
    {
      "from": 420.1,
      "to": 422.18,
      "content": "其实应该说是搬尸体的行动"
    },
    {
      "from": 422.18,
      "to": 424.06,
      "content": "直到深夜才基本控制住火势"
    },
    {
      "from": 424.06,
      "to": 424.72,
      "content": "阿根廷"
    },
    {
      "from": 424.72,
      "to": 425.18,
      "content": "巴西"
    },
    {
      "from": 425.18,
      "to": 427.02,
      "content": "智利等邻国也伸出了援手"
    },
    {
      "from": 427.02,
      "to": 429.46,
      "content": "派出飞机运送医疗物资和专业医生"
    },
    {
      "from": 429.46,
      "to": 431.12,
      "content": "医院也瞬间人满为患"
    },
    {
      "from": 431.12,
      "to": 433.56,
      "content": "数百名重度烧伤和吸入性损伤的伤者"
    },
    {
      "from": 433.56,
      "to": 434.56,
      "content": "需要紧急救治"
    },
    {
      "from": 434.56,
      "to": 436.92,
      "content": "其中一些人在后续的治疗当中还是不幸离世"
    },
    {
      "from": 436.92,
      "to": 439.48,
      "content": "关于伤亡数字至今仍然存在一些争议"
    },
    {
      "from": 439.48,
      "to": 441.54,
      "content": "官方公布的是327人死亡"
    },
    {
      "from": 441.54,
      "to": 443.72,
      "content": "受伤人数在200人到500人之间不等"
    },
    {
      "from": 443.72,
      "to": 446.56,
      "content": "受害者家属和部分媒体则认为实际数字更高"
    },
    {
      "from": 446.56,
      "to": 448.42,
      "content": "甚至还有六人至今下落不明"
    },
    {
      "from": 448.42,
      "to": 449.08,
      "content": "据推测"
    },
    {
      "from": 449.08,
      "to": 451.48,
      "content": "他们的遗体应该已经在高温当中完全焚毁"
    },
    {
      "from": 451.48,
      "to": 453.96,
      "content": "剩下的遇难者死因包括了严重烧伤"
    },
    {
      "from": 453.96,
      "to": 454.82,
      "content": "烟雾中毒"
    },
    {
      "from": 454.82,
      "to": 456.84,
      "content": "踩大窒息以及后续的并发症"
    },
    {
      "from": 456.84,
      "to": 459.56,
      "content": "绝大多数受害者都都是普通的巴拉圭家庭成员"
    },
    {
      "from": 459.56,
      "to": 460.98,
      "content": "周末出来放松的父母"
    },
    {
      "from": 460.98,
      "to": 462.06,
      "content": "活泼可爱的孩子"
    },
    {
      "from": 462.06,
      "to": 462.92,
      "content": "年迈的老人"
    },
    {
      "from": 462.92,
      "to": 464.84,
      "content": "有的家庭一家五口全部遇难"
    },
    {
      "from": 464.84,
      "to": 467.9,
      "content": "这些故事后来在法庭和纪录片当中被反复提起"
    },
    {
      "from": 467.9,
      "to": 469.46,
      "content": "每一次听起来都让人心碎"
    },
    {
      "from": 469.46,
      "to": 470.44,
      "content": "而火灾过后"
    },
    {
      "from": 470.44,
      "to": 471.68,
      "content": "许多家庭支离破碎"
    },
    {
      "from": 471.68,
      "to": 474.84,
      "content": "留下了孤儿寡母以及长期难以愈合的心理创伤"
    },
    {
      "from": 474.84,
      "to": 477.18,
      "content": "甚至还有一些幸存者在后续的日子里面"
    },
    {
      "from": 477.18,
      "to": 478.5,
      "content": "选择结束自己的性命"
    },
    {
      "from": 478.5,
      "to": 480.14,
      "content": "在火灾发生后的第二天"
    },
    {
      "from": 480.14,
      "to": 482.1,
      "content": "泰瓦负责的几名保安就被逮捕了"
    },
    {
      "from": 482.1,
      "to": 484.4,
      "content": "调查结果清楚地指向了三个主要原因"
    },
    {
      "from": 484.4,
      "to": 486.62,
      "content": "超市后厨的烟道长期缺乏维护"
    },
    {
      "from": 486.62,
      "to": 488.3,
      "content": "建筑消防设施严重不足"
    },
    {
      "from": 488.3,
      "to": 490.62,
      "content": "以及火灾发生时故意锁闭出口"
    },
    {
      "from": 490.62,
      "to": 491.34,
      "content": "美国酒精"
    },
    {
      "from": 491.34,
      "to": 491.7,
      "content": "烟草"
    },
    {
      "from": 491.7,
      "to": 493.74,
      "content": "火器和爆炸物管理局等专家"
    },
    {
      "from": 493.74,
      "to": 495.76,
      "content": "也协助确认了起火的意外性质"
    },
    {
      "from": 495.76,
      "to": 497.96,
      "content": "但人为因素被认定为主要原因"
    },
    {
      "from": 497.96,
      "to": 499.58,
      "content": "审判过程漫长而曲折"
    },
    {
      "from": 499.58,
      "to": 501.1,
      "content": "最初的判决相对较轻"
    },
    {
      "from": 501.1,
      "to": 502.6,
      "content": "只认定为过失杀人"
    },
    {
      "from": 502.6,
      "to": 504.68,
      "content": "这引发了受害者家属的强烈不满"
    },
    {
      "from": 504.68,
      "to": 505.8,
      "content": "和法庭内的冲突"
    },
    {
      "from": 505.8,
      "to": 506.88,
      "content": "后来经过重审"
    },
    {
      "from": 506.88,
      "to": 509.28,
      "content": "法院认定这属于可预见的故意杀人"
    },
    {
      "from": 509.28,
      "to": 510.6,
      "content": "帕瓦父子在庭审当中"
    },
    {
      "from": 510.6,
      "to": 512.5,
      "content": "始终否认是自己直接下的命令"
    },
    {
      "from": 512.5,
      "to": 514.46,
      "content": "他们还推出当时的锁门指令"
    },
    {
      "from": 514.46,
      "to": 516.48,
      "content": "是一名已经过时的经理所为"
    },
    {
      "from": 516.48,
      "to": 518.12,
      "content": "然而是个人都看得出来"
    },
    {
      "from": 518.12,
      "to": 519.72,
      "content": "死人是没有办法佐证的"
    },
    {
      "from": 519.72,
      "to": 522.74,
      "content": "所以法庭最终认定这就是一场可预见的意外"
    },
    {
      "from": 522.74,
      "to": 524.34,
      "content": "因为不管是谁下的指令"
    },
    {
      "from": 524.34,
      "to": 526.46,
      "content": "所有的人都知道锁门会害死人"
    },
    {
      "from": 526.46,
      "to": 527.58,
      "content": "却还是这么干了"
    },
    {
      "from": 527.58,
      "to": 529.28,
      "content": "在2008年的最终判决中"
    },
    {
      "from": 529.28,
      "to": 532.26,
      "content": "胡安派瓦也就是父亲被判处了12年有期徒刑"
    },
    {
      "from": 532.26,
      "to": 534.64,
      "content": "他的儿子维克托派瓦被判处了10年"
    },
    {
      "from": 534.64,
      "to": 536.72,
      "content": "保安丹尼尔阿雷克被判处了5年"
    },
    {
      "from": 536.72,
      "to": 538.32,
      "content": "其他相关人员也分别获刑"
    },
    {
      "from": 538.32,
      "to": 540.3,
      "content": "最高法院后来维持了这一判决"
    },
    {
      "from": 540.3,
      "to": 543.28,
      "content": "然而当事人后来因表现良好而提前获释了"
    },
    {
      "from": 543.28,
      "to": 544.96,
      "content": "老派瓦于2014年出狱"
    },
    {
      "from": 544.96,
      "to": 546.38,
      "content": "他的儿子则更早一些"
    },
    {
      "from": 546.38,
      "to": 548.68,
      "content": "但在后来的2020年却死于新冠"
    },
    {
      "from": 548.68,
      "to": 551.08,
      "content": "老派瓦则在2025年因糖尿病离世"
    },
    {
      "from": 551.08,
      "to": 552,
      "content": "但就算是这样"
    },
    {
      "from": 553.36,
      "to": 556.28,
      "content": "许多受害者家属至今仍对判决结果并不满意"
    },
    {
      "from": 556.28,
      "to": 558.34,
      "content": "他们认为司法对有钱人过于宽容"
    },
    {
      "from": 558.34,
      "to": 560.04,
      "content": "民事赔偿也拖延了多年"
    },
    {
      "from": 560.04,
      "to": 562.2,
      "content": "仍有不少家庭没有得到应有的补偿"
    },
    {
      "from": 562.2,
      "to": 564.28,
      "content": "这场火灾太当时震惊了整个巴拉圭"
    },
    {
      "from": 564.28,
      "to": 565.12,
      "content": "在火灾之后"
    },
    {
      "from": 565.12,
      "to": 566.54,
      "content": "全国宣布哀悼三天"
    },
    {
      "from": 566.54,
      "to": 567.32,
      "content": "学校停课"
    },
    {
      "from": 567.32,
      "to": 569.08,
      "content": "司法系统也暂时停止运作"
    },
    {
      "from": 569.08,
      "to": 571.06,
      "content": "超市随后永久关闭原来的遗址"
    },
    {
      "from": 571.06,
      "to": 572.66,
      "content": "如今已成为了一处记忆之地"
    },
    {
      "from": 572.66,
      "to": 573.34,
      "content": "2022年"
    },
    {
      "from": 573.34,
      "to": 574.84,
      "content": "这里正式建成了一座纪念碑"
    },
    {
      "from": 574.84,
      "to": 576.74,
      "content": "包括雕塑花园和小教堂"
    },
    {
      "from": 576.74,
      "to": 577.74,
      "content": "每年的8月1日"
    },
    {
      "from": 577.74,
      "to": 580.58,
