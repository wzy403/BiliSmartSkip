    {
      "from": 324.23,
      "to": 325.51,
      "content": "于是打灯变道"
    },
    {
      "from": 325.51,
      "to": 326.36,
      "content": "准备上桥"
    },
    {
      "from": 326.36,
      "to": 329.32,
      "content": "旁边的X5貌似和视频车目标一致"
    },
    {
      "from": 329.32,
      "to": 331.44,
      "content": "但他变道的时候并没有打灯"
    },
    {
      "from": 331.44,
      "to": 333.8,
      "content": "视频车抢先一步冲到了前面"
    },
    {
      "from": 333.8,
      "to": 335.62,
      "content": "从道汇入口的距离来看"
    },
    {
      "from": 335.62,
      "to": 337.8,
      "content": "宝马X5变道显然变慢了"
    },
    {
      "from": 337.8,
      "to": 340.12,
      "content": "但是同样的剧情再次上演"
    },
    {
      "from": 340.12,
      "to": 342.84,
      "content": "他并不认为自己的操作有什么问题"
    },
    {
      "from": 342.84,
      "to": 345.5,
      "content": "反而因视频车没有让他而暴怒"
    },
    {
      "from": 345.5,
      "to": 346.94,
      "content": "于是他抄上来以后"
    },
    {
      "from": 346.94,
      "to": 349.24,
      "content": "开始对视频车进行驾驶干扰"
    },
    {
      "from": 349.24,
      "to": 350.22,
      "content": "可不巧的是"
    },
    {
      "from": 350.22,
      "to": 352.54,
      "content": "他今天挑错了对手"
    },
    {
      "from": 358.04,
      "to": 359.74,
      "content": "公路之王今日陨落"
    },
    {
      "from": 359.74,
      "to": 360.66,
      "content": "气囊全开"
    },
    {
      "from": 360.66,
      "to": 362.08,
      "content": "断悬架爆水箱"
    },
    {
      "from": 362.08,
      "to": 364.5,
      "content": "关键是还被认定了一个全责"
    },
    {
      "from": 364.5,
      "to": 366.78,
      "content": "其实本就没有太大的必要"
    },
    {
      "from": 366.78,
      "to": 368.02,
      "content": "只因对方脾气大"
    },
    {
      "from": 368.02,
      "to": 368.84,
      "content": "还技术菜"
    },
    {
      "from": 368.84,
      "to": 372.539,
      "content": "所以开车在路上还是不要动不动就发脾气的好"
    },
    {
      "from": 372.539,
      "to": 374.859,
      "content": "发脾气之前也掂量掂量自己"
    },
    {
      "from": 374.859,
      "to": 376.9,
      "content": "到底能不能全身而退"
